7&idx=2&sn=e8a916ccd6df30972a28140fdd30b85a&chksm=bc2438528bf97b90a3f97f5df5ac423b3179d7984f19e1fba6122dab8a242810e5a5f4127022&scene=126&sessionid=1794790832#rd","publishedAt","2026-11-14T01:51:16.000Z","sourceIconUrl","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=920757ef74ebe49f","sourceIconSrcSet","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=9cb8174b387e7452 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=920757ef74ebe49f 96w","firstParty",false,"available",true,"nv5c0dm51azewdriddguukjib","GSK 德莫奇单抗、美泊利珠单抗纳入 2026 年国家医保目录","GSK 宣布易适来（德莫奇单抗）与新可来（美泊利珠单抗注射液）纳入《国家基本医疗保险、生育保险和工伤保险药品目录（2026年）》。德莫奇单抗覆盖重度嗜酸性粒细胞性哮喘和慢性鼻窦炎伴鼻息肉两项适应症，每年给药两次，今年上半年在中国获批后同年进入医保；美泊利珠单抗本次新增慢阻肺病适应症纳入支付范围，其重度嗜酸性粒细胞性哮喘、慢性鼻窦炎伴鼻息肉及嗜酸性肉芽肿性多血管炎三项适应症同步续约。","呼吸界","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604829&idx=1&sn=8794d3e75ea623888f9e2788fcac4246&chksm=fcc25c6faca38ec7b8a9075f60d37ed45d7fd911796634e6c4feedf6182b1665867b5f21562c&scene=126&sessionid=1794790833#rd","2026-11-14T05:39:17.000Z","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2FqcrGY40NstI9KRy4xGibFbQKxOmj4bsGPiaZUj6GX6GT7y8o5IhK2s0WmeUI2OpkvORFYDp0anficAMm01e7dLGAg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=a6a1bb0cc49dcaf4","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2FqcrGY40NstI9KRy4xGibFbQKxOmj4bsGPiaZUj6GX6GT7y8o5IhK2s0WmeUI2OpkvORFYDp0anficAMm01e7dLGAg%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=df299adc40fe2737 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2FqcrGY40NstI9KRy4xGibFbQKxOmj4bsGPiaZUj6GX6GT7y8o5IhK2s0WmeUI2OpkvORFYDp0anficAMm01e7dLGAg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=a6a1bb0cc49dcaf4 96w",{"_121":171,"_94":-5,"_123":172},{"_121":131,"_94":-5,"_123":132},{"_121":122,"_94":-5,"_123":124},"label","观点与解读","items",[125],{"_91":126,"_41":127,"_94":128,"_96":97,"_98":129,"_100":130,"_102":103,"_104":105,"_106":107,"_108":109},"x0xqs42xpeuukznbms8x3f0je","药明巨诺瑞基奥仑赛降至30万元以内进基本医保，成首个纳入的CAR-T","2026版国家医保目录公布，药明巨诺瑞基奥仑赛（倍诺达）从129万元一支谈至30万元以内，成为国内首个进入基本医保的CAR-T，新版目录明年1月1日执行。降价底气来自慢病毒载体国产化，单支成本压到二十多万，按出厂价29万、成本约22万测算毛利率约25%。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699684&idx=1&sn=e72806fa9b4136ea9d8279f1ff04a301&chksm=bcfe2e4492439d1f54fc0e3d12d2bbf62ec2d7a109510448f333d6238f2209763a846a084f98&scene=126&sessionid=1794790832#rd","2026-11-15T04:07:46.000Z","政策与监管",[133,134,135,136],{"_91":70,"_41":63,"_94":153,"_96":97,"_98":154,"_100":155,"_102":103,"_104":105,"_106":107,"_108":109,"_156":32,"_157":158},{"_91":148,"_41":149,"_94":150,"_96":113,"_98":151,"_100":152,"_102":116,"_104":117,"_106":107,"_108":109},{"_91":143,"_41":144,"_94":145,"_96":113,"_98":146,"_100":147,"_102":116,"_104":117,"_106":107,"_108":109},{"_91":137,"_41":138,"_94":139,"_96":140,"_98":141,"_100":142,"_102":-5,"_106":107,"_108":109},"cy13d4uidahrp0yi7v3os5021","罗氏艾美赛珠单抗纳入 2026 年版国家医保目录，覆盖 A 型血友病规律替代治疗","国家医保局公布《国家基本医疗保险、生育保险和工伤保险药品目录（2026 年版）》，罗氏制药中国的艾美赛珠单抗注射液（舒友立乐）纳入医保，报销范围覆盖伴或不伴凝血因子 VIII 抑制物的 A 型血友病患者规律替代治疗。","药时代","https://www.drugtimes.cn/2026/11/14/aimeisaizhudankangchenggongnaruguojiayibaokaiqixueyoubinglin/","2026-11-14T11:08:01.000Z","pyz9ox90brl8hyn4nwbf2gqkt","征祥医药玛硒洛沙韦片（济可舒）纳入2026年国家医保目录","国家医保局11月14日公布2026年国家医保药品目录（2027年1月1日起执行），征祥医药自主研发的1类抗流感新药玛硒洛沙韦片（济可舒）纳入，济川药业为该药中国独家商业化权益方。该药为流感病毒PA核酸内切酶抑制剂，全疗程单次口服，成人80mg、12岁及以上青少年40mg，成人适应症2025年7月获批、青少年适应症2026年6月获批。其代谢不依赖CYP450酶，轻中度肝功能不全无需调整剂量。","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604842&idx=1&sn=53c76be260adf113c60d275172de9e58&chksm=fca3fae73304ded76277d3ba4478e763487eeda5a4c491f72789b47d51c2831b2da86d8ca250&scene=126&sessionid=1794790833#rd","2026-11-15T03:13:12.000Z","l4gif7m8k6kbnc3prgwmqr4i3","度普利尤单抗慢阻肺病与哮喘适应症纳入2026国家医保药品目录","国家医保局公布《国家基本医疗保险、工伤保险和生育保险药品目录（2026年）》，度普利尤单抗注射液成人慢阻肺病及6岁及以上儿童和成人哮喘等四项适应症首次纳入医保支付范围，中重度特应性皮炎适应症续约。该药为靶向白介素-4及白介素-13的生物制剂，陈荣昌、瞿介明两位教授在文中提到纳入医保有助于减轻用药负担、提升可及性并减少急性加重。","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604830&idx=1&sn=f243eb34d45828f019b753a8cf4bbab4&chksm=fcd2f2447358c79aaa4cf155da72bba585adc408db479a1afd77fdcd5789515aa523aee7e06c&scene=126&sessionid=1794790833#rd","2026-11-14T10:00:00.000Z","国家医保局公布2026年国家医保药品目录和商保创新药目录，医保目录新增107种药品（含51种1类创新药）、调出34种，目录总数达3331个；商保创新药目录新纳入11家药企的12种药品，调整后共28种。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699682&idx=1&sn=191dc7e70ed0de6b0a1dfd1744b77d89&chksm=bc5159a21fa3a9a5765db8b67eb2fab594d82db0a45ddba14fb00cb64da8e617165bab59e81a&scene=126&sessionid=1794790832#rd","2026-11-14T04:44:12.000Z","otherSources","related",[159,160],{"_91":164,"_41":165,"_94":-5,"_96":166,"_98":167,"_100":168,"_102":169,"_104":170,"_106":107,"_108":109},{"_91":161,"_41":162,"_94":-5,"_96":97,"_98":163,"_100":101,"_102":103,"_104":105,"_106":107,"_108":109},"b0py1eqh2latc6bruk6mgcgzf","2026版国家医保药品目录与第二批商保创新药目录将于11月14日公布","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699657&idx=1&sn=2dea2747d7b9808d32f40fcbed36b181&chksm=bcd566175a091f2eb725ac28f50c3464e970cd6c05edbca1f5cf3cb5ebb6dd40766b131d008d&scene=126&sessionid=1794790832#rd","my83a4lpsp2zyvri6aerxa0cm","2026版国家医保目录与商保创新药目录发布，新增107种新药、净增78个编号","赛柏蓝","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670661&idx=1&sn=7aaa3d6afe5a061f4b1934b0bdd3d582&chksm=bceebb566421c1517a0d2bd659095d0e461888455c337c1f76767eaaeb9c1c44ce38af4c2aa9&scene=126&sessionid=1794790858#rd","2026-11-14T05:35:05.000Z","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=167030ae1e219003","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=b828ff70e947816f 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=167030ae1e219003 96w","行业动态",[173],{"_91":174,"_41":175,"_94":176,"_96":166,"_98":177,"_100":168,"_102":169,"_104":170,"_106":107,"_108":109},"l3sg0o11v4cxvprqzjdqk3k25","2026H1有52个国谈药在城市实体药店销售过亿，合计近140亿元","米内网数据显示，2026H1中国城市实体药店终端有52个国谈药（2025版）销售额超过1亿元，合计接近140亿元，其中36个品种涨幅超过10%。甲磺酸伏美替尼片、甲磺酸阿美替尼片均超12亿元，泽布替尼胶囊、司库奇尤单抗注射液超5亿元，替尔泊肽注射液涨超300%。一级集团排名中翰森制药、恒瑞医药、诺华位列前三，52个品种中独家品种占比约86%。","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670661&idx=3&sn=a9cd49c32ff7ef89dd2a9c581dafef4b&chksm=bc42d62ab2be85beda9a1268ccddc564b3976c1b2d011a5bed0fbab3ff527c17595834433720&scene=126&sessionid=1794790858#rd",{"_91":148,"_41":149,"_94":150,"_96":113,"_98":151,"_100":152,"_102":116,"_104":117,"_106":107,"_108":109},{"_91":126,"_41":127,"_94":128,"_96":97,"_98":129,"_100":130,"_102":103,"_104":105,"_106":107,"_108":109},{"_91":143,"_41":144,"_94":145,"_96":113,"_98":146,"_100":147,"_102":116,"_104":117,"_106":107,"_108":109},"leadParagraph",{"_183":184,"_185":-5,"_186":109},"changelogVersion","2026-10-08T08:00","release","staticSite"]
