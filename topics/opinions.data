[{"_1":2,"_3":4},"root",{"_5":136},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443580000,{"_115":116,"_56":117,"_118":119,"_120":121,"_122":-5,"_123":124,"_125":126,"_127":128,"_129":130,"_131":132,"_133":134},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":105,"_28":106,"_30":107,"_32":108,"_34":109,"_36":110,"_38":111,"_39":40,"_41":112,"_43":113,"_45":46,"_47":48,"_49":-5},{"_26":97,"_28":98,"_30":99,"_32":100,"_34":101,"_36":102,"_38":103,"_39":40,"_41":104,"_43":65,"_45":46,"_47":48,"_49":-5},{"_26":85,"_28":86,"_30":87,"_32":88,"_34":89,"_36":90,"_38":91,"_39":92,"_41":93,"_43":44,"_45":46,"_47":48,"_49":-5},{"_26":77,"_28":78,"_30":79,"_32":80,"_34":81,"_36":63,"_38":63,"_39":40,"_41":82,"_43":83,"_45":46,"_47":48,"_49":-5},{"_26":58,"_28":59,"_30":60,"_32":61,"_34":62,"_36":63,"_38":63,"_39":40,"_41":64,"_43":65,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","g1wo0hl9vfwrir7yfji4ej9pu","title","IDSA/ESCMID 发布金黄色葡萄球菌菌血症共识声明，以风险分层取代复杂与不复杂分类","summary","IDSA 与 ESCMID 于 9 月发布金黄色葡萄球菌菌血症（SAB）指南项目首批共识声明，围绕风险分层、诊断评估与疗程回答 7 个临床问题，建议以风险分层框架取代传统的复杂与不复杂分类。","reason","指南组成员解释风险分层如何取代复杂与不复杂二分，并说明低风险患者两周疗程的适用条件。","source",{"_56":57},"publishedAt","2026-10-01T16:40:57.433Z","timelineAt","category","opinion","tags",[50,51,52,53,54,55],"score",58,"selected",true,"channel","news","x","观点/解读","抗菌药物","耐药与院感","抗感染","循证指南","对市场","name","Contagion Live·抗菌药物管理","hd485xtzcfm3xsnbe8g91vitu","信达生物Q3产品收入超47亿元，点苍鹤拆解高增长的四股力量与后续节奏","信达生物2026年第三季度产品收入单季超过47亿元，同比增长超40%，在Q2超43亿元的高基数上继续上行。作者点苍鹤认为增长来自老品种企稳、TKI产品进医保后放量、玛仕度肽与托莱西单抗等综合新品渗透以及销售费用摊薄四股力量叠加，短期高增有延续性但同比增速会从Q2接近60%、Q3超40%逐季温和回落。","文章把信达Q3超40%增长拆成老品种企稳、TKI接力、新品放量与费用摊薄四股力量，并指出增速斜率会逐季下移。",{"_56":76},"2026-10-31T01:06:38.000Z",[50,66,67,68,69,70,71,72,73,74,75],62,"公司动态","市场/销售","肿瘤","代谢/减重","GLP-1","信达生物","礼来","辉瑞","武田","罗氏","医药云端工作室","vmmqdj90ogezokrhzjth5m3au","税务局眼中的药企合规：从丹娜生物、和治药业、康希诺案例看研发、销售与财务要求","国家税务总局公众号转载《中国税务报》报道，把天津丹娜生物、和治药业、敬业精细化工、康希诺的税务做法作为正面典型，呈现税务系统对药企合规的判断框架。丹娜生物为每个研发项目分配唯一编码并建独立辅助账，2025年缴税超3500万元、享受研发加扣约2890万元，连续八年A级纳税人；和治药业要求无合同不排产不发货，票面与合同对不上一律退回重开，款项走对公账户并逐笔对账。","从税务系统公开报道的几家药企做法，拆解研发加扣、销售费用与纳税信用三处合规门槛的变化。",{"_56":76},[50,84],47,"政策/监管","bishq0amt3d2me1pxgru72hw5","南方医院遴选处方流转合作药店，广东双通道单独支付征求意见同步推进","南方医科大学南方医院发布处方流转合作药店遴选公告，仅限广州医保双通道定点药店常态化申报，合作期限最长三年，分配送药店和回流药店两类，回流药店需具备30分钟送药回医院指定区域的能力。","文章把医院遴选细则与省级单独支付征求意见稿并置，梳理出处方流转在价格、责任与药店承接意愿上的现实堵点。",{"_56":76},"2026-11-04T03:40:02.000Z","2026-11-05T05:15:49.069Z","policy",[84,94,95,50,96],"医保/集采","行业趋势","国家医保局","q2vrqi464iwlimndbfgbapjnt","58款商保药品推荐清单落地，DTP渠道的三类品种打法","中国保险行业协会11月10日公布《商业健康保险药品保障推荐清单（第一版）》，纳入58个品种，覆盖肺癌、肝癌、血液肿瘤及神经母细胞瘤等，只对应医疗险院外特药责任，属行业参考范本而非强制目录。","围绕58款商保推荐清单，按纯商保、双目录重叠、院内医保三类品种给出院内外渠道与结算打法。",{"_56":76},"2026-11-12T00:25:43.000Z","2026-11-12T14:31:02.650Z",[50,84,94,67],"x0xqs42xpeuukznbms8x3f0je","药明巨诺瑞基奥仑赛降至30万元以内进基本医保，成首个纳入的CAR-T","2026版国家医保目录公布，药明巨诺瑞基奥仑赛（倍诺达）从129万元一支谈至30万元以内，成为国内首个进入基本医保的CAR-T，新版目录明年1月1日执行。降价底气来自慢病毒载体国产化，单支成本压到二十多万，按出厂价29万、成本约22万测算毛利率约25%。","从成本国产化到支付分层，拆解了CAR-T进医保后放量受产能与质控制约的现实条件。",{"_56":76},"2026-11-15T04:07:46.000Z","2026-11-16T01:00:36.137Z",[50,94,114,96],78,"细胞与基因治疗","slug","opinions","观点与解读","group","genre","definition","行业判断与深度解读：分析师观点、研究者访谈、会议纪要与复盘。","brand","total",6,"recent",5,"indexable",false,"latest",{"_28":106,"_135":111},"groupName","内容形态","poolTotal",221,"at",{"_137":138,"_139":-5,"_140":46},"changelogVersion","2026-10-08T08:00","release","staticSite"]
