[{"_1":2,"_3":4},"root",{"_5":85},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443580000,{"_65":66,"_51":67,"_68":69,"_70":71,"_72":-5,"_73":74,"_75":16,"_76":77,"_78":79,"_80":81,"_82":83},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":53,"_24":54,"_26":55,"_28":56,"_30":57,"_32":58,"_34":58,"_35":59,"_37":60,"_39":40,"_41":42,"_43":44,"_45":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":33,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5},"id","ffbzgnxsai4hecg6w3bvtn5rt","title","华润医药发布2026年中期业绩：收入1344.6亿元，归母净利润21.9亿元","summary","华润医药2026年上半年收入同比增长2.0%至1,344.6亿元，归母净利润同比增长5.3%至21.9亿元，中期每股派息0.087元、派息额同比增长20.8%。","reason","中期业绩披露了各分部收入增速与研发投入规模，可对照观察分销与零售业务的结构变化。","source",{"_51":52},"publishedAt","2026-08-25T00:00:00.000Z","timelineAt","category","industry","tags",[46,47,48,49,50],"score",58,"selected",true,"channel","news","x","公司动态","市场/销售","投融资","医疗器械/IVD","华润医药","name","华润医药·医药动态","rfnvez36knw9uh8wlntemdi1y","欧康维视氟轻松玻璃体内植入剂优施莹地产化获 NMPA 批准","10月27日，欧康维视宣布氟轻松玻璃体内植入剂（优施莹）地产化注册申请获国家药监局批准，未来可在境内商业化生产供应。该药2022年6月以进口5.1类获批，用于累及眼后段的慢性非感染性葡萄膜炎，2023年通过国谈进入医保目录；此次由苏州欧康维视以化学药品4类仿制路径申报（受理号CYHS2502987，2025年8月承办，国药准字H20266424），分子、剂型、适应症未变。","从进口独家到苏州地产化，材料拆解了眼科缓释植入剂的制剂工程门槛与后续供应、医保放量逻辑。",{"_51":64},"2026-10-29T00:05:17.000Z","approval",[61,62,49,63],"获批上市","眼科","NMPA","医药云端工作室","slug","device-ivd","医疗器械与 IVD","group","field","definition","器械、诊断与试剂：创新器械审批、IVD 集采、伴随诊断与家用检测。","brand","total",2,"recent","indexable",false,"latest",{"_24":54,"_84":58},"groupName","治疗领域","poolTotal",82,"at",{"_86":87,"_88":-5,"_89":42},"changelogVersion","2026-10-08T08:00","release","staticSite"]
