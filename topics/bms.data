[{"_1":2,"_3":4},"root",{"_5":107},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_82":83,"_52":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":92,"_94":95,"_96":97,"_98":99,"_100":101},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":66,"_25":67,"_27":68,"_29":69,"_31":70,"_33":71,"_35":71,"_36":60,"_38":72,"_40":73,"_42":43,"_44":45,"_46":-5},{"_23":54,"_25":55,"_27":56,"_29":57,"_31":58,"_33":59,"_35":59,"_36":60,"_38":61,"_40":62,"_42":43,"_44":45,"_46":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","lwmjovvi8uvshy4sd6t6zdrq4","title","百利天恒伦康依隆妥单抗肺癌二线 III 期与一线联合数据在 ESMO 公布","summary","2026 ESMO 期间，百利天恒公布伦康依隆妥单抗（iza-bren）在 EGFR 突变肺癌的两组数据。二线 PANKU-Lung01 研究中，单药中位 PFS 达 11.1 个月，较化疗降低疾病进展或死亡风险 60%（HR=0.40），ORR 60.2%、DoR 10.4 个月，该适应症上市申请已被 CDE 受理。","reason","文章汇总了伦康依隆妥单抗在 EGFR 突变肺癌二线与一线的最新数据，读者可据此对照现有标准治疗的 PFS 水平。","source",{"_52":53},"publishedAt","2026-10-27T09:17:13.000Z","timelineAt","category","clinical","tags",[47,48,49,50,51],"score",46,"selected",true,"channel","news","x","临床进展","肿瘤","ADC","抗体/双抗","BMS","name","医药魔方","gpj7y9pn6sio9fy1crcmppqez","百利天恒收到BMS第二笔2.5亿美元里程碑付款，iza-bren合作累计收款13亿美元","百利天恒全资子公司SystImmune已收到BMS支付的第二笔2.5亿美元里程碑付款，源于2023年12月签署的伦康依隆妥单抗（iza-bren/BL-B01D1）全球独家许可协议，该交易潜在总额最高84亿美元。","这笔里程碑款由一项全球Ⅲ期试验达成终点触发，读者可据此看清这笔84亿美元交易的付款节奏与后续节点。",{"_52":65},"2026-11-18T06:22:55.000Z","industry",[63,51,49,48,64],70,"交易/授权","研发管线","药时代","ur7psg8u9pifv5lugm61i0b2j","默沙东、礼来、艾伯维、辉瑞、BMS 向美国众议院委员会表示不在新疆及解放军关联医院启动新临床试验","美国众议院中国问题特别委员会披露，默沙东、礼来、艾伯维、辉瑞、BMS 五家药企已书面表示，不计划在中国新疆地区或与中国军方关联的医院启动新的临床试验点。该委员会去年 6 月对上述五家公司展开调查，关注试验点的知识产权暴露、军方关联与伦理标准问题；五家公司均表示不会在与解放军关联的试验点启动新临床研究。","美国众议院委员会调查五家跨国药企在华临床试验，企业以书面承诺回应，反映地缘政治对试验布局的影响。",{"_52":81},"2026-11-20T00:00:00.000Z",[74,75,76,77,78,79,80,51],58,"公司动态","行业趋势","FDA","默沙东","礼来","艾伯维","辉瑞","STAT","slug","bms","BMS 百时美施贵宝","group","company","definition","BMS 的肿瘤与血液管线、专利悬崖应对、新机制药物与并购动态。","brand",{"_103":-5,"_104":105,"_106":95},"total",3,"recent","indexable",false,"latest",{"_25":67,"_102":71},"groupName","药企与机构","poolTotal",9,"at","src","monogram","B","raster",{"_108":109,"_110":-5,"_111":43},"changelogVersion","2026-10-08T08:00","release","staticSite"]
