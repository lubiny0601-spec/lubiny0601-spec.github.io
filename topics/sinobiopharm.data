[{"_1":2,"_3":4},"root",{"_5":126},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443578000,{"_101":102,"_55":53,"_103":104,"_105":106,"_107":108,"_109":110,"_111":112,"_113":114,"_115":116,"_117":118,"_119":120},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":91,"_28":92,"_30":93,"_32":94,"_34":95,"_36":96,"_38":97,"_39":40,"_41":98,"_43":99,"_45":46,"_47":48,"_49":-5},{"_26":83,"_28":84,"_30":85,"_32":86,"_34":87,"_36":88,"_38":88,"_39":40,"_41":89,"_43":44,"_45":46,"_47":48,"_49":-5},{"_26":75,"_28":76,"_30":77,"_32":-5,"_34":78,"_36":79,"_38":79,"_39":40,"_41":80,"_43":81,"_45":46,"_47":48,"_49":-5},{"_26":65,"_28":66,"_30":67,"_32":-5,"_34":68,"_36":69,"_38":69,"_39":40,"_41":70,"_43":71,"_45":46,"_47":48,"_49":-5},{"_26":57,"_28":58,"_30":59,"_32":60,"_34":61,"_36":62,"_38":62,"_39":40,"_41":63,"_43":44,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","a8k1fw60y6jmpwen1yukoi43t","title","葛兰素史克与中国生物制药达成独家合作，加速乙肝 ASO 疗法 bepirovirsen 在华上市","summary","葛兰素史克与中国生物制药旗下正大天晴达成独家战略合作，加速慢性乙型肝炎在研 ASO 疗法 bepirovirsen 在中国的上市进程。正大天晴负责中国内地的进口、分销、医院准入及推广和非推广活动，GSK 继续担任 MAH，负责监管注册、质量控制、药物警戒及全球医学策略；初始合作期 5.5 年，正大天晴按约定供应条款向 GSK 采购，相关供应计入 GSK 销售收入。","reason","协议划清了正大天晴负责进口分销与医院准入、GSK 保留 MAH 的分工，可据此判断乙肝新药上市阶段的渠道安排。","source",{"_55":56},"publishedAt","2026-05-11T06:00:00.000Z","timelineAt","category","industry","tags",[50,51,52,53,54],"score",72,"selected",true,"channel","news","x","交易/授权","感染/疫苗","GSK","中国生物制药","研发管线","name","GSK 中国·新闻稿","v7n3hdqjiyfwvc5u1qo87h7ux","葛兰素史克与中国生物制药扩大合作，正大天晴负责全再乐和欧乐欣在华商业化","葛兰素史克与中国生物制药扩大战略合作，由旗下正大天晴负责全再乐（氟替美维吸入粉雾剂）和欧乐欣（乌美溴铵维兰特罗吸入粉雾剂）在中国内地的进口、分销、医院准入及推广，覆盖逾9000家医院及基层医疗机构。","协议明确了正大天晴负责进口分销与医院准入、GSK保留MAH的分工，读者可据此判断两款呼吸吸入制剂在基层的准入路径。",{"_55":56},"2026-07-08T04:00:00.000Z",[50,64,52,53],"呼吸","aevjotl03rruq4lrwgazu996t","中国生物制药与Cipla就TQB2102订立独家授权协议","中国生物制药发布自愿公告，宣布与Cipla就TQB2102订立独家授权协议。公告未披露授权区域、首付款与里程碑金额等具体条款。",{"_55":74},"2026-08-31T10:39:00.000Z",[50,53,72,73],56,"ADC","肿瘤","中国生物制药·港交所公告","tjaw0otvjtg1bbjqmg0xj6pli","中国生物制药TQH2722注射液新药上市申请获受理","中国生物制药发布自愿公告，TQH2722注射液的新药上市申请已获受理。公告未披露该药的靶点、适应症及受理机构等具体信息。",{"_55":74},"2026-09-15T23:07:00.000Z",[54,82,53],52,"自免","hfb1gkyjnkslo51pdresk5xjo","中国生物制药与勃林格殷格翰达成70亿美元ADC与TcE授权合作","2026年11月4日，中国生物制药与勃林格殷格翰宣布达成多项目选择权与许可协议，推进基于ADC和T细胞衔接器（TcE）技术的下一代癌症治疗项目。中国生物制药将获得3.58亿美元首付款及近期付款，并有资格获得合计70亿美元的选择权行使、开发、监管及商业化里程碑付款，产品上市后另有阶梯式特许权使用费。","六个临床前项目打包授权，首付款与里程碑结构清晰，可对照国内ADC出海的交易量级。",{"_55":90},"2026-11-04T12:35:56.000Z",[50,73,72,53],"药时代","mrqa4l5bvc0nkkbc3ssjse6gr","中国生物制药与勃林格殷格翰达成战略合作，潜在总金额70亿美元","中国生物制药发布自愿公告，宣布与勃林格殷格翰达成战略合作，潜在总金额70亿美元。公告未披露合作的具体管线、首付款与里程碑结构。","公告披露了中国生物制药与勃林格殷格翰合作的潜在总金额，读者可据此判断这笔交易的体量级别。",{"_55":74},"2026-11-04T08:34:00.000Z","2026-11-05T05:13:30.039Z",[50,53,100],62,"行业趋势","slug","sinobiopharm","group","company","definition","中国生物制药与正大天晴的仿创结合管线、收购整合与集采影响。","brand",{"_122":-5,"_123":124,"_125":114},"total",6,"recent",2,"indexable",false,"latest",{"_28":92,"_121":97},"groupName","药企与机构","poolTotal",23,"at","src","monogram","中","raster",{"_127":128,"_129":-5,"_130":46},"changelogVersion","2026-10-08T08:00","release","staticSite"]
