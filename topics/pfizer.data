[{"_1":2,"_3":4},"root",{"_5":159},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_134":135,"_56":55,"_136":137,"_138":139,"_140":141,"_142":143,"_144":145,"_146":147,"_148":149,"_150":151,"_152":153},"modules",{},"items",[20,21,22,23,24,25,26,27],"page",1,"pageCount","pageSize",20,{"_28":120,"_30":121,"_32":122,"_34":123,"_36":124,"_38":125,"_40":125,"_41":42,"_43":126,"_45":118,"_47":48,"_49":50,"_51":-5},{"_28":110,"_30":111,"_32":112,"_34":113,"_36":114,"_38":115,"_40":116,"_41":42,"_43":117,"_45":118,"_47":48,"_49":50,"_51":-5},{"_28":94,"_30":95,"_32":96,"_34":97,"_36":98,"_38":99,"_40":100,"_41":42,"_43":101,"_45":102,"_47":48,"_49":50,"_51":-5},{"_28":87,"_30":88,"_32":89,"_34":90,"_36":91,"_38":92,"_40":92,"_41":64,"_43":93,"_45":76,"_47":48,"_49":50,"_51":-5},{"_28":77,"_30":78,"_32":79,"_34":80,"_36":81,"_38":82,"_40":82,"_41":42,"_43":83,"_45":84,"_47":48,"_49":50,"_51":-5},{"_28":69,"_30":70,"_32":71,"_34":72,"_36":73,"_38":74,"_40":74,"_41":64,"_43":75,"_45":76,"_47":48,"_49":50,"_51":-5},{"_28":58,"_30":59,"_32":60,"_34":61,"_36":62,"_38":63,"_40":63,"_41":64,"_43":65,"_45":66,"_47":48,"_49":50,"_51":-5},{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":39,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":-5},"id","jrio7n4u57dodxgtyjg1zlboc","title","辉瑞中国获先为达生物埃诺格鲁肽中国大陆独家商业化权益","summary","辉瑞中国与杭州先为达生物就偏向型 GLP-1 受体激动剂埃诺格鲁肽注射液达成商业化战略合作，辉瑞获得该产品在中国大陆的独家商业化权益，先为达生物作为药品上市许可持有人负责研发、注册、生产及供应，并将有权获得最高可达 4.95 亿美元的付款总额，包括首付款、注册及销售里程碑付款。","reason","协议披露了首付款与里程碑结构、双方分工，以及埃诺格鲁肽已获批和减重适应症在审的进度。","source",{"_56":57},"publishedAt","2026-02-23T16:00:00.000Z","timelineAt","category","industry","tags",[52,53,54,55],"score",78,"selected",true,"channel","news","x","交易/授权","代谢/减重","GLP-1","辉瑞","name","辉瑞中国·新闻稿","kynwph2l67jyb9b9v29bh2fx0","辉瑞埃诺格鲁肽（先维盈®）获NMPA批准用于中国成人体重管理","NMPA批准辉瑞新一代cAMP偏向型GLP-1受体激动剂埃诺格鲁肽注射液（先维盈®），用于在控制饮食和增加体力活动基础上对成人超重/肥胖患者进行长期体重管理。III期SLIMMER研究纳入664名中国受试者，治疗48周后最高剂量组（2.4mg）平均体重下降15.4%，92.8%的受试者减重超过5%，因不良事件导致的治疗中断率为2%。","原文给出SLIMMER研究48周减重15.4%、中断率2%等具体数据，可据此判断该药在体重管理中的定位。",{"_56":57},"2026-03-05T16:00:00.000Z","approval",[67,53,54,68,55],74,"获批上市","NMPA","ascwpj300zm91zo6w1hjokih7","辉瑞cAMP偏向型GLP-1埃诺格鲁肽在中国上市，用于2型糖尿病与长期体重管理","辉瑞中国宣布新一代cAMP偏向型GLP-1受体激动剂先维盈®（埃诺格鲁肽注射液）在中国正式上市，获NMPA批准用于成人2型糖尿病患者血糖控制，以及在控制饮食和增加体力活动基础上对成人超重/肥胖患者的长期体重管理。","原文给出获批的两项适应症与SLIMMER研究48周减重数据，可据此判断该药在减重市场的定位。",{"_56":57},"2026-05-30T16:00:00.000Z",[67,54,53,68,55],62,"nxxsb9krnnhtrz0yxri48yrb4","辉瑞乐复诺（利特昔替尼）价格调整落地，面向重度斑秃患者","辉瑞中国宣布乐复诺（利特昔替尼）价格调整正式落地，目的是降低重度斑秃患者的治疗负担、提升创新疗法可及性。利特昔替尼是高选择性JAK3/TEC激酶家族双靶点抑制剂，据《中国斑秃诊断与治疗指南（2026版）》，JAK抑制剂为重度斑秃一线系统治疗方案，我国斑秃患病人数约349万、患病率约0.27%。辉瑞称该药已积累3年长期持久疗效数据与6年长期安全性数据，公司主动向全球总部争取支持推动此次调价。","原文交代了利特昔替尼降价背后的患者负担与指南一线定位，可看出重度斑秃靶向治疗的可及性变化。",{"_56":57},"2026-08-31T16:00:00.000Z",[85,86,55],55,"公司动态","自免","eh4rq7h6ilpzfalx705ggbwvr","辉瑞先维盈（埃诺格鲁肽注射液）在华获批新增 2 型糖尿病适应症","NMPA 批准先维盈（埃诺格鲁肽注射液，2.0mg/ml、1.2ml 预填充注射笔）增加成人 2 型糖尿病适应症，覆盖血糖控制与超重或肥胖患者长期体重管理两项需求。","原文列出获批适应症与两项 III 期研究的具体终点数值，可据此判断该药在糖胖共病人群中的定位。",{"_56":57},"2026-10-11T16:00:00.000Z",[67,53,54,68,55],"wq2nqezlgrnos0d5m3m6et8w1","辉瑞将舒普深国内推广交给第三方CSO，康新博划入核心医院急症BU","据行业消息，辉瑞中国将注射用头孢哌酮钠舒巴坦钠（舒普深）的国内推广整体交给第三方CSO，不再由自有销售队伍覆盖；同属抗感染矩阵的艾沙康唑（康新博）则从广阔市场团队划入核心医院急症BU。","从舒普深转交CSO切入，梳理外企成熟原研药在集采常态化下的处置路径与取舍标准。",{"_56":109},"2026-11-03T04:05:26.000Z","2026-11-03T15:30:38.245Z",[85,103,55,104,105,106,107,108],72,"抗菌药物","市场/销售","抗感染","企业竞争","对市场","对销售","医药云端工作室","xftkwqqgcq9ehq1g9qm73wzkh","黑石生命科学最高投入15亿美元，支持辉瑞GLP-1在研药Berobenatide开发","2026年11月11日，辉瑞与黑石生命科学达成研发共担战略融资协议，黑石旗下管理基金将在2028年前最高投入15亿美元，支持一月一次给药的GLP-1受体激动剂多肽Berobenatide（PF'3944）开发。","黑石以研发共担方式注资辉瑞GLP-1管线，读者可据此了解该资产的资金来源与权属安排。",{"_56":119},"2026-11-12T03:22:34.000Z","2026-11-12T14:18:51.329Z",[52,53,54,55],58,"药时代","ur7psg8u9pifv5lugm61i0b2j","默沙东、礼来、艾伯维、辉瑞、BMS 向美国众议院委员会表示不在新疆及解放军关联医院启动新临床试验","美国众议院中国问题特别委员会披露，默沙东、礼来、艾伯维、辉瑞、BMS 五家药企已书面表示，不计划在中国新疆地区或与中国军方关联的医院启动新的临床试验点。该委员会去年 6 月对上述五家公司展开调查，关注试验点的知识产权暴露、军方关联与伦理标准问题；五家公司均表示不会在与解放军关联的试验点启动新临床研究。","美国众议院委员会调查五家跨国药企在华临床试验，企业以书面承诺回应，反映地缘政治对试验布局的影响。",{"_56":133},"2026-11-20T00:00:00.000Z",[85,127,128,129,130,131,55,132],"行业趋势","FDA","默沙东","礼来","艾伯维","BMS","STAT","slug","pfizer","group","company","definition","辉瑞的获批与管线进展、并购整合（含 Seagen）与疫苗业务的持续追踪。","brand",{"_155":-5,"_156":157,"_158":147},"total",8,"recent",3,"indexable",false,"latest",{"_30":121,"_154":125},"groupName","药企与机构","poolTotal",15,"at","src","monogram","辉","raster",{"_160":161,"_162":-5,"_163":48},"changelogVersion","2026-10-08T08:00","release","staticSite"]
