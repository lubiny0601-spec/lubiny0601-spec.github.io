[{"_1":2,"_3":4},"root",{"_5":150},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_131":132,"_56":53,"_133":134,"_135":136,"_137":-5,"_138":139,"_140":141,"_142":143,"_144":145,"_146":147,"_148":65},"modules",{},"items",[20,21,22,23,24,25,26,27],"page",1,"pageCount","pageSize",20,{"_28":121,"_30":122,"_32":123,"_34":124,"_36":125,"_38":126,"_40":126,"_41":63,"_43":127,"_45":108,"_47":48,"_49":50,"_51":-5},{"_28":112,"_30":113,"_32":114,"_34":115,"_36":116,"_38":117,"_40":118,"_41":63,"_43":119,"_45":46,"_47":48,"_49":50,"_51":-5},{"_28":100,"_30":101,"_32":102,"_34":103,"_36":104,"_38":105,"_40":106,"_41":63,"_43":107,"_45":108,"_47":48,"_49":50,"_51":-5},{"_28":88,"_30":89,"_32":90,"_34":91,"_36":92,"_38":93,"_40":94,"_41":63,"_43":95,"_45":96,"_47":48,"_49":50,"_51":-5},{"_28":81,"_30":82,"_32":83,"_34":-5,"_36":84,"_38":85,"_40":85,"_41":63,"_43":86,"_45":87,"_47":48,"_49":50,"_51":-5},{"_28":69,"_30":70,"_32":71,"_34":72,"_36":73,"_38":74,"_40":74,"_41":63,"_43":75,"_45":76,"_47":48,"_49":50,"_51":-5},{"_28":58,"_30":59,"_32":60,"_34":-5,"_36":61,"_38":62,"_40":62,"_41":63,"_43":64,"_45":65,"_47":48,"_49":50,"_51":-5},{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":39,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":-5},"id","u2s7fftpprobv7ons55e6jkqd","title","欧加隆两款药品新纳入2026版国家基本药物目录，另有6款保留","summary","《国家基本药物目录（2026年版）》纳入欧加隆的依折麦布片（益适纯）和孟鲁司特（顺尔宁），并保留辛伐他汀、依那普利、米氮平、阿仑膦酸钠、非那雄胺和糠酸莫米松鼻喷雾剂6款产品，新版目录自2026年9月1日起施行。依折麦布用于原发性高胆固醇血症、HoFH及谷甾醇血症，孟鲁司特用于哮喘预防与长期治疗及过敏性鼻炎症状缓解。","reason","新版基药目录纳入与保留的品种清单，可帮助判断慢病用药在基层市场的准入格局变化。","source",{"_56":57},"publishedAt","2026-07-08T16:00:00.000Z","timelineAt","category","policy","tags",[52,53,54,55],"score",52,"selected",true,"channel","news","x","政策/监管","心血管","呼吸","医保/集采","name","欧加隆中国·新闻","c8ufm7fzpaihxmidz4zkf48bo","上海医药瑞舒伐他汀依折麦布片（Ⅰ）获批准生产","上海医药集团股份有限公司公告，瑞舒伐他汀依折麦布片（Ⅰ）获得批准生产。公告未披露适应症、批准机构与审评依据等具体信息。",{"_56":68},"2026-07-30T16:00:00.000Z","approval",[66,53,67],62,"获批上市","上海医药","上海医药·公司公告","xroj3yedpys47xlpu0l0n68g3","东北制药子公司恩格列净片获药品注册证书","东北制药全资子公司东北制药集团沈阳第一制药有限公司收到NMPA核准签发的恩格列净片《药品注册证书》，规格10mg，化学药品4类，批准文号国药准字H20265837，有效期至2031年09月01日。恩格列净为SGLT-2抑制剂，该品种用于治疗2型糖尿病、心力衰竭和慢性肾脏病。公司称此次获批有利于丰富产品管线并带来新的市场机会。","公告披露了恩格列净片获批的规格、注册分类与批准文号有效期，可据此判断这款仿制药的上市节奏。",{"_56":80},"2026-09-15T16:00:00.000Z",[66,77,53,78,79],51,"代谢/减重","肾病","东北制药","东北制药·公司公告","tz1822o8txlfrojkhksmivl5q","上海医药氯维地平乳状注射液获批准生产","上海医药集团股份有限公司公告，氯维地平乳状注射液获得批准生产。公告未披露适应症、批准文号及审评依据等具体信息。",{"_56":68},"2026-10-09T16:00:00.000Z",[66,53,67],55,"w93qhyfbqki9yidnocdw3ty4m","国家药监局批准拜耳阿舒克森片上市，用于降低缺血性卒中及高风险TIA患者卒中风险","国家药监局通过优先审评审批程序批准Bayer AG申报的1类创新药阿舒克森片（商品名舒华博）上市，用于降低缺血性卒中或高风险短暂性脑缺血发作（TIA）成人患者的卒中风险，不包括心源性栓塞型卒中患者。该药为患者提供了新的治疗选择。","原文交代了获批适应症与优先审评通道，读者可据此判断该药在卒中二级预防中的定位。",{"_56":99},"2026-10-26T00:00:00.000Z","2026-10-27T13:29:45.248Z",[66,53,97,98],60,"拜耳","NMPA","中国食品药品网·要闻","isf4rwjr6b7h76v7w18kbidfi","拜耳 Factor XIa 抑制剂 asundexian 获 FDA 批准，商品名 Sunharbo，用于卒中二级预防","FDA 批准拜耳的口服 Factor XIa 抑制剂 asundexian（商品名 Sunharbo）用于特定成人患者的卒中二级预防，需与抗血小板治疗联用。支持获批的研究入组逾 12,000 名既往发生预警性卒中或心源性以外血栓性卒中的成人，一半接受安慰剂、一半每日一次 Sunharbo，结果显示缺血性卒中风险较对照组降低 26%，两组大出血例数相近，最常见不良反应为腹泻。","FDA 批准拜耳 asundexian 用于卒中二级预防，关键三期数据同时给出疗效幅度与出血风险对比。",{"_56":111},"2026-11-09T22:40:00.000Z","2026-11-11T14:10:21.623Z",[66,53,109,110,97],58,"小分子","FDA","BioPharma Dive","m8yxhluifdxx2eo4404i03yyk","NMPA通过优先审评批准芮弗西拜单抗注射液（皮下注射）上市，用于HoFH","国家药监局通过优先审评审批程序批准北京盛迪医药有限公司申报的芮弗西拜单抗注射液（皮下注射）（商品名：艾轻达）上市，可与低脂饮食和其他降脂药物合用，用于治疗成人和12岁及以上青少年的纯合子型家族性高胆固醇血症（HoFH），以降低LDL-C水平。该品种为相关患者提供了新的治疗选择。","原文交代了获批适应症与优先审评通道，读者可据此判断该药在HoFH降脂治疗中的定位。",{"_56":99},"2026-11-12T00:00:00.000Z","2026-11-12T14:18:47.930Z",[66,120,53,98],"罕见病","lw2wnumh8jawt4jlowu9g512y","恒瑞医药芮弗西拜单抗（艾轻达）获NMPA批准用于纯合子型家族性高胆固醇血症","恒瑞医药子公司北京盛迪医药的1类创新药芮弗西拜单抗注射液（商品名艾轻达）获NMPA批准上市，与低脂饮食和其他降脂药物合用，用于成人和12岁及以上青少年的纯合子型家族性高胆固醇血症（HoFH）降LDL-C。","原文给出获批适应症与III期终点数值，读者可据此判断这款非LDLR依赖降脂药在HoFH治疗中的位置。",{"_56":130},"2026-11-13T00:00:00.000Z",[66,120,53,128,129,98],"抗体/双抗","恒瑞医药","恒瑞医药·新闻","slug","cardiovascular","group","field","definition","心血管与代谢：降脂新药、抗凝、心衰与高血压领域的药物与器械进展。","brand","total",8,"recent",4,"indexable",false,"latest",{"_30":122,"_149":126},"groupName","治疗领域","poolTotal","at",{"_151":152,"_153":-5,"_154":48},"changelogVersion","2026-10-08T08:00","release","staticSite"]
