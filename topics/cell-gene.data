[{"_1":2,"_3":4},"root",{"_5":163},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_143":144,"_62":58,"_145":146,"_147":148,"_149":-5,"_150":151,"_152":153,"_154":155,"_156":157,"_158":159,"_160":161},"modules",{},"items",[20,21,22,23,24,25,26,27,28],"page",1,"pageCount","pageSize",20,{"_29":133,"_31":134,"_33":135,"_35":136,"_37":137,"_39":138,"_41":139,"_42":43,"_44":140,"_46":47,"_48":49,"_50":51,"_52":-5},{"_29":121,"_31":122,"_33":123,"_35":124,"_37":125,"_39":126,"_41":127,"_42":128,"_44":129,"_46":130,"_48":49,"_50":51,"_52":-5},{"_29":114,"_31":115,"_33":116,"_35":117,"_37":118,"_39":112,"_41":112,"_42":43,"_44":119,"_46":120,"_48":49,"_50":51,"_52":-5},{"_29":107,"_31":108,"_33":109,"_35":110,"_37":111,"_39":112,"_41":112,"_42":43,"_44":113,"_46":47,"_48":49,"_50":51,"_52":-5},{"_29":94,"_31":95,"_33":96,"_35":97,"_37":98,"_39":99,"_41":100,"_42":101,"_44":102,"_46":71,"_48":49,"_50":51,"_52":-5},{"_29":84,"_31":85,"_33":86,"_35":87,"_37":88,"_39":89,"_41":89,"_42":90,"_44":91,"_46":82,"_48":49,"_50":51,"_52":-5},{"_29":75,"_31":76,"_33":77,"_35":78,"_37":79,"_39":80,"_41":80,"_42":43,"_44":81,"_46":82,"_48":49,"_50":51,"_52":-5},{"_29":64,"_31":65,"_33":66,"_35":67,"_37":68,"_39":69,"_41":69,"_42":43,"_44":70,"_46":71,"_48":49,"_50":51,"_52":-5},{"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":40,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":-5},"id","rhpuafwd0otkft0c28p6bm7xb","title","2025国谈结果公布：114个药品新增进基本医保，19个进入商保创新药目录","summary","国家医保局公布2025国谈调整结果，基本医保目录新增114个药品、成功率达88%（2024年为76%），29个药品因临床没有供应或可被其他药物更好替代被调出；商保创新药目录首次新增19个药品，成功率约79%，2025版目录自2026年1月1日起实施。","reason","原文列出基本医保与商保创新药目录的新增数量、成功率和调出原因，可据此判断今年准入口径的变化。","source",{"_62":63},"publishedAt","2025-12-08T00:00:00.000Z","timelineAt","category","policy","tags",[53,54,55,56,57,58,59,60,61],"score",88,"selected",true,"channel","news","x","政策/监管","医保/集采","国家医保局","肿瘤","罕见病","细胞与基因治疗","百济神州","复星医药","罗氏","name","米内网·政策","okucl0ks31e3w0mi23egcpclw","商务部、科技部就修订《中国禁止出口限制出口技术目录》征求意见，拟增列细胞和基因治疗、小核酸药等5项生物医药技术","商务部会同科技部10月16日就修订《中国禁止出口限制出口技术目录》公开征求意见，生物医药领域拟增列细胞和基因治疗、小核酸药、病原微生物相关5项技术，其中拟禁止出口3项、拟限制出口2项。","目录修订把细胞和基因治疗、siRNA 平台技术纳入出口管制，读者可据此判断技术出海与授权交易的合规边界。",{"_62":74},"2026-10-19T00:00:00.000Z",[53,58,72,73],55,"核酸药物","行业趋势","中国食品药品网·要闻","ptoispp2cqtaeg8xu3p67rjrj","商务部拟对细胞与基因治疗、siRNA 等平台实施出口管制，创新药出海交易结构面临调整","商务部 10 月 16 日公布《中国禁止出口限制出口技术目录》修订草案，拟禁止外国收购专有的细胞与基因治疗、siRNA 及病原体功能获得性研究平台，并限制将这两类领域的专有靶点识别与验证技术完整转让给境外实体。","草案把禁止与限制落在平台所有权转让上，对外许可仍走便利通道，读者可据此判断出海交易结构怎么选。",{"_62":83},"2026-10-19T10:27:12.000Z",[53,58,72,73],62,"药时代","tg2cok96qfczuiws94nixuvod","NMPA 批准艺妙神州泊基奥仑赛注射液（赛泊华）上市，用于复发或难治性大B细胞淋巴瘤","国家药监局批准北京艺妙神州生物医药股份有限公司申报的泊基奥仑赛注射液（商品名：赛泊华）上市，用于经过二线或以上系统性治疗后成人复发或难治性大B细胞淋巴瘤患者，包括弥漫性大B细胞淋巴瘤非特指型、3b级滤泡性淋巴瘤和高级别B细胞淋巴瘤。该品种的上市为相关患者提供了新的治疗选择。","国内又一款 CAR-T 产品获批，适应症覆盖二线及以上复发难治大B细胞淋巴瘤的多个亚型。",{"_62":74},"2026-11-06T00:00:00.000Z","approval",[92,56,58,93],"获批上市","NMPA","kbcy714srsvfzczgzohs8pu6z","香雪制药被两名债权人申请破产重整，广药资本中选四个多月仍未签约","香雪制药公告收到广州中院送达的两份拟申请破产重整通知书，广州农商行黄埔支行、广州高新区融资租赁拟以债权人身份申请重整，截至11月10日公司尚未收到法院启动或受理重整申请的文件。","从债权人申请重整、广药资本中选未签约到收入结构变化，呈现这家老牌中药企业重整的完整时间线。",{"_62":106},"2026-11-12T12:00:34.000Z","2026-11-12T14:31:15.869Z","industry",[103,104,58,105],"公司动态","中药","投融资","赛柏蓝","wfoeljat93672svyxkzmsuht2","国家医保局发布2026年版医保药品目录及商保创新药目录，新增107种药品","国家医保局、人力资源社会保障部于11月14日印发《国家基本医疗保险、生育保险和工伤保险药品目录（2026年）》及《商业健康保险创新药品目录（2026年）》，共新增107种药品，其中51个为1类创新药，同时调出34种药品，目录净增78个编号、总数达3331个。","2026年医保目录新增107种药品、51个1类创新药，CAR-T与血友病非因子类药物首次进入基本医保，读者可据此判断创新药的准入路径与支付口径。",{"_62":74},"2026-11-14T00:00:00.000Z",[53,54,55,56,57,58],"x92un5xr4q0bjusu9nepao4hi","新版双目录发布：基本医保目录新增107种药品，商保创新药目录累计28种","11月14日发布的2026版基本医保目录新增107种药品，含51个1类创新药，覆盖肿瘤、罕见病、精神类疾病等领域，目录累计3331种药品。商保创新药目录新增12种，累计28种，包括全球首个实体瘤CAR-T、中国首个血友病基因治疗药物等。首版商保目录中有2款创新药转入新版基本医保目录，形成商保先行探索、基本医保适时衔接的转化路径。","新版双目录同时公布新增品种与商保向基本医保的转化路径，可看清创新药准入的两个通道如何衔接。",{"_62":74},[53,54,55,56,57,58],85,"x0xqs42xpeuukznbms8x3f0je","药明巨诺瑞基奥仑赛降至30万元以内进基本医保，成首个纳入的CAR-T","2026版国家医保目录公布，药明巨诺瑞基奥仑赛（倍诺达）从129万元一支谈至30万元以内，成为国内首个进入基本医保的CAR-T，新版目录明年1月1日执行。降价底气来自慢病毒载体国产化，单支成本压到二十多万，按出厂价29万、成本约22万测算毛利率约25%。","从成本国产化到支付分层，拆解了CAR-T进医保后放量受产能与质控制约的现实条件。",{"_62":132},"2026-11-15T04:07:46.000Z","2026-11-16T01:00:36.137Z","opinion",[131,54,58,55],78,"观点/解读","医药云端工作室","xjj8fe3psbbncixaonjtb0mc1","国家医保局发布2026版医保药品目录与第二批商保创新药目录，新增107种药品","国家医保局公布2026年国家医保药品目录和商保创新药目录，医保目录新增107种药品（含51种1类创新药）、调出34种，目录总数达3331个；商保创新药目录新纳入11家药企的12种药品，调整后共28种。","通知写清了新增药品挂网时限、药事会节点与商保目录支付边界，准入人员可据此排落地节奏。",{"_62":132},"2026-11-14T04:44:12.000Z","2026-11-16T01:00:42.298Z",[53,54,55,56,57,58,141,142],"抗感染","市场准入","slug","cell-gene","group","field","definition","CAR-T、TCR-T、干细胞与体内外基因治疗的技术突破、安全性与商业化难题。","brand","total",9,"recent",6,"indexable",false,"latest",{"_31":134,"_162":139},"groupName","治疗领域","poolTotal",95,"at",{"_164":165,"_166":-5,"_167":49},"changelogVersion","2026-10-08T08:00","release","staticSite"]
