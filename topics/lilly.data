[{"_1":2,"_3":4},"root",{"_5":143},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_118":119,"_53":52,"_120":121,"_122":123,"_124":125,"_126":127,"_128":129,"_130":131,"_132":133,"_134":135,"_136":137},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":108,"_28":109,"_30":110,"_32":111,"_34":112,"_36":113,"_38":113,"_39":40,"_41":114,"_43":44,"_45":46,"_47":48,"_49":-5},{"_26":95,"_28":96,"_30":97,"_32":98,"_34":99,"_36":100,"_38":101,"_39":102,"_41":103,"_43":104,"_45":46,"_47":48,"_49":-5},{"_26":82,"_28":83,"_30":84,"_32":85,"_34":86,"_36":87,"_38":88,"_39":89,"_41":90,"_43":44,"_45":46,"_47":48,"_49":-5},{"_26":67,"_28":68,"_30":69,"_32":70,"_34":71,"_36":72,"_38":73,"_39":40,"_41":74,"_43":75,"_45":46,"_47":48,"_49":-5},{"_26":55,"_28":56,"_30":57,"_32":58,"_34":59,"_36":60,"_38":60,"_39":40,"_41":61,"_43":62,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","epoojo4s7nbifq9nveggd9mg2","title","剂泰科技与礼来达成AI驱动LNP递送技术合作，里程碑总额最高11亿美元","summary","剂泰科技10月19日宣布与礼来达成战略合作，基于NanoForge平台下的AiLNP平台研发提升组织靶向性与体内分布的新一代LNP递送技术，礼来负责投入药物发现、开发及商业化资源。","reason","协议披露了首付款、里程碑总额与销售分成结构，可对照礼来此前在AI与递送领域的多笔合作看其技术拼图。","source",{"_53":54},"publishedAt","2026-10-20T05:34:08.000Z","timelineAt","category","industry","tags",[50,51,52],"score",58,"selected",true,"channel","news","x","交易/授权","核酸药物","礼来","name","药时代","alixbyfav8xfnwxzlzjs66uzc","礼来Q3营收243.97亿美元，替尔泊肽系列前三季度合计437.68亿美元","礼来公布2026年三季度财报，Q3单季营收243.97亿美元（+39%），净利润64.51亿美元（+16%），全年营收指引上调至910-920亿美元。替尔泊肽系列前三季度合计收入437.68亿美元，其中降糖版Mounjaro 293.28亿美元（+89%）、减重版Zepbound 144.40亿美元（+56%），占总营收65%。","礼来Q3财报里替尔泊肽两款产品合计贡献65%营收，中国区以价换量后的增速值得对照看。",{"_53":54},"2026-10-30T10:18:36.000Z",[63,64,65,66,52],67,"公司动态","市场/销售","代谢/减重","GLP-1","j4zrr31ulofr0ili2zybn9ysp","礼来、阿斯利康等五家MNC公布2026年三季报，中国区表现分化","礼来、阿斯利康、默沙东、BMS、吉利德五家MNC公布2026年三季报，礼来Q3营收243.97亿美元、同比增长39%，市值首破1.3万亿美元。替尔泊肽降糖版与减重版前三季度合计437.68亿美元、占总营收65%，中国区Q3收入9.47亿美元、同比增69%，穆峰达2型糖尿病适应症2026年1月纳入国家医保后最低规格月治疗费降至324.1元。","五家MNC三季报横向对照，中国区被单列成三种状态，可看清医保准入与集采对同一批品种的不同作用。",{"_53":81},"2026-11-02T01:42:02.000Z","2026-11-02T13:59:16.230Z",[64,76,65,77,66,52,78,79,80],62,"行业趋势","肿瘤","阿斯利康","默沙东","BMS","医药云端工作室","cy615dx5b3ywgwqj1m58mizck","FDA 要求所有 GLP-1 药物说明书新增 NAION 眼病风险警示，涉及司美格鲁肽、替尔泊肽","11 月 9 日，FDA 要求所有 GLP-1 受体激动剂上市许可持有人在美国说明书“警告和注意事项”部分增加非动脉炎性前部缺血性视神经病变（NAION）潜在风险信息，范围从司美格鲁肽扩至替尔泊肽及 2026 年获批的口服小分子 Foundayo。","FDA 把 NAION 警示从司美格鲁肽扩至全部 GLP-1 药物，读者可据此了解说明书修订范围与各国监管口径差异。",{"_53":94},"2026-11-10T11:54:18.000Z","2026-11-11T08:18:17.999Z","policy",[91,66,65,92,93,52],"政策/监管","FDA","诺和诺德","赛柏蓝","q56n158sih0xekrn9fagxizza","NMPA批准礼来奥氟格列隆钙片（穆优达）上市用于成人长期体重管理","国家药监局批准EliLilly Nederland B.V.申报的1类创新药奥氟格列隆钙片（商品名穆优达）上市，用于在控制饮食和增加运动基础上对成人进行长期体重管理。适用人群为BMI≥30 kg/m2的肥胖成人，或BMI≥27 kg/m2至<30 kg/m2且伴有至少一种体重相关合并症（如高血压、血脂异常、高血糖、阻塞性睡眠呼吸暂停综合征、心血管疾病等）的超重成人。","原文给出了获批的适应症与BMI门槛，读者可据此判断该药在国内减重市场的准入范围。",{"_53":107},"2026-11-12T00:00:00.000Z","2026-11-12T14:18:47.921Z","approval",[105,65,106,52],63,"获批上市","NMPA","中国食品药品网·要闻","ur7psg8u9pifv5lugm61i0b2j","默沙东、礼来、艾伯维、辉瑞、BMS 向美国众议院委员会表示不在新疆及解放军关联医院启动新临床试验","美国众议院中国问题特别委员会披露，默沙东、礼来、艾伯维、辉瑞、BMS 五家药企已书面表示，不计划在中国新疆地区或与中国军方关联的医院启动新的临床试验点。该委员会去年 6 月对上述五家公司展开调查，关注试验点的知识产权暴露、军方关联与伦理标准问题；五家公司均表示不会在与解放军关联的试验点启动新临床研究。","美国众议院委员会调查五家跨国药企在华临床试验，企业以书面承诺回应，反映地缘政治对试验布局的影响。",{"_53":117},"2026-11-20T00:00:00.000Z",[63,76,92,79,52,115,116,80],"艾伯维","辉瑞","STAT","slug","lilly","group","company","definition","礼来的减重与糖尿病管线、产能扩张、阿尔茨海默病与肿瘤领域的进展。","brand",{"_139":-5,"_140":141,"_142":131},"total",6,"recent",5,"indexable",false,"latest",{"_28":109,"_138":113},"groupName","药企与机构","poolTotal",27,"at","src","monogram","礼","raster",{"_144":145,"_146":-5,"_147":46},"changelogVersion","2026-10-08T08:00","release","staticSite"]
