[{"_1":2,"_3":4},"root",{"_5":95},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443578000,{"_71":72,"_51":48,"_73":74,"_75":76,"_77":78,"_79":80,"_81":16,"_82":83,"_84":85,"_86":87,"_88":89},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":53,"_24":54,"_26":55,"_28":56,"_30":57,"_32":58,"_34":59,"_35":60,"_37":61,"_39":62,"_41":42,"_43":44,"_45":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":33,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5},"id","j9tir96eg7npsh9zt7w8jzhht","title","华东医药环孢素软胶囊、他克莫司胶囊、美沙拉秦肠溶片拟中选第十二批国家集采","summary","华东医药及子公司中美华东、西安博华参与第十二批国家集采投标，环孢素软胶囊、他克莫司胶囊、美沙拉秦肠溶片拟中选，采购周期自执行之日起至2029年12月31日。上述拟中选产品2025年度合计销售收入约20.76亿元，占公司营业收入4.76%、医药工业营业收入（含CSO业务）14.04%。","reason","公告同时列出拟中选与未中选品种的收入占比，读者可据此判断第十二批集采对华东医药的院内基本盘影响。","source",{"_51":52},"publishedAt","2026-08-02T16:00:00.000Z","timelineAt","category","policy","tags",[46,47,48,49,50],"score",78,"selected",true,"channel","news","x","政策/监管","医保/集采","华东医药","抗感染","市场准入","name","华东医药·公司公告","jmz88r1urpgnnp9pwu29er5lg","华东医药前三季营收超330亿元，6款新药报产在审、9款进入III期临床","华东医药2026年前三季营业收入超过330亿元、净利润27.72亿元，业绩双增长；2026年至今获批1个生物药3.3类新药和5个仿制药新品，另有6款新药报产在审、9款新药进入III期临床。","梳理华东医药三季报后的管线节奏，读者可对照其GLP-1与ADC项目的临床与报产时间点。",{"_51":70},"2026-10-30T00:00:00.000Z","2026-10-30T11:06:56.082Z","industry",[63,64,65,66,67,48,68,69],50,"公司动态","研发管线","代谢/减重","肿瘤","自免","GLP-1","ADC","米内网·企业","slug","huadong","group","company","definition","华东医药的减重与医美管线、医工商一体化与并购整合进展。","brand",{"_91":-5,"_92":93,"_94":83},"total",2,"recent","indexable",false,"latest",{"_24":54,"_90":59},"groupName","药企与机构","poolTotal",26,"at","src","monogram","华","raster",{"_96":97,"_98":-5,"_99":42},"changelogVersion","2026-10-08T08:00","release","staticSite"]
