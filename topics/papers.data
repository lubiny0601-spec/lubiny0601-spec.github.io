[{"_1":2,"_3":4},"root",{"_5":159},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443580000,{"_138":139,"_61":140,"_141":142,"_143":144,"_145":-5,"_146":147,"_148":149,"_150":151,"_152":153,"_154":155,"_156":157},"modules",{},"items",[20,21,22,23,24,25,26,27,28],"page",1,"pageCount","pageSize",20,{"_29":131,"_31":132,"_33":133,"_35":134,"_37":135,"_39":128,"_41":136,"_42":69,"_44":137,"_46":121,"_48":49,"_50":51,"_52":-5},{"_29":123,"_31":124,"_33":125,"_35":126,"_37":127,"_39":128,"_41":129,"_42":69,"_44":130,"_46":71,"_48":49,"_50":51,"_52":-5},{"_29":113,"_31":114,"_33":115,"_35":116,"_37":117,"_39":118,"_41":119,"_42":69,"_44":120,"_46":121,"_48":49,"_50":51,"_52":-5},{"_29":104,"_31":105,"_33":106,"_35":107,"_37":108,"_39":109,"_41":109,"_42":69,"_44":110,"_46":71,"_48":49,"_50":51,"_52":-5},{"_29":96,"_31":97,"_33":98,"_35":99,"_37":100,"_39":101,"_41":101,"_42":69,"_44":102,"_46":103,"_48":49,"_50":51,"_52":-5},{"_29":87,"_31":88,"_33":89,"_35":90,"_37":91,"_39":92,"_41":93,"_42":69,"_44":94,"_46":82,"_48":49,"_50":51,"_52":-5},{"_29":75,"_31":76,"_33":77,"_35":78,"_37":79,"_39":80,"_41":80,"_42":69,"_44":81,"_46":82,"_48":49,"_50":51,"_52":-5},{"_29":63,"_31":64,"_33":65,"_35":66,"_37":67,"_39":68,"_41":68,"_42":69,"_44":70,"_46":71,"_48":49,"_50":51,"_52":-5},{"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":40,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":-5},"id","mseoethc3gxuo1g1x8wpzwyy8","title","舒巴坦-度洛巴坦对比黏菌素治疗碳青霉烯耐药鲍曼不动杆菌感染达到非劣效","summary","III 期 ATTACK 试验中，舒巴坦-度洛巴坦对比黏菌素治疗碳青霉烯耐药鲍曼不动杆菌感染，主要终点 28 天全因死亡率达到统计学非劣效：舒巴坦-度洛巴坦组 63 例中 12 例（19%），黏菌素组 62 例中 20 例（32%），差异 –13.2%（95% CI –30.0 至 3.5）。","reason","III 期 ATTACK 试验显示该复方在 28 天全因死亡率上不劣于黏菌素，肾毒性更低，可对照耐药鲍曼不动杆菌的用药选择。","source",{"_61":62},"publishedAt","2023-05-12T17:15:43.184Z","timelineAt","category","clinical","tags",[53,54,55,56,57,58,59,60],"score",48,"selected",true,"channel","news","x","临床进展","抗菌药物","耐药与院感","论文/研究","抗感染","循证指南","对市场","FDA","name","Contagion Live·医院感染","zk7i4gzm8t9djvrcatrwy1sq5","中国疾控发布2026年第41周全国急性呼吸道传染病哨点监测情况","2026年第41周（10月5日—10月11日），全国哨点医院门急诊流感样病例百分比为3.8%，南方省份4.6%高于北方省份3.0%。216家多病原监测哨点医院门急诊流感样病例样本阳性率前三位为流感病毒13.6%、鼻病毒11.2%、肠道病毒3.9%，住院严重急性呼吸道感染病例为鼻病毒9.3%、流感病毒4.3%、人偏肺病毒4.1%。","中国疾控第41周哨点监测给出流感病毒13.6%的阳性率与南北差异，可据此判断秋冬呼吸道感染的流行节奏。",{"_61":74},"2026-10-15T00:00:00.000Z","research",[56,72,73],58,"感染/疫苗","呼吸","中国疾控·急性呼吸道传染病哨点监测","l8nqjwlg8uereiywics27ncpx","恒瑞医药瑞拉芙普α一线治疗HER2阴性晚期胃癌III期RELIGHT研究登JCO","恒瑞医药PD-L1/TGF-βRⅡ双特异性抗体融合蛋白瑞拉芙普α（SHR-1701）联合CAPOX一线治疗HER2阴性晚期胃/胃食管结合部腺癌的III期RELIGHT研究发表于JCO。","RELIGHT研究在JCO发表，给出CPS≥5与ITT人群的OS、PFS及ORR数值，可对照现有PD-1联合化疗的获益幅度。",{"_61":86},"2026-10-20T00:00:00.000Z",[56,83,84,85],47,"肿瘤","抗体/双抗","恒瑞医药","恒瑞医药·新闻","nev77hncq8jrgndw2l8dqmxnk","中国流感监测周报第932期：第43周报告145起流感样病例暴发疫情","截至2026年10月25日的一周，南方省份流感病毒检测阳性率略有下降、北方省份略有上升，全国共报告145起流感样病例暴发疫情。全国检出阳性样本中甲型占67.6%、乙型占32.4%，甲型中A(H3N2)占67.2%、A(H1N1)pdm09占32.8%，乙型均为B（Victoria）系。","周报给出南北阳性率分化、暴发疫情数与毒株耐药比例，可用于判断当季流感用药与疫苗匹配情况。",{"_61":95},"2026-10-28T00:00:00.000Z","2026-10-29T14:00:45.453Z",[56,72],"中国疾控·流感监测周报","k9ikqiralh5w95f28tr07kefz","中国流感监测周报第933期：北方阳性率上升，甲流占65.4%","中国疾控发布2026年第44周流感监测周报，截至11月1日，南方省份流感病毒检测阳性率略有下降、北方省份上升，全国检出阳性样本中甲型占65.4%、乙型占34.6%，共报告106起流感样病例暴发疫情。","周报给出南北省份阳性率分化、甲乙流构成与毒株抗原性、耐药监测结果，可作为流感季用药与疫苗匹配判断的当期依据。",{"_61":95},"2026-11-05T00:00:00.000Z",[56,72,55,57,58],55,"h958g3s60uqrf2fnzu773vqdp","IDSA/ESCMID 2026 SAB共识第6、7条解读：无深部病灶者建议14天抗菌治疗","IDSA与ESCMID于9月9日发布金黄色葡萄球菌菌血症（SAB）共识声明第一部分，第6、7条建议经诊断评估后无深部或转移性感染灶的低风险与升高风险成人患者均接受14天抗菌治疗，疗程起始日以血培养转阴日为准，若病灶清除晚于转阴则以清除日起算。","梳理IDSA/ESCMID共识第6、7条对低风险与升高风险SAB的14天疗程建议，并点出实施层面的障碍。",{"_61":112},"2026-11-08T14:49:51.619Z",[56,54,55,57,58,111],"对品牌","Contagion Live·抗菌药物管理","g7pvd8hfxhkimujq702vbenuw","《慢性阻塞性肺疾病诊治指南（2026年修订版）》全文发布","中华医学会呼吸病学分会与中国医师协会呼吸医师分会发布《慢性阻塞性肺疾病诊治指南（2026年修订版）》，在2021年版基础上围绕22个临床问题给出推荐意见，采用GRADE方法评价证据。","指南给出慢阻肺病急性加重抗菌治疗的分层指征与疗程，以及阿奇霉素长期预防的适用人群和耐药风险。",{"_61":122},"2026-11-09T09:37:03.000Z","2026-11-11T08:15:49.221Z",[56,73],62,"呼吸界","fubx64y7iuf3aj03hi4n8pzcl","中国流感监测周报第934期：南北方流感阳性率上升，A(H1N1)pdm09占47.4%","截至2026年11月8日的一周，南、北方省份流感病毒检测阳性率上升，全国检出阳性样本中A(H1N1)pdm09占47.4%、A(H3N2)占23.4%、B(Victoria)系占29.2%，共报告125起流感样病例暴发疫情。","周报给出流感阳性率上升、毒株构成与耐药监测结果，可帮助判断当季抗流感药物的敏感性背景。",{"_61":95},"2026-11-12T00:00:00.000Z","2026-11-12T14:18:53.258Z",[56,72,55,57,58],"m345oqkragfyvkx2jvhm6umvr","中国疾控发布2026年第45周全国急性呼吸道传染病哨点监测：流感病毒阳性率18.8%","中国疾控发布2026年第45周（11月2日—11月8日）全国急性呼吸道传染病哨点监测结果，216家多病原监测哨点医院门急诊流感样病例呼吸道样本阳性率前三位为流感病毒18.8%、鼻病毒10.9%、人偏肺病毒5.4%，住院严重急性呼吸道感染病例为鼻病毒10.2%、流感病毒6.6%、人偏肺病毒5.6%。","疾控周报给出流感病毒阳性率18.8%及A(H1N1)占比上升的南北差异，可据此判断冬春季呼吸道用药需求的走向。",{"_61":74},"2026-11-12T14:18:54.849Z",[56,72,73],"slug","papers","论文研究","group","genre","definition","值得读的医学与药学论文：新靶点、新机制、真实世界研究与重磅期刊发表。","brand","total",9,"recent",6,"indexable",false,"latest",{"_31":132,"_158":136},"groupName","内容形态","poolTotal",288,"at",{"_160":161,"_162":-5,"_163":49},"changelogVersion","2026-10-08T08:00","release","staticSite"]
