[{"_1":2,"_3":4},"root",{"_5":93},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_69":70,"_51":50,"_71":72,"_73":74,"_75":76,"_77":78,"_79":16,"_80":81,"_82":83,"_84":85,"_86":87},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":53,"_24":54,"_26":55,"_28":56,"_30":57,"_32":58,"_34":59,"_35":60,"_37":61,"_39":62,"_41":42,"_43":44,"_45":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":33,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5},"id","y7axbzp7su66b8p95u7byykpt","title","翰森制药与罗氏达成ADC产品组合授权合作，首付款4亿美元","summary","翰森制药与罗氏订立战略合作及授权协议，推进一系列ADC项目，翰森将获得4亿美元首付款、1.1亿美元一周年付款，以及潜在超过150亿美元里程碑付款和分级特许权使用费。合作涵盖两个翰森临床前ADC项目及多个由罗氏提议靶点、依托翰森ADC平台开发的项目，翰森主导早期开发至全球Ia期完成，罗氏负责中国内地、香港、澳门和台湾以外地区的开发，翰森保留上述地区全部权益。这是双方在ADC领域的第二次合作。","reason","协议把首付款、周年付款与超150亿美元里程碑拆开写明，并划清了中美两地的开发与商业化权益。","source",{"_51":52},"publishedAt","2026-10-18T16:00:00.000Z","timelineAt","category","industry","tags",[46,47,48,49,50],"score",72,"selected",true,"channel","news","x","交易/授权","ADC","肿瘤","翰森制药","罗氏","name","翰森制药·公司新闻","cy13d4uidahrp0yi7v3os5021","罗氏艾美赛珠单抗纳入 2026 年版国家医保目录，覆盖 A 型血友病规律替代治疗","国家医保局公布《国家基本医疗保险、生育保险和工伤保险药品目录（2026 年版）》，罗氏制药中国的艾美赛珠单抗注射液（舒友立乐）纳入医保，报销范围覆盖伴或不伴凝血因子 VIII 抑制物的 A 型血友病患者规律替代治疗。","艾美赛珠单抗进医保后，A 型血友病规律替代治疗首次覆盖成人，读者可据此判断皮下给药方案在院内的准入空间。",{"_51":68},"2026-11-14T11:08:01.000Z","2026-11-16T00:55:17.840Z","policy",[63,64,65,66,50,67],71,"政策/监管","医保/集采","罕见病","血液","国家医保局","药时代","slug","roche","group","company","definition","罗氏与基因泰克的肿瘤、眼科与神经管线，诊断业务与新分子实体进展。","brand",{"_89":-5,"_90":91,"_92":81},"total",2,"recent","indexable",false,"latest",{"_24":54,"_88":59},"groupName","药企与机构","poolTotal",8,"at","src","monogram","罗","raster",{"_94":95,"_96":-5,"_97":42},"changelogVersion","2026-10-08T08:00","release","staticSite"]
