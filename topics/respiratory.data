[{"_1":2,"_3":4},"root",{"_5":152},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_132":133,"_57":53,"_134":135,"_136":137,"_138":-5,"_139":140,"_141":142,"_143":144,"_145":146,"_147":148,"_149":150},"modules",{},"items",[20,21,22,23,24,25,26,27],"page",1,"pageCount","pageSize",20,{"_28":124,"_30":125,"_32":126,"_34":127,"_36":128,"_38":129,"_40":130,"_41":76,"_43":131,"_45":103,"_47":48,"_49":50,"_51":-5},{"_28":113,"_30":114,"_32":115,"_34":116,"_36":117,"_38":118,"_40":119,"_41":76,"_43":120,"_45":121,"_47":48,"_49":50,"_51":-5},{"_28":105,"_30":106,"_32":107,"_34":108,"_36":109,"_38":110,"_40":111,"_41":89,"_43":112,"_45":103,"_47":48,"_49":50,"_51":-5},{"_28":95,"_30":96,"_32":97,"_34":98,"_36":99,"_38":100,"_40":101,"_41":89,"_43":102,"_45":103,"_47":48,"_49":50,"_51":-5},{"_28":83,"_30":84,"_32":85,"_34":86,"_36":87,"_38":88,"_40":88,"_41":89,"_43":90,"_45":91,"_47":48,"_49":50,"_51":-5},{"_28":70,"_30":71,"_32":72,"_34":73,"_36":74,"_38":75,"_40":75,"_41":76,"_43":77,"_45":78,"_47":48,"_49":50,"_51":-5},{"_28":59,"_30":60,"_32":61,"_34":62,"_36":63,"_38":64,"_40":64,"_41":65,"_43":66,"_45":67,"_47":48,"_49":50,"_51":-5},{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":39,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":-5},"id","fdoth58493nafsrdaavgwhza1","title","GSK 德莫奇单抗（易适来）在中国获批用于成人和12岁及以上青少年重度嗜酸性粒细胞性哮喘维持治疗","summary","NMPA 批准 GSK 的德莫奇单抗（易适来）用于成人和12岁及以上青少年重度嗜酸性粒细胞性哮喘的维持治疗，每年给药两次。","reason","原文给出获批适应症与SWIFT-1/2两项Ⅲ期试验的发作率降幅，读者可据此判断这款年给药两次生物制剂在重度嗜酸性哮喘中的位置。","source",{"_57":58},"publishedAt","2026-03-31T04:00:00.000Z","timelineAt","category","approval","tags",[52,53,54,55,56],"score",67,"selected",true,"channel","news","x","获批上市","呼吸","抗体/双抗","NMPA","GSK","name","GSK 中国·新闻稿","v7n3hdqjiyfwvc5u1qo87h7ux","葛兰素史克与中国生物制药扩大合作，正大天晴负责全再乐和欧乐欣在华商业化","葛兰素史克与中国生物制药扩大战略合作，由旗下正大天晴负责全再乐（氟替美维吸入粉雾剂）和欧乐欣（乌美溴铵维兰特罗吸入粉雾剂）在中国内地的进口、分销、医院准入及推广，覆盖逾9000家医院及基层医疗机构。","协议明确了正大天晴负责进口分销与医院准入、GSK保留MAH的分工，读者可据此判断两款呼吸吸入制剂在基层的准入路径。",{"_57":58},"2026-07-08T04:00:00.000Z","industry",[68,53,56,69],72,"交易/授权","中国生物制药","u2s7fftpprobv7ons55e6jkqd","欧加隆两款药品新纳入2026版国家基本药物目录，另有6款保留","《国家基本药物目录（2026年版）》纳入欧加隆的依折麦布片（益适纯）和孟鲁司特（顺尔宁），并保留辛伐他汀、依那普利、米氮平、阿仑膦酸钠、非那雄胺和糠酸莫米松鼻喷雾剂6款产品，新版目录自2026年9月1日起施行。依折麦布用于原发性高胆固醇血症、HoFH及谷甾醇血症，孟鲁司特用于哮喘预防与长期治疗及过敏性鼻炎症状缓解。","新版基药目录纳入与保留的品种清单，可帮助判断慢病用药在基层市场的准入格局变化。",{"_57":82},"2026-07-08T16:00:00.000Z","policy",[79,80,53,81],52,"政策/监管","心血管","医保/集采","欧加隆中国·新闻","zk7i4gzm8t9djvrcatrwy1sq5","中国疾控发布2026年第41周全国急性呼吸道传染病哨点监测情况","2026年第41周（10月5日—10月11日），全国哨点医院门急诊流感样病例百分比为3.8%，南方省份4.6%高于北方省份3.0%。216家多病原监测哨点医院门急诊流感样病例样本阳性率前三位为流感病毒13.6%、鼻病毒11.2%、肠道病毒3.9%，住院严重急性呼吸道感染病例为鼻病毒9.3%、流感病毒4.3%、人偏肺病毒4.1%。","中国疾控第41周哨点监测给出流感病毒13.6%的阳性率与南北差异，可据此判断秋冬呼吸道感染的流行节奏。",{"_57":94},"2026-10-15T00:00:00.000Z","research",[92,93,53],58,"论文/研究","感染/疫苗","中国疾控·急性呼吸道传染病哨点监测","g7pvd8hfxhkimujq702vbenuw","《慢性阻塞性肺疾病诊治指南（2026年修订版）》全文发布","中华医学会呼吸病学分会与中国医师协会呼吸医师分会发布《慢性阻塞性肺疾病诊治指南（2026年修订版）》，在2021年版基础上围绕22个临床问题给出推荐意见，采用GRADE方法评价证据。","指南给出慢阻肺病急性加重抗菌治疗的分层指征与疗程，以及阿奇霉素长期预防的适用人群和耐药风险。",{"_57":104},"2026-11-09T09:37:03.000Z","2026-11-11T08:15:49.221Z",[92,53],62,"呼吸界","m345oqkragfyvkx2jvhm6umvr","中国疾控发布2026年第45周全国急性呼吸道传染病哨点监测：流感病毒阳性率18.8%","中国疾控发布2026年第45周（11月2日—11月8日）全国急性呼吸道传染病哨点监测结果，216家多病原监测哨点医院门急诊流感样病例呼吸道样本阳性率前三位为流感病毒18.8%、鼻病毒10.9%、人偏肺病毒5.4%，住院严重急性呼吸道感染病例为鼻病毒10.2%、流感病毒6.6%、人偏肺病毒5.6%。","疾控周报给出流感病毒阳性率18.8%及A(H1N1)占比上升的南北差异，可据此判断冬春季呼吸道用药需求的走向。",{"_57":94},"2026-11-12T00:00:00.000Z","2026-11-12T14:18:54.849Z",[92,93,53],"l4gif7m8k6kbnc3prgwmqr4i3","度普利尤单抗慢阻肺病与哮喘适应症纳入2026国家医保药品目录","国家医保局公布《国家基本医疗保险、工伤保险和生育保险药品目录（2026年）》，度普利尤单抗注射液成人慢阻肺病及6岁及以上儿童和成人哮喘等四项适应症首次纳入医保支付范围，中重度特应性皮炎适应症续约。该药为靶向白介素-4及白介素-13的生物制剂，陈荣昌、瞿介明两位教授在文中提到纳入医保有助于减轻用药负担、提升可及性并减少急性加重。","慢阻肺病与哮喘适应症首次进入医保支付，读者可据此判断呼吸生物制剂在院内的准入与放量空间。",{"_57":104},"2026-11-14T10:00:00.000Z","2026-11-16T01:00:50.265Z",[79,81,53,54,122,123],78,"国家医保局","赛诺菲","nv5c0dm51azewdriddguukjib","GSK 德莫奇单抗、美泊利珠单抗纳入 2026 年国家医保目录","GSK 宣布易适来（德莫奇单抗）与新可来（美泊利珠单抗注射液）纳入《国家基本医疗保险、生育保险和工伤保险药品目录（2026年）》。德莫奇单抗覆盖重度嗜酸性粒细胞性哮喘和慢性鼻窦炎伴鼻息肉两项适应症，每年给药两次，今年上半年在中国获批后同年进入医保；美泊利珠单抗本次新增慢阻肺病适应症纳入支付范围，其重度嗜酸性粒细胞性哮喘、慢性鼻窦炎伴鼻息肉及嗜酸性肉芽肿性多血管炎三项适应症同步续约。","两款呼吸生物制剂进医保的具体适应症与续约范围，可帮助判断嗜酸性粒细胞相关慢病的准入变化。",{"_57":104},"2026-11-14T05:39:17.000Z","2026-11-16T01:00:55.874Z",[79,81,53,54,56,122],"slug","respiratory","group","field","definition","呼吸领域：慢阻肺、哮喘、肺纤维化的新机制药物与吸入制剂进展。","brand","total",8,"recent",4,"indexable",false,"latest",{"_30":125,"_151":130},"groupName","治疗领域","poolTotal",64,"at",{"_153":154,"_155":-5,"_156":48},"changelogVersion","2026-10-08T08:00","release","staticSite"]
