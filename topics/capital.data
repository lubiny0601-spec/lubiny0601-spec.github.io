[{"_1":2,"_3":4},"root",{"_5":100},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443580000,{"_80":81,"_52":49,"_82":83,"_84":85,"_86":-5,"_87":88,"_89":90,"_91":92,"_93":94,"_95":96,"_97":98},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":68,"_25":69,"_27":70,"_29":71,"_31":72,"_33":73,"_35":74,"_36":37,"_38":75,"_40":76,"_42":43,"_44":45,"_46":-5},{"_23":54,"_25":55,"_27":56,"_29":57,"_31":58,"_33":59,"_35":59,"_36":37,"_38":60,"_40":61,"_42":43,"_44":45,"_46":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","ffbzgnxsai4hecg6w3bvtn5rt","title","华润医药发布2026年中期业绩：收入1344.6亿元，归母净利润21.9亿元","summary","华润医药2026年上半年收入同比增长2.0%至1,344.6亿元，归母净利润同比增长5.3%至21.9亿元，中期每股派息0.087元、派息额同比增长20.8%。","reason","中期业绩披露了各分部收入增速与研发投入规模，可对照观察分销与零售业务的结构变化。","source",{"_52":53},"publishedAt","2026-08-25T00:00:00.000Z","timelineAt","category","industry","tags",[47,48,49,50,51],"score",58,"selected",true,"channel","news","x","公司动态","市场/销售","投融资","医疗器械/IVD","华润医药","name","华润医药·医药动态","uxri1pyf171pxd7lc2rcfrcse","阿斯利康拟约100亿美元收购Rhythm Pharmaceuticals，押注MC4R通路罕见肥胖药","路透社援引知情人士称，阿斯利康已提出以约100亿美元收购肥胖症药物公司Rhythm Pharmaceuticals，报价最高每股134美元，部分与里程碑挂钩，此前曾报每股124美元；消息传出后Rhythm收涨28%报110.68美元，市值约76.4亿美元，交易拟由Alexion主导。","交易把MC4R通路与GLP-1的适用人群切开，读者可据此判断罕见肥胖赛道的定价与准入风险。",{"_52":67},"2026-11-06T03:16:13.000Z",[49,62,63,64,65,66],60,"代谢/减重","罕见病","阿斯利康","诺和诺德","礼来","药时代","kbcy714srsvfzczgzohs8pu6z","香雪制药被两名债权人申请破产重整，广药资本中选四个多月仍未签约","香雪制药公告收到广州中院送达的两份拟申请破产重整通知书，广州农商行黄埔支行、广州高新区融资租赁拟以债权人身份申请重整，截至11月10日公司尚未收到法院启动或受理重整申请的文件。","从债权人申请重整、广药资本中选未签约到收入结构变化，呈现这家老牌中药企业重整的完整时间线。",{"_52":79},"2026-11-12T12:00:34.000Z","2026-11-12T14:31:15.869Z",[47,77,78,49],55,"中药","细胞与基因治疗","赛柏蓝","slug","capital","group","genre","definition","生物医药的资本市场：IPO、增发、私募融资、基金募资与估值变化。","brand","total",3,"recent",2,"indexable",false,"latest",{"_25":69,"_99":74},"groupName","内容形态","poolTotal",47,"at",{"_101":102,"_103":-5,"_104":43},"changelogVersion","2026-10-08T08:00","release","staticSite"]
