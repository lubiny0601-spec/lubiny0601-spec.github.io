[{"_1":2,"_3":4},"root",{"_5":155},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443580000,{"_136":42,"_60":52,"_137":138,"_139":140,"_141":-5,"_142":143,"_144":145,"_146":147,"_148":149,"_150":151,"_152":153},"modules",{},"items",[20,21,22,23,24,25,26,27],"page",1,"pageCount","pageSize",20,{"_28":129,"_30":130,"_32":131,"_34":132,"_36":133,"_38":134,"_40":134,"_41":42,"_43":135,"_45":84,"_47":48,"_49":50,"_51":-5},{"_28":118,"_30":119,"_32":120,"_34":121,"_36":122,"_38":123,"_40":123,"_41":42,"_43":124,"_45":107,"_47":48,"_49":50,"_51":-5},{"_28":110,"_30":111,"_32":112,"_34":113,"_36":114,"_38":115,"_40":115,"_41":42,"_43":116,"_45":84,"_47":48,"_49":50,"_51":-5},{"_28":100,"_30":101,"_32":102,"_34":103,"_36":104,"_38":105,"_40":105,"_41":42,"_43":106,"_45":107,"_47":48,"_49":50,"_51":-5},{"_28":89,"_30":90,"_32":91,"_34":92,"_36":93,"_38":94,"_40":94,"_41":42,"_43":95,"_45":46,"_47":48,"_49":50,"_51":-5},{"_28":77,"_30":78,"_32":79,"_34":80,"_36":81,"_38":82,"_40":82,"_41":42,"_43":83,"_45":84,"_47":48,"_49":50,"_51":-5},{"_28":62,"_30":63,"_32":64,"_34":65,"_36":66,"_38":67,"_40":67,"_41":42,"_43":68,"_45":69,"_47":48,"_49":50,"_51":-5},{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":39,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":-5},"id","mseoethc3gxuo1g1x8wpzwyy8","title","舒巴坦-度洛巴坦对比黏菌素治疗碳青霉烯耐药鲍曼不动杆菌感染达到非劣效","summary","III 期 ATTACK 试验中，舒巴坦-度洛巴坦对比黏菌素治疗碳青霉烯耐药鲍曼不动杆菌感染，主要终点 28 天全因死亡率达到统计学非劣效：舒巴坦-度洛巴坦组 63 例中 12 例（19%），黏菌素组 62 例中 20 例（32%），差异 –13.2%（95% CI –30.0 至 3.5）。","reason","III 期 ATTACK 试验显示该复方在 28 天全因死亡率上不劣于黏菌素，肾毒性更低，可对照耐药鲍曼不动杆菌的用药选择。","source",{"_60":61},"publishedAt","2023-05-12T17:15:43.184Z","timelineAt","category","clinical","tags",[52,53,54,55,56,57,58,59],"score",48,"selected",true,"channel","news","x","临床进展","抗菌药物","耐药与院感","论文/研究","抗感染","循证指南","对市场","FDA","name","Contagion Live·医院感染","r7dckds3ruzrlousz2ihe1w4f","GSK 反义寡核苷酸 bepirovirsen 两项三期试验达到主要终点，整体功能性治愈率 19%","GSK 公布 bepirovirsen 两项三期试验 B-Well 1 和 B-Well 2 合并数据，6 个月治疗在基线 HBsAg≤3000 IU/mL 人群中功能性治愈率 19%（233/1220 vs. 0/614 安慰剂组，p<0.001），达到主要终点。","两项三期试验的功能性治愈率与安慰剂0%形成对照，中国亚组数据单独列出，可据此判断该药在国内乙肝人群的定位。",{"_60":76},"2026-05-28T09:00:00.000Z",[52,70,71,72,73,59,74,75],62,"感染/疫苗","GSK","中国生物制药","核酸药物","NMPA","EMA","GSK 中国·新闻稿","p6ch0vd5f1iev5ddpuxiojl2g","翰森制药公布达麦利替尼联合阿美替尼治疗 EGFR 突变伴 MET 扩增晚期 NSCLC 的 III 期数据","翰森制药在 ESMO 2026 以口头报告公布 HS-10241-301 研究结果，达麦利替尼联合阿美替尼用于 EGFR-TKI 治疗失败、EGFR 突变伴 MET 扩增（MET GCN≥5 或 MET/CEP7≥2）的晚期 NSCLC。","III 期数据给出了 PFS、ORR 与安全性数值，读者可据此判断该联合方案在 EGFR-TKI 耐药后 MET 扩增人群中的定位。",{"_60":88},"2026-10-25T16:00:00.000Z",[52,85,86,87],46,"肿瘤","小分子","翰森制药","翰森制药·公司新闻","wpfhggmkk6ffduhwdpksxu7e7","康方生物依沃西联合化疗一线治疗胆道癌 III 期 HARMONi-GI1 达到 OS 主要终点","2026 ESMO 大会上，康方生物公布依沃西联合化疗对比度伐利尤单抗联合化疗一线治疗晚期胆道癌的 III 期 HARMONi-GI1 研究结果，达到 OS 主要终点，中位 OS 为 14.9 vs 12.1 个月（HR=0.75，95% CI:0.61-0.92，P=0.0031）。","HARMONi-GI1 是依沃西在肺癌之外的首个 III 期阳性读出，读者可据此判断 PD-1/VEGF 双抗跨瘤种复制的可能性。",{"_60":99},"2026-10-26T03:58:53.000Z",[52,85,96,97,98],"抗体/双抗","康方生物","阿斯利康","医药魔方","hptxjcsi9a8d7di45u12xhwfo","翰森制药公布瑞康立伏妥塔单抗（HS-20093）治疗复发或难治性骨肉瘤的III期ARTEMIS-011研究结果","翰森制药在ESMO 2026以LBA形式公布III期ARTEMIS-011研究结果，瑞康立伏妥塔单抗（HS-20093）对比吉西他滨联合多西他赛治疗既往至少二线治疗失败的复发或难治性骨肉瘤，达到BICR评估的PFS主要终点，中位PFS为5.5个月 vs 1.4个月（HR=0.33，95%CI 0.20-0.55，P<0.0001），疾病进展或死亡风险降低67%。","原文给出ARTEMIS-011的PFS、ORR与安全性数值，读者可据此判断这款B7-H3 ADC在骨肉瘤中的获益幅度与风险。",{"_60":88},"2026-10-26T16:00:00.000Z",[52,85,108,87,109,71],47,"ADC","罕见病","lwmjovvi8uvshy4sd6t6zdrq4","百利天恒伦康依隆妥单抗肺癌二线 III 期与一线联合数据在 ESMO 公布","2026 ESMO 期间，百利天恒公布伦康依隆妥单抗（iza-bren）在 EGFR 突变肺癌的两组数据。二线 PANKU-Lung01 研究中，单药中位 PFS 达 11.1 个月，较化疗降低疾病进展或死亡风险 60%（HR=0.40），ORR 60.2%、DoR 10.4 个月，该适应症上市申请已被 CDE 受理。","文章汇总了伦康依隆妥单抗在 EGFR 突变肺癌二线与一线的最新数据，读者可据此对照现有标准治疗的 PFS 水平。",{"_60":99},"2026-10-27T09:17:13.000Z",[52,85,108,96,117],"BMS","wfc1cljivcwarvefktkpkg1b1","恒瑞医药瑞普泊肽注射液中国Ⅲ期减重研究GEMINI-1全文发表于《JAMA》","恒瑞医药自主研发的GLP-1/GIP双重受体激动剂瑞普泊肽注射液（HRS9531）在中国肥胖或超重人群中开展的Ⅲ期GEMINI-1研究结果全文发表于《JAMA》。","中国超重肥胖人群的Ⅲ期数据全文发表，给出了各剂量组48周减重幅度与达标比例，可与已上市GLP-1疗法对照。",{"_60":128},"2026-11-17T00:00:00.000Z",[52,125,126,127],"代谢/减重","GLP-1","恒瑞医药","恒瑞医药·新闻","rho7diq3u9zbkhmbmyrt31qdr","恒瑞医药HR091506缓释片III期结果在2026 ACR口头报告，降尿酸达标率优于非布司他","恒瑞医药在2026 ACR年会以口头报告形式公布HR091506缓释片治疗痛风伴高尿酸血症的III期结果，第28周sUA<360μmol/L达标率66.9%，非布司他组41.4%，率差25.6个百分点（P<0.0001）。","原文给出HR091506与非布司他头对头的达标率与降幅差异，可据此判断缓释剂型在痛风长期管理中的位置。",{"_60":128},"2026-11-19T00:00:00.000Z",[52,125,127,86],"slug","group","genre","definition","临床试验的一切：启动、入组、数据读出、失败与终止，以及关键终点的解读。","brand","total",8,"recent",6,"indexable",false,"latest",{"_30":130,"_154":134},"groupName","内容形态","poolTotal",176,"at",{"_156":157,"_158":-5,"_159":48},"changelogVersion","2026-10-08T08:00","release","staticSite"]
