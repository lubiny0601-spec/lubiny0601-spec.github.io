[{"_1":2,"_3":4},"root",{"_5":134},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_114":115,"_58":54,"_116":117,"_118":119,"_120":-5,"_121":122,"_123":124,"_125":126,"_127":128,"_129":130,"_131":132},"modules",{},"items",[20,21,22,23,24,25],"page",1,"pageCount","pageSize",20,{"_26":102,"_28":103,"_30":104,"_32":105,"_34":106,"_36":107,"_38":107,"_39":108,"_41":109,"_43":110,"_45":46,"_47":48,"_49":-5},{"_26":92,"_28":93,"_30":94,"_32":95,"_34":96,"_36":97,"_38":97,"_39":87,"_41":98,"_43":89,"_45":46,"_47":48,"_49":-5},{"_26":81,"_28":82,"_30":83,"_32":84,"_34":85,"_36":86,"_38":86,"_39":87,"_41":88,"_43":89,"_45":46,"_47":48,"_49":-5},{"_26":73,"_28":74,"_30":75,"_32":76,"_34":77,"_36":78,"_38":78,"_39":66,"_41":79,"_43":44,"_45":46,"_47":48,"_49":-5},{"_26":60,"_28":61,"_30":62,"_32":63,"_34":64,"_36":65,"_38":65,"_39":66,"_41":67,"_43":68,"_45":46,"_47":48,"_49":-5},{"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","r7dckds3ruzrlousz2ihe1w4f","title","GSK 反义寡核苷酸 bepirovirsen 两项三期试验达到主要终点，整体功能性治愈率 19%","summary","GSK 公布 bepirovirsen 两项三期试验 B-Well 1 和 B-Well 2 合并数据，6 个月治疗在基线 HBsAg≤3000 IU/mL 人群中功能性治愈率 19%（233/1220 vs. 0/614 安慰剂组，p<0.001），达到主要终点。","reason","两项三期试验的功能性治愈率与安慰剂0%形成对照，中国亚组数据单独列出，可据此判断该药在国内乙肝人群的定位。","source",{"_58":59},"publishedAt","2026-05-28T09:00:00.000Z","timelineAt","category","clinical","tags",[50,51,52,53,54,55,56,57],"score",62,"selected",true,"channel","news","x","临床进展","感染/疫苗","GSK","中国生物制药","核酸药物","FDA","NMPA","EMA","name","GSK 中国·新闻稿","okucl0ks31e3w0mi23egcpclw","商务部、科技部就修订《中国禁止出口限制出口技术目录》征求意见，拟增列细胞和基因治疗、小核酸药等5项生物医药技术","商务部会同科技部10月16日就修订《中国禁止出口限制出口技术目录》公开征求意见，生物医药领域拟增列细胞和基因治疗、小核酸药、病原微生物相关5项技术，其中拟禁止出口3项、拟限制出口2项。","目录修订把细胞和基因治疗、siRNA 平台技术纳入出口管制，读者可据此判断技术出海与授权交易的合规边界。",{"_58":72},"2026-10-19T00:00:00.000Z","policy",[69,70,54,71],55,"政策/监管","细胞与基因治疗","行业趋势","中国食品药品网·要闻","ptoispp2cqtaeg8xu3p67rjrj","商务部拟对细胞与基因治疗、siRNA 等平台实施出口管制，创新药出海交易结构面临调整","商务部 10 月 16 日公布《中国禁止出口限制出口技术目录》修订草案，拟禁止外国收购专有的细胞与基因治疗、siRNA 及病原体功能获得性研究平台，并限制将这两类领域的专有靶点识别与验证技术完整转让给境外实体。","草案把禁止与限制落在平台所有权转让上，对外许可仍走便利通道，读者可据此判断出海交易结构怎么选。",{"_58":80},"2026-10-19T10:27:12.000Z",[69,70,54,71],"药时代","epoojo4s7nbifq9nveggd9mg2","剂泰科技与礼来达成AI驱动LNP递送技术合作，里程碑总额最高11亿美元","剂泰科技10月19日宣布与礼来达成战略合作，基于NanoForge平台下的AiLNP平台研发提升组织靶向性与体内分布的新一代LNP递送技术，礼来负责投入药物发现、开发及商业化资源。","协议披露了首付款、里程碑总额与销售分成结构，可对照礼来此前在AI与递送领域的多笔合作看其技术拼图。",{"_58":80},"2026-10-20T05:34:08.000Z","industry",[90,54,91],58,"交易/授权","礼来","lvmp7rdrpv4euofk5na8u2v6z","默克以约13亿美元收购Silence Therapeutics，溢价82%拿下siRNA平台与PV疗法divesiran","默克宣布以约13亿美元股权价值收购英国siRNA生物技术公司Silence Therapeutics，较过去30个交易日平均股价溢价82%。核心资产是靶向TMPRSS6的siRNA疗法divesiran，用于真性红细胞增多症（PV），其Ⅱ期SANRECO试验中治疗组临床应答率88%、安慰剂组19%，截至第36周平均放血0.2次对2.1次。","这笔收购把溢价水平、Ⅱ期应答率与竞品先发格局放在一起，可据此判断默克切入血液学的定价逻辑。",{"_58":80},"2026-10-20T09:28:19.000Z",[90,99,54,100,101],"血液","罕见病","默沙东","gp38wyy02sytceppt8cx5wuc7","FDA 批准 GSK 反义寡核苷酸药物 Hibsago（bepirovirsen）联合现有抗病毒治疗用于慢性乙肝","FDA 批准 GSK 的 Hibsago（bepirovirsen）注射液联合现有抗病毒治疗，用于无肝硬化、已接受至少 6 个月抗病毒治疗、HBV 得到抑制且 HBsAg≤3,000 IU/mL 的部分成人慢性乙肝患者，这是 FDA 批准的首个治疗慢性乙肝的反义寡核苷酸。","原文给出获批人群的HBsAg阈值与停药后病毒控制比例，读者可据此判断适用患者范围。",{"_58":113},"2026-10-20T19:40:38.000Z","approval",[111,51,54,55,52,112],52,"获批上市","罗氏","FDA 新闻稿","slug","nucleic","group","field","definition","mRNA、siRNA、ASO 与基因编辑：递送系统、平台验证与适应症扩张。","brand","total",6,"recent",0,"indexable",false,"latest",{"_28":103,"_133":107},"groupName","治疗领域","poolTotal",29,"at",{"_135":136,"_137":-5,"_138":46},"changelogVersion","2026-10-08T08:00","release","staticSite"]
