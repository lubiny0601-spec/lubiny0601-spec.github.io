[{"_1":2,"_3":4},"root",{"_5":73},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443578000,{"_50":51,"_48":47,"_52":53,"_54":55,"_56":57,"_58":16,"_59":16,"_60":61,"_62":63,"_64":65,"_66":67},"modules",{},"items",[20],"page",1,"pageCount","pageSize",20,{"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","m0zihkhitp8ytxxu7jgdtft05","title","石药集团棕榈酸帕利哌酮注射液首批发货，24小时内送达山东、北京等地","summary","10月28日，石药集团中诺药业（石家庄）首批棕榈酸帕利哌酮注射液正式发运，未来24小时内陆续送达山东、北京，48小时内送达重庆、广东、江西、贵州及全国各地。该产品2026年7月21日获批，适用于精神分裂症急性期和维持期治疗，为每月给药一次的长效抗精神病针剂。原文称对比口服药物，用药第4天PANSS评分有显著改善，24周随访结果提示复发风险下降29.4%。","reason","原文交代了这款国产长效针剂的发货节奏与获批时间，读者可据此判断其临床可及性的推进速度。","source",{"_48":49},"publishedAt","2026-10-29T00:00:00.000Z","timelineAt","category","industry","tags",[45,46,47],"score",47,"selected",true,"channel","news","x","公司动态","神经/精神","石药集团","name","石药集团·新闻中心","slug","cspc","group","company","definition","石药集团的成药与创新管线、ADC 与 mRNA 平台合作，以及集采影响下的业绩变化。","brand",{"_69":-5,"_70":71,"_72":61},"total","recent","indexable",false,"latest",{"_23":24,"_68":32},"groupName","药企与机构","poolTotal",53,"at","src","monogram","石","raster",{"_74":75,"_76":-5,"_77":41},"changelogVersion","2026-10-08T08:00","release","staticSite"]
