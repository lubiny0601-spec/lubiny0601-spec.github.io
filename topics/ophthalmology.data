[{"_1":2,"_3":4},"root",{"_5":108},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_89":90,"_53":50,"_91":92,"_93":94,"_95":-5,"_96":97,"_98":97,"_99":100,"_101":102,"_103":104,"_105":106},"modules",{},"items",[20,21,22,23],"page",1,"pageCount","pageSize",20,{"_24":78,"_26":79,"_28":80,"_30":81,"_32":82,"_34":83,"_36":83,"_37":38,"_39":84,"_41":42,"_43":44,"_45":46,"_47":-5},{"_24":68,"_26":69,"_28":70,"_30":71,"_32":72,"_34":73,"_36":73,"_37":38,"_39":74,"_41":42,"_43":44,"_45":46,"_47":-5},{"_24":55,"_26":56,"_28":57,"_30":58,"_32":59,"_34":60,"_36":60,"_37":61,"_39":62,"_41":63,"_43":44,"_45":46,"_47":-5},{"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":35,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":-5},"id","inw56c813hlpywgx8nzchhaps","title","兴齐眼药0.01%硫酸阿托品滴眼液多地降价约21%，多家药企管线逼近","summary","兴齐眼药旗下美欧品0.01%硫酸阿托品滴眼液在广东、辽宁、四川、安徽等多地医院降价，由298元/盒降至234.7元/盒，降幅约21.24%，公司回应称是为增加药物可及性；部分电商平台售价仍在274元至300元之间，0.02%规格部分医院维持399元/盒。","reason","从兴齐眼药主力规格降价切入，梳理兆科、恒瑞、齐鲁、参天等低浓度阿托品在研管线的浓度与申报进度差异。","source",{"_53":54},"publishedAt","2026-10-25T11:59:11.000Z","timelineAt","category","industry","tags",[48,49,50,51,52],"score",60,"selected",true,"channel","news","x","公司动态","市场/销售","眼科","恒瑞医药","齐鲁制药","name","赛柏蓝","rfnvez36knw9uh8wlntemdi1y","欧康维视氟轻松玻璃体内植入剂优施莹地产化获 NMPA 批准","10月27日，欧康维视宣布氟轻松玻璃体内植入剂（优施莹）地产化注册申请获国家药监局批准，未来可在境内商业化生产供应。该药2022年6月以进口5.1类获批，用于累及眼后段的慢性非感染性葡萄膜炎，2023年通过国谈进入医保目录；此次由苏州欧康维视以化学药品4类仿制路径申报（受理号CYHS2502987，2025年8月承办，国药准字H20266424），分子、剂型、适应症未变。","从进口独家到苏州地产化，材料拆解了眼科缓释植入剂的制剂工程门槛与后续供应、医保放量逻辑。",{"_53":67},"2026-10-29T00:05:17.000Z","approval",[64,50,65,66],58,"获批上市","医疗器械/IVD","NMPA","医药云端工作室","wtkt18w6obr9mcld36g98rqfp","明慧医药与 ASKA 就 IGF-1R 抗体 MHB018A 达成日本独家许可，首付款 1.1 亿美元","明慧医药与 ASKA Pharmaceutical 就靶向 IGF-1R 的皮下注射抗体 MHB018A 签订日本开发与商业化独家许可协议，明慧医药将获得 1.1 亿美元首付款，并有资格获得最高 3.3 亿美元的开发、监管和商业化里程碑付款，以及基于日本净销售额、最高达 mid-30% 的分级特许权使用费。","交易结构写清了首付款、里程碑与日本权益范围，可对照同类出海授权判断条款水平。",{"_53":77},"2026-11-04T12:35:56.000Z",[75,50,76],"交易/授权","抗体/双抗","药时代","phepjbp6kfzxkn62eo2ur3g8v","强生22亿美元收购Ollin Biosciences，核心管线OLN324与OLN102均源自中国药企","2026年11月16日信达生物公告，其合作企业Ollin Biosciences与强生达成最终收购协议，交易对价22亿美元。","这笔交易把两款源自中国药企的双抗资产打包退出，读者可据此看NewCo模式从授权到并购的完整路径。",{"_53":77},"2026-11-17T08:41:03.000Z",[75,50,85,76,86,87,88],"自免","信达生物","强生","安进","slug","ophthalmology","group","field","definition","眼科领域：眼底病、干眼症与基因治疗，以及眼科器械与给药方式的创新。","brand","total",4,"recent","indexable",false,"latest",{"_26":79,"_107":83},"groupName","治疗领域","poolTotal",10,"at",{"_109":110,"_111":-5,"_112":44},"changelogVersion","2026-10-08T08:00","release","staticSite"]
