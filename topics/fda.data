[{"_1":2,"_3":4},"root",{"_5":160},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443578000,{"_134":135,"_59":136,"_137":138,"_139":140,"_141":142,"_143":144,"_145":146,"_147":148,"_149":150,"_151":152,"_153":154},"modules",{},"items",[20,21,22,23,24,25,26],"page",1,"pageCount","pageSize",20,{"_27":124,"_29":125,"_31":126,"_33":127,"_35":128,"_37":129,"_39":129,"_40":67,"_42":130,"_44":69,"_46":47,"_48":49,"_50":-5},{"_27":113,"_29":114,"_31":115,"_33":116,"_35":117,"_37":118,"_39":119,"_40":67,"_42":120,"_44":69,"_46":47,"_48":49,"_50":-5},{"_27":101,"_29":102,"_31":103,"_33":104,"_35":105,"_37":106,"_39":107,"_40":67,"_42":108,"_44":69,"_46":47,"_48":49,"_50":-5},{"_27":86,"_29":87,"_31":88,"_33":89,"_35":90,"_37":91,"_39":92,"_40":93,"_42":94,"_44":69,"_46":47,"_48":49,"_50":-5},{"_27":73,"_29":74,"_31":75,"_33":76,"_35":77,"_37":78,"_39":78,"_40":67,"_42":79,"_44":80,"_46":47,"_48":49,"_50":-5},{"_27":61,"_29":62,"_31":63,"_33":64,"_35":65,"_37":66,"_39":66,"_40":67,"_42":68,"_44":69,"_46":47,"_48":49,"_50":-5},{"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":38,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":-5},"id","mseoethc3gxuo1g1x8wpzwyy8","title","舒巴坦-度洛巴坦对比黏菌素治疗碳青霉烯耐药鲍曼不动杆菌感染达到非劣效","summary","III 期 ATTACK 试验中，舒巴坦-度洛巴坦对比黏菌素治疗碳青霉烯耐药鲍曼不动杆菌感染，主要终点 28 天全因死亡率达到统计学非劣效：舒巴坦-度洛巴坦组 63 例中 12 例（19%），黏菌素组 62 例中 20 例（32%），差异 –13.2%（95% CI –30.0 至 3.5）。","reason","III 期 ATTACK 试验显示该复方在 28 天全因死亡率上不劣于黏菌素，肾毒性更低，可对照耐药鲍曼不动杆菌的用药选择。","source",{"_59":60},"publishedAt","2023-05-12T17:15:43.184Z","timelineAt","category","clinical","tags",[51,52,53,54,55,56,57,58],"score",48,"selected",true,"channel","news","x","临床进展","抗菌药物","耐药与院感","论文/研究","抗感染","循证指南","对市场","FDA","name","Contagion Live·医院感染","w645syce82hq1hjesrdj3rfbs","FDA 对 Venatorx 的 cefepime-taniborbactam 治疗复杂性尿路感染发出 CRL","FDA 就 Venatorx Pharmaceuticals 与 Melinta Therapeutics 的 cefepime-taniborbactam NDA 发出完整回复函（CRL），该 β-内酰胺/β-内酰胺酶抑制剂复方拟用于成人复杂性尿路感染（cUTI），含敏感革兰阴性菌所致急性肾盂肾炎。","CRL 未要求补做临床试验，只卡在 CMC 环节，读者可据此判断这款含酶抑制剂复方抗生素的上市节奏。",{"_59":60},"2024-02-23T14:28:20.774Z","approval",[70,52,58,53,55,71,57,72],58,"获批上市","管线上新","对准入","gp38wyy02sytceppt8cx5wuc7","FDA 批准 GSK 反义寡核苷酸药物 Hibsago（bepirovirsen）联合现有抗病毒治疗用于慢性乙肝","FDA 批准 GSK 的 Hibsago（bepirovirsen）注射液联合现有抗病毒治疗，用于无肝硬化、已接受至少 6 个月抗病毒治疗、HBV 得到抑制且 HBsAg≤3,000 IU/mL 的部分成人慢性乙肝患者，这是 FDA 批准的首个治疗慢性乙肝的反义寡核苷酸。","原文给出获批人群的HBsAg阈值与停药后病毒控制比例，读者可据此判断适用患者范围。",{"_59":85},"2026-10-20T19:40:38.000Z",[70,81,82,58,83,84],52,"感染/疫苗","核酸药物","GSK","罗氏","FDA 新闻稿","cy615dx5b3ywgwqj1m58mizck","FDA 要求所有 GLP-1 药物说明书新增 NAION 眼病风险警示，涉及司美格鲁肽、替尔泊肽","11 月 9 日，FDA 要求所有 GLP-1 受体激动剂上市许可持有人在美国说明书“警告和注意事项”部分增加非动脉炎性前部缺血性视神经病变（NAION）潜在风险信息，范围从司美格鲁肽扩至替尔泊肽及 2026 年获批的口服小分子 Foundayo。","FDA 把 NAION 警示从司美格鲁肽扩至全部 GLP-1 药物，读者可据此了解说明书修订范围与各国监管口径差异。",{"_59":100},"2026-11-10T11:54:18.000Z","2026-11-11T08:18:17.999Z","policy",[95,96,97,58,98,99],"政策/监管","GLP-1","代谢/减重","诺和诺德","礼来","赛柏蓝","pjbipbd33vluv26wpuotpgab5","和誉医药盐酸匹米替尼胶囊获FDA批准用于症状性腱鞘巨细胞瘤","和誉医药自主研发的CSF-1R小分子抑制剂贝捷迈（盐酸匹米替尼胶囊）获FDA批准，用于系统性治疗手术切除可能导致功能受限加重或严重并发症的症状性腱鞘巨细胞瘤成年患者。","材料给出FDA批准的适应症范围与III期MANEUVER研究终点数据，可据此判断该药在TGCT治疗中的位置。",{"_59":112},"2026-11-11T00:00:00.000Z","2026-11-11T14:10:20.986Z",[70,109,110,111,58],"肿瘤","罕见病","小分子","生物谷","isf4rwjr6b7h76v7w18kbidfi","拜耳 Factor XIa 抑制剂 asundexian 获 FDA 批准，商品名 Sunharbo，用于卒中二级预防","FDA 批准拜耳的口服 Factor XIa 抑制剂 asundexian（商品名 Sunharbo）用于特定成人患者的卒中二级预防，需与抗血小板治疗联用。支持获批的研究入组逾 12,000 名既往发生预警性卒中或心源性以外血栓性卒中的成人，一半接受安慰剂、一半每日一次 Sunharbo，结果显示缺血性卒中风险较对照组降低 26%，两组大出血例数相近，最常见不良反应为腹泻。","FDA 批准拜耳 asundexian 用于卒中二级预防，关键三期数据同时给出疗效幅度与出血风险对比。",{"_59":123},"2026-11-09T22:40:00.000Z","2026-11-11T14:10:21.623Z",[70,121,111,58,122],"心血管","拜耳","BioPharma Dive","vctf7j6uc0nahai9q474ga4re","依沃西美国BLA收到FDA完整回复函，HARMONi研究OS未跨显著性门槛","Summit Therapeutics于2026年11月15日公告，依沃西（ivonescimab，AK112，PD-1/VEGF双抗）用于三代EGFR-TKI耐药EGFR突变非鳞NSCLC的美国BLA收到FDA完整回复函，暂未获批。","原文拆解了HARMONi研究OS差0.012未过阈值的统计细节，以及拼接队列设计如何放大这一风险。",{"_59":133},"2026-11-16T09:59:09.000Z",[70,109,131,58,132],"抗体/双抗","康方生物","药时代","slug","fda","美国 FDA","group","company","definition","FDA 的审评与监管动作：新药与新适应症批准、完全回应函、加速通道、咨询委员会与指南更新。","brand",{"_156":-5,"_157":158,"_159":148},"total",7,"recent",4,"indexable",false,"latest",{"_29":125,"_155":129},"groupName","药企与机构","poolTotal",83,"at","src","monogram","美","raster",{"_161":162,"_163":-5,"_164":47},"changelogVersion","2026-10-08T08:00","release","staticSite"]
