[{"_1":2,"_3":4},"root",{"_5":97},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_77":78,"_51":79,"_80":81,"_82":83,"_84":-5,"_85":86,"_87":86,"_88":89,"_90":91,"_92":93,"_94":95},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":65,"_25":66,"_27":67,"_29":68,"_31":69,"_33":70,"_35":71,"_36":59,"_38":72,"_40":73,"_42":43,"_44":45,"_46":-5},{"_23":53,"_25":54,"_27":55,"_29":56,"_31":57,"_33":58,"_35":58,"_36":59,"_38":60,"_40":61,"_42":43,"_44":45,"_46":-5},{"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":34,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","lwtqu9d7j0ejq9d4m7utgegl6","title","恒瑞医药甲苯磺酸瑞马唑仑新增 ICU 机械通气镇静适应症获批","summary","NMPA 批准恒瑞医药 1 类创新药注射用甲苯磺酸瑞马唑仑（瑞倍宁）新增适应症，用于重症监护期间机械通气时的镇静。此次获批基于两项关键研究，包括短期镇静的 III 期 HR7056-302 研究（43 家中心、211 例患者）和长期镇静的 II 期 HR7056-206 研究（18 家中心、23 例患者），两项研究主要终点均达到预期。","reason","原文交代了新增适应症的两项关键研究设计与样本量，读者可据此判断该药在 ICU 镇静场景的定位。","source",{"_51":52},"publishedAt","2026-10-28T00:00:00.000Z","timelineAt","category","approval","tags",[47,48,49,50],"score",58,"selected",true,"channel","news","x","获批上市","恒瑞医药","NMPA","神经/精神","name","恒瑞医药·新闻","m0zihkhitp8ytxxu7jgdtft05","石药集团棕榈酸帕利哌酮注射液首批发货，24小时内送达山东、北京等地","10月28日，石药集团中诺药业（石家庄）首批棕榈酸帕利哌酮注射液正式发运，未来24小时内陆续送达山东、北京，48小时内送达重庆、广东、江西、贵州及全国各地。该产品2026年7月21日获批，适用于精神分裂症急性期和维持期治疗，为每月给药一次的长效抗精神病针剂。原文称对比口服药物，用药第4天PANSS评分有显著改善，24周随访结果提示复发风险下降29.4%。","原文交代了这款国产长效针剂的发货节奏与获批时间，读者可据此判断其临床可及性的推进速度。",{"_51":64},"2026-10-29T00:00:00.000Z","industry",[62,50,63],47,"公司动态","石药集团","石药集团·新闻中心","wbm2snhs4cop4oc1zaytxx14n","熙源安健两项偏头痛临床前项目授权艾伯维，潜在总额最高7.57亿美元","熙源安健公布与艾伯维独家授权合作进展，两项偏头痛临床前项目的潜在交易总价值最高可达7.57亿美元，另加未来产品销售分成。协议于2024年签署，熙源安健负责药物发现，艾伯维主导全球开发与商业化；两个项目的名称、靶点、技术模态及首付款、分成比例均未披露。","协议2024年签署、如今披露进展，可看清两项偏头痛临床前项目的授权结构与里程碑上限。",{"_51":76},"2026-11-03T01:55:20.000Z","2026-11-03T15:25:06.698Z",[74,50,75],56,"交易/授权","艾伯维","药时代","slug","neuroscience","神经与精神","group","field","definition","中枢神经系统领域：阿尔茨海默病、帕金森、抑郁与精神分裂症的新机制与临床进展。","brand","total",3,"recent","indexable",false,"latest",{"_25":66,"_96":71},"groupName","治疗领域","poolTotal",86,"at",{"_98":99,"_100":-5,"_101":43},"changelogVersion","2026-10-08T08:00","release","staticSite"]
