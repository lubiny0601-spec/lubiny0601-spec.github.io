[{"_1":2,"_3":4},"root",{"_5":77},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443578000,{"_54":55,"_52":47,"_56":57,"_58":59,"_60":61,"_62":16,"_63":16,"_64":65,"_66":67,"_68":69,"_70":71},"modules",{},"items",[20],"page",1,"pageCount","pageSize",20,{"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5},"id","o3lol3xj4fq1fb6zsy1cf74n0","title","百济神州前三季净利润增431.8%，全年营收指引第三次上调至463-470亿元","summary","百济神州2026年前三季度营收349.93亿元、同比增26.8%，归母净利润60.55亿元、同比增431.8%，全年营收指引第三次上调至463-470亿元。泽布替尼第三季度全球销售94.24亿元、同比增27%，前三季度累计255.51亿元，其中美国市场单季贡献68.16亿元。","reason","百济神州三季报显示利润主要来自泽布替尼在欧美的销售而非授权变现，可与国内其他创新药企的路径作对照。","source",{"_52":53},"publishedAt","2026-11-05T16:00:00.000Z","timelineAt","category","industry","tags",[45,46,47,48,49,50,51],"score",74,"selected",true,"channel","news","x","公司动态","市场/销售","百济神州","肿瘤","血液","ADC","抗体/双抗","name","医药云端工作室","slug","beigene","group","company","definition","百济神州的全球临床与商业化进展：泽布替尼、实体瘤管线与海外注册。","brand",{"_73":-5,"_74":75,"_76":65},"total","recent","indexable",false,"latest",{"_23":24,"_72":32},"groupName","药企与机构","poolTotal",3,"at","src","monogram","百","raster",{"_78":79,"_80":-5,"_81":41},"changelogVersion","2026-10-08T08:00","release","staticSite"]
