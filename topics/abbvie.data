[{"_1":2,"_3":4},"root",{"_5":92},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_68":69,"_50":49,"_70":71,"_72":73,"_74":75,"_76":77,"_78":77,"_79":80,"_81":82,"_83":84,"_85":86},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":52,"_24":53,"_26":54,"_28":55,"_30":56,"_32":57,"_34":57,"_36":37,"_38":58,"_40":59,"_42":43,"_44":45,"_46":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","wbm2snhs4cop4oc1zaytxx14n","title","熙源安健两项偏头痛临床前项目授权艾伯维，潜在总额最高7.57亿美元","summary","熙源安健公布与艾伯维独家授权合作进展，两项偏头痛临床前项目的潜在交易总价值最高可达7.57亿美元，另加未来产品销售分成。协议于2024年签署，熙源安健负责药物发现，艾伯维主导全球开发与商业化；两个项目的名称、靶点、技术模态及首付款、分成比例均未披露。","reason","协议2024年签署、如今披露进展，可看清两项偏头痛临床前项目的授权结构与里程碑上限。","source",{"_50":51},"publishedAt","2026-11-03T01:55:20.000Z","timelineAt","2026-11-03T15:25:06.698Z","category","industry","tags",[47,48,49],"score",56,"selected",true,"channel","news","x","交易/授权","神经/精神","艾伯维","name","药时代","ur7psg8u9pifv5lugm61i0b2j","默沙东、礼来、艾伯维、辉瑞、BMS 向美国众议院委员会表示不在新疆及解放军关联医院启动新临床试验","美国众议院中国问题特别委员会披露，默沙东、礼来、艾伯维、辉瑞、BMS 五家药企已书面表示，不计划在中国新疆地区或与中国军方关联的医院启动新的临床试验点。该委员会去年 6 月对上述五家公司展开调查，关注试验点的知识产权暴露、军方关联与伦理标准问题；五家公司均表示不会在与解放军关联的试验点启动新临床研究。","美国众议院委员会调查五家跨国药企在华临床试验，企业以书面承诺回应，反映地缘政治对试验布局的影响。",{"_50":67},"2026-11-20T00:00:00.000Z",[60,61,62,63,64,49,65,66],58,"公司动态","行业趋势","FDA","默沙东","礼来","辉瑞","BMS","STAT","slug","abbvie","group","company","definition","艾伯维的自免与神经管线、Humira 之后的接棒品种与收购布局。","brand",{"_88":-5,"_89":90,"_91":80},"total",2,"recent","indexable",false,"latest",{"_24":53,"_87":57},"groupName","药企与机构","poolTotal",3,"at","src","monogram","艾","raster",{"_93":94,"_95":-5,"_96":43},"changelogVersion","2026-10-08T08:00","release","staticSite"]
