[{"_1":2,"_3":4},"root",{"_5":150},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443580000,{"_129":130,"_57":131,"_132":133,"_134":135,"_136":-5,"_137":138,"_139":140,"_141":142,"_143":144,"_145":146,"_147":148},"modules",{},"items",[20,21,22,23,24,25,26,27],"page",1,"pageCount","pageSize",20,{"_28":118,"_30":119,"_32":120,"_34":121,"_36":122,"_38":123,"_40":124,"_41":42,"_43":125,"_45":126,"_47":48,"_49":50,"_51":-5},{"_28":109,"_30":110,"_32":111,"_34":112,"_36":113,"_38":114,"_40":114,"_41":42,"_43":115,"_45":116,"_47":48,"_49":50,"_51":-5},{"_28":101,"_30":102,"_32":103,"_34":104,"_36":105,"_38":106,"_40":106,"_41":42,"_43":107,"_45":46,"_47":48,"_49":50,"_51":-5},{"_28":89,"_30":90,"_32":91,"_34":92,"_36":93,"_38":94,"_40":95,"_41":42,"_43":96,"_45":75,"_47":48,"_49":50,"_51":-5},{"_28":77,"_30":78,"_32":79,"_34":80,"_36":81,"_38":82,"_40":83,"_41":84,"_43":85,"_45":46,"_47":48,"_49":50,"_51":-5},{"_28":67,"_30":68,"_32":69,"_34":70,"_36":71,"_38":72,"_40":73,"_41":42,"_43":74,"_45":75,"_47":48,"_49":50,"_51":-5},{"_28":59,"_30":60,"_32":61,"_34":62,"_36":63,"_38":64,"_40":64,"_41":42,"_43":65,"_45":66,"_47":48,"_49":50,"_51":-5},{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":39,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":-5},"id","ev79pzod1ph1radmakxynohg8","title","北京取消哈尔滨力强药业洛索洛芬钠凝胶贴膏集采中选资格并撤网","summary","北京市医药集中采购服务中心通知，哈尔滨力强药业生产的洛索洛芬钠凝胶贴膏因生产线严重缺陷、GMP符合性检查不合格，被取消第十一批国家集采中选资格，该产品已在平台撤网。按集采规则，其约定采购量由涉及医疗机构在该品种其他中选企业中自行选择供应企业。","reason","北京医保局据此撤网并明确约定采购量的重新分配方式，涉及集采中选药品的供应衔接。","source",{"_57":58},"publishedAt","2026-05-09T00:00:00.000Z","timelineAt","category","policy","tags",[52,53,54,55,56],"score",58,"selected",true,"channel","news","x","政策/监管","安全/质量","医保/集采","抗感染","市场准入","name","北京医保局·药品通知公告","q2ih701hdegk1l2im0s371mhd","北京取消山东北大高科华泰制药盐酸胺碘酮注射液中选资格并撤网","北京市医药集中采购服务中心发布通知，山东北大高科华泰制药有限公司生产的盐酸胺碘酮注射液（第九批国家集采中选药品）因生产线严重缺陷、评定结论不符合要求，被取消国家集采中选资格，该产品已在平台做撤网处理。此前国家联合采购办公室于2026年6月9日发布公告取消其中选资格，并将该企业列入违规名单。","北京平台对第九批国家集采中选药品执行撤网，读者可据此了解中选资格取消后的落地处置节奏。",{"_57":58},"2026-06-22T00:00:00.000Z",[52,54,53],62,"oe38y0k8hxh7ja9rqykh82srz","广东联盟取消西安利君康乐氯化钠注射液中选资格","广东省药品交易中心公告，因陕西省药监部门检查发现西安利君康乐制药有限责任公司药品生产质量管理不符合要求并已暂停其氯化钠注射液（250ml:2.25g、500ml:4.5g，直立式聚丙烯输液袋）生产、销售，依据《广东联盟双氯芬酸等药品接续采购文件（GDYJYPDL202501）》取消该产品在广东联盟双氯芬酸等药品接续采购的中选资格。","陕西药监因生产质量管理问题暂停该产品生产销售，广东联盟据此取消其中选资格，可看集采中选资格的风险处置链条。",{"_57":76},"2026-11-03T16:00:00.000Z","2026-11-05T05:13:29.209Z",[52,53,54],47,"广东省药品交易中心·通知公告","k9lo3hff5lckcsrhcpahgtr46","Madrigal前临床开发负责人起诉，指控Rezdiffra试验数据被操纵","Madrigal前高级副总裁、临床开发负责人Michael Charlton向美国伊利诺伊州北区联邦地区法院提起SOX吹哨人报复诉讼，指控公司隐瞒Rezdiffra肝脏安全风险、操纵临床试验数据、篡改EASL会议披露的MAESTRO-NAFLD-1 F4c队列两年随访结果，并在其上报后将其调岗、2026年1月5日离职。","前临床负责人以吹哨人诉讼指控试验数据被干预，读者可据此观察MASH药物证据链与监管复核的走向。",{"_57":88},"2026-11-10T01:21:07.000Z","2026-11-11T08:09:23.197Z","industry",[53,86,87],"代谢/减重","其他","药时代","t6wzabnp4fwctewdoxf02csze","国家药监局通告27批次不符合规定药品，涉加替沙星滴眼液、盐酸莫西沙星片等","国家药监局11月12日发布2026年第39号通告，经7家药品检验机构检验，17家企业生产的27批次药品不符合规定。其中郑州卓峰制药、楚雄老拨云堂药业的4批次加替沙星滴眼液可见异物不合格，桂林南药的3批次盐酸莫西沙星片溶出度不合格，武汉华龙生物制药的5批次聚明胶肽注射液涉及热原和可见异物。药监部门已要求相关企业暂停销售使用、召回并调查整改，省级药监部门将立案调查涉嫌违法行为。","通告列出17家企业27批次不合格药品的具体品种与检验项目，可供判断相关品类的质量风险与召回范围。",{"_57":100},"2026-11-12T00:00:00.000Z","2026-11-12T14:18:47.963Z",[52,53,97,98,99,55,56],"NMPA","抗菌药物","中药","中国食品药品网·要闻","n8ny1rrie44hl16x3pvc0ad5h","深圳医保联合公安整治超量开药，事前提醒拦截金额超3600万元","深圳市医保部门针对门诊共济改革后超量开药套取医保基金行为，采取数据穿透、行刑联动、事前拦截等措施，联合公安抓获犯罪嫌疑人30名，涉案金额200余万元，15名涉案人员被依法处理。当地开发累计用量超限、密集型开药、重复购药等11类超量开药事前提醒规则，涉及1235种药品、超10万个品规，累计预警提醒16.17万次，拦截金额3694万元，全市遵从率39.3%。","深圳医保披露超量开药事前提醒规则的覆盖品规与拦截金额，可看到门诊共济后基金监管的具体抓手。",{"_57":108},"2026-11-13T00:00:00.000Z",[52,54,108,53],"国家医保局","pyvov8yvcdpsq8ma7olreownp","上海暂停南京泽恒医药舒更葡糖钠注射液采购资格","上海市医药集中招标采购事务管理所发布通知，因江苏省药监局检查发现南京泽恒医药技术开发有限公司委托亚邦医药股份有限公司生产的舒更葡糖钠注射液上市许可持有人与受托企业质量管理体系均存在缺陷、生产不符合要求，自2026年11月21日0时起暂停该品种两个规格（5ml:500mg、2ml:200mg）的采购资格。","上海招采部门依据江苏药监检查结果暂停该品种采购资格，读者可据此了解集采中选药品的质量联动处置方式。",{"_57":117},"2026-11-20T00:00:00.000Z",[52,53,54],55,"上海阳光医药采购网","u2gdvowt6n9yfb29t6012vctj","上海暂停桂林南药盐酸莫西沙星片采购资格","上海市医药集中招标采购事务管理所通知，桂林南药股份有限公司持有并生产的盐酸莫西沙星片为1-8批国家集采协议期满接续采购中选药品，因经辽宁省药品检验检测院检验溶出度不符合规定，自2026年11月24日0时起暂停该药品在上海市招采子系统的采购资格。此次暂停依据国家药监局2026年11月12日发布的《关于27批次不符合规定药品的通告》（2026年第39号），涉及0.4g规格3片/盒与6片/盒两种包装。","国家集采中选药品因溶出度不合格被暂停采购资格，读者可据此了解中选药品质量问题的处理路径。",{"_57":117},"2026-11-23T00:00:00.000Z","2026-11-23T12:26:30.217Z",[52,98,53,55,56,127,128],72,"对销售","对准入","slug","safety","安全与质量","group","genre","definition","药品安全与质量事件：不良反应、召回、警戒信号、监管检查与数据合规争议。","brand","total",8,"recent",6,"indexable",false,"latest",{"_30":119,"_149":124},"groupName","内容形态","poolTotal",46,"at",{"_151":152,"_153":-5,"_154":48},"changelogVersion","2026-10-08T08:00","release","staticSite"]
