[{"_1":2,"_3":4},"root",{"_5":99},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_74":75,"_49":48,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93},"modules",{},"items",[20,21,22],"page",1,"pageCount","pageSize",20,{"_23":63,"_25":64,"_27":65,"_29":66,"_30":67,"_32":68,"_34":69,"_35":36,"_37":70,"_39":71,"_41":42,"_43":44,"_45":-5},{"_23":51,"_25":52,"_27":53,"_29":54,"_30":55,"_32":56,"_34":56,"_35":36,"_37":57,"_39":40,"_41":42,"_43":44,"_45":-5},{"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":33,"_34":33,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5},"id","vtbor151625bb5rmj32hp54r3","title","恒瑞医药与诺和诺德就 HRS-1596 项目签署授权许可协议","summary","恒瑞医药公告与 Novo Nordisk A/S 就 HRS-1596 项目签署授权许可协议，公告未披露交易金额、首付款与里程碑等条款细节。","reason","source",{"_49":50},"publishedAt","2026-09-28T16:00:00.000Z","timelineAt","category","industry","tags",[46,47,48],"score",62,"selected",true,"channel","news","x","交易/授权","恒瑞医药","诺和诺德","name","恒瑞医药·公司公告","l791o61rlz337pw1iyoxzxx0g","诺和诺德三季报：司美格鲁肽系列前三季度销售268.20亿美元","诺和诺德三季报显示，司美格鲁肽系列四款产品前三季度合计销售1726.38亿丹麦克朗，约合268.20亿美元；其中注射减重版Wegovy 581.26亿丹麦克朗（+4%），口服减重版Wegovy 108.68亿丹麦克朗，注射降糖版Ozempic 889.06亿丹麦克朗（-3%），口服降糖版Rybelsus 147.38亿丹麦克朗（-10%）。","财报拆出司美格鲁肽四款产品的销售分化与降价安排，可看清GLP-1在美国支付方压力下的价格走向。",{"_49":62},"2026-11-04T12:35:56.000Z",[58,59,60,61,48],"公司动态","市场/销售","代谢/减重","GLP-1","药时代","ucq247nraf34rd1grsxyk3l1a","诺和诺德前三季度中国区收入约23亿美元，GLP-1下降18%","诺和诺德2026年前三季度全球净销售额2545.06亿丹麦克朗（约395.45亿美元），按固定汇率同比增长13%；中国区收入147.78亿丹麦克朗（约22.96亿美元），同比下滑2%，第三季度单季再降5%。","财报拆出中国区胰岛素与GLP-1的分化，并解释替尔泊肽进医保后的价格竞争如何改变格局。",{"_49":73},"2026-11-04T09:40:00.000Z","2026-11-05T05:15:43.700Z",[58,59,61,60,48,72],67,"礼来","医药云端工作室","slug","novonordisk","group","company","definition","诺和诺德的 GLP-1 管线与产能、口服司美格鲁肽与减重市场竞争格局。","brand",{"_95":-5,"_96":97,"_98":87},"total",3,"recent",2,"indexable",false,"latest",{"_25":64,"_94":69},"groupName","药企与机构","poolTotal",6,"at","src","monogram","诺","ra