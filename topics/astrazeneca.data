[{"_1":2,"_3":4},"root",{"_5":94},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_70":71,"_56":53,"_72":73,"_74":75,"_76":77,"_78":79,"_80":79,"_81":82,"_83":84,"_85":86,"_87":88},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":58,"_24":59,"_26":60,"_28":61,"_30":62,"_32":63,"_34":63,"_36":37,"_38":64,"_40":65,"_42":43,"_44":45,"_46":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5},"id","j4zrr31ulofr0ili2zybn9ysp","title","礼来、阿斯利康等五家MNC公布2026年三季报，中国区表现分化","summary","礼来、阿斯利康、默沙东、BMS、吉利德五家MNC公布2026年三季报，礼来Q3营收243.97亿美元、同比增长39%，市值首破1.3万亿美元。替尔泊肽降糖版与减重版前三季度合计437.68亿美元、占总营收65%，中国区Q3收入9.47亿美元、同比增69%，穆峰达2型糖尿病适应症2026年1月纳入国家医保后最低规格月治疗费降至324.1元。","reason","五家MNC三季报横向对照，中国区被单列成三种状态，可看清医保准入与集采对同一批品种的不同作用。","source",{"_56":57},"publishedAt","2026-11-02T01:42:02.000Z","timelineAt","2026-11-02T13:59:16.230Z","category","industry","tags",[47,48,49,50,51,52,53,54,55],"score",62,"selected",true,"channel","news","x","市场/销售","行业趋势","代谢/减重","肿瘤","GLP-1","礼来","阿斯利康","默沙东","BMS","name","医药云端工作室","uxri1pyf171pxd7lc2rcfrcse","阿斯利康拟约100亿美元收购Rhythm Pharmaceuticals，押注MC4R通路罕见肥胖药","路透社援引知情人士称，阿斯利康已提出以约100亿美元收购肥胖症药物公司Rhythm Pharmaceuticals，报价最高每股134美元，部分与里程碑挂钩，此前曾报每股124美元；消息传出后Rhythm收涨28%报110.68美元，市值约76.4亿美元，交易拟由Alexion主导。","交易把MC4R通路与GLP-1的适用人群切开，读者可据此判断罕见肥胖赛道的定价与准入风险。",{"_56":69},"2026-11-06T03:16:13.000Z",[66,49,67,53,68,52],60,"投融资","罕见病","诺和诺德","药时代","slug","astrazeneca","group","company","definition","阿斯利康的 ADC 与肿瘤管线、呼吸与自免业务，以及中国区投资与合规动态。","brand",{"_90":-5,"_91":92,"_93":82},"total",2,"recent","indexable",false,"latest",{"_24":59,"_89":63},"groupName","药企与机构","poolTotal",13,"at","src","monogram","阿","raster",{"_95":96,"_97":-5,"_98":43},"changelogVersion","2026-10-08T08:00","release","staticSite"]
