[{"_1":2,"_3":4},"root",{"_5":91},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443578000,{"_67":68,"_51":49,"_69":70,"_71":72,"_73":74,"_75":76,"_77":76,"_78":79,"_80":81,"_82":83,"_84":85},"modules",{},"items",[20,21],"page",1,"pageCount","pageSize",20,{"_22":53,"_24":54,"_26":55,"_28":56,"_30":57,"_32":58,"_34":59,"_35":60,"_37":61,"_39":62,"_41":42,"_43":44,"_45":-5},{"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":33,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5},"id","wpfhggmkk6ffduhwdpksxu7e7","title","康方生物依沃西联合化疗一线治疗胆道癌 III 期 HARMONi-GI1 达到 OS 主要终点","summary","2026 ESMO 大会上，康方生物公布依沃西联合化疗对比度伐利尤单抗联合化疗一线治疗晚期胆道癌的 III 期 HARMONi-GI1 研究结果，达到 OS 主要终点，中位 OS 为 14.9 vs 12.1 个月（HR=0.75，95% CI:0.61-0.92，P=0.0031）。","reason","HARMONi-GI1 是依沃西在肺癌之外的首个 III 期阳性读出，读者可据此判断 PD-1/VEGF 双抗跨瘤种复制的可能性。","source",{"_51":52},"publishedAt","2026-10-26T03:58:53.000Z","timelineAt","category","clinical","tags",[46,47,48,49,50],"score",48,"selected",true,"channel","news","x","临床进展","肿瘤","抗体/双抗","康方生物","阿斯利康","name","医药魔方","zvcswwfefxttd1xlg5v4xroyw","康方生物古莫奇单抗获批活动性强直性脊柱炎新适应症","11月13日，国家药监局官网显示康方生物自主研发的IL-17A单抗古莫奇单抗（AK111）获批新适应症，用于活动性强直性脊柱炎，这是继2026年6月斑块状银屑病之后该药的第2项适应症。","原文梳理了古莫奇单抗两项适应症的获批节奏与康方自免管线梯队，也点出IL-17赛道已有7款单靶点药物获批的竞争格局。",{"_51":66},"2026-11-14T01:51:16.000Z","2026-11-16T01:00:56.400Z","approval",[63,64,48,49,65],58,"获批上市","自免","NMPA","医药云端工作室","slug","akeso","group","company","definition","康方生物的双抗与肿瘤免疫管线：临床数据、获批进展与对外授权。","brand",{"_87":-5,"_88":89,"_90":79},"total",2,"recent","indexable",false,"latest",{"_24":54,"_86":59},"groupName","药企与机构","poolTotal",4,"at","src","monogram","康","raster",{"_92":93,"_94":-5,"_95":42},"changelogVersion","2026-10-08T08:00","release","staticSite"]
