[{"_1":2,"_3":4},"root",{"_5":116},"topic",{"_5":6},"data",{"_5":7,"_8":9},{"_3":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19},"expiresAt",1795443579000,{"_91":92,"_52":51,"_93":94,"_95":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":106,"_107":108,"_109":110},"modules",{},"items",[20,21,22,23],"page",1,"pageCount","pageSize",20,{"_24":76,"_26":77,"_28":78,"_30":79,"_32":80,"_34":81,"_36":81,"_37":60,"_39":82,"_41":42,"_43":44,"_45":46,"_47":-5},{"_24":66,"_26":67,"_28":68,"_30":69,"_32":70,"_34":71,"_36":71,"_37":38,"_39":72,"_41":42,"_43":44,"_45":46,"_47":-5},{"_24":54,"_26":55,"_28":56,"_30":57,"_32":58,"_34":59,"_36":59,"_37":60,"_39":61,"_41":42,"_43":44,"_45":46,"_47":-5},{"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":35,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":-5},"id","t1oz14g5msw80jra3s689ea4q","title","默沙东来特莫韦片（Ⅱ）在华上市，用于儿童及成人HSCT后CMV预防","summary","默沙东宣布来特莫韦片（Ⅱ）在中国境内上市，用于接受异基因造血干细胞移植的CMV血清学阳性成人和6个月及以上且体重≥6 kg的儿童受者预防CMV感染和CMV病。新剂型规格为120mg/袋，微型片剂尺寸仅2mm，可与软食混合口服或经鼻胃管、胃管给药，便于按体重和是否合用环孢素在40-240mg间调整剂量。","reason","来特莫韦片（Ⅱ）以120mg微型片剂补齐儿童HSCT后CMV预防的口服给药方式，读者可据此了解剂量调整与给药途径的变化。","source",{"_52":53},"publishedAt","2026-09-16T00:00:00.000Z","timelineAt","category","approval","tags",[48,49,50,51],"score",58,"selected",true,"channel","news","x","获批上市","感染/疫苗","血液","默沙东","name","米内网·企业","lvmp7rdrpv4euofk5na8u2v6z","默克以约13亿美元收购Silence Therapeutics，溢价82%拿下siRNA平台与PV疗法divesiran","默克宣布以约13亿美元股权价值收购英国siRNA生物技术公司Silence Therapeutics，较过去30个交易日平均股价溢价82%。核心资产是靶向TMPRSS6的siRNA疗法divesiran，用于真性红细胞增多症（PV），其Ⅱ期SANRECO试验中治疗组临床应答率88%、安慰剂组19%，截至第36周平均放血0.2次对2.1次。","这笔收购把溢价水平、Ⅱ期应答率与竞品先发格局放在一起，可据此判断默克切入血液学的定价逻辑。",{"_52":65},"2026-10-20T09:28:19.000Z","industry",[62,50,63,64,51],"交易/授权","核酸药物","罕见病","药时代","a0d1ppm6h8d9vjow71su0dyiv","默沙东贝组替凡在华获批PPGL新适应症，HIF-2α抑制剂首入罕见肿瘤通道","10月22日默沙东宣布维利瑞（贝组替凡片）在华获批新适应症，用于12岁及以上局部晚期、不可切除或转移性嗜铬细胞瘤或副神经节瘤（PPGL）患者。获批依据是全球LITESPARK-015的II期数据，72例患者每日一次120mg口服，确认ORR 26%，DCR 85%，中位DoR 20.4个月，中位PFS 22.3个月，2年OS率76%。","从机制独占、VHL适应症底座和医保支付三层拆解这款罕见肿瘤药的商业化路径，可迁移到同类小众靶向药的准入判断。",{"_52":75},"2026-10-28T08:45:10.000Z",[48,73,64,74,51],"肿瘤","NMPA","医药云端工作室","ur7psg8u9pifv5lugm61i0b2j","默沙东、礼来、艾伯维、辉瑞、BMS 向美国众议院委员会表示不在新疆及解放军关联医院启动新临床试验","美国众议院中国问题特别委员会披露，默沙东、礼来、艾伯维、辉瑞、BMS 五家药企已书面表示，不计划在中国新疆地区或与中国军方关联的医院启动新的临床试验点。该委员会去年 6 月对上述五家公司展开调查，关注试验点的知识产权暴露、军方关联与伦理标准问题；五家公司均表示不会在与解放军关联的试验点启动新临床研究。","美国众议院委员会调查五家跨国药企在华临床试验，企业以书面承诺回应，反映地缘政治对试验布局的影响。",{"_52":90},"2026-11-20T00:00:00.000Z",[83,84,85,51,86,87,88,89],"公司动态","行业趋势","FDA","礼来","艾伯维","辉瑞","BMS","STAT","slug","msd","group","company","definition","默沙东的 Keytruda 生命周期管理、ADC 与减重布局、大额授权交易。","brand",{"_112":-5,"_113":114,"_115":104},"total",4,"recent",2,"indexable",false,"latest",{"_26":77,"_111":81},"groupName","药企与机构","poolTotal",10,"at","src","monogram","默","raster",{"_117":118,"_119":-5,"_120":44},"changelogVersion","2026-10-08T08:00","release","staticSite"]
