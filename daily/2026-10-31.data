il?id=2116083198168403968","publishedAt","2026-10-29T16:00:00.000Z","sourceIconUrl","/api/img-proxy?u=https%3A%2F%2Fwww.gdmede.com.cn%2Ffavicon.ico&mode=avatar&exp=1795651200&sig=7b6790186a8c4652","sourceIconSrcSet","/api/img-proxy?u=https%3A%2F%2Fwww.gdmede.com.cn%2Ffavicon.ico&mode=avatar-48&exp=1795651200&sig=e585872dca2ffb01 48w, /api/img-proxy?u=https%3A%2F%2Fwww.gdmede.com.cn%2Ffavicon.ico&mode=avatar&exp=1795651200&sig=7b6790186a8c4652 96w","firstParty",true,"available","行业动态",[114,115],{"_97":123,"_31":124,"_93":125,"_99":119,"_101":126,"_103":121,"_105":-5,"_109":122,"_111":110},{"_97":116,"_31":117,"_93":118,"_99":119,"_101":120,"_103":121,"_105":-5,"_109":122,"_111":110},"jmz88r1urpgnnp9pwu29er5lg","华东医药前三季营收超330亿元，6款新药报产在审、9款进入III期临床","华东医药2026年前三季营业收入超过330亿元、净利润27.72亿元，业绩双增长；2026年至今获批1个生物药3.3类新药和5个仿制药新品，另有6款新药报产在审、9款新药进入III期临床。","米内网·企业","https://www.menet.com.cn/info/202610/20261030090827827_151361.shtml","2026-10-30T00:00:00.000Z",false,"pfgtuq778gtb73e28xtcos8xf","上海医药2026年前三季度营收2229.64亿元，扣非净利润增长25.02%","上海医药公布2026年前三季度业绩，实现营业收入2229.64亿元，同比增长3.67%，扣非归母净利润33.74亿元，同比增长25.02%。工业板块收入189.89亿元、同比增长4.54%，商业板块收入2039.75亿元、同比增长3.59%，占总营收比重超过90%。报告期内研发费用15.16亿元，占医药工业收入比重7.98%，新药管线共60项，1类新药苹果酸司妥吉仑片已获批上市并在多个省份挂网。","https://www.menet.com.cn/info/202610/202610301622512251_151366.shtml",{"_97":123,"_31":124,"_93":125,"_99":119,"_101":126,"_103":121,"_105":-5,"_109":122,"_111":110},{"_97":116,"_31":117,"_93":118,"_99":119,"_101":120,"_103":121,"_105":-5,"_109":122,"_111":110},"leadParagraph",{"_131":132,"_133":-5,"_134":110},"changelogVersion","2026-10-08T08:00","release","staticSite"]
