xY3bYAGLsl4VY5bjwbIMXvXvdj9V0x1uRD9g9FrUznFicCVlRA8MOYJHKjEiaWlqLqsV7V68FWkueoWf45yVA%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=abee4bf1a3e99cca 96w","获批与准入",[125],{"_96":126,"_31":127,"_92":128,"_98":129,"_100":130,"_102":131,"_104":132,"_106":133,"_108":111,"_110":111},"vuc4hka58mwy0jh9bwuzpcuai","NMPA 批准阿舒克森片、巴托利单抗注射液等多款创新药上市","国家药监局批准阿舒克森片、巴托利单抗注射液、紫花温肺止嗽颗粒、盐酸艾泊度胺胶囊的注册申请。拜耳的1类创新药阿舒克森片经优先审评审批程序获批，用于降低缺血性卒中或高风险短暂性脑缺血发作成人患者的卒中风险，不包括心源性栓塞型卒中患者；巴托利单抗注射液与常规治疗药物联合用于抗乙酰胆碱受体抗体阳性的成人全身型重症肌无力。","中国食品药品网·要闻","https://www.cnpharm.com/c/2026-10-28/1109526.shtml","2026-10-28T00:00:00.000Z","/api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar&exp=1795651200&sig=c24b59b2539d0fa2","/api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar-48&exp=1795651200&sig=a6033af3171219fe 48w, /api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar&exp=1795651200&sig=c24b59b2539d0fa2 96w",{"_96":126,"_31":127,"_92":128,"_98":129,"_100":130,"_102":131,"_104":132,"_106":133,"_108":111,"_110":111},{"_96":115,"_31":116,"_92":117,"_98":118,"_100":119,"_102":120,"_104":121,"_106":122,"_108":109,"_110":111},"leadParagraph",{"_138":139,"_140":-5,"_141":111},"changelogVersion","2026-10-08T08:00","release","staticSite"]
