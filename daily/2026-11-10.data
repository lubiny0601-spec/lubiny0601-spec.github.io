blishedAt","2026-11-09T00:00:00.000Z","sourceIconUrl","/api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar&exp=1795651200&sig=c24b59b2539d0fa2","sourceIconSrcSet","/api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar-48&exp=1795651200&sig=a6033af3171219fe 48w, /api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar&exp=1795651200&sig=c24b59b2539d0fa2 96w","firstParty",true,"available","行业动态",[116,117],{"_97":70,"_39":52,"_93":127,"_101":128,"_103":129,"_105":106,"_107":-5,"_111":126,"_113":112},{"_97":118,"_39":119,"_93":120,"_101":121,"_103":122,"_105":123,"_107":124,"_109":125,"_111":126,"_113":112},"gd3mphdbgx3r4poc6o5rt2opp","九芝堂三季度单季利润增近6倍，陇神戎发单季亏损超千万","九芝堂前三季净赚3个多亿，三季度单季利润翻了近6倍；陇神戎发前三季营收下降近28%，三季度单季亏损1000多万，扣非净利润仅7万多。文章将分化归因于集采与医保控费压缩价格空间，临床价值证据不足的中药注射剂、辅助用药进院变难，并提到九芝堂以3.1亿收购吉象隆切入多肽赛道、陇神戎发九成收入依赖两个独家品种且销售费用削减三分之一。","医药云端工作室","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699512&idx=1&sn=5269ad3b53d3cd612bb7fe2f3e4d446e&chksm=bc2e21ff54a2c3f3c57152eef319f4aeb10c72410491af288b92138b70ac509e8f81b95cb003&scene=126&sessionid=1794205837#rd","2026-11-09T02:10:18.000Z","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=920757ef74ebe49f","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=9cb8174b387e7452 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=920757ef74ebe49f 96w",false,"葵花药业2026年前三季度营收约21.19亿元、同比增长25.81%，归母净利润约8353万元、同比增长349.07%，扣非归母净利润约4943万元、同比增长160.72%。公司拥有600余个生产批文、29个独家品种，2026H1在中国城市实体药店终端儿科中成药集团排名居首，份额保持13%以上。今年以来5个品种获批并视同过评，其中氟比洛芬凝胶贴膏为首款贴膏剂，美沙拉秦肠溶片在第12批国家集采中选。","米内网·企业","https://www.menet.com.cn/info/202611/202611090911261126_151405.shtml",{"_97":98,"_39":99,"_93":100,"_101":102,"_103":104,"_105":106,"_107":108,"_109":110,"_111":112,"_113":112},{"_97":118,"_39":119,"_93":120,"_101":121,"_103":122,"_105":123,"_107":124,"_109":125,"_111":126,"_113":112},"leadParagraph",{"_134":135,"_136":-5,"_137":112},"changelogVersion","2026-10-08T08:00","release","staticSite"]
