crGY40NstI9KRy4xGibFbQKxOmj4bsGPiaZUj6GX6GT7y8o5IhK2s0WmeUI2OpkvORFYDp0anficAMm01e7dLGAg%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=df299adc40fe2737 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2FqcrGY40NstI9KRy4xGibFbQKxOmj4bsGPiaZUj6GX6GT7y8o5IhK2s0WmeUI2OpkvORFYDp0anficAMm01e7dLGAg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=a6a1bb0cc49dcaf4 96w","政策与监管",[148,149,150,151],{"_91":70,"_39":55,"_94":168,"_96":169,"_98":170,"_100":171,"_102":172,"_104":173,"_106":109,"_108":109,"_167":32},{"_91":161,"_39":162,"_94":163,"_96":164,"_98":165,"_100":166,"_102":-5,"_106":109,"_108":109,"_167":30},{"_91":156,"_39":157,"_94":158,"_96":97,"_98":159,"_100":160,"_102":103,"_104":105,"_106":107,"_108":109},{"_91":152,"_39":153,"_94":154,"_96":113,"_98":155,"_100":124,"_102":116,"_104":117,"_106":107,"_108":109},"cy615dx5b3ywgwqj1m58mizck","FDA 要求所有 GLP-1 药物说明书新增 NAION 眼病风险警示，涉及司美格鲁肽、替尔泊肽","11 月 9 日，FDA 要求所有 GLP-1 受体激动剂上市许可持有人在美国说明书“警告和注意事项”部分增加非动脉炎性前部缺血性视神经病变（NAION）潜在风险信息，范围从司美格鲁肽扩至替尔泊肽及 2026 年获批的口服小分子 Foundayo。","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670067&idx=4&sn=1aba008d7091e137fec6c9de86badac5&chksm=bc6b73b20544af489e8ce63cb00b425215066594cac9d5821867fa8ee4c808a0ebefb093f24f&scene=126&sessionid=1794384945#rd","nlm0po7xu4108td3t4ubso8ho","中保协发布首版商保药品推荐清单，58款高值创新药械入选","11月10日，中国保险行业协会发布《商业健康保险药品保障推荐清单（第一版）》，首批遴选58款推荐药械，适应症覆盖肺癌、肝癌、血液肿瘤等高发恶性肿瘤及神经母细胞瘤等国家罕见病目录内肿瘤，其中1类创新药25款、2类改良型新药2款，基本医保目录外自费药32款。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699547&idx=1&sn=876e47f9b66147f900ca3c68d6e3b26c&chksm=bc71c129d5e5830141f99f0e62f4a5af2b31b84ccf34d9c6af210752518c8e58eee5adfc7f30&scene=126&sessionid=1794384876#rd","2026-11-10T11:29:40.000Z","rwnxfwlhpi92h2i7b7lkace12","上海启动第十二批国家集采未中选药品梯度降价填报，11月17日前未调价将暂停采购","上海阳光医药采购网开通第十二批国家集采未中选已挂网药品申报价填报通道，价格确认时间为2026年11月11日至11月17日。已挂网参比制剂和过评药品按系统参考治理价调整申报价，未过评药品按不高于本市有约定采购量中选药品最低价依差比价规则计算，中选产品非供应清单内的二同药品按其中选价格依差比价规则计算。","上海阳光医药采购网","https://www.smpaa.cn/xxgk/gggs/2026/11/11/25805.shtml","2026-11-11T00:00:00.000Z","otherSources","11月10日，国家卫生健康委、国家医保局、国家中医药局、国家疾控局联合发布《关于进一步做好创新药安全合理配备使用工作的通知》，明确国家医保谈判药品目录和商业健康保险创新药品目录内1类新药不计入一品两规，也不纳入门诊患者基本药物处方占比、住院次均药品费用增幅等公立医疗机构绩效监测指标。","中国食品药品网·要闻","https://www.cnpharm.com/c/2026-11-10/1110268.shtml","2026-11-10T00:00:00.000Z","/api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar&exp=1795651200&sig=c24b59b2539d0fa2","/api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar-48&exp=1795651200&sig=a6033af3171219fe 48w, /api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar&exp=1795651200&sig=c24b59b2539d0fa2 96w","行业动态",[176,177,178],{"_91":189,"_39":190,"_94":191,"_96":192,"_98":193,"_100":194,"_102":-5,"_106":107,"_108":109,"_167":30},{"_91":184,"_39":185,"_94":186,"_96":113,"_98":187,"_100":188,"_102":116,"_104":117,"_106":107,"_108":109},{"_91":179,"_39":180,"_94":181,"_96":97,"_98":182,"_100":183,"_102":103,"_104":105,"_106":107,"_108":109},"txkhvirutbeop5uax0772gvga","药明康德被美国国防部移出1260H清单，梳理近三年博弈前因后果","美国国防部决定将药明康德从1260H条款项下的中国军工企业名单中移除，药明康德11月9日获悉、11月10日在港交所公告。事件起于6月8日国防部更新清单将药明康德列为中国军工企业，公司6月11日在哥伦比亚特区联邦地区法院起诉，8月7日法院批准初步禁令，裁决意见书指出国防部认定存在事实错误。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699533&idx=1&sn=e7515636aee185ac0cff162018562e1d&chksm=bc7a8bbea5b43f458c997ff82f08a170f26addb3adbb08d8e21ff8a0205184988827cf9384cf&scene=126&sessionid=1794384876#rd","2026-11-10T02:07:57.000Z","dlqfgn0lci9cbq9wuo6tpwfpj","泰格医药拟出售方达控股控制权，剥离海外实验室业务","泰格医药11月10日公告，拟出售子公司方达控股控制权并剥离其海外实验室业务。香港泰格将与查尔斯河（CRL）、方达控股董事会主席李松博士及相关信托共同推进方达私有化、退出港股上市，再分拆业务由各方分别承接；私有化以共同设立的SanRex为收购主体，每股注销价2.37港元，较10月21日收盘价溢价约59.1%。交易完成后泰格医药及香港泰格不再持有方达股份，但仍持有拆分后保留的业务。","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670239&idx=1&sn=370c061360176f0269ef86b445a81470&chksm=bcac0cbca4d36b4b16e47ae37f6fd6f48a2bdabe2f9764d4b77d9333f36775869e782cfb7d81&scene=126&sessionid=1794384945#rd","2026-11-11T04:07:52.000Z","k9lo3hff5lckcsrhcpahgtr46","Madrigal前临床开发负责人起诉，指控Rezdiffra试验数据被操纵","Madrigal前高级副总裁、临床开发负责人Michael Charlton向美国伊利诺伊州北区联邦地区法院提起SOX吹哨人报复诉讼，指控公司隐瞒Rezdiffra肝脏安全风险、操纵临床试验数据、篡改EASL会议披露的MAESTRO-NAFLD-1 F4c队列两年随访结果，并在其上报后将其调岗、2026年1月5日离职。","药时代","https://www.drugtimes.cn/2026/11/10/nianxiaotupo10yimeiyuanzhijiyizhisuzhuangxilaiqianlinchuangf/","2026-11-10T01:21:07.000Z","获批与准入",[197,198,199],{"_91":213,"_39":214,"_94":215,"_96":216,"_98":217,"_100":218,"_102":-5,"_106":107,"_108":109},{"_91":208,"_39":209,"_94":210,"_96":211,"_98":212,"_100":166,"_102":-5,"_106":107,"_108":109},{"_91":200,"_39":201,"_94":202,"_96":203,"_98":204,"_100":205,"_102":206,"_104":207,"_106":109,"_108":109},"bocc708ws0d5id8d2e4how6i1","哈药股份哈药总厂注射用头孢唑肟钠通过仿制药一致性评价","哈药集团制药总厂收到 NMPA 颁发的《药品补充申请批准通知书》，注射用头孢唑肟钠 0.5g 与 1.0g 两个规格通过仿制药质量和疗效一致性评价。该药适用于敏感菌所致下呼吸道感染、尿路感染、腹腔感染、败血症、脑膜炎和单纯性淋病等。","哈药股份·公司公告","https://static.cninfo.com.cn/finalpage/2026-11-11/1225664721.PDF","2026-11-10T16:00:00.000Z","/api/img-proxy?u=http%3A%2F%2Fstatic.cninfo.com.cn%2Fnew%2Fimg%2Ffavicon.ico&mode=avatar&exp=1795651200&sig=31abe3ac3c56ac96","/api/img-proxy?u=http%3A%2F%2Fstatic.cninfo.com.cn%2Fnew%2Fimg%2Ffavicon.ico&mode=avatar-48&exp=1795651200&sig=a1d51bd4eb959fa9 48w, /api/img-proxy?u=http%3A%2F%2Fstatic.cninfo.com.cn%2Fnew%2Fimg%2Ffavicon.ico&mode=avatar&exp=1795651200&sig=31abe3ac3c56ac96 96w","pjbipbd33vluv26wpuotpgab5","和誉医药盐酸匹米替尼胶囊获FDA批准用于症状性腱鞘巨细胞瘤","和誉医药自主研发的CSF-1R小分子抑制剂贝捷迈（盐酸匹米替尼胶囊）获FDA批准，用于系统性治疗手术切除可能导致功能受限加重或严重并发症的症状性腱鞘巨细胞瘤成年患者。","生物谷","https://news.bioon.com/article/daf4963e948e.html","isf4rwjr6b7h76v7w18kbidfi","拜耳 Factor XIa 抑制剂 asundexian 获 FDA 批准，商品名 Sunharbo，用于卒中二级预防","FDA 批准拜耳的口服 Factor XIa 抑制剂 asundexian（商品名 Sunharbo）用于特定成人患者的卒中二级预防，需与抗血小板治疗联用。支持获批的研究入组逾 12,000 名既往发生预警性卒中或心源性以外血栓性卒中的成人，一半接受安慰剂、一半每日一次 Sunharbo，结果显示缺血性卒中风险较对照组降低 26%，两组大出血例数相近，最常见不良反应为腹泻。","BioPharma Dive","https://www.biopharmadive.com/news/bayer-sunharbo-asundexian-fda-approve-stroke-factor-xi/872837/","2026-11-09T22:40:00.000Z",{"_91":161,"_39":162,"_94":163,"_96":164,"_98":165,"_100":166,"_102":-5,"_106":109,"_108":109,"_167":30},{"_91":138,"_39":139,"_94":140,"_96":141,"_98":142,"_100":143,"_102":144,"_104":145,"_106":107,"_108":109},{"_91":156,"_39":157,"_94":158,"_96":97,"_98":159,"_100":160,"_102":103,"_104":105,"_106":107,"_108":109},"leadParagraph",{"_224":225,"_226":-5,"_227":109},"changelogVersion","2026-10-08T08:00","release","staticSite"]
