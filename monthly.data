[{"_1":2,"_3":4},"root",{"_5":175},"monthly-latest",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16},"kind","monthly","report",{"_7":8,"_18":19,"_20":21,"_22":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":-5},"index",[17],"today","2026-11-23","expiresAt",1795443789000,{"_18":19,"_20":21,"_22":23},"key","2026-10","issueNumber",1,"title","国家药监局批准拜耳阿舒克森片上市，用于降低缺血性卒中及高风险TIA患者卒中风险","MedHOT 月报 · 2026-10","generatedAt","2026-11-02T09:52:11.918Z","lead",{"_22":23,"_174":32},"leadItemId","w93qhyfbqki9yidnocdw3ty4m","overview","本月拜耳阿舒克森片经优先审评获批上市，用于降低缺血性卒中及高风险短暂性脑缺血发作患者的卒中风险，巴托利单抗注射液等多款创新药也同期获批。研发端，三生制药在2026年欧洲肿瘤内科学会年会上公布SSGJ-707一线治疗晚期非小细胞肺癌的长期随访数据，中位无进展生存期达13.6至13.8个月。企业层面，A股药企三季报利润前十出炉，药明康德居首，上海医药、华东医药前三季度业绩保持增长。监管方面，广东联盟带量联动采购征求意见，江苏公布第九批药品价格预警，基层服务能力新标准同步施行。","highlights",[171,172,173],"sections",[52,53,54,55,56],"flashes",[],"cover","metrics",{"_46":47,"_48":49,"_50":51},"readingMinutes",6,"prev","next","totalStories",13,"selectedCount",12,"reportsCovered",4,{"_57":157,"_59":-5,"_60":158},{"_57":146,"_59":-5,"_60":147},{"_57":113,"_59":114,"_60":115},{"_57":80,"_59":-5,"_60":81},{"_57":58,"_59":-5,"_60":61},"label","论文研究","summary","items",[62],{"_63":64,"_22":65,"_59":66,"_67":68,"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":78},"itemId","nev77hncq8jrgndw2l8dqmxnk","中国流感监测周报第932期：第43周报告145起流感样病例暴发疫情","截至2026年10月25日的一周，南方省份流感病毒检测阳性率略有下降、北方省份略有上升，全国共报告145起流感样病例暴发疫情。全国检出阳性样本中甲型占67.6%、乙型占32.4%，甲型中A(H3N2)占67.2%、A(H1N1)pdm09占32.8%，乙型均为B（Victoria）系。","sourceName","中国疾控·流感监测周报","sourceUrl","https://www.chinacdc.cn/jksj/jksj04_14249/202610/t20261028_1842545.html","publishedAt","2026-10-28T00:00:00.000Z","sourceIconUrl","/api/img-proxy?u=https%3A%2F%2Fwww.chinacdc.cn%2Fimages%2Flogo_ico.png&mode=avatar&exp=1795651200&sig=dce7a2aec60f8270","sourceIconSrcSet","/api/img-proxy?u=https%3A%2F%2Fwww.chinacdc.cn%2Fimages%2Flogo_ico.png&mode=avatar-48&exp=1795651200&sig=7775fef985ba8279 48w, /api/img-proxy?u=https%3A%2F%2Fwww.chinacdc.cn%2Fimages%2Flogo_ico.png&mode=avatar&exp=1795651200&sig=dce7a2aec60f8270 96w","firstParty",true,"available","政策与监管",[82,83,84,85],{"_63":105,"_22":106,"_59":107,"_67":108,"_69":109,"_71":110,"_73":111,"_75":112,"_77":78,"_79":78},{"_63":99,"_22":100,"_59":101,"_67":102,"_69":103,"_71":104,"_73":74,"_75":76,"_77":78,"_79":78},{"_63":95,"_22":96,"_59":97,"_67":89,"_69":98,"_71":91,"_73":92,"_75":93,"_77":94,"_79":78},{"_63":86,"_22":87,"_59":88,"_67":89,"_69":90,"_71":91,"_73":92,"_75":93,"_77":94,"_79":78},"rtcxnkifv1aqysm0xzlg7hdgz","乡镇卫生院和社区卫生服务中心服务能力标准（2026版）印发，基药优先与4—12周长处方列入B档","国家卫生健康委、国家中医药局、国家疾控局于9月29日联合印发《乡镇卫生院和社区卫生服务中心服务能力标准（2026版）》，10月20日在委网站公开并自印发之日起施行，2022版两项标准同步废止。","赛柏蓝","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653668642&idx=6&sn=1a6503d2b2a8c023d734a04cdc949dd5&chksm=bc8f4e9f607ed75351b5a7c36d914feb5df53664e201194c169f7de071e995e6eb97a7625f85&scene=126&sessionid=1793282443#rd","2026-10-29T11:17:10.000Z","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=167030ae1e219003","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=b828ff70e947816f 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=167030ae1e219003 96w",false,"vno4axtk2e81576w7vujzke4b","江苏公布第九批药品价格预警，安宫牛黄丸、六味地黄胶囊、风油精等41条记录被点名","江苏省医保局10月28日发布2026年第九批药品预警情况，涉及41条药品价格预警记录，其中黄色预警26个、红一星13个、红二星2个，无红三星；化药23个、中成药18个，中成药包括安宫牛黄丸、六味地黄胶囊、风油精等品种。","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653668642&idx=1&sn=951e1d19765e1dbe79a96d90a244900a&chksm=bc07c6c59d5d593624510dca1d0a676aedeecdd910de30a2f0d20513a4e794ef2a5fbcbe05b3&scene=126&sessionid=1793282443#rd","j5c7vw39t5336c5kyg2ekhqa5","全国急性呼吸道传染病哨点监测：第43周流感病毒阳性率14.7%，南方高于北方","2026年第43周（10月19日—10月25日），全国216家多病原监测哨点医院门急诊流感样病例呼吸道样本阳性率前三位为流感病毒（14.7%）、鼻病毒（11.7%）、副流感病毒（4.3%），住院严重急性呼吸道感染病例为鼻病毒（11.0%）、流感病毒（4.9%）、人偏肺病毒（4.4%）。","中国疾控·急性呼吸道传染病哨点监测","https://www.chinacdc.cn/jksj/jksj04_14275/202610/t20261029_1842566.html","2026-10-29T00:00:00.000Z","fozm3jmfsj12wgfkgrp13sr3h","广东省药品交易中心就广东联盟阿替洛尔等药品带量联动采购文件征求意见","广东省药品交易中心就《广东联盟阿替洛尔等药品带量联动采购文件（征求意见稿）》公开征求意见，反馈时间为2026年10月30日至11月5日17:00，需提交加盖单位鲜章的征求意见表扫描件及对应excel文档至yaopinbu@gdmede.com.cn，逾期不予受理。文件依据粤医保规〔2025〕4号起草，具体采购品种与规则见附件1。","广东省药品交易中心·通知公告","https://www.gdmede.com.cn/announcement/announcement/detail?id=2116083198168403968","2026-10-29T16:00:00.000Z","/api/img-proxy?u=https%3A%2F%2Fwww.gdmede.com.cn%2Ffavicon.ico&mode=avatar&exp=1795651200&sig=7b6790186a8c4652","/api/img-proxy?u=https%3A%2F%2Fwww.gdmede.com.cn%2Ffavicon.ico&mode=avatar-48&exp=1795651200&sig=e585872dca2ffb01 48w, /api/img-proxy?u=https%3A%2F%2Fwww.gdmede.com.cn%2Ffavicon.ico&mode=avatar&exp=1795651200&sig=7b6790186a8c4652 96w","行业动态","药企三季报密集披露，达仁堂与华润医药商业就两个独家基药品种达成全国总经销合作，翰森制药两款适应症已申报上市。",[116,117,118,119,120],{"_63":141,"_22":142,"_59":143,"_67":89,"_69":144,"_71":145,"_73":92,"_75":93,"_77":94,"_79":78},{"_63":135,"_22":136,"_59":137,"_67":138,"_69":139,"_71":140,"_73":-5,"_77":94,"_79":78},{"_63":131,"_22":132,"_59":133,"_67":124,"_69":134,"_71":126,"_73":-5,"_77":94,"_79":78},{"_63":127,"_22":128,"_59":129,"_67":124,"_69":130,"_71":104,"_73":-5,"_77":94,"_79":78},{"_63":121,"_22":122,"_59":123,"_67":124,"_69":125,"_71":126,"_73":-5,"_77":94,"_79":78},"jmz88r1urpgnnp9pwu29er5lg","华东医药前三季营收超330亿元，6款新药报产在审、9款进入III期临床","华东医药2026年前三季营业收入超过330亿元、净利润27.72亿元，业绩双增长；2026年至今获批1个生物药3.3类新药和5个仿制药新品，另有6款新药报产在审、9款新药进入III期临床。","米内网·企业","https://www.menet.com.cn/info/202610/20261030090827827_151361.shtml","2026-10-30T00:00:00.000Z","dktlqthkqbzlwwwji4eyb5u6u","翰森制药B7-H3 ADC瑞康立伏妥塔单抗小细胞肺癌与骨肉瘤III期数据公布，两项适应症已申报上市","翰森制药的注射用瑞康立伏妥塔单抗（HS-20093）是一款靶向B7-H3的ADC，9月2日及24日分别申报小细胞肺癌（CXSS2600134）和骨肉瘤（CXSS2600155）适应症上市，两项均已纳入优先审评。","https://www.menet.com.cn/info/202610/202610291616331633_151360.shtml","pfgtuq778gtb73e28xtcos8xf","上海医药2026年前三季度营收2229.64亿元，扣非净利润增长25.02%","上海医药公布2026年前三季度业绩，实现营业收入2229.64亿元，同比增长3.67%，扣非归母净利润33.74亿元，同比增长25.02%。工业板块收入189.89亿元、同比增长4.54%，商业板块收入2039.75亿元、同比增长3.59%，占总营收比重超过90%。报告期内研发费用15.16亿元，占医药工业收入比重7.98%，新药管线共60项，1类新药苹果酸司妥吉仑片已获批上市并在多个省份挂网。","https://www.menet.com.cn/info/202610/202610301622512251_151366.shtml","g1s3977ahzzeian4s8a0htld9","达仁堂与华润医药商业签约，金芪降糖片、癃清片交由华润全国总经销","津药达仁堂集团与华润医药商业集团签署战略合作协议，就金芪降糖片、癃清片两个独家基药品种的全国总经销、渠道运营与终端推广展开合作，并启动“金癃腾飞”项目。两个品种均来自达仁堂旗下隆顺榕制药厂，属国家基本药物目录独家品种并纳入国家医保目录。华润医药商业覆盖31个省市、客户超13万家，配套208个物流中心，合作重点放在县域及基层终端下沉，并协同共建学术推广体系与价格体系维护。","手动推送","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653668223&idx=3&sn=5d69ab1b5c5b478860114ede8796261e&chksm=bcc8b1c288e60a2822cb117a44f039c6b3d36d50b42ad1ee2f348a297e2aab2112ddc3fad1a2&scene=126&sessionid=1793107872#rd","2026-10-26T11:34:42.000Z","anektez7k0w9xlvgkd5gjp5lj","A股药企三季报利润前十出炉，药明康德、恒瑞医药、复星医药在列","同花顺问财数据显示，2026年前三季度归母净利润排名前十的A股医药企业为药明康德、恒瑞医药、新和成、复星医药、艾力斯、华润三九、九州通、国药股份、新产业和海思科，药明康德以193.98亿元居首，前十门槛为13.76亿元。","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653668532&idx=2&sn=b922f2812a801a39543ec4a41b9d48c2&chksm=bcf55fa8e81a585f7e0957b1317b7f580e325b244f6f2cada1e579297fd03586a044be0d4021&scene=126&sessionid=1793202325#rd","2026-10-28T12:15:55.000Z","临床与研发",[148],{"_63":149,"_22":150,"_59":151,"_67":152,"_69":153,"_71":154,"_73":155,"_75":156,"_77":94,"_79":78},"v9ozxwjqxkag3r8unjbgdkjqc","三生制药PD-1/VEGF双抗SSGJ-707 ESMO读出数据：一线NSCLC中位PFS达13.6/13.8个月","三生制药在2026 ESMO年会上公布SSGJ-707（tivunatamig/PF-08634404）联合化疗一线治疗晚期NSCLC的中国II期长期随访数据，10mg/kg Q3W剂量下鳞癌cORR 80.7%、非鳞癌77.5%，中位PFS分别为13.6个月和13.8个月。","医药魔方","https://mp.weixin.qq.com/s?__biz=Mzg2OTY4MTEzMA==&mid=2247654909&idx=3&sn=505644fcb0c1f814116d49c98b7d3321&chksm=cf4d82d3f786315482e92a7cc68119adb639845f047f40a5618c59d52dfd5410c79e89c9baf4&scene=126&sessionid=1793202325#rd","2026-10-28T09:49:29.000Z","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F1SqxY3bYAGLsl4VY5bjwbIMXvXvdj9V0x1uRD9g9FrUznFicCVlRA8MOYJHKjEiaWlqLqsV7V68FWkueoWf45yVA%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=abee4bf1a3e99cca","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F1SqxY3bYAGLsl4VY5bjwbIMXvXvdj9V0x1uRD9g9FrUznFicCVlRA8MOYJHKjEiaWlqLqsV7V68FWkueoWf45yVA%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=33bf17d592ab34bc 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F1SqxY3bYAGLsl4VY5bjwbIMXvXvdj9V0x1uRD9g9FrUznFicCVlRA8MOYJHKjEiaWlqLqsV7V68FWkueoWf45yVA%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=abee4bf1a3e99cca 96w","获批与准入",[159,160],{"_63":30,"_22":23,"_59":168,"_67":164,"_69":169,"_71":170,"_73":166,"_75":167,"_77":78,"_79":78},{"_63":161,"_22":162,"_59":163,"_67":164,"_69":165,"_71":72,"_73":166,"_75":167,"_77":78,"_79":78},"vuc4hka58mwy0jh9bwuzpcuai","NMPA 批准阿舒克森片、巴托利单抗注射液等多款创新药上市","国家药监局批准阿舒克森片、巴托利单抗注射液、紫花温肺止嗽颗粒、盐酸艾泊度胺胶囊的注册申请。拜耳的1类创新药阿舒克森片经优先审评审批程序获批，用于降低缺血性卒中或高风险短暂性脑缺血发作成人患者的卒中风险，不包括心源性栓塞型卒中患者；巴托利单抗注射液与常规治疗药物联合用于抗乙酰胆碱受体抗体阳性的成人全身型重症肌无力。","中国食品药品网·要闻","https://www.cnpharm.com/c/2026-10-28/1109526.shtml","/api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar&exp=1795651200&sig=c24b59b2539d0fa2","/api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar-48&exp=1795651200&sig=a6033af3171219fe 48w, /api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar&exp=1795651200&sig=c24b59b2539d0fa2 96w","国家药监局通过优先审评审批程序批准Bayer AG申报的1类创新药阿舒克森片（商品名舒华博）上市，用于降低缺血性卒中或高风险短暂性脑缺血发作（TIA）成人患者的卒中风险，不包括心源性栓塞型卒中患者。该药为患者提供了新的治疗选择。","https://www.cnpharm.com/c/2026-10-26/1109445.shtml","2026-10-26T00:00:00.000Z",{"_63":141,"_22":142,"_59":143,"_67":89,"_69":144,"_71":145,"_73":92,"_75":93,"_77":94,"_79":78},{"_63":105,"_22":106,"_59":107,"_67":108,"_69":109,"_71":110,"_73":111,"_75":112,"_77":78,"_79":78},{"_63":99,"_22":100,"_59":101,"_67":102,"_69":103,"_71":104,"_73":74,"_75":76,"_77":78,"_79":78},"leadParagraph",{"_176":177,"_178":-5,"_179":78},"changelogVersion","2026-10-08T08:00","release","staticSite"]
