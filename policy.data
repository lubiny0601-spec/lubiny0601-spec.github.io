_85":86,"_87":-5},{"_64":176,"_66":177,"_68":178,"_70":179,"_71":180,"_73":172,"_75":181,"_77":78,"_79":182,"_81":154,"_83":155,"_85":86,"_87":-5},{"_64":168,"_66":169,"_68":170,"_70":-5,"_71":171,"_73":172,"_75":173,"_77":78,"_79":174,"_81":122,"_83":84,"_85":86,"_87":-5},{"_64":158,"_66":159,"_68":160,"_70":-5,"_71":161,"_73":162,"_75":163,"_77":78,"_79":164,"_81":154,"_83":84,"_85":86,"_87":-5},{"_64":147,"_66":148,"_68":149,"_70":150,"_71":151,"_73":142,"_75":152,"_77":78,"_79":153,"_81":154,"_83":155,"_85":86,"_87":-5},{"_64":138,"_66":139,"_68":140,"_70":-5,"_71":141,"_73":142,"_75":143,"_77":78,"_79":144,"_81":145,"_83":84,"_85":86,"_87":-5},{"_64":131,"_66":132,"_68":133,"_70":-5,"_71":134,"_73":74,"_75":135,"_77":78,"_79":136,"_81":137,"_83":84,"_85":86,"_87":-5},{"_64":124,"_66":125,"_68":126,"_70":-5,"_71":127,"_73":74,"_75":128,"_77":78,"_79":129,"_81":82,"_83":84,"_85":86,"_87":-5},{"_64":115,"_66":116,"_68":117,"_70":-5,"_71":118,"_73":119,"_75":120,"_77":78,"_79":121,"_81":122,"_83":84,"_85":86,"_87":-5},{"_64":105,"_66":106,"_68":107,"_70":-5,"_71":108,"_73":74,"_75":109,"_77":78,"_79":110,"_81":111,"_83":84,"_85":86,"_87":-5},{"_64":98,"_66":99,"_68":100,"_70":-5,"_71":101,"_73":74,"_75":102,"_77":78,"_79":103,"_81":104,"_83":84,"_85":86,"_87":-5},{"_64":92,"_66":93,"_68":94,"_70":-5,"_71":95,"_73":74,"_75":96,"_77":78,"_79":97,"_81":82,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","k05kocvv931j76f4pijh3aitt","title","山东大学齐鲁医院医保码实现全院一码通用，结算提速至秒级","summary","山东大学齐鲁医院打通医院管理、医保、银行交易等系统，推动医保码覆盖挂号、就诊、结算全流程，实现\"一码通用\"。医院将门诊慢特病病种知识库和3万余条医保支付范围规则嵌入系统，结算时自动完成合规校验，单次结算时间从数分钟压缩到秒级，住院患者床旁结算率超过90%。","reason","source",{"_91":90},"publishedAt","2026-10-28T00:00:00.000Z","timelineAt","2026-10-28T15:38:58.451Z","category","policy","tags",[88,89,90],"score",12,"selected",false,"channel","news","x","政策/监管","医保/集采","国家医保局","name","h04h3qm6u6u66yx6qvmg57sas","湖南省医保局公示部分医疗机构美容整形类医疗服务项目市场调节价备案","湖南省医保局对接国家医保局美容整形类医疗服务价格项目立项指南，统一规范美容整形项目并公示长沙市部、省属医疗机构备案价格及执业许可证载明的医疗美容整形诊疗科目。美容整形医疗服务不属于基本医疗服务，实行市场调节价管理，不纳入医保支付范围，由具备相应资质的医疗机构自主合理定价并按规定备案、向社会公开。",{"_91":90},"2026-10-28T15:38:58.463Z",[88,90],"aeoz8wsx5zeyf04gqana79krf","烟台市医保局用激光雷达与北斗+GPS电子工牌赋能长护险监管","烟台市医保局将激光雷达、北斗+GPS双模电子工牌等技术融入长护险失能等级评估与护理服务经办全流程，以严控基金运行风险。全市定点长护服务机构169家，已累计为1.98万名参保失能人员提供专业化护理保障；激光雷达对存疑评估对象实施3至7天无接触式三维数据采集，电子工牌定位精度≤10米，参保人双重人脸识别核验成功率稳定在84%以上。",{"_91":90},"2026-10-28T15:38:58.474Z",[88,89,90],10,"tcxzr0xgi0p9yll125vk0g6n1","雷平会见俄罗斯联邦卫生监督局副局长德米特里·帕夫柳科夫一行","国家药监局副局长雷平10月23日在京会见俄罗斯联邦卫生监督局副局长德米特里·帕夫柳科夫一行。雷平介绍了中国医疗器械审评审批制度改革、法规标准体系建设、全生命周期监管和产业创新发展情况，帕夫柳科夫介绍了俄方医疗器械监管工作，双方同意在医疗器械注册管理及上市后监测等领域加强交流，共同提升监管能力、保障两国公众用械安全。",{"_91":114},"2026-10-28T15:39:01.273Z",[88,112,113],8,"医疗器械/IVD","NMPA","中国食品药品网·要闻","o8dl8zlipsuvpx6ul3vi7lozb","CDE就放射性体内诊断与治疗药物非临床研究技术指导原则问答文件公开征求意见","CDE于10月26日就《〈放射性体内诊断药物非临床研究技术指导原则〉问答文件（征求意见稿）》和《〈放射性治疗药物非临床研究技术指导原则〉问答文件（征求意见稿）》公开征求意见，反馈时限为发布之日起1个月。两份问答文件基于2021年发布的放射性体内诊断药物指导原则和2024年发布的放射性治疗药物指导原则修订形成，旨在规范和指导放射性诊断、治疗药物的非临床研究研发与评价。",{"_91":114},"2026-10-27T00:00:00.000Z","2026-10-28T15:39:01.304Z",[88,123,113],22,"放射性药物","nhm2b9mj95vkjmrlt8esglem6","上海提示冠脉支架国家集采第二轮接续结果执行前未中选产品挂网价申报","上海拟于2026年11月中下旬执行国家组织冠脉支架集采第二轮接续结果，未中选产品企业须在2026年11月10日前向市药事所递交加盖公章的挂网价申报纸质材料。申报材料包括法人授权书、挂网价申报函、最低省级平台挂网价截图及价格承诺书等；无外省市价格者需填报成本价并递交无外省市价格承诺书。",{"_91":130},"2026-10-28T15:39:02.573Z",[88,89,112],"上海阳光医药采购网","iapqxo3fixblxjheu5zvt1zvq","上海阳光医药采购网公示2026年8月部分短缺药全国平均价","上海市医药集中招标采购事务管理所公示2026年8月部分短缺药全国平均价，要求各医疗机构根据市场供需情况，在保供稳价基础上采购质量可靠、价格适宜的药品。此次公示依据国家医保局相关文件及国办发〔2019〕47号文精神开展。",{"_91":130},"2026-10-28T15:39:02.579Z",[88,89,90],42,"dqjmmubgltz8u3946vu1mtvs9","国家药监局公布暖宫七味散等9个品种转换为非处方药","国家药监局10月29日公告，暖宫七味散、红花逍遥片、痔特佳胶囊、唇齿清胃丸、儿童咳颗粒、人知降糖胶囊、红药胶囊、调经活血胶囊和排毒养颜片9个品种由处方药转换为非处方药，品种名单及非处方药说明书范本一并发布。相关药品上市许可持有人须于2027年7月26日前就修订说明书事项向省级药品监督管理部门备案，并通知相关医疗机构、药品经营企业等单位。",{"_91":114},"2026-10-29T00:00:00.000Z","2026-10-29T13:59:53.521Z",[88,113,146],36,"中药","j5c7vw39t5336c5kyg2ekhqa5","全国急性呼吸道传染病哨点监测：第43周流感病毒阳性率14.7%，南方高于北方","2026年第43周（10月19日—10月25日），全国216家多病原监测哨点医院门急诊流感样病例呼吸道样本阳性率前三位为流感病毒（14.7%）、鼻病毒（11.7%）、副流感病毒（4.3%），住院严重急性呼吸道感染病例为鼻病毒（11.0%）、流感病毒（4.9%）、人偏肺病毒（4.4%）。","第43周哨点监测给出流感、鼻病毒等病原体的南北差异与年龄分布，可作为呼吸道用药需求的先行参考。",{"_91":157},"2026-10-29T14:00:45.454Z",[88,156],58,true,"感染/疫苗","中国疾控·急性呼吸道传染病哨点监测","ef6oj9ycv3d5vstx5kuip23ji","天津医药采购中心发布挂网药品价格联动调整通知","天津医药采购中心发布关于开展挂网药品价格联动调整工作的通知，材料未提供正文，具体调整范围、规则与执行时间暂无法确认。",{"_91":167},"2026-10-30T10:45:24.000Z","2026-10-30T11:06:55.309Z",[88,89,165,166],"抗感染","市场准入","天津医药采购中心·通知公告","to3uxil4o13fcnvp9x10fk7jf","广东省第三方药品电子交易平台同步20261023批次新增挂网药品数据","广东省第三方药品电子交易平台已将20261023批次审核通过且公示无异议的新增挂网药品数据同步至广东招采子系统。相关企业需使用CA登录子系统维护配送关系，挂网药品配送须覆盖全省所有参加药品采购的各类医疗机构，配送关系符合要求后医疗机构方可发起合同交易。",{"_91":175},"2026-10-29T16:00:00.000Z","2026-10-30T11:06:56.297Z",[88,89],"广东省药品交易中心·通知公告","fozm3jmfsj12wgfkgrp13sr3h","广东省药品交易中心就广东联盟阿替洛尔等药品带量联动采购文件征求意见","广东省药品交易中心就《广东联盟阿替洛尔等药品带量联动采购文件（征求意见稿）》公开征求意见，反馈时间为2026年10月30日至11月5日17:00，需提交加盖单位鲜章的征求意见表扫描件及对应excel文档至yaopinbu@gdmede.com.cn，逾期不予受理。文件依据粤医保规〔2025〕4号起草，具体采购品种与规则见附件1。","广东联盟新一轮带量联动采购进入征求意见阶段，涉及品种与报量规则尚待文件附件披露。",{"_91":175},"2026-10-30T11:06:56.307Z",[88,89],"ejkj2ytnzk28k7wuw9bedyp4r","第十一届中国药物警戒大会在苏州召开，国家药监局副局长雷平出席并致辞","10月29日，第十一届中国药物警戒大会在苏州召开，国家药监局党组成员、副局长雷平出席并致辞，指出药械警戒制度体系不断完善、监测评价能力显著增强、风险信号处置有力有效。两院院士围绕监管科学助力生物药创新发展、纳米技术医药产品创新与监管、微创器械创新发展作大会报告，药品监管司、器械监管司有关领导作药品医疗器械监管改革政策解读。",{"_91":114},"2026-10-30T00:00:00.000Z","2026-10-30T14:58:45.910Z",[88,113],"ygr4derpku2fmmfy4v9rf80ab","国家药监局副局长杨胜赴广东调研大湾区药物创新研发与监管工作","国家药监局党组成员、副局长杨胜带队赴广东调研部分药物研发企业及药品、医疗器械大湾区分中心，并召开座谈会了解大湾区医药产业创新成果转化和药品监管工作情况。杨胜强调要主动服务国家发展战略，聚焦重点品种、完善服务方式方法，并加强人才培养、落实\"三统一\"工作目标。广东省药监局和深圳市市场监管局有关负责同志参加调研和座谈。",{"_91":114},"2026-10-30T14:58:45.921Z",[88,113],"yb846z2kwn87iw0ecw07mapfv","CDE公开征求《新生抗原药品关键问题的技术考虑（征求意见稿）》意见","CDE于10月30日就《新生抗原药品关键问题的技术考虑（征求意见稿）》公开征求意见，旨在规范和指导新生抗原（Neoantigens）药品的研发和注册申报。征求意见时限为自发布之日起1个月，反馈意见可发送至指定邮箱。",{"_91":114},"2026-10-30T14:58:45.973Z",[88,203,113],30,"肿瘤","j03o3a5abs0u99vq308ui3clk","国家药监局传达学习贯彻党的二十届五中全会精神","10月30日，国家药监局党组书记、局长黄果主持召开党组扩大会议，专题传达学习党的二十届五中全会精神并研究部署贯彻落实措施。会议强调把持之以恒推进全面从严治党要求落实到药品监管全过程各方面，扎实做好中央巡视整改，坚决守住药品安全底线。会议要求开展多形式、多层次的宣讲培训，推动全会精神落地落实。",{"_91":114},"2026-10-31T00:00:00.000Z",[88,113],"x0ms3xz7u4zby3uogkrvh65wo","第九届中国药品监管科学大会在京召开，国家药监局副局长王维东出席并讲话","10月31日，中国药品监督管理研究会主办的第九届中国药品监管科学大会在京开幕，国家药监局党组成员、副局长王维东出席并讲话。大会以\"高水平安全、高质量发展——监管科学助力培育壮大生物医药新兴支柱产业\"为主题，设报告环节和14个分论坛，药品监管部门和学界业界1800余名代表参会。",{"_91":114},[88,113],"f7kytu1qb94yiriu3ljf73o8h","国家药监局公开征求《国家药品安全事件应急预案（征求意见稿）》意见","国家药监局组织起草《国家药品安全事件应急预案（征求意见稿）》，于11月2日起向社会公开征求意见，反馈截止2026年11月9日。该预案依据《药品管理法》及《国家突发事件总体应急预案》制定，旨在健全药品安全应急管理体系、提升药品安全事件应急处置能力，意见反馈表需发送至指定邮箱。",{"_91":114},"2026-11-02T00:00:00.000Z","2026-11-02T09:52:08.174Z",[88,113],"fyrp9lgkpsv08y6r6wa440113","CDE将ICP-B794纳入“关爱计划-延伸”试点项目，拟开发肺外神经内分泌癌","CDE将诺诚健华申报的ICP-B794纳入“关爱计划-延伸”试点项目，拟开发适应症为肺外神经内分泌癌。该试点依据《罕见疾病创新药物研发鼓励试点计划（“关爱计划-延伸”）申报指南》开展。",{"_91":114},"2026-11-02T09:52:08.183Z",[88,228,203,113],"罕见病","p1c8zabjdtgwl0pdb5lum81yx","新疆推行DRG/DIP半年清算机制，14个统筹地区完成2758家医疗机构清算","新疆医保局统筹部署全区DRG/DIP半年清算，截至目前14个统筹地区均已完成对2758家医疗机构的半年清算，累计支付166.23亿元。2026年1-6月全区8065.25万人次享受医保待遇，医保基金支出243.86亿元。半年累计评审病例4.4万余例，医保基金支付7.66亿元，并构建\"线上双盲评审+分级审核\"闭环管理体系。",{"_91":90},"2026-11-02T09:52:08.905Z",[88,89,90],"hy8y7m6g6j4zkah6j00io86yx","福建厦门优化医保结算流程：基金拨付最短1个工作日，覆盖2000多家定点医药机构","福建厦门医保部门将基金拨付时限压缩至最短1个工作日，覆盖全市2000多家定点医药机构，并连续3年较全国平均水平提前两个月完成年度清算。即时结算实现门诊、住院、生育医疗、救助与药店购药费用\"日报日审日拨\"，大病保险结算由按月拨付升级为按日拨付，预计每年快拨付大病保险费用6亿元。今年2月完成2025年度医保清算，比往年提前超60天，全年拨付医保资金超110亿元。",{"_91":90},"2026-11-02T09:52:08.922Z",[88,89,90],"wsiex74lu7bn1kq10wey3l0l5","黑龙江多措并举打通基层药品配备“最后一公里”","黑龙江省医保部门联合卫健、中医药管理等部门出台系列举措，将社区卫生服务中心常用口服药品指导目录扩充至600种，并要求常态化配备不少于300种。乡镇卫生院、村卫生室分别明确常态化配药300种以上、100种以上的刚性标准。依托全省一体化医保信息平台，已累计推送医保药品结算数据12次、4000余条，并完成650种基层常用药品的医保支付属性标注。",{"_91":90},"2026-11-02T09:52:08.939Z",[88,89,90],38,"ii3a903ivw5tzs28r66ubg04y","广东“医保钱包2.0”上线：职工医保个人账户实现跨省共济","“医保钱包2.0”于9月29日上线，广东作为首批省份实现职工医保个人账户从省内共济扩展至跨省共济。职工参保人可通过国家医保服务平台APP与省外参保近亲属绑定共济关系、设定共济额度，用于支付其就医购药个人负担费用或参保缴费，绑定次数和金额不限，剩余额度可返还个人账户。",{"_91":90},"2026-11-02T09:52:08.963Z",[88,89,90],"za6skha9ca5etc3jbhej7dumk","国家医保局公布2026年全民参保宣传短视频大赛结果名单","国家医疗保障局公布2026年全民参保宣传短视频大赛结果名单，共收到930件作品，120部入围，最终评出一等奖10名、二等奖20名、三等奖30名和优秀奖60名。大赛于2026年6月至8月举办，旨在巩固全民参保成果、普及医保知识。",{"_91":90},"2026-11-01T00:00:00.000Z","2026-11-02T09:52:08.993Z",[88,89,90],"ltograrjcp1npcemuhxbkrgxv","浙江杭州实施医保定点医药机构资源配置规划（2025—2027年），定点管理提质赋能","浙江省杭州市医保部门编制实施《杭州市医疗保障定点医药机构资源配置规划（2025—2027年）》，遏制机构无序扩张。2026年上半年全市272家医药机构申请医保定点，同比下降55.70%，185家通过定点准入评估，同比下降24.49%；截至2026年8月底，定点医药机构总数为9129家，较2024年底仅增长0.30%。",{"_91":90},"2026-11-03T00:00:00.000Z",[88,89,90],"emr76r0kqmzedhg1d2fq4nfo4","江苏医保局部署第十二批国家集采中选结果落地，11月30日起全省执行","江苏省医保局发文部署第十二批国家集采中选结果落地，全省公立医疗机构自2026年11月30日24:00起统一执行，采购周期至2029年12月31日。中选药品按中选价挂网，曲马多注射剂、艾司唑仑口服常释剂型、吡仑帕奈口服常释剂型3个品种完成约定采购量后不再考核用量；伐昔洛韦口服常释剂型等8个品种对接执行本批中选结果，原集采结果同步停止执行。","文件明确了第十二批国采在江苏的执行时间、采购周期与考核口径，涉及抗菌药物品种的落地安排。",{"_91":275},"2026-11-03T15:24:58.419Z",[88,89,90,165,166],75,"江苏医保局·阳光采购服务网","al1ui9exasqe5g5xocpkgl5om","广东联盟药品集采公示第十批新增中选产品，公示至11月4日","广东省药品交易中心公示广东联盟药品集中带量采购新增中选产品信息（十），南京力成药业等企业申请增补中选资格，公示期至2026年11月4日17:30。依据《广东联盟双氯芬酸等药品接续采购文件（GDYJYPDL202501）》，报名截止后首次获批的同品种同剂型产品，接受本企业最低价格/最低日均费用与中选产品最低单位可比价两者低值的，可按中选产品挂网，当年度协议采购量默认为0。","公示规则明确了接续集采品种范围内新获批产品按中选价挂网的准入路径，涉及企业可据此判断增补资格。",{"_91":175},"2026-11-01T16:00:00.000Z","2026-11-03T15:25:05.461Z",[88,89,165,166],50,"i02u4hpugvk7m0bazm8ocvs8v","北京医保局发文执行第十二批国家集采中选结果，11月28日起全面落地","北京市医保局通知执行第十二批国家组织药品集采中选结果，2026年11月21日0时招采子系统统一调整中选药品采购价格，11月28日0时起全面执行中选结果及医保支付标准，采购周期至2029年12月31日。通知明确因抗菌药物使用限制等导致临床需求重大变化的，考核以使用比例代替使用数量；医疗机构反映中选药品供应问题并经核实公示后，采购其他中选企业药品可视作采购该中选药品并享受医保资金结余留用政策。","北京落地第十二批国家集采的执行细则，明确了价格调整、医保支付标准与考核口径的变化。",{"_91":293},"2026-11-03T15:25:05.573Z",[88,89,90,165,166],85,"北京医保局·药品通知公告","lpxm9cdo96ui03tg5b2tpvkf0","FDA 发布细胞与基因治疗产品效力保证最终指南，取代 2011 版效力检测指南","FDA 发布《细胞与基因治疗产品效力保证》最终指南，取代 2011 版 CGT 效力检测指南，要求制造商在从早期 IND 申报、BLA 获批到上市后验证的全生命周期内建立基于科学与风险的效力保证策略。",{"_91":304},"2026-11-02T13:56:06.000Z","2026-11-03T15:25:07.155Z",[88,302,303],20,"细胞与基因治疗","FDA","FDA 新闻稿","temy5l1kph470ozaf6zo5h5pq","CDE将注射用埃普奈明纳入\"关爱计划-延伸\"试点项目","CDE将武汉海特生物制药的注射用埃普奈明纳入\"关爱计划-延伸\"试点项目，拟开发适应症为不可切除或转移的经典型软骨肉瘤。该通知于11月3日发布，依据《罕见疾病创新药物研发鼓励试点计划（\"关爱计划-延伸\"）申报指南》执行。",{"_91":114},"2026-11-03T15:25:10.221Z",[88,228,113],"d1thwqtntb4m49n7mctrna5kr","CDE公示将SR604注射液纳入\"关爱计划-延伸\"试点项目","CDE于11月3日公示拟将上海莱士血液制品股份有限公司的SR604注射液纳入\"关爱计划-延伸\"试点项目，公示期至2026年11月10日。该品种拟开发适应症为\"血小板无力症\"和\"血管性血友病的预防治疗\"。",{"_91":114},"2026-11-03T15:25:10.258Z",[88,228,317,113],"血液","tlht2kqdc8umt7s546f9uq4bm","CDE将TollB-001片纳入“关爱计划-延伸”试点项目","CDE将北京拓领博泰生物科技有限公司的TollB-001片纳入“关爱计划-延伸”试点项目，拟开发适应症为系统性硬化症。该通知依据《罕见疾病创新药物研发鼓励试点计划（“关爱计划-延伸”）申报指南》发布，日期为11月3日。",{"_91":114},"2026-11-03T15:25:10.266Z",[88,228,113],"izmnpz7twand2g8n13qm5pvox","CDE公示将人源多巴胺能前体细胞注射液纳入\"关爱计划-延伸\"试点项目","CDE 11月3日公示，拟将睿健毅联医药科技（成都）有限公司的人源多巴胺能前体细胞注射液纳入\"关爱计划-延伸\"试点项目，拟开发适应症为多系统萎缩帕金森型，公示期截至2026年11月10日。该公示依据《罕见疾病创新药物研发鼓励试点计划（\"关爱计划-延伸\"）申报指南》发布，异议可发送至指定邮箱。",{"_91":114},"2026-11-03T15:25:10.273Z",[88,228,302,113,330],"神经/精神","sabf80feaoav7bocovpym3gnb","黄果会见世卫组织监管和预认证司代理司长希蒂·西洛，讨论疫苗WLA评估合作","国家药品监督管理局局长黄果11月2日在京会见世卫组织监管和预认证司代理司长希蒂·西洛及驻华代表马丁·泰勒，双方围绕世卫组织列名机构（WLA）评估、监管能力建设、人员交流等合作事项深入讨论。黄果表示中国国家药监局高度重视疫苗WLA评估工作，世卫组织愿共同推进评估，双方同意深化人员交流。会见后双方举行工作会议，就WLA评估及后续安排达成一致。",{"_91":114},"2026-11-03T15:25:10.299Z",[88,113,156],"sdnqkfro7vbvy5xei3l6x2vey","国家医保局发布第二十二批智能监管“两库”规则和知识点","国家医保局发布第二十二批智能监管“两库”规则和知识点，本次公开的是“诊断与患者性别不符”规则中“泌尿生殖系统疾病”章对应的知识点明细。各省级医保部门需据此对省级医保信息平台智能监管子系统“两库”动态更新，定点医药机构可将其嵌入智能提醒系统或对接事前提醒功能模块开展自查自纠。相关知识点明细以PDF和xlsx附件形式发布。",{"_91":90},"2026-11-04T00:00:00.000Z","2026-11-05T05:13:20.373Z",[88,89,90],"oe38y0k8hxh7ja9rqykh82srz","广东联盟取消西安利君康乐氯化钠注射液中选资格","广东省药品交易中心公告，因陕西省药监部门检查发现西安利君康乐制药有限责任公司药品生产质量管理不符合要求并已暂停其氯化钠注射液（250ml:2.25g、500ml:4.5g，直立式聚丙烯输液袋）生产、销售，依据《广东联盟双氯芬酸等药品接续采购文件（GDYJYPDL202501）》取消该产品在广东联盟双氯芬酸等药品接续采购的中选资格。","陕西药监因生产质量管理问题暂停该产品生产销售，广东联盟据此取消其中选资格，可看集采中选资格的风险处置链条。",{"_91":175},"2026-11-03T16:00:00.000Z","2026-11-05T05:13:29.209Z",[88,353,89],47,"安全/质量","myck3lcrykihphx3tmpyb2mxj","广东省药品交易中心公布广东联盟药品集中带量采购新增中选产品信息（十）","广东省药品交易中心公布广东联盟药品集中带量采购新增中选产品信息（十），依据《广东联盟双氯芬酸等药品接续采购文件（GDYJYPDL202501）》，经企业申请、审核、公示等程序确定。新增中选产品当年度协议采购量默认为0。",{"_91":175},"2026-11-04T16:00:00.000Z","2026-11-05T13:32:29.450Z",[88,89,165,166],40,"pw6ucp2922s9vr0aj4z2srgo9","国家药监局副局长雷平率队赴上海参加第九届进博会","国家药监局党组成员、副局长雷平于11月4日—6日率队参加第九届中国国际进口博览会，出席开幕式及由国家药监局和虹桥论坛秘书处主办的第九届虹桥国际经济论坛\"国际药品安全治理与中国药品监管改革\"分论坛并致辞。雷平表示，国家药监局着力统筹发展与安全、质量与效率、监管与服务，欢迎各国医药企业将全球医药创新成果第一时间引入中国，并支持中国优质药械走向世界。",{"_91":114},"2026-11-07T00:00:00.000Z",[88,113],18,"g2m75iruvropozafc1wbiyc4z","广东省第三方药品电子交易平台同步20261030批次新增挂网药品数据","广东省第三方药品电子交易平台已将20261030批次审核通过且公示无异议的新增挂网药品数据同步至广东招采子系统。相关企业需使用CA登录子系统维护配送关系，挂网药品配送须覆盖全省所有参加药品采购的各类医疗机构，配送关系符合要求后医疗机构方可发起合同交易。",{"_91":175},"2026-11-08T16:00:00.000Z","2026-11-09T06:26:04.016Z",[88,89],"vdzri95dwgtd9jhsllv6ct7kd","CDE 发布《化学药生物等效性试验备案范围和程序》修订版及共性问题解答","药审中心发布修订后的《化学药生物等效性试验备案范围和程序》及共性问题解答（2026年第51号通告），自2027年2月1日起施行。此次修订旨在明确 BE 试验备案范围、完善备案工作程序，经国家药监局审查同意后发布，两份文件以附件形式随通告公布。","CDE 修订化学药 BE 试验备案范围与程序并配套共性问题解答，仿制药研发与注册人员可据此调整备案安排。",{"_91":114},"2026-11-09T00:00:00.000Z","2026-11-09T06:26:07.610Z",[88,113],"firstParty","tag","q","tab","time",{"_390":391,"_392":-5,"_393":155},"changelogVersion","2026-10-08T08:00","release","staticSite"]
