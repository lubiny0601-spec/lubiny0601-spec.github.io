83":128,"_85":86,"_87":-5},{"_64":176,"_66":177,"_68":178,"_70":-5,"_71":179,"_73":160,"_75":160,"_77":78,"_79":180,"_81":181,"_83":84,"_85":86,"_87":-5},{"_64":170,"_66":171,"_68":172,"_70":-5,"_71":173,"_73":160,"_75":160,"_77":78,"_79":174,"_81":175,"_83":84,"_85":86,"_87":-5},{"_64":164,"_66":165,"_68":166,"_70":167,"_71":168,"_73":160,"_75":160,"_77":78,"_79":169,"_81":127,"_83":128,"_85":86,"_87":-5},{"_64":155,"_66":156,"_68":157,"_70":158,"_71":159,"_73":160,"_75":160,"_77":78,"_79":161,"_81":127,"_83":128,"_85":86,"_87":-5},{"_64":148,"_66":149,"_68":150,"_70":151,"_71":152,"_73":136,"_75":136,"_77":78,"_79":153,"_81":127,"_83":128,"_85":86,"_87":-5},{"_64":140,"_66":141,"_68":142,"_70":-5,"_71":143,"_73":136,"_75":136,"_77":78,"_79":144,"_81":145,"_83":128,"_85":86,"_87":-5},{"_64":132,"_66":133,"_68":134,"_70":-5,"_71":135,"_73":136,"_75":136,"_77":78,"_79":137,"_81":99,"_83":128,"_85":86,"_87":-5},{"_64":121,"_66":122,"_68":123,"_70":-5,"_71":124,"_73":125,"_75":125,"_77":78,"_79":126,"_81":127,"_83":128,"_85":86,"_87":-5},{"_64":111,"_66":112,"_68":113,"_70":-5,"_71":114,"_73":115,"_75":116,"_77":78,"_79":117,"_81":118,"_83":84,"_85":86,"_87":-5},{"_64":103,"_66":104,"_68":105,"_70":-5,"_71":106,"_73":74,"_75":107,"_77":78,"_79":108,"_81":99,"_83":84,"_85":86,"_87":-5},{"_64":93,"_66":94,"_68":95,"_70":-5,"_71":96,"_73":74,"_75":97,"_77":78,"_79":98,"_81":99,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","x31n2db92vy3sut3ri8fk47ql","title","华东医药公告全资子公司产品及合作产品纳入国家医保目录及商保创新药目录","summary","华东医药发布公告，称其全资子公司产品及合作产品纳入国家医保目录及商保创新药目录。公告未披露具体产品名称、适应症及纳入方式。","reason","source",{"_91":92},"publishedAt","2026-11-15T16:00:00.000Z","timelineAt","2026-11-16T00:55:12.313Z","category","policy","tags",[88,89,90],"score",75,"selected",false,"channel","news","x","政策/监管","医保/集采","华东医药","name","华东医药·公司公告","jb2iq02cqmnptb0jg7u2k5dmm","华北制药公告公司及下属子公司产品纳入国家医保目录","华北制药发布公告，说明公司及下属子公司产品纳入国家医保目录。公告未披露具体产品名称、适应症及纳入方式。",{"_91":102},"2026-11-16T00:55:13.893Z",[88,89,100,101],62,"华北制药","国家医保局","华北制药·公司公告","nd7yzwjuqsswknaef4gi5bt8d","复星医药公告控股子公司药品新纳入国家医保目录","复星医药发布提示性公告，称控股子公司药品获新纳入国家医保目录。公告未披露具体药品名称、适应症及纳入类别。",{"_91":110},"2026-11-16T00:55:13.951Z",[88,89,109],"复星医药","复星医药·公司公告","etbb7t1ta2pb6a34m8aak48hh","翰森制药创新药纳入2026国家医保目录","翰森制药发布自愿公告，披露创新药纳入2026国家医保目录的业务进展。公告未披露具体药品名称、适应症及谈判结果细节。",{"_91":120},"2026-11-15T10:25:00.000Z","2026-11-16T00:55:18.036Z",[88,89,119],36,"翰森制药","翰森制药·港交所公告","lw0qysxmn2n4zv2g5tvzq3fxi","天津医药采购中心发布挂网药品价格联动调整工作通知","天津医药采购中心发布关于开展挂网药品价格联动调整工作的通知，材料未提供正文，具体调整范围、联动规则与执行时间暂未披露。",{"_91":131},"2026-11-16T10:24:27.000Z",[88,89,129,130],58,true,"抗感染","市场准入","天津医药采购中心·通知公告","kixf6bdydcjzwjo75bddia1gw","健康元公告公司产品纳入医保目录","健康元药业集团股份有限公司发布公告，称公司产品纳入医保目录。公告未披露具体产品名称、适应症及纳入方式。",{"_91":139},"2026-11-16T16:00:00.000Z",[88,89,138],"健康元","健康元·公司公告","rsr8ifgox97qwwxa06unya506","科伦药业公告公司药品纳入国家医保目录","科伦药业发布公告称公司药品纳入国家医保目录，公告未披露具体药品名称、适应症及支付规则。",{"_91":147},[88,89,146],67,"科伦药业","科伦药业·公司公告","ve0ppj48xx02vv4x4eq007iwh","广东开展第十二批国家集采中选企业供应清单外规格包装挂网价格确认","广东省药品交易中心启动第十二批国家集采中选企业未在供应清单内规格包装产品的挂网价格确认，要求按本企业中选价格依差比价规则计算调整，确认时间为即日起至2026年11月20日17:30。企业同意调整的价格自2026年11月30日起与中选结果同步执行，拒绝确认且申诉未获采纳或逾期未操作的药品自同日起取消挂网。","广东对第十二批国家集采中选企业供应清单外规格包装启动挂网价确认，涉及差比价调整与逾期取消挂网。",{"_91":154},[88,89,129,130],"广东省药品交易中心·通知公告","jbz8if39c7s579einl40mn76n","国家疾控局等三部门发文，十五五期间逐步实现疫苗处方全覆盖","11月17日，国家疾控局、国家卫生健康委和国家中医药局联合发布《关于全面推行疫苗处方工作的指导意见》，提出“十五五”期间逐步实现疫苗处方在二级及以上医疗机构、基层医疗卫生机构的全覆盖。","三部门联合发文明确疫苗处方的实施机构、开具科室与推荐疫苗品种，读者可据此判断院内接种服务的落地路径。",{"_91":163},"2026-11-17T00:00:00.000Z",[88,162],"感染/疫苗","中国食品药品网·要闻","mt9jo5os7n40feu1p3lxb1yf3","湖南调整优化医疗服务价格，2025年调价总金额12.69亿元","湖南省医保局介绍医疗服务价格动态调整机制运行情况，2025年全省全年调价总金额12.69亿元，其中年度动态调整空间5.34亿元、价格治理腾出空间7.35亿元。机制设3项启动条件、5项约束条件，上年度医药总费用增幅高于10%或基金当期赤字等情形原则上不得上调价格。2026年10月湖南还下调560个药品、352类医用耗材的个人先行自付比例，预计每年增加基金支出保底约8亿元。","湖南披露调价总量、熔断条件与支付协同的具体做法，可供其他省份测算调价空间时参照。",{"_91":101},[88,89,101],"ppsc4ntc7supymzd4279n65pw","国家疾控局等三部门解读《关于全面推行疫苗处方工作的指导意见》","国家疾控局会同国家卫生健康委、国家中医药局联合印发《关于全面推行疫苗处方工作的指导意见》，明确\"十五五\"期间逐步实现疫苗处方在二级及以上医疗机构和基层医疗卫生机构全覆盖。文件规定由全科医疗科、预防保健科等科室具有资质的临床、公共卫生、中医类别医师开具处方，并规范识别对象、开具处方、接种服务、信息化管理等流程。",{"_91":163},[88,162],42,"pxjzphkmel1drwv3ihsnnjuv7","国家药监局党组召开2026年巡视工作会议暨第四轮巡视动员部署会","国家药监局党组11月16日召开2026年巡视工作会议暨第四轮巡视动员部署会，宣布对服务中心、国际交流中心、南方所、特药检查中心开展常规巡视。会议传达学习中央政治局审议《关于二十届中央第七轮巡视情况的综合报告》有关会议精神及全国巡视工作会议精神，局党组成员、副局长王维东出席并讲话。第四轮巡视在中央巡视整改期间同步开展，会议要求精准查摆问题、把政治监督落到实处。",{"_91":163},[88,182],8,"NMPA","uz3zgv69ybm7424idhbl8f2on","国家疾控局等三部门发文全面推行疫苗处方工作","国家疾控局、国家卫生健康委、国家中医药局联合印发《关于全面推行疫苗处方工作的指导意见》，推动各地全面、规范开展疫苗处方工作，以深化医防协同、医防融合机制。通知于11月17日在国家疾控局网站发布，文件落款日期为2026年10月30日，要求各地结合实际认真组织实施。","三部门联合发文推行疫苗处方，读者可据此判断接种服务从公共卫生向临床处方环节延伸的方向。",{"_91":163},[88,162],"v0pqx5ioi1g6n53tyodvgwy7n","药品海外注册公益培训班在苏州举办，近500家药企参加","11月10日至12日，由国家药监局高级研修学院主办、江苏省药监局苏州检查分局和苏州市药学会协办的药品海外注册公益培训班在苏州举办，近500家药品企业相关负责人参加。培训聚焦药品海外注册能力提升，内容涵盖药品出口监管要求解读、海外注册路径选择、欧美注册申报实务、项目管理及对外授权交易等。高研院表示将持续分区域、分领域、分专题组织海外注册培训。",{"_91":163},[88,182],12,"zk78bth1hygdmgtuka9hg72ai","上海执行国家组织冠脉支架集采第二轮接续中选结果，11月20日生效","上海市医药集中招标采购事务管理所通知，国家组织冠脉支架集中带量采购第二轮接续中选结果自2026年11月20日起执行，采购周期至2029年6月30日。医疗机构须按中选价采购、不得二次议价，每年度总协议采购量不低于前一年实际使用量的90%。非中选冠状动脉药物洗脱合金支架挂网价≥1708元/个纳入黄标、≥2372元/个纳入红标管理。",{"_91":201},[88,89,200],"医疗器械/IVD","上海阳光医药采购网","idobj0vusczpaxp0my53uwmx0","天津启动二十六省联盟集采与第九批国家集采残缺规格两个项目协议到期续签","天津医药采购中心发布通知，就二十六省联盟药品集中带量采购、第九批国家组织药品集中采购天津市残缺规格两个项目协议到期后的续签执行工作作出安排。通知未披露涉及品种、续签规则与执行时间等具体内容。",{"_91":131},"2026-11-17T09:18:27.000Z",[88,89,129,130],"vtteda0kxkfhqifq9c3hu6exr","FDA 启动全球依赖披露计划（GRDP），扩大全球患者药物可及性","FDA 宣布启动全球依赖披露计划（GRDP），旨在改变全球卫生监管机构利用 FDA 药品与生物制品审批决策的方式。该计划为一项里程碑式举措，目标是扩大全球患者对药物的可及性。",{"_91":216},"2026-11-17T20:32:16.000Z",[88,215],22,"FDA","FDA 新闻稿","cu01fnfdb13vrz4ynrs24k4zn","云南构建“事前提醒+事中控制”机制，筑牢医保基金安全防线","云南省医保部门针对回流药倒卖、超量开药等问题，实施“事前提醒、事中控制”模式，首批将司美格鲁肽、复方α-酮酸片等纳入控制范围。自2023年12月实施以来，系统累计分析审核处方约3.1亿张，对213.8万笔不合理超量开药费用实施事中控制转自费结算，涉及金额1.21亿元。全省定点医药机构事前提醒功能接入率超95%。",{"_91":101},"2026-11-18T00:00:00.000Z",[88,89,101,223],"GLP-1","godnlghbc1b26m9jymyelxjw2","沈阳长护险制度实施以来已为近5000名失能人员提供长期照护服务","沈阳市长期护理保险制度自2026年1月实施以来，已陆续为近5000名失能人员提供长期照护服务。铁西区89岁卧床老人王奶奶通过上门帮办提交失能等级评估申请，当月通过评估后获定制擦浴、褥疮护理及换管等服务，每周三次由长期照护师上门提供。",{"_91":101},[88,89,101],"s5xdh4curuu6un3l30quk1u7b","国家药监局在贵阳召开血液制品生产智慧监管三年行动工作总结会","国家药监局11月17日在贵阳召开血液制品生产智慧监管三年行动工作总结会，该工作自2024年起部署，目前整体完成，行业信息化基础得到夯实、智慧监管水平实现提升。会议强调持续巩固建设成果、压紧压实企业主体责任，切实保障血液制品质量安全。副局长杨胜还赴血液制品生产企业和贵州省药检所调研生产监管和批签发情况。",{"_91":163},[88,182,234],"血液","tvlcn788i988roqc45luqe7fm","福建省医保局举办“敬老月里话长护 医保服务暖银龄”长护险政策宣传活动","10月21日，福建省医保局、福州市医保局在福州鼓楼区举办长期护理保险政策专场宣传活动，设政策宣讲、现场答疑、健康义诊、互动问答、科普展板五大功能区。福州自2021年起开展全国第二批长护险试点，今年6月福建省印发实施方案，明确2028年基本建立覆盖全省的长护险制度，2026年底前省本级、厦门、泉州、三明陆续启动，福州将覆盖范围从职工扩大到城乡居民。",{"_91":101},[88,89,101],"wfe5ja720kd2b85nxxii4aeg0","国家医保局启动2026年第三批参照药预沟通专家论证，11月30日截止收件","国家医保局医药价格和招标采购指导中心组织开展2026年第三批参照药预沟通专家论证工作，符合条件的企业需按《参照药预沟通办法（试行）》以邮件形式提交申请资料。资料接收时间自即日起至2026年11月30日止，接收邮箱为ybczy@nhsa.gov.cn。","国家医保局启动第三批参照药预沟通，企业可据此判断申报窗口与材料准备节奏。",{"_91":101},[88,101,89],"wq3v7btwjs23x9c0g6pshbtag","国家药监局核查中心就《医用手术机器人检查要点（征求意见稿）》公开征求意见","国家药监局药品审核查验中心11月18日发布《医用手术机器人检查要点（征求意见稿）》，公开征求意见，旨在规范和指导医用手术机器人产品质量管理体系现场检查工作。意见反馈须于2026年12月10日前发送至mdgmp@cfdi.org.cn。",{"_91":163},[88,200,182],"mjg60i7hl3xyqar2eplnyovke","中国流感监测周报第935期：北方阳性率上升，A(H1N1)pdm09占56.2%","截至2026年11月15日的一周，南方省份流感病毒检测阳性率略有下降，北方省份上升，全国检出阳性样本中A(H1N1)pdm09占56.2%、A(H3N2)占15.5%、B(Victoria)系占28.3%，共报告144起流感样病例暴发疫情。","周报给出南北省份阳性率分化、毒株构成与神经氨酸酶抑制剂敏感性数据，可作为流感季用药与备货的参考。",{"_91":258},"2026-11-19T00:00:00.000Z",[88,162],"中国疾控·流感监测周报","zq66662mi7evig5jqnxotf9ly","中国疾控发布2026年第46周全国急性呼吸道传染病哨点监测结果","中国疾控发布2026年第46周（11月9日至15日）全国哨点监测结果，门急诊流感样病例百分比为4.5%，216家多病原监测哨点医院门急诊流感样病例样本阳性率前三位为流感病毒22.5%、鼻病毒10.6%、人偏肺病毒5.5%，住院严重急性呼吸道感染病例前三位为鼻病毒9.5%、流感病毒8.7%、人偏肺病毒6.8%。","中国疾控第46周哨点监测给出流感病毒与鼻病毒的阳性率及年龄、地域分布，可据此判断当季呼吸道病原体流行结构。",{"_91":266},[88,162],60,"中国疾控·急性呼吸道传染病哨点监测","kjbehmt51b2gcerdoca96uzvd","广东联盟阿替洛尔等药品带量联动采购文件附表补充征求意见：新增精氨酸、尼可刹米注射剂","广东省药品交易中心就《广东联盟阿替洛尔等药品带量联动采购文件（征求意见稿）》附表《采购清单及统一代表品》补充征求意见，新增序号24精氨酸注射剂、序号25尼可刹米注射剂两个品种。征求意见时间为2026年11月20日至11月24日17:00，意见需以加盖单位鲜章的《征求意见表》扫描件及对应excel文档发送至指定邮箱，逾期不予受理。",{"_91":154},"2026-11-19T16:00:00.000Z",[88,89],"r7gykfthlmuumthprug6wjjl2","广东省第三方药品电子交易平台同步20261113批次新增挂网药品数据","广东省第三方药品电子交易平台已将20261113批次审核通过且公示无异议的新增挂网药品数据同步至广东招采子系统。相关企业需使用CA证书登录子系统维护配送关系，挂网药品配送须覆盖全省所有参加药品采购的各类医疗机构，配送关系符合要求后医疗机构方可发起合同交易。",{"_91":154},[88,89],"ai9e7l1a4kgolsi594n35acw6","湖南调整优化医疗服务价格：统筹基金安全、医院运转与群众负担","湖南省医保局持续调整优化医疗服务价格，2025年全省全年调价总金额12.69亿元，其中年度动态调整空间5.34亿元、价格治理腾出空间7.35亿元，调价严格控制在总量之内。动态调整机制设3项启动条件、5项约束条件，并设医保基金安全\"熔断\"红线。2025年全省公立医疗机构医疗服务收入占医药总费用比例62.3%，较2019年的55.8%增长6.5个百分点。",{"_91":101},"2026-11-20T00:00:00.000Z",[88,89,101],"fsjjrskjg8ksir6am4hqxgi5r","药品注册检验改革一周年：奥普雷顿片中国首发，罕见病药品检验样品降幅达78%","药品注册检验改革实施一周年，武田制药1型发作性睡病创新药奥普雷顿片借助新规实现中国率先获批并开出首批处方，其注册检验样品需求减少约78%。《规范》将常规药品每批样品量由3倍减为2倍、罕见病药品由3批9倍量减为1批2倍量，降幅分别为33%和78%。一年内药检系统受理优先审评品种64个，平均检验用时61个工作日，较法定时限缩短23.8%。",{"_91":163},[88,182,289,290,291],"罕见病","行业趋势","武田","hwl6l365btztpp4v2i7iy1vld","武汉\"医保共治随手拍\"吸纳8182名环卫工，凭广告照片侦破跨省\"回流药\"分销案","武汉依托\"医保共治随手拍\"活动吸纳8182名环卫工人、城管协管员担任街头医保监督员，上报医保套现类小广告线索，街面广告存量与新发量降幅明显。江汉区依据环卫工拍下的广告照片，联合公安开展大数据研判并借助药品追溯码溯源，成功侦破跨省\"回流药\"分销案件，抓获多名涉案人员。",{"_91":101},[88,89,101],40,"kgcj05z6179abnp5pz1qt8irq","宁夏以“四项改革”促进“三医”协同：集采药品耗材954种、43类，累计减负超20亿元","宁夏医保部门以医疗服务价格与集采、医保目录管理、基金清算结算等改革促进“三医”协同。“十四五”以来累计执行集采药品、医用耗材中选产品954种、43类，减轻群众负担超20亿元；全区定点医疗机构实行“年预付、日结算”的“T+1”拨付，基金结算周期从20多个工作日缩短至1个工作日。2025年全区跨省异地就医直接结算率达95.8%，惠及322万人次。",{"_91":101},[88,89,101],30,"nadfm7ys9e8xjhaud757h8l2u","工信部公布第五批中小企业特色产业集群名单，5个生物医药集群入选","工业和信息化部公布2026年度（第五批）中小企业特色产业集群名单，共97个集群入选，主要集中在能源、电力通信、人工智能、生物医药等领域，其中5个涉及生物医药，包括杭州钱塘区合成生物、彭州中医药、昆明呈贡区民族特色生物医药、陇西中药材精深加工和乌鲁木齐新市区生物医药集群。",{"_91":163},[88,290],"pyvov8yvcdpsq8ma7olreownp","上海暂停南京泽恒医药舒更葡糖钠注射液采购资格","上海市医药集中招标采购事务管理所发布通知，因江苏省药监局检查发现南京泽恒医药技术开发有限公司委托亚邦医药股份有限公司生产的舒更葡糖钠注射液上市许可持有人与受托企业质量管理体系均存在缺陷、生产不符合要求，自2026年11月21日0时起暂停该品种两个规格（5ml:500mg、2ml:200mg）的采购资格。","上海招采部门依据江苏药监检查结果暂停该品种采购资格，读者可据此了解集采中选药品的质量联动处置方式。",{"_91":201},[88,316,89],55,"安全/质量","rqtkw1ihf4gnbdzvt3e035s3a","每周医药看点（11月9日—15日）：2026版医保目录新增107种药品、商保创新药目录新增12种药品","国家医保局、人力资源和社会保障部发布2026年版国家医保药品目录与商保创新药目录，前者新增107种药品（含51个1类创新药），后者新增12种药品，均自2027年1月1日起执行。国家卫生健康委等四部门发文明确1类新药不计入\"一品两规\"，且不纳入门诊基本药物处方占比等绩效监测指标。和誉医药盐酸匹米替尼胶囊获FDA批准上市，用于症状性腱鞘巨细胞瘤成年患者。",{"_91":163},[88,89,101,182,322],"恒瑞医药","wlcer7ylafqawgf1n363et9rc","深圳医保以数据穿透和事前拦截整治超量开药，拦截金额超3600万元","深圳市医保部门针对门诊共济改革后超量开药套取医保基金行为，采取数据穿透、行刑联动和事前拦截等措施，联合公安机关抓获犯罪嫌疑人30名，涉案金额200余万元，15名涉案人员被依法处理。","深圳医保部门用知识图谱锁定超量开药，并开发11类事前提醒规则，呈现了门诊共济改革后基金监管的具体做法。",{"_91":101},[88,89,101,223],52,"sfnag7k8zsv8mp77kr5pzjly1","天津医药采购中心公示第十二批国家集采中选药品采购执行量并启动三方协议签订","天津医药采购中心发布通知，开展第十二批国家组织药品集中采购中选药品的采购执行量公示及三方协议签订工作。通知未披露涉及品种、执行量数据与时间安排。",{"_91":131},"2026-11-20T07:37:55.000Z",[88,89],"onp0bhygo0mfn0zfeov73clqw","国家药监局推进真实世界数据应用试点转入规范发展新阶段","国家药监局副局长雷平在海南参加第八次真实世界数据应用试点领导小组会议，部署推动真实世界试点从探索阶段转入规范发展、常态应用新阶段。会议提出完善制度规则、对标国际共识打造技术指南体系，并探索建设全国药械真实世界数据平台，支持不良反应（事件）监测等工作。雷平同时出席第五届博鳌国际药械真实世界研究大会。",{"_91":163},"2026-11-23T00:00:00.000Z","2026-11-23T07:25:15.980Z",[88,182],"pz5drvoitu22by2u85ods5knz","口腔种植体系统全国联盟接续采购启动需求量填报，四川牵头、上海通知医疗机构报量","四川省医保局牵头组织全国各省组成联盟开展口腔种植体系统接续采购，医疗机构须于2026年11月23日9:00至12月4日17:00在四川省口腔种植体系统报量平台填报历史采购量（2025年11月1日—2026年10月31日）和采购需求量。",{"_91":201},"2026-11-23T08:25:31.551Z",[88,89,200,101],"vxcpk675loj8ni5cq36j1fcmp","上海药事所发布2026年第四季度集采中选药品续签通知，12月20日执行","上海市医药集中招标采购事务管理所发布通知，对采购协议期满并完成约定采购量的部分集采中选药品，与中选企业及其指定配送企业续签购销三方协议，通知于2026年12月20日执行。具体续签品种见附件《2026年第四季度集采中选药品续签信息表》，医疗机构在带量采购中选药品采购中发现问题需及时向市药事所反馈。","上海药事所对四季度到期的集采中选药品启动三方协议续签，涉及品种与执行时间以附件信息表为准。",{"_91":201},"2026-11-23T12:26:30.207Z",[88,89,129,130],"u2gdvowt6n9yfb29t6012vctj","上海暂停桂林南药盐酸莫西沙星片采购资格","上海市医药集中招标采购事务管理所通知，桂林南药股份有限公司持有并生产的盐酸莫西沙星片为1-8批国家集采协议期满接续采购中选药品，因经辽宁省药品检验检测院检验溶出度不符合规定，自2026年11月24日0时起暂停该药品在上海市招采子系统的采购资格。此次暂停依据国家药监局2026年11月12日发布的《关于27批次不符合规定药品的通告》（2026年第39号），涉及0.4g规格3片/盒与6片/盒两种包装。","国家集采中选药品因溶出度不合格被暂停采购资格，读者可据此了解中选药品质量问题的处理路径。",{"_91":201},"2026-11-23T12:26:30.217Z",[88,364,316,129,130,365,366],72,"抗菌药物","对销售","对准入","firstParty","tag","q","tab","time",{"_373":374,"_375":-5,"_376":128},"changelogVersion","2026-10-08T08:00","release","staticSite"]
