1":188,"_83":84,"_85":86,"_87":-5},{"_64":172,"_66":173,"_68":174,"_70":-5,"_72":175,"_74":176,"_76":177,"_77":78,"_79":178,"_81":179,"_83":113,"_85":86,"_87":-5},{"_64":164,"_66":165,"_68":166,"_70":-5,"_72":167,"_74":142,"_76":168,"_77":78,"_79":169,"_81":145,"_83":113,"_85":86,"_87":-5},{"_64":156,"_66":157,"_68":158,"_70":-5,"_72":159,"_74":142,"_76":160,"_77":78,"_79":161,"_81":145,"_83":113,"_85":86,"_87":-5},{"_64":147,"_66":148,"_68":149,"_70":-5,"_72":150,"_74":142,"_76":151,"_77":78,"_79":152,"_81":153,"_83":113,"_85":86,"_87":-5},{"_64":138,"_66":139,"_68":140,"_70":-5,"_72":141,"_74":142,"_76":143,"_77":78,"_79":144,"_81":145,"_83":113,"_85":86,"_87":-5},{"_64":132,"_66":133,"_68":134,"_70":-5,"_72":135,"_74":101,"_76":101,"_77":78,"_79":136,"_81":137,"_83":113,"_85":86,"_87":-5},{"_64":126,"_66":127,"_68":128,"_70":-5,"_72":129,"_74":101,"_76":101,"_77":78,"_79":130,"_81":131,"_83":113,"_85":86,"_87":-5},{"_64":121,"_66":122,"_68":123,"_70":-5,"_72":124,"_74":101,"_76":101,"_77":78,"_79":125,"_81":120,"_83":113,"_85":86,"_87":-5},{"_64":115,"_66":116,"_68":117,"_70":-5,"_72":118,"_74":101,"_76":101,"_77":78,"_79":119,"_81":120,"_83":113,"_85":86,"_87":-5},{"_64":107,"_66":108,"_68":109,"_70":-5,"_72":110,"_74":101,"_76":101,"_77":78,"_79":111,"_81":112,"_83":113,"_85":86,"_87":-5},{"_64":96,"_66":97,"_68":98,"_70":99,"_72":100,"_74":101,"_76":101,"_77":78,"_79":102,"_81":103,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":71,"_72":73,"_74":75,"_76":75,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","x92un5xr4q0bjusu9nepao4hi","title","新版双目录发布：基本医保目录新增107种药品，商保创新药目录累计28种","summary","11月14日发布的2026版基本医保目录新增107种药品，含51个1类创新药，覆盖肿瘤、罕见病、精神类疾病等领域，目录累计3331种药品。商保创新药目录新增12种，累计28种，包括全球首个实体瘤CAR-T、中国首个血友病基因治疗药物等。首版商保目录中有2款创新药转入新版基本医保目录，形成商保先行探索、基本医保适时衔接的转化路径。","reason","新版双目录同时公布新增品种与商保向基本医保的转化路径，可看清创新药准入的两个通道如何衔接。","source",{"_94":95},"publishedAt","2026-11-14T00:00:00.000Z","timelineAt","category","policy","tags",[88,89,90,91,92,93],"score",85,"selected",true,"channel","news","x","政策/监管","医保/集采","国家医保局","肿瘤","罕见病","细胞与基因治疗","name","中国食品药品网·要闻","bzxiz2g5cjrgerkn97jpa4ckf","恒瑞医药12款产品通过2026年新版国家医保目录调整，3款新药首次纳入","《国家基本医疗保险、生育保险和工伤保险药品目录（2026年）》于11月14日公布，恒瑞医药共有12款产品通过调整，其中3款新药首次进入医保，覆盖代谢与肿瘤领域，分别为恒格列净瑞格列汀二甲双胍缓释片（II）、鲁兹诺雷钠片和泽美妥司他片。另有艾维达（注射用瑞康曲妥珠单抗）与艾瑞康（羟乙磺酸达尔西利片）的新适应症纳入医保，后者同时完成续约；其余7款产品续约成功保留在目录内。","恒瑞12款产品通过新版医保目录调整，其中3款新药首次纳入，读者可据此了解相关品种的准入变化。",{"_94":106},"2026-11-16T00:00:00.000Z",[88,89,104,91,105],72,"恒瑞医药","代谢/减重","恒瑞医药·新闻","dn8y8mpt1ix1dbnh81othx33x","CDE发布《儿童药物临床试验中应用患者报告结局（PRO）技术指导原则》","CDE于11月16日发布《儿童药物临床试验中应用患者报告结局（PRO）技术指导原则》，经国家药监局审查同意，自发布之日起施行。该指导原则旨在推动我国儿童用药研发，提高临床研究的质量和效率。",{"_94":95},[88,114],38,false,"NMPA","i1nf2m6v0jcfnwkd0xpx635qx","福建医保定点资源配置规划：2025年定点医药机构25166家，基金支出同比下降3.49%","福建省医保部门推进医保定点资源配置规划编制，2025年全省定点医药机构25166家、与上年基本持平，基本医保基金支出同比下降3.49%，所有统筹区实现当期收支平衡。规划实施以来定点医药机构仅增长179家，年均增长率不到1.08%；福州按每千人6.3张床位、3.8名医师设定住院和门诊机构配置目标，并对床位使用率持续低于60%的地区审慎新增定点。",{"_94":90},[88,89,90],42,"o1ml4zb2ra35oa0acmbh65iza","国家医保局指导各地持续调整优化医疗服务价格：技术劳务类上调、检查检验类下调","国家医保局指导各地常态化运行医疗服务价格动态调整机制，2018—2025年医疗服务价格总水平累计上涨26.0%，年均涨幅约3.4%。技术劳务类项目价格合理上调，如普通门诊诊查费平均上涨约20.3%、运动功能训练平均上涨约82.9%；检查检验类价格下调，PET/CT局部显像价格下降约47.0%，男性五项肿瘤标志物检测从500元下调至220元。",{"_94":90},[88,89,90],"rwoc2elp8bmfhrfeqoeza0x2s","萍乡医保外配处方试点：手机复诊开方、药店比价报销少跑腿","萍乡市自2026年6月上线医保复诊开方服务以来，累计开出医保电子处方3.5万余张，3万余名慢病患者实现线上复诊、就近购药报销。患者可通过萍乡医保通微信小程序发起复诊开方，医师线上接诊到开出处方约5分钟，病情稳定者可开长期用药处方。当地药品比价小程序已连通全市530余家定点药店库存价格信息，支持拍照扫码查药与多药筛选。",{"_94":90},[88,89,90],22,"vp2jb5mkntfsjjr6md14hbtpm","象山县医保局深化宁波长护险试点：2358名失能人员享受待遇，建成7家基层医养中心","宁波长护险试点启动以来，象山县医保局走访失能家庭4000余户，建立497名村社联系人制度，目前全县2358名失能人员享受长护待遇。全县已建成7家基层医养中心、160张医养床位，家庭照护负担减轻四成以上；2025年处理违规机构11家次，追回基金3.16万元。",{"_94":90},[88,89,90],10,"es4cw3eqedoqn7nypvwox7911","恒瑞医药公告公司药品纳入国家医保目录","恒瑞医药发布公告，说明公司药品纳入国家医保目录。公告未披露具体药品名称、适应症及纳入方式。",{"_94":146},"2026-11-15T16:00:00.000Z","2026-11-16T00:55:08.298Z",[88,89,104],62,"恒瑞医药·公司公告","x31n2db92vy3sut3ri8fk47ql","华东医药公告全资子公司产品及合作产品纳入国家医保目录及商保创新药目录","华东医药发布公告，称其全资子公司产品及合作产品纳入国家医保目录及商保创新药目录。公告未披露具体产品名称、适应症及纳入方式。",{"_94":155},"2026-11-16T00:55:12.313Z",[88,89,154],75,"华东医药","华东医药·公司公告","jb2iq02cqmnptb0jg7u2k5dmm","华北制药公告公司及下属子公司产品纳入国家医保目录","华北制药发布公告，说明公司及下属子公司产品纳入国家医保目录。公告未披露具体产品名称、适应症及纳入方式。",{"_94":163},"2026-11-16T00:55:13.893Z",[88,89,162,90],"华北制药","华北制药·公司公告","nd7yzwjuqsswknaef4gi5bt8d","复星医药公告控股子公司药品新纳入国家医保目录","复星医药发布提示性公告，称控股子公司药品获新纳入国家医保目录。公告未披露具体药品名称、适应症及纳入类别。",{"_94":171},"2026-11-16T00:55:13.951Z",[88,89,170],"复星医药","复星医药·公司公告","etbb7t1ta2pb6a34m8aak48hh","翰森制药创新药纳入2026国家医保目录","翰森制药发布自愿公告，披露创新药纳入2026国家医保目录的业务进展。公告未披露具体药品名称、适应症及谈判结果细节。",{"_94":181},"2026-11-15T10:25:00.000Z","2026-11-16T00:55:18.036Z",[88,89,180],36,"翰森制药","翰森制药·港交所公告","lw0qysxmn2n4zv2g5tvzq3fxi","天津医药采购中心发布挂网药品价格联动调整工作通知","天津医药采购中心发布关于开展挂网药品价格联动调整工作的通知，材料未提供正文，具体调整范围、联动规则与执行时间暂未披露。",{"_94":191},"2026-11-16T10:24:27.000Z",[88,89,189,190],58,"抗感染","市场准入","天津医药采购中心·通知公告","rsr8ifgox97qwwxa06unya506","科伦药业公告公司药品纳入国家医保目录","科伦药业发布公告称公司药品纳入国家医保目录，公告未披露具体药品名称、适应症及支付规则。",{"_94":200},"2026-11-16T16:00:00.000Z",[88,89,199],67,"科伦药业","科伦药业·公司公告","ve0ppj48xx02vv4x4eq007iwh","广东开展第十二批国家集采中选企业供应清单外规格包装挂网价格确认","广东省药品交易中心启动第十二批国家集采中选企业未在供应清单内规格包装产品的挂网价格确认，要求按本企业中选价格依差比价规则计算调整，确认时间为即日起至2026年11月20日17:30。企业同意调整的价格自2026年11月30日起与中选结果同步执行，拒绝确认且申诉未获采纳或逾期未操作的药品自同日起取消挂网。","广东对第十二批国家集采中选企业供应清单外规格包装启动挂网价确认，涉及差比价调整与逾期取消挂网。",{"_94":207},[88,89,189,190],"广东省药品交易中心·通知公告","jbz8if39c7s579einl40mn76n","国家疾控局等三部门发文，十五五期间逐步实现疫苗处方全覆盖","11月17日，国家疾控局、国家卫生健康委和国家中医药局联合发布《关于全面推行疫苗处方工作的指导意见》，提出“十五五”期间逐步实现疫苗处方在二级及以上医疗机构、基层医疗卫生机构的全覆盖。","三部门联合发文明确疫苗处方的实施机构、开具科室与推荐疫苗品种，读者可据此判断院内接种服务的落地路径。",{"_94":95},"2026-11-17T00:00:00.000Z",[88,215],"感染/疫苗","mt9jo5os7n40feu1p3lxb1yf3","湖南调整优化医疗服务价格，2025年调价总金额12.69亿元","湖南省医保局介绍医疗服务价格动态调整机制运行情况，2025年全省全年调价总金额12.69亿元，其中年度动态调整空间5.34亿元、价格治理腾出空间7.35亿元。机制设3项启动条件、5项约束条件，上年度医药总费用增幅高于10%或基金当期赤字等情形原则上不得上调价格。2026年10月湖南还下调560个药品、352类医用耗材的个人先行自付比例，预计每年增加基金支出保底约8亿元。","湖南披露调价总量、熔断条件与支付协同的具体做法，可供其他省份测算调价空间时参照。",{"_94":90},[88,89,90],"ppsc4ntc7supymzd4279n65pw","国家疾控局等三部门解读《关于全面推行疫苗处方工作的指导意见》","国家疾控局会同国家卫生健康委、国家中医药局联合印发《关于全面推行疫苗处方工作的指导意见》，明确\"十五五\"期间逐步实现疫苗处方在二级及以上医疗机构和基层医疗卫生机构全覆盖。文件规定由全科医疗科、预防保健科等科室具有资质的临床、公共卫生、中医类别医师开具处方，并规范识别对象、开具处方、接种服务、信息化管理等流程。",{"_94":95},[88,215],"pxjzphkmel1drwv3ihsnnjuv7","国家药监局党组召开2026年巡视工作会议暨第四轮巡视动员部署会","国家药监局党组11月16日召开2026年巡视工作会议暨第四轮巡视动员部署会，宣布对服务中心、国际交流中心、南方所、特药检查中心开展常规巡视。会议传达学习中央政治局审议《关于二十届中央第七轮巡视情况的综合报告》有关会议精神及全国巡视工作会议精神，局党组成员、副局长王维东出席并讲话。第四轮巡视在中央巡视整改期间同步开展，会议要求精准查摆问题、把政治监督落到实处。",{"_94":95},[88,114],8,"uz3zgv69ybm7424idhbl8f2on","国家疾控局等三部门发文全面推行疫苗处方工作","国家疾控局、国家卫生健康委、国家中医药局联合印发《关于全面推行疫苗处方工作的指导意见》，推动各地全面、规范开展疫苗处方工作，以深化医防协同、医防融合机制。通知于11月17日在国家疾控局网站发布，文件落款日期为2026年10月30日，要求各地结合实际认真组织实施。","三部门联合发文推行疫苗处方，读者可据此判断接种服务从公共卫生向临床处方环节延伸的方向。",{"_94":95},[88,215],"v0pqx5ioi1g6n53tyodvgwy7n","药品海外注册公益培训班在苏州举办，近500家药企参加","11月10日至12日，由国家药监局高级研修学院主办、江苏省药监局苏州检查分局和苏州市药学会协办的药品海外注册公益培训班在苏州举办，近500家药品企业相关负责人参加。培训聚焦药品海外注册能力提升，内容涵盖药品出口监管要求解读、海外注册路径选择、欧美注册申报实务、项目管理及对外授权交易等。高研院表示将持续分区域、分领域、分专题组织海外注册培训。",{"_94":95},[88,114],12,"zk78bth1hygdmgtuka9hg72ai","上海执行国家组织冠脉支架集采第二轮接续中选结果，11月20日生效","上海市医药集中招标采购事务管理所通知，国家组织冠脉支架集中带量采购第二轮接续中选结果自2026年11月20日起执行，采购周期至2029年6月30日。医疗机构须按中选价采购、不得二次议价，每年度总协议采购量不低于前一年实际使用量的90%。非中选冠状动脉药物洗脱合金支架挂网价≥1708元/个纳入黄标、≥2372元/个纳入红标管理。",{"_94":251},[88,89,250],"医疗器械/IVD","上海阳光医药采购网","idobj0vusczpaxp0my53uwmx0","天津启动二十六省联盟集采与第九批国家集采残缺规格两个项目协议到期续签","天津医药采购中心发布通知，就二十六省联盟药品集中带量采购、第九批国家组织药品集中采购天津市残缺规格两个项目协议到期后的续签执行工作作出安排。通知未披露涉及品种、续签规则与执行时间等具体内容。",{"_94":191},"2026-11-17T09:18:27.000Z",[88,89,189,190],"vtteda0kxkfhqifq9c3hu6exr","FDA 启动全球依赖披露计划（GRDP），扩大全球患者药物可及性","FDA 宣布启动全球依赖披露计划（GRDP），旨在改变全球卫生监管机构利用 FDA 药品与生物制品审批决策的方式。该计划为一项里程碑式举措，目标是扩大全球患者对药物的可及性。",{"_94":265},"2026-11-17T20:32:16.000Z",[88,264],"FDA","FDA 新闻稿","cu01fnfdb13vrz4ynrs24k4zn","云南构建“事前提醒+事中控制”机制，筑牢医保基金安全防线","云南省医保部门针对回流药倒卖、超量开药等问题，实施“事前提醒、事中控制”模式，首批将司美格鲁肽、复方α-酮酸片等纳入控制范围。自2023年12月实施以来，系统累计分析审核处方约3.1亿张，对213.8万笔不合理超量开药费用实施事中控制转自费结算，涉及金额1.21亿元。全省定点医药机构事前提醒功能接入率超95%。",{"_94":90},"2026-11-18T00:00:00.000Z",[88,89,90,272],"GLP-1","s5xdh4curuu6un3l30quk1u7b","国家药监局在贵阳召开血液制品生产智慧监管三年行动工作总结会","国家药监局11月17日在贵阳召开血液制品生产智慧监管三年行动工作总结会，该工作自2024年起部署，目前整体完成，行业信息化基础得到夯实、智慧监管水平实现提升。会议强调持续巩固建设成果、压紧压实企业主体责任，切实保障血液制品质量安全。副局长杨胜还赴血液制品生产企业和贵州省药检所调研生产监管和批签发情况。",{"_94":95},[88,114,278],"血液","tvlcn788i988roqc45luqe7fm","福建省医保局举办“敬老月里话长护 医保服务暖银龄”长护险政策宣传活动","10月21日，福建省医保局、福州市医保局在福州鼓楼区举办长期护理保险政策专场宣传活动，设政策宣讲、现场答疑、健康义诊、互动问答、科普展板五大功能区。福州自2021年起开展全国第二批长护险试点，今年6月福建省印发实施方案，明确2028年基本建立覆盖全省的长护险制度，2026年底前省本级、厦门、泉州、三明陆续启动，福州将覆盖范围从职工扩大到城乡居民。",{"_94":90},[88,89,90],"wq3v7btwjs23x9c0g6pshbtag","国家药监局核查中心就《医用手术机器人检查要点（征求意见稿）》公开征求意见","国家药监局药品审核查验中心11月18日发布《医用手术机器人检查要点（征求意见稿）》，公开征求意见，旨在规范和指导医用手术机器人产品质量管理体系现场检查工作。意见反馈须于2026年12月10日前发送至mdgmp@cfdi.org.cn。",{"_94":95},[88,250,114],"mjg60i7hl3xyqar2eplnyovke","中国流感监测周报第935期：北方阳性率上升，A(H1N1)pdm09占56.2%","截至2026年11月15日的一周，南方省份流感病毒检测阳性率略有下降，北方省份上升，全国检出阳性样本中A(H1N1)pdm09占56.2%、A(H3N2)占15.5%、B(Victoria)系占28.3%，共报告144起流感样病例暴发疫情。","周报给出南北省份阳性率分化、毒株构成与神经氨酸酶抑制剂敏感性数据，可作为流感季用药与备货的参考。",{"_94":296},"2026-11-19T00:00:00.000Z",[88,215],"中国疾控·流感监测周报","zq66662mi7evig5jqnxotf9ly","中国疾控发布2026年第46周全国急性呼吸道传染病哨点监测结果","中国疾控发布2026年第46周（11月9日至15日）全国哨点监测结果，门急诊流感样病例百分比为4.5%，216家多病原监测哨点医院门急诊流感样病例样本阳性率前三位为流感病毒22.5%、鼻病毒10.6%、人偏肺病毒5.5%，住院严重急性呼吸道感染病例前三位为鼻病毒9.5%、流感病毒8.7%、人偏肺病毒6.8%。","中国疾控第46周哨点监测给出流感病毒与鼻病毒的阳性率及年龄、地域分布，可据此判断当季呼吸道病原体流行结构。",{"_94":304},[88,215],60,"中国疾控·急性呼吸道传染病哨点监测","kjbehmt51b2gcerdoca96uzvd","广东联盟阿替洛尔等药品带量联动采购文件附表补充征求意见：新增精氨酸、尼可刹米注射剂","广东省药品交易中心就《广东联盟阿替洛尔等药品带量联动采购文件（征求意见稿）》附表《采购清单及统一代表品》补充征求意见，新增序号24精氨酸注射剂、序号25尼可刹米注射剂两个品种。征求意见时间为2026年11月20日至11月24日17:00，意见需以加盖单位鲜章的《征求意见表》扫描件及对应excel文档发送至指定邮箱，逾期不予受理。",{"_94":207},"2026-11-19T16:00:00.000Z",[88,89],"r7gykfthlmuumthprug6wjjl2","广东省第三方药品电子交易平台同步20261113批次新增挂网药品数据","广东省第三方药品电子交易平台已将20261113批次审核通过且公示无异议的新增挂网药品数据同步至广东招采子系统。相关企业需使用CA证书登录子系统维护配送关系，挂网药品配送须覆盖全省所有参加药品采购的各类医疗机构，配送关系符合要求后医疗机构方可发起合同交易。",{"_94":207},[88,89],"fsjjrskjg8ksir6am4hqxgi5r","药品注册检验改革一周年：奥普雷顿片中国首发，罕见病药品检验样品降幅达78%","药品注册检验改革实施一周年，武田制药1型发作性睡病创新药奥普雷顿片借助新规实现中国率先获批并开出首批处方，其注册检验样品需求减少约78%。《规范》将常规药品每批样品量由3倍减为2倍、罕见病药品由3批9倍量减为1批2倍量，降幅分别为33%和78%。一年内药检系统受理优先审评品种64个，平均检验用时61个工作日，较法定时限缩短23.8%。",{"_94":95},"2026-11-20T00:00:00.000Z",[88,114,92,322,323],"行业趋势","武田","hwl6l365btztpp4v2i7iy1vld","武汉\"医保共治随手拍\"吸纳8182名环卫工，凭广告照片侦破跨省\"回流药\"分销案","武汉依托\"医保共治随手拍\"活动吸纳8182名环卫工人、城管协管员担任街头医保监督员，上报医保套现类小广告线索，街面广告存量与新发量降幅明显。江汉区依据环卫工拍下的广告照片，联合公安开展大数据研判并借助药品追溯码溯源，成功侦破跨省\"回流药\"分销案件，抓获多名涉案人员。",{"_94":90},[88,89,90],40,"kgcj05z6179abnp5pz1qt8irq","宁夏以“四项改革”促进“三医”协同：集采药品耗材954种、43类，累计减负超20亿元","宁夏医保部门以医疗服务价格与集采、医保目录管理、基金清算结算等改革促进“三医”协同。“十四五”以来累计执行集采药品、医用耗材中选产品954种、43类，减轻群众负担超20亿元；全区定点医疗机构实行“年预付、日结算”的“T+1”拨付，基金结算周期从20多个工作日缩短至1个工作日。2025年全区跨省异地就医直接结算率达95.8%，惠及322万人次。",{"_94":90},[88,89,90],30,"nadfm7ys9e8xjhaud757h8l2u","工信部公布第五批中小企业特色产业集群名单，5个生物医药集群入选","工业和信息化部公布2026年度（第五批）中小企业特色产业集群名单，共97个集群入选，主要集中在能源、电力通信、人工智能、生物医药等领域，其中5个涉及生物医药，包括杭州钱塘区合成生物、彭州中医药、昆明呈贡区民族特色生物医药、陇西中药材精深加工和乌鲁木齐新市区生物医药集群。",{"_94":95},[88,322],"pyvov8yvcdpsq8ma7olreownp","上海暂停南京泽恒医药舒更葡糖钠注射液采购资格","上海市医药集中招标采购事务管理所发布通知，因江苏省药监局检查发现南京泽恒医药技术开发有限公司委托亚邦医药股份有限公司生产的舒更葡糖钠注射液上市许可持有人与受托企业质量管理体系均存在缺陷、生产不符合要求，自2026年11月21日0时起暂停该品种两个规格（5ml:500mg、2ml:200mg）的采购资格。","上海招采部门依据江苏药监检查结果暂停该品种采购资格，读者可据此了解集采中选药品的质量联动处置方式。",{"_94":251},[88,348,89],55,"安全/质量","rqtkw1ihf4gnbdzvt3e035s3a","每周医药看点（11月9日—15日）：2026版医保目录新增107种药品、商保创新药目录新增12种药品","国家医保局、人力资源和社会保障部发布2026年版国家医保药品目录与商保创新药目录，前者新增107种药品（含51个1类创新药），后者新增12种药品，均自2027年1月1日起执行。国家卫生健康委等四部门发文明确1类新药不计入\"一品两规\"，且不纳入门诊基本药物处方占比等绩效监测指标。和誉医药盐酸匹米替尼胶囊获FDA批准上市，用于症状性腱鞘巨细胞瘤成年患者。",{"_94":95},[88,89,90,114,104],"wlcer7ylafqawgf1n363et9rc","深圳医保以数据穿透和事前拦截整治超量开药，拦截金额超3600万元","深圳市医保部门针对门诊共济改革后超量开药套取医保基金行为，采取数据穿透、行刑联动和事前拦截等措施，联合公安机关抓获犯罪嫌疑人30名，涉案金额200余万元，15名涉案人员被依法处理。","深圳医保部门用知识图谱锁定超量开药，并开发11类事前提醒规则，呈现了门诊共济改革后基金监管的具体做法。",{"_94":90},[88,89,90,272],52,"sfnag7k8zsv8mp77kr5pzjly1","天津医药采购中心公示第十二批国家集采中选药品采购执行量并启动三方协议签订","天津医药采购中心发布通知，开展第十二批国家组织药品集中采购中选药品的采购执行量公示及三方协议签订工作。通知未披露涉及品种、执行量数据与时间安排。",{"_94":191},"2026-11-20T07:37:55.000Z",[88,89],"firstParty","tag","q","tab","time",{"_373":374,"_375":-5,"_376":84},"changelogVersion","2026-10-08T08:00","release","staticSite"]
