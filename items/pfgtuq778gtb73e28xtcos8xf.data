[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794205945000,"id","pfgtuq778gtb73e28xtcos8xf","title","上海医药2026年前三季度营收2229.64亿元，扣非净利润增长25.02%","originalTitle","透视三季报，解锁上海医药稳增长密码","summary","上海医药公布2026年前三季度业绩，实现营业收入2229.64亿元，同比增长3.67%，扣非归母净利润33.74亿元，同比增长25.02%。工业板块收入189.89亿元、同比增长4.54%，商业板块收入2039.75亿元、同比增长3.59%，占总营收比重超过90%。报告期内研发费用15.16亿元，占医药工业收入比重7.98%，新药管线共60项，1类新药苹果酸司妥吉仑片已获批上市并在多个省份挂网。","reason","原文拆解上海医药前三季度工业与商业两大板块的收入结构，可看其创新药服务与CSO业务的增长位置。","source",{"_75":96},"links",{"_60":95},"publishedAt","2026-10-30T00:00:00.000Z","discoveredAt","2026-10-30T11:06:56.067Z","timelineAt","category","industry","tags",[76,91,92,93,82,94,84],"score",60,"selected",true,"channel","news","story",{"_88":89,"_13":90},"x","readingMode","full","author","body","outline",[],"relatedStories",[87],"topics",[67,68,69,70,71,72],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","f9DYHBXcTc6Y","reportCount",1,"additionalSourceCount",0,{"_73":85,"_75":86},{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","company-news","name","公司动态","market","市场与销售","pipeline","研发管��","tcm","中药","small-molecule","小分子","antibody","抗体与双抗",{"_88":89,"_13":90},"publicId","6be81f91-49de-4a10-b664-c194a15a1b5a","上海医药前三季度营收2229.64亿元","市场/销售","研发管线","上海医药","抗体/双抗","https://www.menet.com.cn/info/202610/202610301622512251_151366.shtml","米内网·企业",{"_98":99,"_100":-5,"_101":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
