[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791089000,"id","gsi6a5l948tgszxtjr3ouzx7c","title","Immunity：莫纳什大学研究发现抗衰老新靶点 GzmK，可解耦机体衰老与免疫衰老","originalTitle","Immunity：发现抗衰老新靶点——GzmK","summary","莫纳什大学研究团队在 Immunity 发表研究，发现颗粒酶 K（GzmK）可驱动年龄相关组织纤维化和器官功能障碍，但不促进免疫衰老。在年轻和老年 GzmK−/− 小鼠中，GzmK 缺失显著减轻器官衰老，同时免疫衰老表型持续存在，表明机体衰老与免疫衰老可以解耦。肾脏中该效应与补体沉积减少相关，肝脏中则伴随核心糖蛋白聚糖（decorin）增加及促纤维化 TGF-β 信号减弱。","reason","source",{"_69":78},"links",{"_59":77},"publishedAt","2026-11-15T00:00:00.000Z","discoveredAt","2026-11-16T00:55:13.205Z","timelineAt","category","research","tags",[75,76],"score",8,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f1kOnvPgFZYk","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","papers","name","论文研究",{"_72":73,"_13":74},"publicId","5da69ed0-197b-4b0a-8281-d9d84ce07ec5","Immunity：GzmK驱动衰老组织重塑，可解耦免疫衰老","论文/研究","其他","https://news.bioon.com/article/7b24964194c6.html","生物谷",{"_80":81,"_82":-5,"_83":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
