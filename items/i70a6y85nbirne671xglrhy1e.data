[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795410126000,"id","i70a6y85nbirne671xglrhy1e","title","广西医科大学杨帆团队开发仿水母气泡马达微群，实现EV超灵敏液体活检","originalTitle","NBE：广西医科大学杨帆团队开发仿水母气泡微群，实现超灵敏液体活检","summary","广西医科大学杨帆团队受水母群协同捕食启发，设计自驱动气泡马达（Butor）微群，实现细胞外囊泡（EV）的智能化分离与超灵敏分析，为癌症液体活检提供新方案。该研究于2026年11月16日在线发表于Nature Biomedical Engineering，针对EV分离与检测方法不足限制临床应用的问题。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T04:24:55.774Z","timelineAt","category","research","tags",[81,76,82],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fuP5BaHyzmL0","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","device-ivd","医疗器械与 IVD","oncology","肿瘤",{"_78":79,"_13":80},"publicId","fecd74a2-f0e8-4b99-b994-800f3b08bf7c","杨帆团队仿水母气泡马达微群用于癌症液体活检","论文/研究","医疗器械/IVD","https://news.bioon.com/article/93bc96522e20.html","生物谷",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
