[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443813000,"id","fz90yj0jmuv75rx7meuoxlqea","title","全国省级药监微信公众号传播力分析（11月1日—11月7日）：湖北药监、江苏药品监管、广东药监居前","originalTitle","全国省级药监微信公众号传播力分析（11月1日—11月7日）","summary","11月8日，中国医药报社发布全国省级药监微信公众号传播力分析（11月1日—11月7日），湖北药监、江苏药品监管、广东药监等10个公众号传播力较强。湖北药监11月6日原创文章披露，省药监局武汉分局对辖区药品经营企业储运环节开展全覆盖检查，约谈企业6家、发放告诫信22份、排查风险隐患700余条、移送线索20余条。","reason","source",{"_62":68},"links",{"_57":67},"publishedAt","2026-11-10T00:00:00.000Z","discoveredAt","2026-11-11T14:04:23.259Z","timelineAt","category","industry","tags",[63,66],"score",10,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","trends","name","行业趋势","nmpa","中国 NMPA","NMPA","https://www.cnpharm.com/c/2026-11-10/1110247.shtml","中国食品药品网·要闻",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
