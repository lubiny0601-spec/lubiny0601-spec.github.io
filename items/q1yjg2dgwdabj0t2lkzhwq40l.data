[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791103000,"id","q1yjg2dgwdabj0t2lkzhwq40l","title","徐州长护险赋能基层医疗机构：42家机构纳入协议管理，棋盘镇卫生院建院内专区与居家上门服务","originalTitle","【江苏】院内专区筑阵地，院外上门护民生——徐州市长期护理保险赋能基层医疗机构新发展","summary","截至2026年8月，徐州纳入长护险协议管理的基层医疗机构共42家，累计入住失能人员2332人，长护险基金累计支付5577.16万元，带动综合营收11631.37万元。新沂市棋盘镇中心卫生院2022年10月建成长护专区，2026年1月试点启动居家上门长护服务，目前提供居家服务的失能人员达330人。","reason","source",{"_68":75},"links",{"_59":76},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-12T14:18:53.229Z","timelineAt","category","policy","tags",[74,75],"score",15,"selected",false,"channel","news","story",{"_71":72,"_13":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fVQlfFZ3Rv3o","reportCount",1,"additionalSourceCount",0,{"_67":30,"_68":69},"slug","name","政策与监管",{"_71":72,"_13":73},"publicId","1a6086f6-b448-42fa-8b9f-b7e5d152f021","徐州42家基层医疗机构纳入长护险协议管理","政策/监管","国家医保局","http://www.nhsa.gov.cn/art/2026/11/2/art_14_23284.html",{"_78":79,"_80":-5,"_81":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
