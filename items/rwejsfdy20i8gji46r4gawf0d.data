[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795410154000,"id","rwejsfdy20i8gji46r4gawf0d","title","第九届进博会闭幕：意向成交额854.5亿美元创历史新高，3项生物医药展品入选黑科技","originalTitle","进博会丨第九届进博会累计意向成交额达854.5亿美元，创历史新高","summary","第九届中国国际进口博览会11月10日闭幕，按一年计意向成交额达854.5亿美元，较上届增长2.3%，创历史新高。本届进博会企业展面积首达37万平方米，参展企业4142家，代表性首发首秀展品485件。10项黑科技展品中3项涉及生物医药，包括勃林格殷格翰索弗度肽、诺和诺德CagriSema、拜耳Asundexian。","reason","source",{"_72":90},"links",{"_59":89},"publishedAt","2026-11-10T00:00:00.000Z","discoveredAt","2026-11-11T14:04:23.219Z","timelineAt","category","industry","tags",[73,84,85,77,86,87,88],"score",18,"selected",false,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body","outline",[],"relatedStories",[80],"topics",[66,67,68,69],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fAtY2TLZMQI0","reportCount",1,"additionalSourceCount",0,{"_70":78,"_72":79},{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","trends","name","行业趋势","device-ivd","医疗器械与 IVD","cardiovascular","心血管","metabolic","代谢与减重",{"_81":82,"_13":83},"publicId","a65cfe29-0e20-4507-be4b-0f1feb4f598d","第九届进博会闭幕，意向成交额854.5亿美元创新高","医疗器械/IVD","代谢/减重","诺和诺德","拜耳","阿斯利康","https://www.cnpharm.com/c/2026-11-10/1110295.shtml","中国食品药品网·要闻",{"_92":93,"_94":-5,"_95":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
