[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205950000,"id","aiyapjzvpwk8lpkmlvzc8maxj","title","IDSA/ESCMID 发布金黄色葡萄球菌菌血症共识声明：聚焦随访血培养","originalTitle","IDSA/ESCMID Statement on Staphylococcus aureus: Follow-Up Blood Cultures","summary","IDSA 与 ESCMID 于 9 月 9 日发布金黄色葡萄球菌菌血症（SAB）最新共识声明第一部分，共含 7 条共识，覆盖风险分层、诊断评估及成人与儿童管理。其中共识声明 2 专门针对随访血培养问题给出建议。SAB 是血流感染的首要死因，常伴深部感染灶与转移灶，致残率较高。","reason","source",{"_61":71},"links",{"_57":70},"publishedAt","2026-09-28T19:13:37.363Z","discoveredAt","2026-10-29T13:59:54.039Z","timelineAt","category","policy","tags",[65,66,67,68,69],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","antibiotics","抗菌药物与耐药","政策/监管","抗菌药物","耐药与院感","抗感染","循证指南","https://www.contagionlive.com/view/idsa-escmid-statement-on-staphylococcus-aureus-follow-up-blood-cultures","Contagion Live·抗菌药物管理",{"_73":74,"_75":-5,"_76":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
