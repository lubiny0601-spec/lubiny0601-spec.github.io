[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":52,"_53":-5,"_54":35,"_55":56},"expiresAt",1794384605000,"id","p6hctxg9on4mfds3izzhg7mtd","title","CDE发布《抗肿瘤药物基于后线研究数据开展前线适应症临床试验技术指导原则》","originalTitle","summary","国家药监局药审中心10月23日发布《抗肿瘤药物基于后线研究数据开展前线适应症临床试验技术指导原则》（2026年第48号通告），自发布之日起施行。该指导原则旨在保障患者安全、确保试验设计科学严谨的前提下，为抗肿瘤药物基于后线研究数据向前线适应症推进的临床研发场景提供可参考的技术规范。","reason","source",{"_61":70},"links",{"_56":69},"publishedAt","2026-10-24T00:00:00.000Z","discoveredAt","2026-10-28T15:39:01.281Z","timelineAt","category","policy","tags",[67,64,68],"score",44,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":65,"_61":66},{"_60":63,"_61":64},{"_60":29,"_61":62},"slug","name","政策与监管","oncology","肿瘤","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-24/1109540.shtml","中国食品药品网·要闻",{"_72":73,"_74":-5,"_75":52},"changelogVersion","2026-10-08T08:00","release","staticSite"]
