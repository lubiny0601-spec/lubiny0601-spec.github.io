[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":52,"_53":-5,"_54":35,"_55":56},"expiresAt",1794384605000,"id","oqhvyt487lgk7aiymext5f8wf","title","黑龙江多措并举打通基层药品配备“最后一公里”","originalTitle","summary","黑龙江省医保部门联合卫健、中医药管理等部门出台系列举措，将社区卫生服务中心常用口服药品指导目录扩充至600种，并要求常态化配备不少于300种。乡镇卫生院和村卫生室分别明确常态化配药300种以上、100种以上的刚性标准。依托全省一体化医保信息平台，已累计推送医保药品结算数据12次、4000余条，并完成650种基层常用药品的医保支付属性标注。","reason","source",{"_60":66},"links",{"_56":67},"publishedAt","2026-10-24T00:00:00.000Z","discoveredAt","2026-11-09T06:26:15.536Z","timelineAt","category","policy","tags",[64,65,66],"score",38,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_59":62,"_60":63},{"_59":29,"_60":61},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/10/24/art_287_23315.html",{"_69":70,"_71":-5,"_72":52},"changelogVersion","2026-10-08T08:00","release","staticSite"]
