[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795410128000,"id","m18fbld381anso5v80xm1gb7x","title","赛诺菲 Infilbray 获 FDA 批准，成为 3 型戈谢病神经症状首个获批疗法","originalTitle","Sanofi gains FDA clearance for Gaucher disease pill","summary","赛诺菲每日一次口服药 Infilbray 获 FDA 批准，用于体重至少 15 公斤的成人和儿童 3 型戈谢病，成为该病神经症状的首个获批治疗。支撑获批的 III 期试验中，治疗一年与神经症状出现统计学显著改善相关。该药源自赛诺菲 2011 年收购 Genzyme，此前在帕金森病、Fabry 病等多项适应症中失败；处方信息含自杀念头与行为等警告，赛诺菲未披露定价。","reason","source",{"_65":75},"links",{"_58":74},"publishedAt","2026-11-19T17:17:00.000Z","discoveredAt","2026-11-23T04:24:56.277Z","timelineAt","category","approval","tags",[66,68,73,70],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","Delilah Alvarado","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","approvals","name","获批上市","rare-disease","罕见病","sanofi","赛诺菲","fda","美国 FDA","FDA","https://www.biopharmadive.com/news/sanofi-fda-infilbray-venglustat-approve-gaucher/875167/","BioPharma Dive",{"_77":78,"_79":-5,"_80":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
