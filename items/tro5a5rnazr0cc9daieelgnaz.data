[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795408365000,"id","tro5a5rnazr0cc9daieelgnaz","title","国家药监局批准信诺维1类创新药注射用亚胺西福上市，用于HABP/VABP","originalTitle","国家药监局批准注射用亚胺西福上市","summary","国家药监局批准苏州信诺维医药科技股份有限公司申报的1类创新药注射用亚胺西福（商品名：福诺凯）上市，适应症为医院获得性细菌性肺炎和呼吸机相关性细菌性肺炎（HABP/VABP）。该药适用于18岁及以上患者中由肺炎克雷伯菌、醋酸钙-鲍曼不动杆菌复合群、铜绿假单胞菌、流感嗜血杆菌、产气克雷伯菌、阴沟肠杆菌、大肠埃希菌、产酸克雷伯菌等敏感革兰阴性菌引起的HABP/VABP。","reason","亚胺西福获批用于HABP/VABP，覆盖肺炎克雷伯菌、鲍曼不动杆菌、铜绿假单胞菌等革兰阴性菌，为院内耐药菌感染补充了一个新选择。","source",{"_72":90},"links",{"_60":89},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-12T14:18:47.940Z","timelineAt","category","approval","tags",[73,82,83,84,85,86,87,88],"score",76,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fevf0HYYFdns","reportCount",2,"additionalSourceCount",1,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","approvals","name","获批上市","antibiotics","抗菌药物与耐药","nmpa","中国 NMPA",{"_79":80,"_13":81},"publicId","8531255f-1e27-4416-ab13-cc44c3acdff4","NMPA批准信诺维1类新药亚胺西福上市","抗菌药物","耐药与院感","NMPA","抗感染","管线上新","对销售","对准入","https://www.cnpharm.com/c/2026-11-12/1110391.shtml","中国食品药品网·要闻",{"_92":93,"_94":-5,"_95":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
