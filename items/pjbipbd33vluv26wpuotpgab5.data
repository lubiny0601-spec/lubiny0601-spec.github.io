[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794791088000,"id","pjbipbd33vluv26wpuotpgab5","title","和誉医药盐酸匹米替尼胶囊获FDA批准用于症状性腱鞘巨细胞瘤","originalTitle","和誉医药与默克宣布贝捷迈®（盐酸匹米替尼胶囊）获FDA批准用于治疗腱鞘巨细胞","summary","和誉医药自主研发的CSF-1R小分子抑制剂贝捷迈（盐酸匹米替尼胶囊）获FDA批准，用于系统性治疗手术切除可能导致功能受限加重或严重并发症的症状性腱鞘巨细胞瘤成年患者。","reason","材料给出FDA批准的适应症范围与III期MANEUVER研究终点数据，可据此判断该药在TGCT治疗中的位置。","source",{"_74":90},"links",{"_60":89},"publishedAt","2026-11-11T00:00:00.000Z","discoveredAt","2026-11-11T14:10:20.986Z","timelineAt","category","approval","tags",[75,81,79,77,88],"score",58,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","body","outline",[],"relatedStories",[84],"topics",[67,68,69,70,71],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fuNqR2TQwUPY","reportCount",1,"additionalSourceCount",0,{"_72":82,"_74":83},{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","approvals","name","获批上市","small-molecule","小分子","rare-disease","罕见病","oncology","肿瘤","fda","美国 FDA",{"_85":86,"_13":87},"publicId","cb3785d5-2c72-45ac-8381-47cb11342766","匹米替尼获FDA批准治疗症状性腱鞘巨细胞瘤","FDA","https://news.bioon.com/article/daf4963e948e.html","生物谷",{"_92":93,"_94":-5,"_95":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
