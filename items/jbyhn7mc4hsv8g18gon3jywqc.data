[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889549000,"id","jbyhn7mc4hsv8g18gon3jywqc","title","【山东】人工晶体集采降价惠及低保白内障患者，青岛西海岸新区赵女士双眼手术后自付600元","originalTitle","【山东】一枚“晶体”点亮光明之路 集采惠民守护“睛”彩人生","summary","青岛西海岸新区低保群众赵女士在医用耗材集采与医保报销政策支持下完成双眼白内障手术，个人仅自付600元。人工晶体集采后由近4000元降至900元左右，叠加基本医保支付与低保人群倾斜政策，整体花费大幅下降。术后赵女士视力恢复明显，可自主进食、扶墙慢行，家庭照护负担明显减轻。","reason","source",{"_70":83},"links",{"_59":86},"publishedAt","2026-10-28T00:00:00.000Z","discoveredAt","2026-10-28T15:38:58.441Z","timelineAt","category","policy","tags",[80,81,82,83,84,85],"score",12,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fhq-mYhqT2G0","reportCount",1,"additionalSourceCount",0,{"_69":74,"_70":75},{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","政策与监管","insurance","医保与集采","device-ivd","医疗器械与 IVD",{"_77":78,"_13":79},"publicId","a016427c-00da-49ee-a4a9-6aa86232cc59","集采人工晶体降价，青岛低保患者双眼手术自付600元","政策/监管","医保/集采","医疗器械/IVD","国家医保局","抗感染","市场准入","http://www.nhsa.gov.cn/art/2026/9/29/art_14_22386.html",{"_88":89,"_90":-5,"_91":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
