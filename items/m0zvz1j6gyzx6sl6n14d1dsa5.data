[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205955000,"id","m0zvz1j6gyzx6sl6n14d1dsa5","title","研究者重新审视80年前发现的streptothricin，以降低毒性并保留抗耐药革兰阴性菌活性","originalTitle","Back to the Future to Combat Today's \"Super Bugs\"","summary","研究者重新评估1942年发现的streptothricin，通过新型纯化技术去除毒性成分并保留杀菌活性。主要成分streptothricin F对碳青霉烯耐药肠杆菌和鲍曼不动杆菌有活性，在小鼠大腿感染模型中对表达NDM-1的泛耐药肺炎克雷伯菌显示显著疗效，体外和体内毒性至少比streptothricin D低10倍。","reason","source",{"_63":76},"links",{"_57":75},"publishedAt","2023-05-30T10:57:49.020Z","discoveredAt","2026-10-27T15:41:45.040Z","timelineAt","category","research","tags",[69,70,71,66,72,73,74],"score",18,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","small-molecule","小分子","antibiotics","抗菌药物与耐药","论文/研究","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://www.contagionlive.com/view/back-to-the-future-to-combat-today-s-super-bugs-","Contagion Live·医院感染",{"_78":79,"_80":-5,"_81":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
