[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793888174000,"id","aljrat2guocizibej058g7gyc","title","观点：为免费医疗移居欧洲后，我怀念美国的患者门户","originalTitle","Opinion: I moved to Europe for free health care. I miss my patient portal","summary","一位患多发性硬化症、乳腺癌并接受过半肝切除的美国患者，因担心联邦雇员医保前景，移居马耳他。她每周缴纳38欧元社保，约合每年2300美元，覆盖本人及药物，其中包括在美国年花费8万美元的药物。她怀念美国医院的患者门户，并指出马耳他公立保障就医、私立层级用现金换取速度与便利。","reason","source",{"_74":94},"links",{"_60":93},"publishedAt","2026-11-04T09:30:00.000Z","discoveredAt","2026-11-05T05:13:22.031Z","timelineAt","category","opinion","tags",[88,89,90,83,79,91,92],"score",8,"selected",false,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","Mariska Breland","body","outline",[],"relatedStories",[84],"topics",[67,68,69,70,71],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fWK0vf4fGUDA","reportCount",1,"additionalSourceCount",0,{"_72":82,"_74":83},{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","opinions","name","观点与解读","insurance","医保与集采","rare-disease","罕见病","neuroscience","神经与精神","oncology","肿瘤",{"_85":86,"_13":87},"publicId","8ea18a31-e8af-432c-9238-f0cdc8425bd0","美国患者移居马耳他后怀念患者门户","观点/解读","医保/集采","神经/精神","FDA","EMA","https://www.statnews.com/2026/11/04/moving-to-europe-free-health-care-differences/?utm_campaign=rss","STAT",{"_96":97,"_98":-5,"_99":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
