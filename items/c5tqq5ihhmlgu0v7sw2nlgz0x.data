[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795410125000,"id","c5tqq5ihhmlgu0v7sw2nlgz0x","title","观点：Kennedy 与 MAHA 运动如何助力终结麻疹","originalTitle","Opinion: How Kennedy and MAHA could help stop measles","summary","美国失去麻疹消除状态后，卫生部长 Robert F. Kennedy Jr. 表示将阻止麻疹传播并恢复消除状态，同时继续推荐 MMR 疫苗接种。文章提出可动员其参与建立的 MAHA  grassroots 运动来触达对疫苗犹豫的家庭。KFF 调查显示，86% 支持 MAHA 的家长认为社区儿童接种麻疹疫苗很重要，近八成对 MMR 疫苗安全性有信心。","reason","source",{"_71":82},"links",{"_60":81},"publishedAt","2026-11-21T09:30:00.000Z","discoveredAt","2026-11-23T04:24:56.279Z","timelineAt","category","opinion","tags",[79,80],"score",12,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Brinda Adhikari","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fT9hPBJQ4n9Y","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","opinions","name","观点与解读","infectious","感染与疫苗",{"_76":77,"_13":78},"publicId","23650baf-ab06-4af6-8054-af203dc80a1c","美国失去麻疹消除状态后 Kennedy 的表态","观点/解读","感染/疫苗","https://www.statnews.com/2026/11/21/rfk-jr-maha-measles-outbreak-elimination-status-promote-mmr-vaccine/?utm_campaign=rss","STAT",{"_84":85,"_86":-5,"_87":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
