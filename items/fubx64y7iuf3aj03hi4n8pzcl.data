[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795443794000,"id","fubx64y7iuf3aj03hi4n8pzcl","title","中国流感监测周报第934期：南北方流感阳性率上升，A(H1N1)pdm09占47.4%","originalTitle","2026年第45周第934期中国流感监测周报","summary","截至2026年11月8日的一周，南、北方省份流感病毒检测阳性率上升，全国检出阳性样本中A(H1N1)pdm09占47.4%、A(H3N2)占23.4%、B(Victoria)系占29.2%，共报告125起流感样病例暴发疫情。","reason","周报给出流感阳性率上升、毒株构成与耐药监测结果，可帮助判断当季抗流感药物的敏感性背景。","source",{"_72":88},"links",{"_60":87},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-12T14:18:53.258Z","timelineAt","category","research","tags",[82,83,84,85,86],"score",58,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fiXVsJQMowyQ","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","infectious","感染与疫苗",{"_79":80,"_13":81},"publicId","d7ea66ff-96d5-4e0a-9d75-da29cc9fd241","中国疾控发布第45周流感监测周报","论文/研究","感染/疫苗","耐药与院感","抗感染","循证指南","https://www.chinacdc.cn/jksj/jksj04_14249/202611/t20261111_1842933.html","中国疾控·流感监测周报",{"_90":91,"_92":-5,"_93":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
