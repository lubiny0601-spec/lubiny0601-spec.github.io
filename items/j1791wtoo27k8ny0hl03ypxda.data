[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889546000,"id","j1791wtoo27k8ny0hl03ypxda","title","步长制药赵菁出席2026“一带一路”媒体合作论坛，谈中医药国际化与健康丝绸之路","originalTitle","步长制药赵菁出席2026“一带一路”媒体合作论坛 共话丝路医药文明，助力健康丝绸之路建设","summary","步长制药副董事长赵菁出席11月3日在福州举办的2026“一带一路”媒体合作论坛，并作主旨报告分享中医药国际化实践。目前步长制药已有43个品种进入39个国家和地区，脑心通胶囊、稳心颗粒在印尼、马来西亚、新加坡完成注册销售，宣肺败毒颗粒在乌兹别克斯坦、哈萨克斯坦、蒙古国等注册上市。赵菁提出聚焦标准互认、布局绿色供应链、深化人才共育三点合作倡议。","reason","source",{"_71":82},"links",{"_59":81},"publishedAt","2026-11-04T10:45:03.000Z","discoveredAt","2026-11-05T05:16:11.339Z","timelineAt","category","industry","tags",[74,76,72],"score",8,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fqjqNNPuhTAM","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","trends","name","行业趋势","company-news","公司动态","tcm","中药",{"_78":79,"_13":80},"publicId","ef7defd9-62bc-4620-a21c-f945b735db0b","步长制药赵菁出席一带一路媒体合作论坛","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669472&idx=4&sn=d88738be09f43d7c7fcb9a12dd72fdce&chksm=bc7178f44542456975bdb9974e65d9999b03b781413752623a749549cc091e812492a68c09e1&scene=126&sessionid=1793855794#rd","赛柏蓝",{"_84":85,"_86":-5,"_87":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
