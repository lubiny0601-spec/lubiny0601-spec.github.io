[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795408368000,"id","sjbxnnemrbkr4d3edsf0z35kc","title","丹麦医院中耐万古霉素肠球菌如何演化：ITQB NOVA 解析 VREfm ST80 的兴衰机制","originalTitle","How Vancomycin-Resistant Enterococcus Evolved in a Danish Hospital","summary","葡萄牙 ITQB NOVA 团队对丹麦 9 家医院 2012–2020 年收集的 334 株 vanA 型 VREfm ST80 分离株（83% 定植、17% 感染）做全基因组测序与系统发育分析，发现亚簇 1.A 在 2012–2015 年占 72%，2016–2020 年分离株分散于全部亚簇、多样性上升。","reason","source",{"_63":74},"links",{"_58":73},"publishedAt","2026-11-13T20:02:36.000Z","discoveredAt","2026-11-16T00:55:16.766Z","timelineAt","category","research","tags",[67,68,69,70,71,72],"score",20,"selected",false,"channel","news","story","x","readingMode","full","author","Julianna LeMieux, PhD","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","论文/研究","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://www.genengnews.com/topics/infectious-diseases/how-vancomycin-resistant-enterococcus-evolved-in-a-danish-hospital/","GEN Genetic Engineering & Biotechnology News",{"_76":77,"_78":-5,"_79":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
