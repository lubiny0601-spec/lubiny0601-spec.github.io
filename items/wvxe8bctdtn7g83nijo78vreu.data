[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384588000,"id","wvxe8bctdtn7g83nijo78vreu","title","库克县225例回顾性研究：1个月1HP方案（异烟肼+利福喷丁）治疗潜伏性结核完成率与标准方案相当","originalTitle","Treatment of Latent Tuberculosis in a Trice","summary","库克县卫生局3家诊所225例潜伏性结核感染患者的回顾性研究显示，1个月1HP方案（异烟肼300 mg每日+利福喷丁300-600 mg）完成治疗率64%，与其他标准方案72%相当（P=0.460）。1HP组不良事件发生率41%，其他方案25%（P=0.107），仅1例因不良事件停药。研究者认为该短程方案耐受性良好，或可成为可行的更短替代方案。","reason","source",{"_63":76},"links",{"_57":75},"publishedAt","2026-09-12T09:45:12.697Z","discoveredAt","2026-10-27T15:41:44.442Z","timelineAt","category","research","tags",[69,70,71,72,73,74],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","infectious","感染与疫苗","论文/研究","感染/疫苗","抗菌药物","抗感染","循证指南","对品牌","https://www.contagionlive.com/view/treatment-of-latent-tuberculosis-in-a-trice","Contagion Live·抗菌药物管理",{"_78":79,"_80":-5,"_81":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
