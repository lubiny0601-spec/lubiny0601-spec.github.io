[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408366000,"id","eqijgd0k4x9fdf783k381gm4o","title","吸药怕量不够、吸不动气怎么挑装置？杨汀：一块黑布可自测，训练哨能选装置","originalTitle","吸药总怕量不够？吸不动气怎么挑装置？一个小哨子就能测！","summary","中日医院杨汀介绍，用一块干燥薄黑布盖住干粉吸入器吸嘴吸气，布面出现白色粉末颗粒说明药物已释放且吸力足够，布面干净则需排查吸力不足、装药错误或装置故障。该法主要适用于信必可都保、舒利迭准纳器等干粉吸入器，对压力定量气雾剂参考价值有限。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-15T10:33:39.000Z","discoveredAt","2026-11-16T01:00:41.479Z","timelineAt","category","opinion","tags",[81,76,82],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fCcBRfZdgS6U","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","opinions","name","观点与解读","device-ivd","医疗器械与 IVD","respiratory","呼吸",{"_78":79,"_13":80},"publicId","83d48707-c1c5-45bd-bd17-0e87f3eb6dc1","杨汀介绍干粉吸入器自测与选装置方法","观点/解读","医疗器械/IVD","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604843&idx=2&sn=fd03bdbd84d9a1659bef8d275813afb3&chksm=fcd537cef0e111812610df0f67dde953cf036ec50d01040bf1591ebd4648298a37ec2a1ab082&scene=126&sessionid=1794790833#rd","呼吸界",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
