[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384583000,"id","b78kh7xzwkpoy7ozjturm9576","title","3家药企注销《药品经营许可证》；12起严重学术造假被查处；云南35个药最高降幅81%","originalTitle","3家药企“退场”；12起严重学术造假被查处；35个药“大杀价”…","summary","甘肃省药监局11月3日公告依法注销甘肃裕康药业等3家企业《药品经营许可证》，原因均为有效期届满未申请重新审查发证。国家卫健委11月5日通报第六批涉\"论文工厂\"严重学术造假调查结果，共12起，主要责任人来自多家医院。同日云南省药品集中采购平台公示35个药品企业申请降价，最高降幅81%。","reason","source",{"_63":76},"links",{"_57":75},"publishedAt","2026-11-08T11:01:13.000Z","discoveredAt","2026-11-09T06:31:25.456Z","timelineAt","category","industry","tags",[66,64,69,70,71,72,73,74],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","trends","name","行业趋势","company-news","公司动态","insurance","医保与集采","NMPA","石药集团","海正药业","医保/集采","抗感染","企业竞争","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669799&idx=2&sn=5cc972bfe9ad6f4a301aa60d65b0c68a&chksm=bcc8896a4bd3691bb77c8d4a3fe2230588d9995763229c64ba0fad89e103a78b14175aeba326&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_78":79,"_80":-5,"_81":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
