[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794384582000,"id","k9ikqiralh5w95f28tr07kefz","title","中国流感监测周报第933期：北方阳性率上升，甲流占65.4%","originalTitle","2026年第44周第933期中国流感监测周报","summary","中国疾控发布2026年第44周流感监测周报，截至11月1日，南方省份流感病毒检测阳性率略有下降、北方省份上升，全国检出阳性样本中甲型占65.4%、乙型占34.6%，共报告106起流感样病例暴发疫情。","reason","周报给出南北省份阳性率分化、甲乙流构成与毒株抗原性、耐药监测结果，可作为流感季用药与疫苗匹配判断的当期依据。","source",{"_64":76},"links",{"_58":75},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-09T06:32:44.661Z","timelineAt","category","research","tags",[70,71,72,73,74],"score",55,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","infectious","感染与疫苗","论文/研究","感染/疫苗","耐药与院感","抗感染","循证指南","https://www.chinacdc.cn/jksj/jksj04_14249/202611/t20261105_1842732.html","中国疾控·流感监测周报",{"_78":79,"_80":-5,"_81":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
