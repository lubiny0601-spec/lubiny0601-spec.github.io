[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791091000,"id","wbg8a4fcdvs28t4hpauin1g22","title","赛柏蓝11月26-27日广州举办医药营销全场景AI技能包搭建与人机协同实战班","originalTitle","医药营销全场景AI技能包搭建与人机协同实战班「11月26-27日 广州」","summary","赛柏蓝定于11月26-27日在广州举办医药营销全场景AI技能包搭建与人机协同实战班，联合多位医药营销场景化AI教练开发十大核心场景实用技能。课程基于东阳光集团、康美药业、1药网、海王星辰、叮当快药等企业部署腾讯WorkBuddy企业版的实践，覆盖药品审评报告提取、仓储扫码、药品对码、智能选品等场景。课程另设AI转型方法论、企业版深度解析、可链接的知识库、案例与落地路线图四个专题。","reason","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-12T07:28:06.000Z","discoveredAt","2026-11-12T14:33:19.922Z","timelineAt","category","industry","tags",[75,70],"score",8,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fzF_Sv9yNRZg","reportCount",2,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","trends","name","行业趋势",{"_72":73,"_13":74},"publicId","1b3c5ba5-8601-4884-b3d6-05dbb501cb35","赛柏蓝广州办WorkBuddy医药营销实战班","其他","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670439&idx=4&sn=808a69d2778a9f4d65c7f4d4f1d23d1f&chksm=bcde2e0fcf90bd8befdb771817f13c2ed7c53b5c2bd396ab69021fcd8d1f3393e284fd41ee62&scene=126&sessionid=1794493868#rd","赛柏蓝",{"_79":80,"_81":-5,"_82":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
