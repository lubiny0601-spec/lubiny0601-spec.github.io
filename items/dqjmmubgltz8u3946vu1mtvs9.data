[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":55,"_56":35,"_57":58},"expiresAt",1793888185000,"id","dqjmmubgltz8u3946vu1mtvs9","title","国家药监局公布暖宫七味散等9个品种转换为非处方药","originalTitle","summary","国家药监局10月29日公告，暖宫七味散、红花逍遥片、痔特佳胶囊、唇齿清胃丸、儿童咳颗粒、人知降糖胶囊、红药胶囊、调经活血胶囊和排毒养颜片9个品种由处方药转换为非处方药，品种名单及非处方药说明书范本一并发布。相关药品上市许可持有人须于2027年7月26日前就修订说明书事项向省级药品监督管理部门备案，并通知相关医疗机构、药品经营企业等单位。","reason","source",{"_69":82},"links",{"_58":81},"publishedAt","2026-10-29T00:00:00.000Z","discoveredAt","2026-10-29T13:59:53.521Z","timelineAt","category","policy","tags",[79,80,72],"score",36,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body","outline",[],"relatedStories",[75],"topics",[65,66,67],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","f1_jHrjwnY-Y","reportCount",1,"additionalSourceCount",0,{"_68":73,"_69":74},{"_68":71,"_69":72},{"_68":29,"_69":70},"slug","name","政策与监管","tcm","中药","nmpa","中国 NMPA",{"_76":77,"_13":78},"publicId","3e963019-8f93-487c-b414-beb177919a9a","药监局公告9品种转非处方药","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-29/1109677.shtml","中国食品药品网·要闻",{"_84":85,"_86":-5,"_87":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
