[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443805000,"id","rqtkw1ihf4gnbdzvt3e035s3a","title","每周医药看点（11月9日—15日）：2026版医保目录新增107种药品、商保创新药目录新增12种药品","originalTitle","每周医药看点（11月9日—15日）","summary","国家医保局、人力资源和社会保障部发布2026年版国家医保药品目录与商保创新药目录，前者新增107种药品（含51个1类创新药），后者新增12种药品，均自2027年1月1日起执行。国家卫生健康委等四部门发文明确1类新药不计入\"一品两规\"，且不纳入门诊基本药物处方占比等绩效监测指标。和誉医药盐酸匹米替尼胶囊获FDA批准上市，用于症状性腱鞘巨细胞瘤成年患者。","reason","source",{"_61":71},"links",{"_57":70},"publishedAt","2026-11-20T00:00:00.000Z","discoveredAt","2026-11-23T04:24:52.556Z","timelineAt","category","policy","tags",[65,66,67,68,69],"score",40,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","NMPA","恒瑞医药","https://www.cnpharm.com/c/2026-11-20/1111041.shtml","中国食品药品网·要闻",{"_73":74,"_75":-5,"_76":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
