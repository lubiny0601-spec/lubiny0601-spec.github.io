[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794791089000,"id","mdkapanypwnwalqpbsjbkk54f","title","国家卫健委印发罕见病目录制订工作程序（2026年版）","originalTitle","卫健委印发罕见病目录制订工作程序（2026年版）","summary","国家卫生健康委、国家中医药局印发《罕见病目录制订工作程序（2026年版）》，自印发之日起施行，2018年版同时废止。病种纳入需同时满足发病率或患病率较低、对患者和家庭危害较大、有明确诊断方法、有治疗或干预手段等四项条件，目录分批遴选并动态更新。国家有关部门、省级卫生健康行政部门、国家级行业学会或协会等可提出增加病种申请，经专家委员会论证和征求意见后公布。","reason","新版程序明确了病种纳入的四项条件与申报主体范围，读者可据此判断哪些罕见病有机会进入目录。","source",{"_62":68},"links",{"_58":67},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-11T14:04:23.294Z","timelineAt","category","policy","tags",[66,65],"score",55,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","rare-disease","罕见病","政策/监管","https://www.cnpharm.com/c/2026-11-09/1110153.shtml","中国食品药品网·要闻",{"_70":71,"_72":-5,"_73":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
