[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795410130000,"id","udohhsd9mjlxxlf1lsb1cwxu8","title","阿米巴肝脓肿经门静脉播散致化脓性门静脉血栓及感染性心内膜炎一例","originalTitle","A Portal–Systemic Infectious Cascade: Invasive Amoebiasis Leading to Septic Portal Vein Thrombosis and Endocarditis","summary","一名67岁男性在秘鲁亚马逊河游泳约5个月后出现每日发热寒战，最终诊断为溶组织内阿米巴肝脓肿、门静脉炎、多重菌血症及二尖瓣感染性心内膜炎。腹部CT和MRI显示门静脉血栓伴右肝小病灶，血培养先后检出Bacteroides fragilis与Streptococcus anginosus，经食管超声见二尖瓣后叶约0.5 cm活动性回声团。","reason","source",{"_63":76},"links",{"_57":75},"publishedAt","2026-11-10T15:29:18.333Z","discoveredAt","2026-11-23T04:24:53.381Z","timelineAt","category","research","tags",[69,70,71,72,73,74],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","infectious","感染与疫苗","论文/研究","感染/疫苗","抗菌药物","抗感染","循证指南","对品牌","https://www.contagionlive.com/view/a-portal-systemic-infectious-cascade-invasive-amoebiasis-leading-to-septic-portal-vein-thrombosis-and-endocarditis","Contagion Live·抗菌药物管理",{"_78":79,"_80":-5,"_81":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
