[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794384581000,"id","gd3mphdbgx3r4poc6o5rt2opp","title","九芝堂三季度单季利润增近6倍，陇神戎发单季亏损超千万","originalTitle","同是中药企业，一家利润暴增近6倍，另一家","summary","九芝堂前三季净赚3个多亿，三季度单季利润翻了近6倍；陇神戎发前三季营收下降近28%，三季度单季亏损1000多万，扣非净利润仅7万多。文章将分化归因于集采与医保控费压缩价格空间，临床价值证据不足的中药注射剂、辅助用药进院变难，并提到九芝堂以3.1亿收购吉象隆切入多肽赛道、陇神戎发九成收入依赖两个独家品种且销售费用削减三分之一。","reason","两家同处中药板块的企业三季报分化，对照出集采控费下独家品种与循证、并购路径的差别。","source",{"_66":76},"links",{"_59":75},"publishedAt","2026-11-09T02:10:18.000Z","discoveredAt","2026-11-09T06:30:50.608Z","timelineAt","category","industry","tags",[69,73,74,67],"score",47,"selected",true,"channel","news","story","x","readingMode","full","author","点苍鹤","body","outline",[],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","trends","name","行业趋势","company-news","公司动态","market","市场与销售","tcm","中药","市场/销售","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699512&idx=1&sn=5269ad3b53d3cd612bb7fe2f3e4d446e&chksm=bc2e21ff54a2c3f3c57152eef319f4aeb10c72410491af288b92138b70ac509e8f81b95cb003&scene=126&sessionid=1794205837#rd","医药云端工作室",{"_78":79,"_80":-5,"_81":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
