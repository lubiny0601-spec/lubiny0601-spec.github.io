[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384584000,"id","pw6ucp2922s9vr0aj4z2srgo9","title","国家药监局副局长雷平率队赴上海参加第九届进博会","originalTitle","雷平率队赴上海参加第九届进博会","summary","国家药监局党组成员、副局长雷平于11月4日—6日率队参加第九届中国国际进口博览会，出席开幕式及由国家药监局和虹桥论坛秘书处主办的第九届虹桥国际经济论坛\"国际药品安全治理与中国药品监管改革\"分论坛并致辞。雷平表示，国家药监局着力统筹发展与安全、质量与效率、监管与服务，欢迎各国医药企业将全球医药创新成果第一时间引入中国，并支持中国优质药械走向世界。","reason","source",{"_61":68},"links",{"_57":67},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-09T06:26:07.587Z","timelineAt","category","policy","tags",[65,66],"score",18,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-07/1110086.shtml","中国食品药品网·要闻",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
