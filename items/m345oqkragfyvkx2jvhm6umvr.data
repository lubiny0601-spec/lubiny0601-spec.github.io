[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794791088000,"id","m345oqkragfyvkx2jvhm6umvr","title","中国疾控发布2026年第45周全国急性呼吸道传染病哨点监测：流感病毒阳性率18.8%","originalTitle","全国急性呼吸道传染病哨点监测情况（2026年第45周）","summary","中国疾控发布2026年第45周（11月2日—11月8日）全国急性呼吸道传染病哨点监测结果，216家多病原监测哨点医院门急诊流感样病例呼吸道样本阳性率前三位为流感病毒18.8%、鼻病毒10.9%、人偏肺病毒5.4%，住院严重急性呼吸道感染病例为鼻病毒10.2%、流感病毒6.6%、人偏肺病毒5.6%。","reason","疾控周报给出流感病毒阳性率18.8%及A(H1N1)占比上升的南北差异，可据此判断冬春季呼吸道用药需求的走向。","source",{"_72":85},"links",{"_60":84},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-12T14:18:54.849Z","timelineAt","category","research","tags",[82,83,75],"score",62,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fygflUSHcr-Y","reportCount",2,"additionalSourceCount",1,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","papers","name","论文研究","respiratory","呼吸","infectious","感染与疫苗",{"_79":80,"_13":81},"publicId","0488cfb2-80d0-444a-aef8-f14e4fa1fd68","中国疾控发布第45周急性呼吸道传染病监测","论文/研究","感染/疫苗","https://www.chinacdc.cn/jksj/jksj04_14275/202611/t20261112_1842956.html","中国疾控·急性呼吸道传染病哨点监测",{"_87":88,"_89":-5,"_90":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
