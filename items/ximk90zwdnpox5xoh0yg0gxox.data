[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384588000,"id","ximk90zwdnpox5xoh0yg0gxox","title","骨科感染清创联合植入抗生素后，短期全身抗生素不劣于标准疗程","originalTitle","Implanted Antibiotic Reduced Systemic Regimen for Orthopedic Infection","summary","一项475例患者的多中心开放标签非劣效试验显示，骨科感染患者清创并植入抗生素后，接受短期（≤7天）全身抗生素治疗在12个月治疗失败率上不劣于标准疗程（≥4周），失败率分别为11.1%和14.1%，达到预设10%差异的非劣效标准。","reason","source",{"_61":70},"links",{"_57":69},"publishedAt","2026-09-23T14:34:04.408Z","discoveredAt","2026-10-27T15:41:44.409Z","timelineAt","category","clinical","tags",[62,65,66,67,68],"score",26,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","临床进展","antibiotics","抗菌药物与耐药","抗菌药物","抗感染","循证指南","对品牌","https://www.contagionlive.com/view/implanted-antibiotic-reduced-systemic-regimen-for-orthopedic-infection","Contagion Live·抗菌药物管理",{"_72":73,"_74":-5,"_75":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
