[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795408387000,"id","zngq5eddgu8u41n2dxqps4qy9","title","国家卫生健康委等发布《罕见病目录制订工作程序（2026年版）》","originalTitle","罕见病目录制订工作程序迎来修订","summary","国家卫生健康委、国家中医药局于11月4日联合发布《罕见病目录制订工作程序（2026年版）》，对2018年版进行修订。纳入病种的第四项条件增加“具有较高的预防筛查、科研价值”情形，申请主体新增国家医学中心和国家临床医学研究中心，并优化了目录更新周期。2018年以来两批目录共纳入207种罕见病。","reason","修订放宽了罕见病目录的纳入情形与申请主体，读者可据此判断哪些病种和机构更容易进入目录。","source",{"_62":68},"links",{"_58":67},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-11T14:04:23.283Z","timelineAt","category","policy","tags",[66,65],"score",51,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","rare-disease","罕见病","政策/监管","https://www.cnpharm.com/c/2026-11-09/1110151.shtml","中国食品药品网·要闻",{"_70":71,"_72":-5,"_73":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
