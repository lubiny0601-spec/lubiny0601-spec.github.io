[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205955000,"id","btnzhl5cqe94nyqzoy5uf9otw","title","非达霉素与口服甲硝唑治疗医疗相关CDI疗效相当，但甲硝唑组一线换药率更高","originalTitle","2 Antibiotics Show Similar Efficacy for Healthcare-Associated Infection","summary","一项回顾性队列研究纳入105例艰难梭菌感染（CDI）患者，比较非达霉素（n=30）与口服甲硝唑（n=75）的疗效，两组全球治愈率（70.0% vs 53.3%；P=.12）与临床治愈率（86.7% vs 78.7%；P=.35）均无显著差异。","reason","source",{"_62":73},"links",{"_57":72},"publishedAt","2023-09-27T14:23:19.437Z","discoveredAt","2026-10-27T15:41:44.989Z","timelineAt","category","research","tags",[66,67,68,69,70,71],"score",30,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","论文/研究","抗菌药物","耐药与院感","抗感染","循证指南","对品牌","https://www.contagionlive.com/view/2-antibiotics-show-similar-efficacy-for-healthcare-associated-infection","Contagion Live·医院感染",{"_75":76,"_77":-5,"_78":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
