[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794384583000,"id","e7k78qhoqentb3hu5vjwkb30o","title","283家A股药企前三季度研发费用出炉：恒瑞、复星、百利天恒领跑","originalTitle","283家头部药企研发费用来了，恒瑞、复星、百利天恒领跑","summary","截至2026年11月8日，283家A股上市医药企业披露2026年前三季度研发费用合计543.04亿元，同比增长1.41%。恒瑞医药、复星医药、百利天恒分别以54.23亿元、31.18亿元、20.45亿元位列前三，百利天恒研发费用率达97.69%。化学制药是三类行业中唯一研发费用实现增长的板块，160家企业平均2.17亿元，同比增长2.84%。","reason","source",{"_65":78},"links",{"_58":77},"publishedAt","2026-11-08T11:01:13.000Z","discoveredAt","2026-11-09T06:31:22.171Z","timelineAt","category","industry","tags",[68,72,70,73,74,75,76,66],"score",40,"selected",false,"channel","news","story","x","readingMode","full","author","晓琳","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","trends","name","行业趋势","company-news","公司动态","fosun","复星医药","hengrui","恒瑞医药","君实生物","石药集团","智飞生物","华润医药","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669799&idx=1&sn=dde1ac5a83e03721898146f10d095bae&chksm=bcd8fb849f52b106255dc3f6abd29a3c80f0a40e280a6a4103bfe1dbd50640ed27c7e5a88a1f&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_80":81,"_82":-5,"_83":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
