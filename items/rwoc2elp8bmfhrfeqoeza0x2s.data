[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443809000,"id","rwoc2elp8bmfhrfeqoeza0x2s","title","萍乡医保外配处方试点：手机复诊开方、药店比价报销少跑腿","originalTitle","【江西】慢病买药报销如何少跑腿？医保外配处方给出便民新答案","summary","萍乡市自2026年6月上线医保复诊开方服务以来，累计开出医保电子处方3.5万余张，3万余名慢病患者实现线上复诊、就近购药报销。患者可通过萍乡医保通微信小程序发起复诊开方，医师线上接诊到开出处方约5分钟，病情稳定者可开长期用药处方。当地药品比价小程序已连通全市530余家定点药店库存价格信息，支持拍照扫码查药与多药筛选。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-11-16T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.270Z","timelineAt","category","policy","tags",[65,66,67],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/11/art_14_23352.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
