[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384583000,"id","w8jj3ve16fruym7rdrw966pgl","title","蓝亭叙2026第15届医药健康互联网大会11月28-29日杭州召开，聚焦药企电商与医生IP","originalTitle","医药营销老兵，不会卖药了","summary","蓝亭叙2026-第15届医药健康互联网大会将于11月28-29日在杭州举行，针对药企线上流量贵、ROI低、私域IP合规受限等营销痛点设置议程。大会邀请京东健康分享AI与O2O玩法，哈药、德开等年销过亿爆品操盘手现场交底，并设医生IP打造、医疗短剧带货专场及平台与私域IP辩论。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-08T11:01:13.000Z","discoveredAt","2026-11-09T06:31:31.122Z","timelineAt","category","industry","tags",[71,78,79],"score",8,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fprfJgyaonR0","reportCount",3,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","trends","name","行业趋势","market","市场与销售",{"_75":76,"_13":77},"publicId","fc8ce772-0c1b-487e-bdbe-1be471cae4a6","赛柏蓝11月在杭州办医药健康互联网大会","市场/销售","哈药股份","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669799&idx=4&sn=b202c07f79a4b25b1f931417fcdbca3a&chksm=bcdcba02c60329a4ca9805ce6f8644ab6c6731d860538b758c7e3c55157d665fa1ac67339e84&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
