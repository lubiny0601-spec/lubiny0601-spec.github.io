[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888185000,"id","ejkj2ytnzk28k7wuw9bedyp4r","title","第十一届中国药物警戒大会在苏州召开，国家药监局副局长雷平出席并致辞","originalTitle","第十一届中国药物警戒大会召开","summary","10月29日，第十一届中国药物警戒大会在苏州召开，国家药监局党组成员、副局长雷平出席并致辞，指出药械警戒制度体系不断完善、监测评价能力显著增强、风险信号处置有力有效。两院院士围绕监管科学助力生物药创新发展、纳米技术医药产品创新与监管、微创器械创新发展作大会报告，药品监管司、器械监管司有关领导作药品医疗器械监管改革政策解读。","reason","source",{"_69":80},"links",{"_59":79},"publishedAt","2026-10-30T00:00:00.000Z","discoveredAt","2026-10-30T14:58:45.910Z","timelineAt","category","policy","tags",[77,78],"score",12,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","feRhvjX_-F0g","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","nmpa","中国 NMPA",{"_74":75,"_13":76},"publicId","59be6e08-cb6f-4a5d-b9cc-0dc274823d8c","第十一届中国药物警戒大会在苏州召开","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-30/1109737.shtml","中国食品药品网·要闻",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
