[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795408365000,"id","m8yxhluifdxx2eo4404i03yyk","title","NMPA通过优先审评批准芮弗西拜单抗注射液（皮下注射）上市，用于HoFH","originalTitle","国家药监局批准芮弗西拜单抗注射液（皮下注射）上市","summary","国家药监局通过优先审评审批程序批准北京盛迪医药有限公司申报的芮弗西拜单抗注射液（皮下注射）（商品名：艾轻达）上市，可与低脂饮食和其他降脂药物合用，用于治疗成人和12岁及以上青少年的纯合子型家族性高胆固醇血症（HoFH），以降低LDL-C水平。该品种为相关患者提供了新的治疗选择。","reason","原文交代了获批适应症与优先审评通道，读者可据此判断该药在HoFH降脂治疗中的定位。","source",{"_73":87},"links",{"_60":86},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-12T14:18:47.930Z","timelineAt","category","approval","tags",[74,76,78,85],"score",52,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body","outline",[],"relatedStories",[81],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","floEY3yKD4ek","reportCount",2,"additionalSourceCount",1,{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","approvals","name","获批上市","rare-disease","罕见病","cardiovascular","心血管","nmpa","中国 NMPA",{"_82":83,"_13":84},"publicId","1ab8ad67-7172-4172-b418-4b3d8e6f4dc1","NMPA批准首款ANGPTL3单抗皮下注射剂上市","NMPA","https://www.cnpharm.com/c/2026-11-12/1110389.shtml","中国食品药品网·要闻",{"_89":90,"_91":-5,"_92":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
