[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794205949000,"id","ktbh2ub9smbwo1e3zimp90zf0","title","全国首个省级医保病理云集采征求意见：重庆设15元/人次限价、5年采购周期","originalTitle","全国首个！「新型集采」来了","summary","重庆市医保局就全国首个省级医保病理云（数字切片）服务集采公开征求意见，设置15元/人次最高投标限价，采购周期5年。评标总分100分中价格仅占10分、技术占60分、商务占30分，报价低于限价80%须提交成本合理性证明，否则否决投标。履约期每12个月考核一次，不达标企业有3个月整改窗口，整改期满仍不达标即终止资格。","reason","source",{"_71":88},"links",{"_60":87},"publishedAt","2026-10-26T11:34:42.000Z","discoveredAt","2026-10-27T14:00:37.210Z","timelineAt","category","policy","tags",[81,82,83,84,85,86],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","赛柏蓝","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fqLqELMhQ0hA","reportCount",1,"additionalSourceCount",0,{"_70":75,"_71":76},{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","政策与监管","insurance","医保与集采","device-ivd","医疗器械与 IVD",{"_78":79,"_13":80},"publicId","d3aa0f9a-31fb-42c4-8001-6e20f17b184a","重庆医保局就病理云集采招标文件征求意见","政策/监管","医保/集采","医疗器械/IVD","国家医保局","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653668223&idx=4&sn=97bc26b7fbef67b557db2d8f5546bdc7&chksm=bc79a82ee17b4c3fd25ddbc3cb8aa4c5d82e651a5f9e85436d31e61986f3dd9e491af4f7f4d4&scene=126&sessionid=1793107872#rd","手动推送",{"_90":91,"_92":-5,"_93":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
