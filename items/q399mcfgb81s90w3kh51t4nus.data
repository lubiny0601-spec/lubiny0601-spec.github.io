[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793888176000,"id","q399mcfgb81s90w3kh51t4nus","title","江苏牵头部分化学药品省际联盟集采启动产品信息维护，9月30日至10月15日申报","originalTitle","关于开展部分化学药品省际联盟集采产品信息维护工作的通知","summary","江苏牵头、全国各省及新疆生产建设兵团参与的“部分化学药品省际联盟（江苏）集中带量采购联盟”启动产品信息维护，企业须在2026年9月30日至10月15日17时通过江苏省药品和医用耗材招采管理系统填报企业资质、药品注册批件、产能、挂网价格及省级集采中选价格等信息。","reason","江苏牵头的省际联盟化学药品集采启动产品信息维护，企业可据此判断参与报量与报价的时间窗口。","source",{"_62":72},"links",{"_58":71},"publishedAt","2026-09-30T00:00:00.000Z","discoveredAt","2026-10-27T16:04:45.492Z","timelineAt","category","policy","tags",[66,67,68,69,70],"score",72,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","抗感染","市场准入","http://ybj.jiangsu.gov.cn/art/2026/9/30/art_85505_11837069.html","江苏医保局·阳光采购服务网",{"_74":75,"_76":-5,"_77":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
