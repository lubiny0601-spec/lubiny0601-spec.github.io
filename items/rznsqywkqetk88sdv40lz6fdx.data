[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791092000,"id","rznsqywkqetk88sdv40lz6fdx","title","第12批集采落地、普药被削薄，牛黄清火丸凭准独家规格与医保乙类中标价50.34元招商","originalTitle","集采把普药一层层削薄， 清火类里，准独家反而更安全","summary","第12批集采全国落地、挂网规则收紧，同质化普药利润被层层削薄，牛黄清火丸以3g×6丸大蜜丸准独家规格切入清火品类。该品为医保乙类，中标价50.34元，公立、基层与零售均可进入，功能主治为清热、散风、解毒，用于肝胃肺蕴热引起的头晕目眩、口鼻生疮、风火牙疼、咽喉肿痛等。目前全国空白区域正在招商。","reason","source",{"_71":88},"links",{"_59":87},"publishedAt","2026-11-10T11:54:18.000Z","discoveredAt","2026-11-11T08:18:28.781Z","timelineAt","category","industry","tags",[81,76,82,83,84,85,86],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fjlzKBGYRy0M","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","market","name","市场与销售","insurance","医保与集采","tcm","中药",{"_78":79,"_13":80},"publicId","cef27069-d8ce-411f-916e-ad8bdb4e66ea","赛柏蓝招商牛黄清火丸准独家规格","市场/销售","医保/集采","抗感染","市场准入","对销售","对市场","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670067&idx=8&sn=b1df4be2c31263c7813b28fa0c555242&chksm=bc0d4f45d161df1fa4405a50979a0a77962df2665f048536dd43eee9f0d6c7034e2a1f2a66b8&scene=126&sessionid=1794384945#rd","赛柏蓝",{"_90":91,"_92":-5,"_93":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
