[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794384602000,"id","w93qhyfbqki9yidnocdw3ty4m","title","国家药监局批准拜耳阿舒克森片上市，用于降低缺血性卒中及高风险TIA患者卒中风险","originalTitle","国家药监局批准阿舒克森片上市","summary","国家药监局通过优先审评审批程序批准Bayer AG申报的1类创新药阿舒克森片（商品名舒华博）上市，用于降低缺血性卒中或高风险短暂性脑缺血发作（TIA）成人患者的卒中风险，不包括心源性栓塞型卒中患者。该药为患者提供了新的治疗选择。","reason","原文交代了获批适应症与优先审评通道，读者可据此判断该药在卒中二级预防中的定位。","source",{"_72":85},"links",{"_60":84},"publishedAt","2026-10-26T00:00:00.000Z","discoveredAt","2026-10-27T13:29:45.248Z","timelineAt","category","approval","tags",[73,75,82,83],"score",60,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fSmdWcNoCp8s","reportCount",2,"additionalSourceCount",1,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","approvals","name","获批上市","cardiovascular","心血管","nmpa","中国 NMPA",{"_79":80,"_13":81},"publicId","4cfd49b3-d310-431d-8ebc-ab66339b5de9","国家药监局批准拜耳阿舒克森片上市","拜耳","NMPA","https://www.cnpharm.com/c/2026-10-26/1109445.shtml","中国食品药品网·要闻",{"_87":88,"_89":-5,"_90":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
