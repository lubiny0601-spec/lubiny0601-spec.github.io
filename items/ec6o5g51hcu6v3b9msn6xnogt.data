[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793888176000,"id","ec6o5g51hcu6v3b9msn6xnogt","title","颅内手术感染危险因素研究：传统\"三大管\"未入列，预测模型效能0.745丨SIFIC2026·壁报交流","originalTitle","颅内手术感染，传统三大管竟不是危险因素？丨SIFIC2026·壁报交流","summary","郑州人民医院刘琛基于2020年至2025年颅内手术患者数据发现，术前存在感染、引流管天数、术后腰椎穿刺是术后感染的独立危险因素，而呼吸机、中心静脉置管、泌尿道置管\"三大管\"未入列。研究显示引流管留置7至14天风险占比最高，预测模型效能为0.745。湘雅医院李春辉点评建议开展多中心大样本研究以提升预测效能。","reason","source",{"_63":73},"links",{"_58":72},"publishedAt","2026-10-23T11:19:00.000Z","discoveredAt","2026-10-27T13:41:22.279Z","timelineAt","category","research","tags",[67,68,69,70,71],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","SIFIC团队","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","论文/研究","耐药与院感","抗感染","循证指南","对市场","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200215&idx=1&sn=acde445fb46f85f9d101850f4dc1fb81&chksm=824c3b29d5be48071ad8cd3d3cbe5d52258f08e49ef68ca14ac561bb34c6c9e63e76cad2f3fc&scene=126&sessionid=1793108467#rd","SIFIC 感染视界",{"_75":76,"_77":-5,"_78":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
