[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384585000,"id","ymmes537krjs1bi4duyxwtrgv","title","中疾控传染病所与北京地坛医院联合发文：Q热和立克次体病或为不明原因发热中被低估的重要病因","originalTitle","中疾控传染病所、北京地坛医院团队联合发文：“Q热和立克次体病”可能是不明原因发热患者中被长期低估的重要病因","summary","中国疾控中心传染病所与北京地坛医院团队基于2021年12月至2025年4月12,544份不明原因发热患者mNGS样本，在iMetaOmics发文揭示Q热与立克次体病分布特征。共1,176份样本检出相关病原，占9.4%；贝纳柯克斯体347例，占阳性样本29.5%，31个省级区域中除宁夏外均有检出。研究还检出299例立克次体，并在4例患者中检出类Rickettsia bellii序列。","reason","source",{"_71":88},"links",{"_59":87},"publishedAt","2026-11-02T11:00:00.000Z","discoveredAt","2026-11-02T13:58:38.501Z","timelineAt","category","research","tags",[81,82,83,84,85,86],"score",30,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fD5ntpYtO4PU","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","infectious","感染与疫苗",{"_78":79,"_13":80},"publicId","4a3d0f12-2a7f-4dfa-8f95-c335339ecb8b","中国团队发表Q热与立克次体病全国mNGS调查","论文/研究","感染/疫苗","耐药与院感","抗感染","循证指南","对市场","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604342&idx=2&sn=b55cd7eb621e495c995d6ac2dbbafb19&chksm=fc8204c272cc348e100c7b4f9c8ff5d76bd2d2286c23debe7421aba580a672a9bf432c908a7a&scene=126&sessionid=1793627912#rd","呼吸界",{"_90":91,"_92":-5,"_93":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
