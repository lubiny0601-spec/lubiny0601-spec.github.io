[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205955000,"id","uhd080s9kz6twc0ja6ox5z44z","title","WHO 首次发布儿科优先抗生素清单，覆盖头孢地尔等 9 款在研或在用药物","originalTitle","WHO Prioritizes Antibiotics for Pediatrics","summary","WHO 于 3 月 24 日报告首次发布儿科优先抗生素清单，列出需开发或优化的抗生素，涵盖在研药物、儿童超说明书使用药物及缺乏适龄剂型的已批准药物。进入 II、III 期临床或仅在成人获批的药物包括头孢地尔、美罗培南-伐博巴坦、plazomicin、aztreonam-avibactam 等 9 款；阿莫西林-克拉维酸、呋喃妥因、阿奇霉素和头孢地尔被列入 PADO 优先清单。","reason","source",{"_62":75},"links",{"_57":74},"publishedAt","2023-05-02T13:20:26.039Z","discoveredAt","2026-10-28T01:14:48.485Z","timelineAt","category","policy","tags",[68,69,70,71,72,73],"score",38,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":66,"_62":67},{"_61":64,"_62":65},{"_61":30,"_62":63},"slug","name","政策与监管","antibiotics","抗菌药物与耐药","infectious","感染与疫苗","政策/监管","抗菌药物","感染/疫苗","抗感染","管线上新","对市场","https://www.contagionlive.com/view/who-prioritizes-antibiotics-for-pediatrics","Contagion Live·医院感染",{"_77":78,"_79":-5,"_80":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
