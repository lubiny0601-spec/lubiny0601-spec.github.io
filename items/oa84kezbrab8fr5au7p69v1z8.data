[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795410147000,"id","oa84kezbrab8fr5au7p69v1z8","title","ObesityWeek 2026 | 翰森制药奥莱泊肽减重Ⅲ期 LIGHTEN 研究性别亚组数据以 LBA 公布：男女均疗效显著，安全性特征一致","originalTitle","ObesityWeek® 2026 | 翰森制药奥莱泊肽减重Ⅲ期 LIGHTEN 研究亚组数据以最新突破摘要公布：男女均疗效显著，安全性特征一致","summary","翰森制药在 ObesityWeek 2026 以最新突破性摘要壁报公布奥莱泊肽（HS-20094）中国减重Ⅲ期 LIGHTEN 研究性别亚组分析：604 例超重/肥胖成人每周皮下注射 5mg、10mg、15mg 或安慰剂 48 周，各剂量组体重、腰围、WHtR、FLI 改善均显著优于安慰剂（P<0.001），女性在体重降幅 ≥15%、≥20% 等达标比例上呈高于男性趋势。","reason","source",{"_69":81},"links",{"_59":80},"publishedAt","2026-11-14T16:00:00.000Z","discoveredAt","2026-11-16T00:55:18.947Z","timelineAt","category","clinical","tags",[70,77,78,79],"score",38,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fm2L4RdNrrNI","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","临床进展","metabolic","代谢与减重",{"_74":75,"_13":76},"publicId","cb0dde8a-deef-4264-8e10-4f6fb6ab05e1","翰森制药公布奥莱泊肽减重Ⅲ期性别亚组数据","代谢/减重","GLP-1","翰森制药","https://www.hansoh.cn/news/news-detail-514111.htm","翰森制药·公司新闻",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
