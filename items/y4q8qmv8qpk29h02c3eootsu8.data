[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795408368000,"id","y4q8qmv8qpk29h02c3eootsu8","title","特朗普政府将 Medicaid 工作要求执行推迟六个月","originalTitle","STAT+: Enforcement of stringent Medicaid work requirements delayed for six months","summary","特朗普政府周五宣布，将各州开始执行 Medicaid 工作要求的期限额外延长六个月，各州原需在 1 月 1 日前完成系统准备。该要求源自去年通过的 One Big Beautiful Bill，规定 ACA 扩围后各州须确保无受抚养子女的工作年龄受助者每月工作、就学或志愿服务至少 80 小时，残疾、照护幼儿或\"medical frail\"者除外。","reason","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-11-13T22:21:56.000Z","discoveredAt","2026-11-16T00:55:13.516Z","timelineAt","category","policy","tags",[66,67],"score",10,"selected",false,"channel","news","story","x","readingMode","full","author","John Wilkerson","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":64,"_62":65},{"_61":30,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","https://www.statnews.com/2026/11/13/medicaid-work-requirements-implementation-delayed-six-months/?utm_campaign=rss","STAT",{"_71":72,"_73":-5,"_74":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
