[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794205961000,"id","foacpsz9k1bqbwzjsk7snd5k7","title","恒瑞医药HRS-2189片获NMPA临床试验批准，拟联合新型内分泌治疗用于晚期前列腺癌","originalTitle","恒瑞医药｜恒瑞医药关于获得药物临床试验批准通知书的公告","summary","恒瑞医药子公司山东盛迪医药的HRS-2189片获NMPA核准签发《药物临床试验批准通知书》，同意开展联合新型内分泌治疗用于晚期前列腺癌的临床试验。HRS-2189片是一种新型KAT6抑制剂，通过抑制组蛋白赖氨酸乙酰化水平调控下游癌基因表达发挥抗肿瘤作用，目前国内外暂无同靶点药物获批上市。该项目累计研发投入约5,530万元（未经审计）。","reason","source",{"_72":87},"links",{"_59":86},"publishedAt","2026-10-28T16:00:00.000Z","discoveredAt","2026-10-28T15:38:58.439Z","timelineAt","category","approval","tags",[84,75,77,85],"score",17,"selected",false,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body","outline",[],"relatedStories",[80],"topics",[66,67,68,69],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fsEE4shjfSR4","reportCount",1,"additionalSourceCount",0,{"_70":78,"_72":79},{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","pipeline","name","研发管��","oncology","肿瘤","hengrui","恒瑞医药","nmpa","中国 NMPA",{"_81":82,"_13":83},"publicId","105df4e3-a212-41a3-bbd7-f3ef8c98e05b","恒瑞HRS-2189片获批晚期前列腺癌临床试验","研发管线","NMPA","https://static.cninfo.com.cn/finalpage/2026-10-29/1225636088.PDF","恒瑞医药·公司公告",{"_89":90,"_91":-5,"_92":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
