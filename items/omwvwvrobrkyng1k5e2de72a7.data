[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794791088000,"id","omwvwvrobrkyng1k5e2de72a7","title","中保协发布首版商保药品推荐清单，58款高值创新药械入选","originalTitle","关于58个商保药品推荐清单，官方答记者问（全文，关键字句已标注）","summary","中国保险行业协会11月10日发布《商业健康保险药品保障推荐清单（第一版）》，58款高值创新药械入选，并同步发布三份医疗险示范条款。清单由22名医学专家从临床需求、创新性、有效性、安全性四个维度评审，54家健康险公司参与投票；入选药械覆盖肺癌、肝癌、血液肿瘤等高发恶性肿瘤及神经母细胞瘤等罕见病目录肿瘤，近半数为1类创新或2类改良型新药，近六成为基本医保目录外自费药。","reason","清单的遴选维度与院外购药配套规则，能帮读者判断哪些高值药械先进入商保支付通道。","source",{"_72":84},"links",{"_60":83},"publishedAt","2026-11-11T08:55:03.000Z","discoveredAt","2026-11-12T14:31:08.473Z","timelineAt","category","policy","tags",[81,82,73],"score",62,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fsHWVfoDmhmw","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","trends","name","行业趋势","政策与监管","insurance","医保与集采",{"_78":79,"_13":80},"publicId","028d6286-5003-440e-b97d-925f0afaf552","中保协发布首版商保药品推荐清单，58款高值药械入选","政策/监管","医保/集采","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699580&idx=1&sn=0c87b7f1d01f867f018a755f477be63a&chksm=bcbf2752fb2d08c5c1c04f94f0af15c7a1fc17997c2b2697c19eb4e07da2972462baba047910&scene=126&sessionid=1794493842#rd","医药云端工作室",{"_86":87,"_88":-5,"_89":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
