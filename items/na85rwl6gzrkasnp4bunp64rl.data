[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":54,"_55":56,"_57":35,"_58":59},"expiresAt",1794384583000,"id","na85rwl6gzrkasnp4bunp64rl","title","王一民医生：病毒性肺炎该不该用抗生素？何时用、用哪一种？——多病例详解分层抉择与动态评估","originalTitle","summary","王一民医生结合流行病学与共感染证据，梳理病毒性肺炎抗生素使用的分层抉择与动态评估。我国成人CAP中病毒感染占39.2%，混合感染在重症患者中比例更高、细菌与病毒混合约占30%；流感合并细菌感染增加死亡风险（OR=2.55，95%CI 1.88～3.44）、ICU入院风险（OR=1.87）及机械通气需求风险（OR=1.78）。","reason","source",{"_70":85},"links",{"_59":84},"publishedAt","2026-11-07T12:20:37.000Z","discoveredAt","2026-11-09T06:30:59.177Z","timelineAt","category","opinion","tags",[78,79,80,81,82,83],"score",22,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","王一民","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fOR-USDCMcjs","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","antibiotics","抗菌药物与耐药",{"_75":76,"_13":77},"publicId","9d71dce6-e689-4bef-830a-520c21cd1a9b","王一民阐述病毒性肺炎抗生素分层使用策略","观点/解读","抗菌药物","耐药与院感","抗感染","循证指南","对品牌","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604564&idx=1&sn=1d67eb531e1fe651971d31cbb1e21684&chksm=fcca7ed3b999d0d50c831e11b771463631006e2e596a28f84bf8c30fa88b5f07764843c0fde4&scene=126&sessionid=1794205843#rd","呼吸界",{"_87":88,"_89":-5,"_90":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
