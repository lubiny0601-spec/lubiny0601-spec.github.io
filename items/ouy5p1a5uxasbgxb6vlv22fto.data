[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793889546000,"id","ouy5p1a5uxasbgxb6vlv22fto","title","梁宗安教授谈呼吸治疗师如何规范化开展胸部物理治疗","originalTitle","梁宗安教授：“胸部物理治疗”规范化实施要点？——呼吸治疗师规范化开展该核心技术的临床思考","summary","梁宗安教授围绕呼吸治疗师规范化实施胸部物理治疗（CPT）提出临床要点，明确CPT以物理手段改善呼吸功能、促进气道分泌物清除为核心目标。文章梳理体位引流、胸壁叩拍、胸壁震颤、主动呼吸循环技术（ACBT）、自体引流、正压呼气装置、高频胸壁振荡及指导性咳嗽与哈气等主流技术的原理、方法与关键点，并强调呼吸治疗师与胸部物理治疗师在执业体系上的差异。","reason","source",{"_71":81},"links",{"_60":80},"publishedAt","2026-11-05T04:12:36.000Z","discoveredAt","2026-11-05T05:15:39.731Z","timelineAt","category","opinion","tags",[79,74],"score",12,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","梁宗安","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fvxtscm8fV_g","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","opinions","name","观点与解读","respiratory","呼吸",{"_76":77,"_13":78},"publicId","a84e4215-acc6-47df-b503-dccfb77afd8c","梁宗安教授谈呼吸治疗师规范化开展胸部物理治疗","观点/解读","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604445&idx=2&sn=be137b97d52e709c6793ca3a7c51c51d&chksm=fc0d3dbd27f040d71f97c8e68658bddbb8b6dd7c0c1d200bcfab41aa6f552e2b525324482888&scene=126&sessionid=1793855735#rd","呼吸界",{"_83":84,"_85":-5,"_86":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
