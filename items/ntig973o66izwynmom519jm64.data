[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889567000,"id","ntig973o66izwynmom519jm64","title","国家药监局、海关总署增设广西钦州港口岸为药材进口边境口岸","originalTitle","国家药监局 海关总署增设广西壮族自治区钦州港口岸为药材进口边境口岸","summary","国家药监局、海关总署10月22日公告，经国务院批准增设广西壮族自治区钦州港口岸为药材进口边境口岸，即日起中药材可经该口岸进口。钦州市市场监督管理局承担进口药材登记备案与监督管理，广西壮族自治区药品检验研究院承担口岸检验工作。所进口药材须符合《进口药材管理办法》等规定。","reason","source",{"_62":71},"links",{"_57":70},"publishedAt","2026-10-22T00:00:00.000Z","discoveredAt","2026-10-27T13:29:45.319Z","timelineAt","category","policy","tags",[68,65,69],"score",36,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":66,"_62":67},{"_61":64,"_62":65},{"_61":30,"_62":63},"slug","name","政策与监管","tcm","中药","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-22/1109302.shtml","中国食品药品网·要闻",{"_73":74,"_75":-5,"_76":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
