[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":36,"_55":36,"_56":57,"_58":59,"_60":61},"expiresAt",1795443794000,"id","f3mw65nxnzpdl2ec41hllbydt","title","上海启动第12批国采未中选药品梯度降价，11月17日前未调价将暂停挂网","originalTitle","上海：第12批国采未中选品种，梯度降价开始！若不接受调价，将暂停挂网","summary","上海市药事所11月11日通知，对第12批国采未中选已挂网药品开展梯度降价，价格确认时间为2026年11月11日至11月17日。已挂网参比制剂和过评药品按系统内参考治理价调整申报价，未过评药品按不高于本市有约定采购量中选药品最低价、依现行差比价规则计算，中选产品未列入供应清单的规格包装按其中选价依差比价规则计算。","reason","source",{"_71":86},"links",{"_61":85},"publishedAt","2026-11-11T03:17:37.000Z","discoveredAt","2026-11-11T08:15:26.426Z","timelineAt","category","policy","tags",[81,82,83,84],"score",67,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","sameEvent",{"_11":79,"_13":80},"readingMode","full","author","body","outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fEH9a7yyhxcw","reportCount",2,"additionalSourceCount",1,{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","政策与监管","insurance","医保与集采",{"_76":77,"_13":78},"publicId","7d11c560-d5b9-4103-b145-e9ae8c62224e","上海启动第十二批集采未中选药品梯度降价填报","rwnxfwlhpi92h2i7b7lkace12","上海启动第十二批国家集采未中选药品梯度降价填报，11月17日前未调价将暂停采购","政策/监管","医保/集采","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699560&idx=1&sn=f94db3da5f0a60ddd52ce834e10ede2c&chksm=bc873034dbe4e5b47f3c32ff263ef2991ed848f817433aeaf079271169224a89ed492f8d39ff&scene=126&sessionid=1794384876#rd","医药云端工作室",{"_88":89,"_90":-5,"_91":36},"changelogVersion","2026-10-08T08:00","release","staticSite"]
