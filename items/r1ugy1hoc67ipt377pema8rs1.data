[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795443813000,"id","r1ugy1hoc67ipt377pema8rs1","title","恒瑞医药4款创新药纳入商业健康保险药品保障推荐清单（第一版）","originalTitle","恒瑞医药4款创新药纳入《商业健康保险药品保障推荐清单》，助力提升患者用药可及性","summary","11月10日中国保险行业协会发布《商业健康保险药品保障推荐清单（第一版）》，恒瑞医药有4款创新药纳入，分别为HER2 ADC瑞康曲妥珠单抗（艾维达）、抗PD-L1/TGF-βRII双抗融合蛋白瑞拉芙普α（艾泽利）、PD-L1抑制剂阿得贝利单抗（艾瑞利）和EZH2抑制剂泽美妥司他（艾瑞璟）。恒瑞医药总裁、首席运营官冯佶表示将配合清单落地实施，深化与保险机构协同，拓宽创新药保障渠道。","reason","商保推荐清单首次纳入恒瑞4款创新药，读者可据此判断创新药支付渠道向商保延伸的路径。","source",{"_66":83},"links",{"_58":82},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-23T04:25:02.675Z","timelineAt","category","policy","tags",[78,79,77,75,80,81],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_65":76,"_66":77},{"_65":74,"_66":75},{"_65":72,"_66":73},{"_65":70,"_66":71},{"_65":68,"_66":69},{"_65":31,"_66":67},"slug","name","政策与监管","insurance","医保与集采","antibody","抗体与双抗","adc","ADC 与偶联药物","oncology","肿瘤","hengrui","恒瑞医药","政策/监管","医保/集采","ADC","抗体/双抗","https://www.hengrui.com/media/detail-1068.html","恒瑞医药·新闻",{"_85":86,"_87":-5,"_88":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
