[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794791090000,"id","q7t485p2pjvistbgf5ad5bp8c","title","Gladstone研究所绘制神经保护蛋白图谱，揭示血脑屏障选择性转运机制与阿尔茨海默病早期通路受损","originalTitle","Neuroprotective Protein Atlas Positions the Blood-Brain Barrier as a Selective Checkpoint","summary","Gladstone Institutes等机构在小鼠中构建了首个血脑屏障转运神经保护蛋白图谱，追踪861种血浆蛋白后发现92种可进入大脑，多数由肝脏产生。研究显示阿尔茨海默病模型在血脑屏障破损前即已停止输入APOA1等保护性蛋白，而肝脏过量产生APOA1的小鼠疾病迹象更少。","reason","source",{"_64":73},"links",{"_58":72},"publishedAt","2026-11-12T18:59:49.000Z","discoveredAt","2026-11-16T00:55:16.796Z","timelineAt","category","research","tags",[70,71,67],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","Uduak Thomas","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","papers","name","论文研究","rare-disease","罕见病","neuroscience","神经与精神","论文/研究","神经/精神","https://www.genengnews.com/topics/translational-medicine/neuroprotective-protein-atlas-positions-the-blood-brain-barrier-as-a-selective-checkpoint/","GEN Genetic Engineering & Biotechnology News",{"_75":76,"_77":-5,"_78":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
