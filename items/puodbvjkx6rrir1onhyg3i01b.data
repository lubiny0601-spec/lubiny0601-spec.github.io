[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443791000,"id","puodbvjkx6rrir1onhyg3i01b","title","32家医药企业董事长离职；药明生物原副总裁王卓智出任水木分子CEO；第十二批国采25地确定执行时间","originalTitle","32家医药企业董事长离职；药明生物原副总裁履新；第十二批国采，25地确定执行时间...","summary","截至11月21日，今年已有32家医药企业披露33起董事长离任消息，科伦药业创始人刘革新辞任董事长、由其子刘思川接任。药明生物原副总裁王卓智出任水木分子CEO，负责AI驱动创新生物药管线研发及全球商务拓展。第十二批国采中选结果已有25地确定执行时间，江西、湖北、青海已执行。","reason","source",{"_63":77},"links",{"_57":76},"publishedAt","2026-11-21T11:29:31.000Z","discoveredAt","2026-11-23T04:32:35.273Z","timelineAt","category","industry","tags",[64,69,70,71,68,72,73,74,75],"score",30,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","company-news","name","公司动态","insurance","医保与集采","wuxi","药明康德","医保/集采","国家医保局","科伦药业","华东医药","赛诺菲","抗感染","企业竞争","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653671423&idx=2&sn=9aec19f7027436c9146f7efb1faa36bd&chksm=bc5f7b772f5d32e883032e73d805c4d40d8e3013bfeb3394986209239080b00ebb729f37c767&scene=126&sessionid=1795408256#rd","赛柏蓝",{"_79":80,"_81":-5,"_82":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
