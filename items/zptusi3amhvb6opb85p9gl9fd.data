[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443792000,"id","zptusi3amhvb6opb85p9gl9fd","title","昆明医科大学刘文军团队在 Adv Sci 发表阶段自适应双层水凝胶，序贯光动力抗菌与工程化 sEV 免疫调节治疗感染性糖尿病创面","originalTitle","Adv Sci：昆明医科大学刘文军团队发现一块水凝胶\"先杀菌、后安抚\"，让感染伤口按节奏自己修复","summary","昆明医科大学刘文军团队在 Advanced Science 发表阶段自适应双层水凝胶 Bil-Gel@miR-sEVs，内层载二氢卟吩e6（Ce6）行光动力抗菌，ROS 响应上层负载富集 miR-146a、携带人 CD64 识别模块的 hUC-MSC 来源 sEVs，实现早期杀菌与后期免疫调节的空间分隔与时序衔接。","reason","source",{"_72":92},"links",{"_59":91},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T04:24:55.736Z","timelineAt","category","research","tags",[84,85,86,87,88,89,90],"score",12,"selected",false,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body","outline",[],"relatedStories",[80],"topics",[66,67,68,69],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fsK-CKEcQDw4","reportCount",1,"additionalSourceCount",0,{"_70":78,"_72":79},{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","papers","name","论文研究","device-ivd","医疗器械与 IVD","antibiotics","抗菌药物与耐药","infectious","感染与疫苗",{"_81":82,"_13":83},"publicId","54f943d4-87d1-46d7-885b-2c4f32779d7c","昆医团队发表阶段自适应双层水凝胶研究","论文/研究","抗菌药物","耐药与院感","感染/疫苗","医疗器械/IVD","抗感染","循证指南","https://news.bioon.com/article/b832965232fb.html","生物谷",{"_94":95,"_96":-5,"_97":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
