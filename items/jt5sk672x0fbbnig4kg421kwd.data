[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793888191000,"id","jt5sk672x0fbbnig4kg421kwd","title","石药百克入选2026年“山东省品牌提升群星行动”重点培育企业","originalTitle","石药百克入选“山东省品牌提升群星行动”重点培育企业","summary","石药集团百克（山东）生物制药股份有限公司入选山东省市场监管局发布的2026年“山东省品牌提升群星行动”重点培育企业名单。该行动为省级品牌梯次培育重点工程，入库企业可获省级平台推介、“一企一策”帮扶及品牌专项辅导等支持。石药百克此前已获国家科学技术进步二等奖、中国专利金奖、山东省制造业单项冠军企业等荣誉。","reason","source",{"_62":67},"links",{"_57":66},"publishedAt","2026-10-26T00:00:00.000Z","discoveredAt","2026-10-29T14:00:04.310Z","timelineAt","category","industry","tags",[63,65],"score",7,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","company-news","name","公司动态","cspc","石药集团","https://www.cspc.cn/details/details_92_7256.html","石药集团·新闻中心",{"_69":70,"_71":-5,"_72":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
