[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384583000,"id","f272484705k792ovyoc3s7q5e","title","第九届进博会美妆龙头首发首展新品盘点：欧莱雅、资生堂、雅诗兰黛等集中亮相","originalTitle","进博会 | 进博聚光灯下，美妆龙头秀出哪些“首发”“首展”新品？","summary","第九届进博会上，欧莱雅、资生堂、雅诗兰黛、爱茉莉太平洋、高丝、宝洁、花王等美妆龙头集中展示首发首展新品。欧莱雅携27个品牌参展，带来5款全球首发和10余款中国首发新品，其中金致驭龄面霜与鲜注油膜已申请备案，油养微珠精华液已于今年9月完成备案。资生堂悦薇智感视黄醇抗皱紧颜精萃水今年7月完成备案，拟于12月上市。","reason","source",{"_62":68},"links",{"_57":67},"publishedAt","2026-11-08T00:00:00.000Z","discoveredAt","2026-11-09T06:26:07.592Z","timelineAt","category","industry","tags",[65,63,66],"score",3,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","trends","name","行业趋势","company-news","公司动态","其他","https://www.cnpharm.com/c/2026-11-08/1110095.shtml","中国食品药品网·要闻",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
