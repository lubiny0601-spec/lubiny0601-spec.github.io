[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794205954000,"id","txktw1c520ej0zduxetqd2f44","title","北京医保局启动河南牵头34种药品省际联盟集采报量，本市参与9个品种","originalTitle","关于填报34种药品省际联盟集中带量采购相关品种需求量的通知","summary","北京市医保局通知各医疗机构填报河南牵头34种药品省际联盟集采需求量，本市仅需对其中9个品种报量，填报时间为2026年4月9日至16日，通过34种药品省际联盟采购报量平台线上直报并上传承诺函。2025年历史采购量已导入系统供参考，医疗机构报量低于历史采购量80%时须作出说明，有历史采购量而不参与报量的机构将在落地执行监测中重点关注。","reason","北京医保局明确河南牵头34种药品联盟集采的报量口径，涉及本市参与的9个品种与低于历史量80%需说明的规则。","source",{"_62":72},"links",{"_58":71},"publishedAt","2026-04-09T00:00:00.000Z","discoveredAt","2026-10-27T16:01:16.796Z","timelineAt","category","policy","tags",[66,67,68,69,70],"score",62,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://ybj.beijing.gov.cn/zczxs/2020_ycgga/202604/t20260409_4577905.html","北京医保局·药品通知公告",{"_74":75,"_76":-5,"_77":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
