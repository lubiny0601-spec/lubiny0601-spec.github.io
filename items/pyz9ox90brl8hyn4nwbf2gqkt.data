[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795408364000,"id","pyz9ox90brl8hyn4nwbf2gqkt","title","征祥医药玛硒洛沙韦片（济可舒）纳入2026年国家医保目录","originalTitle","流感防治新选择：国产1类创新药济可舒®（玛硒洛沙韦片）成功纳入国家医保目录","summary","国家医保局11月14日公布2026年国家医保药品目录（2027年1月1日起执行），征祥医药自主研发的1类抗流感新药玛硒洛沙韦片（济可舒）纳入，济川药业为该药中国独家商业化权益方。该药为流感病毒PA核酸内切酶抑制剂，全疗程单次口服，成人80mg、12岁及以上青少年40mg，成人适应症2025年7月获批、青少年适应症2026年6月获批。其代谢不依赖CYP450酶，轻中度肝功能不全无需调整剂量。","reason","国产抗流感1类新药进入国家医保目录，读者可据此判断单次口服方案在流感处方中的可及性变化。","source",{"_71":86},"links",{"_60":85},"publishedAt","2026-11-15T03:13:12.000Z","discoveredAt","2026-11-16T01:00:44.225Z","timelineAt","category","policy","tags",[81,82,83,84],"score",75,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","ff9PlQw4Iss4","reportCount",1,"additionalSourceCount",0,{"_70":75,"_71":76},{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","政策与监管","insurance","医保与集采","infectious","感染与疫苗",{"_78":79,"_13":80},"publicId","1cfaacbb-59ab-48f3-85f8-c412058dc31d","济可舒纳入2026年国家医保药品目录","政策/监管","医保/集采","感染/疫苗","国家医保局","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604842&idx=1&sn=53c76be260adf113c60d275172de9e58&chksm=fca3fae73304ded76277d3ba4478e763487eeda5a4c491f72789b47d51c2831b2da86d8ca250&scene=126&sessionid=1794790833#rd","呼吸界",{"_88":89,"_90":-5,"_91":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
