[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795408385000,"id","za8928fn1fpgbtem5tocmq4q1","title","进博会美妆观察：宝洁、资生堂、欧莱雅等加码中国本土研发与共创","originalTitle","进博会丨“中国味”成进博美妆流量密码","summary","第九届进博会上，宝洁、资生堂、欧莱雅、花王等全球美妆企业集中展示面向中国市场的本土化创新，从产品引进转向在华研发落地。欧莱雅与巴斯夫共研的防晒新原料麦色滤400在中国获准注册，成为《化妆品监督管理条例》实施以来首个获批的防晒新原料，三款应用该原料的理肤泉防晒产品同步获准注册。资生堂中国团队主导的医美品牌RQ PYOLOGY律曜、欧莱雅与中国初创企业共研的K-STATION防脱护理仪等亦亮相。","reason","source",{"_63":71},"links",{"_57":70},"publishedAt","2026-11-10T00:00:00.000Z","discoveredAt","2026-11-11T14:04:23.193Z","timelineAt","category","industry","tags",[66,69,64],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","trends","name","行业趋势","company-news","公司动态","device-ivd","医疗器械与 IVD","医疗器械/IVD","https://www.cnpharm.com/c/2026-11-10/1110289.shtml","中国食品药品网·要闻",{"_73":74,"_75":-5,"_76":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
