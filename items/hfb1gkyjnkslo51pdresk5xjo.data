[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794384582000,"id","hfb1gkyjnkslo51pdresk5xjo","title","中国生物制药与勃林格殷格翰达成70亿美元ADC与TcE授权合作","originalTitle","70亿美元 ！中国生物制药与BI达成合作","summary","2026年11月4日，中国生物制药与勃林格殷格翰宣布达成多项目选择权与许可协议，推进基于ADC和T细胞衔接器（TcE）技术的下一代癌症治疗项目。中国生物制药将获得3.58亿美元首付款及近期付款，并有资格获得合计70亿美元的选择权行使、开发、监管及商业化里程碑付款，产品上市后另有阶梯式特许权使用费。","reason","六个临床前项目打包授权，首付款与里程碑结构清晰，可对照国内ADC出海的交易量级。","source",{"_66":77},"links",{"_59":76},"publishedAt","2026-11-04T12:35:56.000Z","discoveredAt","2026-11-09T06:26:03.925Z","timelineAt","category","industry","tags",[74,71,75,73],"score",72,"selected",true,"channel","news","story","x","readingMode","full","author","yian","body","outline",[],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","deals","name","交易与授权","adc","ADC 与偶联药物","oncology","肿瘤","sinobiopharm","中国生物制药","交易/授权","ADC","https://www.drugtimes.cn/2026/11/04/70yimeiyuanzhongguoshengwuzhiyaoyubidachenghezuo/","药时代",{"_79":80,"_81":-5,"_82":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
