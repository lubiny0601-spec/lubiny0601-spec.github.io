[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1793888172000,"id","bx1guilpucpsxvrwb8htp0ush","title","上海发布基药优先配备通知，与多省落地口径对比偏轻","originalTitle","如何看待上海基药配备政策？与各省相比大有深意！","summary","上海市卫健委与医保局10月28日联合发布《关于进一步做好基本药物优先配备使用工作的通知》，要求各级公立医疗机构在10月31日前完成用药目录调整，自2026年9月1日起施行2026版基药目录，并将基药使用纳入处方审核点评、监测“四个占比”、每年11月30日前报评估且与基层基药补助资金挂钩。","reason","上海基药配备文件与山西、广东等省份的硬指标形成对照，读者可据此判断本地执行口径的松紧差异。","source",{"_70":82},"links",{"_60":81},"publishedAt","2026-10-29T03:13:03.000Z","discoveredAt","2026-10-31T03:04:43.151Z","timelineAt","category","policy","tags",[78,79,80],"score",58,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fin_b1FKvifc","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","政策与监管","insurance","医保与集采",{"_75":76,"_13":77},"publicId","dd0ad611-d4ec-4c06-aeb4-bb612e97650a","上海发布基药优先配备使用通知","政策/监管","医保/集采","其他","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699404&idx=1&sn=c1322d1c8c5668d83f89a32177023e3d&chksm=bcaa8ca561a2f323e51d1917f5ef6220dfb6cc9c81c1609fa9e5a4cf9e127d28181e1229f725&scene=126&sessionid=1793415858#rd","医药云端工作室",{"_84":85,"_86":-5,"_87":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
