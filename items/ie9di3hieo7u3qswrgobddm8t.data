[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793889546000,"id","ie9di3hieo7u3qswrgobddm8t","title","感染前30天内抗菌药物使用史与腹部侵入性操作是CRKP感染独立危险因素——青岛市市立医院CRKP分子流行病学特征研究","originalTitle","感染前30天内抗菌药物使用史、腹部侵入性操作是独立危险因素？——CRKP感染的临床危险因素与分子流行病学特征研究","summary","青岛市市立医院2016年11月至2023年10月分离的528株肺炎克雷伯菌中，80例CRKP感染患者的多因素logistic回归显示，感染前30天内抗菌药物使用史（OR=4.411，95%CI：1.749~11.128）和腹部侵入性操作（OR=6.846，95%CI：3.141~14.922）是CRKP感染的独立危险因素。","reason","source",{"_71":86},"links",{"_60":85},"publishedAt","2026-11-04T11:41:12.000Z","discoveredAt","2026-11-05T05:15:48.501Z","timelineAt","category","research","tags",[79,80,81,82,83,84],"score",29,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","张宸峥 等","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fNSCYBXoIfwc","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药",{"_76":77,"_13":78},"publicId","a91d78f7-c264-4e97-8e97-12851fff416f","青岛市立医院发表CRKP感染危险因素研究","论文/研究","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604411&idx=2&sn=8d2929535289999b11ac493cfad6d7d9&chksm=fcad011be962191a23663af5d7e57ac12ea2545e4296cf5f221183f358a3a2f3722513c94021&scene=126&sessionid=1793855735#rd","呼吸界",{"_88":89,"_90":-5,"_91":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
