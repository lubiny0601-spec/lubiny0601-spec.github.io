[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1793888171000,"id","hd485xtzcfm3xsnbe8g91vitu","title","信达生物Q3产品收入超47亿元，点苍鹤拆解高增长的四股力量与后续节奏","originalTitle","信达生物Q3增长超40%，增长的底气在哪儿？后续还会增长吗？","summary","信达生物2026年第三季度产品收入单季超过47亿元，同比增长超40%，在Q2超43亿元的高基数上继续上行。作者点苍鹤认为增长来自老品种企稳、TKI产品进医保后放量、玛仕度肽与托莱西单抗等综合新品渗透以及销售费用摊薄四股力量叠加，短期高增有延续性但同比增速会从Q2接近60%、Q3超40%逐季温和回落。","reason","文章把信达Q3超40%增长拆成老品种企稳、TKI接力、新品放量与费用摊薄四股力量，并指出增速斜率会逐季下移。","source",{"_76":101},"links",{"_61":100},"publishedAt","2026-10-31T01:06:38.000Z","discoveredAt","2026-10-31T03:04:27.275Z","timelineAt","category","opinion","tags",[92,79,93,85,94,95,87,96,97,98,99],"score",62,"selected",true,"channel","news","story",{"_89":90,"_13":91},"x","readingMode","full","author","点苍鹤","body","outline",[],"relatedStories",[88],"topics",[68,69,70,71,72,73],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fCsTSlrYyW6A","reportCount",1,"additionalSourceCount",0,{"_74":86,"_76":87},{"_74":84,"_76":85},{"_74":82,"_76":83},{"_74":80,"_76":81},{"_74":78,"_76":79},{"_74":75,"_76":77},"slug","opinions","name","观点与解读","company-news","公司动态","market","市场与销售","metabolic","代谢与减重","oncology","肿瘤","innovent","信达生物",{"_89":90,"_13":91},"publicId","39f23fda-d8ed-4156-80cd-7668128f0dd6","信达生物Q3产品收入超47亿元，同比增超40%","观点/解读","市场/销售","代谢/减重","GLP-1","礼来","辉瑞","武田","罗氏","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699440&idx=2&sn=a70365c717b768cef0d1922c58c087d5&chksm=bc9d283850872f365d70025a68f298a0d39cda07eea58256fccce778b2f830e081fc3414d844&scene=126&sessionid=1793415858#rd","医药云端工作室",{"_103":104,"_105":-5,"_106":37},"changelogVersion","2026-10-08T08:00","releas