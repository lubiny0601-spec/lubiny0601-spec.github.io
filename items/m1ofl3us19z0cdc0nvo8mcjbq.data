[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795410125000,"id","m1ofl3us19z0cdc0nvo8mcjbq","title","2026流感宣传月：儿童流感的早期识别、规范诊疗与科学防控","originalTitle","2026 流感宣传月丨儿童专科必读：儿童流感的早期识别、规范诊疗与科学防控","summary","2026年流感季异常提前，夏季已出现明显流感活动，H1N1占比回升并伴G155E突变，第46周全国流感阳性样本中A(H1N1)pdm09占56.2%。儿童流感发病率分别为15～59岁人群的3.1倍、60岁及以上人群的6.6倍，专家共识建议确诊或疑似患儿起病48h内启动抗病毒治疗，重症高风险患儿采取“边检边治”或“抢先治疗”。玛巴洛沙韦干混悬剂适用于1~12岁儿童，可按体重精准给药，全程1次用药。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-21T11:08:03.000Z","discoveredAt","2026-11-23T04:31:06.590Z","timelineAt","category","opinion","tags",[77,78],"score",38,"selected",false,"channel","news","story",{"_75":76,"_13":14},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fgbkC-RU0_ms","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","infectious","感染与疫苗",{"_75":76,"_13":14},"publicId","799f0b92-8345-4544-b8fb-07a85e314578","观点/解读","感染/疫苗","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200759&idx=1&sn=7147790b0e457db767bb78a51a721f8e&chksm=8238e378ce03f8a36287ba1bddca10048f6fe1f96fddd91cb53e76a378bfd275fde7d6e664a6&scene=126&sessionid=1795408256#rd","SIFIC 感染视界",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
