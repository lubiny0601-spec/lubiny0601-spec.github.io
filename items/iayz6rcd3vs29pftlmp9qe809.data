[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794791088000,"id","iayz6rcd3vs29pftlmp9qe809","title","四部门发文促进创新药配备使用，两目录内1类新药不计入一品两规","originalTitle","有关创新药不计入“一品两规”、不纳入公立医疗机构绩效监测指标……四部门联合发文促进创新药配备使用","summary","11月10日，国家卫生健康委、国家医保局、国家中医药局、国家疾控局联合发布《关于进一步做好创新药安全合理配备使用工作的通知》，明确国家医保谈判药品目录和商业健康保险创新药品目录内1类新药不计入一品两规，也不纳入门诊患者基本药物处方占比、住院次均药品费用增幅等公立医疗机构绩效监测指标。","reason","四部门明确两目录内1类新药不计入一品两规和多项绩效监测指标，读者可据此判断创新药进院与考核口径的变化。","source",{"_70":83},"links",{"_60":82},"publishedAt","2026-11-10T00:00:00.000Z","discoveredAt","2026-11-11T14:04:23.226Z","timelineAt","category","policy","tags",[78,79,80,81],"score",80,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fZCv1UXJ56sc","reportCount",3,"additionalSourceCount",2,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","政策与监管","insurance","医保与集采",{"_75":76,"_13":77},"publicId","b89dbeac-87dd-4530-9a1b-573db8656b2d","四部门发文：两目录内1类新药不计入一品两规","政策/监管","医保/集采","国家医保局","NMPA","https://www.cnpharm.com/c/2026-11-10/1110268.shtml","中国食品药品网·要闻",{"_85":86,"_87":-5,"_88":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
