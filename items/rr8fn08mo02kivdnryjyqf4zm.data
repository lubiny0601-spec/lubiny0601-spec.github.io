[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408366000,"id","rr8fn08mo02kivdnryjyqf4zm","title","璟济生物异甘草酸镁上市申请获CDE受理，为国内第三家申报企业","originalTitle","一个 30 亿的品种， 全国目前就这三家","summary","璟济生物自主研发的异甘草酸镁（原料药+注射液）上市申请已获CDE受理，受理号CYHS2602702，成为国内第三家申报该品种的企业。该品种为第四代甘草酸制剂，同时覆盖急性药物性肝损伤与慢性肝炎肝功能异常双适应症，慢性肝病ALT升高患者治疗2周有效率92.94%。公立终端年销售额稳定在24亿元以上，整体市场规模突破30亿级。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-15T23:30:00.000Z","discoveredAt","2026-11-16T01:01:05.417Z","timelineAt","category","industry","tags",[81,82,76],"score",22,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fQs9Y5iyFIS0","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","market","name","市场与销售","pipeline","研发管��","small-molecule","小分子",{"_78":79,"_13":80},"publicId","68edb162-71af-409b-8cfd-4c92c3abb854","璟济生物异甘草酸镁上市申请获受理","研发管线","市场/销售","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670726&idx=1&sn=5c17abba72d4b9cdeafeb597817a1be0&chksm=bc65873a85c68122ec7329e5212500830a4bfedc9c5510f69e7b1a8613312515174f22fb8b43&scene=126&sessionid=1794790858#rd","赛柏蓝",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
