[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791091000,"id","xt8xp81gg9j17mbh4tp2p8rfm","title","鼻孔吸药、亲吻吸嘴：吸入装置使用中的常见错误操作盘点","originalTitle","鼻孔吸药、亲吻吸嘴……吸药「迷惑行为大赏」，你中了几条？","summary","呼吸科门诊发现，吸入装置使用错误普遍存在：有患者用鼻子代替嘴巴吸药，导致药粉大多被截留在鼻腔、难以抵达下气道；有患者只轻吻吸嘴而不含住配合吸气，药物散失在口腔前部。干粉吸入剂对着吸嘴呼气会带入湿气使药粉受潮结块，共用装置则带来感染、剂量混乱及急救与维持用药错配风险。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-11T11:05:00.000Z","discoveredAt","2026-11-12T14:31:07.384Z","timelineAt","category","opinion","tags",[78,73],"score",10,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f2gH6c8KvUoA","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","respiratory","呼吸",{"_75":76,"_13":77},"publicId","283826b4-0425-4c69-a461-f827e6e93d19","吸入装置常见错误操作盘点","观点/解读","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604714&idx=3&sn=25fedf61c42b7713795a7cf25e3cb858&chksm=fc3b5c796f61d394af1fd973d348ab73f917596f35943d1945cb8a2cfb8292bac217d3c553ae&scene=126&sessionid=1794493844#rd","呼吸界",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
