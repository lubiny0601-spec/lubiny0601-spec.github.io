[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795443790000,"id","l3sg0o11v4cxvprqzjdqk3k25","title","2026H1有52个国谈药在城市实体药店销售过亿，合计近140亿元","originalTitle","52个国谈药，药店销售过亿（附名单）","summary","米内网数据显示，2026H1中国城市实体药店终端有52个国谈药（2025版）销售额超过1亿元，合计接近140亿元，其中36个品种涨幅超过10%。甲磺酸伏美替尼片、甲磺酸阿美替尼片均超12亿元，泽布替尼胶囊、司库奇尤单抗注射液超5亿元，替尔泊肽注射液涨超300%。一级集团排名中翰森制药、恒瑞医药、诺华位列前三，52个品种中独家品种占比约86%。","reason","米内网数据显示国谈药在实体药店持续扩容，52个过亿品种的靶点与独家格局可作院外准入参考。","source",{"_73":92},"links",{"_61":91},"publishedAt","2026-11-14T05:35:05.000Z","discoveredAt","2026-11-16T01:03:31.161Z","timelineAt","category","industry","tags",[83,84,74,85,86,87,88,89,90],"score",58,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","玲珑","body","outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","f7WoyOH5A_-Q","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","trends","name","行业趋势","market","市场与销售","insurance","医保与集采",{"_80":81,"_13":82},"publicId","6af49cb4-a94c-4515-a69c-09b6ce5b1b79","米内网：2026H1城市实体药店52个国谈药销售过亿","市场/销售","医保/集采","恒瑞医药","翰森制药","百济神州","诺华","礼来","国家医保局","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670661&idx=3&sn=a9cd49c32ff7ef89dd2a9c581dafef4b&chksm=bc42d62ab2be85beda9a1268ccddc564b3976c1b2d011a5bed0fbab3ff527c17595834433720&scene=126&sessionid=1794790858#rd","赛柏蓝",{"_94":95,"_96":-5,"_97":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
