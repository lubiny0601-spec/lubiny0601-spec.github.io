[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794384584000,"id","vwnpkyxt8s9bt1ovtxy02dsft","title","两位新当选议员拟在Trump政府削减下捍卫健康公平","originalTitle","Two incoming lawmakers plan to defend health equity from Trump administration cuts","summary","在民主党赢得第120届国会控制权后，新当选的密歇根州参议员Abdul El-Sayed（流行病学家、前健康差异研究者）和佐治亚州众议员Jasmine Clark（微生物学家）表示将捍卫健康公平。过去两年Trump政府终止了数百项用于记录和纠正医疗不平等的拨款，并关闭了科学人才多元化项目。Clark称其研究HIV传播的前实验室因国际合作的限制而暂停了部分非洲纵向研究。","reason","source",{"_63":68},"links",{"_58":67},"publishedAt","2026-11-06T21:46:55.000Z","discoveredAt","2026-11-09T06:26:05.129Z","timelineAt","category","policy","tags",[66,64],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","Anil Oza","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":30,"_63":65},{"_61":62,"_63":64},"slug","trends","name","行业趋势","政策与监管","政策/监管","https://www.statnews.com/2026/11/06/abdul-el-sayed-jasmine-clark-defend-health-equity-from-cuts/?utm_campaign=rss","STAT",{"_70":71,"_72":-5,"_73":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
