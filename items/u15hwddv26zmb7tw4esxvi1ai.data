[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794205954000,"id","u15hwddv26zmb7tw4esxvi1ai","title","2026年政府工作报告提医药重点：优化医药集采和价格治理、加强基层用药衔接、推进中医药传承创新","originalTitle","2026两会“药点”来了！政府工作报告：推进中医药传承创新、加强基层用药衔接、优化医药集采和价格治理......","summary","3月5日十四届全国人大四次会议开幕，政府工作报告在2026年任务中提出健全医疗、医保、医药协同发展和治理机制，加强基层用药衔接，优化医药集中采购和价格治理，深化医保支付方式改革，推进中医药传承创新，加快发展商业健康保险，推动创新药和医疗器械高质量发展。","reason","政府工作报告列出集采、价格治理与基层用药衔接的年度方向，可对照此前集采与医保支付规则理解后续落地节奏。","source",{"_63":75},"links",{"_58":74},"publishedAt","2026-03-06T00:00:00.000Z","discoveredAt","2026-10-11T18:36:05.043Z","timelineAt","category","policy","tags",[69,70,68,71,72,73],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":31,"_63":64},"slug","name","政策与监管","insurance","医保与集采","tcm","中药","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://www.menet.com.cn/info/202603/202603060922272227_150382.shtml","米内网·政策",{"_77":78,"_79":-5,"_80":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
