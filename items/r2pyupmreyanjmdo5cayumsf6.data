[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889566000,"id","r2pyupmreyanjmdo5cayumsf6","title","ASN 2026 | 翰森制药公布盐酸谷司卡肽治疗CKD血液透析患者SHPT的Ⅲ期及Ⅱ期长期数据","originalTitle","ASN 2026 | 翰森制药公布盐酸谷司卡肽治疗慢性肾脏病血液透析的成人患者继发性甲状旁腺功能亢进症的有效性、安全性及长期临床研究数据","summary","翰森制药在ASN 2026公布盐酸谷司卡肽静脉用拟钙剂关键Ⅲ期及Ⅱ期长期数据：Ⅲ期入组498例，第20–27周iPTH较基线下降>30%比例达90.2%，显著优于西那卡塞的74.7%，胃肠道不良事件发生率20.2%亦显著更低。Ⅱ期303例中位治疗74.7周，安全性良好，至少71%参与者iPTH降至300 pg/mL以下。该药上市申请已于2026年6月9日获NMPA受理。","reason","source",{"_61":68},"links",{"_57":67},"publishedAt","2026-10-22T16:00:00.000Z","discoveredAt","2026-10-27T14:51:16.222Z","timelineAt","category","clinical","tags",[62,65,64,66],"score",43,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","临床进展","small-molecule","小分子","肾病","翰森制药","https://www.hansoh.cn/news/news-detail-514094.htm","翰森制药·公司新闻",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
