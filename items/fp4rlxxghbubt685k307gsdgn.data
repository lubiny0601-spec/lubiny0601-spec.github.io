[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795443792000,"id","fp4rlxxghbubt685k307gsdgn","title","死后脑组织DNA甲基化分析揭示PTSD脑分子特征与创伤暴露年龄、性别及种族相关","originalTitle","PTSD Brain DNA Methylation Patterns Linked to Age of Trauma Exposure, Sex, and Ethnicity","summary","得克萨斯大学奥斯汀分校团队对302例死后脑组织（101例PTSD、101例重度抑郁症、100例无精神疾病对照）的前额叶皮层、杏仁核和海马进行DNA甲基化分析，发现PTSD患者脑内甲基化模式个体间差异大于重度抑郁症患者。","reason","source",{"_63":70},"links",{"_58":69},"publishedAt","2026-11-20T19:36:46.000Z","discoveredAt","2026-11-23T04:24:58.860Z","timelineAt","category","research","tags",[67,68],"score",7,"selected",false,"channel","news","story","x","readingMode","full","author","Sophia Ktori","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","neuroscience","神经与精神","论文/研究","神经/精神","https://www.genengnews.com/topics/omics/ptsd-brain-dna-methylation-patterns-linked-to-age-of-trauma-exposure-sex-and-ethnicity/","GEN Genetic Engineering & Biotechnology News",{"_72":73,"_74":-5,"_75":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
