[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889546000,"id","tazdg6od3vcbtbi7coz3rffq2","title","人社部数据：2026年第一季度医药代表平均招聘薪酬0.98万元/月","originalTitle","医药代表，薪资水平来了","summary","人社部市场招聘薪酬数据显示，2026年第一季度医药代表岗位平均招聘薪酬为0.98万元/月，该数据反映招聘市场薪酬报价，不等于在职医药代表实际平均收入。从业者对薪资感受不一，有肿瘤产品推广代表认为压力大但薪水较一般行业可观，也有代表称压力大、收入不如从前。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-05T00:54:40.000Z","discoveredAt","2026-11-05T05:15:58.734Z","timelineAt","category","industry","tags",[71,78],"score",22,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fjv6ngrlAYhA","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","trends","name","行业趋势","market","市场与销售",{"_75":76,"_13":77},"publicId","1077378b-a927-4b4d-88ac-2e8a8f214410","人社部公布一季度医药代表招聘月薪0.98万元","市场/销售","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669482&idx=1&sn=0c3baddc24556d83f535eeeb3ff0ce17&chksm=bcaf8d40b26908849162b3f9e7ae9fc8900452893a794cf349208ca8107469f1dec47d088ac5&scene=126&sessionid=1793855794#rd","赛柏蓝",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
