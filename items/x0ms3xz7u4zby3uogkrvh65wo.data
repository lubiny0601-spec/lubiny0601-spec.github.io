[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793888184000,"id","x0ms3xz7u4zby3uogkrvh65wo","title","第九届中国药品监管科学大会在京召开，国家药监局副局长王维东出席并讲话","originalTitle","第九届中国药品监管科学大会在京召开","summary","10月31日，中国药品监督管理研究会主办的第九届中国药品监管科学大会在京开幕，国家药监局党组成员、副局长王维东出席并讲话。大会以\"高水平安全、高质量发展——监管科学助力培育壮大生物医药新兴支柱产业\"为主题，设报告环节和14个分论坛，药品监管部门和学界业界1800余名代表参会。","reason","source",{"_61":68},"links",{"_57":67},"publishedAt","2026-10-31T00:00:00.000Z","discoveredAt","2026-11-02T09:52:08.166Z","timelineAt","category","policy","tags",[65,66],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-31/1109754.shtml","中国食品药品网·要闻",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
