[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795443811000,"id","lw2wnumh8jawt4jlowu9g512y","title","恒瑞医药芮弗西拜单抗（艾轻达）获NMPA批准用于纯合子型家族性高胆固醇血症","originalTitle","中国首个自主研发的ANGPTL3单抗艾轻达®获批！罕见病纯合子家族性高胆固醇血症患者迎来新希望","summary","恒瑞医药子公司北京盛迪医药的1类创新药芮弗西拜单抗注射液（商品名艾轻达）获NMPA批准上市，与低脂饮食和其他降脂药物合用，用于成人和12岁及以上青少年的纯合子型家族性高胆固醇血症（HoFH）降LDL-C。","reason","原文给出获批适应症与III期终点数值，读者可据此判断这款非LDLR依赖降脂药在HoFH治疗中的位置。","source",{"_67":82},"links",{"_58":81},"publishedAt","2026-11-13T00:00:00.000Z","discoveredAt","2026-11-23T04:25:02.669Z","timelineAt","category","approval","tags",[68,72,74,79,76,80],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_65":77,"_67":78},{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","approvals","name","获批上市","antibody","抗体与双抗","rare-disease","罕见病","cardiovascular","心血管","hengrui","恒瑞医药","nmpa","中国 NMPA","抗体/双抗","NMPA","https://www.hengrui.com/media/detail-1069.html","恒瑞医药·新闻",{"_84":85,"_86":-5,"_87":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
