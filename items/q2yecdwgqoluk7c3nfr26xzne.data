[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384595000,"id","q2yecdwgqoluk7c3nfr26xzne","title","山东淄博创新床位编码数字化管理 提升医保协议管理精细化水平","originalTitle","山东淄博创新床位编码数字化管理 提升协议管理精细化水平","summary","山东淄博市医保部门以18位唯一床位编码为核心搭建住院床位数字化管理体系，实现\"一床一码、全程可溯\"，未完成编码入库的床位不予医保结算。该市选取9家不同级别、性质医疗机构开展床位编码结算强校验试点，对无效、未备案、虚假床位编码实行刚性拦截。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-09T06:26:15.506Z","timelineAt","category","policy","tags",[65,66,67],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/5/art_287_23316.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
