[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793889552000,"id","j2sjdeykglwdcxhgcv66kp082","title","北京医保局启动第12批国家集采约定采购量分配，9月4日中午前完成提交","originalTitle","关于开展第12批国家组织药品集中带量采购约定采购量分配工作的通知","summary","北京市医疗保障局发布通知，组织参与第12批国家组织药品集中带量采购的医疗机构开展约定采购量分配，医疗机构须在即日起至2026年9月4日中午12时前通过国采平台完成填报确认并提交。","reason","通知明确了第12批国家集采分量规则与封顶机制，医疗机构可据此判断自身报量如何分配。","source",{"_62":72},"links",{"_58":71},"publishedAt","2026-08-28T00:00:00.000Z","discoveredAt","2026-10-27T16:01:16.754Z","timelineAt","category","policy","tags",[66,67,68,69,70],"score",67,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://ybj.beijing.gov.cn/zczxs/2020_ycgga/202608/t20260828_4840575.html","北京医保局·药品通知公告",{"_74":75,"_76":-5,"_77":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
