[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384582000,"id","dg7awav6zgsmqd3yukzu23meq","title","国内首个！天士力中药1.1类新药枣仁宁心滴丸获批上市，开拓睡眠维持困难新市场","originalTitle","国内首个，天士力重磅中药1类新药开拓新市场","summary","天士力中药1.1类新药枣仁宁心滴丸获批上市，是国内首个精准针对睡眠维持困难（时睡时醒）及伴有日间功能障碍的创新中药，处方源自国医大师张伯礼教授临床经验方。四项多中心、随机双盲、安慰剂对照临床试验显示，睡眠质量改善有效率最高89.2%，失眠严重程度改善有效率最高98.7%，日间功能改善有效率最高97.3%。产品采用滴丸固体分散技术，一日1次/1袋晚上服用，填补安神补脑中成药细分市场空白。","reason","source",{"_71":83},"links",{"_59":82},"publishedAt","2026-11-10T00:00:00.000Z","discoveredAt","2026-11-11T08:03:40.948Z","timelineAt","category","approval","tags",[72,74,81],"score",42,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f5fyj73oZuuc","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","approvals","name","获批上市","tcm","中药","neuroscience","神经与精神",{"_78":79,"_13":80},"publicId","5207877c-f13e-4cb7-a65c-f24c2c87654c","天士力枣仁宁心滴丸获批上市","神经/精神","https://www.menet.com.cn/info/202611/202611101610101010_151418.shtml","米内网·企业",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
