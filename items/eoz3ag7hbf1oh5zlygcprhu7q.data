[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":-5,"_55":35,"_56":57},"expiresAt",1793888176000,"id","eoz3ag7hbf1oh5zlygcprhu7q","title","直播预告丨感控文化怎么建设？从“要我感控”到“我要感控”的落地路径（第三季11期）","originalTitle","summary","感控S计划第三季第11期直播于10月22日19点开播，讲者立足本院多年感控文化建设实践，围绕务实、严谨、融合、创新四个维度介绍感控文化建设举措。内容涵盖四维文化建设思路解读、院内落地实践做法展示及文化推进难点剖析，并结合真实案例复盘，推动感控理念从“要我感控”向“我要感控”转变。","reason","source",{"_61":68},"links",{"_57":67},"publishedAt","2026-10-22T09:39:51.000Z","discoveredAt","2026-10-27T13:41:26.806Z","timelineAt","category","industry","tags",[63,64,65,66],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","SIFIC团队","body","outline",[],"relatedStories",[],"topics",[58],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_59":60,"_61":62},"slug","antibiotics","name","抗菌药物与耐药","其他","耐药与院感","抗感染","对品牌","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200193&idx=1&sn=898c006e2ece006f6a4dfdb079175ae2&chksm=82a2ad51a6b598e44aa9f4bb813edc124d154022df7cf21a1e4540907db44f1e0bcff9a88729&scene=126&sessionid=1793108467#rd","SIFIC 感染视界",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
