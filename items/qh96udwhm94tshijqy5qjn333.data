[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384582000,"id","qh96udwhm94tshijqy5qjn333","title","集采后药企商务体系如何重构：赛柏蓝上海实战班11月19-20日开课","originalTitle","集采后，药企商务彻底变了","summary","集采后医药企业商务板块正从后勤保障转向增长驱动，商务权责划分、渠道管控、库存止损与缺货断供应对成为普遍痛点。赛柏蓝定于11月19-20日在上海举办医药企业商务体系重构与销售增长实战班，提供四象限表、履约风险清单、返利设计模板、窜货取证流程、ROI测算表、KPI设计模板及体系重构路线图等落地工具。","reason","source",{"_70":82},"links",{"_59":81},"publishedAt","2026-11-07T12:15:14.000Z","discoveredAt","2026-11-09T06:32:53.285Z","timelineAt","category","industry","tags",[71,78,79,80],"score",10,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fwmMr-z1FWTs","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","company-news","name","公司动态","insurance","医保与集采",{"_75":76,"_13":77},"publicId","ed88d38b-ade0-436e-ba24-8b6d6fd90c98","赛柏蓝将在上海举办医药商务实战班","医保/集采","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669765&idx=6&sn=21c9fa34e6cd4ded8ef6a510cf13f94f&chksm=bc31d0a4de8849d528fd41ccff65bf2c878ababa615dd6a70104af45b4f90f45b26eda690142&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_84":85,"_86":-5,"_87":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
