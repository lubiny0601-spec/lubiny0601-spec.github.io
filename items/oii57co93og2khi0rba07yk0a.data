[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795443791000,"id","oii57co93og2khi0rba07yk0a","title","2026流感宣传月：从流感规范化诊疗到全院感控的临床实践要点","originalTitle","2026 流感宣传月丨守牢全院感控阵地：从流感规范化诊疗到全院管控的临床实践要点","summary","2026年流感季异常提前，第46周全国检出以甲流为主，A(H1N1)pdm09占比56.2%，H1N1阳性样本中13/17份存在G155E突变。抗病毒治疗应在发病48小时内启动，奥司他韦每日2次连用5天，玛巴洛沙韦全程单次口服。研究显示患者服用玛巴洛沙韦后家庭内传播风险从19.35%降至9.57%。","reason","source",{"_71":82},"links",{"_60":81},"publishedAt","2026-11-22T11:41:53.000Z","discoveredAt","2026-11-23T04:31:03.796Z","timelineAt","category","opinion","tags",[79,80],"score",38,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","感染在线","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fn-WDj-E9ljI","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","opinions","name","观点与解读","infectious","感染与疫苗",{"_76":77,"_13":78},"publicId","799f0b92-8345-4544-b8fb-07a85e314578","2026流感季提前，儿童流感防治要点发布","观点/解读","感染/疫苗","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200778&idx=1&sn=63cfc6f96472fd723f9da37f4930177c&chksm=827e348c584cd2d957dc95782b18944262876da74f712521370f8a95de7a1254b8fd27512c74&scene=126&sessionid=1795408256#rd","SIFIC 感染视界",{"_84":85,"_86":-5,"_87":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
