[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889554000,"id","ffg7wyyqdujmr5dt3g16q2x1r","title","IDSA与ESCMID发布2026版金黄色葡萄球菌菌血症临床实践指南，解答7个关键临床问题","originalTitle","IDSA Addresses Critical Questions on Staph aureus Bacteremia","summary","IDSA与ESCMID联合发布的2026版金黄色葡萄球菌菌血症（SAB）临床实践指南指出，现行\"复杂性/非复杂性\"SAB二分法不足以指导诊断评估与管理，建议按临床表现及深部感染灶、转移灶风险因素进行个体化分层。指南围绕7个临床问题给出共识声明，涵盖随访血培养、经胸/经食管超声心动图、全身影像学检查及抗生素疗程（低危及高危无深部病灶者均为14天）等。","reason","source",{"_61":72},"links",{"_57":71},"publishedAt","2026-08-02T12:49:10.691Z","discoveredAt","2026-10-28T01:14:46.511Z","timelineAt","category","policy","tags",[65,66,67,68,69,70],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","antibiotics","抗菌药物与耐药","政策/监管","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://www.contagionlive.com/view/idsa-addresses-critical-questions-on-staph-aureus-bacteremia","Contagion Live·抗菌药物管理",{"_74":75,"_76":-5,"_77":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
