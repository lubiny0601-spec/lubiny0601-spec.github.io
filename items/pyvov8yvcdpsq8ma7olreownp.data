[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795410124000,"id","pyvov8yvcdpsq8ma7olreownp","title","上海暂停南京泽恒医药舒更葡糖钠注射液采购资格","originalTitle","关于暂停南京泽恒医药技术开发有限公司舒更葡糖钠注射液采购资格的通知","summary","上海市医药集中招标采购事务管理所发布通知，因江苏省药监局检查发现南京泽恒医药技术开发有限公司委托亚邦医药股份有限公司生产的舒更葡糖钠注射液上市许可持有人与受托企业质量管理体系均存在缺陷、生产不符合要求，自2026年11月21日0时起暂停该品种两个规格（5ml:500mg、2ml:200mg）的采购资格。","reason","上海招采部门依据江苏药监检查结果暂停该品种采购资格，读者可据此了解集采中选药品的质量联动处置方式。","source",{"_64":73},"links",{"_58":72},"publishedAt","2026-11-20T00:00:00.000Z","discoveredAt","2026-11-23T04:24:56.909Z","timelineAt","category","policy","tags",[69,70,71],"score",55,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":67,"_64":68},{"_62":31,"_64":66},{"_62":63,"_64":65},"slug","safety","name","安全与质量","政策与监管","insurance","医保与集采","政策/监管","安全/质量","医保/集采","https://www.smpaa.cn/xxgk/gggs/2026/11/20/26272.shtml","上海阳光医药采购网",{"_75":76,"_77":-5,"_78":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
