[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791089000,"id","oix0jkjcdf2bm20vw0tf9b7qa","title","东芬兰大学研究：中年男性动物蛋白摄入越多，血清睾酮水平越低","originalTitle","中年男性，动物蛋白摄入越多，雄性激素越少？","summary","东芬兰大学等机构基于库奥皮奥地区缺血性心脏病危险因素研究中2546名42-60岁芬兰东部男性的数据发现，动物蛋白与植物蛋白摄入量同血清睾酮水平呈相反关联：动物蛋白摄入最高组总睾酮平均比最低组低1.2 nmol/L，植物蛋白摄入最高组则高1.1 nmol/L，SHBG浓度呈类似关联。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-15T00:00:00.000Z","discoveredAt","2026-11-16T00:55:13.214Z","timelineAt","category","research","tags",[78,79],"score",8,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fojLbpQ2XjGU","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","metabolic","代谢与减重",{"_75":76,"_13":77},"publicId","c346cc1d-8f32-4bd0-9e35-fd9621adf4e5","东芬兰大学研究：中年男性动物蛋白摄入与睾酮水平呈负相关","论文/研究","代谢/减重","https://news.bioon.com/article/5242964193e9.html","生物谷",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
