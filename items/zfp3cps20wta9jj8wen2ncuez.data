[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794205947000,"id","zfp3cps20wta9jj8wen2ncuez","title","剑桥大学与DIOSynVax利用AI开发广谱禽流感疫苗DVX-panH5Nx，临床前试验优于现有储备疫苗","originalTitle","Bird Flu Vaccine Developed Using AI Outperforms Current Stockpiled Vaccines in Preclinical Tests","summary","剑桥大学与衍生公司DIOSynVax利用AI引导工程开发出多抗原mRNA广谱禽流感疫苗DVX-panH5Nx，临床前试验中对多种全球流行的H5Nx变异株实现完全保护。相比之下，现有储备疫苗在暴露于多种H5N1变异株的动物中仅保护约50%。该疫苗整合HA、NA和M2抗原，在小鼠和雪貂中实现完全保护及更优存活率，结果发表于Cell Reports Medicine。","reason","source",{"_65":76},"links",{"_58":75},"publishedAt","2026-11-05T19:57:23.000Z","discoveredAt","2026-11-09T06:26:07.014Z","timelineAt","category","research","tags",[73,74,68,70],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","Sophia Ktori","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","papers","name","论文研究","ai-pharma","AI 制药","nucleic","核酸药物","infectious","感染与疫苗","论文/研究","感染/疫苗","https://www.genengnews.com/topics/infectious-diseases/bird-flu-vaccine-developed-using-ai-outperforms-current-stockpiled-vaccines-in-preclinical-tests/","GEN Genetic Engineering & Biotechnology News",{"_78":79,"_80":-5,"_81":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
