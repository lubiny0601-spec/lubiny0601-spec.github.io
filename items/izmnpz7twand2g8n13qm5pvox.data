[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384595000,"id","izmnpz7twand2g8n13qm5pvox","title","CDE公示将人源多巴胺能前体细胞注射液纳入\"关爱计划-延伸\"试点项目","originalTitle","CDE公示将人源多巴胺能前体细胞注射液纳入“关爱计划-延伸”试点项目","summary","CDE 11月3日公示，拟将睿健毅联医药科技（成都）有限公司的人源多巴胺能前体细胞注射液纳入\"关爱计划-延伸\"试点项目，拟开发适应症为多系统萎缩帕金森型，公示期截至2026年11月10日。该公示依据《罕见疾病创新药物研发鼓励试点计划（\"关爱计划-延伸\"）申报指南》发布，异议可发送至指定邮箱。","reason","source",{"_72":90},"links",{"_59":89},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T15:25:10.273Z","timelineAt","category","policy","tags",[86,77,75,87,88],"score",20,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","body","outline",[],"relatedStories",[82],"topics",[66,67,68,69,70],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fjQ0UFTzwpRk","reportCount",1,"additionalSourceCount",0,{"_71":80,"_72":81},{"_71":78,"_72":79},{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","政策与监管","cell-gene","细胞与基因治疗","rare-disease","罕见病","neuroscience","神经与精神","nmpa","中国 NMPA",{"_83":84,"_13":85},"publicId","5b436d69-883c-4a28-8af1-c681b2b7dd31","CDE公示细胞注射液拟入关爱计划延伸试点","政策/监管","NMPA","神经/精神","https://www.cnpharm.com/c/2026-11-03/1109878.shtml","中国食品药品网·要闻",{"_92":93,"_94":-5,"_95":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
