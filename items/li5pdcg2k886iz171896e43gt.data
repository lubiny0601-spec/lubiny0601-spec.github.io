[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795410149000,"id","li5pdcg2k886iz171896e43gt","title","中国创新药对外授权前三季度约1300亿美元，NMPA今年已批准69个创新药上市","originalTitle","对外授权日益活跃，中国创新药价值获全球重估","summary","今年前三季度中国创新药对外授权交易额约1300亿美元，接近去年全年水平。国家药监局数据显示，今年以来69个创新药获批上市，其中15个为新机制、新靶点首创新药，包括全球首款放射性创新药锝[99mTc]佩昔瑞特加肽注射液、全球首个XI因子抑制剂阿舒克森片等。2025年全国登记新药临床试验2997项，细胞与基因治疗药物临床试验数量同比增长约30%。","reason","source",{"_66":81},"links",{"_57":80},"publishedAt","2026-11-14T00:00:00.000Z","discoveredAt","2026-11-16T00:55:14.778Z","timelineAt","category","opinion","tags",[78,67,79,75,71,73],"score",38,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":76,"_66":77},{"_64":74,"_66":75},{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","trends","name","行业趋势","opinions","观点与解读","radiopharma","放射性药物","small-molecule","小分子","cell-gene","细胞与基因治疗","nmpa","中国 NMPA","观点/解读","NMPA","https://www.cnpharm.com/c/2026-11-14/1110512.shtml","中国食品药品网·要闻",{"_83":84,"_85":-5,"_86":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
