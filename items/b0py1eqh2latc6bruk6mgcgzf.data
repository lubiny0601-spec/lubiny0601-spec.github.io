[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795410125000,"id","b0py1eqh2latc6bruk6mgcgzf","title","2026版国家医保药品目录与第二批商保创新药目录将于11月14日公布","originalTitle","2026版医保药品目录、第二批商保创新药目录即将发布","summary","2026年国家医保药品目录调整与第二批商保创新药目录制定同步推进，新版双目录将于11月14日正式公布。本轮延续准备、申报、专家评审、谈判协商、结果公布五大流程，整体节奏前置，并新增创新药预申报通道，允许技术审评通过、尚未取得上市批件的品种提前申报，同时优化调出规则。","reason","本轮调整新增创新药预申报通道并同步推进商保目录，读者可据此判断品种院内准入与院外支付路径的变化。","source",{"_62":70},"links",{"_58":69},"publishedAt","2026-11-14T01:51:16.000Z","discoveredAt","2026-11-16T01:00:53.800Z","timelineAt","category","policy","tags",[66,67,68],"score",72,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699657&idx=1&sn=2dea2747d7b9808d32f40fcbed36b181&chksm=bcd566175a091f2eb725ac28f50c3464e970cd6c05edbca1f5cf3cb5ebb6dd40766b131d008d&scene=126&sessionid=1794790832#rd","医药云端工作室",{"_72":73,"_74":-5,"_75":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
