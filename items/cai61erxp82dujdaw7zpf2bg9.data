[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384589000,"id","cai61erxp82dujdaw7zpf2bg9","title","POET II 试验：感染性心内膜炎按疗效调整的短程抗生素治疗与更长生存相关但复发率更高","originalTitle","Patients With Infective Endocarditis Survived Longer with Shorter Period of Antibiotic Treatment","summary","国际随机对照 POET II 试验显示，初始抗生素治疗 2–4 周后临床稳定的左心感染性心内膜炎患者，按疗效调整的短程继续抗生素方案较标准最长 6 周方案生存更久，6 个月内无抗生素治疗或无菌血症天数为 183 天 vs 169 天。短程组主要安全性复合终点（全因死亡、非计划心脏手术或症状性栓塞事件）非劣于标准组（21 例 vs 27 例），但复发更常见（5.1% vs 1.6%）。","reason","source",{"_64":78},"links",{"_57":77},"publishedAt","2026-08-31T12:41:50.489Z","discoveredAt","2026-10-27T15:41:44.474Z","timelineAt","category","research","tags",[72,73,71,74,75,76],"score",38,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":70,"_64":71},{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","infectious","感染与疫苗","cardiovascular","心血管","论文/研究","抗菌药物","感染/疫苗","抗感染","循证指南","https://www.contagionlive.com/view/patients-with-infective-endocarditis-survived-longer-with-shorter-period-of-antibiotic-treatment","Contagion Live·抗菌药物管理",{"_80":81,"_82":-5,"_83":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
