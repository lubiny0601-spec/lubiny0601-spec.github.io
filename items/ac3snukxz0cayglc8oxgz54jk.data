[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795408365000,"id","ac3snukxz0cayglc8oxgz54jk","title","恒瑞医药瑞普泊肽注射液GEMINI-1 Ⅲ期研究结果登顶《美国医学会杂志》","originalTitle","瑞普泊肽注射液Ⅲ期研究结果登顶《美国医学会杂志》","summary","恒瑞医药自主研发的GLP-1/GIP双重受体激动剂瑞普泊肽注射液，其GEMINI-1 Ⅲ期研究结果全文发表于《美国医学会杂志》（JAMA）。该多中心、随机、双盲、安慰剂平行对照研究在中国55个研究中心入组567名成人肥胖和超重患者，6mg组治疗48周后体重较基线降低19.2%且未达平台期，腰围缩减14.4厘米。瑞普泊肽用于成人长期体重管理的上市申请已于2025年9月在国内获受理。","reason","source",{"_63":72},"links",{"_58":71},"publishedAt","2026-11-17T08:41:03.000Z","discoveredAt","2026-11-23T04:24:45.543Z","timelineAt","category","clinical","tags",[64,69,70,68],"score",40,"selected",false,"channel","news","story","x","readingMode","full","author","永恒","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":30,"_63":64},"slug","name","临床进展","metabolic","代谢与减重","hengrui","恒瑞医药","代谢/减重","GLP-1","https://www.drugtimes.cn/2026/11/17/ruipupotaizhusheyeqiyanjiujieguodengdingmeiguoyixuehuiza/","药时代",{"_74":75,"_76":-5,"_77":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
