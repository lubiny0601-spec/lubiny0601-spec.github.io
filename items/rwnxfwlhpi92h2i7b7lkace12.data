[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794384581000,"id","rwnxfwlhpi92h2i7b7lkace12","title","上海启动第十二批国家集采未中选药品梯度降价填报，11月17日前未调价将暂停采购","originalTitle","关于开展第十二批国家组织药品集中带量采购本市未中选药品梯度降价工作的通知","summary","上海阳光医药采购网开通第十二批国家集采未中选已挂网药品申报价填报通道，价格确认时间为2026年11月11日至11月17日。已挂网参比制剂和过评药品按系统参考治理价调整申报价，未过评药品按不高于本市有约定采购量中选药品最低价依差比价规则计算，中选产品非供应清单内的二同药品按其中选价格依差比价规则计算。","reason","上海对第十二批国家集采未中选药品设梯度降价与暂停采购规则，涉及参比制剂、过评和未过评三类价格口径。","source",{"_70":83},"links",{"_60":82},"publishedAt","2026-11-11T00:00:00.000Z","discoveredAt","2026-11-11T08:03:41.113Z","timelineAt","category","policy","tags",[78,79,80,81],"score",72,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fEH9a7yyhxcw","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","政策与监管","insurance","医保与集采",{"_75":76,"_13":77},"publicId","7d11c560-d5b9-4103-b145-e9ae8c62224e","上海开展第十二批国家集采未中选药品梯度降价","政策/监管","医保/集采","抗感染","市场准入","https://www.smpaa.cn/xxgk/gggs/2026/11/11/25805.shtml","上海阳光医药采购网",{"_85":86,"_87":-5,"_88":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
