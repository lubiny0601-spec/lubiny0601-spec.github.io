[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889556000,"id","cktuy1bm7a4u07q3s6ajuywnd","title","CDC报告纽约市两例耐药性癣病例","originalTitle","Two Cases of Drug-Resistant Ringworm In New York City","summary","CDC在最新一期MMWR中报告纽约市出现2例由T indotineae引起的耐药性癣病例，其中一例无近期国际旅行史，提示该菌可能已在美国本土传播。两例患者对口服特比萘芬均未获改善，一例经4周伊曲康唑治疗后皮疹消退，另一例在灰黄霉素治疗下改善约80%。","reason","source",{"_62":73},"links",{"_57":72},"publishedAt","2023-05-11T21:47:27.721Z","discoveredAt","2026-10-28T01:14:48.448Z","timelineAt","category","research","tags",[66,67,68,69,70,71],"score",15,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","论文/研究","抗真菌","耐药与院感","抗感染","循证指南","对市场","https://www.contagionlive.com/view/two-cases-of-drug-resistant-ringworm-report-in-new-york-city","Contagion Live·医院感染",{"_75":76,"_77":-5,"_78":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
