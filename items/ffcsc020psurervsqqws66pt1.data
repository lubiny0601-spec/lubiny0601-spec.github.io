[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205952000,"id","ffcsc020psurervsqqws66pt1","title","达托霉素耐药屎肠球菌菌血症：肝移植患者复发后的处理策略","originalTitle","When Daptomycin Fails: Practical Approaches to Resistant Enterococcus faecium","summary","肝移植患者在接受高剂量达托霉素、腹腔冲洗和胆道支架置入后仍出现达托霉素耐药屎肠球菌（DREfm）菌血症复发，药敏显示对利奈唑胺、替加环素和依拉环素敏感。DREfm在血液恶性肿瘤或肝移植受者中的VREfm感染占比可达35%，既往达托霉素暴露与耐药风险升高达30倍相关。处理需确认临床意义并积极控制感染源，利奈唑胺是FDA唯一批准用于VREfm感染的药物。","reason","source",{"_62":73},"links",{"_57":72},"publishedAt","2026-08-16T13:19:09.436Z","discoveredAt","2026-10-28T01:14:46.484Z","timelineAt","category","opinion","tags",[66,67,68,69,70,71],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","opinions","name","观点与解读","antibiotics","抗菌药物与耐药","观点/解读","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://www.contagionlive.com/view/when-daptomycin-fails-practical-approaches-to-resistant-enterococcus-faecium","Contagion Live·抗菌药物管理",{"_75":76,"_77":-5,"_78":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
