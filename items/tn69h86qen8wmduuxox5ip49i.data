[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889556000,"id","tn69h86qen8wmduuxox5ip49i","title","CDC：2020-2021年新冠相关真菌感染院内死亡率达48.5%，显著高于非新冠相关感染","originalTitle","During the Pandemic, COVID-19–Associated Fungal Infections Had Higher In-Hospital Mortality","summary","CDC报告显示，2020-2021年新冠相关真菌感染患者院内死亡率为48.5%，非新冠相关真菌感染为12.3%。新冠相关真菌住院占全部真菌住院的13.4%，ICU入住率约为非新冠相关的2倍、院内死亡率约为4倍，以侵袭性念珠菌病和曲霉病为主。数据来自Premier Healthcare Database，作者认为新冠相关免疫失调及糖皮质激素等免疫抑制治疗是重要风险因素。","reason","source",{"_62":73},"links",{"_57":72},"publishedAt","2023-06-22T20:21:02.352Z","discoveredAt","2026-10-27T15:41:45.009Z","timelineAt","category","research","tags",[66,67,68,69,70,71],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","论文/研究","抗真菌","耐药与院感","抗感染","循证指南","对市场","https://www.contagionlive.com/view/during-the-pandemic-covid-19-associated-fungal-infections-had-higher-in-hospital-mortality","Contagion Live·医院感染",{"_75":76,"_77":-5,"_78":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
