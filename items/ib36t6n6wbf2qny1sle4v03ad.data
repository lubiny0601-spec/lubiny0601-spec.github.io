[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384583000,"id","ib36t6n6wbf2qny1sle4v03ad","title","每周医药看点（11月2日—8日）：罕见病目录制订程序2026年版印发，海创药业HP570达成独家授权","originalTitle","每周医药看点（11月2日—8日）","summary","11月2日—8日，国家卫生健康委办公厅、国家中医药局综合司印发《罕见病目录制订工作程序（2026年版）》，明确目录病种纳入条件与调整程序。海创药业将口服VAV1分子胶降解剂HP570授权给Evommune，获3000万美元首付款及最高10.7亿美元里程碑付款；明慧医药将靶向IGF-1R的MHB018A日本权益授予ASKA，获1.1亿美元首付款及最高3.3亿美元里程碑付款。","reason","source",{"_68":91},"links",{"_57":90},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-09T06:26:07.580Z","timelineAt","category","industry","tags",[84,69,81,77,85,86,87,75,88,89],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61,62,63,64,65],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_66":82,"_68":83},{"_66":80,"_68":81},{"_66":78,"_68":79},{"_66":76,"_68":77},{"_66":74,"_68":75},{"_66":72,"_68":73},{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","trends","name","行业趋势","policy","政策与监管","insurance","医保与集采","ai-pharma","AI 制药","tcm","中药","adc","ADC 与偶联药物","rare-disease","罕见病","metabolic","代谢与减重","政策/监管","医保/集采","GLP-1","ADC","NMPA","FDA","https://www.cnpharm.com/c/2026-11-09/1110133.shtml","中国食品药品网·要闻",{"_93":94,"_95":-5,"_96":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
