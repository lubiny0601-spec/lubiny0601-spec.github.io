[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":52,"_53":-5,"_54":35,"_55":56},"expiresAt",1793889565000,"id","rxf9icfsubmbm491icnibpv1d","title","CDE公开征求《疫苗非临床研究技术指导原则（征求意见稿）》意见","originalTitle","summary","CDE于10月23日发布《疫苗非临床研究技术指导原则（征求意见稿）》，公开征求意见和建议，反馈时限为自发布之日起1个月。该指导原则旨在规范和指导疫苗的非临床研究与评价，基于前期调研及当前科学认知与国内外研发监管经验起草。意见可发送至指定邮箱反馈。","reason","source",{"_63":75},"links",{"_56":74},"publishedAt","2026-10-24T00:00:00.000Z","discoveredAt","2026-10-28T15:39:01.322Z","timelineAt","category","policy","tags",[70,71,72,73],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":68,"_63":69},{"_61":66,"_63":67},{"_61":29,"_63":65},{"_61":62,"_63":64},"slug","pipeline","name","研发管��","政策与监管","infectious","感染与疫苗","nmpa","中国 NMPA","政策/监管","感染/疫苗","研发管线","NMPA","https://www.cnpharm.com/c/2026-10-24/1109530.shtml","中国食品药品网·要闻",{"_77":78,"_79":-5,"_80":52},"changelogVersion","2026-10-08T08:00","release","staticSite"]
