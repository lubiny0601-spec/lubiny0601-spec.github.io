[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1793888171000,"id","i02u4hpugvk7m0bazm8ocvs8v","title","北京医保局发文执行第十二批国家集采中选结果，11月28日起全面落地","originalTitle","北京市医疗保障局关于执行第十二批国家组织药品集中带量采购中选结果有关工作的通知","summary","北京市医保局通知执行第十二批国家组织药品集采中选结果，2026年11月21日0时招采子系统统一调整中选药品采购价格，11月28日0时起全面执行中选结果及医保支付标准，采购周期至2029年12月31日。通知明确因抗菌药物使用限制等导致临床需求重大变化的，考核以使用比例代替使用数量；医疗机构反映中选药品供应问题并经核实公示后，采购其他中选企业药品可视作采购该中选药品并享受医保资金结余留用政策。","reason","北京落地第十二批国家集采的执行细则，明确了价格调整、医保支付标准与考核口径的变化。","source",{"_70":84},"links",{"_60":83},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T15:25:05.573Z","timelineAt","category","policy","tags",[78,79,80,81,82],"score",85,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fmAwgLpIM-DQ","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","政策与监管","insurance","医保与集采",{"_75":76,"_13":77},"publicId","dbc17da7-53e4-4600-bce8-b7f1ee1e75f0","北京医保局部署第十二批国家集采落地","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://ybj.beijing.gov.cn/zczxs/2020_ycgga/202611/t20261103_4931207.html","北京医保局·药品通知公告",{"_86":87,"_88":-5,"_89":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
