[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443810000,"id","f3gn6cx754vzsdle5m4dchl6n","title","CDE公示亘喜生物GC012F注射液纳入“关爱计划-延伸”试点项目，拟开发复发或难治性轻链型淀粉样变性","originalTitle","CDE公示GC012F注射液纳入“关爱计划-延伸”试点项目","summary","CDE于11月13日公示将亘喜生物科技（上海）有限公司的GC012F注射液纳入“关爱计划-延伸”试点项目，拟开发适应症为复发或难治性轻链型淀粉样变性，公示期截至2026年11月20日。该公示依据《罕见疾病创新药物研发鼓励试点计划（“关爱计划-延伸”）申报指南》发布，异议可发送至指定邮箱。","reason","source",{"_63":74},"links",{"_57":73},"publishedAt","2026-11-14T00:00:00.000Z","discoveredAt","2026-11-16T00:55:14.813Z","timelineAt","category","policy","tags",[71,68,66,72],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":69,"_63":70},{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":30,"_63":64},"slug","name","政策与监管","cell-gene","细胞与基因治疗","rare-disease","罕见病","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-14/1110505.shtml","中国食品药品网·要闻",{"_76":77,"_78":-5,"_79":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
