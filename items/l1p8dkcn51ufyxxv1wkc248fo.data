[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888187000,"id","l1p8dkcn51ufyxxv1wkc248fo","title","恒瑞医药HRS-8046片获NMPA临床试验批准，拟用于KRAS G12D突变实体瘤","originalTitle","恒瑞医药｜恒瑞医药关于获得药物临床试验批准通知书的公告","summary","恒瑞医药子公司成都盛迪医药、上海恒瑞医药的HRS-8046片获NMPA核准签发《药物临床试验批准通知书》，同意单药在携带KRAS G12D突变的实体瘤中开展临床试验。该药为公司自主研发的创新型抗肿瘤药物，目前国内外尚无同类药物上市，相关项目累计研发投入约1,540万元（未经审计）。","reason","source",{"_73":89},"links",{"_59":88},"publishedAt","2026-10-28T16:00:00.000Z","discoveredAt","2026-10-28T15:38:58.451Z","timelineAt","category","clinical","tags",[75,86,77,79,87],"score",20,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","body","outline",[],"relatedStories",[82],"topics",[66,67,68,69,70],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fzVKsV0yz12c","reportCount",1,"additionalSourceCount",0,{"_71":80,"_73":81},{"_71":78,"_73":79},{"_71":76,"_73":77},{"_71":30,"_73":75},{"_71":72,"_73":74},"slug","pipeline","name","研发管��","临床进展","oncology","肿瘤","hengrui","恒瑞医药","nmpa","中国 NMPA",{"_83":84,"_13":85},"publicId","16038233-6ff9-433c-8be8-8d5b75934b2b","恒瑞HRS-8046片获批开展KRAS G12D实体瘤临床试验","研发管线","NMPA","https://static.cninfo.com.cn/finalpage/2026-10-29/1225636071.PDF","恒瑞医药·公司公告",{"_91":92,"_93":-5,"_94":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
