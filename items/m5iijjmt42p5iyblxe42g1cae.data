[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794384581000,"id","m5iijjmt42p5iyblxe42g1cae","title","中疾控第44周监测：流感活动波动上升，A(H1N1)占比上升，多毒株共同流行","originalTitle","最新丨流感活动开始波动上升！王大燕、李侗曾：今年多毒株共同活跃；H1N1占比呈上升趋势，后续优势毒株存在转换可能","summary","中疾控发布2026年第44周全国急性呼吸道传染病哨点监测，门急诊流感样病例呼吸道样本阳性率前三位为流感病毒（15.6%）、鼻病毒（11.4%）、人偏肺病毒（4.3%），住院严重急性呼吸道感染病例为鼻病毒（10.1%）、流感病毒（6.1%）、人偏肺病毒（4.4%）。","reason","中疾控第44周监测显示流感阳性率15.6%，H1N1占比上升，读者可据此判断流感季用药与备货节奏。","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-11-06T06:37:40.000Z","discoveredAt","2026-11-09T06:31:05.149Z","timelineAt","category","policy","tags",[66,67],"score",62,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","infectious","感染与疫苗","政策/监管","感染/疫苗","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604505&idx=1&sn=38c1bebc6d142aa1efd19e857678fb7e&chksm=fcf06319f4f65eb380808030b88a4b687887460b4cb7b9168431c3b7d20995e2c6121473cfd5&scene=126&sessionid=1794205843#rd","呼吸界",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
