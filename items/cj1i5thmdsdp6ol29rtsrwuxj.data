[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793889547000,"id","cj1i5thmdsdp6ol29rtsrwuxj","title","Ribbon Bio 推出无细胞 DNA 组装技术 MiroMine，摆脱细菌宿主限制","originalTitle","Building Custom DNA without Bacterial Constraints","summary","Ribbon Bio 推出 MiroMine 试剂盒，以无细胞组装技术替代细菌扩增来构建定制 DNA，早期版本可合成约 7 kb 的分子，仅需标准实验室硬件。公司自测显示，约 3.4 kb 和 6.8 kb 的分子测序 reads 100% 序列正确，约 4 kb 构建体为 88%，内毒素水平≤0.1 units/µg，未检出细菌基因组 DNA。","reason","source",{"_71":81},"links",{"_60":80},"publishedAt","2026-11-04T18:45:05.000Z","discoveredAt","2026-11-05T05:13:23.190Z","timelineAt","category","industry","tags",[72,79],"score",8,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Kathy Vuksanaj","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","f9r1fzmUHnXw","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","company-news","name","公司动态","antibody","抗体与双抗",{"_76":77,"_13":78},"publicId","74f9f821-93f3-494b-bcb4-f9d6001f5804","Ribbon Bio推出无细胞DNA合成试剂盒MiroMine","抗体/双抗","https://www.genengnews.com/sponsored/building-custom-dna-without-bacterial-constraints/","GEN Genetic Engineering & Biotechnology News",{"_83":84,"_85":-5,"_86":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
