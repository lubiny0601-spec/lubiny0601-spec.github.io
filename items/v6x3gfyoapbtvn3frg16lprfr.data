[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443791000,"id","v6x3gfyoapbtvn3frg16lprfr","title","第15届医药健康互联网大会·蓝亭叙2026将在杭州举办，聚焦医药电商全域增长","originalTitle","医药电商太难了","summary","第15届医药健康互联网大会·蓝亭叙2026将于11月28-30日在杭州举办，围绕医药电商品效销全域增长展开。京东健康、哈药、好药师B2C的实战操盘手将分享流量获取、私域运营、医生IP打造及抖音小红书爆单打法，并拆解从公域种草到私域变现、B2C与O2O联动及AI提效的全链路。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-22T11:08:04.000Z","discoveredAt","2026-11-23T04:32:24.127Z","timelineAt","category","industry","tags",[71,78,79],"score",8,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fprfJgyaonR0","reportCount",7,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","trends","name","行业趋势","market","市场与销售",{"_75":76,"_13":77},"publicId","fc8ce772-0c1b-487e-bdbe-1be471cae4a6","赛柏蓝杭州医药健康互联网大会日期说法不一","市场/销售","哈药股份","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653671478&idx=4&sn=80405a56de9e87b32d4cbfe984154bfa&chksm=bcf9ebaf109148fe76bfedd9d58ad1811c6b7655d73f03b61b1dc9c3de9a133a013bc890cc94&scene=126&sessionid=1795408256#rd","赛柏蓝",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
