[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443805000,"id","fsjjrskjg8ksir6am4hqxgi5r","title","药品注册检验改革一周年：奥普雷顿片中国首发，罕见病药品检验样品降幅达78%","originalTitle","药检加速度 改革见成效 药品注册检验改革一周年回眸","summary","药品注册检验改革实施一周年，武田制药1型发作性睡病创新药奥普雷顿片借助新规实现中国率先获批并开出首批处方，其注册检验样品需求减少约78%。《规范》将常规药品每批样品量由3倍减为2倍、罕见病药品由3批9倍量减为1批2倍量，降幅分别为33%和78%。一年内药检系统受理优先审评品种64个，平均检验用时61个工作日，较法定时限缩短23.8%。","reason","source",{"_63":72},"links",{"_57":71},"publishedAt","2026-11-20T00:00:00.000Z","discoveredAt","2026-11-23T04:24:52.562Z","timelineAt","category","policy","tags",[68,69,67,64,70],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":66,"_63":67},{"_61":30,"_63":65},{"_61":62,"_63":64},"slug","trends","name","行业趋势","政策与监管","rare-disease","罕见病","政策/监管","NMPA","武田","https://www.cnpharm.com/c/2026-11-20/1111076.shtml","中国食品药品网·要闻",{"_74":75,"_76":-5,"_77":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
