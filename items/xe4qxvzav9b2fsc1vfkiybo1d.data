[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384582000,"id","xe4qxvzav9b2fsc1vfkiybo1d","title","上海市药事所11月19日举办“政府开放日”活动，分科室现场接待企业咨询","originalTitle","[11-11]关于11月份市药事所开展“政府开放日”活动的通知","summary","上海市医药集中招标采购事务管理所定于11月19日14:00—17:00在局门路622号举办“政府开放日”专项互动答疑活动，由联采科、药采科、耗材科、监督科分科室现场接待企业。企业代表当日13:30起在一楼服务大厅按业务对应科室取号排队，每家企业原则上安排1名业务人员到场。现场可即时答复的咨询即时回应，需核查、流转处置的诉求统一登记台账。","reason","source",{"_69":80},"links",{"_59":79},"publishedAt","2026-11-11T00:00:00.000Z","discoveredAt","2026-11-11T08:03:41.104Z","timelineAt","category","policy","tags",[77,78],"score",12,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fEkapNPLDGoc","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","insurance","医保与集采",{"_74":75,"_13":76},"publicId","5c409777-5bf3-408d-b8c1-e013797d4623","上海市药事所举办政府开放日答疑活动","政策/监管","医保/集采","https://www.smpaa.cn/xxgk/gggs/2026/11/11/25806.shtml","上海阳光医药采购网",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
