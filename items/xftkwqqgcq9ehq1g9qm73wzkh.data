[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795408364000,"id","xftkwqqgcq9ehq1g9qm73wzkh","title","黑石生命科学最高投入15亿美元，支持辉瑞GLP-1在研药Berobenatide开发","originalTitle","15亿美元加码！黑石押注辉瑞百亿竞购的GLP‑1重磅资产","summary","2026年11月11日，辉瑞与黑石生命科学达成研发共担战略融资协议，黑石旗下管理基金将在2028年前最高投入15亿美元，支持一月一次给药的GLP-1受体激动剂多肽Berobenatide（PF'3944）开发。","reason","黑石以研发共担方式注资辉瑞GLP-1管线，读者可据此了解该资产的资金来源与权属安排。","source",{"_73":87},"links",{"_61":86},"publishedAt","2026-11-12T03:22:34.000Z","discoveredAt","2026-11-12T14:18:51.329Z","timelineAt","category","industry","tags",[83,84,85,78],"score",58,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","yian","body","outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fFWOHo0Mu6c0","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","deals","name","交易与授权","metabolic","代谢与减重","pfizer","辉瑞",{"_80":81,"_13":82},"publicId","652eea75-42c8-431b-a795-2b098295cc61","辉瑞与黑石达成Berobenatide研发共担融资协议","交易/授权","代谢/减重","GLP-1","https://www.drugtimes.cn/2026/11/12/15yimeiyuanjiamaheishiyazhuhuiruibaiyijinggoudeglp1zhongbang/","药时代",{"_89":90,"_91":-5,"_92":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
