[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793889547000,"id","wv1b2ibhzhnayvsy5peuy235h","title","瑞士团队开发微型生物阻抗传感器，实现小规模生物工艺活细胞密度实时监测","originalTitle","Small Bioprocess Monitoring Hits the Goldilocks Zone","summary","瑞士东部应用科技大学Yves Mermoud团队报告了一款概念验证型微型活细胞密度传感器，采用1 x 10 mm、25 µL工作体积的生物阻抗芯片，在CHO细胞测试中与参考细胞计数呈强相关（R² = 0.92），检测限约0.5 × 10⁶ cells mL⁻¹。","reason","source",{"_71":82},"links",{"_60":81},"publishedAt","2026-11-04T17:00:35.000Z","discoveredAt","2026-11-05T05:13:23.204Z","timelineAt","category","research","tags",[79,80],"score",8,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Corinna Singleman, PhD","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","flna9wrGvhy4","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","device-ivd","医疗器械与 IVD",{"_76":77,"_13":78},"publicId","0dcd8d86-f568-4983-ba9b-01702f425f15","瑞士团队报告微型活细胞密度传感器概念验证","论文/研究","医疗器械/IVD","https://www.genengnews.com/topics/bioprocessing/small-bioprocess-monitoring-hits-the-goldilocks-zone/","GEN Genetic Engineering & Biotechnology News",{"_84":85,"_86":-5,"_87":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
