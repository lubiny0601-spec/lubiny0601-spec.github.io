[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":52,"_53":-5,"_54":35,"_55":56},"expiresAt",1794791110000,"id","p1flqpvx28ao0i62w9f094exz","title","恒瑞医药连续两年蝉联《中国医药创新指数》创新力与发明力双榜榜首","originalTitle","summary","恒瑞医药在2026《中国医药创新指数》发布会上连续两年蝉联创新力与发明力双榜榜首，该指数从0到1源头突破与1到N成果转化双维度评价企业。公司累计研发投入超600亿元、占营收比重超25%，已在中国获批27款1类新药、6款2类新药，100多个自主创新产品在临床开发中。今年前三季度创新药销售收入138.71亿元，同比增长17.05%，占药品销售收入比重升至64.59%。","reason","source",{"_62":69},"links",{"_56":68},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-12T14:19:46.839Z","timelineAt","category","industry","tags",[65,67,63],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":66,"_62":67},{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","trends","name","行业趋势","company-news","公司动态","hengrui","恒瑞医药","https://www.hengrui.com/media/detail-1064.html","恒瑞医药·新闻",{"_71":72,"_73":-5,"_74":52},"changelogVersion","2026-10-08T08:00","release","staticSite"]
