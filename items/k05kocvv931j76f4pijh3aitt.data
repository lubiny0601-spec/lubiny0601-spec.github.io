[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384600000,"id","k05kocvv931j76f4pijh3aitt","title","山东大学齐鲁医院医保码实现全院一码通用，结算提速至秒级","originalTitle","【山东】一码走全院 结算秒完成——山东大学齐鲁医院医保服务便民纪实","summary","山东大学齐鲁医院打通医院管理、医保、银行交易等系统，推动医保码覆盖挂号、就诊、结算全流程，实现\"一码通用\"。医院将门诊慢特病病种知识库和3万余条医保支付范围规则嵌入系统，结算时自动完成合规校验，单次结算时间从数分钟压缩到秒级，住院患者床旁结算率超过90%。","reason","source",{"_69":79},"links",{"_59":80},"publishedAt","2026-10-28T00:00:00.000Z","discoveredAt","2026-10-28T15:38:58.451Z","timelineAt","category","policy","tags",[77,78,79],"score",12,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f6_SpPp0kSJQ","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","insurance","医保与集采",{"_74":75,"_13":76},"publicId","5b0e0f62-23b7-49f5-8ba4-12d377752d5a","齐鲁医院医保码全院通用，结算缩至秒级","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/9/28/art_14_22381.html",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
