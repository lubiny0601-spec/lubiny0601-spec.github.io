[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794384581000,"id","ym9mnsdv52lj78qexfradenme","title","荃信生物将TL1A/IL-17双抗授权给Caldera，首付款3000万美元、里程碑最高7.5亿美元","originalTitle","7.8亿美元！荃信自免双抗再次出海Caldera","summary","荃信生物与Caldera Therapeutics就一款靶向TL1A、IL-17的临床前双特异性抗体签署独家授权协议，Caldera获得全球独家开发、申报注册、生产与商业化权益。荃信将收到3000万美元一次性首付款，后续达成临床开发、监管审批及商业化里程碑还可获得最高7.5亿美元付款。这是双方继IL-23p19/TL1A双抗QX030N/CLD-423（总金额可达5.55亿美元）之后的再度合作。","reason","荃信与Caldera二次合作，首付款与里程碑结构可对照此前QX030N交易看自免双抗出海的定价逻辑。","source",{"_65":75},"links",{"_59":74},"publishedAt","2026-11-06T01:43:00.000Z","discoveredAt","2026-11-09T06:26:03.896Z","timelineAt","category","industry","tags",[71,72,73],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","yian","body","outline",[],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","deals","name","交易与授权","antibody","抗体与双抗","immunology","自免与炎症","交易/授权","自免","抗体/双抗","https://www.drugtimes.cn/2026/11/06/78yimeiyuanquanxinzimianshuangkangzaicichuhaicaldera/","药时代",{"_77":78,"_79":-5,"_80":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
