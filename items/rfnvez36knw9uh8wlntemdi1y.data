[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1793888172000,"id","rfnvez36knw9uh8wlntemdi1y","title","欧康维视氟轻松玻璃体内植入剂优施莹地产化获 NMPA 批准","originalTitle","这款眼科植入剂，从进口独家到地产化，难在哪里？未来机会何在？","summary","10月27日，欧康维视宣布氟轻松玻璃体内植入剂（优施莹）地产化注册申请获国家药监局批准，未来可在境内商业化生产供应。该药2022年6月以进口5.1类获批，用于累及眼后段的慢性非感染性葡萄膜炎，2023年通过国谈进入医保目录；此次由苏州欧康维视以化学药品4类仿制路径申报（受理号CYHS2502987，2025年8月承办，国药准字H20266424），分子、剂型、适应症未变。","reason","从进口独家到苏州地产化，材料拆解了眼科缓释植入剂的制剂工程门槛与后续供应、医保放量逻辑。","source",{"_66":77},"links",{"_59":76},"publishedAt","2026-10-29T00:05:17.000Z","discoveredAt","2026-10-31T03:04:46.207Z","timelineAt","category","approval","tags",[67,71,74,75],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","点苍鹤","body","outline",[],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","approvals","name","获批上市","device-ivd","医疗器械与 IVD","ophthalmology","眼科","nmpa","中国 NMPA","医疗器械/IVD","NMPA","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699399&idx=1&sn=e0811786e89c50f3f9847b723fd3e713&chksm=bc67fa6cc8bcce733b02d5ad289936c41fca9622657f75fc4a07ad8025c8f940f49f8487a271&scene=126&sessionid=1793415858#rd","医药云端工作室",{"_79":80,"_81":-5,"_82":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
