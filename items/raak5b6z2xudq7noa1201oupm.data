[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795443791000,"id","raak5b6z2xudq7noa1201oupm","title","时隔十年，《肺癌小样本取材相关问题的中国专家共识（2026版）》发布，更新导航支气管镜与冷冻肺活检推荐","originalTitle","最新丨时隔十年，《肺癌小样本取材相关问题的中国专家共识（2026版）》发布！","summary","中华医学会呼吸病学分会组织多学科专家完成《肺癌小样本取材相关问题的中国专家共识（2026版）》，为2016年版共识的第二次修订更新。新版重点评估了ENB、CBCT、RAB等导航支气管镜技术和CLE实时成像技术在肺外周病变（PPL）诊断中的价值，并对TBCB、EBUS-TBNA和PTNB部分内容作出更新，围绕30个临床常见问题形成39项推荐意见。","reason","source",{"_72":85},"links",{"_60":84},"publishedAt","2026-11-22T11:11:19.000Z","discoveredAt","2026-11-23T04:30:34.938Z","timelineAt","category","research","tags",[82,77,83],"score",22,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","中华医学会杂志社","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fdJwJHmIvvCQ","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","papers","name","论文研究","device-ivd","医疗器械与 IVD","oncology","肿瘤",{"_79":80,"_13":81},"publicId","fe354562-ed68-43d1-a272-52d1c96f7f77","肺癌小样本取材中国专家共识2026版发布","论文/研究","医疗器械/IVD","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247605106&idx=1&sn=160bf6babadeb888e22d91d9761b0077&chksm=fcd4d00f410c370951b25ebf0235c8c4ffe4d4a2312bfbdafc29189964469787cd18685cff23&scene=126&sessionid=1795408232#rd","呼吸界",{"_87":88,"_89":-5,"_90":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
