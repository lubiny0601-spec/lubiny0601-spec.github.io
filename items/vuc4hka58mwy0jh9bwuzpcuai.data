[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793889560000,"id","vuc4hka58mwy0jh9bwuzpcuai","title","NMPA 批准阿舒克森片、巴托利单抗注射液等多款创新药上市","originalTitle","阿舒克森片等多款创新药获批上市","summary","国家药监局批准阿舒克森片、巴托利单抗注射液、紫花温肺止嗽颗粒、盐酸艾泊度胺胶囊的注册申请。拜耳的1类创新药阿舒克森片经优先审评审批程序获批，用于降低缺血性卒中或高风险短暂性脑缺血发作成人患者的卒中风险，不包括心源性栓塞型卒中患者；巴托利单抗注射液与常规治疗药物联合用于抗乙酰胆碱受体抗体阳性的成人全身型重症肌无力。","reason","一次汇总四款新药获批，读者可对照各自适应症与审评通道，判断相关治疗场景的用药选择变化。","source",{"_65":78},"links",{"_58":77},"publishedAt","2026-10-28T00:00:00.000Z","discoveredAt","2026-10-28T15:39:01.294Z","timelineAt","category","approval","tags",[66,73,74,75,68,70,76],"score",51,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","approvals","name","获批上市","tcm","中药","hematology","血液","nmpa","中国 NMPA","NMPA","拜耳","BMS","悦康药业","https://www.cnpharm.com/c/2026-10-28/1109526.shtml","中国食品药品网·要闻",{"_80":81,"_82":-5,"_83":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
