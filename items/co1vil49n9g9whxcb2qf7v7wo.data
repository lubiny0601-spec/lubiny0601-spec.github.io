[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443790000,"id","co1vil49n9g9whxcb2qf7v7wo","title","杰毅生物mNGS呼吸道病原微生物检测试剂盒获国内自动化建库试剂品类首证","originalTitle","八年磨一剑：杰毅生物获国内mNGS自动化建库试剂品类首证，让病原NGS真正\"可及\"","summary","杰毅生物自主研发的mNGS呼吸道病原微生物检测试剂盒（可逆末端终止测序法）于2026年11月20日获国家三类医疗器械注册证（国械注准20263402360），为国内病原mNGS自动化建库试剂品类首张注册证。该方案以\"试剂+自动化设备+软件\"全流程闭环，将建库由手工7至8小时压缩至90分钟，生信分析由约2小时缩短至不到10分钟完成一张芯片审核，推动病原NGS院内本地化开展。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T11:48:45.384Z","timelineAt","category","approval","tags",[72,81,82],"score",20,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f3yfy-lcac4U","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","approvals","name","获批上市","device-ivd","医疗器械与 IVD","nmpa","中国 NMPA",{"_78":79,"_13":80},"publicId","c0594dbd-2c10-41ed-adbd-8531af568cb0","杰毅生物mNGS呼吸道检测试剂盒获三类证","医疗器械/IVD","NMPA","https://news.bioon.com/article/c7ea9001e45f.html","生物谷",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
