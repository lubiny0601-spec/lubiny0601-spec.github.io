[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795410128000,"id","ps0j3u1gh1y3dait2dqlr7f9q","title","大感控·大家谈 第07期丨李航：感控是医院高质量发展的底线和红线","originalTitle","大感控·大家谈 第07期丨李航：感控，是医院高质量发展的底线和红线","summary","北京大学第一医院副院长李航在“大感控·大家谈”第07期中提出，感控是医院高质量发展的底线和红线，疫情回归常态后任务反而更广。他指出门诊手术、有创治疗和内镜等“大门诊”场景不断扩展，防控体系需从病房延伸至门诊，并强调应将医院感染管理作为专业发展、建立类似住培专培的培养体系，同时借助AI与医防融合把传染病阻断在萌芽阶段。","reason","source",{"_63":73},"links",{"_58":72},"publishedAt","2026-11-17T11:15:00.000Z","discoveredAt","2026-11-23T04:32:47.081Z","timelineAt","category","opinion","tags",[67,68,69,70,71],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","SIFIC团队","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","opinions","name","观点与解读","antibiotics","抗菌药物与耐药","观点/解读","耐药与院感","抗感染","专家会议","对市场","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200686&idx=1&sn=809d947b7bdc7539eb18f1c3c5c0a82e&chksm=825ddb54e67ba27b24e107c281f3ddd3f5bea19f67c5a169d01003bf0fd9010d5a040709827b&scene=126&sessionid=1795408256#rd","SIFIC 感染视界",{"_75":76,"_77":-5,"_78":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
