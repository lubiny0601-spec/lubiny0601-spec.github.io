[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889567000,"id","b3ka12pqpcui3yn22bsbmbe2e","title","广东省第三方药品电子交易平台同步20261016批次新增挂网药品数据","originalTitle","关于广东省第三方药品电子交易平台同步药品挂网数据信息的通知（20261016批次）","summary","广东省第三方药品电子交易平台已将20261016批次审核通过且公示无异议的新增挂网药品数据同步至广东招采子系统。相关企业需使用CA登录子系统维护配送关系，挂网药品配送须覆盖全省所有参加药品采购的各类医疗机构，配送关系符合要求后医疗机构方可发起合同交易。","reason","source",{"_61":68},"links",{"_57":67},"publishedAt","2026-10-22T16:00:00.000Z","discoveredAt","2026-10-27T16:01:17.234Z","timelineAt","category","policy","tags",[65,66],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","https://www.gdmede.com.cn/announcement/announcement/detail?id=2113521363808423936","广东省药品交易中心·通知公告",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
