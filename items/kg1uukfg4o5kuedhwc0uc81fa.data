[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795410127000,"id","kg1uukfg4o5kuedhwc0uc81fa","title","BCI Pioneers Coalition 发布报告：脑植入物试验如何更好保障受试者权益","originalTitle","Patients have little say in how brain implant trials are done. Ian Burkhart wants to change that","summary","BCI Pioneers Coalition 上周发布报告，针对植入式脑机接口（BCI）试验提出 13 条建议，涵盖试验后照护、知情同意与神经数据隐私，供初创企业、研究者和监管机构参考。联合创始人 Ian Burkhart 曾于 2014 年在俄亥俄州立大学植入 BCI 装置，因研究资金问题被要求取出设备，他认为现有知情同意更偏向保护研究团队而非受试者。","reason","source",{"_63":70},"links",{"_58":69},"publishedAt","2026-11-20T09:30:00.000Z","discoveredAt","2026-11-23T04:24:56.346Z","timelineAt","category","opinion","tags",[67,68],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","O. Rose Broderick","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","opinions","name","观点与解读","device-ivd","医疗器械与 IVD","观点/解读","医疗器械/IVD","https://www.statnews.com/2026/11/20/ian-burkhart-how-brain-implant-trials-can-serve-patients-better/?utm_campaign=rss","STAT",{"_72":73,"_74":-5,"_75":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
