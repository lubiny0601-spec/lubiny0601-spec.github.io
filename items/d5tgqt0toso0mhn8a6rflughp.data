[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793888192000,"id","d5tgqt0toso0mhn8a6rflughp","title","FDA 启动 NAIN 项目推进神经科学医疗产品开发，首个计划聚焦阿尔茨海默病预防","originalTitle","FDA Launches New Program to Advance Neuroscience Medical Product Development","summary","FDA 宣布启动神经科学进步与创新联结项目（NAIN），协调药物、生物制品与器械三大中心力量，推进脑与神经系统疾病医疗产品开发。首个计划阿尔茨海默病预防加速器将聚焦延缓或预防阿尔茨海默病的医疗产品，探索预防性临床试验的人群选择、阶段适配终点及证据路径。NAIN 覆盖神经与精神疾病、物质使用障碍及疼痛等领域。","reason","source",{"_63":72},"links",{"_58":71},"publishedAt","2026-10-22T16:58:19.000Z","discoveredAt","2026-10-27T13:29:42.800Z","timelineAt","category","policy","tags",[69,70,44],"score",18,"selected",false,"channel","news","story","x","readingMode","full","author","FDA","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":30,"_63":64},"slug","name","政策与监管","neuroscience","神经与精神","fda","美国 FDA","政策/监管","神经/精神","http://www.fda.gov/news-events/press-announcements/fda-launches-new-program-advance-neuroscience-medical-product-development","FDA 新闻稿",{"_74":75,"_76":-5,"_77":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
