[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795408364000,"id","x0xqs42xpeuukznbms8x3f0je","title","药明巨诺瑞基奥仑赛降至30万元以内进基本医保，成首个纳入的CAR-T","originalTitle","降价30万以内，CAR-T的医保大门开了，但放量这事没那么简单","summary","2026版国家医保目录公布，药明巨诺瑞基奥仑赛（倍诺达）从129万元一支谈至30万元以内，成为国内首个进入基本医保的CAR-T，新版目录明年1月1日执行。降价底气来自慢病毒载体国产化，单支成本压到二十多万，按出厂价29万、成本约22万测算毛利率约25%。","reason","从成本国产化到支付分层，拆解了CAR-T进医保后放量受产能与质控制约的现实条件。","source",{"_73":87},"links",{"_61":86},"publishedAt","2026-11-15T04:07:46.000Z","discoveredAt","2026-11-16T01:00:36.137Z","timelineAt","category","opinion","tags",[83,84,78,85],"score",78,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","点苍鹤","body","outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fSZdXfevOkuU","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","opinions","name","观点与解读","insurance","医保与集采","cell-gene","细胞与基因治疗",{"_80":81,"_13":82},"publicId","29c2e251-8cd9-4865-82b5-35271934e12c","药明巨诺CAR-T降至30万元内进基本医保","观点/解读","医保/集采","国家医保局","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699684&idx=1&sn=e72806fa9b4136ea9d8279f1ff04a301&chksm=bcfe2e4492439d1f54fc0e3d12d2bbf62ec2d7a109510448f333d6238f2209763a846a084f98&scene=126&sessionid=1794790832#rd","医药云端工作室",{"_89":90,"_91":-5,"_92":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
