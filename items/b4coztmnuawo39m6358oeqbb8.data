[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795410151000,"id","b4coztmnuawo39m6358oeqbb8","title","国家药监局就药品委托分段生产公告公开征求意见","originalTitle","国家药监局公开征求《关于药品委托分段生产有关事项的公告（征求意见稿）》意见","summary","国家药监局综合司就《关于药品委托分段生产有关事项的公告（征求意见稿）》向社会公开征求意见，反馈截止2026年11月30日，意见发送至jianguansanchu@nmpa.gov.cn。该公告用于落实2026年5月15日施行的新修订《药品管理法实施条例》，条例已对药品委托分段生产作出常态化制度安排。","reason","新修订药品管理法实施条例已把委托分段生产常态化，这份公告征求意见稿决定具体怎么落地。","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-11-13T00:00:00.000Z","discoveredAt","2026-11-16T00:55:14.852Z","timelineAt","category","policy","tags",[66,67],"score",47,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-13/1110480.shtml","中国食品药品网·要闻",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
