[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889552000,"id","eplbuiicfpxxynhypybzbdmej","title","超越获批：新型革兰阴性菌抗生素在治疗中的定位","originalTitle","Beyond Approval: Finding the Right Place for Emerging Gram-Negative Antibiotics","summary","FDA 批准本身并不决定新型革兰阴性菌抗生素在治疗中的位置，临床医生需自行判断其解决何种未满足需求、证据强度及未知之处。舒巴坦-度洛巴坦填补 CRAB 感染治疗需求，氨曲南-阿维巴坦为产 NDM 的 CRE 提供重要选择；头孢吡肟-恩美唑巴坦证据主要限于尿路感染，头孢吡肟-齐德巴坦证据仍限于体外数据和病例报告。文章强调新颖不等于必要，抗菌药物管理应基于耐药机制匹配治疗而非最新选项。","reason","source",{"_62":74},"links",{"_57":73},"publishedAt","2026-09-02T15:14:15.807Z","discoveredAt","2026-10-27T15:41:44.462Z","timelineAt","category","opinion","tags",[66,67,68,69,70,71,72],"score",32,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","opinions","name","观点与解读","antibiotics","抗菌药物与耐药","观点/解读","抗菌药物","耐药与院感","抗感染","循证指南","对品牌","对准入","https://www.contagionlive.com/view/beyond-approval-finding-the-right-place-for-emerging-gram-negative-antibiotics","Contagion Live·抗菌药物管理",{"_76":77,"_78":-5,"_79":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
