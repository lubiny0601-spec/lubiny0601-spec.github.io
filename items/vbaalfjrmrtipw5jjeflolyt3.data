[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793888179000,"id","vbaalfjrmrtipw5jjeflolyt3","title","静脉碳青霉烯类与口服替比培南匹伏酯综述","originalTitle","Review of Intravenous Carbapenems and Oral Tebipenem Pivoxil","summary","本文综述了美国上市的静脉碳青霉烯类单药（厄他培南、美罗培南、亚胺培南-西司他丁）及2026年6月获FDA批准的首个口服碳青霉烯替比培南匹伏酯。碳青霉烯类为广谱β-内酰胺类抗生素，通过结合青霉素结合蛋白抑制细菌细胞壁合成，通常保留用于窄谱抗生素不可用的耐药感染，对产ESBL革兰阴性杆菌常为首选，但不覆盖MRSA。该类药均可引起癫痫发作，并降低丙戊酸血药浓度，与丙磺舒合用不推荐。","reason","source",{"_62":77},"links",{"_57":76},"publishedAt","2026-08-08T09:00:00.000Z","discoveredAt","2026-10-28T01:14:46.498Z","timelineAt","category","research","tags",[66,67,68,69,70,71,72,73,74,75],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","论文/研究","抗菌药物","耐药与院感","抗感染","循证指南","对品牌","FDA","GSK","默沙东","辉瑞","https://www.contagionlive.com/view/review-of-intravenous-carbapenems-and-oral-tebipenem-pivoxil","Contagion Live·抗菌药物管理",{"_79":80,"_81":-5,"_82":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
