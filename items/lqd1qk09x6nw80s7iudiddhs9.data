[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889546000,"id","lqd1qk09x6nw80s7iudiddhs9","title","清华大学王凤超等发现KAT5-H2A.Z乙酰化失稳致滋养层染色体不稳定，关联复发性流产","originalTitle","Sci Adv：表观修饰守胎盘，清华大学王凤超等发现KAT5-H2A.Z失稳，染色体乱了，胎儿难留","summary","清华大学王凤超等人在 Science Advances 发表研究，证明KAT5通过乙酰化H2A.Z转录激活Aurka、Aurkb和Cenpa等有丝分裂基因，维持滋养层细胞染色体稳定性。小鼠滋养层特异性敲除Kat5或引入乙酰化缺陷突变体可诱导严重染色体不稳定性（CIN）并致胚胎致死，该作用在人滋养层干细胞中保守。复发性流产患者胎盘绒毛中KAT5与乙酰化H2A.Z表达降低。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T08:14:19.789Z","timelineAt","category","research","tags",[78,73],"score",8,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fe627FEjsRpk","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","rare-disease","罕见病",{"_75":76,"_13":77},"publicId","b19e7af3-09fe-4607-a0ec-7aa7276e8e48","清华团队揭示复发性流产的滋养层染色体失稳机制","论文/研究","https://news.bioon.com/article/513b96200692.html","生物谷",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
