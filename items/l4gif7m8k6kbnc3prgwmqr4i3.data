[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795410125000,"id","l4gif7m8k6kbnc3prgwmqr4i3","title","度普利尤单抗慢阻肺病与哮喘适应症纳入2026国家医保药品目录","originalTitle","度普利尤单抗慢性阻塞性肺疾病与哮喘适应症纳入2026国家医保药品目录","summary","国家医保局公布《国家基本医疗保险、工伤保险和生育保险药品目录（2026年）》，度普利尤单抗注射液成人慢阻肺病及6岁及以上儿童和成人哮喘等四项适应症首次纳入医保支付范围，中重度特应性皮炎适应症续约。该药为靶向白介素-4及白介素-13的生物制剂，陈荣昌、瞿介明两位教授在文中提到纳入医保有助于减轻用药负担、提升可及性并减少急性加重。","reason","慢阻肺病与哮喘适应症首次进入医保支付，读者可据此判断呼吸生物制剂在院内的准入与放量空间。","source",{"_72":90},"links",{"_60":89},"publishedAt","2026-11-14T10:00:00.000Z","discoveredAt","2026-11-16T01:00:50.265Z","timelineAt","category","policy","tags",[84,85,79,86,87,88],"score",78,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body","outline",[],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fPjD2sgyhFO8","reportCount",1,"additionalSourceCount",0,{"_71":78,"_72":79},{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":31,"_72":73},"slug","name","政策与监管","insurance","医保与集采","antibody","抗体与双抗","respiratory","呼吸",{"_81":82,"_13":83},"publicId","761629e7-0406-4a4e-9454-c16bb401c1ac","度普利尤单抗四项适应症首次纳入2026医保","政策/监管","医保/集采","抗体/双抗","国家医保局","赛诺菲","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604830&idx=1&sn=f243eb34d45828f019b753a8cf4bbab4&chksm=fcd2f2447358c79aaa4cf155da72bba585adc408db479a1afd77fdcd5789515aa523aee7e06c&scene=126&sessionid=1794790833#rd","呼吸界",{"_92":93,"_94":-5,"_95":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
