[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791091000,"id","uf3z2puwxm8hywtjk2rhq84p2","title","赛柏蓝12月12-13日成都举办医药企业合规转型落地实操研修班","originalTitle","新形势下，医药企业合规转型落地实操研修班「12月12-13日 成都」","summary","赛柏蓝定于12月12-13日在成都举办\"新形势下，医药企业合规转型落地实操研修班\"，聚焦医药合规实战落地。随着两高司法解释、《医药代表管理办法》等合规新政落地，新规下调商业贿赂入罪门槛，药企及高管面临行政、民事、刑事三重合规风险。课程帮助企业搭建全流程合规体系，规避合规误区、筑牢刑事风险防火墙。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-12T07:28:06.000Z","discoveredAt","2026-11-12T14:33:25.069Z","timelineAt","category","industry","tags",[71,78],"score",10,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f-BZfhyqwhsQ","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","company-news","name","公司动态","policy","政策与监管",{"_75":76,"_13":77},"publicId","ce7c31ba-ca1e-486a-8589-079d406abf63","赛柏蓝12月成都办医药合规研修班","政策/监管","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670439&idx=6&sn=1a83b545fb992587135ec793f9f6a065&chksm=bc4fc9e81d3c453a76c940474a38fa9251fa72a7c94aac2a97df2b3b6754a62295c8f648de09&scene=126&sessionid=1794493868#rd","赛柏蓝",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
