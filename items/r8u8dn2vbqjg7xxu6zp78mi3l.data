[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795443794000,"id","r8u8dn2vbqjg7xxu6zp78mi3l","title","肺炎旁胸腔积液合并20厘米巨大细菌性肝脓肿：肝脓液引流约6000mL，胸水与肝脓液是同一病原吗？","originalTitle","肺炎旁胸腔积液+20厘米巨大细菌性肝脓肿，肝脓液陆续引流约6000mL，与胸水是同一病原吗？症状不重等于感染轻吗？","summary","一例53岁女性因发热、右上腹胀痛起病，检出肝右叶巨大细菌性肝脓肿（约20.9×13.7 cm），脓液培养与mNGS均检出中间链球菌，经置管引流约6000mL脓液并联合抗菌治疗后脓肿持续缩小、引流管最终拔除。同期右下肺炎伴右侧肺炎旁胸腔积液，胸水为非脓性、培养阴性，未认定为脓胸，也未认定与肝脓肿为同一病原。","reason","source",{"_70":84},"links",{"_60":83},"publishedAt","2026-11-10T11:14:01.000Z","discoveredAt","2026-11-11T08:15:31.701Z","timelineAt","category","clinical","tags",[71,78,79,80,81,82],"score",15,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","王旭阳 马玉燕 等","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fHuy2dDhWk9o","reportCount",2,"additionalSourceCount",1,{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","临床进展","antibiotics","抗菌药物与耐药",{"_75":76,"_13":77},"publicId","6ecc5b8c-f90c-4917-90db-8578d0fb8cbc","53岁女性巨大肝脓肿检出中间链球菌","抗菌药物","耐药与院感","抗感染","循证指南","对销售","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604658&idx=2&sn=9ee0aa5b88dfeac0bc92144c114eae87&chksm=fcb459dfeaceabafec142b319ea08ae64a17dbdea8d4c7d1967e41ea56236263d570ef78c80c&scene=126&sessionid=1794384928#rd","呼吸界",{"_86":87,"_88":-5,"_89":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
