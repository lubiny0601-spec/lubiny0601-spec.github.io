[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794205946000,"id","ecytk1ngxjfavdxbdyg79dlgf","title","诺华披露9例SMA患者接受Zolgensma后出现肿瘤，2例检出AAV载体DNA整合","originalTitle","Novartis reveals cancer cases possibly linked to gene therapy Zolgensma","summary","诺华披露9名接受基因疗法Zolgensma的脊髓性肌萎缩症（SMA）患者后续出现肿瘤，其中2例检出治疗所用AAV载体整合入患者DNA的证据。诺华称每例均已通报监管机构，将继续配合后续工作；Zolgensma说明书已列明AAV可能整合入DNA的理论风险，目前全球已有6000人接受该治疗。","reason","source",{"_65":75},"links",{"_58":74},"publishedAt","2026-11-06T16:51:00.000Z","discoveredAt","2026-11-09T06:26:05.097Z","timelineAt","category","industry","tags",[73,72,68,70],"score",40,"selected",false,"channel","news","story","x","readingMode","full","author","Jonathan Gardner","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","safety","name","安全与质量","cell-gene","细胞与基因治疗","rare-disease","罕见病","novartis","诺华","安全/质量","https://www.biopharmadive.com/news/zolgensma-tumor-report-novartis-sma-spinal-muscular-atrophy/873990/","BioPharma Dive",{"_77":78,"_79":-5,"_80":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
