[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889548000,"id","z2lwcbzsofhjtw2moj0kdy51v","title","PNAS：娄继忠研究组揭示CD28与PD-1通过相分离竞争性调控T细胞活化，为CAR-T设计优化提供新思路","originalTitle","PNAS：娄继忠研究组合作揭示共信号受体通过相分离双重调控T细胞活化，为CAR-T设计优化提供新思路","summary","中国科学院生物物理研究所娄继忠团队在PNAS发表研究，揭示CD28胞内结构域与Lck形成信号凝聚体驱动共刺激，而双磷酸化PD-1竞争性结合CD28并溶解该凝聚体。据此工程化的CD28 ICD突变体可抵抗PD-1介导的破坏，整合入CAR构建体后增强体内抗肿瘤疗效。","reason","source",{"_72":87},"links",{"_59":86},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T05:13:21.611Z","timelineAt","category","research","tags",[84,79,77,85],"score",16,"selected",false,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body","outline",[],"relatedStories",[80],"topics",[66,67,68,69],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f-YfYAr9lC4A","reportCount",1,"additionalSourceCount",0,{"_70":78,"_72":79},{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","papers","name","论文研究","antibody","抗体与双抗","cell-gene","细胞与基因治疗","oncology","肿瘤",{"_81":82,"_13":83},"publicId","c971fd94-dba5-4979-97b1-5f8e02a39dbb","PNAS：CD28与PD-1相分离竞争调控T细胞活化","论文/研究","抗体/双抗","https://news.bioon.com/article/07079618816e.html","生物谷",{"_89":90,"_91":-5,"_92":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
