[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793889550000,"id","wxa8r3kcqyqvahah6t33k8j4d","title","华北制药注射用哌拉西林钠他唑巴坦钠/氯化钠注射液获药品注册证书，为国内首家获批","originalTitle","华北制药｜注射用哌拉西林钠他唑巴坦钠/氯化钠注射液获药品注册证书","summary","华北制药收到NMPA核准签发的注射用哌拉西林钠他唑巴坦钠/氯化钠注射液《药品注册证书》，为国内首家获批企业，该双室制剂国内此前无上市销售产品。规格为粉体室4.5g（哌拉西林钠4.0g与他唑巴坦钠0.5g）加液体室100ml：0.9g氯化钠，注册分类化学药品4类，批准文号国药准字H20266333，有效期至2031年10月19日，累计研发投入2,637.25万元。","reason","国内首个哌拉西林钠他唑巴坦钠双室制剂获批，公告同时给出同类粉针剂年销售额与销量，可据此判断这一剂型的市场空间。","source",{"_63":75},"links",{"_58":74},"publishedAt","2026-10-23T16:00:00.000Z","discoveredAt","2026-10-28T16:55:42.952Z","timelineAt","category","approval","tags",[64,67,68,69,70,71,72,73],"score",60,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","approvals","name","获批上市","antibiotics","抗菌药物与耐药","抗菌药物","NMPA","华北制药","抗感染","管线上新","对销售","对准入","https://static.cninfo.com.cn/finalpage/2026-10-24/1225619994.PDF","华北制药·公司公告",{"_77":78,"_79":-5,"_80":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
