[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794791091000,"id","b3nugqrhakva7hv7dapjvg3j4","title","达利雷生获 FDA 突破性疗法认定，拟用于儿童青少年失眠障碍","originalTitle","儿童失眠赛道，重磅明星药要来了","summary","达利雷生获 FDA 突破性疗法认定，用于治疗 10 岁至不满 18 岁儿童青少年的失眠障碍。该认定基于 II 期临床结果：单次服用 50 毫克后受试者总睡眠时长较基线增加约 50 分钟，伴神经发育障碍亚组增加约 64 分钟；Idorsia 预计 2027 年下半年启动儿童青少年 III 期临床项目。先声药业持有达利雷生大中华区独家权益，儿童适应症纳入授权范围须经 Idorsia 另行书面同意。","reason","source",{"_65":76},"links",{"_58":75},"publishedAt","2026-11-12T12:00:34.000Z","discoveredAt","2026-11-12T14:31:18.508Z","timelineAt","category","clinical","tags",[67,72,73,74],"score",38,"selected",false,"channel","news","story","x","readingMode","full","author","晓琳","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":70,"_65":71},{"_63":68,"_65":69},{"_63":30,"_65":67},{"_63":64,"_65":66},"slug","pipeline","name","研发管��","临床进展","neuroscience","神经与精神","fda","美国 FDA","神经/精神","FDA","研发管线","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670466&idx=2&sn=b890e030a7eada29191bb83203246fc4&chksm=bc531eb701e5ed1a1de3ece27b5c6f9f59ab94e67830b299bd951e695751fe9b342ac4054f51&scene=126&sessionid=1794493868#rd","赛柏蓝",{"_78":79,"_80":-5,"_81":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
