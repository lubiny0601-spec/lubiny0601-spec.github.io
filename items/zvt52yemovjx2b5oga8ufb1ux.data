[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793888174000,"id","zvt52yemovjx2b5oga8ufb1ux","title","UniQure 亨廷顿病基因疗法获 FDA 审评决定日期；Teva 终止脑病药物研究","originalTitle","UniQure gets an FDA decision date; Teva scraps brain drug study","summary","FDA 同意审评 UniQure 亨廷顿病基因疗法上市申请，采用加速审评，预计 5 月 1 日前作出决定，并计划召开外部顾问会议讨论该申请。Teva 在中期数据检查后提前终止与 Modag 合作的 emrusolmin 治疗多系统萎缩的 II 期研究，该药达到无效性标准。Bright Minds 口服抗癫痫药 BMB-101 的 II 期试验申请被 FDA 部分临床暂停，原因是小鼠试验中发现毒性。","reason","source",{"_66":79},"links",{"_58":78},"publishedAt","2026-11-03T13:41:00.000Z","discoveredAt","2026-11-05T05:13:21.839Z","timelineAt","category","industry","tags",[69,76,71,77,67],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","BioPharma Dive staff","body","outline",[],"relatedStories",[],"topics",[59,60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":74,"_66":75},{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","trends","name","行业趋势","company-news","公司动态","cell-gene","细胞与基因治疗","neuroscience","神经与精神","fda","美国 FDA","神经/精神","FDA","https://www.biopharmadive.com/news/uniqure-fda-bright-minds-specific-teva-cinrock/873455/","BioPharma Dive",{"_81":82,"_83":-5,"_84":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
