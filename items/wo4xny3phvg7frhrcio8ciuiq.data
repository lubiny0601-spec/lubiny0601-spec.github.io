[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889568000,"id","wo4xny3phvg7frhrcio8ciuiq","title","上海市医保局征集医疗服务真实世界医保综合价值评价项目，11月20日截止申报","originalTitle","关于开展医疗服务真实世界医保综合价值评价项目征集的通知","summary","上海市医疗保障局公开征集医疗服务医保综合价值评价项目，申报截止11月20日，面向可信评价点医疗机构、医药企业、科研院校及学术团体，鼓励企业与医疗机构联合申报。评价项目按技术劳务、医用耗材、诊断试剂、医疗设备、人工智能/医用软件、优化诊疗流程等驱动因素分类，重点支持价格项目预立项、新增、定价调价和纳保四类应用场景。","reason","source",{"_61":69},"links",{"_57":68},"publishedAt","2026-10-21T00:00:00.000Z","discoveredAt","2026-10-27T13:29:41.881Z","timelineAt","category","policy","tags",[65,66,67],"score",38,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","https://www.smpaa.cn/xxgk/gggs/2026/10/21/25512.shtml","上海阳光医药采购网",{"_71":72,"_73":-5,"_74":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
