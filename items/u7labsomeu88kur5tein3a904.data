[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794205948000,"id","u7labsomeu88kur5tein3a904","title","广州医科大学合作《Nature》：产气荚膜梭菌δ毒素靶向CD9驱动坏死性小肠结肠炎与脑损伤","originalTitle","广州医科大学合作最新《Nature》","summary","广州国家实验室、广州医科大学熊小哲团队与哈佛医学院/波士顿儿童医院董民团队等在 Nature 发表研究，发现携带δ毒素的产气荚膜梭菌在重症坏死性小肠结肠炎（NEC）患儿肠道中显著富集，δ毒素经全基因组CRISPR筛选确定以CD9为宿主受体。小鼠实验显示，δ毒素主要作用于巨噬细胞，激活炎症小体引发细胞焦亡和炎症风暴，进而破坏血脑屏障导致脑损伤；一款中和性抗δ毒素单克隆抗体在小鼠中能有效阻止疾病进展。","reason","source",{"_71":88},"links",{"_59":87},"publishedAt","2026-10-30T00:00:00.000Z","discoveredAt","2026-10-30T11:06:59.518Z","timelineAt","category","research","tags",[81,82,83,84,85,86],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","foViQpfydcIQ","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","infectious","感染与疫苗",{"_78":79,"_13":80},"publicId","d60310ba-1a44-48e5-b882-3e0af96c328d","Nature发表NEC毒素致病机制研究","论文/研究","感染/疫苗","耐药与院感","其他","抗感染","循证指南","https://news.bioon.com/article/9bb99609489a.html","生物谷",{"_90":91,"_92":-5,"_93":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
