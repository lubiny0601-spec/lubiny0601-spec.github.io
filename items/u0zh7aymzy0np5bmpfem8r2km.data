[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795408366000,"id","u0zh7aymzy0np5bmpfem8r2km","title","世界慢阻肺病日特别直播：王辰院士等专家谈慢阻肺病早诊早管，我国近1亿患者诊断率不足三成","originalTitle","一亿人的沉默肺病，超90%的人却不自知，早诊早管，守住呼吸！丨11月17日12:30看直播（世界慢阻肺病日特别节目）","summary","《呼吸界》《看呼吸》将于11月17日12:30推出世界慢阻肺病日科普直播，白岩松对话王辰院士、孙永昌教授、陈燕教授，主题为“早诊断早管理，挽救悄悄下降的肺功能”。我国慢阻肺病患者近1亿，诊断率不足三成，40岁以上人群肺功能检查率仅4.5%，超过半数患者首诊已是中重度。节目将讲解高危因素识别、筛查问卷与肺功能检查、戒烟疫苗规范用药及肺康复等早干预手段。","reason","source",{"_73":87},"links",{"_60":86},"publishedAt","2026-11-15T10:33:39.000Z","discoveredAt","2026-11-16T01:00:38.640Z","timelineAt","category","opinion","tags",[85,78,74,80],"score",15,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","直播间等您的","body","outline",[],"relatedStories",[81],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fBwUGtwMo9gc","reportCount",1,"additionalSourceCount",0,{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","trends","name","行业趋势","opinions","观点与解读","respiratory","呼吸","astrazeneca","阿斯利康",{"_82":83,"_13":84},"publicId","12ac4370-1dde-44d2-ac64-49d9f9dbe687","呼吸界将直播慢阻肺病早诊早管科普","观点/解读","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604843&idx=1&sn=8f60e31e5b160151600defddea9b6157&chksm=fc472421d7adf2c1eec397f3877eb43011724a1b6ba3a6d29a0f13ba006365205c1e3c94c6e8&scene=126&sessionid=1794790833#rd","呼吸界",{"_89":90,"_91":-5,"_92":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
