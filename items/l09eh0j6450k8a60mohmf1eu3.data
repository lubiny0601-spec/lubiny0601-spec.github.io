[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794791090000,"id","l09eh0j6450k8a60mohmf1eu3","title","Synchron 暂停第二代脑机接口临床试验","originalTitle","Brain implant startup pauses trials","summary","Synchron 已暂停其第二代脑机接口的临床试验，该无线版设备通过静脉导管将支架置入大脑运动皮层附近，旨在让用户以脑活动连接数字设备。公司负责人称暂停与安全性无关，同时将在纽约市裁员并着手开发新设备。CEO Tom Oxley 此前曾称系统中有数百个组件，某一组件延迟拖慢了向 FDA 的申报。","reason","source",{"_63":69},"links",{"_58":68},"publishedAt","2026-11-13T14:40:32.000Z","discoveredAt","2026-11-16T00:55:13.589Z","timelineAt","category","industry","tags",[64,67],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","Annalisa Merelli and O. Rose Broderick","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","company-news","name","公司动态","device-ivd","医疗器械与 IVD","医疗器械/IVD","https://www.statnews.com/2026/11/13/health-news-brain-implant-startup-pauses-trials/?utm_campaign=rss","STAT",{"_71":72,"_73":-5,"_74":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
