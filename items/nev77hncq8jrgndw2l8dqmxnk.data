[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1793889546000,"id","nev77hncq8jrgndw2l8dqmxnk","title","中国流感监测周报第932期：第43周报告145起流感样病例暴发疫情","originalTitle","2026年第43周第932期中国流感监测周报","summary","截至2026年10月25日的一周，南方省份流感病毒检测阳性率略有下降、北方省份略有上升，全国共报告145起流感样病例暴发疫情。全国检出阳性样本中甲型占67.6%、乙型占32.4%，甲型中A(H3N2)占67.2%、A(H1N1)pdm09占32.8%，乙型均为B（Victoria）系。","reason","周报给出南北阳性率分化、暴发疫情数与毒株耐药比例，可用于判断当季流感用药与疫苗匹配情况。","source",{"_71":82},"links",{"_60":81},"publishedAt","2026-10-28T00:00:00.000Z","discoveredAt","2026-10-29T14:00:45.453Z","timelineAt","category","research","tags",[79,80],"score",47,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fCe8UUaw3CTE","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","infectious","感染与疫苗",{"_76":77,"_13":78},"publicId","215da520-2e49-4b2d-9dbf-f29237d8065f","中国疾控发布第43周流感监测周报","论文/研究","感染/疫苗","https://www.chinacdc.cn/jksj/jksj04_14249/202610/t20261028_1842545.html","中国疾控·流感监测周报",{"_84":85,"_86":-5,"_87":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
