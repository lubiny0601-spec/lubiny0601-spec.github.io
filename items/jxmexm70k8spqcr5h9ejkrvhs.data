[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":-5,"_55":35,"_56":57},"expiresAt",1795443793000,"id","jxmexm70k8spqcr5h9ejkrvhs","title","直播预告丨质控视角下现场督导的实施与提质路径（第三季12期）","originalTitle","summary","《感控S计划》第三季第12期直播聚焦质控视角下临床感控现场督导的实施与提质路径。讲者从质控中心管理与临床一线督导双重视角，围绕标准落地、现场核查、问题溯源、反馈沟通、闭环整改、成效复盘六个维度梳理督导全流程方法，并拆解督导清单设计、问题分级处置与闭环追踪机制。内容结合真实督导案例复盘，针对“重检查、轻指导”等痛点，推动感控督导从单纯督查转向赋能指导。","reason","source",{"_61":68},"links",{"_57":67},"publishedAt","2026-11-19T03:03:11.000Z","discoveredAt","2026-11-23T04:31:12.501Z","timelineAt","category","industry","tags",[63,64,65,66],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","SIFIC团队","body","outline",[],"relatedStories",[],"topics",[58],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_59":60,"_61":62},"slug","antibiotics","name","抗菌药物与耐药","其他","耐药与院感","抗感染","对销售","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200732&idx=1&sn=61493d1f7eebdf51d5678478d4218f32&chksm=82e1b9e05299c33e8486c313a775fd286d71e7a542764efc06d49da99fc88f405734f2956c0f&scene=126&sessionid=1795408256#rd","SIFIC 感染视界",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
