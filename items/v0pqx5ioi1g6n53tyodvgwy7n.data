[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795410145000,"id","v0pqx5ioi1g6n53tyodvgwy7n","title","药品海外注册公益培训班在苏州举办，近500家药企参加","originalTitle","药品海外注册公益培训班在苏州举办","summary","11月10日至12日，由国家药监局高级研修学院主办、江苏省药监局苏州检查分局和苏州市药学会协办的药品海外注册公益培训班在苏州举办，近500家药品企业相关负责人参加。培训聚焦药品海外注册能力提升，内容涵盖药品出口监管要求解读、海外注册路径选择、欧美注册申报实务、项目管理及对外授权交易等。高研院表示将持续分区域、分领域、分专题组织海外注册培训。","reason","source",{"_61":68},"links",{"_57":67},"publishedAt","2026-11-17T00:00:00.000Z","discoveredAt","2026-11-23T04:24:52.616Z","timelineAt","category","policy","tags",[65,66],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-17/1110646.shtml","中国食品药品网·要闻",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
