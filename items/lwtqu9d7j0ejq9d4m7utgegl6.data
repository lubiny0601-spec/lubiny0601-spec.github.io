[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794384600000,"id","lwtqu9d7j0ejq9d4m7utgegl6","title","恒瑞医药甲苯磺酸瑞马唑仑新增 ICU 机械通气镇静适应症获批","originalTitle","创新价值持续拓展，恒瑞医药创新药甲苯磺酸瑞马唑仑新适应症获批上市","summary","NMPA 批准恒瑞医药 1 类创新药注射用甲苯磺酸瑞马唑仑（瑞倍宁）新增适应症，用于重症监护期间机械通气时的镇静。此次获批基于两项关键研究，包括短期镇静的 III 期 HR7056-302 研究（43 家中心、211 例患者）和长期镇静的 II 期 HR7056-206 研究（18 家中心、23 例患者），两项研究主要终点均达到预期。","reason","原文交代了新增适应症的两项关键研究设计与样本量，读者可据此判断该药在 ICU 镇静场景的定位。","source",{"_64":73},"links",{"_58":72},"publishedAt","2026-10-28T00:00:00.000Z","discoveredAt","2026-11-02T09:52:35.936Z","timelineAt","category","approval","tags",[65,69,70,71],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","approvals","name","获批上市","neuroscience","神经与精神","hengrui","恒瑞医药","NMPA","神经/精神","https://www.hengrui.com/media/detail-1061.html","恒瑞医药·新闻",{"_75":76,"_77":-5,"_78":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
