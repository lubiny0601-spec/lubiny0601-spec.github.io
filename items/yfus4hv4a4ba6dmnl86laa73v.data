[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":55,"_56":35,"_57":58},"expiresAt",1795443791000,"id","yfus4hv4a4ba6dmnl86laa73v","title","合规背景下的医院准入实战训练营（广州12.12）","originalTitle","summary","12月12日广州将举办《合规背景下的医院准入实战训练营》，面向药企KA、市场准入、政务、商务及大区&省区经理，为期1天。课程围绕客户链接与合规准入两条主线，拆解医院决策链条、DRG/DIP成本逻辑，并复盘4个脱敏真实准入案例，配套医院画像台账、跟进SOP、药事会答辩预案等工具包及现场沙盘推演。","reason","source",{"_68":77},"links",{"_58":76},"publishedAt","2026-11-22T07:25:37.000Z","discoveredAt","2026-11-23T04:30:37.133Z","timelineAt","category","industry","tags",[74,75],"score",8,"selected",false,"channel","news","story",{"_71":72,"_13":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[65],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fbSzfdTkSl6A","reportCount",2,"additionalSourceCount",0,{"_66":67,"_68":69},"slug","insurance","name","医保与集采",{"_71":72,"_13":73},"publicId","715b1985-9a09-4bd5-b342-bca730a08fe4","医院准入实战训练营12月12日广州开课","其他","医保/集采","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699759&idx=2&sn=59f6e6c57cfde7e891607bcf70f3180a&chksm=bcb6d0bc4c615161a991f9bf0a5fe14ce12216af2079337e905811b9419fc4f620ecaddd1f68&scene=126&sessionid=1795408227#rd","医药云端工作室",{"_79":80,"_81":-5,"_82":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
