[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794791090000,"id","xlnbumx413ndgocc35xc52xoe","title","民主党人就「Medicare for More」与「Medikids」提案形成共识","originalTitle","STAT+: Democrats coalesce around ‘Medicare for More,’ ‘Medikids’ proposals","summary","民主党正围绕「Medicare for More」提案凝聚共识，该政策旨在向更多美国人提供 Medicare 覆盖，被视为可避免党内温和派与自由派分歧的折中方案。另一项「Medikids」提案拟为从出生至 26 岁人群提供免费医疗保险，同样在民主党内获得越来越多支持。","reason","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-11-13T21:46:05.000Z","discoveredAt","2026-11-16T00:55:13.523Z","timelineAt","category","policy","tags",[66,67],"score",10,"selected",false,"channel","news","story","x","readingMode","full","author","John Wilkerson","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":64,"_62":65},{"_61":30,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","https://www.statnews.com/2026/11/13/democrats-eye-medicare-for-more-vs-medicare-for-all/?utm_campaign=rss","STAT",{"_71":72,"_73":-5,"_74":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
