[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408367000,"id","y6xqcmabd2f8ickiprhbmguic","title","晁代印/严建兵合作《Cell》：鉴定ZmNAET1揭示烟胺介导镍向籽粒转运机制","originalTitle","填补教科书，晁代印/严建兵合作最新《Cell》","summary","中国科学院分子植物科学卓越创新中心晁代印与华中农业大学严建兵共同通讯在Cell发表研究，首次鉴定出调控禾本科作物籽粒镍积累的关键转运蛋白ZmNAET1。该转运蛋白介导烟胺（NA）分泌，实现节中烟胺依赖性镍的韧皮部装载并向库器官转运；缺乏ZmNAET1的突变体出现显著产量损失、种子萌发变慢及种子寿命急剧缩短，镍补充可完全挽救上述表型。","reason","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-15T00:00:00.000Z","discoveredAt","2026-11-16T00:55:13.229Z","timelineAt","category","research","tags",[75],"score",8,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f_tgQLCsu7RU","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","papers","name","论文研究",{"_72":73,"_13":74},"publicId","9896b447-0fe5-4ece-8ea4-bc23b39f7d69","Cell发表ZmNAET1介导镍向籽粒转运研究","论文/研究","https://news.bioon.com/article/133f96390187.html","生物谷",{"_79":80,"_81":-5,"_82":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
