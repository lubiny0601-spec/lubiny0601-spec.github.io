[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795410125000,"id","nv5c0dm51azewdriddguukjib","title","GSK 德莫奇单抗、美泊利珠单抗纳入 2026 年国家医保目录","originalTitle","GSK两款创新生物制剂纳入新版国家医保目录，创新治疗加速可及，助力呼吸慢病迈向精准、长期管理","summary","GSK 宣布易适来（德莫奇单抗）与新可来（美泊利珠单抗注射液）纳入《国家基本医疗保险、生育保险和工伤保险药品目录（2026年）》。德莫奇单抗覆盖重度嗜酸性粒细胞性哮喘和慢性鼻窦炎伴鼻息肉两项适应症，每年给药两次，今年上半年在中国获批后同年进入医保；美泊利珠单抗本次新增慢阻肺病适应症纳入支付范围，其重度嗜酸性粒细胞性哮喘、慢性鼻窦炎伴鼻息肉及嗜酸性肉芽肿性多血管炎三项适应症同步续约。","reason","两款呼吸生物制剂进医保的具体适应症与续约范围，可帮助判断嗜酸性粒细胞相关慢病的准入变化。","source",{"_73":93},"links",{"_60":92},"publishedAt","2026-11-14T05:39:17.000Z","discoveredAt","2026-11-16T01:00:55.874Z","timelineAt","category","policy","tags",[87,88,80,89,90,91],"score",62,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","readingMode","full","author","body","outline",[],"relatedStories",[83],"topics",[67,68,69,70,71],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fyahqeJ8mAc0","reportCount",1,"additionalSourceCount",0,{"_72":81,"_73":82},{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":31,"_73":74},"slug","name","政策与监管","insurance","医保与集采","antibody","抗体与双抗","respiratory","呼吸","gsk","GSK 葛兰素史克",{"_84":85,"_13":86},"publicId","54e9897c-3b29-4780-b9b9-0a81fcc01ae6","GSK两款呼吸生物制剂纳入2026年国家医保目录","政策/监管","医保/集采","抗体/双抗","GSK","国家医保局","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604829&idx=1&sn=8794d3e75ea623888f9e2788fcac4246&chksm=fcc25c6faca38ec7b8a9075f60d37ed45d7fd911796634e6c4feedf6182b1665867b5f21562c&scene=126&sessionid=1794790833#rd","呼吸界",{"_95":96,"_97":-5,"_98":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
