[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384583000,"id","nfoi2srvarqrb8ldz6dd5u3vw","title","36家药企被点名；6个中成药被取消集采中选资格；九州通新公司来了","originalTitle","36家药企被点名；6个中成药被取消集采中选资格；九州通新公司来了...","summary","河南省公共资源交易中心近日点名36家医药企业，指其涉嫌违背公平合理、诚实信用、质价相符原则，涉及医药价格和招采信用评价预评级。上海取消6个中成药全国中成药联采中选资格，涉及5家药企，自2026年11月7日起执行。中国生物制药与勃林格殷格翰签下涵盖6个临床前ADC及TCE资产的许可协议，获3.58亿美元首付款及近期付款，潜在里程碑最高70亿美元。","reason","source",{"_64":80},"links",{"_57":79},"publishedAt","2026-11-07T12:15:14.000Z","discoveredAt","2026-11-09T06:32:39.166Z","timelineAt","category","industry","tags",[65,67,72,73,74,75,76,77,78],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":70,"_64":71},{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","company-news","name","公司动态","capital","投融资","deals","交易与授权","insurance","医保与集采","中国生物制药","九州通","诺和诺德","医保/集采","交易/授权","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669765&idx=1&sn=9b7d0c07402055a8f6a25cbb068a890f&chksm=bc642152beee1aa3b68116cd76d447d76d8d2de59cb51fbe6d15a65fc6e8df61bc498713288a&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_82":83,"_84":-5,"_85":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
