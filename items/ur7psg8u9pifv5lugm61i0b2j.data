[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1795410124000,"id","ur7psg8u9pifv5lugm61i0b2j","title","默沙东、礼来、艾伯维、辉瑞、BMS 向美国众议院委员会表示不在新疆及解放军关联医院启动新临床试验","originalTitle","STAT+: Big drugmakers tell House committee they will halt clinical trials at some hospitals in China","summary","美国众议院中国问题特别委员会披露，默沙东、礼来、艾伯维、辉瑞、BMS 五家药企已书面表示，不计划在中国新疆地区或与中国军方关联的医院启动新的临床试验点。该委员会去年 6 月对上述五家公司展开调查，关注试验点的知识产权暴露、军方关联与伦理标准问题；五家公司均表示不会在与解放军关联的试验点启动新临床研究。","reason","美国众议院委员会调查五家跨国药企在华临床试验，企业以书面承诺回应，反映地缘政治对试验布局的影响。","source",{"_69":86},"links",{"_59":85},"publishedAt","2026-11-20T00:00:00.000Z","discoveredAt","2026-11-23T04:24:56.380Z","timelineAt","category","industry","tags",[72,70,83,80,78,74,82,84],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","Ed Silverman","body","outline",[],"relatedStories",[],"topics",[60,61,62,63,64,65,66],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_67":81,"_69":82},{"_67":79,"_69":80},{"_67":77,"_69":78},{"_67":75,"_69":76},{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","trends","name","行业趋势","company-news","公司动态","abbvie","艾伯维","bms","BMS 百时美施贵宝","lilly","礼来","msd","默沙东","pfizer","辉瑞","FDA","BMS","https://www.statnews.com/pharmalot/2026/11/19/china-pharma-biotech-clinical-trials-security-risk-patents-drug-development/?utm_campaign=rss","STAT",{"_88":89,"_90":-5,"_91":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
