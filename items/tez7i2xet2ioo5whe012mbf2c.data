[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793888173000,"id","tez7i2xet2ioo5whe012mbf2c","title","Rose BioSolutions CEO David Enloe 谈超越外包：如何建立更好的 CDMO 合作关系","originalTitle","Beyond Outsourcing: Building Better CDMO Partnerships","summary","Rose BioSolutions CEO David Enloe 提出 CDMO 应从单纯执行申办方既定工艺的供应商，转变为申办方团队的延伸，尤其在细胞与基因治疗等复杂疗法中。他认为科学领导力、监管专长、质量知识与项目管理正日益决定项目能否高效推进至临床，并主张在项目前端共同审视风险、挑战假设，以避免后期昂贵的返工与延误。","reason","source",{"_72":85},"links",{"_60":84},"publishedAt","2026-11-04T21:43:03.000Z","discoveredAt","2026-11-05T05:13:23.126Z","timelineAt","category","opinion","tags",[82,83,77],"score",8,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Kathy Vuksanaj","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","f5HXb1ZDtJZo","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","opinions","name","观点与解读","cxo","CXO 与外包","cell-gene","细胞与基因治疗",{"_79":80,"_13":81},"publicId","a3b29c0b-bb9b-4992-a01a-cb530cbb5061","Rose BioSolutions CEO 谈 CDMO 合作模式转变","观点/解读","CXO","https://www.genengnews.com/sponsored/beyond-outsourcing-building-better-cdmo-partnerships/","GEN Genetic Engineering & Biotechnology News",{"_87":88,"_89":-5,"_90":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
