[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794791088000,"id","cy615dx5b3ywgwqj1m58mizck","title","FDA 要求所有 GLP-1 药物说明书新增 NAION 眼病风险警示，涉及司美格鲁肽、替尔泊肽","originalTitle","突发！GLP-1药物新增罕见眼病警告，涉及司美格鲁肽、替尔泊肽...","summary","11 月 9 日，FDA 要求所有 GLP-1 受体激动剂上市许可持有人在美国说明书“警告和注意事项”部分增加非动脉炎性前部缺血性视神经病变（NAION）潜在风险信息，范围从司美格鲁肽扩至替尔泊肽及 2026 年获批的口服小分子 Foundayo。","reason","FDA 把 NAION 警示从司美格鲁肽扩至全部 GLP-1 药物，读者可据此了解说明书修订范围与各国监管口径差异。","source",{"_65":79},"links",{"_59":78},"publishedAt","2026-11-10T11:54:18.000Z","discoveredAt","2026-11-11T08:18:17.999Z","timelineAt","category","policy","tags",[73,74,75,76,77,70],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","凯西","body","outline",[],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_64":71,"_65":72},{"_64":69,"_65":70},{"_64":67,"_65":68},{"_64":31,"_65":66},"slug","name","政策与监管","metabolic","代谢与减重","lilly","礼来","fda","美国 FDA","政策/监管","GLP-1","代谢/减重","FDA","诺和诺德","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670067&idx=4&sn=1aba008d7091e137fec6c9de86badac5&chksm=bc6b73b20544af489e8ce63cb00b425215066594cac9d5821867fa8ee4c808a0ebefb093f24f&scene=126&sessionid=1794384945#rd","赛柏蓝",{"_81":82,"_83":-5,"_84":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
