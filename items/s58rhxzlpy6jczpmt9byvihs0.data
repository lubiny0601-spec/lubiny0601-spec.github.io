[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793888182000,"id","s58rhxzlpy6jczpmt9byvihs0","title","美国国会重新提交《Pasteur Act》法案，以订阅模式激励抗生素研发","originalTitle","Congress Reintroduces the Pasteur Act","summary","美国参众两院议员重新提交《Pasteur Act》法案，拟通过订阅模式让联邦政府以分期付款方式投资新型抗生素和抗真菌药，换取政府项目免费使用。法案旨在激励针对最具威胁感染的创新药物研发、改善抗生素合理使用并保障国内供应。5家机构联合发声支持，指出美国每15分钟就有1人死于现有抗菌药物耐药感染。","reason","source",{"_61":73},"links",{"_57":72},"publishedAt","2023-05-01T17:29:24.827Z","discoveredAt","2026-10-28T01:14:48.491Z","timelineAt","category","policy","tags",[65,66,67,68,69,70,71],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","antibiotics","抗菌药物与耐药","政策/监管","抗菌药物","耐药与院感","抗感染","市场准入","对市场","对准入","https://www.contagionlive.com/view/congress-reintroduces-the-pasteur-act","Contagion Live·医院感染",{"_75":76,"_77":-5,"_78":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
