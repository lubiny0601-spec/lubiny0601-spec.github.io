[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":52,"_53":-5,"_54":35,"_55":56},"expiresAt",1795410151000,"id","gx0337ehe4g9qfnni70mba335","title","我国申请加入PIC/S工作首次观摩检查正式启动","originalTitle","summary","11月11日，我国申请加入PIC/S工作的首次观摩检查正式启动，标志着该项工作进入关键攻坚期。国家药监局2023年9月提交正式申请材料、当年11月被确认为正式申请者；今年8月PIC/S已完成现场资料评估且结果向好，本月起来自12个国家的观摩检查小组将依次来华开展现场观摩检查。观摩检查结果将与现场资料评估报告一并汇总，作为PIC/S委员会作出入会判断的重要依据。","reason","source",{"_60":67},"links",{"_56":66},"publishedAt","2026-11-13T00:00:00.000Z","discoveredAt","2026-11-16T00:55:14.846Z","timelineAt","category","policy","tags",[64,65],"score",38,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_59":62,"_60":63},{"_59":29,"_60":61},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-13/1110471.shtml","中国食品药品网·要闻",{"_69":70,"_71":-5,"_72":52},"changelogVersion","2026-10-08T08:00","release","staticSite"]
