[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1793889545000,"id","bzmybm14i4o3eeyfhtrt0rhm9","title","盐野义将南京长澳与深圳联诚100%股权转让给浙江高跖医药","originalTitle","盐野义的两家中国子公司，卖给了浙江高跖医药","summary","10月29日，盐野义制药与浙江高跖医药同时宣布，盐野义中国仿制药业务主体南京长澳制药与深圳联诚医药各100%股权转让给成立仅五年的高跖医药。南京长澳拥有冻干粉针、固体制剂、软膏乳膏凝胶三条产线及注射用雷贝拉唑钠、匹伐他汀钙片、克拉霉素分散片等50件注册证，深圳联诚负责长澳产品全国营销并持有阿莫西林胶囊“阿莫灵”中国大陆独家经销权。","reason","文章把盐野义出售中国仿制药资产放进外企在华腾笼换鸟的脉络里，并点出整合成败的关键。","source",{"_74":92},"links",{"_61":91},"publishedAt","2026-10-29T23:50:56.000Z","discoveredAt","2026-10-31T03:04:30.469Z","timelineAt","category","industry","tags",[86,77,75,87,88,89,90],"score",65,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","点苍鹤","body","outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","f3iR17oXlsXw","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","trends","name","行业趋势","company-news","公司动态","deals","交易与授权","antibiotics","抗菌药物与耐药",{"_83":84,"_13":85},"publicId","e9287c07-0729-428e-aec3-2c1eba5f857f","盐野义将两家中国仿制药子公司股权转让给高跖医药","交易/授权","抗菌药物","抗感染","企业竞争","对市场","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699438&idx=1&sn=d8a05345c615dbe60194bc6bd1b95960&chksm=bca78c1fafdf1d6222d48e9285e10f59379583882e5082125711d0c0bdf37d3087ca30d21d27&scene=126&sessionid=1793415858#rd","医药云端工作室",{"_94":95,"_96":-5,"_97":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
