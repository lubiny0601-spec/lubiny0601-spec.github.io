[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408366000,"id","cljvkpzadcxpipxm2sdytj7l5","title","产品价值再亮眼，进不了医院都是白搭：药企医院准入的落地难题","originalTitle","产品价值再亮眼，进不了医院，都是白搭","summary","药企即便临床证据充分、疗效优势明确，仍常卡在医院准入环节，无法进入院内目录和科室使用。医院评审受目录名额紧张、DRG/DIP控费约束和科室考核压力制约，主任认可疗效也常因院内存量腾挪与成本核算难以推进。产品价值需转化为医院可用的方案，结合临床路径测算住院成本、平均住院日与并发症风险，证明可优化病组成本和考核指标。","reason","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-15T04:07:46.000Z","discoveredAt","2026-11-16T01:00:39.348Z","timelineAt","category","opinion","tags",[75],"score",10,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fc7jcAgjwo14","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","opinions","name","观点与解读",{"_72":73,"_13":74},"publicId","3aaed769-4fec-49bb-8af5-a8f4fa1df730","药企产品价值难破医院准入关","观点/解读","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699684&idx=2&sn=76000462da26d5e262637862a2b57467&chksm=bcdccb3d998c8dd62756e9d288bef3aa915a9da055077efdae37ea59ea80d8162d094db88eee&scene=126&sessionid=1794790832#rd","医药云端工作室",{"_79":80,"_81":-5,"_82":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
