[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795408366000,"id","clrgtyyso5tvea380iav3uy0z","title","复星系老将李梅正式接任葫芦娃法定代表人","originalTitle","葫芦娃法定代表人换人，复星系老将正式接任","summary","11月14日，ST葫芦娃完成工商变更登记，法定代表人由刘景萍变更为李梅，此前11月5日公司已聘任李梅为总经理。李梅曾长期在复星万邦（江苏）健康发展有限公司任总经理、联席CEO，并曾分享非布司他片4年销售增长12倍的营销经验。葫芦娃2024年、2025年及2026年前三季度营收分别同比下降21.26%、36.27%、42.25%，同期归母净利润分别亏损2.74亿元、2.87亿元和1.46亿元。","reason","source",{"_63":68},"links",{"_58":67},"publishedAt","2026-11-15T10:27:27.000Z","discoveredAt","2026-11-16T01:01:11.717Z","timelineAt","category","industry","tags",[64,66],"score",32,"selected",false,"channel","news","story","x","readingMode","full","author","颜色","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","company-news","name","公司动态","hengrui","恒瑞医药","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670716&idx=2&sn=8da56d64e0bf72ece94f1b5328a521d5&chksm=bc3a0d7ce97d235da2e0f2003a303c6e14dfec8fc1a9a4e0f8a65cf56e5d75f2a3418f0383b3&scene=126&sessionid=1794790858#rd","赛柏蓝",{"_70":71,"_72":-5,"_73":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
