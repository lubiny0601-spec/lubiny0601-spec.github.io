[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793889547000,"id","nh4xbp74r20x7wa65rz42m11h","title","多组学人胶质母细胞瘤细胞图谱或可成为指导未来治疗方案的指南针","originalTitle","Multiomic Human Glioblastoma Cell Atlas Could Act as Compass to Guide Future Treatment Approaches","summary","Wellcome Sanger Institute、EMBL、DKFZ等机构研究者构建了迄今最大的多模态胶质母细胞瘤（GB）图谱，对12例患者逾100万个细胞进行单细胞与空间图谱分析，发现癌细胞沿可预测的空间模式从发育样状态向胶质损伤反应和缺氧状态转变。相关成果发表于Nature，配套研究解码了调控GB可塑性的基因调控网络并提示潜在靶点。研究团队已将GBM-Space图谱免费开放。","reason","source",{"_72":84},"links",{"_60":83},"publishedAt","2026-11-04T21:19:16.000Z","discoveredAt","2026-11-05T05:13:23.142Z","timelineAt","category","research","tags",[82,77,75],"score",14,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Sophia Ktori","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fEky_k-rWDvY","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","papers","name","论文研究","ai-pharma","AI 制药","oncology","肿瘤",{"_79":80,"_13":81},"publicId","e3ed7e10-9cfa-4936-8b1f-97c7e96a7a06","Nature发表胶质母细胞瘤多组学细胞图谱","论文/研究","https://www.genengnews.com/topics/cancer/multiomic-human-glioblastoma-cell-atlas-could-act-as-compass-to-guide-future-treatment-approaches/","GEN Genetic Engineering & Biotechnology News",{"_86":87,"_88":-5,"_89":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
