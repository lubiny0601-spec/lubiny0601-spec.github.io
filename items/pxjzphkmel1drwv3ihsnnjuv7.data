[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":52,"_53":-5,"_54":35,"_55":56},"expiresAt",1795410146000,"id","pxjzphkmel1drwv3ihsnnjuv7","title","国家药监局党组召开2026年巡视工作会议暨第四轮巡视动员部署会","originalTitle","summary","国家药监局党组11月16日召开2026年巡视工作会议暨第四轮巡视动员部署会，宣布对服务中心、国际交流中心、南方所、特药检查中心开展常规巡视。会议传达学习中央政治局审议《关于二十届中央第七轮巡视情况的综合报告》有关会议精神及全国巡视工作会议精神，局党组成员、副局长王维东出席并讲话。第四轮巡视在中央巡视整改期间同步开展，会议要求精准查摆问题、把政治监督落到实处。","reason","source",{"_60":67},"links",{"_56":66},"publishedAt","2026-11-17T00:00:00.000Z","discoveredAt","2026-11-23T04:24:52.622Z","timelineAt","category","policy","tags",[64,65],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_59":62,"_60":63},{"_59":29,"_60":61},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-17/1110602.shtml","中国食品药品网·要闻",{"_69":70,"_71":-5,"_72":52},"changelogVersion","2026-10-08T08:00","release","staticSite"]
