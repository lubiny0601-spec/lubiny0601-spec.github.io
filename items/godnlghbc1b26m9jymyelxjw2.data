[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443807000,"id","godnlghbc1b26m9jymyelxjw2","title","沈阳长护险制度实施以来已为近5000名失能人员提供长期照护服务","originalTitle","【辽宁】长护送暖入家门 温情守护夕阳红","summary","沈阳市长期护理保险制度自2026年1月实施以来，已陆续为近5000名失能人员提供长期照护服务。铁西区89岁卧床老人王奶奶通过上门帮办提交失能等级评估申请，当月通过评估后获定制擦浴、褥疮护理及换管等服务，每周三次由长期照护师上门提供。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-11-18T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.226Z","timelineAt","category","policy","tags",[65,66,67],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/13/art_14_23377.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
