[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793889547000,"id","sobjvk44kguvrm2txnjb0916x","title","分析：标准化单采流程将助力细胞治疗行业","originalTitle","Standardized Apheresis Processes Would Help Cell Therapy Sector","summary","一项新分析指出，单采环节的操作差异会影响细胞治疗起始材料的质量，部分流程标准化将有利于细胞与基因治疗开发者。作者建议以ISBT 128等现有标准为起点，统一供者合格性数据要素、质量属性定义及产品标识与标签，并呼吁FDA明确研究用与商业化起始材料的区分及境外采集的监管预期。","reason","source",{"_71":81},"links",{"_60":80},"publishedAt","2026-11-04T17:00:51.000Z","discoveredAt","2026-11-05T05:13:23.196Z","timelineAt","category","opinion","tags",[79,74],"score",12,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Corinna Singleman, PhD","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fpYqHaova7p0","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","opinions","name","观点与解读","cell-gene","细胞与基因治疗",{"_76":77,"_13":78},"publicId","afed907d-a57d-4f1f-85a2-9769b166d6bd","分析建议以现有标准统一单采流程","观点/解读","https://www.genengnews.com/topics/bioprocessing/standardized-apheresis-processes-would-help-cell-therapy-sector/","GEN Genetic Engineering & Biotechnology News",{"_83":84,"_85":-5,"_86":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
