[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384583000,"id","r45x6ai05lhz7as5qvhap5tfr","title","2026进博会：京东健康前三季度线上首发超100款新药，与辉瑞、默克、武田等20余家全球药企签约","originalTitle","2026进博会｜新药首发持续领跑，京东健康成礼来、辉瑞等全球药企重要选择","summary","2026年前三季度京东健康线上首发超过100款新药，已超2025年全年总和，覆盖代谢、皮肤、罕见病等领域。进博会期间京东健康集中与辉瑞、默克、武田、勃林格殷格翰、诺华、诺和诺德等超过20家全球医药健康品牌签约，合作从新药首发延伸至患者管理与AI创新。默克明确未来三年将京东健康作为新药上市发布首选渠道。","reason","source",{"_64":78},"links",{"_57":77},"publishedAt","2026-11-07T12:15:14.000Z","discoveredAt","2026-11-09T06:32:42.088Z","timelineAt","category","industry","tags",[67,72,65,71,73,74,75,76],"score",38,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":70,"_64":71},{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","trends","name","行业趋势","company-news","公司动态","market","市场与销售","pfizer","辉瑞","市场/销售","诺华","武田","诺和诺德","阿斯利康","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669765&idx=2&sn=463172aace2a79abcc0cfbd3d44a64d1&chksm=bcdc2aaae940a148b7cba88ec5fa9735cd4b17a1b8129bb94862cd4c511edc36aac59d98d85c&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_80":81,"_82":-5,"_83":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
