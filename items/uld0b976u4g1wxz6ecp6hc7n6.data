[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794384582000,"id","uld0b976u4g1wxz6ecp6hc7n6","title","26家医药企业董事长离职：工作调整占四成，二代接班与国资调配成接棒主线","originalTitle","26家医药企业董事长离职（附名单）","summary","截至11月7日，今年已有26家医药企业发生27次董事长离任变动，其中工作调整或工作变动11条、占比40.74%，个人及身体原因6条、占22.22%，退休、董事会换届或任期届满各4条、分别占14.81%。接任者主要来自集团体系内调配与内部选任，天士力由原总经理蔡金勇接任董事长，天坛生物由梁红军接任；海森药业王雨潇、珍宝岛方福鑫则由年轻二代接棒。","reason","source",{"_63":69},"links",{"_58":68},"publishedAt","2026-11-07T12:15:14.000Z","discoveredAt","2026-11-09T06:32:45.265Z","timelineAt","category","industry","tags",[66,64,67],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","颜色","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","trends","name","行业趋势","company-news","公司动态","恒瑞医药","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669765&idx=3&sn=b26341d7dbc5bbd3c2edd7f437b2408e&chksm=bca7b2ba21aa541b880e8173857832a46c8aa3a9011a6948b923f4a0fd5f854ed883d0411859&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_71":72,"_73":-5,"_74":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
