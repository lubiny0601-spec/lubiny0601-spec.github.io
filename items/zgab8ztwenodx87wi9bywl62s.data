[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384584000,"id","zgab8ztwenodx87wi9bywl62s","title","金陵药业终止收购常州四药100%股权及四药厂部分资产","originalTitle","知名药企终止收购计划","summary","金陵药业11月8日公告决定不参加常州四药100%股权及四药厂部分土地使用权、厂房资产的竞价出售，并终止此前投资意向。公司自2026年4月13日递交《投资意向函》后已开展尽职调查、初步审计及资产评估，截至公告日未签署任何具有法律约束力的协议，称终止不会对生产经营及财务状况产生重大影响。","reason","source",{"_70":79},"links",{"_59":78},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-09T06:26:01.734Z","timelineAt","category","industry","tags",[71,73],"score",38,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fdEMzAl9_Cwc","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","company-news","name","公司动态","capital","投融资",{"_75":76,"_13":77},"publicId","6bbff1e2-41d4-4ff4-b1da-9a58dead6103","金陵药业终止收购常州四药股权意向","https://www.menet.com.cn/info/202611/202611090924362436_151410.shtml","米内网·企业",{"_81":82,"_83":-5,"_84":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
