[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205955000,"id","bciqnkwdp5kewbbwxb1lx808o","title","Leapfrog Group 2023年秋季医院安全评级显示医院感染率下降","originalTitle","National Safety Grades Show Decrease in HAIs in Hospitals","summary","Leapfrog Group 2023年秋季医院安全评级显示，近3000家综合医院在疫情后降低了医疗相关感染率，MRSA、CLABSI和CAUTI三项感染指标较高峰期改善，超过85%的医院至少一项感染指标好转。本轮评级中近30%医院获“A”，24%获“B”，39%获“C”。患者体验评分连续第二年下降，所有州均出现下滑。","reason","source",{"_62":72},"links",{"_57":71},"publishedAt","2023-11-07T21:25:01.865Z","discoveredAt","2026-10-27T15:41:44.983Z","timelineAt","category","research","tags",[66,67,68,69,70],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","论文/研究","耐药与院感","抗感染","循证指南","对市场","https://www.contagionlive.com/view/national-safety-grades-show-decrease-in-hais-in-hospitals","Contagion Live·医院感染",{"_74":75,"_76":-5,"_77":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
