[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794791088000,"id","cy13d4uidahrp0yi7v3os5021","title","罗氏艾美赛珠单抗纳入 2026 年版国家医保目录，覆盖 A 型血友病规律替代治疗","originalTitle","艾美赛珠单抗成功纳入国家医保，开启血友病 “零出血” 全年龄段长守护新纪元","summary","国家医保局公布《国家基本医疗保险、生育保险和工伤保险药品目录（2026 年版）》，罗氏制药中国的艾美赛珠单抗注射液（舒友立乐）纳入医保，报销范围覆盖伴或不伴凝血因子 VIII 抑制物的 A 型血友病患者规律替代治疗。","reason","艾美赛珠单抗进医保后，A 型血友病规律替代治疗首次覆盖成人，读者可据此判断皮下给药方案在院内的准入空间。","source",{"_74":92},"links",{"_61":91},"publishedAt","2026-11-14T11:08:01.000Z","discoveredAt","2026-11-16T00:55:17.840Z","timelineAt","category","policy","tags",[88,89,81,79,83,90],"score",71,"selected",true,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","永恒","body","outline",[],"relatedStories",[84],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fuq1AHWdcgMM","reportCount",1,"additionalSourceCount",0,{"_73":82,"_74":83},{"_73":80,"_74":81},{"_73":78,"_74":79},{"_73":76,"_74":77},{"_73":31,"_74":75},"slug","name","政策与监管","insurance","医保与集采","hematology","血液","rare-disease","罕见病","roche","罗氏",{"_85":86,"_13":87},"publicId","39577266-2472-4efb-90f8-11750b2b5d56","艾美赛珠单抗纳入2026年国家医保目录","政策/监管","医保/集采","国家医保局","https://www.drugtimes.cn/2026/11/14/aimeisaizhudankangchenggongnaruguojiayibaokaiqixueyoubinglin/","药时代",{"_94":95,"_96":-5,"_97":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
