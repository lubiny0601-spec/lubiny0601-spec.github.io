[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384583000,"id","n1gow9ocpk6bnjnhzzbww2nhu","title","慢阻肺病7年后出现蓝嘴唇、腿脚肿，迟春花教授解析肺动脉高压诊断","originalTitle","他确诊7年后又添怪病，蓝嘴唇、腿脚肿……所有肺病患者都逃不脱？","summary","北京大学第一医院迟春花教授解析一例慢阻肺病确诊7年后新发蓝嘴唇、活动后气短的病例，右心导管实测平均肺动脉压力28毫米汞柱、肺血管阻力3.8 Wood单位，超过20毫米汞柱诊断界值，确诊肺动脉高压。长期缺氧刺激肺小动脉收缩并结构重塑，肺循环压力升高，右心负荷加重可致肺心病。疾病所致\"蓝嘴唇\"变色范围更广、持续不消退且随活动加重，常伴气短、胸闷、心悸。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-07T12:20:37.000Z","discoveredAt","2026-11-09T06:31:01.857Z","timelineAt","category","opinion","tags",[78,73],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fNZPepkNvGSE","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","respiratory","呼吸",{"_75":76,"_13":77},"publicId","fc752354-652f-47bb-843e-9b7042379d13","慢阻肺病7年后确诊肺动脉高压，迟春花解析诊断","观点/解读","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604564&idx=2&sn=dceb2caeb98675614775ab7ae6a1d063&chksm=fcf5029dbd452b640ff787b6629e66dbf7cbcbd568bf65e0a94ab97dd9f3ad2ba0e54c7e3178&scene=126&sessionid=1794205843#rd","呼吸界",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
