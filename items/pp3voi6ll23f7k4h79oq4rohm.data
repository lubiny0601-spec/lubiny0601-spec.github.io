[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794384598000,"id","pp3voi6ll23f7k4h79oq4rohm","title","恒瑞瑞康曲妥珠单抗一线HER2阳性乳腺癌新适应症上市申请获受理并纳入优先审评","originalTitle","恒瑞ADC创新药瑞康曲妥珠单抗新适应症上市申报获受理且被纳入优先审评程序","summary","恒瑞医药子公司苏州盛迪亚的注射用瑞康曲妥珠单抗新适应症上市许可申请获国家药监局受理，并被纳入优先审评，适应症为联合或不联合帕妥珠单抗一线治疗局部晚期或转移性HER2阳性乳腺癌。","reason","材料交代了瑞康曲妥珠单抗一线HER2阳性乳腺癌新适应症的受理与优先审评，并给出III期研究设计与终点，读者可据此判断其乳腺癌一线布局。","source",{"_65":77},"links",{"_58":76},"publishedAt","2026-10-30T00:00:00.000Z","discoveredAt","2026-11-11T08:03:55.498Z","timelineAt","category","industry","tags",[73,70,74,72,75],"score",62,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","pipeline","name","研发管��","adc","ADC 与偶联药物","oncology","肿瘤","hengrui","恒瑞医药","研发管线","ADC","NMPA","https://www.hengrui.com/media/detail-1063.html","恒瑞医药·新闻",{"_79":80,"_81":-5,"_82":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
