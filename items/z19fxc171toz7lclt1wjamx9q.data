[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794205945000,"id","z19fxc171toz7lclt1wjamx9q","title","海创药业VAV1分子胶降解剂HP570海外权益授权Evommune，总额最高约11亿美元","originalTitle","11亿美元！海创药业VAV1分子胶降解剂出海","summary","海创药业与Evommune就口服VAV1分子胶降解剂HP570达成独家授权协议，授予其大中华地区以外全球开发、生产及商业化权益。Evommune支付3000万美元首付款，海创药业另可获最高约10.7亿美元开发、监管注册及商业化里程碑付款和阶梯式特许权使用费。HP570的IND已获FDA批准，为国内首个获FDA临床许可的VAV1分子胶降解剂，国内IND仍在审评中，I期临床试验即将启动。","reason","交易金额结构与VAV1分子胶的差异化机制一并给出，可对照同类自免靶点的授权定价。","source",{"_66":78},"links",{"_59":77},"publishedAt","2026-11-05T01:54:34.000Z","discoveredAt","2026-11-09T06:26:03.908Z","timelineAt","category","industry","tags",[74,75,71,76],"score",56,"selected",true,"channel","news","story","x","readingMode","full","author","yian","body","outline",[],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","pipeline","name","研发管��","deals","交易与授权","small-molecule","小分子","immunology","自免与炎症","交易/授权","自免","研发管线","https://www.drugtimes.cn/2026/11/05/11yimeiyuanhaichuangyaoyevav1fenzijiaojiangjiejichuhai/","药时代",{"_80":81,"_82":-5,"_83":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
