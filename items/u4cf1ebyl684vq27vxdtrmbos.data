[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794205956000,"id","u4cf1ebyl684vq27vxdtrmbos","title","上海医药曲前列尼尔二乙醇胺吸入粉雾剂获NMPA临床试验批准","originalTitle","上海医药｜上海医药集团股份有限公司关于曲前列尼尔二乙醇胺吸入粉雾剂获得临床试验批准通知书的公告","summary","上海医药下属上药睿尔的曲前列尼尔二乙醇胺吸入粉雾剂获国家药监局《药物临床试验批准通知书》，同意开展临床试验。该药为2.2类改良型创新药，活性成分为人工合成前列环素类衍生物，拟用于治疗肺动脉高压（PAH，WHO第1组），通过舒张肺和全身动脉血管床并抑制血小板聚集发挥作用。截至公告日该项目累计研发投入约2,141万元人民币，尚未在全球任何国家或地区获批上市。","reason","source",{"_71":86},"links",{"_59":85},"publishedAt","2026-11-04T16:00:00.000Z","discoveredAt","2026-11-05T05:13:24.119Z","timelineAt","category","clinical","tags",[72,76,74,83,84],"score",15,"selected",false,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","body","outline",[],"relatedStories",[79],"topics",[66,67,68,69],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fFQl4_QVOrzc","reportCount",1,"additionalSourceCount",0,{"_70":77,"_71":78},{"_70":75,"_71":76},{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","临床进展","small-molecule","小分子","respiratory","呼吸","nmpa","中国 NMPA",{"_80":81,"_13":82},"publicId","6d6d6323-73a7-45da-ae08-c5017741ed20","上海医药曲前列尼尔吸入粉雾剂获临床试验批准","上海医药","NMPA","https://static.cninfo.com.cn/finalpage/2026-11-05/1225657259.PDF","上海医药·公司公告",{"_88":89,"_90":-5,"_91":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
