[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384584000,"id","m7s37krw9qugvws6jhtaefymu","title","陆军军医大学王延江团队揭示Tau蛋白致蓝斑去甲肾上腺素能神经元过度兴奋机制，驱动睡眠碎片化与认知下降","originalTitle","Cell子刊：睡不好、记性差？陆军军医大学王延江团队揭示Tau蛋白致蓝斑神经元过度兴奋机制","summary","陆军军医大学王延江、重庆大学谌小维团队在 Cell Reports 发表研究，利用 P301S 转基因小鼠及细胞类型特异性 tau 过表达模型发现，病理性 tau 蓄积选择性升高蓝斑多巴胺-β-羟化酶去甲肾上腺素能（LCDBH）神经元内在兴奋性，破坏睡眠稳态、减少 NREM 睡眠与慢波活动并造成识别记忆缺损。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-09T06:26:04.633Z","timelineAt","category","research","tags",[78,79],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f_vKtdPPCKiU","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","neuroscience","神经与精神",{"_75":76,"_13":77},"publicId","c32a165a-bfe7-4769-bf62-170bc9390605","Tau过度兴奋蓝斑神经元致睡眠与认知损害","论文/研究","神经/精神","https://news.bioon.com/article/9c639626999f.html","生物谷",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
