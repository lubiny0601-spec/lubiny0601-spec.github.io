[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793888173000,"id","r02d2e1kkacht7fooadaacl7y","title","治疗模态扩展下基因组图谱需同步跟进：Sampled 谈 CGP 如何支持肿瘤药物研发","originalTitle","As Therapeutic Modalities Expand, Genomic Profiling Must Keep Pace","summary","随着细胞与基因治疗、RNA 疗法、靶向蛋白降解、ADC 等模态成熟，曾被视为\"不可成药\"的靶点重新受到关注，药物开发者需要更广泛地审视基因组变异。Sampled 提供整合样本采集套件、样本存储、端到端样本处理、基因组图谱与数据分析的实验室与生物样本库服务，其全面基因组图谱（CGP）覆盖单核苷酸变异、插入缺失、拷贝数变异及部分基因融合。","reason","source",{"_74":91},"links",{"_60":90},"publishedAt","2026-11-04T20:49:13.000Z","discoveredAt","2026-11-05T05:13:23.166Z","timelineAt","category","opinion","tags",[88,83,79,89,77],"score",8,"selected",false,"channel","news","story",{"_85":86,"_13":87},"x","readingMode","full","author","Kathy Vuksanaj","body","outline",[],"relatedStories",[84],"topics",[67,68,69,70,71],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fYV1BAOJfpWI","reportCount",1,"additionalSourceCount",0,{"_72":82,"_74":83},{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","opinions","name","观点与解读","ai-pharma","AI 制药","cell-gene","细胞与基因治疗","adc","ADC 与偶联药物","oncology","肿瘤",{"_85":86,"_13":87},"publicId","3c626bfd-2df7-4b34-9003-b77ee5ec68eb","Sampled 称治疗模态扩展需更广基因组图谱","观点/解读","ADC","https://www.genengnews.com/sponsored/as-therapeutic-modalities-expand-genomic-profiling-must-keep-pace/","GEN Genetic Engineering & Biotechnology News",{"_93":94,"_95":-5,"_96":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
