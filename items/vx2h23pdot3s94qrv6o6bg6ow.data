[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794205946000,"id","vx2h23pdot3s94qrv6o6bg6ow","title","多数美国人不了解kratom：它是什么，谁在使用？","originalTitle","Most people haven’t heard of kratom. What is it, and who’s using it?","summary","Annenberg公共政策中心调查显示，约三分之二（66%）美国人从未听说过kratom。该植物及其衍生物（如7-OH、MGPI、MGM-15）在烟店和加油站货架日益普遍且效力大幅提升，联邦限制政策待定，多州和地方已对7-OH甚至全部kratom产品发布紧急禁令。在有一定了解的人群中，很少有人能区分天然叶片形式与合成产品。","reason","source",{"_64":73},"links",{"_58":72},"publishedAt","2026-11-06T09:30:00.000Z","discoveredAt","2026-11-09T06:26:05.196Z","timelineAt","category","research","tags",[70,71,65],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","Theresa Gaffney","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","trends","name","行业趋势","safety","安全与质量","papers","论文研究","论文/研究","安全/质量","https://www.statnews.com/2026/11/06/what-is-kratom-addiction-risks-explained-7-oh/?utm_campaign=rss","STAT",{"_75":76,"_77":-5,"_78":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
