[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1795443790000,"id","my83a4lpsp2zyvri6aerxa0cm","title","2026版国家医保目录与商保创新药目录发布，新增107种新药、净增78个编号","originalTitle","刚刚！2026国家医保目录、商保创新药目录发布（附下载）","summary","2026版国家医保药品目录新增107种新药、调出34种，综合调整后净增78个编号，药品总数达3331个，其中西药1935个、中成药1396个。商保创新药目录新增12种创新药、总数28种，瑞基奥仑赛与盐酸沙丙蝶呤片由商保目录转入基本医保。新版目录2027年1月1日执行，新增药品原则上2026年12月底前完成省级平台挂网，4种未续约调出药品享6个月支付过渡期。","reason","目录新增107种新药、调出34种，并给出挂网、药事会与过渡期的具体节点，可据此安排准入节奏。","source",{"_63":76},"links",{"_59":75},"publishedAt","2026-11-14T05:35:05.000Z","discoveredAt","2026-11-16T01:03:24.580Z","timelineAt","category","policy","tags",[67,68,69,70,71,72,73,74],"score",88,"selected",true,"channel","news","story","x","readingMode","full","author","凯西","body","outline",[],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":65,"_63":66},{"_62":31,"_63":64},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","恒瑞医药","百济神州","信达生物","康方生物","诺华","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670661&idx=1&sn=7aaa3d6afe5a061f4b1934b0bdd3d582&chksm=bceebb566421c1517a0d2bd659095d0e461888455c337c1f76767eaaeb9c1c44ce38af4c2aa9&scene=126&sessionid=1794790858#rd","赛柏蓝",{"_78":79,"_80":-5,"_81":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
