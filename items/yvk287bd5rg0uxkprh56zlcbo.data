[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794384586000,"id","yvk287bd5rg0uxkprh56zlcbo","title","流感、新冠核酸均阴性仍不能排除病毒性肺炎：40岁女性高热黄痰、CRP 125.6 mg/L、双肺斑片影，mNGS检出人偏肺病毒","originalTitle","流感、新冠核酸均阴性，能否排除病毒性肺炎？40岁女性高热黄痰、CRP 125.6 mg/L、双肺斑片影，广泛病灶所为何因？","summary","40岁女性高热咳嗽咳黄痰4天，甲型流感、乙型流感及新冠病毒核酸均阴性，CRP 125.6 mg/L、PCT 0.03 ng/mL，胸部CT示双肺多发斑片灶，经验性抗细菌治疗无好转。支气管肺泡灌洗液DNA+RNA mNGS检出大量人偏肺病毒核酸序列（28576条），最终诊断人偏肺病毒肺炎。人偏肺病毒感染尚无特异性抗病毒治疗，以支持治疗为主，检出病毒后仍需复评经验性抗菌用药的必要性。","reason","source",{"_64":78},"links",{"_58":77},"publishedAt","2026-10-28T11:28:13.000Z","discoveredAt","2026-11-02T13:58:53.003Z","timelineAt","category","clinical","tags",[65,72,67,73,74,75,76],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","罗佳伟  马玉燕等","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":70,"_64":71},{"_63":68,"_64":69},{"_63":66,"_64":67},{"_63":30,"_64":65},"slug","name","临床进展","respiratory","呼吸","antibiotics","抗菌药物与耐药","infectious","感染与疫苗","感染/疫苗","耐药与院感","抗感染","循证指南","对销售","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604092&idx=1&sn=663f1b08a9d28d4cb1a3ec67bd28eddb&chksm=fcaa2c983770a402ef2b632f7b104aeb6b7f618ad91988d78a7a1dcb72c4ee44d54e3e133924&scene=126&sessionid=1793627912#rd","呼吸界",{"_80":81,"_82":-5,"_83":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
