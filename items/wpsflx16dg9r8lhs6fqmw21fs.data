[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1795410124000,"id","wpsflx16dg9r8lhs6fqmw21fs","title","NMPA 批准醋酸索乐匹尼布片等一批药品，恒瑞止吐复方新增中度致吐适应症","originalTitle","刚刚，多款重磅品种获批，新增新适应症！恒瑞、和黄、欣峰制药等","summary","11月18日国家药监局官网显示一批药品获批上市，包括和记黄埔医药（上海）的醋酸索乐匹尼布片，用于既往一线标准治疗无效或复发的成人原发慢性免疫性血小板减少症（ITP），为国内该靶点首个获批产品。","reason","一批同日获批品种里，国产首创靶点药与改良剂型的适应症拓展方向，可供判断院内用药结构变化。","source",{"_69":85},"links",{"_59":84},"publishedAt","2026-11-19T08:52:06.000Z","discoveredAt","2026-11-23T04:30:53.053Z","timelineAt","category","approval","tags",[70,76,78,74,72,83,80],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","药事达","body","outline",[],"relatedStories",[],"topics",[60,61,62,63,64,65,66],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_67":81,"_69":82},{"_67":79,"_69":80},{"_67":77,"_69":78},{"_67":75,"_69":76},{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","approvals","name","获批上市","small-molecule","小分子","hematology","血液","rare-disease","罕见病","oncology","肿瘤","hengrui","恒瑞医药","nmpa","中国 NMPA","NMPA","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699737&idx=2&sn=dd440934e12caf4c63d4e80333baf90d&chksm=bc25936a990efc19716ea412102b07cea0e97bec77cc46d72f1dd01040d879e37a0eed6e8ffa&scene=126&sessionid=1795408227#rd","医药云端工作室",{"_87":88,"_89":-5,"_90":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
