[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795410158000,"id","j3sjgxul7l1rip2bu684i0abs","title","CDE 发布《药物临床试验安全信息报告与风险沟通交流技术指导原则》","originalTitle","CDE发布《药物临床试验安全信息报告与风险沟通交流技术指导原则》","summary","国家药监局药审中心发布《药物临床试验安全信息报告与风险沟通交流技术指导原则》（2026 年第 52 号通告），自发布之日起施行。该指导原则用于规范药物临床试验各方之间的安全性信息报告流转和风险沟通交流，明确各方职责并强化风险相称理念，以保护试验参与者安全。","reason","CDE 明确临床试验各方安全信息报告职责，强化风险相称理念，涉及申办方与研究者的日常合规流程。","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-11T14:04:23.265Z","timelineAt","category","policy","tags",[66,67],"score",50,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-09/1110232.shtml","中国食品药品网·要闻",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
