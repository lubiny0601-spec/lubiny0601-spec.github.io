[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794791089000,"id","rabta62futqrn55vggnegpvpm","title","FDA 拒绝 Summit Therapeutics 与康方生物肺癌药物 ivonescimab 的上市申请","originalTitle","STAT+: FDA rejects lung cancer treatment ivonescimab from Summit Therapeutics","summary","FDA 拒绝批准 Summit Therapeutics 与康方生物开发的肺癌药物 ivonescimab，理由是该药未能延长患者生存期。FDA 审评人员指出，尽管该药可延缓肺癌进展，但缺乏生存获益\"不支持支持批准的正面获益-风险特征\"。Summit 负责该药中国以外地区的开发。","reason","source",{"_73":87},"links",{"_60":86},"publishedAt","2026-11-15T15:05:15.000Z","discoveredAt","2026-11-16T00:55:13.509Z","timelineAt","category","approval","tags",[74,76,85,78],"score",41,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Adam Feuerstein","body","outline",[],"relatedStories",[81],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fKsBBaeOKCAs","reportCount",1,"additionalSourceCount",0,{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","approvals","name","获批上市","oncology","肿瘤","akeso","康方生物","fda","美国 FDA",{"_82":83,"_13":84},"publicId","4da74650-12c3-438e-a8ab-5ad9e017feca","FDA拒绝批准ivonescimab肺癌适应症","FDA","https://www.statnews.com/2026/11/15/fda-rejects-ivonescimab-lung-cancer-treatment-summit-therapeutics/?utm_campaign=rss","STAT",{"_89":90,"_91":-5,"_92":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
