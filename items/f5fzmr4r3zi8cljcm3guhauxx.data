[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443790000,"id","f5fzmr4r3zi8cljcm3guhauxx","title","Cell Metab：上海交通大学占贞贞/夏强等揭示既往肝损伤通过固有免疫记忆加重心肌梗死","originalTitle","Cell Metab：上海交通大学占贞贞/夏强等合作揭示肝损伤为何会让心梗更严重","summary","上海交通大学占贞贞、夏强与海军军医大学刘星光合作在 Cell Metabolism 发表研究，揭示既往肝损伤会引发固有免疫系统长期重编程，使造血干细胞分化偏向髓系命运，加重心肌梗死（MI）期间的炎症损伤。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T11:48:45.391Z","timelineAt","category","research","tags",[81,74,82],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fPyF-KAEvM3U","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","cardiovascular","心血管","immunology","自免与炎症",{"_78":79,"_13":80},"publicId","5b35dc52-1442-4b73-9838-54bfb747d962","研究：既往肝损伤经免疫记忆加重心梗","论文/研究","自免","https://news.bioon.com/article/7a4896529406.html","生物谷",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
