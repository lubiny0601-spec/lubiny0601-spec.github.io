[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794205952000,"id","rfgugry6cxs2dn08sz7fnu1w3","title","第二届临床微生物学学术大会暨中国医药教育协会临床微生物学专业委员会2026年学术年会将于杭州召开","originalTitle","参会通知 | 第二届临床微生物学学术大会暨中国医药教育协会临床微生物学专业委员会2026年学术年会即将启幕！邀您共同参会","summary","中国医药教育协会临床微生物学专业委员会定于2026年8月21日-23日在杭州召开第二届临床微生物学学术大会暨专委会2026年学术年会，由该协会与北京中卫医药卫生科技发展中心、北京整合医学学会联合主办。会议面向专委会全体委员及临床抗感染治疗、临床微生物、临床药师、院感控制与细菌真菌耐药监测研究人员，参会代表注册费700元/人、研究生300元/人。","reason","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-08-17T11:30:02.000Z","discoveredAt","2026-11-02T13:05:43.641Z","timelineAt","category","industry","tags",[64,65,66,67],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","SCM","body","outline",[],"relatedStories",[],"topics",[59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":61,"_62":63},"slug","antibiotics","name","抗菌药物与耐药","其他","耐药与院感","抗感染","对市场","https://mp.weixin.qq.com/s?__biz=MzA5MTExNzgwMA==&mid=2651005943&idx=1&sn=209d5602e24596bc67615e415ab32a59&chksm=8aaaa3ae62feb6bc1de82b19cb2cf64122706d8ed044a4bec1de73215f7f0f06fbcb33255fdd&scene=126&sessionid=1793624721#rd","CHINET 中国细菌耐药监测网",{"_71":72,"_73":-5,"_74":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
