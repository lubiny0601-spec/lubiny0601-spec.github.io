[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205949000,"id","jmn0423gw4xfhf6vh107pw2sv","title","皮内、皮下、肌内注射感控要点：消毒范围与皮试禁用碘伏","originalTitle","皮内、皮下、肌内注射感控要点💉","summary","皮内、皮下、肌内注射消毒均需从中心点向外螺旋擦拭，范围至少5厘米。皮下和肌内注射可用碘伏消毒，拔针后轻压针眼；皮内注射（皮试）只能用75%酒精，拔针不可按压，否则影响皮试结果判断。规范操作以减少院感风险。","reason","source",{"_62":72},"links",{"_57":71},"publishedAt","2026-10-21T11:33:23.000Z","discoveredAt","2026-10-28T15:45:34.396Z","timelineAt","category","opinion","tags",[66,67,68,69,70],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","opinions","name","观点与解读","antibiotics","抗菌药物与耐药","观点/解读","耐药与院感","抗感染","循证指南","对销售","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200169&idx=1&sn=6a6846aaef0d6c54e12990d6457aaff3&chksm=820b3bad58dca95f6d1e944c60d9b758c2ddf388db73bc756f17b578b6aaea1ac5447943b9a4&scene=126&sessionid=1793202279#rd","SIFIC 感染视界",{"_74":75,"_76":-5,"_77":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
