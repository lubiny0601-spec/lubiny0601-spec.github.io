[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384588000,"id","kc1vetehbr53num0zvsxcg893","title","PETERPEN试验：哌拉西林-他唑巴坦治疗ESBL血流感染早期结局不劣于美罗培南，碳青霉烯类仍为标准治疗","originalTitle","Carbapenem-Sparing Therapy for ESBL Bacteremia: New Trials, Old Questions","summary","PETERPEN试验新数据显示，在部分ESBL血流感染患者中，哌拉西林-他唑巴坦的早期临床结局不劣于美罗培南，但在最终死亡率结果获得并充分分析前，碳青霉烯类仍是标准治疗。此前MERINO RCT（NCT02176122）显示，哌拉西林-他唑巴坦组30天全因死亡率12.3%（23/187），美罗培南组3.7%（7/191），未达到非劣效性。","reason","source",{"_61":71},"links",{"_57":70},"publishedAt","2026-09-24T16:58:09.863Z","discoveredAt","2026-10-27T15:41:44.400Z","timelineAt","category","clinical","tags",[62,65,66,67,68,69],"score",38,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","临床进展","antibiotics","抗菌药物与耐药","抗菌药物","耐药与院感","抗感染","循证指南","对品牌","https://www.contagionlive.com/view/carbapenem-sparing-therapy-for-esbl-bacteremia-new-trials-old-questions","Contagion Live·抗菌药物管理",{"_73":74,"_75":-5,"_76":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
