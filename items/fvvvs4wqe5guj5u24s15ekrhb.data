[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794384584000,"id","fvvvs4wqe5guj5u24s15ekrhb","title","民主党中期选举大胜，医院行业迎来利好","originalTitle","STAT+: Democrats’ midterm landslide spells relief for hospitals","summary","民主党赢得众议院和参议院控制权后，医院行业将免于共和党进一步削减Medicaid支付的压力。民主党计划在下一届国会开始后的前100小时内推进政策，逆转特朗普税法案中的Medicaid削减，并永久恢复今年早些时候到期的ACA计划增强补贴。民主党还计划阻止特朗普政府提出的一项医院反对的小众药品折扣模式。","reason","source",{"_63":70},"links",{"_58":69},"publishedAt","2026-11-06T17:46:16.000Z","discoveredAt","2026-11-09T06:26:05.136Z","timelineAt","category","opinion","tags",[67,68],"score",18,"selected",false,"channel","news","story","x","readingMode","full","author","Bob Herman","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","opinions","name","观点与解读","insurance","医保与集采","观点/解读","医保/集采","https://www.statnews.com/2026/11/06/why-democrats-midterm-landslide-helps-hospital-industry/?utm_campaign=rss","STAT",{"_72":73,"_74":-5,"_75":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
