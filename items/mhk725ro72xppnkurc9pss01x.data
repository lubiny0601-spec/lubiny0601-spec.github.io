[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794791090000,"id","mhk725ro72xppnkurc9pss01x","title","评论：器官捐献新规对家属不公平","originalTitle","Opinion: New organ donation rules are unfair to families","summary","美国器官获取与移植网络（OPTN）11月18日起实施新规，允许器官获取组织在患者家属决定是否撤除生命支持治疗前就接触家属讨论捐献，以增加可移植器官供给。作者作为俄勒冈健康与科学大学神经重症监护医生指出，此举模糊了救治医生与器官获取团队的界限，可能让家属对ICU救治产生不信任。","reason","source",{"_63":70},"links",{"_58":69},"publishedAt","2026-11-13T14:59:54.000Z","discoveredAt","2026-11-16T00:55:13.580Z","timelineAt","category","opinion","tags",[67,68],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","Tarvez Tucker","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","opinions","name","观点与解读","policy","政策与监管","观点/解读","政策/监管","https://www.statnews.com/2026/11/13/organ-donation-policy-life-sustaining-treatment-brain-death/?utm_campaign=rss","STAT",{"_72":73,"_74":-5,"_75":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
