[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795443790000,"id","wfe5ja720kd2b85nxxii4aeg0","title","国家医保局启动2026年第三批参照药预沟通专家论证，11月30日截止收件","originalTitle","关于组织开展2026年第三批参照药预沟通专家论证工作的通知","summary","国家医保局医药价格和招标采购指导中心组织开展2026年第三批参照药预沟通专家论证工作，符合条件的企业需按《参照药预沟通办法（试行）》以邮件形式提交申请资料。资料接收时间自即日起至2026年11月30日止，接收邮箱为ybczy@nhsa.gov.cn。","reason","国家医保局启动第三批参照药预沟通，企业可据此判断申报窗口与材料准备节奏。","source",{"_62":67},"links",{"_58":69},"publishedAt","2026-11-18T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.314Z","timelineAt","category","policy","tags",[66,67,68],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","国家医保局","医保/集采","http://www.nhsa.gov.cn/art/2026/11/18/art_109_23437.html",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
