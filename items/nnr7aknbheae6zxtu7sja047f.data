[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795410126000,"id","nnr7aknbheae6zxtu7sja047f","title","莫纳什大学小鼠免疫衰老研究揭示CD8+ T细胞功能障碍与癌症发生线索","originalTitle","Immune Aging Study in Mice Reveals Clues to T Cell Dysfunction and Cancer Development","summary","莫纳什大学团队在小鼠临床前研究中发现，衰老会通过三种不同方式扰乱调控免疫细胞功能的遗传指令，并识别出一群此前未知的衰老免疫细胞，其既丧失抗病能力又主动抑制其他免疫细胞应答。研究聚焦CD8+ T细胞，相关遗传特征发表于Science Immunology，为识别逆转免疫衰老的潜在靶点提供了蓝图。","reason","source",{"_64":73},"links",{"_58":72},"publishedAt","2026-11-20T19:04:09.000Z","discoveredAt","2026-11-23T04:24:58.866Z","timelineAt","category","research","tags",[70,69,71],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","Uduak Thomas","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","papers","name","论文研究","infectious","感染与疫苗","oncology","肿瘤","论文/研究","感染/疫苗","https://www.genengnews.com/topics/cancer/immune-aging-study-in-mice-reveals-clues-to-t-cell-dysfunction-and-cancer-development/","GEN Genetic Engineering & Biotechnology News",{"_75":76,"_77":-5,"_78":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
