[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795408369000,"id","h958g3s60uqrf2fnzu773vqdp","title","IDSA/ESCMID 2026 SAB共识第6、7条解读：无深部病灶者建议14天抗菌治疗","originalTitle","A Closer Look at IDSA/ESCMID 2026 Consensus Statements 6 and 7 on Staphylococcus aureus Bacteremia","summary","IDSA与ESCMID于9月9日发布金黄色葡萄球菌菌血症（SAB）共识声明第一部分，第6、7条建议经诊断评估后无深部或转移性感染灶的低风险与升高风险成人患者均接受14天抗菌治疗，疗程起始日以血培养转阴日为准，若病灶清除晚于转阴则以清除日起算。","reason","梳理IDSA/ESCMID共识第6、7条对低风险与升高风险SAB的14天疗程建议，并点出实施层面的障碍。","source",{"_63":74},"links",{"_58":73},"publishedAt","2026-11-08T14:49:51.619Z","discoveredAt","2026-11-16T00:55:14.288Z","timelineAt","category","research","tags",[67,68,69,70,71,72],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","论文/研究","抗菌药物","耐药与院感","抗感染","循证指南","对品牌","https://www.contagionlive.com/view/a-closer-look-at-idsa-escmid-2026-consensus-statements-6-and-7-on-staphylococcus-aureus-bacteremia","Contagion Live·抗菌药物管理",{"_76":77,"_78":-5,"_79":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
