[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793889546000,"id","zmj9yu1apgn2s0vzv0yhexfx1","title","六大上市连锁药店三季报拆解：大参林、益丰、老百姓等盈利与门店效率、会员策略对比","originalTitle","都是头部连锁，6大巨头盈利、门店效率、会员策略拆解","summary","2026年前三季度六大上市连锁药店营收分化，大参林以213.08亿元领跑，益丰182.36亿元、老百姓166.50亿元紧随；利润端普遍反转，一心堂营收微降2.33%但归母净利润大增41.86%，健之佳因约2.24亿元租赁视同销售补税及滞纳金亏损2.59亿元。门店策略转向存量提效，老百姓直营日均坪效49元/㎡、会员1.16亿，一心堂净减333家店、租赁负债降31.31%。","reason","source",{"_64":73},"links",{"_58":72},"publishedAt","2026-11-03T23:26:52.000Z","discoveredAt","2026-11-05T05:15:52.115Z","timelineAt","category","opinion","tags",[70,71,65],"score",40,"selected",false,"channel","news","story","x","readingMode","full","author","点苍鹤","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","trends","name","行业趋势","opinions","观点与解读","market","市场与销售","观点/解读","市场/销售","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699473&idx=1&sn=5f4a452e0760f136250395c782c5ab45&chksm=bce34ec31936f72351d5c460ab1ea324e34b0e45d0a08d3d3e16bd9dafec0e5bc20d99a3f683&scene=126&sessionid=1793855733#rd","医药云端工作室",{"_75":76,"_77":-5,"_78":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
