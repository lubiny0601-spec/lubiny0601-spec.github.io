[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408366000,"id","a8v6ixcrudh94bsxkgd0g94ex","title","慢阻肺病为何一查就是中重度？杨健医生解析三大“麻痹点”与GOLD 2026指南更新","originalTitle","一查就是中重度，它已悄悄偷走1亿人肺功能……慢阻肺病有哪些“麻痹点”你根本想不到？","summary","南京江宁医院杨健医生指出，我国40岁及以上人群慢阻肺病患病率约13.6%—13.7%、患者接近1亿，但知晓率仅0.9%、做过肺功能检查的仅4.5%。GOLD 2026指南更新：过去1年内发生1次中度急性加重即纳入高风险组，需重新评估并必要时升级治疗，此前标准为2次中度或1次重度。40岁及以上建议每年查一次肺功能，35岁以上吸烟或长期吸二手烟者应提上日程。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-15T03:13:12.000Z","discoveredAt","2026-11-16T01:00:47.461Z","timelineAt","category","opinion","tags",[78,73],"score",22,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fdnReXJEnHow","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","respiratory","呼吸",{"_75":76,"_13":77},"publicId","a7941cfd-5a30-4137-97cd-c9ba964a8fe3","杨健医生解析慢阻肺病晚发现与GOLD 2026更新","观点/解读","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604842&idx=2&sn=63b46543a1ba1fa32c81f240b681eb19&chksm=fc92bf74a9e8a7b543a50fdefcd44b130d09fff19467c745f80d92f881f7e389faf66caf93f4&scene=126&sessionid=1794790833#rd","呼吸界",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
