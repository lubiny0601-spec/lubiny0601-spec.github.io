[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408366000,"id","y9m0hy65p4s7lnman4pmzfhfw","title","药企现有商务体系为何不管用：权责边界、一级商业管法、集采履约与院外投入的重构路径","originalTitle","药企现有商务体系，不管用了","summary","医药企业现有商务体系多为五年前甚至十年前搭建，面对中标利润不高、未中标渠道受阻、院外价格互冲与终端碎片化已难以适用。重构需划清商务与销售的权责边界，对一级商业实行A/B/C档打分评级并一年一调，建立集采履约的量、库存、流向核实办法，院外投入先算ROI再定回本线与止损线。赛柏蓝定于11月19-20日在上海举办医药企业商务体系重构与销售增长实战班。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-15T10:27:27.000Z","discoveredAt","2026-11-16T01:03:21.554Z","timelineAt","category","opinion","tags",[78,79],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fwmMr-z1FWTs","reportCount",3,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","market","市场与销售",{"_75":76,"_13":77},"publicId","ed88d38b-ade0-436e-ba24-8b6d6fd90c98","赛柏蓝11月19-20日上海办医药商务实战班","观点/解读","市场/销售","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670716&idx=6&sn=7a15731b86fa2b17cc54ccec3650d29f&chksm=bced7c233f09c78ed2bc9213be58f22cdcf16552b95446eff94dca2d78837fcaa1bac32b101a&scene=126&sessionid=1794790858#rd","赛柏蓝",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
