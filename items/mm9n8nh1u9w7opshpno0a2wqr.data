[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":35,"_53":54,"_55":56,"_57":35,"_58":59},"expiresAt",1793889549000,"id","mm9n8nh1u9w7opshpno0a2wqr","title","大感控·大家谈 第05期丨俞云松：看清耐药菌传播轨迹，把诊断、治疗与防控连起来","originalTitle","summary","浙江大学医学院附属邵逸夫医院俞云松教授在“大感控·大家谈”第05期访谈中提出，感染诊疗与感控应作为整体推进，并以碳青霉烯耐药肺炎克雷伯菌基因组分析、家庭环境MRSA溯源等案例说明如何将传播证据转化为防控行动。他强调分子流行病学与大数据分析结合可梳理院内传播线索，感染病学科、院感科、微生物科、临床药师及临床科室需协同，同时肯定护理人员在消毒与操作规程落实中的作用。","reason","source",{"_70":84},"links",{"_59":83},"publishedAt","2026-10-27T11:54:13.000Z","discoveredAt","2026-10-27T13:41:13.869Z","timelineAt","category","opinion","tags",[78,79,80,81,82],"score",22,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","SIFIC团队","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fCTAmRN1qYlo","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","antibiotics","抗菌药物与耐药",{"_75":76,"_13":77},"publicId","a3d9a6e0-1835-43f0-a5a5-fcfecfe6a3bf","俞云松谈耐药菌溯源与诊防控联动","观点/解读","耐药与院感","抗感染","专家会议","对市场","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200246&idx=1&sn=a675d41ea40a0b82cb9820d2961507c5&chksm=8277dea3d6012d52d4b6b830f725e2d6fa5db39785245bd7faa9c412e428fe92e5359273f92f&scene=126&sessionid=1793108467#rd","SIFIC 感染视界",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
