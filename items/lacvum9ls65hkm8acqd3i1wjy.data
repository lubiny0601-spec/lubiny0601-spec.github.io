[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795410152000,"id","lacvum9ls65hkm8acqd3i1wjy","title","连云港长护险2027年起覆盖城乡居民医保参保人员","originalTitle","【江苏】长护险让失能老人有了新保障","summary","连云港市2026年8月印发长护险扩面文件，明确自2027年1月1日起城乡居民医保参保人员可按规定享受长护险待遇，制度由职工试点扩至全民覆盖。按规定参保缴费且失能6个月以上的重度失能人员均可享受待遇，服务资源优先向乡镇、村居下沉，鼓励机构、社区、居家照护一体发展。","reason","source",{"_68":75},"links",{"_59":76},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-12T14:18:53.235Z","timelineAt","category","policy","tags",[74,75],"score",18,"selected",false,"channel","news","story",{"_71":72,"_13":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fqTufym8evQA","reportCount",1,"additionalSourceCount",0,{"_67":30,"_68":69},"slug","name","政策与监管",{"_71":72,"_13":73},"publicId","5e5425f5-64a2-45ed-a5e1-7084e24e688f","连云港长护险2027年起扩至城乡居民","政策/监管","国家医保局","http://www.nhsa.gov.cn/art/2026/10/30/art_14_23258.html",{"_78":79,"_80":-5,"_81":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
