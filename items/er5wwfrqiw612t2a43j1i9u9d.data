[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384593000,"id","er5wwfrqiw612t2a43j1i9u9d","title","西雅图 Virginia Mason 医疗中心调查致命肺炎克雷伯菌暴发，已确认 33 例感染、9 例死亡","originalTitle","Seattle Medical Center Investigates Deadly Klebsiella pneumoniae Outbreak","summary","西雅图 Virginia Mason 医疗中心正在调查肺炎克雷伯菌暴发，迄今已确认 33 例感染，最新病例于 5 月 4 日确诊。9 例感染该特定菌株的患者均已死亡，但因患者均患有复杂基础疾病，尚不能确定肺炎克雷伯菌是否导致或促成了死亡。院方自 2022 年 10 月起发现市中心院区病例增多，已加强安全措施并与华盛顿州 DOH、西雅图-金县公共卫生部门及 CDC 联合调查感染来源。","reason","source",{"_62":72},"links",{"_57":71},"publishedAt","2023-06-13T15:00:11.948Z","discoveredAt","2026-10-27T15:41:45.021Z","timelineAt","category","industry","tags",[66,67,68,69,70],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","safety","name","安全与质量","antibiotics","抗菌药物与耐药","安全/质量","耐药与院感","抗感染","疫情监测","对市场","https://www.contagionlive.com/view/seattle-medical-center-investigates-deadly-klebsiella-pneumoniae-outbreak","Contagion Live·医院感染",{"_74":75,"_76":-5,"_77":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
