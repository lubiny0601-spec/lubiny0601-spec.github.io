[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408384000,"id","g21yurcoc9947rlsxp3sow2qz","title","国家药监局修订氨溴特罗口服溶液与片剂说明书","originalTitle","氨溴特罗制剂说明书修订","summary","国家药监局11月12日发布2026年第107号公告，决定对氨溴特罗口服溶液和氨溴特罗片说明书进行统一修订，要求上市许可持有人于2027年2月11日前报省级药品监督管理部门备案。修订涉及药品标签的应一并修订，备案之日起生产的药品不得继续使用原说明书，持有人须在备案后9个月内更换已出厂说明书及标签或告知患者更新信息。持有人还应针对新增不良反应发生机制开展深入研究并做好合理用药宣传培训。","reason","source",{"_70":83},"links",{"_59":82},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-12T14:18:47.950Z","timelineAt","category","policy","tags",[80,81,73],"score",42,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f31xOWgqMwww","reportCount",1,"additionalSourceCount",0,{"_69":74,"_70":75},{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","政策与监管","respiratory","呼吸","nmpa","中国 NMPA",{"_77":78,"_13":79},"publicId","ec9e1b91-d8c6-4fa5-9806-60b3a7cb7d99","国家药监局统一修订氨溴特罗制剂说明书","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-12/1110388.shtml","中国食品药品网·要闻",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
