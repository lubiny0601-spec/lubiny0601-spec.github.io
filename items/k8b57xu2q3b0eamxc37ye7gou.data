[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793888194000,"id","k8b57xu2q3b0eamxc37ye7gou","title","国家药监局局长黄果：发挥监管政策引领作用，筑牢健康中国的医药基石","originalTitle","黄果：发挥监管政策引领作用 筑牢健康中国的医药基石","summary","国家药监局局长黄果撰文提出，“十五五”时期药品监管首要任务是构建事前预防型药品安全治理模式，严把从实验室到医院的每一道防线。文章明确对重点品种实行“提前介入、一企一策、全程指导、研审联动”，集中资源支持新靶点、新机制及细胞与基因治疗等重点产品研发，并建立儿童药品、罕见病用药品市场独占期制度。同时推动全球药物在中国同步研发、同步申报、同步审评、同步上市。","reason","source",{"_63":71},"links",{"_57":70},"publishedAt","2026-10-21T00:00:00.000Z","discoveredAt","2026-10-27T13:29:45.495Z","timelineAt","category","policy","tags",[68,69,64],"score",40,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":66,"_63":67},{"_61":30,"_63":65},{"_61":62,"_63":64},"slug","trends","name","行业趋势","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-21/1109215.shtml","中国食品药品网·要闻",{"_73":74,"_75":-5,"_76":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
