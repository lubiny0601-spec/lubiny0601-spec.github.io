[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888185000,"id","m3t76o88h74cxkb9qv50iw11l","title","美敦力一次性使用磁定位标测双能量消融导管等4个创新产品获NMPA批准上市","originalTitle","一次性使用磁定位标测双能量消融导管等4个产品获批上市","summary","国家药监局批准美敦力公司“一次性使用磁定位标测双能量消融导管”“心脏双能量消融系统”“三维心脏电生理标测系统”“一次性使用体表参考电极”4个创新产品注册申请。该导管与消融系统配合可在一次手术中对心脏不同部位分别输出射频或脉冲电场能量，用于治疗药物难治性、复发性、症状性持续性房颤（发作持续时间少于1年）。上述产品组合在提高消融效率、减少心房食管瘘等严重并发症方面具有临床应用价值。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-10-30T00:00:00.000Z","discoveredAt","2026-10-30T11:06:55.969Z","timelineAt","category","approval","tags",[72,81,82],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fwI42S8s3dkw","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","approvals","name","获批上市","device-ivd","医疗器械与 IVD","nmpa","中国 NMPA",{"_78":79,"_13":80},"publicId","1093eb1f-be55-4467-b645-144cefc07ca9","NMPA批准美敦力4个心脏消融创新产品上市","医疗器械/IVD","NMPA","https://www.cnpharm.com/c/2026-10-30/1109709.shtml","中国食品药品网·要闻",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
