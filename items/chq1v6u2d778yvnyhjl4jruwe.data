[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795410130000,"id","chq1v6u2d778yvnyhjl4jruwe","title","桐乡市妇幼保健院基于SPO模型构建围术期感控体系，3373例手术患者感染率下降","originalTitle","妇幼专科医院围术期感控体系怎么建？丨SIFIC2026·壁报交流","summary","桐乡市妇幼保健院金新丽基于SPO模型构建妇幼专科医院围术期感染防控体系，前瞻性前后对照纳入3373例手术患者，干预后手术部位感染率从0.94%降至0.32%，术后肺炎发生率亦明显下降。妇科肿瘤手术感染数值下降但部分分组未达统计学差异，研究者归因于样本量较小及患者基础状况较差。专家建议采用间断时间序列分析增强因果论证，并补充卫生经济学评价。","reason","source",{"_71":85},"links",{"_60":84},"publishedAt","2026-11-10T11:00:00.000Z","discoveredAt","2026-11-11T08:15:50.236Z","timelineAt","category","research","tags",[79,80,81,82,83],"score",20,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","SIFIC团队","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fWJHpRojEiwA","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药",{"_76":77,"_13":78},"publicId","868c8f82-e37a-4c9a-9876-e7c38a0bd9d6","桐乡妇保院SPO模型围术期感控研究发布","论文/研究","耐药与院感","抗感染","循证指南","对市场","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200552&idx=1&sn=7d3fd17e44699364adeb31a6daa68ad5&chksm=82db0c9d976305ca124a1278f2e6910157bc32521ae6dfa1f304bd1f8bf528e1dbcdac2bca20&scene=126&sessionid=1794384944#rd","SIFIC 感染视界",{"_87":88,"_89":-5,"_90":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
