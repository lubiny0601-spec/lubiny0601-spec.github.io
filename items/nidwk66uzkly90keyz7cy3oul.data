[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1795410124000,"id","nidwk66uzkly90keyz7cy3oul","title","新疆医保局启动2027年双通道药品动态调整申报，新增与调出可同时申请","originalTitle","双通道，你想进入还是调出？新疆开始申报！（附投票，看看大家的选择是？）","summary","新疆医保局11月17日发布通知，启动2027年双通道管理药品动态调整申报，申报时段为11月17日至11月25日，2027年1月1日起新版名单生效。申报范围重点覆盖2026年国谈、竞价新增进医保但尚未纳入新疆双通道的品种，同时接受原双通道药品调出申请，原研药、仿制药均可提交退出申请。","reason","新疆双通道双向申报窗口把进与退的取舍摆到台面上，读者可对照剂型与供应能力判断自家品种的申报策略。","source",{"_63":73},"links",{"_59":72},"publishedAt","2026-11-19T08:52:06.000Z","discoveredAt","2026-11-23T04:30:49.201Z","timelineAt","category","policy","tags",[67,68,69,70,71],"score",55,"selected",true,"channel","news","story","x","readingMode","full","author","子非鱼","body","outline",[],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":65,"_63":66},{"_62":31,"_63":64},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699737&idx=1&sn=889c4a2546bf77bb29a42ba332e35a9f&chksm=bc68cc440e81fa77f68ae9241d918e1c02ea9df64eaeea250495f92c53aa5918b7bba6ca82de&scene=126&sessionid=1795408227#rd","医药云端工作室",{"_75":76,"_77":-5,"_78":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
