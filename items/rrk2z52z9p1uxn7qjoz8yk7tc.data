[{"_1":2,"_3":4},"root",{"_5":67},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795443790000,"id","rrk2z52z9p1uxn7qjoz8yk7tc","title","ADA 内乱持续，对糖尿病患者意味着什么？","originalTitle","As diabetes association’s turmoil continues, what does it mean for patients?","summary","美国糖尿病协会（ADA）因政治抗议风波分裂五个月后，专家担忧这场僵局可能阻碍糖尿病诊疗进展。纷争源于五名成员在 2026 年新奥尔良科学会议上被驱逐，随后引发高层辞职、1,221 名成员抵制，以及未公开姓名的临时编辑委员会接管《Diabetes Care》期刊。ADA 表示 2027 版指南将于 12 月按期发布，但下届科学会议议程尚未确定。","reason","source",{"_62":66},"links",{"_58":65},"publishedAt","2026-11-23T09:30:00.000Z","discoveredAt","2026-11-23T11:48:44.215Z","timelineAt","category","industry","tags",[63,64],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","Elizabeth Cooney","body","outline",[],"relatedStories",[],"topics",[59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":61,"_62":63},"slug","trends","name","行业趋势","其他","https://www.statnews.com/2026/11/23/ada-convention-fallout-will-turmoil-impact-patients-research/?utm_campaign=rss","STAT",{"_68":69,"_70":-5,"_71":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
