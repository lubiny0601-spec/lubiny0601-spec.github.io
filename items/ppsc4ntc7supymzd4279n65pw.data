[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443807000,"id","ppsc4ntc7supymzd4279n65pw","title","国家疾控局等三部门解读《关于全面推行疫苗处方工作的指导意见》","originalTitle","《关于全面推行疫苗处方工作的指导意见》政策解读","summary","国家疾控局会同国家卫生健康委、国家中医药局联合印发《关于全面推行疫苗处方工作的指导意见》，明确\"十五五\"期间逐步实现疫苗处方在二级及以上医疗机构和基层医疗卫生机构全覆盖。文件规定由全科医疗科、预防保健科等科室具有资质的临床、公共卫生、中医类别医师开具处方，并规范识别对象、开具处方、接种服务、信息化管理等流程。","reason","source",{"_61":68},"links",{"_57":67},"publishedAt","2026-11-17T00:00:00.000Z","discoveredAt","2026-11-23T04:24:52.609Z","timelineAt","category","policy","tags",[65,66],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","infectious","感染与疫苗","政策/监管","感染/疫苗","https://www.cnpharm.com/c/2026-11-17/1110731.shtml","中国食品药品网·要闻",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
