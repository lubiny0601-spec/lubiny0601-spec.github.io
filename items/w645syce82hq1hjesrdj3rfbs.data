[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793888182000,"id","w645syce82hq1hjesrdj3rfbs","title","FDA 对 Venatorx 的 cefepime-taniborbactam 治疗复杂性尿路感染发出 CRL","originalTitle","FDA Issues a CRL for Venatorx Pharmaceuticals’ Antibiotic for Treatment of Complicated UTI","summary","FDA 就 Venatorx Pharmaceuticals 与 Melinta Therapeutics 的 cefepime-taniborbactam NDA 发出完整回复函（CRL），该 β-内酰胺/β-内酰胺酶抑制剂复方拟用于成人复杂性尿路感染（cUTI），含敏感革兰阴性菌所致急性肾盂肾炎。","reason","CRL 未要求补做临床试验，只卡在 CMC 环节，读者可据此判断这款含酶抑制剂复方抗生素的上市节奏。","source",{"_64":78},"links",{"_58":77},"publishedAt","2024-02-23T14:28:20.774Z","discoveredAt","2026-10-27T15:41:44.977Z","timelineAt","category","approval","tags",[65,70,71,72,73,74,75,76],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","approvals","name","获批上市","antibiotics","抗菌药物与耐药","fda","美国 FDA","抗菌药物","FDA","耐药与院感","抗感染","管线上新","对市场","对准入","https://www.contagionlive.com/view/fda-issues-a-crl-for-venatorx-pharmaceuticals-antibiotic-for-treatment-of-complicated-uti","Contagion Live·医院感染",{"_80":81,"_82":-5,"_83":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
