[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384596000,"id","ltograrjcp1npcemuhxbkrgxv","title","浙江杭州实施医保定点医药机构资源配置规划（2025—2027年），定点管理提质赋能","originalTitle","浙江杭州坚持规划引领 实现医保定点管理提质赋能","summary","浙江省杭州市医保部门编制实施《杭州市医疗保障定点医药机构资源配置规划（2025—2027年）》，遏制机构无序扩张。2026年上半年全市272家医药机构申请医保定点，同比下降55.70%，185家通过定点准入评估，同比下降24.49%；截至2026年8月底，定点医药机构总数为9129家，较2024年底仅增长0.30%。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-09T06:26:15.513Z","timelineAt","category","policy","tags",[65,66,67],"score",38,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/3/art_287_23312.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
