[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384589000,"id","c7na0nah32sh8z4sq2zyszgwn","title","阿奇霉素未减少学龄前儿童急诊喘息：PECARN AZ-SWED 试验结果","originalTitle","Azithromycin in ER Did Not Reduce Wheezing in Preschoolers","summary","在美国8家儿科急诊开展的多中心随机试验中，阿奇霉素较安慰剂未改善18-59月龄学龄前儿童的喘息症状严重程度、急诊或住院时长及72小时内回访，无论上呼吸道是否检出致病菌。该试验在计划中期分析时因无效提前终止，共随机840例PRAM评分≥4的患儿。尽管阿奇霉素清除细菌的效果远优于安慰剂（58.7% vs 11.4%），研究者仍建议不将其用于急诊已出现呼吸窘迫的儿童。","reason","source",{"_64":77},"links",{"_57":76},"publishedAt","2026-08-30T08:46:20.686Z","discoveredAt","2026-10-27T15:41:44.480Z","timelineAt","category","clinical","tags",[66,71,68,72,73,74,75],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":69,"_64":70},{"_62":67,"_64":68},{"_62":30,"_64":66},{"_62":63,"_64":65},"slug","papers","name","论文研究","临床进展","respiratory","呼吸","antibiotics","抗菌药物与耐药","抗菌药物","论文/研究","抗感染","循证指南","对市场","https://www.contagionlive.com/view/azithromycin-in-er-did-not-reduce-wheezing-in-preschoolers","Contagion Live·抗菌药物管理",{"_79":80,"_81":-5,"_82":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
