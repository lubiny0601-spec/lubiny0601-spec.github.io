[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794384581000,"id","vnjgfwqbjnwfuukbwk0o7epfv","title","宁夏全区推开药耗货款医保直接结算，2026年底前覆盖集采药品和部分耗材","originalTitle","医保直接结算，加速扩围！","summary","宁夏医保局11月5日发布通知，在吴忠市试点基础上于全区全面推进药耗货款医保基金与医药企业直接结算，要求2026年10月1日起完成入库且未线下结算的集采药品及相关耗材纳入线上直接结算，2026年底前各市县实现集采药品和部分医用耗材直接结算。","reason","宁夏在吴忠试点基础上全区推开药耗直接结算，试点回款周期压缩至20个工作日，可对照各地扩围节奏。","source",{"_62":70},"links",{"_58":69},"publishedAt","2026-11-06T11:47:51.000Z","discoveredAt","2026-11-09T06:32:55.795Z","timelineAt","category","policy","tags",[66,67,68],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669729&idx=1&sn=9d125f4816a5d793540c063d665dd33f&chksm=bcab5b4371c228e7253479daf84fcd88d848df687972df459625f5f6fb9a635088f9dd5ab4c2&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_72":73,"_74":-5,"_75":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
