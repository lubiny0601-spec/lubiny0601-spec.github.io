[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795410145000,"id","zk78bth1hygdmgtuka9hg72ai","title","上海执行国家组织冠脉支架集采第二轮接续中选结果，11月20日生效","originalTitle","关于本市执行国家组织冠脉支架集中带量采购第二轮接续中选结果相关工作的通知","summary","上海市医药集中招标采购事务管理所通知，国家组织冠脉支架集中带量采购第二轮接续中选结果自2026年11月20日起执行，采购周期至2029年6月30日。医疗机构须按中选价采购、不得二次议价，每年度总协议采购量不低于前一年实际使用量的90%。非中选冠状动脉药物洗脱合金支架挂网价≥1708元/个纳入黄标、≥2372元/个纳入红标管理。","reason","source",{"_62":72},"links",{"_57":71},"publishedAt","2026-11-17T00:00:00.000Z","discoveredAt","2026-11-23T04:24:56.917Z","timelineAt","category","policy","tags",[68,69,70],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":66,"_62":67},{"_61":64,"_62":65},{"_61":30,"_62":63},"slug","name","政策与监管","insurance","医保与集采","device-ivd","医疗器械与 IVD","政策/监管","医保/集采","医疗器械/IVD","https://www.smpaa.cn/xxgk/gggs/2026/11/17/26206.shtml","上海阳光医药采购网",{"_74":75,"_76":-5,"_77":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
