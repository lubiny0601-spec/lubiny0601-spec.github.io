[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443813000,"id","cl44a4en6mblo0fvibe6d8wkt","title","杨胜率团赴韩国出席ICMRA峰会和全体会议","originalTitle","杨胜率团赴韩国出席国际药品监管机构联盟峰会和全体会议","summary","2026年11月2日至5日，国家药监局副局长杨胜率团赴韩国首尔出席国际药品监管机构联盟（ICMRA）峰会和全体会议，围绕人工智能在药品监管中的应用、新方法学与下一代监管框架、以患者为中心的药物研发与监管等议题作大会报告和讨论发言。与会期间，代表团与欧盟、新加坡、波兰、韩国等药监机构及世卫组织代表举行工作会谈，并同英国、加拿大、丹麦、葡萄牙、巴西、埃及、南非等药监机构主要负责人交流，深化双边合作。","reason","source",{"_69":80},"links",{"_59":79},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-12T14:18:47.912Z","timelineAt","category","policy","tags",[77,78],"score",12,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fARg-EYuqIKg","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","nmpa","中国 NMPA",{"_74":75,"_13":76},"publicId","0c3995c2-3d01-4b91-99ff-aaf6d1294f6a","杨胜率团赴韩出席ICMRA峰会与全体会议","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-12/1110396.shtml","中国食品药品网·要闻",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
