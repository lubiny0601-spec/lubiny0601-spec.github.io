[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795410129000,"id","xoyrc6solxje32yui6z9rdukx","title","第十二批国采落地：内蒙古等11省份明确执行时间节点","originalTitle","第12批国采：内蒙古等11省份明确落地时间","summary","截至11月12日，内蒙古、甘肃、山西、辽宁、山东、上海、宁夏、江西、江苏、北京、黑龙江、海南、河南等省份相继发布第十二批国家集采落地通知。江西11月16日零时起更新734个品规医保支付标准并执行，山东、山西、内蒙古、河南、海南、黑龙江统一锁定11月30日执行，北京为11月28日0时。","reason","梳理11省份第十二批国采落地节点与红黄标、医保支付标准差异，便于分省对照准备。","source",{"_62":72},"links",{"_58":71},"publishedAt","2026-11-12T05:12:54.000Z","discoveredAt","2026-11-12T14:31:00.033Z","timelineAt","category","policy","tags",[66,67,68,69,70],"score",75,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699587&idx=1&sn=725f033bf10796404d56dfedf0e9b281&chksm=bcdeede9d40f585769662daeffd9e5aa5bed90bf1dfccc5b1e4d1831058948950d162931bd4c&scene=126&sessionid=1794493842#rd","医药云端工作室",{"_74":75,"_76":-5,"_77":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
