[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795410156000,"id","f29t1w2b5a2oamwa8vgrjmj22","title","恒瑞医药SHR-1139注射液获NMPA临床试验批准，拟开展掌跖脓疱病临床试验","originalTitle","恒瑞医药｜恒瑞医药关于获得药物临床试验批准通知书的公告","summary","恒瑞医药子公司广东恒瑞医药的SHR-1139注射液获国家药监局药物临床试验批准通知书，同意开展掌跖脓疱病临床试验。SHR-1139为同时靶向IL-23p19和IL-36R的双特异性抗体，目前国内外尚无同类药物获批上市。该项目累计研发投入约16,270万元。","reason","source",{"_73":92},"links",{"_59":91},"publishedAt","2026-11-09T16:00:00.000Z","discoveredAt","2026-11-11T08:03:36.777Z","timelineAt","category","clinical","tags",[87,88,89,80,90],"score",20,"selected",false,"channel","news","story",{"_84":85,"_13":86},"x","readingMode","full","author","body","outline",[],"relatedStories",[83],"topics",[66,67,68,69,70],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fkPN_BcdIYd0","reportCount",1,"additionalSourceCount",0,{"_71":81,"_73":82},{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","pipeline","name","研发管��","antibody","抗体与双抗","immunology","自免与炎症","hengrui","恒瑞医药","nmpa","中国 NMPA",{"_84":85,"_13":86},"publicId","e3e5350d-be3e-42e6-8f17-88e191d5532f","恒瑞SHR-1139获批开展掌跖脓疱病临床试验","研发管线","自免","抗体/双抗","NMPA","https://static.cninfo.com.cn/finalpage/2026-11-10/1225663322.PDF","恒瑞医药·公司公告",{"_94":95,"_96":-5,"_97":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
