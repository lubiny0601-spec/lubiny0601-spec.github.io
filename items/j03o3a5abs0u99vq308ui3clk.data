[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":52,"_53":-5,"_54":35,"_55":56},"expiresAt",1793889559000,"id","j03o3a5abs0u99vq308ui3clk","title","国家药监局传达学习贯彻党的二十届五中全会精神","originalTitle","summary","10月30日，国家药监局党组书记、局长黄果主持召开党组扩大会议，专题传达学习党的二十届五中全会精神并研究部署贯彻落实措施。会议强调把持之以恒推进全面从严治党要求落实到药品监管全过程各方面，扎实做好中央巡视整改，坚决守住药品安全底线。会议要求开展多形式、多层次的宣讲培训，推动全会精神落地落实。","reason","source",{"_60":67},"links",{"_56":66},"publishedAt","2026-10-31T00:00:00.000Z","discoveredAt","2026-11-02T09:52:08.213Z","timelineAt","category","policy","tags",[64,65],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_59":62,"_60":63},{"_59":29,"_60":61},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-31/1109757.shtml","中国食品药品网·要闻",{"_69":70,"_71":-5,"_72":52},"changelogVersion","2026-10-08T08:00","release","staticSite"]
