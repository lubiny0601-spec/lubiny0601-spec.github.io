[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793888180000,"id","aiv4cxt9cgr1zdley1tegdl9l","title","第12批国家集采公示企业关联关系，明确六类认定情形","originalTitle","国家组织药品联合采购办公室关于第12批国家组织药品集中带量采购企业关联关系的公示","summary","国家组织药品联合采购办公室对已通过第12批国家集采信息审核的企业关联关系进行公示，公示期为2026年7月20日至7月22日，申诉受理截止7月22日16:00。申报同品种的不同企业存在法定代表人同一人、直接或间接控股超50%、2021年及以后该品种有效注册批件转让、境外药品上市许可持有人境内责任人关系、委托生产关联或委托同一家企业生产等六类情形之一的，认定为存在关联关系。","reason","第12批国家集采公示企业关联关系认定口径，涉及控股、批件转让与委托生产等六类情形。","source",{"_62":71},"links",{"_58":70},"publishedAt","2026-07-20T00:00:00.000Z","discoveredAt","2026-10-27T16:04:45.511Z","timelineAt","category","policy","tags",[66,67,68,69],"score",60,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","抗感染","市场准入","http://ybj.jiangsu.gov.cn/art/2026/7/20/art_85505_11806476.html","江苏医保局·阳光采购服务网",{"_73":74,"_75":-5,"_76":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
