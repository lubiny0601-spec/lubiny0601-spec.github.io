[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384585000,"id","yu6ujfo1kdygjzw0blf59563s","title","进博倒计时｜阿斯利康“肿瘤健康日”聚焦“筛诊治管”全链路","originalTitle","进博倒计时｜阿斯利康“肿瘤健康日”，要讲透“筛诊治管”","summary","阿斯利康将于11月7日在第九届进博会设立“肿瘤健康日”，主题为“共筑筛诊治管全链路，同创癌症防治新篇章”，聚焦肿瘤筛查、诊断、治疗到长期管理的全病程。活动将围绕前列腺癌PSA早筛与穿刺培训模拟方案、肿瘤联合治疗（Combo）及乳腺癌、血液肿瘤院外全程管理展开，并计划与两家中国本土创新企业签署肺癌联合疗法合作备忘录。","reason","source",{"_63":70},"links",{"_57":69},"publishedAt","2026-11-06T11:47:51.000Z","discoveredAt","2026-11-09T06:32:57.555Z","timelineAt","category","industry","tags",[64,66,68],"score",18,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","company-news","name","公司动态","oncology","肿瘤","astrazeneca","阿斯利康","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669729&idx=2&sn=f37367fdabb4182a2da184381dcbd1fc&chksm=bc02035a353fdd0b7615ae685b27530d5d20827e2dd93a6d2595e049e89ff2c72b0193edc5ef&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_72":73,"_74":-5,"_75":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
