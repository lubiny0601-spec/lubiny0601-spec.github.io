[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795410144000,"id","flzos05d2xh0gy1d8ika9q2a0","title","华东医药HDM4002注射液获NMPA临床试验批准，拟用于IgA肾病","originalTitle","华东医药｜HDM4002临床试验获批","summary","华东医药全资子公司中美华东的HDM4002注射液获NMPA药物临床试验批准通知书，拟开展随机、双盲、安慰剂对照的I期临床研究，适应症为具有疾病进展风险的原发性IgA肾病成人患者。HDM4002是一款同时靶向补体因子B（CFB）与MASP-2的双特异性抗体，可双重阻断补体旁路途径和凝集素途径。该药为中美华东研发并拥有全球知识产权的1类生物新药。","reason","source",{"_64":75},"links",{"_57":74},"publishedAt","2026-11-18T16:00:00.000Z","discoveredAt","2026-11-23T04:24:55.062Z","timelineAt","category","clinical","tags",[66,71,72,73,70],"score",23,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":69,"_64":70},{"_62":67,"_64":68},{"_62":30,"_64":66},{"_62":63,"_64":65},"slug","pipeline","name","研发管��","临床进展","antibody","抗体与双抗","huadong","华东医药","研发管线","肾病","抗体/双抗","https://static.cninfo.com.cn/finalpage/2026-11-19/1225677291.PDF","华东医药·公司公告",{"_77":78,"_79":-5,"_80":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
