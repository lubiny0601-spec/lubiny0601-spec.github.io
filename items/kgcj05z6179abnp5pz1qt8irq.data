[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443805000,"id","kgcj05z6179abnp5pz1qt8irq","title","宁夏以“四项改革”促进“三医”协同：集采药品耗材954种、43类，累计减负超20亿元","originalTitle","宁夏以“四项改革”为牵引 有效促进“三医”协同","summary","宁夏医保部门以医疗服务价格与集采、医保目录管理、基金清算结算等改革促进“三医”协同。“十四五”以来累计执行集采药品、医用耗材中选产品954种、43类，减轻群众负担超20亿元；全区定点医疗机构实行“年预付、日结算”的“T+1”拨付，基金结算周期从20多个工作日缩短至1个工作日。2025年全区跨省异地就医直接结算率达95.8%，惠及322万人次。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-11-20T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.090Z","timelineAt","category","policy","tags",[65,66,67],"score",30,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/20/art_287_23479.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
