[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":55,"_56":35,"_57":58},"expiresAt",1794205958000,"id","f7kytu1qb94yiriu3ljf73o8h","title","国家药监局公开征求《国家药品安全事件应急预案（征求意见稿）》意见","originalTitle","summary","国家药监局组织起草《国家药品安全事件应急预案（征求意见稿）》，于11月2日起向社会公开征求意见，反馈截止2026年11月9日。该预案依据《药品管理法》及《国家突发事件总体应急预案》制定，旨在健全药品安全应急管理体系、提升药品安全事件应急处置能力，意见反馈表需发送至指定邮箱。","reason","source",{"_68":79},"links",{"_58":78},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T09:52:08.174Z","timelineAt","category","policy","tags",[76,77],"score",42,"selected",false,"channel","news","story",{"_73":74,"_13":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fAJ7cO5j-u2c","reportCount",1,"additionalSourceCount",0,{"_67":70,"_68":71},{"_67":29,"_68":69},"slug","name","政策与监管","nmpa","中国 NMPA",{"_73":74,"_13":75},"publicId","687545d1-4433-4964-963b-66ae21f469f1","国家药监局就药品安全事件应急预案征求意见","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-02/1109824.shtml","中国食品药品网·要闻",{"_81":82,"_83":-5,"_84":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
