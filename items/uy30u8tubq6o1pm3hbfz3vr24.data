[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795443793000,"id","uy30u8tubq6o1pm3hbfz3vr24","title","观点：脑震荡后应更多由医生开具运动处方","originalTitle","Opinion: More doctors should prescribe exercise after a concussion","summary","一项2019年由John Leddy领导的随机试验显示，103名运动相关脑震荡青少年中，接受有氧运动处方者中位13天恢复，仅做拉伸的对照组为17天。2024年一项小型试验中，中度至重度脑损伤超过6个月者经高强度训练后步行距离和速度优于常规康复。作者呼吁医生为脑震荡患者制定个体化运动处方，并建议保险覆盖临床适宜的运动康复项目。","reason","source",{"_63":70},"links",{"_58":69},"publishedAt","2026-11-20T09:30:00.000Z","discoveredAt","2026-11-23T04:24:56.359Z","timelineAt","category","opinion","tags",[67,68],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","Scott W. Hamilton","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","opinions","name","观点与解读","neuroscience","神经与精神","观点/解读","神经/精神","https://www.statnews.com/2026/11/20/concussion-exercise-dark-room-leddy-robert-perske-cardiology/?utm_campaign=rss","STAT",{"_72":73,"_74":-5,"_75":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
