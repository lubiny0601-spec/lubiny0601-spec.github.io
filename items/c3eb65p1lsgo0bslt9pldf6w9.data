[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":-5,"_55":35,"_56":57},"expiresAt",1794384585000,"id","c3eb65p1lsgo0bslt9pldf6w9","title","2026流感宣传月｜林炳亮教授：南方流感常年不断档，成人防控重在早识别与防重症","originalTitle","summary","中山大学附属第三医院林炳亮教授指出，南方流感呈冬春季与夏季双峰流行甚至全年散发，临床需打破\"夏季无流感\"观念，对发热伴呼吸道症状患者保持流感鉴别意识，门急诊常态化配备快速检测及抗病毒药物。","reason","source",{"_62":69},"links",{"_57":68},"publishedAt","2026-11-06T12:00:09.000Z","discoveredAt","2026-11-09T06:31:15.238Z","timelineAt","category","opinion","tags",[66,67],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","感染在线","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","opinions","name","观点与解读","infectious","感染与疫苗","观点/解读","感染/疫苗","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200453&idx=1&sn=302efebdc03a808f24d0c186b88d6f85&chksm=82c467957ba48d97d6a17b1f4d376779938bf46342c433ab56bc94fdc0135ee2a78c1c7c64c1&scene=126&sessionid=1794205857#rd","SIFIC 感染视界",{"_71":72,"_73":-5,"_74":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
