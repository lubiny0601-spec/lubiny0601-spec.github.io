[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794384587000,"id","x87l12siqx040up4ntowsvdqe","title","牛津大学团队用XFEL拍下青霉素合成\"分子电影\"，揭示IPNS催化β-内酰胺环形成新中间体","originalTitle","‘Molecular Movie’ of Penicillin Synthesis Could Inform Future Antibiotic Development","summary","牛津大学联合Diamond Light Source等机构，用X射线自由电子激光（XFEL）实时观测异青霉素N合成酶（IPNS）催化线性肽底物生成β-内酰胺环的过程，捕捉到β-内酰胺环形成前的硫醛中间体和首个单环β-内酰胺中间体。研究发表于Nature Catalysis，揭示活性位点水分子在反应中的关键作用，为应对耐药菌上升、优化现有抗生素和设计新抗生素结构提供依据。","reason","source",{"_63":74},"links",{"_58":73},"publishedAt","2026-10-09T16:36:22.000Z","discoveredAt","2026-10-11T18:36:08.224Z","timelineAt","category","research","tags",[67,68,69,70,71,72],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","Sophia Ktori","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","论文/研究","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://www.genengnews.com/topics/bioprocessing/molecular-movie-of-penicillin-synthesis-could-inform-future-antibiotic-development/","GEN Genetic Engineering & Biotechnology News",{"_76":77,"_78":-5,"_79":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
