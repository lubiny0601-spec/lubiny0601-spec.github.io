[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795410148000,"id","o1ml4zb2ra35oa0acmbh65iza","title","国家医保局指导各地持续调整优化医疗服务价格：技术劳务类上调、检查检验类下调","originalTitle","各地医保持续调整优化医疗服务价格","summary","国家医保局指导各地常态化运行医疗服务价格动态调整机制，2018—2025年医疗服务价格总水平累计上涨26.0%，年均涨幅约3.4%。技术劳务类项目价格合理上调，如普通门诊诊查费平均上涨约20.3%、运动功能训练平均上涨约82.9%；检查检验类价格下调，PET/CT局部显像价格下降约47.0%，男性五项肿瘤标志物检测从500元下调至220元。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-11-16T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.122Z","timelineAt","category","policy","tags",[65,66,67],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/16/art_287_23409.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
