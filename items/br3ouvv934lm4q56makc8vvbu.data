[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":52,"_53":-5,"_54":35,"_55":56},"expiresAt",1793889568000,"id","br3ouvv934lm4q56makc8vvbu","title","国家药监局党组理论学习中心组开展2026年第五次集体（扩大）学习","originalTitle","summary","10月20日，国家药监局党组书记、局长黄果主持召开局党组理论学习中心组2026年第五次集体（扩大）学习会议，集体学习习近平经济思想、习近平总书记关于中国式现代化和总体国家安全观的重要论述。会议要求牢牢守住药品安全底线，全力支持医药产业高质量发展，扎实推进药品监管能力建设。","reason","source",{"_60":67},"links",{"_56":66},"publishedAt","2026-10-21T00:00:00.000Z","discoveredAt","2026-10-27T13:29:45.515Z","timelineAt","category","policy","tags",[64,65],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_59":62,"_60":63},{"_59":29,"_60":61},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-21/1109157.shtml","中国食品药品网·要闻",{"_69":70,"_71":-5,"_72":52},"changelogVersion","2026-10-08T08:00","release","staticSite"]
