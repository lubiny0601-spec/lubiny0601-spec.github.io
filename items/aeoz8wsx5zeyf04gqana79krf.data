[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888186000,"id","aeoz8wsx5zeyf04gqana79krf","title","烟台市医保局用激光雷达与北斗+GPS电子工牌赋能长护险监管","originalTitle","【山东】数智创新赋能长护险 科技护航基金安全","summary","烟台市医保局将激光雷达、北斗+GPS双模电子工牌等技术融入长护险失能等级评估与护理服务经办全流程，以严控基金运行风险。全市定点长护服务机构169家，已累计为1.98万名参保失能人员提供专业化护理保障；激光雷达对存疑评估对象实施3至7天无接触式三维数据采集，电子工牌定位精度≤10米，参保人双重人脸识别核验成功率稳定在84%以上。","reason","source",{"_69":79},"links",{"_59":80},"publishedAt","2026-10-28T00:00:00.000Z","discoveredAt","2026-10-28T15:38:58.474Z","timelineAt","category","policy","tags",[77,78,79],"score",10,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fMFycSvbj34U","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","insurance","医保与集采",{"_74":75,"_13":76},"publicId","c48deaf7-30e3-4344-9f14-eabe2334219c","烟台医保局以激光雷达和电子工牌监管长护险","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/9/25/art_14_22357.html",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
