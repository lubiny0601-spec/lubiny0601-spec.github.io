[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795443790000,"id","p428j27hrac2cvf9arikiix4c","title","Caronilex 开发下一代多发性骨髓瘤 CAR-T 疗法 TriPRIL，早期试验 15 例中 12 例缓解","originalTitle","STAT+: New biotech aims to develop next generation CAR-T for multiple myeloma","summary","新生物技术公司 Caronilex 正在开发下一代 CAR-T 疗法 TriPRIL，用于多发性骨髓瘤。上周发表于 The Lancet 的小型早期试验显示，TriPRIL 使 15 例复发或难治性多发性骨髓瘤患者中的 12 例肿瘤体征减少或消除，其中多数患者此前接受过 CAR-T 治疗。该疗法安全性数据积极，可能成为自身免疫疾病的候选疗法。","reason","source",{"_72":85},"links",{"_60":84},"publishedAt","2026-11-23T09:30:00.000Z","discoveredAt","2026-11-23T11:48:44.182Z","timelineAt","category","clinical","tags",[73,79,75,77],"score",22,"selected",false,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","Angus Chen","body","outline",[],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","f2uKWiFDvzns","reportCount",1,"additionalSourceCount",0,{"_71":78,"_72":79},{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","临床进展","cell-gene","细胞与基因治疗","hematology","血液","oncology","肿瘤",{"_81":82,"_13":83},"publicId","dc5ebf6d-740a-413e-b852-693ae7ef49b9","Caronilex公布TriPRIL早期试验结果","https://www.statnews.com/2026/11/23/caronilex-dual-targeting-car-t-overcomes-myeloma-resistance/?utm_campaign=rss","STAT",{"_87":88,"_89":-5,"_90":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
