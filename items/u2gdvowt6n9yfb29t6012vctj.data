[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795443789000,"id","u2gdvowt6n9yfb29t6012vctj","title","上海暂停桂林南药盐酸莫西沙星片采购资格","originalTitle","关于暂停桂林南药股份有限公司盐酸莫西沙星片采购资格的通知","summary","上海市医药集中招标采购事务管理所通知，桂林南药股份有限公司持有并生产的盐酸莫西沙星片为1-8批国家集采协议期满接续采购中选药品，因经辽宁省药品检验检测院检验溶出度不符合规定，自2026年11月24日0时起暂停该药品在上海市招采子系统的采购资格。此次暂停依据国家药监局2026年11月12日发布的《关于27批次不符合规定药品的通告》（2026年第39号），涉及0.4g规格3片/盒与6片/盒两种包装。","reason","国家集采中选药品因溶出度不合格被暂停采购资格，读者可据此了解中选药品质量问题的处理路径。","source",{"_72":89},"links",{"_60":88},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T12:26:30.217Z","timelineAt","category","policy","tags",[81,82,83,84,85,86,87],"score",72,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fVru6wFB4aOw","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","safety","name","安全与质量","政策与监管","antibiotics","抗菌药物与耐药",{"_78":79,"_13":80},"publicId","85e16f7d-c252-48cb-8a0e-3f1fdec90c58","国家药监局通告27批次药品不合格，上海暂停桂林南药相关药品采购","政策/监管","抗菌药物","安全/质量","抗感染","市场准入","对销售","对准入","https://www.smpaa.cn/xxgk/gggs/2026/11/23/26313.shtml","上海阳光医药采购网",{"_91":92,"_93":-5,"_94":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
