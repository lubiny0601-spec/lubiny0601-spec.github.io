[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795443789000,"id","bzhi9kelnsv7ok2dt0txwmfuu","title","第12批国采24省明确执行时间，未中选品种保留红黄标预警","originalTitle","第12批国采：24省明确执行时间，未中选品种红黄标","summary","截至11月19日，新疆、湖南、云南、安徽、广东、福建等24省已发布第12批国家集采配套落地通知，执行节点从江西11月16日到多数省份11月30日分批推进。未中选产品统一按医保价采函〔2026〕2号落实红黄标价格风险预警，中选产品以中选价作为医保支付标准，中选企业清单外规格可按差比价视同中选、不调整则撤网。","reason","梳理24省第12批国采落地节点与红黄标、差比价规则差异，可对照本省执行节奏与价格管控口径。","source",{"_62":72},"links",{"_58":71},"publishedAt","2026-11-19T07:41:58.000Z","discoveredAt","2026-11-23T04:30:56.063Z","timelineAt","category","policy","tags",[66,67,68,69,70],"score",75,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699728&idx=1&sn=ad4603c085e1e6176db621d35167cbac&chksm=bc82622d4380bd261b9ba08d02f8b97237e11e1aae9c8282c08f8ebbd7cca66147e1dbaf2320&scene=126&sessionid=1795408227#rd","医药云端工作室",{"_74":75,"_76":-5,"_77":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
