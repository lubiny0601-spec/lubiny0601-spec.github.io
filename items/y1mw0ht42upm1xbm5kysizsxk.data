[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384583000,"id","y1mw0ht42upm1xbm5kysizsxk","title","GSK进博会展示靶向IL-5生物制剂美泊利珠单抗与德莫奇单抗，推动呼吸慢病长期管理","originalTitle","创新靶向生物制剂亮相进博，助推呼吸系统疾病走向长期控制","summary","GSK在第九届进博会上展示多款靶向生物制剂，其中靶向IL-5的美泊利珠单抗已在华获批慢阻肺病、重度哮喘等5大相关适应症，同为IL-5靶点的德莫奇单抗仅需半年给药一次。GSK称德莫奇单抗为全球首个且目前唯一的\"超长效\"生物制剂，可帮助患者更长久地控制疾病。","reason","source",{"_64":75},"links",{"_57":74},"publishedAt","2026-11-08T11:03:31.000Z","discoveredAt","2026-11-09T06:30:52.769Z","timelineAt","category","industry","tags",[65,69,72,73],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":70,"_64":71},{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","company-news","name","公司动态","antibody","抗体与双抗","respiratory","呼吸","gsk","GSK 葛兰素史克","抗体/双抗","GSK","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604571&idx=2&sn=31104968bfc28d403664d22fcfca52bd&chksm=fca3a4a9a4a1c1868cac42b9476f0c41fb66da215a4b4e0a5cad82829411cda5ad6874004ad7&scene=126&sessionid=1794205843#rd","呼吸界",{"_77":78,"_79":-5,"_80":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
