[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795443790000,"id","p91nspexyc0mxzhku9gyzv0z4","title","Genmab 三款抗癌药关键试验接连告捷，下一步聚焦获批与自主商业化","originalTitle","STAT+: A string of wins with cancer drugs sets Genmab up for its next chapter","summary","Genmab 上月有三款药物在三种不同癌症的关键试验中取得成功，被分析师称为“帽子戏法”。公司下一步需推进这些药物的获批与上市，其中两款产品将由 Genmab 自主商业化，以证明其不依赖大型药企合作的能力。CEO Jan van de Winkel 表示“一切归结于执行”。","reason","source",{"_72":84},"links",{"_60":83},"publishedAt","2026-11-23T09:30:00.000Z","discoveredAt","2026-11-23T11:48:44.201Z","timelineAt","category","industry","tags",[73,77,82],"score",20,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Andrew Joseph","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fKZsjel3RB4E","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","company-news","name","公司动态","antibody","抗体与双抗","oncology","肿瘤",{"_79":80,"_13":81},"publicId","7089962e-959a-486a-90a3-5257bdc59adf","Genmab三款肿瘤药关键试验成功，转向自主商业化","抗体/双抗","https://www.statnews.com/2026/11/23/genmab-cancer-drugs-oncology-clinical-trials/?utm_campaign=rss","STAT",{"_86":87,"_88":-5,"_89":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
