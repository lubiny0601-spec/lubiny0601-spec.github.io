[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795408365000,"id","smzgdcmtq0ad0uqbvb8d3rjm2","title","礼来与Stipple Bio达成59亿美元多靶点肿瘤合作，开发TSE表位结合药物","originalTitle","59亿美元！礼来达成肿瘤新合作","summary","礼来与Stipple Bio签署多靶点、多模态战略性研究合作及授权许可协议，礼来获得合作产出产品的全球独家开发与商业化权益。Stipple Bio将依托Pointillist平台发掘肿瘤特异性细胞表面表位（TSE）结合物，礼来负责工程化改造开发候选药物，若达成各阶段里程碑，Stipple Bio有资格累计获得最高59亿美元里程碑款及阶梯式特许权使用费。","reason","source",{"_65":76},"links",{"_58":75},"publishedAt","2026-11-17T03:44:36.000Z","discoveredAt","2026-11-23T04:24:45.561Z","timelineAt","category","industry","tags",[73,70,72,74],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","永恒","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","deals","name","交易与授权","antibody","抗体与双抗","oncology","肿瘤","lilly","礼来","交易/授权","抗体/双抗","https://www.drugtimes.cn/2026/11/17/59yimeiyuanlilaidachengzhongliuxinhezuo/","药时代",{"_78":79,"_80":-5,"_81":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
