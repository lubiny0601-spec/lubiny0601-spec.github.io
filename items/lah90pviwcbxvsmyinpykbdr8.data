[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384583000,"id","lah90pviwcbxvsmyinpykbdr8","title","招商蛇口挂牌转让招商力宝50%股权及5086.9863万元债权，退出太子湾医院运营","originalTitle","一央企剥离医院业务","summary","招商蛇口全资子公司深圳市招商创业在北京产权交易所挂牌，拟转让招商力宝医院管理（深圳）有限公司50%股权及5086.9863万元债权，底价5456.5863万元，等同出售太子湾医院50%股权。该项目须与乐活国际50%股权及1500万元债权打包受让，原股东力宝医疗保留优先购买权。截至2026年6月30日，招商力宝营业收入2171.73万元，净利润-5880.94万元，所有者权益-15115.52万元。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-08T11:01:13.000Z","discoveredAt","2026-11-09T06:31:28.766Z","timelineAt","category","industry","tags",[71,78],"score",20,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fY10LNaDHGSY","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","company-news","name","公司动态","device-ivd","医疗器械与 IVD",{"_75":76,"_13":77},"publicId","45579f8c-2ed2-4791-ae79-3cb6afbe63dd","招商蛇口挂牌转让招商力宝50%股权及债权","医疗器械/IVD","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669799&idx=3&sn=7a407bde5478529c7464d1b79c184037&chksm=bc567860a3682311429a44fc7641f4f0ce9b7fc05aed2f4b9f889a36b26d43836f251edf6583&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
