[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795443794000,"id","hdfpq7uxadjr0itncnrfhi4w7","title","53岁女性20厘米肝脓肿，脓液mNGS与培养检出中间链球菌","originalTitle","探案丨腹胀痛背后，竟藏着20厘米的肝脓肿——元凶是谁？","summary","一例53岁女性因发热、右上腹胀痛就诊，影像发现肝右叶约20.9×13.7 cm巨大脓肿，超声引导置管引流约6000 mL脓液，脓液mNGS与培养均检出中间链球菌。经厄他培南经验性治疗后依药敏降级为头孢曲松联合左氧氟沙星，并引流右侧肺炎旁胸腔积液约1000 mL，炎症指标与肝功能逐步改善，随访脓肿持续缩小并拔管。","reason","source",{"_70":84},"links",{"_60":83},"publishedAt","2026-11-09T12:00:00.000Z","discoveredAt","2026-11-11T08:15:56.179Z","timelineAt","category","clinical","tags",[71,78,79,80,81,82],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","王旭阳 马玉燕 等","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fHuy2dDhWk9o","reportCount",2,"additionalSourceCount",1,{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","临床进展","antibiotics","抗菌药物与耐药",{"_75":76,"_13":77},"publicId","6ecc5b8c-f90c-4917-90db-8578d0fb8cbc","53岁女性巨大肝脓肿检出中间链球菌","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200524&idx=1&sn=34236ef19d804ff362bce7a431356da6&chksm=82a9d21258ee9bd59e3c534e750a1fcfb8bc14e27ffd3fbc8c59ebc8e642dec362b929f77ba5&scene=126&sessionid=1794384944#rd","SIFIC 感染视界",{"_86":87,"_88":-5,"_89":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
