[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408367000,"id","u2o9lynnmhmeh068g98nkm7dc","title","陈晓亚/万里团队《Nature》揭示植物NIB1感知昆虫效应子产生的2′,3′-cNMP激活抗虫免疫","originalTitle","昆虫叮咬，植物有“感觉”？陈晓亚/万里研究团队合作最新《Nature》","summary","中国科学院分子植物科学卓越创新中心陈晓亚院士团队联合万里研究团队在《Nature》发表研究，揭示植物RNA结合蛋白NIB1可感知昆虫效应子T2家族核糖核酸酶（如NVR1）切割RNA产生的2′,3′-cAMP、2′,3′-cGMP及ApG>p等环磷酸核苷酸信号。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-15T00:00:00.000Z","discoveredAt","2026-11-16T00:55:13.222Z","timelineAt","category","research","tags",[78,73],"score",8,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fS9S_7BR2ULM","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","small-molecule","小分子",{"_75":76,"_13":77},"publicId","c58a043c-8299-4633-967b-92e5377d7fe9","Nature发表植物感知昆虫效应子激活免疫机制","论文/研究","https://news.bioon.com/article/a18a964192b8.html","生物谷",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
