[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794205946000,"id","z5ntl1g73tmtotdlutl52drzl","title","北卡罗来纳60县随机对照试验：社区与急救系统强化培训未改善院外心脏骤停生存率","originalTitle","Survival after sudden cardiac arrest didn’t improve despite training bystanders, emergency responders","summary","北卡罗来纳60个县、约850万居民的随机对照试验显示，针对911调度员、急救人员和社区居民的多层面心脏骤停培训未能提高院外心脏骤停患者的生存率及良好神经功能结局。研究五年间共22,459名成年居民发生院外心脏骤停，干预县11,615人与对照县10,844人的生存情况无差异。探索性分析显示第四年旁观者实施CPR的比例有所上升，研究者认为需更长时间评估。","reason","source",{"_72":83},"links",{"_60":82},"publishedAt","2026-11-08T22:15:00.000Z","discoveredAt","2026-11-09T06:26:05.069Z","timelineAt","category","clinical","tags",[74,76,81],"score",8,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","Elizabeth Cooney","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fWVZk41few28","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":30,"_72":74},{"_70":71,"_72":73},"slug","papers","name","论文研究","临床进展","cardiovascular","心血管",{"_78":79,"_13":80},"publicId","85ca8e74-bede-41e0-af34-730efce22b22","北卡社区心肺复苏培训RCT未改善院外心脏骤停生存","论文/研究","https://www.statnews.com/2026/11/08/sudden-cardiac-arrest-survival-cpr-defibrillation-training/?utm_campaign=rss","STAT",{"_85":86,"_87":-5,"_88":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
