[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794791090000,"id","eidkmnkxihcx5u1ipnw7w9mus","title","当选参议员 Abdul El-Sayed 谈重建科学信任、公共卫生现状与 RFK Jr.","originalTitle","Senator-elect Abdul El-Sayed on restoring trust in science, the state of public health, and RFK Jr.","summary","即将成为参议院首位流行病学家的密歇根州民主党人 Abdul El-Sayed 表示，美国科学信任危机已造成灾难性后果，他主张通过支持「Medicare for All」、揭露借科学之名牟利者、重振公共卫生运动三条路径重建信任。他批评 HHS 部长 Robert F. Kennedy Jr. 未兑现对抗企业的承诺，并称美国失去麻疹消除状态是「一场悲剧」。","reason","source",{"_64":74},"links",{"_58":73},"publishedAt","2026-11-13T09:30:00.000Z","discoveredAt","2026-11-16T00:55:13.620Z","timelineAt","category","opinion","tags",[70,71,72],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","Nicholas Florko","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","opinions","name","观点与解读","infectious","感染与疫苗","fda","美国 FDA","观点/解读","感染/疫苗","FDA","https://www.statnews.com/2026/11/13/senator-abdul-el-sayed-interview-public-health-rfk-jr-trust-in-science/?utm_campaign=rss","STAT",{"_76":77,"_78":-5,"_79":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
