[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793888174000,"id","mbfjlpsunppsdt4q5dm900459","title","赛诺菲停止开发与 Nurix 合作的 STAT6 降解剂 SAR448272","originalTitle","Sanofi stops development of Nurix-partnered immune drug","summary","赛诺菲已停止开发从 Nurix 引进的口服 STAT6 降解剂 SAR448272，该药原本用于湿疹等炎症性疾病。Nurix 未说明具体原因，赛诺菲向 Leerink Partners 表示“新出现的非临床发现”不支持继续开发。Nurix 股价周三早盘跌超 40%；该药 I 期研究于 8 月启动时 Nurix 已收到赛诺菲 1000 万美元付款。","reason","source",{"_73":88},"links",{"_60":87},"publishedAt","2026-11-04T17:18:00.000Z","discoveredAt","2026-11-05T05:13:21.792Z","timelineAt","category","industry","tags",[74,85,76,80,86],"score",22,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","Delilah Alvarado","body","outline",[],"relatedStories",[81],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","frNItuMRQpBI","reportCount",1,"additionalSourceCount",0,{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","company-news","name","公司动态","small-molecule","小分子","immunology","自免与炎症","sanofi","赛诺菲",{"_82":83,"_13":84},"publicId","b82330b6-0c01-4351-a4db-a8e21812b3f8","赛诺菲停止开发Nurix授权的STAT6降解剂","自免","罗氏","https://www.biopharmadive.com/news/sanofi-discontinue-development-nurix-stat6-degrader-eczema/873697/","BioPharma Dive",{"_90":91,"_92":-5,"_93":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
