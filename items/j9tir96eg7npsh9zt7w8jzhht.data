[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793889553000,"id","j9tir96eg7npsh9zt7w8jzhht","title","华东医药环孢素软胶囊、他克莫司胶囊、美沙拉秦肠溶片拟中选第十二批国家集采","originalTitle","华东医药｜环孢素软胶囊、克莫司胶囊、美沙拉秦肠溶片拟中选集采","summary","华东医药及子公司中美华东、西安博华参与第十二批国家集采投标，环孢素软胶囊、他克莫司胶囊、美沙拉秦肠溶片拟中选，采购周期自执行之日起至2029年12月31日。上述拟中选产品2025年度合计销售收入约20.76亿元，占公司营业收入4.76%、医药工业营业收入（含CSO业务）14.04%。","reason","公告同时列出拟中选与未中选品种的收入占比，读者可据此判断第十二批集采对华东医药的院内基本盘影响。","source",{"_63":74},"links",{"_58":73},"publishedAt","2026-08-02T16:00:00.000Z","discoveredAt","2026-10-27T15:19:16.577Z","timelineAt","category","policy","tags",[69,70,68,71,72],"score",78,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":31,"_63":64},"slug","name","政策与监管","insurance","医保与集采","huadong","华东医药","政策/监管","医保/集采","抗感染","市场准入","https://static.cninfo.com.cn/finalpage/2026-08-03/1225452807.PDF","华东医药·公司公告",{"_76":77,"_78":-5,"_79":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
