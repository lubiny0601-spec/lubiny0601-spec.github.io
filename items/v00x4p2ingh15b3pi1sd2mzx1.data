[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":52,"_53":-5,"_54":35,"_55":56},"expiresAt",1793888193000,"id","v00x4p2ingh15b3pi1sd2mzx1","title","国家药监局修订降脂灵制剂和乳块消口服制剂说明书","originalTitle","summary","国家药监局10月22日发布2026年第102号公告，对降脂灵制剂（片、分散片、颗粒）和乳块消口服制剂（片、颗粒、胶囊、软胶囊、丸、口服液和糖浆）说明书中的【警示语】【不良反应】【禁忌】【注意事项】等进行统一修订。上市许可持有人须于2027年1月18日前报省级药品监督管理部门备案，备案后9个月内完成已出厂说明书及标签更换或告知患者。","reason","source",{"_63":74},"links",{"_56":73},"publishedAt","2026-10-22T00:00:00.000Z","discoveredAt","2026-10-27T13:29:45.303Z","timelineAt","category","policy","tags",[70,71,67,72],"score",40,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":68,"_63":69},{"_61":66,"_63":67},{"_61":29,"_63":65},{"_61":62,"_63":64},"slug","safety","name","安全与质量","政策与监管","tcm","中药","nmpa","中国 NMPA","政策/监管","NMPA","安全/质量","https://www.cnpharm.com/c/2026-10-22/1109306.shtml","中国食品药品网·要闻",{"_76":77,"_78":-5,"_79":52},"changelogVersion","2026-10-08T08:00","release","staticSite"]
