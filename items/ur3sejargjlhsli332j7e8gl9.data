[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793888179000,"id","ur3sejargjlhsli332j7e8gl9","title","鲁抗医药注射用盐酸万古霉素拟中选第十二批国家集采","originalTitle","鲁抗医药｜鲁抗医药关于参与第十二批全国药品集中采购拟中选的公告","summary","鲁抗医药公告，公司产品注射用盐酸万古霉素（0.5g）拟中选第十二批全国药品集中采购，拟中选价格与数量以联采办最终数据为准，采购周期自中选结果执行之日起至2029年12月31日。该产品2025年度销售收入544.78万元，占公司2025年度营业收入的0.09%；2026年一季度销售收入555.44万元。公司提示采购合同签订及后续市场销售执行仍存在不确定性。","reason","公告披露了注射用盐酸万古霉素拟中选第十二批国家集采，并给出该品种的销售基数与采购周期，便于判断集采对单品的影响。","source",{"_63":78},"links",{"_58":77},"publishedAt","2026-08-03T16:00:00.000Z","discoveredAt","2026-10-28T17:00:37.599Z","timelineAt","category","policy","tags",[69,70,71,72,73,74,75,76],"score",62,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":31,"_63":64},"slug","name","政策与监管","insurance","医保与集采","antibiotics","抗菌药物与耐药","政策/监管","抗菌药物","医保/集采","鲁抗医药","抗感染","市场准入","对销售","对准入","https://static.cninfo.com.cn/finalpage/2026-08-04/1225454572.PDF","鲁抗医药·公司公告",{"_80":81,"_82":-5,"_83":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
