[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793888174000,"id","anicz33ggaymyiu5pwcim1zis","title","CVS Health宣布分拆为两家公司，逆转多年并购整合","originalTitle","STAT+: CVS Health to split, reversing years of deal-making to combine pharmacies and insurance","summary","CVS Health宣布将拆分为两家独立上市公司，分别命名为CVS Health和CVS Pharmacy，逆转多年来将药房与保险业务合并的并购路径。CVS Health将保留Caremark PBM、Aetna保险、专科药房及面向老年人的初级诊疗和上门服务业务，专科药房高值药品仍与全美最大PBM和保险公司交织。此前CVS等大型保险公司因垂直整合面临联邦和州层面的审查。","reason","source",{"_71":80},"links",{"_60":79},"publishedAt","2026-11-04T16:30:06.000Z","discoveredAt","2026-11-05T05:13:21.957Z","timelineAt","category","industry","tags",[74,72],"score",22,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","Bob Herman","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","f0EhlWTOUdNQ","reportCount",2,"additionalSourceCount",1,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","trends","name","行业趋势","company-news","公司动态",{"_76":77,"_13":78},"publicId","585112eb-ca7d-4cc9-beab-37b97e3bbaf5","CVS宣布拆分，Aetna与Caremark剥离零售药房","https://www.statnews.com/2026/11/04/cvs-splits-pharmacy-from-insurance/?utm_campaign=rss","STAT",{"_82":83,"_84":-5,"_85":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
