[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384585000,"id","sek7k3qt2g2z3eutz212qld4p","title","中国医科大学刘国军等开发手性病毒样纳米平台CVSN，突破血脑屏障递送抗生素治疗细菌性脑膜炎","originalTitle","Adv Sci：突破血脑屏障，中国医科大学刘国军等开发纳米平台为细菌性脑膜炎提供广谱给药方案","summary","中国医科大学刘国军等开发手性病毒模拟介孔二氧化硅纳米结构CVSN，经L-丙氨酸修饰后可高效穿透血脑屏障，将头孢哌酮、诺氟沙星、左氧氟沙星与亚胺培南等多种抗生素递送至脑实质与脑脊液。该体系靶向小胶质细胞与星形胶质细胞，提升抗生素生物利用度与脑内药物浓度，对13株临床分离肺炎链球菌表现出强效抗菌活性，可用于革兰氏阴性菌和阳性菌所致脑膜炎。","reason","source",{"_71":89},"links",{"_59":88},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T09:52:05.997Z","timelineAt","category","research","tags",[81,82,83,84,85,86,87],"score",14,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fd0zSHYjvhXI","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","neuroscience","神经与精神",{"_78":79,"_13":80},"publicId","39772ea6-3e9d-43e4-8b4c-a79cd5eaccfb","手性纳米平台递送抗生素穿透血脑屏障","论文/研究","抗菌药物","耐药与院感","神经/精神","抗感染","管线上新","对市场","https://news.bioon.com/article/9f97961194bb.html","生物谷",{"_91":92,"_93":-5,"_94":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
