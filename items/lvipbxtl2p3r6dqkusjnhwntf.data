[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":55,"_56":35,"_57":58},"expiresAt",1794384583000,"id","lvipbxtl2p3r6dqkusjnhwntf","title","破谣 | 立冬之后一定要多吃萝卜？生吃比熟吃效果好？","originalTitle","summary","立冬后\"冬日萝卜赛人参\"的说法流传，中医认为萝卜味甘性寒、入肺胃经，可清热生津、下气宽中，对肺热所致的黄稠鼻涕、口干咽痛、痰黄黏稠等有帮助。萝卜籽\"莱菔子\"也是常用清热化痰、消食降气药。生吃辣味重、清热生津下气消食效果相对更好，炖煮后辣味消减、性质平和，更适合脾胃虚寒者；服用人参、党参等补气药时不宜同食，且萝卜不能替代药物。","reason","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-11-08T11:03:31.000Z","discoveredAt","2026-11-09T06:30:55.877Z","timelineAt","category","opinion","tags",[77,72],"score",3,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fE5cMXNdbFtc","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","opinions","name","观点与解读","tcm","中药",{"_74":75,"_13":76},"publicId","8db24cb3-ee96-4faa-adb7-d35266cfa5a0","立冬后必吃萝卜？生吃熟吃各有适用人群","观点/解读","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604571&idx=3&sn=2dd26b37cb715b1f3bfdf82be73d2476&chksm=fc10e1b335357a929b0966cc3fd085a4f9d2e0569c0664184d69a80bf975fa338007290b03c9&scene=126&sessionid=1794205843#rd","呼吸界",{"_81":82,"_83":-5,"_84":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
