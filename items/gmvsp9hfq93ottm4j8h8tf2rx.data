[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793888173000,"id","gmvsp9hfq93ottm4j8h8tf2rx","title","Lonza 收购默克 KGaA 五个美国 CDMO 基地，美国站点翻倍至九个","originalTitle","Lonza Expanding U.S. CDMO Footprint with Purchase of Five Merck KGaA Sites","summary","Lonza 同意收购默克 KGaA 在美国的五个 CDMO 基地，交易金额为“低至中三位数百万瑞士法郎”，即 1 亿至 5 亿瑞士法郎。交易完成后 Lonza 美国 CDMO 站点将从四个增至九个，新增约 1,100 名员工，美国员工总数超过 6,000 人。收购站点覆盖生物偶联物、高效载荷-连接子、病毒载体及脂质纳米颗粒等能力，预计合计年销售额约 2.5 亿瑞士法郎。","reason","source",{"_72":85},"links",{"_60":84},"publishedAt","2026-11-04T21:34:47.000Z","discoveredAt","2026-11-05T05:13:23.133Z","timelineAt","category","industry","tags",[82,83,73],"score",22,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Alex Philippidis","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fC_4PSNV8UcY","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","company-news","name","公司动态","deals","交易与授权","cxo","CXO 与外包",{"_79":80,"_13":81},"publicId","adc1a396-88f7-44f1-bb48-a2b71ff3a715","Lonza收购默克KGaA五个美国CDMO基地","交易/授权","CXO","https://www.genengnews.com/topics/bioprocessing/lonza-expanding-u-s-cdmo-footprint-with-purchase-of-five-merck-kgaa-sites/","GEN Genetic Engineering & Biotechnology News",{"_87":88,"_89":-5,"_90":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
