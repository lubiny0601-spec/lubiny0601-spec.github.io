[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889549000,"id","iht0byh6ee6r929jdm5u68qvp","title","福建医科大学张文明等发现STING激动剂经STING/I型干扰素通路缓解骨髓炎疼痛、骨破坏与脓肿","originalTitle","Adv Sci：不杀细菌先修环境，福建医科大学张文明等发现STING激活拆掉骨髓炎三连击","summary","福建医科大学张文明、方心俞、杨滨团队在Advanced Science发表研究，发现STING激动剂在金黄色葡萄球菌诱导的小鼠股骨骨髓炎模型中可缓解疼痛、抑制骨破坏并减少局部脓肿形成。上述效应依赖宿主STING/I型干扰素信号通路，涉及抑制伤害感受器激活、抑制破骨细胞分化而不影响成骨细胞活性、下调IL-1β减少中性粒细胞募集三重机制。减少脓肿生成还可提升万古霉素等常规抗生素在感染灶的抗菌效果。","reason","source",{"_71":89},"links",{"_59":88},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T15:25:07.106Z","timelineAt","category","research","tags",[81,82,83,84,85,86,87],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fVGKZAt5BgiI","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","infectious","感染与疫苗",{"_78":79,"_13":80},"publicId","8ba84c5a-d2ad-42d9-b803-837573444283","STING激动剂缓解小鼠骨髓炎","论文/研究","感染/疫苗","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://news.bioon.com/article/7b4896158904.html","生物谷",{"_91":92,"_93":-5,"_94":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
