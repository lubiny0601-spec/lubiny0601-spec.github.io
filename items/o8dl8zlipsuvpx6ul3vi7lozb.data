[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889560000,"id","o8dl8zlipsuvpx6ul3vi7lozb","title","CDE就放射性体内诊断与治疗药物非临床研究技术指导原则问答文件公开征求意见","originalTitle","CDE公开征求《〈放射性体内诊断药物非临床研究技术指导原则〉问答文件（征求意见稿）》《〈放射性治疗药物非临床研究技术指导原则〉问答文件（征求意见稿）》意见","summary","CDE于10月26日就《〈放射性体内诊断药物非临床研究技术指导原则〉问答文件（征求意见稿）》和《〈放射性治疗药物非临床研究技术指导原则〉问答文件（征求意见稿）》公开征求意见，反馈时限为发布之日起1个月。两份问答文件基于2021年发布的放射性体内诊断药物指导原则和2024年发布的放射性治疗药物指导原则修订形成，旨在规范和指导放射性诊断、治疗药物的非临床研究研发与评价。","reason","source",{"_70":83},"links",{"_59":82},"publishedAt","2026-10-27T00:00:00.000Z","discoveredAt","2026-10-28T15:39:01.304Z","timelineAt","category","policy","tags",[80,73,81],"score",22,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fuShbs31f2O8","reportCount",1,"additionalSourceCount",0,{"_69":74,"_70":75},{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","政策与监管","radiopharma","放射性药物","nmpa","中国 NMPA",{"_77":78,"_13":79},"publicId","2b9bf1a8-a546-4fbc-858e-1e69c5440baf","CDE就放射性药物非临床研究问答文件征求意见","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-27/1109534.shtml","中国食品药品网·要闻",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
