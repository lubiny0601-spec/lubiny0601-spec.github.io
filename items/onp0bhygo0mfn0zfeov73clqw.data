[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443790000,"id","onp0bhygo0mfn0zfeov73clqw","title","国家药监局推进真实世界数据应用试点转入规范发展新阶段","originalTitle","国家药监局推进真实世界研究工作","summary","国家药监局副局长雷平在海南参加第八次真实世界数据应用试点领导小组会议，部署推动真实世界试点从探索阶段转入规范发展、常态应用新阶段。会议提出完善制度规则、对标国际共识打造技术指南体系，并探索建设全国药械真实世界数据平台，支持不良反应（事件）监测等工作。雷平同时出席第五届博鳌国际药械真实世界研究大会。","reason","source",{"_69":80},"links",{"_59":79},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T07:25:15.980Z","timelineAt","category","policy","tags",[77,78],"score",22,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","ffuXcHIEsejc","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","nmpa","中国 NMPA",{"_74":75,"_13":76},"publicId","02f2416a-eb83-4770-b1e1-44d8be97191c","国家药监局部署真实世界数据试点转段","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-23/1111185.shtml","中国食品药品网·要闻",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
