[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795410157000,"id","zvg5h6643xqv9rn1o75eij8ai","title","黄果到中检院调研 强调学习贯彻党的二十届五中全会精神","originalTitle","黄果到中检院调研 强调学习好贯彻好党的二十届五中全会精神","summary","国家药监局党组书记、局长黄果11月6日到中检院调研，就学习贯彻党的二十届五中全会精神参加生检所艾滋病性病病毒疫苗实验室党支部集体学习并宣讲全会精神。黄果强调学习好贯彻好全会精神是当前和今后一个时期的重大政治任务，要求对标对表全会部署，把全面从严治党要求贯彻到药品监管全过程，严把检验检测等质量安全关口。","reason","source",{"_61":68},"links",{"_57":67},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-11T14:04:23.302Z","timelineAt","category","policy","tags",[65,66],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-09/1110211.shtml","中国食品药品网·要闻",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
