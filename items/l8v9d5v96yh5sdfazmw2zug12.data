[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795410146000,"id","l8v9d5v96yh5sdfazmw2zug12","title","全国省级药监微信公众号传播力分析（11月8日—11月14日）：浙江药闻、湖北药监、广东药监居前","originalTitle","全国省级药监微信公众号传播力分析（11月8日—11月14日）","summary","11月15日，中国医药报社发布全国省级药监微信公众号传播力分析（11月8日—11月14日），\"浙江药闻\"\"湖北药监\"\"广东药监\"等十家公众号传播力较强。当周高关注度文章包括浙江发布的《长三角区域药品制造执行系统（MES）检查指南（试行）》，共8章、55个检查要点；湖北部署新修订《医疗器械生产质量管理规范》监督实施工作；广东化妆品电子标签试点已确定65家试点企业。","reason","source",{"_62":68},"links",{"_57":67},"publishedAt","2026-11-17T00:00:00.000Z","discoveredAt","2026-11-23T04:24:52.637Z","timelineAt","category","industry","tags",[63,66],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","trends","name","行业趋势","nmpa","中国 NMPA","NMPA","https://www.cnpharm.com/c/2026-11-17/1110592.shtml","中国食品药品网·要闻",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
