[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794384586000,"id","aceoomydne09xawgfaflvsqoj","title","程真顺教授等综述重症肺炎床旁病原学早期诊断进展：M-ROSE、多重PCR与宏基因组测序助力抓住“黄金时间窗”","originalTitle","程真顺教授等：重症肺炎患者如何抓住“黄金时间窗”？病原学和耐药基因检测技术、定植和感染判别方法等相关进展？","summary","武汉大学中南医院程真顺教授等发表综述，梳理重症肺炎床旁病原学早期诊断技术进展。快速现场微生物学评价（M-ROSE）可在15~30 min内完成涂片判读，多重PCR、宏基因组测序等可缩短病原体检出时间并同步检测耐药基因。病原体谱联合宿主免疫应答状态的多组学分析有助于区分定植与感染，避免抗生素泛用。","reason","source",{"_71":86},"links",{"_60":85},"publishedAt","2026-10-29T11:34:10.000Z","discoveredAt","2026-10-31T03:04:16.780Z","timelineAt","category","research","tags",[79,80,81,82,83,84],"score",20,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","韦超洁  程真顺","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fz7DCdwDhnxM","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药",{"_76":77,"_13":78},"publicId","48f5bd25-8127-49ed-a021-7118d61db0ec","程真顺等发表重症肺炎床旁病原学诊断综述","论文/研究","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604136&idx=2&sn=03d9d6c6d68860402d724f1c25b49f42&chksm=fcabed0e7dbdb6fd0291bb6307f17e800c80913e669aa761bf8fd14652da291fb787b788b70f&scene=126&sessionid=1793415832#rd","呼吸界",{"_88":89,"_90":-5,"_91":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
