[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384594000,"id","wobqo3l9zk7cs9rh44pajhiwp","title","国家药监局副局长王维东调研西南分中心建设工作","originalTitle","王维东调研指导西南分中心建设工作","summary","国家药监局党组成员、副局长王维东带队赴药品和医疗器械审评检查西南分中心调研，与重庆市政府共同召开分中心央地共建工作推进会，并召开西南五省（区、市）药品监管协同工作座谈会。王维东实地察看分中心党建、审评检查业务及队伍建设情况，强调把严的基调贯穿分中心建设运行各环节。","reason","source",{"_61":68},"links",{"_57":67},"publishedAt","2026-11-06T00:00:00.000Z","discoveredAt","2026-11-09T06:26:07.623Z","timelineAt","category","policy","tags",[65,66],"score",10,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-06/1110082.shtml","中国食品药品网·要闻",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
