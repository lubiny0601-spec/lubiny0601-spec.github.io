[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795410124000,"id","mt9jo5os7n40feu1p3lxb1yf3","title","湖南调整优化医疗服务价格，2025年调价总金额12.69亿元","originalTitle","统筹基金安全·医院运转·群众负担 湖南调整优化医疗服务价格","summary","湖南省医保局介绍医疗服务价格动态调整机制运行情况，2025年全省全年调价总金额12.69亿元，其中年度动态调整空间5.34亿元、价格治理腾出空间7.35亿元。机制设3项启动条件、5项约束条件，上年度医药总费用增幅高于10%或基金当期赤字等情形原则上不得上调价格。2026年10月湖南还下调560个药品、352类医用耗材的个人先行自付比例，预计每年增加基金支出保底约8亿元。","reason","湖南披露调价总量、熔断条件与支付协同的具体做法，可供其他省份测算调价空间时参照。","source",{"_62":68},"links",{"_58":69},"publishedAt","2026-11-17T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.109Z","timelineAt","category","policy","tags",[66,67,68],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/17/art_287_23421.html",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
