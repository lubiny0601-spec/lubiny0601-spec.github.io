[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795410124000,"id","ve0ppj48xx02vv4x4eq007iwh","title","广东开展第十二批国家集采中选企业供应清单外规格包装挂网价格确认","originalTitle","关于开展第十二批国家组织药品集中采购中选企业未在供应清单内规格包装产品挂网价格确认工作的通知","summary","广东省药品交易中心启动第十二批国家集采中选企业未在供应清单内规格包装产品的挂网价格确认，要求按本企业中选价格依差比价规则计算调整，确认时间为即日起至2026年11月20日17:30。企业同意调整的价格自2026年11月30日起与中选结果同步执行，拒绝确认且申诉未获采纳或逾期未操作的药品自同日起取消挂网。","reason","广东对第十二批国家集采中选企业供应清单外规格包装启动挂网价确认，涉及差比价调整与逾期取消挂网。","source",{"_62":71},"links",{"_58":70},"publishedAt","2026-11-16T16:00:00.000Z","discoveredAt","2026-11-23T04:24:57.557Z","timelineAt","category","policy","tags",[66,67,68,69],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","抗感染","市场准入","https://www.gdmede.com.cn/announcement/announcement/detail?id=2122588452900835328","广东省药品交易中心·通知公告",{"_73":74,"_75":-5,"_76":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
