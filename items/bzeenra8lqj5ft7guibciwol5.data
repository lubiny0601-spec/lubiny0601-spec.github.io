[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384584000,"id","bzeenra8lqj5ft7guibciwol5","title","进博会聚焦减重、抗肿瘤与罕见病：拜耳塞伐艾替尼片、礼来奥氟格列隆等新药亮相","originalTitle","进博会 | 聚焦减重、抗肿瘤和罕见病治疗领域，本届进博会有这些“药”点","summary","第九届进博会药品展区集中展示减重、抗肿瘤和罕见病领域新药：拜耳塞伐艾替尼片今年4月在中国附条件获批用于HER2突变NSCLC，进博会前夕一线治疗获批；礼来口服小分子GLP-1激动剂奥氟格列隆首次展出，2026年4月在美国获批用于肥胖症长期体重管理，2025年底已向国家药监局递交体重管理和2型糖尿病上市申请。","reason","source",{"_66":86},"links",{"_57":85},"publishedAt","2026-11-07T00:00:00.000Z","discoveredAt","2026-11-09T06:26:07.598Z","timelineAt","category","industry","tags",[67,75,78,71,69,79,80,77,81,82,83,84],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":76,"_66":77},{"_64":74,"_66":75},{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","trends","name","行业趋势","respiratory","呼吸","rare-disease","罕见病","metabolic","代谢与减重","oncology","肿瘤","lilly","礼来","代谢/减重","GLP-1","拜耳","罗氏","诺和诺德","默沙东","GSK","https://www.cnpharm.com/c/2026-11-07/1110090.shtml","中国食品药品网·要闻",{"_88":89,"_90":-5,"_91":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
