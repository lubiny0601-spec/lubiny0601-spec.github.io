[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795443790000,"id","pg5iwvk1vrpiwu5y1r2ehee17","title","观点：中国研究机构通过FOIA获取我的科研工作，我不得不交出","originalTitle","Opinion: A Chinese research entity FOIA’d my scientific work. I had to give it to them","summary","美国西北大学Francesca E. Duncan通过FOIA收到通知，一家中国实体仅支付25美元即申请获取其由NIH资助的科研基金申请书，依法她必须交出。NIH十余年间通过FOIA收到超过13,300份基金申请书请求。她呼吁国会将专有美国科学成果豁免或排除于FOIA之外。","reason","source",{"_70":78},"links",{"_60":77},"publishedAt","2026-11-23T09:30:00.000Z","discoveredAt","2026-11-23T11:48:44.209Z","timelineAt","category","opinion","tags",[76],"score",15,"selected",false,"channel","news","story",{"_73":74,"_13":75},"x","readingMode","full","author","Francesca E. Duncan","body","outline",[],"relatedStories",[72],"topics",[67],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","frreptpjHDTM","reportCount",1,"additionalSourceCount",0,{"_68":69,"_70":71},"slug","opinions","name","观点与解读",{"_73":74,"_13":75},"publicId","97b7cc6e-b7c4-4430-a9cc-fbddf188240e","美学者称中国实体经FOIA索取其NIH基金申请","观点/解读","https://www.statnews.com/2026/11/23/foia-scientific-research-china-legal-loophole/?utm_campaign=rss","STAT",{"_80":81,"_82":-5,"_83":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
