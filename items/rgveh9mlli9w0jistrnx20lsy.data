[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793889548000,"id","rgveh9mlli9w0jistrnx20lsy","title","美国国会跛脚鸭会期：12月11日政府拨款截止期限将决定到期卫生项目与HHS提名人确认","originalTitle","STAT+: A looming deadline to fund the government will shape Congress’ unusual lame duck session","summary","民主党已赢得众议院和参议院控制权，但共和党仍执政至明年，国会须在12月11日前通过政府拨款法案。下周开始的跛脚鸭会期将决定到期卫生项目能否获得资金，以及特朗普提名的多位HHS人选能否在民主党接管前获得确认。今年任何医疗立法几乎都必须纳入政府拨款法案。","reason","source",{"_69":77},"links",{"_60":76},"publishedAt","2026-11-04T15:55:54.000Z","discoveredAt","2026-11-05T05:13:21.968Z","timelineAt","category","policy","tags",[75],"score",12,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","John Wilkerson","body","outline",[],"relatedStories",[71],"topics",[67],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fevBPhm_W6g0","reportCount",1,"additionalSourceCount",0,{"_68":30,"_69":70},"slug","name","政策与监管",{"_72":73,"_13":74},"publicId","d357b565-2be8-47cd-a688-fc905079187f","美国国会12月11日前须通过政府拨款法案","政策/监管","https://www.statnews.com/2026/11/04/lame-duck-session-congress-health-policy-aca-subsidies-medicaid-funding/?utm_campaign=rss","STAT",{"_79":80,"_81":-5,"_82":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
