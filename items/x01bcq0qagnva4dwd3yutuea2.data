[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443811000,"id","x01bcq0qagnva4dwd3yutuea2","title","AI制药全链条生态加速成形：2025年全球市场规模66.3亿美元，华为、英伟达与礼来等入局","originalTitle","AI制药全链条生态正在加速成形","summary","AI制药全链条生态正在加速成形，2025年全球市场规模达66.3亿美元，增速43.55%；今年1至9月融资57笔、总额接近158亿美元，已接近去年全年的3倍。除传统药企、AI制药企业和CRO外，信息技术企业纷纷入局，华为成立制药军团，英伟达与礼来联合投入10亿美元成立AI联合创新实验室。英矽智能利用生成式AI发现的肺纤维化治疗靶点，其新药已推进至三期临床试验。","reason","source",{"_63":71},"links",{"_57":70},"publishedAt","2026-11-13T00:00:00.000Z","discoveredAt","2026-11-16T00:55:14.792Z","timelineAt","category","opinion","tags",[69,64,68],"score",18,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","trends","name","行业趋势","opinions","观点与解读","lilly","礼来","观点/解读","https://www.cnpharm.com/c/2026-11-13/1110499.shtml","中国食品药品网·要闻",{"_73":74,"_75":-5,"_76":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
