[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794791090000,"id","q7ucu212w676l9xbwvvltqif8","title","百时美施贵宝合并研发部门，首席研究官Robert Plenge将离任","originalTitle","Bristol Myers research chief to depart in ‘evolution’ of company’s structure","summary","百时美施贵宝将合并研究与开发部门，现任首席医学官兼开发负责人Cristian Massacesi自1月1日起出任新设的研发负责人，首席研究官Robert Plenge将于2027年3月前离任完成交接。公司称此次结构调整旨在加快决策、改善管线管理并加速管线进展。Plenge随2019年以740亿美元收购Celgene加入，2023年7月起担任研究负责人。","reason","source",{"_63":69},"links",{"_58":68},"publishedAt","2026-11-12T16:03:00.000Z","discoveredAt","2026-11-16T00:55:13.597Z","timelineAt","category","industry","tags",[64,67],"score",36,"selected",false,"channel","news","story","x","readingMode","full","author","Kristin Jensen","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","company-news","name","公司动态","bms","BMS 百时美施贵宝","BMS","https://www.biopharmadive.com/news/bristol-myers-robert-plenge-cristian-massacesi-research-transition/874476/","BioPharma Dive",{"_71":72,"_73":-5,"_74":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
