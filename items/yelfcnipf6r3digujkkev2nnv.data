[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793889549000,"id","yelfcnipf6r3digujkkev2nnv","title","《NEJM》综述：革兰氏阴性菌抗菌药物耐药性的驱动因素、耐药机制与当前及新兴治疗格局","originalTitle","《NEJM》最新综述：革兰氏阴性菌抗菌药物耐药性的抬头威胁着现代医学的基础……其驱动因素、主要耐药机制以及当前和新兴治疗格局？","summary","《新英格兰医学杂志》发表综述，系统梳理革兰氏阴性菌抗菌药物耐药的驱动因素、主要耐药机制及当前和新兴治疗格局，重点关注产ESBL肠杆菌目细菌、CRE、难治性耐药铜绿假单胞菌和碳青霉烯类耐药鲍曼不动杆菌复合群感染。","reason","source",{"_71":86},"links",{"_60":85},"publishedAt","2026-11-01T11:17:22.000Z","discoveredAt","2026-11-02T13:58:44.690Z","timelineAt","category","research","tags",[79,80,81,82,83,84],"score",36,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","NEJM医学前沿","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fW2wYHD_2L7E","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药",{"_76":77,"_13":78},"publicId","dbbd44d9-bcf0-4fdb-88c2-72a1d7c4032e","NEJM发表革兰氏阴性菌耐药综述","论文/研究","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604328&idx=1&sn=e68f48ecb944febc49ba8d1730138b67&chksm=fc35a7aac077f42d022be156f2a37f733e52fda41983f449125102ff11741bd3299db136db1c&scene=126&sessionid=1793627912#rd","呼吸界",{"_88":89,"_90":-5,"_91":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
