[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443815000,"id","x8jxh2gypk2qiqxmvm66b9w0y","title","福建推进医保定点资源配置规划：2025年定点医药机构25166家，基金支出同比下降3.49%","originalTitle","福建规划引领优布局 系统施治提质效 统筹医保定点资源供给","summary","福建省医保部门推进医保定点资源配置规划编制，2025年全省定点医药机构25166家、与上年基本持平，千人床位数控制在6.01张，基本医保基金支出同比下降3.49%，所有统筹区实现当期收支平衡。规划实施以来定点医药机构仅增长179家，年均增长率不到1.08%。福州按每千人6.3张床位、3.8名医师设定住院与门诊机构配置目标，南平推行\"一套公式、两个通道、一个底线\"药店配置。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-11-10T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.170Z","timelineAt","category","policy","tags",[65,66,67],"score",40,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/10/art_287_23406.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
