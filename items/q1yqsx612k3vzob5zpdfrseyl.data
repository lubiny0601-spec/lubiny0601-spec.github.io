[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793889549000,"id","q1yqsx612k3vzob5zpdfrseyl","title","6家医院124万份病历对比：AI感控预警系统使院感发生率降近三分之一","originalTitle","124万份病历，AI交出了什么答卷？6家医院对比：院感发生率降了近三分之一","summary","上海市徐汇区中心医院联合6家三级医院开展多中心对照研究，3家使用AI感染实时监测与预警系统、3家采用传统人工监测，两年共纳入124万份住院患者数据。结果显示，AI系统组医院感染发生率下降近三分之一，多耐药发生率明显下降，聚集性事件预警排查由约3天缩短至约1天。该系统与HIS、LIS对接，可提醒医生护士及时防控，二级和基层医院同样具备应用可能。","reason","source",{"_71":86},"links",{"_60":85},"publishedAt","2026-10-28T11:50:22.000Z","discoveredAt","2026-10-28T15:45:32.023Z","timelineAt","category","research","tags",[79,80,81,82,83,84],"score",22,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","SIFIC团队","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fPc1vQWYApvs","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药",{"_76":77,"_13":78},"publicId","26949107-d6e4-486c-b520-20dda8ab1ee0","6家医院对照研究：AI院感预警使感染发生率降近三分之一","论文/研究","耐药与院感","抗感染","循证指南","对市场","对数字化","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200251&idx=1&sn=05acd6acac4bb40aee272f25c4a83b74&chksm=8248808896229f26dde03b3950cf7829aa571b89aae31814f172d82730caec1f8fbdc4ad6440&scene=126&sessionid=1793202279#rd","SIFIC 感染视界",{"_88":89,"_90":-5,"_91":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
