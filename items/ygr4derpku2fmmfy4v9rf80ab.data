[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889559000,"id","ygr4derpku2fmmfy4v9rf80ab","title","国家药监局副局长杨胜赴广东调研大湾区药物创新研发与监管工作","originalTitle","杨胜在广东调研大湾区药物创新研发工作","summary","国家药监局党组成员、副局长杨胜带队赴广东调研部分药物研发企业及药品、医疗器械大湾区分中心，并召开座谈会了解大湾区医药产业创新成果转化和药品监管工作情况。杨胜强调要主动服务国家发展战略，聚焦重点品种、完善服务方式方法，并加强人才培养、落实\"三统一\"工作目标。广东省药监局和深圳市市场监管局有关负责同志参加调研和座谈。","reason","source",{"_69":80},"links",{"_59":79},"publishedAt","2026-10-30T00:00:00.000Z","discoveredAt","2026-10-30T14:58:45.921Z","timelineAt","category","policy","tags",[77,78],"score",12,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f6H-mtx8TfYI","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","nmpa","中国 NMPA",{"_74":75,"_13":76},"publicId","a2cf1e72-4e9a-477e-a421-6d822c68d887","杨胜赴广东调研大湾区药物创新与监管","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-30/1109735.shtml","中国食品药品网·要闻",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
