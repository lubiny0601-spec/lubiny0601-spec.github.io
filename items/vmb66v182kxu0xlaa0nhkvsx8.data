[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889547000,"id","vmb66v182kxu0xlaa0nhkvsx8","title","每周医药看点（10月26日—11月1日）：CDE就新生抗原药品技术考虑征求意见，贝达药业与晟斯生物合作超长效生长激素月制剂SS202","originalTitle","每周医药看点（10月26日—11月1日）","summary","CDE就《新生抗原药品关键问题的技术考虑（征求意见稿）》公开征求意见，针对新生抗原预测、筛选与验证及软件/算法性能评估等药学研究提出一般性技术要求。贝达药业与晟斯生物就超长效重组生长激素月制剂SS202达成合作，贝达药业将主导该产品全球研发、生产及商业化，并支付首付款、里程碑付款及销售分成。和黄医药索乐匹尼布获FDA孤儿药资格认定，拟用于治疗原发免疫性血小板减少症。","reason","source",{"_66":87},"links",{"_57":86},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T05:13:24.522Z","timelineAt","category","industry","tags",[67,78,79,80,81,82,83,84,85],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":76,"_66":77},{"_64":74,"_66":75},{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","trends","name","行业趋势","pipeline","研发管��","policy","政策与监管","deals","交易与授权","insurance","医保与集采","nmpa","中国 NMPA","政策/监管","研发管线","交易/授权","医保/集采","恒瑞医药","华润医药","九州通","NMPA","https://www.cnpharm.com/c/2026-11-05/1109940.shtml","中国食品药品网·要闻",{"_89":90,"_91":-5,"_92":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
