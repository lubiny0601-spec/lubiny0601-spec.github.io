[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793888178000,"id","v16uh887df3rpzqoo7g66lhej","title","创伤弧菌综述：临床表现与抗生素治疗","originalTitle","A Review of Vibrio vulnificus: Clinical Presentation and Treatment","summary","创伤弧菌等弧菌属细菌自然存在于沿海咸水与半咸水中，经口摄入或开放性伤口接触可引发胃肠、血流或伤口感染，美国每年约8万例弧菌病。约40%的弧菌病由副溶血弧菌引起，溶藻弧菌占20%。肝病等高危人群感染后可能危及生命，综述梳理了创伤弧菌的临床表现与推荐抗生素治疗方案。","reason","source",{"_63":76},"links",{"_57":75},"publishedAt","2026-09-01T14:59:40.901Z","discoveredAt","2026-10-27T15:41:44.468Z","timelineAt","category","research","tags",[69,70,71,72,73,74],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","infectious","感染与疫苗","论文/研究","感染/疫苗","抗菌药物","抗感染","循证指南","对品牌","https://www.contagionlive.com/view/a-review-of-vibrio-vulnificus-clinical-presentation-and-treatment","Contagion Live·抗菌药物管理",{"_78":79,"_80":-5,"_81":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
