[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795408364000,"id","dgqkdd81uquk48cictyuxnbgi","title","翰森制药阿美乐、昕越新增适应症纳入2026国家医保目录，多款创新药续约","originalTitle","翰森制药 | 阿美乐®、昕越®新增适应症纳入2026国家医保目录，多款创新药成功续约","summary","翰森制药宣布甲磺酸阿美替尼片（阿美乐）新增1项适应症、伊奈利珠单抗注射液（昕越）新增2项适应症纳入2026国家医保目录，目录于2027年1月1日执行。阿美乐新增的是2026年1月获批的第五项适应症，即联合培美曲塞和铂类用于EGFR突变NSCLC一线治疗；昕越新增IgG4-RD与gMG两项适应症，NMOSD适应症续约。氟马替尼、洛塞那肽续约，帕立骨化醇软胶囊首次纳入医保。","reason","翰森制药披露阿美替尼与伊奈利珠单抗新增适应症进入2026国家医保目录，可据此判断相关产品的院内准入与放量节奏。","source",{"_66":86},"links",{"_58":85},"publishedAt","2026-11-13T16:00:00.000Z","discoveredAt","2026-11-16T00:55:18.960Z","timelineAt","category","policy","tags",[78,79,77,80,81,71,82,83,84],"score",75,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_65":76,"_66":77},{"_65":74,"_66":75},{"_65":72,"_66":73},{"_65":70,"_66":71},{"_65":68,"_66":69},{"_65":31,"_66":67},"slug","name","政策与监管","insurance","医保与集采","rare-disease","罕见病","metabolic","代谢与减重","immunology","自免与炎症","oncology","肿瘤","政策/监管","医保/集采","自免","代谢/减重","翰森制药","抗感染","市场准入","https://www.hansoh.cn/news/news-detail-514109.htm","翰森制药·公司新闻",{"_88":89,"_90":-5,"_91":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
