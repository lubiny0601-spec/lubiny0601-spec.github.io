[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794205944000,"id","seaiad78o4uisfn4q60ly09ns","title","葵花药业2026年前三季度净利润增349.07%，儿科中成药份额居首","originalTitle","净利润狂涨349%，儿科中成药龙头太猛了","summary","葵花药业2026年前三季度营收约21.19亿元、同比增长25.81%，归母净利润约8353万元、同比增长349.07%，扣非归母净利润约4943万元、同比增长160.72%。公司拥有600余个生产批文、29个独家品种，2026H1在中国城市实体药店终端儿科中成药集团排名居首，份额保持13%以上。今年以来5个品种获批并视同过评，其中氟比洛芬凝胶贴膏为首款贴膏剂，美沙拉秦肠溶片在第12批国家集采中选。","reason","葵花药业前三季度净利增349%，材料同时给出儿科中成药终端份额与在审新品结构，可看其增长来源。","source",{"_65":76},"links",{"_58":75},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-09T06:26:01.746Z","timelineAt","category","industry","tags",[66,72,73,74],"score",60,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","company-news","name","公司动态","market","市场与销售","pipeline","研发管��","tcm","中药","市场/销售","研发管线","https://www.menet.com.cn/info/202611/202611090911261126_151405.shtml","米内网·企业",{"_78":79,"_80":-5,"_81":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
