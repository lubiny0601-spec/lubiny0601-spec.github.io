[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794384583000,"id","z9e9cehp1psac0sgeqyex8tab","title","BIO 联合加州两家生物技术行业组织起诉 CMS，寻求叫停 GLOBE 药品定价试点","originalTitle","STAT+: BIO joins the legal fight against Medicare pilot that ties drug prices to peer countries","summary","BIO 与两家加州生物技术行业组织于周五向美国加州北区联邦地区法院提起诉讼，寻求叫停 CMS 的 GLOBE 试点，主张该示范项目超越 Medicare 法定权限。GLOBE 旨在将 Medicare 药品价格与同类国家价格对齐，业界预计其实际影响有限，但希望阻止其形成先例。CMS 未立即回应置评请求。","reason","source",{"_72":84},"links",{"_60":83},"publishedAt","2026-11-07T16:57:13.000Z","discoveredAt","2026-11-09T06:26:05.094Z","timelineAt","category","policy","tags",[81,82,73],"score",22,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","John Wilkerson","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","f00JjQFBLQqo","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":30,"_72":74},{"_70":71,"_72":73},"slug","trends","name","行业趋势","政策与监管","insurance","医保与集采",{"_78":79,"_13":80},"publicId","c48347dd-5d3e-4f47-85e9-fae2caa076ed","BIO起诉阻止GLOBE药品定价试点","政策/监管","医保/集采","https://www.statnews.com/2026/11/07/bio-sues-to-block-globe-drug-pricing-model/?utm_campaign=rss","STAT",{"_86":87,"_88":-5,"_89":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
