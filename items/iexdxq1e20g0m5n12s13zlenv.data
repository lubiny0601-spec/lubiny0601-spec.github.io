[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889548000,"id","iexdxq1e20g0m5n12s13zlenv","title","Cancer Cell：PAR4 驱动血小板抑制 CD8+ T 细胞，胶质母细胞瘤抗肿瘤免疫存在性别差异","originalTitle","Cancer Cell：血小板“叛变”了？科学家发现胶质母细胞瘤的性别差异新线索！","summary","Cancer Cell 发表研究显示，胶质母细胞瘤（GBM）患者血小板中 PAR4 驱动的反应性增强，激活后的血小板抑制 CD8+ T 细胞活性。临床前模型中药物抑制或基因敲除 PAR4 均可逆转对 CD8+ T 细胞的抑制，但生存获益仅见于雌性模型，且依赖雌激素，雄性模型在雌激素存在时阻断 PAR4 同样可延长生存期。","reason","source",{"_71":83},"links",{"_59":82},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T05:13:21.596Z","timelineAt","category","research","tags",[81,76,74],"score",14,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fIB4uQ6p1-qY","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","hematology","血液","oncology","肿瘤",{"_78":79,"_13":80},"publicId","9f4abac1-766e-4507-a6df-61d0932b9b59","Cancer Cell发表GBM血小板性别差异机制研究","论文/研究","https://news.bioon.com/article/334496185403.html","生物谷",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
