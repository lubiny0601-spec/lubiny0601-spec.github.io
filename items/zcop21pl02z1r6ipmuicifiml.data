[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408366000,"id","zcop21pl02z1r6ipmuicifiml","title","第15届医药健康互联网大会·蓝亭叙2026将在杭州召开，聚焦药企线上爆品打造","originalTitle","线上爆品打造，很多药企在试错","summary","第15届医药健康互联网大会·蓝亭叙2026将于11月28-30日在杭州举办，专门讨论药企线上爆品打造。大会将拆解线上全域营销造超级爆品的方法论，并讲解B2C、O2O双轮驱动的全渠道打法。配套议题还包括抖音、小红书、视频号内容电商破圈、即时零售爆品策略、慢病品类线上运营及私域加兴趣电商复购。","reason","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-14T05:35:05.000Z","discoveredAt","2026-11-16T01:03:33.481Z","timelineAt","category","industry","tags",[75,70],"score",10,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fprfJgyaonR0","reportCount",6,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","trends","name","行业趋势",{"_72":73,"_13":74},"publicId","fc8ce772-0c1b-487e-bdbe-1be471cae4a6","赛柏蓝杭州办医药健康互联网大会","其他","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670661&idx=4&sn=37cc8a55e0b462caedec6f85cdc9caf0&chksm=bc18c45cac135b6750148813f0858ec589b21396cc2fe8c061c0716e437256414539d760a9b7&scene=126&sessionid=1794790858#rd","赛柏蓝",{"_79":80,"_81":-5,"_82":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
