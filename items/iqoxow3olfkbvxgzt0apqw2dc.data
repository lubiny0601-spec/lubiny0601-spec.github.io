[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408367000,"id","iqoxow3olfkbvxgzt0apqw2dc","title","中国农业大学刘蓉/任发政等发现运动诱导WDR41 K319乳酰化激活自噬改善脂肪肝","originalTitle","Autophagy：中国农业大学刘蓉/任发政等发现运动流出的乳酸，给肝脏自噬拧开了开关","summary","中国农业大学刘蓉、任发政与美国西北大学Congcong He合作发现，运动产生的乳酸促进WDR41在K319位点乳酰化，该修饰由LDHA催化、SIRT2去乳酰化，通过驱动ULK1复合物组装启动自噬。WDR41及其K319乳酰化对运动诱导的胰岛素敏感性和脂质代谢改善、对抗肝脏过度脂质积累至关重要，为MAFLD防治提供新机制见解。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-15T00:00:00.000Z","discoveredAt","2026-11-16T00:55:13.258Z","timelineAt","category","research","tags",[78,79],"score",10,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fL_ADTgbza5s","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","metabolic","代谢与减重",{"_75":76,"_13":77},"publicId","4f166995-7596-413f-886c-7729af6b138c","中国农大团队揭示运动改善脂肪肝的分子机制","论文/研究","代谢/减重","https://news.bioon.com/article/b7649630836b.html","生物谷",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
