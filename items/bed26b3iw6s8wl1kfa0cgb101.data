[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384588000,"id","bed26b3iw6s8wl1kfa0cgb101","title","头孢曲松安全性：多医院回顾性研究显示严重不良事件率与其他静脉头孢菌素相当","originalTitle","Ceftriaxone Safety: Separating Signal From Risk","summary","一项多医院回顾性研究显示，头孢曲松严重不良事件发生率为0.047%，与其他4种静脉头孢菌素的0.041%相近且差异无统计学意义，不支持因近期卫生部门安全警报而避免使用头孢曲松。研究在2022年10月至2025年6月间共识别211例事件，其中头孢曲松组90例；临床医生仅将3例心脏骤停直接归因于头孢曲松，且均发生于合并多种基础疾病的患者。","reason","source",{"_63":76},"links",{"_57":75},"publishedAt","2026-09-16T19:08:23.707Z","discoveredAt","2026-10-27T15:41:44.428Z","timelineAt","category","research","tags",[69,70,71,72,73,74],"score",40,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","safety","name","安全与质量","papers","论文研究","antibiotics","抗菌药物与耐药","论文/研究","抗菌药物","安全/质量","抗感染","循证指南","对品牌","https://www.contagionlive.com/view/ceftriaxone-safety-separating-signal-from-risk","Contagion Live·抗菌药物管理",{"_78":79,"_80":-5,"_81":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
