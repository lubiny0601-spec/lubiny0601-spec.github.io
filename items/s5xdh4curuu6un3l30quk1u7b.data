[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795410145000,"id","s5xdh4curuu6un3l30quk1u7b","title","国家药监局在贵阳召开血液制品生产智慧监管三年行动工作总结会","originalTitle","血液制品生产智慧监管工作总结会在贵阳召开","summary","国家药监局11月17日在贵阳召开血液制品生产智慧监管三年行动工作总结会，该工作自2024年起部署，目前整体完成，行业信息化基础得到夯实、智慧监管水平实现提升。会议强调持续巩固建设成果、压紧压实企业主体责任，切实保障血液制品质量安全。副局长杨胜还赴血液制品生产企业和贵州省药检所调研生产监管和批签发情况。","reason","source",{"_62":71},"links",{"_57":70},"publishedAt","2026-11-18T00:00:00.000Z","discoveredAt","2026-11-23T04:24:52.594Z","timelineAt","category","policy","tags",[68,69,65],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":66,"_62":67},{"_61":64,"_62":65},{"_61":30,"_62":63},"slug","name","政策与监管","hematology","血液","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-18/1110853.shtml","中国食品药品网·要闻",{"_73":74,"_75":-5,"_76":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
