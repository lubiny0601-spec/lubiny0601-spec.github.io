[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794384585000,"id","h6a3ntm52c19q0h9pvzxckcji","title","STAT+：新肿瘤病例显示常用基因治疗工具AAV可能带来致癌风险","originalTitle","STAT+: New tumor cases show common gene therapy tool can come with risk","summary","新出现的肿瘤病例提供了有力证据，表明腺相关病毒（AAV）载体可能致癌，结束了持续二十年的相关争论。这一新确认的风险正迫使研究者和患者家庭在AAV疗法的救命潜力与致癌风险之间重新权衡，并推动未来设计更安全的疗法。罗切斯特大学神经学家Sam Mackenzie表示，这将改变部分患者（尤其是脊髓性肌萎缩症患者）的获益风险评估。","reason","source",{"_65":76},"links",{"_58":75},"publishedAt","2026-11-06T16:14:40.000Z","discoveredAt","2026-11-09T06:26:05.157Z","timelineAt","category","research","tags",[73,70,72,74],"score",20,"selected",false,"channel","news","story","x","readingMode","full","author","Jason Mast","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","safety","name","安全与质量","papers","论文研究","cell-gene","细胞与基因治疗","oncology","肿瘤","论文/研究","安全/质量","https://www.statnews.com/2026/11/06/novartis-zolgensma-gene-therapy-tumor-risk/?utm_campaign=rss","STAT",{"_78":79,"_80":-5,"_81":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
