[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793888172000,"id","yhbzdap7m00p2v6ya7dj3ffwe","title","A股医疗器械上市公司2026年前三季度营收TOP100出炉，迈瑞医疗居首","originalTitle","医疗器械上市公司营收前100来了","summary","2026年前三季度A股142家医疗器械上市公司中102家营收增长，迈瑞医疗以超270亿元营收、71.84亿元归母净利润稳居营收和净利润榜首。营收前十还包括英科医疗、联影医疗、新华医疗、鱼跃医疗等，十强总营收846.55亿元。第三季度医疗器械板块收入同比增长9.82%，归母净利润同比增长15.79%，医疗设备、医用耗材、体外诊断三大板块均实现增长。","reason","source",{"_66":80},"links",{"_58":79},"publishedAt","2026-11-04T10:45:03.000Z","discoveredAt","2026-11-05T05:16:08.787Z","timelineAt","category","industry","tags",[69,76,77,67,75,78],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","东台","body","outline",[],"relatedStories",[],"topics",[59,60,61,62,63],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_64":74,"_66":75},{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","trends","name","行业趋势","company-news","公司动态","market","市场与销售","device-ivd","医疗器械与 IVD","mindray","迈瑞医疗","医疗器械/IVD","市场/销售","联影医疗","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669472&idx=3&sn=83ecee1c704488d685c6d73f881cac01&chksm=bcb0d35bb4f0bf3afacfd1b6b1cc422966b4aabdae820d9da5116e8ef074e21e1cd6cbf06f04&scene=126&sessionid=1793855794#rd","赛柏蓝",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
