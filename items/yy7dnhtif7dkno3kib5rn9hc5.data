[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794384592000,"id","yy7dnhtif7dkno3kib5rn9hc5","title","北京医保局启动第1-8批国家集采协议期满品种接续采购协议采购量确认","originalTitle","关于开展国家组织集采药品协议期满品种接续采购中选产品协议采购量确认工作的通知","summary","北京市医疗保障局通知全市参与第1-8批国家组织集采药品协议期满品种接续采购的医疗机构，在2026年3月11日24时前完成中选产品协议采购量确认。医疗机构先查看平台推送的基础量，再将未中选企业约定采购量及中选企业调整后的剩余部分，分配给不高于询价基准的中选企业，同品种分配剩余量按主流规格折算后不得少于系统展示的应分配剩余量。确认通过江苏省药品和医用耗材招采管理系统提交，数据一经提交原则上不可修改。","reason","北京医保局明确第1-8批国家集采协议期满品种接续的协议采购量分配规则与截止时间，涉及剩余量分配口径。","source",{"_62":72},"links",{"_58":71},"publishedAt","2026-03-06T00:00:00.000Z","discoveredAt","2026-10-27T16:01:16.814Z","timelineAt","category","policy","tags",[66,67,68,69,70],"score",60,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://ybj.beijing.gov.cn/zczxs/2020_ycgga/202603/t20260306_4550977.html","北京医保局·药品通知公告",{"_74":75,"_76":-5,"_77":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
