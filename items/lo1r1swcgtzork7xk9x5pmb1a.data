[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384595000,"id","lo1r1swcgtzork7xk9x5pmb1a","title","恒瑞医药瑞康曲妥珠单抗联合PD-1/PD-L1抑制剂获NMPA临床试验批准，用于HER2异常可切除非鳞NSCLC围手术期","originalTitle","恒瑞医药｜恒瑞医药关于获得药物临床试验批准通知书的公告","summary","恒瑞医药子公司苏州盛迪亚、上海盛迪收到NMPA核准签发的《药物临床试验批准通知书》，同意注射用瑞康曲妥珠单抗联合PD-1/PD-L1抑制剂在伴有HER2异常的可切除非鳞非小细胞肺癌围手术期患者中开展临床试验。瑞康曲妥珠单抗为HER2靶向ADC，已在国内获批三项适应症；阿得贝利单抗为抗PD-L1单抗，已获批两项适应症。","reason","source",{"_72":89},"links",{"_59":88},"publishedAt","2026-11-04T16:00:00.000Z","discoveredAt","2026-11-05T05:13:22.365Z","timelineAt","category","clinical","tags",[73,77,86,79,87],"score",22,"selected",false,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","body","outline",[],"relatedStories",[82],"topics",[66,67,68,69,70],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fG84AHFGfeWg","reportCount",1,"additionalSourceCount",0,{"_71":80,"_72":81},{"_71":78,"_72":79},{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","临床进展","adc","ADC 与偶联药物","oncology","肿瘤","hengrui","恒瑞医药","nmpa","中国 NMPA",{"_83":84,"_13":85},"publicId","b455fcf1-3e63-4afb-90ee-ff0d3d70da6c","恒瑞瑞康曲妥珠单抗联合免疫治疗获临床试验批准","ADC","NMPA","https://static.cninfo.com.cn/finalpage/2026-11-05/1225657236.PDF","恒瑞医药·公司公告",{"_91":92,"_93":-5,"_94":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
