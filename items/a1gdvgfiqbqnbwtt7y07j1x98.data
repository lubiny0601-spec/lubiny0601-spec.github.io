[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795408364000,"id","a1gdvgfiqbqnbwtt7y07j1x98","title","同源康与汇宇就TY-9591商业化授权纠纷和解，支付3亿元","originalTitle","3亿元BD学费！同源康与汇宇的商业化授权纠纷落槌","summary","同源康医药与汇宇制药就TY-9591销售代理及配套合作争议签署附条件和解协议，同源康分两期支付合计3亿元，首期1.5亿元于协议生效后30日内支付，第二期最晚2027年1月25日；汇宇收款后向内江中院撤诉并放弃对TY-9591的全部权利主张。","reason","一药双授引发的3亿元和解，为创新药授权签约与权利冲突隔离提供了可参照的案例。","source",{"_75":92},"links",{"_61":91},"publishedAt","2026-11-12T03:22:34.000Z","discoveredAt","2026-11-12T14:18:51.320Z","timelineAt","category","industry","tags",[76,89,82,80,90],"score",62,"selected",true,"channel","news","story",{"_86":87,"_13":88},"x","readingMode","full","author","yian","body","outline",[],"relatedStories",[85],"topics",[68,69,70,71,72],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","f9UnpztPCey0","reportCount",1,"additionalSourceCount",0,{"_73":83,"_75":84},{"_73":81,"_75":82},{"_73":79,"_75":80},{"_73":77,"_75":78},{"_73":74,"_75":76},"slug","company-news","name","公司动态","deals","交易与授权","small-molecule","小分子","oncology","肿瘤","nmpa","中国 NMPA",{"_86":87,"_13":88},"publicId","b21ae9b2-9f21-40c8-968b-ccb32f936878","同源康与汇宇就TY-9591授权纠纷达成和解","交易/授权","NMPA","https://www.drugtimes.cn/2026/11/12/3yiyuanbdxuefeitongyuankangyuhuiyudeshangyehuashouquanjiufen/","药时代",{"_94":95,"_96":-5,"_97":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
