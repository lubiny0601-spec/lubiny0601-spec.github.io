[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889557000,"id","sabf80feaoav7bocovpym3gnb","title","黄果会见世卫组织监管和预认证司代理司长希蒂·西洛，讨论疫苗WLA评估合作","originalTitle","黄果会见世卫组织监管和预认证司代理司长希蒂·西洛","summary","国家药品监督管理局局长黄果11月2日在京会见世卫组织监管和预认证司代理司长希蒂·西洛及驻华代表马丁·泰勒，双方围绕世卫组织列名机构（WLA）评估、监管能力建设、人员交流等合作事项深入讨论。黄果表示中国国家药监局高度重视疫苗WLA评估工作，世卫组织愿共同推进评估，双方同意深化人员交流。会见后双方举行工作会议，就WLA评估及后续安排达成一致。","reason","source",{"_70":84},"links",{"_59":83},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T15:25:10.299Z","timelineAt","category","policy","tags",[80,81,82],"score",22,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fryyQBbiySWw","reportCount",1,"additionalSourceCount",0,{"_69":74,"_70":75},{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","政策与监管","infectious","感染与疫苗","nmpa","中国 NMPA",{"_77":78,"_13":79},"publicId","d83dfd0b-730e-4992-bc93-8e6721fd424c","黄果会见世卫组织代表，讨论疫苗WLA评估合作","政策/监管","NMPA","感染/疫苗","https://www.cnpharm.com/c/2026-11-03/1109871.shtml","中国食品药品网·要闻",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
