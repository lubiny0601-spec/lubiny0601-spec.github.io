[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795408382000,"id","laf4ojjguipf10num94dk29nh","title","翰森制药亮相2026创新药高质量发展大会，展示五大治疗领域原研新药与全球化管线","originalTitle","翰森制药亮相2026创新药高质量发展大会","summary","翰森制药在苏州举行的2026创新药高质量发展大会上，以“创新与国际化”为主题集中展示抗肿瘤、代谢、自身免疫、中枢神经系统、抗感染五大治疗领域的原研新药研发、商业化进展及全球化管线布局。大会由国家医疗保障局、江苏省人民政府指导，同期举办创新药械高质量发展博览会。国家医保局领导带队多部委及地方政府代表莅临展台考察。","reason","source",{"_62":68},"links",{"_57":67},"publishedAt","2026-11-13T16:00:00.000Z","discoveredAt","2026-11-16T00:55:18.953Z","timelineAt","category","industry","tags",[65,63,66],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","trends","name","行业趋势","company-news","公司动态","翰森制药","https://www.hansoh.cn/news/news-detail-514110.htm","翰森制药·公司新闻",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
