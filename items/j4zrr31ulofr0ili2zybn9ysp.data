[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794205945000,"id","j4zrr31ulofr0ili2zybn9ysp","title","礼来、阿斯利康等五家MNC公布2026年三季报，中国区表现分化","originalTitle","礼来市值1.3万亿美元，替尔泊肽业绩炸裂| MNC2026Q3业绩巡礼","summary","礼来、阿斯利康、默沙东、BMS、吉利德五家MNC公布2026年三季报，礼来Q3营收243.97亿美元、同比增长39%，市值首破1.3万亿美元。替尔泊肽降糖版与减重版前三季度合计437.68亿美元、占总营收65%，中国区Q3收入9.47亿美元、同比增69%，穆峰达2型糖尿病适应症2026年1月纳入国家医保后最低规格月治疗费降至324.1元。","reason","五家MNC三季报横向对照，中国区被单列成三种状态，可看清医保准入与集采对同一批品种的不同作用。","source",{"_68":86},"links",{"_59":85},"publishedAt","2026-11-02T01:42:02.000Z","discoveredAt","2026-11-02T13:59:16.230Z","timelineAt","category","industry","tags",[80,69,81,75,82,79,77,83,84],"score",62,"selected",true,"channel","news","story","x","readingMode","full","author","子非鱼","body","outline",[],"relatedStories",[],"topics",[60,61,62,63,64,65],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_66":78,"_68":79},{"_66":76,"_68":77},{"_66":74,"_68":75},{"_66":72,"_68":73},{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","trends","name","行业趋势","market","市场与销售","metabolic","代谢与减重","oncology","肿瘤","astrazeneca","阿斯利康","lilly","礼来","市场/销售","代谢/减重","GLP-1","默沙东","BMS","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699442&idx=1&sn=5e7f9d783f3193569a335a7c08b485d1&chksm=bc64fe86fad8057f3a9a51546e6fb212350dcf5c65f74d34e1cfda5f8a9a1eee1c0ad741b05d&scene=126&sessionid=1793627945#rd","医药云端工作室",{"_88":89,"_90":-5,"_91":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
