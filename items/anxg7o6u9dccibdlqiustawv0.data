[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408368000,"id","anxg7o6u9dccibdlqiustawv0","title","世界肺炎日：梁硕教授谈老年肺炎从\"重治疗\"转向\"重预防\"与全周期防线","originalTitle","世界肺炎日｜从\"重治疗\"到\"重预防\"，老年肺炎防治需构建全周期健康防线","summary","世界肺炎日之际，同济大学附属上海市肺科医院梁硕教授在上海\"老年肺炎科普讲座\"上指出，老年CAP患者症状不典型、致病菌复杂，应尽早留取病原学标本并启动经验性抗菌治疗。她推荐二/三代头孢菌素联合大环内酯类或四环素类等方案，并提到截短侧耳素类新机制药物可缩短疗程、减少住院时间。预防方面倡导勤洗手戴口罩、接种流感及肺炎球菌疫苗。","reason","source",{"_71":87},"links",{"_59":86},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-12T14:18:52.029Z","timelineAt","category","industry","tags",[72,81,82,83,84,85],"score",18,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","foi8-oREbgmA","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","company-news","name","公司动态","antibiotics","抗菌药物与耐药","infectious","感染与疫苗",{"_78":79,"_13":80},"publicId","f1cac05b-8bbd-4d57-8d93-34c4890fe013","上海举办老年肺炎科普讲座","感染/疫苗","抗菌药物","抗感染","专家会议","对市场","https://news.bioon.com/article/f906964080d3.html","生物谷",{"_89":90,"_91":-5,"_92":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
