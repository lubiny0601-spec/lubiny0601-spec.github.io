[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889566000,"id","ob1r5pq2jvu1qw67c5fg25xya","title","恒瑞医药瑞维鲁胺片获NMPA临床试验批准，拟开展前列腺癌III期研究","originalTitle","恒瑞医药｜瑞维鲁胺片临床试验获批","summary","恒瑞医药瑞维鲁胺片获国家药监局临床试验批准，将开展联合ADT对比安慰剂联合ADT治疗根治性手术/放疗后高危局限性或高危生化复发前列腺癌的多中心、随机、双盲、安慰剂对照III期研究。瑞维鲁胺为第二代AR抑制剂，2022年已获批用于高瘤负荷mHSPC，同类产品2025年全球销售额合计约128.9亿美元。","reason","source",{"_63":73},"links",{"_57":72},"publishedAt","2026-10-22T16:00:00.000Z","discoveredAt","2026-10-27T15:17:45.728Z","timelineAt","category","clinical","tags",[64,66,68,71],"score",31,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":69,"_63":70},{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":30,"_63":64},"slug","name","临床进展","oncology","肿瘤","hengrui","恒瑞医药","nmpa","中国 NMPA","NMPA","https://static.cninfo.com.cn/finalpage/2026-10-23/1225616060.PDF","恒瑞医药·公司公告",{"_75":76,"_77":-5,"_78":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
