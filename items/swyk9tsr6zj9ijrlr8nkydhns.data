[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794205945000,"id","swyk9tsr6zj9ijrlr8nkydhns","title","流感样病例暴发疫情升至145起，百亿流感药市场竞争升温","originalTitle","高峰期将至，百亿流感药市场竞争升温！","summary","中国疾控中心2026年第43周流感监测周报显示，全国报告145起流感样病例暴发疫情，较前一周的28起明显增加，阳性样本中甲型占67.6%、乙型占32.4%。2025年中国流感抗病毒药物市场规模约137亿元，奥司他韦三大终端六大市场销售额超83亿元，PA抑制剂市场由2024年的9亿元增至33亿元。","reason","梳理流感监测数据与奥司他韦、PA 抑制剂两类药物的销售格局，可看清百亿流感药市场的竞争重心。","source",{"_65":76},"links",{"_59":75},"publishedAt","2026-11-01T11:46:16.000Z","discoveredAt","2026-11-02T13:59:46.424Z","timelineAt","category","industry","tags",[71,72,73,74,66],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","姚婷婷","body","outline",[],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","trends","name","行业趋势","market","市场与销售","infectious","感染与疫苗","市场/销售","感染/疫苗","罗氏","国药控股","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653668987&idx=3&sn=55466c980eb55b56c64a9a8e5c6233a7&chksm=bc2eeeb4be37c6b414e7fe4ea768310f9b6d029103a01b77c590f998dc114489b3fc7fa68c0d&scene=126&sessionid=1793627968#rd","赛柏蓝",{"_78":79,"_80":-5,"_81":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
