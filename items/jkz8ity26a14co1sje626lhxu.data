[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888189000,"id","jkz8ity26a14co1sje626lhxu","title","CDE发布抗肿瘤药物基于后线数据开展前线适应症临床试验指导原则","originalTitle","CDE发布指导原则助推抗肿瘤药物临床研发向前线推进","summary","国家药监局药品审评中心于10月23日发布《抗肿瘤药物基于后线研究数据开展前线适应症临床试验技术指导原则》，适用于抗肿瘤治疗性药物，不涵盖细胞治疗和基因治疗产品。指导原则要求基于后线数据规划前线试验时系统评估药物作用机制、后线疗效数据、药物安全性特征三大要素，并阐述晚期患者前线试验的给药策略、研究人群选择及早期肿瘤适应症研发的特殊考量。","reason","source",{"_70":83},"links",{"_59":82},"publishedAt","2026-10-27T00:00:00.000Z","discoveredAt","2026-10-27T13:29:45.218Z","timelineAt","category","policy","tags",[80,73,81],"score",52,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fauKgvBwQmV4","reportCount",1,"additionalSourceCount",0,{"_69":74,"_70":75},{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","政策与监管","oncology","肿瘤","nmpa","中国 NMPA",{"_77":78,"_13":79},"publicId","8887f28a-f2e0-4d77-99c4-611253ac0672","CDE发布抗肿瘤药物前线适应症试验指导原则","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-27/1109520.shtml","中国食品药品网·要闻",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
