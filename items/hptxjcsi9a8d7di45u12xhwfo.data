[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1793888190000,"id","hptxjcsi9a8d7di45u12xhwfo","title","翰森制药公布瑞康立伏妥塔单抗（HS-20093）治疗复发或难治性骨肉瘤的III期ARTEMIS-011研究结果","originalTitle","ESMO 2026 | 翰森制药公布瑞康立伏妥塔单抗（HS-20093）治疗复发或难治性骨肉瘤的III期ARTEMIS-011研究结果","summary","翰森制药在ESMO 2026以LBA形式公布III期ARTEMIS-011研究结果，瑞康立伏妥塔单抗（HS-20093）对比吉西他滨联合多西他赛治疗既往至少二线治疗失败的复发或难治性骨肉瘤，达到BICR评估的PFS主要终点，中位PFS为5.5个月 vs 1.4个月（HR=0.33，95%CI 0.20-0.55，P<0.0001），疾病进展或死亡风险降低67%。","reason","原文给出ARTEMIS-011的PFS、ORR与安全性数值，读者可据此判断这款B7-H3 ADC在骨肉瘤中的获益幅度与风险。","source",{"_72":88},"links",{"_60":87},"publishedAt","2026-10-26T16:00:00.000Z","discoveredAt","2026-10-27T14:51:16.201Z","timelineAt","category","clinical","tags",[73,79,84,85,77,86],"score",47,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body","outline",[],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fwK61dkA58FY","reportCount",1,"additionalSourceCount",0,{"_71":78,"_72":79},{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":31,"_72":73},"slug","name","临床进展","adc","ADC 与偶联药物","rare-disease","罕见病","oncology","肿瘤",{"_81":82,"_13":83},"publicId","3a8c2d7d-032c-4c36-b1a5-9b037c96a132","翰森制药HS-20093骨肉瘤III期达PFS主要终点","ADC","翰森制药","GSK","https://www.hansoh.cn/news/news-detail-514100.htm","翰森制药·公司新闻",{"_90":91,"_92":-5,"_93":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
