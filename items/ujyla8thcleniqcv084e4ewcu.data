[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408366000,"id","ujyla8thcleniqcv084e4ewcu","title","2026年医保目录新增107种药品，含51个1类新药","originalTitle","2026医保目录，新增107种，其中51个1类新药","summary","国家医保局、人社部发布2026年版国家医保药品目录及商保创新药品目录，本次共新增107种药品，其中51个为1类创新药。新增品种覆盖肿瘤、罕见病、慢性病、精神疾病等领域，同时调出34种临床价值有限或有更好替代方案的药品。调整后目录药品总数达3331个，其中西药1935个、中成药1396个。","reason","source",{"_69":81},"links",{"_59":80},"publishedAt","2026-11-14T03:04:42.000Z","discoveredAt","2026-11-16T01:00:45.071Z","timelineAt","category","policy","tags",[77,78,79],"score",82,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fXb5ibrzwy6g","reportCount",6,"additionalSourceCount",1,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","insurance","医保与集采",{"_74":75,"_13":76},"publicId","36976c37-63b5-4f49-aaeb-20cada1484ae","2026年医保目录新增107种药品，商保创新药目录扩至28种","政策/监管","医保/集采","国家医保局","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699679&idx=1&sn=1b970cc8ce1381c2d937022d85449ac0&chksm=bc69fe3ab4c88cb6260da4780b7800281e1e64fc8891c36c8361d0cb78d199f9d222f92fb1c9&scene=126&sessionid=1794790832#rd","医药云端工作室",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
