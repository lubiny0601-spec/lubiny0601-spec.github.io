[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888174000,"id","ajg1icbo32h8b9jv1io8zbzrc","title","BMC Psychiatry系统综述：重度抑郁症血液标志物单一分子难复现，多组学模型仅内部验证，血液检测目前更适用于患者分层而非诊断","originalTitle","“抽血查抑郁”离我们还有多远？BMC Psychiatry：单一标志物难复现，多组学模型仅内部验证，血液检测目前更适用于患者分层而非诊断","summary","一项发表于BMC Psychiatry的系统综述纳入25项研究、24套独立受试者数据集，梳理重度抑郁症血液分子标志物证据，发现难以找到可在不同人群稳定复现的单一标志物，但免疫-干扰素、核因子κB、线粒体能量代谢等通路层面分子改变在多项独立研究中一致。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T05:13:21.588Z","timelineAt","category","research","tags",[78,79],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fJ6Mqtwi_Rxs","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","neuroscience","神经与精神",{"_75":76,"_13":77},"publicId","522792e8-9609-4fb1-8045-e38e03a40cd5","抑郁症血液标志物综述：单一分子难复现","论文/研究","神经/精神","https://news.bioon.com/article/e025962012b3.html","生物谷",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
