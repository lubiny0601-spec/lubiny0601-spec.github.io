[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443791000,"id","bwc0r3rta6bpb7jiylo965ksl","title","药企如何借AI抢抖音营销红利？12月成都实战工作坊","originalTitle","抖音火爆，药企红利咋抢到","summary","针对药企使用AI工具多停留在浅层次试用、难出业务结果的问题，12月12-13日在成都举办抖音医药内容合规投放转化与AI技能人机协作实战工作坊。工作坊带企业用现成AI工具包结合自家产品现场实操，当堂产出短视频脚本、种草图文与千川投放文案初稿，并给出修改优化方向。","reason","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-23T03:22:45.000Z","discoveredAt","2026-11-23T04:31:03.082Z","timelineAt","category","opinion","tags",[75],"score",8,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","frNS080eAC2o","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","opinions","name","观点与解读",{"_72":73,"_13":74},"publicId","d46d048c-8cde-4fd0-98ca-cd8a7f0c4d73","药企AI抖音营销实战工作坊12月成都开班","观点/解读","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653671530&idx=1&sn=cc53b2ff4f7303f5178f67393ccfa565&chksm=bc235d34d500c44cfd7a7df2bfe4ad57b6181be5646c6720820a0386a71a0a6e1b51133a1b82&scene=126&sessionid=1795408256#rd","赛柏蓝",{"_79":80,"_81":-5,"_82":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
