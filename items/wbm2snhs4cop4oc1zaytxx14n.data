[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794205945000,"id","wbm2snhs4cop4oc1zaytxx14n","title","熙源安健两项偏头痛临床前项目授权艾伯维，潜在总额最高7.57亿美元","originalTitle","7.57亿美元！熙源安健偏头痛管线出海艾伯维","summary","熙源安健公布与艾伯维独家授权合作进展，两项偏头痛临床前项目的潜在交易总价值最高可达7.57亿美元，另加未来产品销售分成。协议于2024年签署，熙源安健负责药物发现，艾伯维主导全球开发与商业化；两个项目的名称、靶点、技术模态及首付款、分成比例均未披露。","reason","协议2024年签署、如今披露进展，可看清两项偏头痛临床前项目的授权结构与里程碑上限。","source",{"_73":86},"links",{"_61":85},"publishedAt","2026-11-03T01:55:20.000Z","discoveredAt","2026-11-03T15:25:06.698Z","timelineAt","category","industry","tags",[83,84,78],"score",56,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","yian","body","outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fOdT86US-Sqc","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","deals","name","交易与授权","neuroscience","神经与精神","abbvie","艾伯维",{"_80":81,"_13":82},"publicId","a3647731-9b81-41b8-b667-ff8ff1290243","熙源安健两项偏头痛项目授权艾伯维","交易/授权","神经/精神","https://www.drugtimes.cn/2026/11/03/757yimeiyuanxiyuananjianpiantoutongguanxianchuhaiaibowei/","药时代",{"_88":89,"_90":-5,"_91":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
