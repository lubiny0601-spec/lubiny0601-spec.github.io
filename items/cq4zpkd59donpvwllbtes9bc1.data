[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795410152000,"id","cq4zpkd59donpvwllbtes9bc1","title","广东明确第十二批国家集采首年采购周期为2026年11月30日至2027年11月29日","originalTitle","关于做好第十二批国家组织药品集中采购有关准备工作的通知","summary","广东省药品交易中心发布通知，第十二批国家集采首年采购周期为2026年11月30日至2027年11月29日，中选企业即日起在广东招采子系统维护配送关系，医疗机构与中选企业可查看约定采购量。与广东联盟双氯芬酸等药品接续采购、常见病慢性病药品接续采购、易短缺和急抢救药联盟集采存在重复的品种，自本次集采结果执行之日起按国家集采结果执行并重新签订购销合同，各采购平台关闭原历史购销合同采购下单功能。","reason","省级落地通知明确了第十二批国家集采首年采购周期与配送、备货要求，涉及与省采重叠品种的合同切换。","source",{"_70":82},"links",{"_60":81},"publishedAt","2026-11-11T16:00:00.000Z","discoveredAt","2026-11-12T14:18:49.567Z","timelineAt","category","policy","tags",[78,79,80],"score",62,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fBDOhg5OrrM0","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","政策与监管","insurance","医保与集采",{"_75":76,"_13":77},"publicId","c2549607-0747-4635-8121-bc3db0d26ef9","广东启动第十二批国家集采配送准备","政策/监管","医保/集采","国家医保局","https://www.gdmede.com.cn/announcement/announcement/detail?id=2120795759115767808","广东省药品交易中心·通知公告",{"_84":85,"_86":-5,"_87":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
