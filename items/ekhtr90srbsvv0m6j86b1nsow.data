[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384582000,"id","ekhtr90srbsvv0m6j86b1nsow","title","10月9个新药未被批准，沙库巴曲缬沙坦钠片3家企业未过评","originalTitle","9个新药未被批准","summary","10月共9个新药审评未获批准，另有5个新药补充申请未通过。未获批品种中沙库巴曲缬沙坦钠片涉及3家企业，数量最多；上海合全医药、印度西普拉、白云山东泰商丘药业各有2个品种未获批准。当月整体批准率为93.34%，1561个受理号完成审评审批。","reason","source",{"_61":67},"links",{"_57":66},"publishedAt","2026-11-07T12:15:14.000Z","discoveredAt","2026-11-09T06:32:48.119Z","timelineAt","category","approval","tags",[62,63,64,65],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_59":60,"_61":62},"slug","approvals","name","获批上市","NMPA","其他","鲁抗医药","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669765&idx=4&sn=c4f43955e16210a8450080824b960f62&chksm=bceb85b3fafdbe49da9803d5279fc94a4573961217fa32d3b82e58c95c070796c3e1741caf9b&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_69":70,"_71":-5,"_72":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
