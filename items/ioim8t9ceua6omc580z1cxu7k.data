[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793888183000,"id","ioim8t9ceua6omc580z1cxu7k","title","COVID-19住院患者更易发生医疗相关感染：CLABSI、CAUTI与MRSA菌血症发生率显著升高","originalTitle","COVID-19 Patients Are More Susceptible to Health Care-Associated Infections","summary","一项发表于JAMA Network Open的回顾性横断面研究显示，COVID-19住院患者的医疗相关感染发生率显著高于非COVID-19住院患者。研究纳入182家社区医院近500万例患者（其中313200例为COVID-19住院患者），COVID-19患者CLABSI发生率约为非COVID-19患者的4倍，CAUTI为2.7倍，MRSA菌血症为3倍。","reason","source",{"_63":76},"links",{"_57":75},"publishedAt","2023-05-01T15:30:52.181Z","discoveredAt","2026-10-28T01:14:48.498Z","timelineAt","category","research","tags",[69,70,71,72,73,74],"score",27,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","infectious","感染与疫苗","论文/研究","耐药与院感","感染/疫苗","抗感染","循证指南","对市场","https://www.contagionlive.com/view/covid-19-patients-are-more-susceptible-to-health-care-associated-infections","Contagion Live·医院感染",{"_78":79,"_80":-5,"_81":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
