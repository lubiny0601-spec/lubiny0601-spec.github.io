[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205954000,"id","wierhc2s1rvizc0yroq1tav69","title","Leapfrog 报告：92% 医院在 3 类医疗相关感染中至少 1 项改善","originalTitle","92% of Hospitals See Decrease in 3 Health Care-Associated Infections","summary","Leapfrog Group 春季 2024 医院安全评级报告显示，CLABSI 下降 34%、CAUTI 下降 30%、MRSA 下降 30%，自 2022 年秋季以来 92% 医院在至少 1 项上述可预防感染上有所改善。报告对近 3000 家综合医院给出 A–F 评级，并首次按都市区发布排名，Utah 以 57.7% 的 A 级医院占比连续第二个周期居州榜首。","reason","source",{"_62":72},"links",{"_57":71},"publishedAt","2024-05-03T15:28:44.765Z","discoveredAt","2026-10-27T15:41:44.957Z","timelineAt","category","research","tags",[66,67,68,69,70],"score",18,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","论文/研究","耐药与院感","抗感染","循证指南","对市场","https://www.contagionlive.com/view/92-of-hospitals-see-decrease-in-3-health-care-associated-infections","Contagion Live·医院感染",{"_74":75,"_76":-5,"_77":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
