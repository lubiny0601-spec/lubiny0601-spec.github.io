[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791103000,"id","hjn57nvcgn3h4t8bnpwxwdnjg","title","山东淄博推行18位床位编码数字化管理，强化医保协议管理与基金监管","originalTitle","【山东】山东淄博创新床位编码数字化管理 提升协议管理精细化水平","summary","山东淄博医保部门以18位唯一床位编码搭建全域床位信息化管理体系，未完成编码入库的床位不予医保结算，并在入院登记环节强制校验床位编码。选取9家不同级别、性质医疗机构开展编码结算拦截强校验试点，对无效、未备案、虚假床位编码刚性拦截。全市住院次均费用由9532.26元降至9003.65元，降幅5.55%；今年上半年住院率同比下降0.79%，住院人次、住院费用分别同比下降10.5%、6.62%。","reason","source",{"_69":79},"links",{"_59":80},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-12T14:18:53.213Z","timelineAt","category","policy","tags",[77,78,79],"score",22,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fC9WKdlGyrcg","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","insurance","医保与集采",{"_74":75,"_13":76},"publicId","5e55f323-53b7-402b-a4e5-0671c64a7925","淄博医保推行住院床位18位编码管理","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/5/art_14_23303.html",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
