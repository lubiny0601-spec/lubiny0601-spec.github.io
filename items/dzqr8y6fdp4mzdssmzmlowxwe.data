[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1793889545000,"id","dzqr8y6fdp4mzdssmzmlowxwe","title","福建医保药品单列门诊统筹支付管理办法施行，明确目录准入与调出规则","originalTitle","福建：国谈单列门诊统筹支付政策有变，目录如何准入？与广东单独支付有何不同？","summary","福建省医保局10月30日印发《福建省医保药品单列门诊统筹支付管理办法》（闽医保规〔2026〕3号），自2026年11月1日施行、有效期五年，替代原试行版本。药品纳入单列支付目录需同时满足四项条件：属于协议期内或已转常规目录的国谈药品、竞价药品；适合门诊治疗；适应症未被现有门诊特殊病种政策完全覆盖；疗程达12周及以上或年度治疗费用偏高。","reason","福建新版单列门诊统筹办法给出四项准入硬条件与80%/60%报销比例，可与广东单独支付口径对照。","source",{"_71":85},"links",{"_61":84},"publishedAt","2026-11-02T09:40:38.000Z","discoveredAt","2026-11-02T13:59:10.847Z","timelineAt","category","policy","tags",[79,80,81,82,83],"score",70,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","点苍鹤","body","outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fh4FfJo_wDpE","reportCount",1,"additionalSourceCount",0,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","政策与监管","insurance","医保与集采",{"_76":77,"_13":78},"publicId","bb774143-54f2-4ea2-b643-f91e9b330371","福建施行单列门诊统筹支付管理办法","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699453&idx=1&sn=ab85bb7b69202a9b54f9b9bf5e7bd7e8&chksm=bcb1245cbe1b264572e30044905e868a585eb826c0b37f0f4c09a9b8666bb3fceb7939ae7f22&scene=126&sessionid=1793627945#rd","医药云端工作室",{"_87":88,"_89":-5,"_90":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
