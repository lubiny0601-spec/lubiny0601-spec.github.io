[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795408365000,"id","xe6p2t5pwanrdyy97v6a61rof","title","2026年以来8个全国性、6个地方性医药学协会撤销66个分支机构","originalTitle","大清理来了！66个医药学协会分支机构被撤销","summary","2026年以来，已有8个全国性学协会和6个地方性学协会撤销分支机构，涉及数量达66个。文章进一步讨论这些分支机构能否独立办会、收费和管理资金，以及药企以往的学术合作模式将面临哪些变化。","reason","材料梳理了今年全国性与地方性医药学协会撤销分支机构的数量分布，读者可据此了解学术合作合规环境的变化。","source",{"_71":80},"links",{"_60":79},"publishedAt","2026-11-11T03:13:25.000Z","discoveredAt","2026-11-11T08:15:55.648Z","timelineAt","category","policy","tags",[78,72],"score",58,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fexEDx-Sl4LE","reportCount",1,"additionalSourceCount",0,{"_69":31,"_71":73},{"_69":70,"_71":72},"slug","trends","name","行业趋势","政策与监管",{"_75":76,"_13":77},"publicId","eef2ce5e-a0a1-40f6-89af-0e553a17eb34","医药学协会今年撤销66个分支机构","政策/监管","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670213&idx=1&sn=bc645bf53371adb61f86e6f7da32299e&chksm=bce8acb9b7743e95452ab9abd2843ce573854f0e13c3c192d0fc9ec1ad23cdde075d5d44a573&scene=126&sessionid=1794384945#rd","赛柏蓝",{"_82":83,"_84":-5,"_85":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
