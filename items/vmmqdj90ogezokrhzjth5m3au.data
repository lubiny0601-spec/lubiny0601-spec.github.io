[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794205945000,"id","vmmqdj90ogezokrhzjth5m3au","title","税务局眼中的药企合规：从丹娜生物、和治药业、康希诺案例看研发、销售与财务要求","originalTitle","税务局眼中的药企合规，长什么样子？| 合规案例","summary","国家税务总局公众号转载《中国税务报》报道，把天津丹娜生物、和治药业、敬业精细化工、康希诺的税务做法作为正面典型，呈现税务系统对药企合规的判断框架。丹娜生物为每个研发项目分配唯一编码并建独立辅助账，2025年缴税超3500万元、享受研发加扣约2890万元，连续八年A级纳税人；和治药业要求无合同不排产不发货，票面与合同对不上一律退回重开，款项走对公账户并逐笔对账。","reason","从税务系统公开报道的几家药企做法，拆解研发加扣、销售费用与纳税信用三处合规门槛的变化。","source",{"_64":71},"links",{"_59":70},"publishedAt","2026-10-31T01:06:38.000Z","discoveredAt","2026-10-31T03:04:24.617Z","timelineAt","category","opinion","tags",[68,69],"score",47,"selected",true,"channel","news","story","x","readingMode","full","author","点苍鹤","body","outline",[],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","opinions","name","观点与解读","policy","政策与监管","观点/解读","政策/监管","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699440&idx=1&sn=41a9d025ad09ef7851b8b471b54ab6fe&chksm=bcb1a32422a0804afcf26784bc6d9133fd4749438a823e788c70f292e60739e7a3aa6234859e&scene=126&sessionid=1793415858#rd","医药云端工作室",{"_73":74,"_75":-5,"_76":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
