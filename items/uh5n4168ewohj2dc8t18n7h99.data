[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795410125000,"id","uh5n4168ewohj2dc8t18n7h99","title","2款中成药出事、25家涉商业贿赂案企业被点名、64个品种集采结果出炉，恒瑞入选福布斯中国创新力企业50强","originalTitle","2款中成药出事了！25家涉商业贿赂案企业被点名，64个品种集采结果出炉，恒瑞厉害了","summary","2026版国家医保目录新增107个药品，成功率86%，含51个1类创新药；12个药品进入商保创新药品目录。云南省第二批省内药品集中带量联动采购拟中选64个品种，以注射剂为主，齐鲁、石四药、南京正大天晴、丽珠医药等有多个品种拟中选。四川省点名25家涉医药商业贿赂案配送企业，需7日内完成涉案生产企业及产品指认，逾期暂停采购平台交易账号。","reason","source",{"_64":82},"links",{"_57":81},"publishedAt","2026-11-22T11:08:04.000Z","discoveredAt","2026-11-23T04:31:12.457Z","timelineAt","category","industry","tags",[65,72,73,71,74,75,76,77,78,79,80],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":70,"_64":71},{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","trends","name","行业趋势","policy","政策与监管","insurance","医保与集采","hengrui","恒瑞医药","政策/监管","医保/集采","信达生物","科伦药业","翰森制药","抗感染","市场准入","国家医保局","NMPA","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653671478&idx=2&sn=5182305c2b4a7ff217b18a336c208cdb&chksm=bcfad7076ca858afdc0f84bc15cb85705ab973d3c17c6b4ae933eccbcd0c44bb3b3aa608d3b0&scene=126&sessionid=1795408256#rd","赛柏蓝",{"_84":85,"_86":-5,"_87":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
