[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795443790000,"id","mjg60i7hl3xyqar2eplnyovke","title","中国流感监测周报第935期：北方阳性率上升，A(H1N1)pdm09占56.2%","originalTitle","2026年第46周第935期中国流感监测周报","summary","截至2026年11月15日的一周，南方省份流感病毒检测阳性率略有下降，北方省份上升，全国检出阳性样本中A(H1N1)pdm09占56.2%、A(H3N2)占15.5%、B(Victoria)系占28.3%，共报告144起流感样病例暴发疫情。","reason","周报给出南北省份阳性率分化、毒株构成与神经氨酸酶抑制剂敏感性数据，可作为流感季用药与备货的参考。","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-11-19T00:00:00.000Z","discoveredAt","2026-11-23T04:25:01.791Z","timelineAt","category","policy","tags",[66,67],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","infectious","感染与疫苗","政策/监管","感染/疫苗","https://www.chinacdc.cn/jksj/jksj04_14249/202611/t20261119_1843085.html","中国疾控·流感监测周报",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
