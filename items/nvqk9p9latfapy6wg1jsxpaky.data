[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794791091000,"id","nvqk9p9latfapy6wg1jsxpaky","title","中日医院CTEPH多学科团队13小时手术救治武汉大学中南医院重症医学科副主任饶歆","originalTitle","医生倒在手术台上，13小时生死营救：中日医院CTEPH团队全力相搏，不负同道性命相托","summary","武汉大学中南医院重症医学科副主任饶歆因慢性血栓栓塞性肺动脉高压接受肺动脉血栓内膜剥脱术，中日医院CTEPH多学科团队将整套围术期体系带到当地，甄雅南教授主刀，在深低温停循环下连续奋战13小时完成手术。术后其肺动脉恢复通畅、肺动脉高压完全恢复正常，已重返工作岗位。","reason","source",{"_71":82},"links",{"_60":81},"publishedAt","2026-11-12T14:11:11.000Z","discoveredAt","2026-11-12T14:30:55.493Z","timelineAt","category","industry","tags",[79,74,80],"score",15,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","张竹","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","f5NupgnZIjq4","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","device-ivd","name","医疗器械与 IVD","cardiovascular","心血管",{"_76":77,"_13":78},"publicId","cc794d8d-ee53-44cc-a976-719bd4093ed7","中日医院团队为同行医生完成肺动脉内膜剥脱术","其他","医疗器械/IVD","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604792&idx=2&sn=111acc94991d681657ef005fdc276fcd&chksm=fc839730f464585aac918c04706775053a7bc1cb2c2ef842c1ba94d283aa15dee8d8ddda8f48&scene=126&sessionid=1794493844#rd","呼吸界",{"_84":85,"_86":-5,"_87":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
