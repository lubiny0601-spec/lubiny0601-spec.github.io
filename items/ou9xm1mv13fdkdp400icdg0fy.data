[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794791088000,"id","ou9xm1mv13fdkdp400icdg0fy","title","中国药师协会撤销两个分支机构，年内已有66个医药学协会分支机构被撤销","originalTitle","整顿潮来了，66个医药学协会分支机构被撤销","summary","中国药师协会公告撤销精准药学工作委员会、药学服务胜任力培养与评价工作委员会，自公告发布之日起停止一切业务活动。据赛柏蓝不完全统计，2026年以来已有8个全国性学协会、6个地方性学协会撤销分支机构，数量达66个，原因包括长期未开展活动、专业领域交叉重叠、不符合规范化管理要求等。","reason","梳理学协会分支机构撤销的监管依据与数量，并给出药企审核合作对象、合同与资金流向的具体应对。","source",{"_64":69},"links",{"_59":68},"publishedAt","2026-11-10T11:54:18.000Z","discoveredAt","2026-11-11T08:16:06.288Z","timelineAt","category","policy","tags",[67,65],"score",60,"selected",true,"channel","news","story","x","readingMode","full","author","晓琳","body","outline",[],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":31,"_64":66},{"_62":63,"_64":65},"slug","trends","name","行业趋势","政策与监管","政策/监管","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670067&idx=1&sn=ee5f4621cfabc255fd7d781c6e3bd7ce&chksm=bcc287e3528ed5fbef1aa23e0ee4065092d8ad6cf6873354fed5031f877e76a7e37cc4a531a3&scene=126&sessionid=1794384945#rd","赛柏蓝",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
