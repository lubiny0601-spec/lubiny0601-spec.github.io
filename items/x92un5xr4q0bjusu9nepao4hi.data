[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795443809000,"id","x92un5xr4q0bjusu9nepao4hi","title","新版双目录发布：基本医保目录新增107种药品，商保创新药目录累计28种","originalTitle","新版“双目录”发布:基本医保目录新增107种药品 商保创新药累计达28种 2款商保创新药转化进入新版基本医保目录","summary","11月14日发布的2026版基本医保目录新增107种药品，含51个1类创新药，覆盖肿瘤、罕见病、精神类疾病等领域，目录累计3331种药品。商保创新药目录新增12种，累计28种，包括全球首个实体瘤CAR-T、中国首个血友病基因治疗药物等。首版商保目录中有2款创新药转入新版基本医保目录，形成商保先行探索、基本医保适时衔接的转化路径。","reason","新版双目录同时公布新增品种与商保向基本医保的转化路径，可看清创新药准入的两个通道如何衔接。","source",{"_65":79},"links",{"_58":78},"publishedAt","2026-11-14T00:00:00.000Z","discoveredAt","2026-11-16T00:55:14.820Z","timelineAt","category","policy","tags",[75,76,77,74,72,70],"score",85,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61,62,63],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_64":73,"_65":74},{"_64":71,"_65":72},{"_64":69,"_65":70},{"_64":67,"_65":68},{"_64":31,"_65":66},"slug","name","政策与监管","insurance","医保与集采","cell-gene","细胞与基因治疗","rare-disease","罕见病","oncology","肿瘤","政策/监管","医保/集采","国家医保局","https://www.cnpharm.com/c/2026-11-14/1110503.shtml","中国食品药品网·要闻",{"_81":82,"_83":-5,"_84":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
