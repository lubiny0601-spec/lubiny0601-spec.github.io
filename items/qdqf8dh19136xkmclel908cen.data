[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794205944000,"id","qdqf8dh19136xkmclel908cen","title","国家卫健委发布《罕见病目录制订工作程序（2026年版）》","originalTitle","罕见病目录，制订工作程序变了！","summary","11月4日，国家卫健委联合国家中医药局发布《罕见病目录制订工作程序（2026年版）》（国卫办医政发〔2026〕16号），替代2018版旧程序。新版新增“具备较高预防筛查、科研价值”的纳入情形，申报主体扩大至国家级行业学会或协会、民政部注册登记的相关社会组织、国家医学中心和国家临床医学研究中心等，并取消原则上不少于2年的固定更新周期，同时建立病种退出机制。","reason","新版程序放宽申报主体并新增科研价值纳入情形，药企可据此判断罕见病病种申报的路径与证据准备。","source",{"_71":81},"links",{"_61":80},"publishedAt","2026-11-04T16:00:00.000Z","discoveredAt","2026-11-05T05:15:40.712Z","timelineAt","category","policy","tags",[79,74],"score",58,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","子非鱼","body","outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fK9SfnZjz92E","reportCount",1,"additionalSourceCount",0,{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","政策与监管","rare-disease","罕见病",{"_76":77,"_13":78},"publicId","d4bc9471-b033-4e6a-808f-67e3c55bc7c7","罕见病目录制订工作程序发布新版","政策/监管","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699494&idx=2&sn=43c02651b1c838ce26d28bd0f8a73d3d&chksm=bc6298bb50c254f0caeef88d167ba52fc95a172ad1ca2feae6ffefd23c45708b9d9cfd1fed31&scene=126&sessionid=1793855733#rd","医药云端工作室",{"_83":84,"_85":-5,"_86":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
