[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795443789000,"id","xvh34j2hghg2w0s306ql5v6om","title","NMPA 批准和记黄埔医药醋酸索乐匹尼布片上市，用于 ITP 与 wAIHA","originalTitle","国家药监局批准醋酸索乐匹尼布片上市","summary","国家药监局通过优先审评审批程序批准和记黄埔医药（上海）有限公司申报的 1 类创新药醋酸索乐匹尼布片（商品名赛威珂）上市。该药适用于对既往至少一种治疗反应不佳的慢性原发免疫性血小板减少症（ITP）成人患者，以及既往至少对糖皮质激素治疗反应不佳的温抗体型自身免疫性溶血性贫血（wAIHA）成人患者。","reason","原文交代了获批的两个适应症与优先审评通道，读者可据此判断该药进入的血液罕见病治疗场景。","source",{"_73":87},"links",{"_60":86},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T11:48:45.303Z","timelineAt","category","approval","tags",[74,78,76,85],"score",62,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body","outline",[],"relatedStories",[81],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fo0-IaZqT2n8","reportCount",1,"additionalSourceCount",0,{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","approvals","name","获批上市","hematology","血液","rare-disease","罕见病","nmpa","中国 NMPA",{"_82":83,"_13":84},"publicId","3a314802-935c-4df4-a4c3-f79cd6c823d5","NMPA批准醋酸索乐匹尼布片上市","NMPA","https://www.cnpharm.com/c/2026-11-23/1111200.shtml","中国食品药品网·要闻",{"_89":90,"_91":-5,"_92":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
