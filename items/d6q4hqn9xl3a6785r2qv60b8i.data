[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795408366000,"id","d6q4hqn9xl3a6785r2qv60b8i","title","未名医药5.59亿元挂牌转让子公司及两项抗体技术；34种药品省际联盟集采启动分量","originalTitle","5.59亿元，知名药企转让资产；34种药品省际联盟集采开始分量；东阿阿胶高管有变…","summary","*ST未名拟公开挂牌转让吉林未名天人中药材科技100%股权及重组抗TNFα全人源单克隆抗体注射液、注射用重组抗CD25人鼠嵌合单克隆抗体两项药品技术，首次挂牌价按历史成本合计约5.59亿元。34种药品省际联盟集采进入约定采购量分配阶段，医药机构须在11月16日至24日完成分量，逾期未分配的量将平均分给价格最低和得分最高的中选产品。","reason","source",{"_68":94},"links",{"_57":93},"publishedAt","2026-11-14T05:35:05.000Z","discoveredAt","2026-11-16T01:03:28.234Z","timelineAt","category","industry","tags",[71,69,73,84,85,77,86,87,88,89,90,91,92],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61,62,63,64,65],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_66":82,"_68":83},{"_66":80,"_68":81},{"_66":78,"_68":79},{"_66":76,"_68":77},{"_66":74,"_68":75},{"_66":72,"_68":73},{"_66":70,"_68":71},{"_66":67,"_68":69},"slug","trends","name","行业趋势","company-news","公司动态","capital","投融资","deals","交易与授权","tcm","中药","device-ivd","医疗器械与 IVD","antibody","抗体与双抗","infectious","感染与疫苗","交易/授权","医疗器械/IVD","抗体/双抗","感染/疫苗","强生","BMS","阿斯利康","诺和诺德","华润医药","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670661&idx=2&sn=b1f4ce8f36ed768aeeea9c1a61e9e5cb&chksm=bc748040b37f46a239027b0d347e2d0bc7be9aaf161a57937a5be19bf766f9ee1722b82584a1&scene=126&sessionid=1794790858#rd","赛柏蓝",{"_96":97,"_98":-5,"_99":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
