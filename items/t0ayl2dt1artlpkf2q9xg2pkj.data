[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205964000,"id","t0ayl2dt1artlpkf2q9xg2pkj","title","湖北宜昌“三破一立”推进 DIP 季度清算改革落地","originalTitle","湖北宜昌“三破一立” 推进季度清算改革落地","summary","湖北宜昌市医保部门以“三破一立”推动 DIP 基金清算从“年清年结”转向“季度清、及时付”，2026 年 5 月底完成一季度清算，住院次均费用同比下降 5.67%，统筹基金支出同比下降 12.89%，季度清算拨付比例达 95.58%。一季度特例单议受理 973 例、通过 946 例，通过率 97.23%；事前提醒接入率 99.7%，审核拒付违规金额 439.73 万元，同比增长 389.95%。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-10-26T00:00:00.000Z","discoveredAt","2026-11-09T06:26:15.519Z","timelineAt","category","policy","tags",[65,66,67],"score",33,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/10/26/art_287_23313.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
