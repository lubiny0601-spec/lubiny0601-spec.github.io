[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795410130000,"id","zi0sdquvr8khfs5wuvg9s1o4u","title","科伦药业279项仿制药过评目录解析：产品结构与发展路径","originalTitle","从科伦仿制药过评目录，看产品结构及发展路径","summary","科伦药业截至2026年11月5日累计通过/视同通过一致性评价药品279项，覆盖抗感染、肠外营养、液体治疗、中枢神经、麻醉镇痛、肿瘤等十余个治疗领域。过评结构以注射剂为主体，粉液双室袋与肠外营养多室袋合计超140项，形成“输液底座+复杂注射剂+专科仿制”的梯度布局。过评路径已从早期补充申请存量补课切换至新3/新4类视同过评为主力，近三年过评密度与复杂度同步上升。","reason","source",{"_73":93},"links",{"_60":92},"publishedAt","2026-11-09T23:37:00.000Z","discoveredAt","2026-11-11T08:15:41.216Z","timelineAt","category","opinion","tags",[85,76,86,87,88,89,90,91],"score",42,"selected",false,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","点苍鹤","body","outline",[],"relatedStories",[81],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fj2oaxeM89_M","reportCount",1,"additionalSourceCount",0,{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","opinions","name","观点与解读","company-news","公司动态","pipeline","研发管��","antibiotics","抗菌药物与耐药",{"_82":83,"_13":84},"publicId","13b89572-8b77-4344-ba33-3cdd76c77a52","科伦药业公布279项仿制药过评目录","观点/解读","研发管线","抗菌药物","科伦药业","抗感染","企业竞争","对市场","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699529&idx=1&sn=eb3e46754733a59328c8aeb6841639a5&chksm=bc42ad5e7c14b5c541a0b0ca7b9ea317313dc10becae9212dfc1770b9844856a241561d3166a&scene=126&sessionid=1794384876#rd","医药云端工作室",{"_95":96,"_97":-5,"_98":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
