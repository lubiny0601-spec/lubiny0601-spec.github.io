[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795410124000,"id","pq7kdae3qowz09bl52lbmjsx1","title","全国药品联盟单抗类集采发布第1号公告，7个品种15个品规启动信息申报","originalTitle","集采发布公告，生物药这条线，代理商的位怎么卡","summary","11月21日，全国药品联盟集中带量采购（单克隆抗体类）发布第1号公告，7个单抗品种、15个品规进入信息申报，申报窗口为11月24日至27日。公告要求申报人具备2年以上单抗注射剂生产经验、提交不少于24个月的上市放行记录并出具知识产权承诺书。文章认为单抗集采比拼的是产能、合规与稳定供应，代理商需在接集采中选品种吃确定量、或接非集采差异化品种吃溢价之间重新选择。","reason","单抗首次成批进入联盟集采，申报门槛与代理商选品逻辑的变化是这条线最值得关注的部分。","source",{"_73":90},"links",{"_60":89},"publishedAt","2026-11-22T11:08:04.000Z","discoveredAt","2026-11-23T04:32:26.787Z","timelineAt","category","policy","tags",[84,85,86,74,87,88],"score",58,"selected",true,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body","outline",[],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","f_gdAmodYBas","reportCount",1,"additionalSourceCount",0,{"_71":78,"_73":79},{"_71":76,"_73":77},{"_71":31,"_73":75},{"_71":72,"_73":74},"slug","trends","name","行业趋势","政策与监管","insurance","医保与集采","antibody","抗体与双抗",{"_81":82,"_13":83},"publicId","00fcce17-c3a6-437e-be98-11725f266854","全国药品联盟启动单抗类集采信息申报","政策/监管","医保/集采","抗体/双抗","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653671478&idx=5&sn=996f0935c34b3b353e615c90d3ededf0&chksm=bc48d2cd546a14d31a4bf651198b84a67913c44c0250d0b97707a1d6aa61d0a34fdd546104d5&scene=126&sessionid=1795408256#rd","赛柏蓝",{"_92":93,"_94":-5,"_95":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
