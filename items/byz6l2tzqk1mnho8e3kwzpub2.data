[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795410154000,"id","byz6l2tzqk1mnho8e3kwzpub2","title","CDE公示将QLS2416注射液纳入\"关爱计划-延伸\"试点项目","originalTitle","CDE公示将QLS2416注射液纳入“关爱计划-延伸”试点项目","summary","CDE于11月11日公示将上海齐鲁制药研究中心有限公司的QLS2416注射液纳入\"关爱计划-延伸\"试点项目，拟开发适应症为系统性硬化症，公示期截至2026年11月18日。该试点依据《罕见疾病创新药物研发鼓励试点计划（\"关爱计划-延伸\"）申报指南》开展。","reason","source",{"_70":84},"links",{"_59":83},"publishedAt","2026-11-11T00:00:00.000Z","discoveredAt","2026-11-11T14:04:23.206Z","timelineAt","category","policy","tags",[80,73,81,82],"score",22,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fxsMWThoY4k8","reportCount",1,"additionalSourceCount",0,{"_69":74,"_70":75},{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","政策与监管","rare-disease","罕见病","nmpa","中国 NMPA",{"_77":78,"_13":79},"publicId","cca69beb-19fe-416a-bcc5-8741fd217084","CDE公示QLS2416注射液拟纳入关爱计划-延伸试点","政策/监管","NMPA","齐鲁制药","https://www.cnpharm.com/c/2026-11-11/1110320.shtml","中国食品药品网·要闻",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
