[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795408365000,"id","a6ngncdshkz09b067f7an5bum","title","15亿美元！礼来收购Calytrix，开发mCALR靶向双表位抗体治疗骨髓增殖性肿瘤","originalTitle","15亿美元！礼来收购Calytrix，开发骨髓增殖性肿瘤精准疗法","summary","礼来与Calytrix Bio签署最终收购协议，Calytrix股东最高可获合计15亿美元现金，含首付款及临床、监管里程碑后续款项。Calytrix核心管线为靶向突变钙网蛋白（mCALR）的双表位抗体，用于原发性血小板增多症（ET）与骨髓纤维化（MF），旨在覆盖全部突变亚型实现疾病修饰效应。","reason","source",{"_65":76},"links",{"_58":75},"publishedAt","2026-11-17T03:44:36.000Z","discoveredAt","2026-11-23T04:24:45.569Z","timelineAt","category","industry","tags",[73,70,74,72],"score",45,"selected",false,"channel","news","story","x","readingMode","full","author","永恒","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","deals","name","交易与授权","antibody","抗体与双抗","hematology","血液","lilly","礼来","交易/授权","抗体/双抗","https://www.drugtimes.cn/2026/11/17/15yimeiyuanlilaishougoucalytrixkaifagusuizengzhixingzhongliu/","药时代",{"_78":79,"_80":-5,"_81":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
