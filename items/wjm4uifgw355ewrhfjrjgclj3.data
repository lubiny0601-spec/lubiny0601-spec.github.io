[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384583000,"id","wjm4uifgw355ewrhfjrjgclj3","title","翰森制药亮相2026进博会：7款创新药商业化，瑞康立伏妥塔单抗III期PFS风险降低67%","originalTitle","翰森制药亮相2026进博会 以原研创新链接全球健康未来","summary","翰森制药在第九届进博会上展示抗肿瘤、代谢、自身免疫、中枢神经系统、抗感染五大领域创新进展，已实现7款创新药商业化，创新药与合作产品收入占比超85%。近三年与葛兰素史克、默沙东、罗氏、再生元等达成8项授权合作，累计首付款超10亿美元，总潜在交易价值超275亿美元。瑞康立伏妥塔单抗（B7-H3 ADC）在骨肉瘤取得近30年来首个阳性III期结果，疾病进展风险降低67%。","reason","source",{"_74":99},"links",{"_59":98},"publishedAt","2026-11-07T16:00:00.000Z","discoveredAt","2026-11-09T06:26:16.165Z","timelineAt","category","industry","tags",[77,75,85,90,81,91,92,93,94,95,96,97],"score",18,"selected",false,"channel","news","story",{"_87":88,"_13":89},"x","readingMode","full","author","body","outline",[],"relatedStories",[86],"topics",[66,67,68,69,70,71],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fWq2w57qTXf4","reportCount",1,"additionalSourceCount",0,{"_72":84,"_74":85},{"_72":82,"_74":83},{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","trends","name","行业趋势","company-news","公司动态","adc","ADC 与偶联药物","rare-disease","罕见病","metabolic","代谢与减重","oncology","肿瘤",{"_87":88,"_13":89},"publicId","0cb1d5df-4b84-4469-9a49-5470cc9b441f","翰森制药进博会展示7款创新药及授权合作","代谢/减重","ADC","GLP-1","翰森制药","GSK","默沙东","罗氏","再生元","https://www.hansoh.cn/news/news-detail-514104.htm","翰森制药·公司新闻",{"_101":102,"_103":-5,"_104":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
