[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384583000,"id","u70duxchekr4h815o6foai4gy","title","药械企业失信惩戒穿透联动强化，赛柏蓝11月19-20日上海举办信用修复策略实战班","originalTitle","药企失信，风险很大","summary","药械价格招采信用评价新规下修复口径显著收窄，企业一旦触发失信线索将面临挂网受限、集采禁入等经营风险。赛柏蓝定于11月19-20日在上海举办药械企业失信公示与信用修复策略实战班，覆盖失信认定、分级惩戒与全流程修复实操。课程针对收益核算、价格剔除、证据组织及主管部门沟通等自主修复难点设计整改方案与谈判策略。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-08T11:01:13.000Z","discoveredAt","2026-11-09T06:31:33.731Z","timelineAt","category","industry","tags",[72,81,82],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fJE6FQjroonU","reportCount",3,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","company-news","name","公司动态","policy","政策与监管","insurance","医保与集采",{"_78":79,"_13":80},"publicId","2ec3595b-b19f-4867-9e32-7cf71ebae95f","赛柏蓝11月上海办药企信用修复实战班","政策/监管","医保/集采","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669799&idx=5&sn=89bee0a0d9d1feb78db714a7e225f534&chksm=bca3e2c2db3a943f4f2676b0d908611766c99fcc316435da0c2becc24b69d9d4b8457f31538f&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
