[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794791091000,"id","p1k59hv8tlusgw5vsk7osqcla","title","发热胸痛9天、双肺多发结节伴空洞抗感染无效：追问装修与蟑螂窝暴露史，BALF镜检确诊肺蠊缨滴虫","originalTitle","发热胸痛9天，双肺“开花”，BALF镜检吓人一跳……若没那句关键对话，是否还能揭开这“梅雨迷踪”？丨疑案探密（212）","summary","一例56岁女性因发热胸痛9天、双肺多发结节伴空洞入院，头孢替安及阿奇霉素+头孢曲松抗感染均无效。追问发现家中装修并清理橱柜时发现蟑螂窝，支气管肺泡灌洗液镜检见大量活动滴虫，确诊蠊缨滴虫肺炎。予甲硝唑0.4g tid口服，3天后体温恢复正常，约1个月后复查CT病灶显著吸收、BALF镜检转阴。","reason","source",{"_70":80},"links",{"_60":79},"publishedAt","2026-11-11T11:05:00.000Z","discoveredAt","2026-11-12T14:31:01.821Z","timelineAt","category","clinical","tags",[71,78],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","葛晓晓 葛海燕","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fZjxbwdxILsU","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","临床进展","infectious","感染与疫苗",{"_75":76,"_13":77},"publicId","86d5bbd3-c4be-4cb2-bae9-862557f1548d","华东医院报告肺蠊缨滴虫感染病例","感染/疫苗","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604714&idx=1&sn=71c9a9dec928d6542909949d5f9b9bbd&chksm=fcea311d9bcf81295a2122a621af69380449590562610987534cbd8f9a29baaa5aaad5e337e0&scene=126&sessionid=1794493844#rd","呼吸界",{"_82":83,"_84":-5,"_85":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
