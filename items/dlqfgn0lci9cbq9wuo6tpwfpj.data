[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795408365000,"id","dlqfgn0lci9cbq9wuo6tpwfpj","title","泰格医药拟出售方达控股控制权，剥离海外实验室业务","originalTitle","泰格医药，要卖部分海外业务了","summary","泰格医药11月10日公告，拟出售子公司方达控股控制权并剥离其海外实验室业务。香港泰格将与查尔斯河（CRL）、方达控股董事会主席李松博士及相关信托共同推进方达私有化、退出港股上市，再分拆业务由各方分别承接；私有化以共同设立的SanRex为收购主体，每股注销价2.37港元，较10月21日收盘价溢价约59.1%。交易完成后泰格医药及香港泰格不再持有方达股份，但仍持有拆分后保留的业务。","reason","交易结构分私有化与业务分拆两步，读者可据此看清泰格医药如何调整海外实验室资产。","source",{"_72":85},"links",{"_60":84},"publishedAt","2026-11-11T04:07:52.000Z","discoveredAt","2026-11-11T08:15:53.259Z","timelineAt","category","industry","tags",[82,83,73],"score",58,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fyBAIH9uEUfE","reportCount",2,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","company-news","name","公司动态","deals","交易与授权","cxo","CXO 与外包",{"_79":80,"_13":81},"publicId","697827ca-d42a-4973-94d4-734e5a7e38d7","泰格医药拟出售方达控股控制权","交易/授权","CXO","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670239&idx=1&sn=370c061360176f0269ef86b445a81470&chksm=bcac0cbca4d36b4b16e47ae37f6fd6f48a2bdabe2f9764d4b77d9333f36775869e782cfb7d81&scene=126&sessionid=1794384945#rd","赛柏蓝",{"_87":88,"_89":-5,"_90":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
