[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795410128000,"id","kozyb578k8ri1imsu0bai0kzh","title","2026年世界提高抗微生物药物认识周：同一健康，同一行动，立即预防耐药","originalTitle","同一健康，同一行动：立即预防耐药丨2026年世界提高抗微生物药物认识周","summary","2026年世界提高抗微生物药物耐药性认识周（WAAW）于11月18—24日举行，主题为「同一健康，同一行动：立即预防耐药」，呼吁人类、动物、植物与环境各领域利益相关方各承诺一项具体行动。细菌性AMR每年已与逾470万例死亡相关；若不采取紧急行动，2025—2050年间AMR可能导致多达3900万人死亡，并在2035年前给全球经济造成7.7万亿美元损失。","reason","source",{"_62":74},"links",{"_58":73},"publishedAt","2026-11-16T02:07:54.000Z","discoveredAt","2026-11-23T04:32:50.066Z","timelineAt","category","policy","tags",[66,67,68,69,70,71,72],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","网络综合","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":64,"_62":65},{"_61":30,"_62":63},"slug","name","政策与监管","antibiotics","抗菌药物与耐药","政策/监管","抗菌药物","耐药与院感","抗感染","疫情监测","对市场","对准入","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200678&idx=1&sn=ec509ebae97711c8ab9537b5d25a2b3f&chksm=82a29e02ec92166d5c96ae7c51e67ab909301d409d71a9443008e1e1fa18509c64e41b28b74a&scene=126&sessionid=1795408256#rd","SIFIC 感染视界",{"_76":77,"_78":-5,"_79":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
