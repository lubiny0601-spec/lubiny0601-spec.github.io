[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794384583000,"id","m5lc3xveu4yjejqeh01mhvktr","title","从诺华pelacarsen与诺和诺德IL-6靶向药心脏试验失败看AI hype为何该被质疑","originalTitle","STAT+: Why the latest heart drug failures should make us all more skeptical of AI hype","summary","美国心脏协会年会上公布的两项研究显示，诺华pelacarsen虽降低血中Lp(a)水平，却对心脏病发作和卒中发生率无影响；诺和诺德靶向IL-6的抗炎药大型研究同样未显示获益。这两次失败表明，被寄望加速新药问世的遗传学与新技术一再落空，对AI等新技术的疗效宣称应保持怀疑。","reason","source",{"_72":86},"links",{"_60":85},"publishedAt","2026-11-08T09:30:00.000Z","discoveredAt","2026-11-09T06:26:05.078Z","timelineAt","category","opinion","tags",[82,77,83,84,73],"score",22,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","Matthew Herper","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fth08SNrijx8","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","trends","name","行业趋势","opinions","观点与解读","cardiovascular","心血管",{"_79":80,"_13":81},"publicId","c82aa9f2-9263-4442-a666-634ec50d46ce","两项心脏试验失败：降Lp(a)与抗炎均未减少心血管事件","观点/解读","诺华","诺和诺德","https://www.statnews.com/2026/11/08/heart-drug-failures-lessons-for-artificial-intelligence-from-aha-conference/?utm_campaign=rss","STAT",{"_88":89,"_90":-5,"_91":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
