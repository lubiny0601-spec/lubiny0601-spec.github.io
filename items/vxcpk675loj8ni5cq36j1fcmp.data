[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795443789000,"id","vxcpk675loj8ni5cq36j1fcmp","title","上海药事所发布2026年第四季度集采中选药品续签通知，12月20日执行","originalTitle","[11-23]关于2026年第四季度集采中选药品续签的通知","summary","上海市医药集中招标采购事务管理所发布通知，对采购协议期满并完成约定采购量的部分集采中选药品，与中选企业及其指定配送企业续签购销三方协议，通知于2026年12月20日执行。具体续签品种见附件《2026年第四季度集采中选药品续签信息表》，医疗机构在带量采购中选药品采购中发现问题需及时向市药事所反馈。","reason","上海药事所对四季度到期的集采中选药品启动三方协议续签，涉及品种与执行时间以附件信息表为准。","source",{"_70":83},"links",{"_60":82},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T12:26:30.207Z","timelineAt","category","policy","tags",[78,79,80,81],"score",58,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fnNLdd5QAipo","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","政策与监管","insurance","医保与集采",{"_75":76,"_13":77},"publicId","6bd58ac2-dae8-4aa0-a660-2a4eab43adf4","上海药事所发布第四季度集采药品续签通知","政策/监管","医保/集采","抗感染","市场准入","https://www.smpaa.cn/xxgk/gggs/2026/11/23/26314.shtml","上海阳光医药采购网",{"_85":86,"_87":-5,"_88":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
