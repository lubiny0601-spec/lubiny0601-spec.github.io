[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443791000,"id","vp0vr02ehl9bvzqr7k7iv10zi","title","上海交通大学李慧/周斌兵团队揭示嘌呤代谢物积累经TUFM-RHEB轴抑制mTORC1","originalTitle","Cell Death & Differ：嘌呤堆太多也会\"踩刹车\"，上海交通大学李慧/周斌兵发现代谢物过剩反向关闭生长主开关","summary","上海交通大学李慧和周斌兵团队在 Cell Death & Differentiation 发表研究，以PRPS1功能获得性突变为嘌呤积累模型，发现升高的嘌呤尤其是脱氧鸟苷（dG）抑制mTORC1信号。机制上，dG促进RHEB在Ser130位点磷酸化，触发TUFM与鸟嘌呤核苷酸从RHEB解离，使RHEB失活。抑制XDH/XO时也观察到类似的mTORC1抑制和TUFM结合丢失。","reason","source",{"_71":83},"links",{"_59":82},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T07:25:14.879Z","timelineAt","category","research","tags",[81,76,74],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fNhGuOnc_Gec","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","small-molecule","小分子","oncology","肿瘤",{"_78":79,"_13":80},"publicId","3fbf1e80-6810-4967-9fbb-2c9dcbfd03c6","嘌呤积累经TUFM-RHEB轴抑制mTORC1","论文/研究","https://news.bioon.com/article/097496529e7f.html","生物谷",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
