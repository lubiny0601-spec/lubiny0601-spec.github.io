[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793889569000,"id","c2bhhd1ngeqa8p394kevmuzc7","title","FDA 批准首个 Climara Pro 仿制药：雌二醇/左炔诺孕酮每周一次透皮贴片","originalTitle","FDA Approves Once-Weekly Generic Hormone Therapy Patch for Women","summary","FDA 批准 Zydus Pharmaceuticals 的雌二醇/左炔诺孕酮透皮贴片（0.045 mg/日/0.015 mg），为 Climara Pro 的首个仿制药，每周给药一次。该贴片适用于子宫完整的女性，用于治疗绝经所致中重度血管舒缩症状及预防绝经后骨质疏松，含雌激素与孕激素复方。","reason","source",{"_63":68},"links",{"_58":67},"publishedAt","2026-10-20T15:57:36.000Z","discoveredAt","2026-10-27T13:29:42.845Z","timelineAt","category","approval","tags",[64,44],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","FDA","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","approvals","name","获批上市","fda","美国 FDA","http://www.fda.gov/news-events/press-announcements/fda-approves-once-weekly-generic-hormone-therapy-patch-women","FDA 新闻稿",{"_70":71,"_72":-5,"_73":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
