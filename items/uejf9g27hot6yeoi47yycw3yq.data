[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794205946000,"id","uejf9g27hot6yeoi47yycw3yq","title","Cell：密歇根大学与哈佛团队证实穿孔素可独立诱导肿瘤细胞铁死亡，改写免疫杀伤机制认知","originalTitle","颠覆免疫学经典！Cell：AI虚拟细胞模拟肿瘤细胞，穿孔素能直接触发铁死亡，这条被漏掉的“死亡逻辑”终于补上了","summary","美国密歇根大学罗格尔癌症中心联合哈佛医学院波士顿儿童医院在 Cell 发表研究，证实穿孔素（Prf1）不依赖颗粒酶 A/B 即可直接诱导肿瘤细胞铁死亡。机制上，穿孔素在肿瘤细胞膜成孔后触发转铁蛋白受体（TFR/CD71）内吞，促进内体-线粒体接触位点形成，导致线粒体铁过载与脂质过氧化物堆积。","reason","source",{"_71":83},"links",{"_59":82},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-09T06:26:04.660Z","timelineAt","category","research","tags",[81,76,74],"score",14,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fZ3Ge67ierzY","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","cell-gene","细胞与基因治疗","oncology","肿瘤",{"_78":79,"_13":80},"publicId","75b6effc-eaff-48bf-8736-a6aeee1e84d8","Cell研究揭示穿孔素独立诱导肿瘤铁死亡","论文/研究","https://news.bioon.com/article/9afa963014fd.html","生物谷",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
