[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795408365000,"id","y59sv6s3mdt2g1iwxfvody03n","title","Isomorphic Labs完成50亿美元C轮融资，创全球AI制药单笔融资纪录","originalTitle","50亿美元！全球最大AI制药融资诞生","summary","英国AI药物研发企业Isomorphic Labs于2026年11月17日宣布完成50亿美元C轮融资，由Greenoaks与红杉资本联合领投，Alphabet追加投资，创生物医药行业单笔私募融资纪录。资金将用于迭代自研药物设计引擎IsoDDE并推进多条临床前管线，同时搭建转化医学与临床开发能力。公司聚焦肿瘤与免疫方向，管线细节尚未披露，临床前结果仅称\"前景向好\"。","reason","source",{"_64":75},"links",{"_58":74},"publishedAt","2026-11-18T06:41:42.000Z","discoveredAt","2026-11-23T04:24:45.523Z","timelineAt","category","industry","tags",[65,69,70,71,72,73],"score",26,"selected",false,"channel","news","story","x","readingMode","full","author","yian","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","capital","name","投融资","immunology","自免与炎症","oncology","肿瘤","自免","礼来","诺华","强生","https://www.drugtimes.cn/2026/11/18/50yimeiyuanquanqiuzuidaaizhiyaorongzidansheng/","药时代",{"_77":78,"_79":-5,"_80":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
