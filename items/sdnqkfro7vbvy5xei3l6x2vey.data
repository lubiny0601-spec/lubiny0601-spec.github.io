[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":55,"_56":35,"_57":58},"expiresAt",1794384595000,"id","sdnqkfro7vbvy5xei3l6x2vey","title","国家医保局发布第二十二批智能监管“两库”规则和知识点","originalTitle","summary","国家医保局发布第二十二批智能监管“两库”规则和知识点，本次公开的是“诊断与患者性别不符”规则中“泌尿生殖系统疾病”章对应的知识点明细。各省级医保部门需据此对省级医保信息平台智能监管子系统“两库”动态更新，定点医药机构可将其嵌入智能提醒系统或对接事前提醒功能模块开展自查自纠。相关知识点明细以PDF和xlsx附件形式发布。","reason","source",{"_68":78},"links",{"_58":79},"publishedAt","2026-11-04T00:00:00.000Z","discoveredAt","2026-11-05T05:13:20.373Z","timelineAt","category","policy","tags",[76,77,78],"score",22,"selected",false,"channel","news","story",{"_73":74,"_13":75},"x","readingMode","full","author","body","outline",[],"relatedStories",[72],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fT7Oiw2Xn2do","reportCount",1,"additionalSourceCount",0,{"_67":70,"_68":71},{"_67":29,"_68":69},"slug","name","政策与监管","insurance","医保与集采",{"_73":74,"_13":75},"publicId","a9490bf0-3bc9-442c-92cc-400665c6a24a","医保局发布第二十二批智能监管两库规则","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/4/art_109_23294.html",{"_81":82,"_83":-5,"_84":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
