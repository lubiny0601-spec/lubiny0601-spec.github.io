[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205953000,"id","yl5jt3q0i39t46t49z2sxqi0u","title","多重耐药淋病奈瑟菌负担加重：Zoliflodacin 能否救场？","originalTitle","The Increasing Burden of Multidrug-Resistant Neisseria Gonorrhoeae: Zoliflodacin to the Rescue?","summary","Zoliflodacin 已于 2025 年 12 月 12 日获 FDA 批准，作为单剂口服疗法用于无并发症泌尿生殖道淋病。其 III 期试验（NCT03959527）纳入 930 例受试者，比较单剂口服 3 g zoliflodacin 与头孢曲松 500 mg 肌注联合阿奇霉素 1 g 口服，主要终点为治愈访视时微生物学治愈比例，结果显示非劣效。","reason","source",{"_63":78},"links",{"_57":77},"publishedAt","2026-07-24T11:00:00.000Z","discoveredAt","2026-10-28T01:14:46.531Z","timelineAt","category","opinion","tags",[69,70,71,72,73,74,75,76],"score",40,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","opinions","name","观点与解读","antibiotics","抗菌药物与耐药","fda","美国 FDA","观点/解读","抗菌药物","耐药与院感","抗感染","循证指南","对市场","对品牌","FDA","https://www.contagionlive.com/view/the-increasing-burden-of-multidrug-resistant-neisseria-gonorrhoeae-zoliflodacin-to-the-rescue-","Contagion Live·抗菌药物管理",{"_80":81,"_82":-5,"_83":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
