[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1793888171000,"id","emr76r0kqmzedhg1d2fq4nfo4","title","江苏医保局部署第十二批国家集采中选结果落地，11月30日起全省执行","originalTitle","江苏省医疗保障局关于做好第十二批国家组织药品集中采购中选结果落地执行工作的通知（苏医保函〔2026〕121号）","summary","江苏省医保局发文部署第十二批国家集采中选结果落地，全省公立医疗机构自2026年11月30日24:00起统一执行，采购周期至2029年12月31日。中选药品按中选价挂网，曲马多注射剂、艾司唑仑口服常释剂型、吡仑帕奈口服常释剂型3个品种完成约定采购量后不再考核用量；伐昔洛韦口服常释剂型等8个品种对接执行本批中选结果，原集采结果同步停止执行。","reason","文件明确了第十二批国采在江苏的执行时间、采购周期与考核口径，涉及抗菌药物品种的落地安排。","source",{"_70":84},"links",{"_60":83},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T15:24:58.419Z","timelineAt","category","policy","tags",[78,79,80,81,82],"score",75,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","flCgCOBtOCGU","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","政策与监管","insurance","医保与集采",{"_75":76,"_13":77},"publicId","7a6910af-897c-4e43-927d-72e633773b81","江苏部署第十二批国采中选结果落地","政策/监管","医保/集采","国家医保局","抗感染","市场准入","http://ybj.jiangsu.gov.cn/art/2026/11/3/art_85482_11853913.html","江苏医保局·阳光采购服务网",{"_86":87,"_88":-5,"_89":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
