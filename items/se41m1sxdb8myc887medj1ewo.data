[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888174000,"id","se41m1sxdb8myc887medj1ewo","title","南医大 Nature Neuroscience 研究揭示帕金森病 ABCA1 胆固醇转运失衡机制，枸橼酸镁在动物模型显示神经保护作用","originalTitle","帕金森患者吃他汀，为什么临床收效有限？南医大 Nature Neuroscience：胆固醇“转运失衡”才是关键，合成抑制这条路走不通","summary","南京医科大学与南京中医药大学团队在 Nature Neuroscience 发表研究，发现帕金森病中 ABCA1 介导的胆固醇转运失衡而非合成过量是致病关键，星形胶质细胞 ABCA1 过度外排胆固醇、神经元溶酶体 ABCA1 泵入胆固醇，经 GPR155-mTORC1 通路抑制自噬，加重 α-突触核蛋白病理。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T05:13:21.603Z","timelineAt","category","research","tags",[81,82,74],"score",14,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f7GD2Wj7b2xs","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","small-molecule","小分子","neuroscience","神经与精神",{"_78":79,"_13":80},"publicId","db0cd116-ac89-4883-9adc-329027665816","南医大团队揭示ABCA1驱动帕金森神经退行","论文/研究","神经/精神","https://news.bioon.com/article/d251961851a5.html","生物谷",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
