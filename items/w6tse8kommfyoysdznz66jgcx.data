[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795410125000,"id","w6tse8kommfyoysdznz66jgcx","title","2026年三季报：医药商业陷入大洗牌，国资、民营与连锁药店加速转型","originalTitle","医药商业，陷入「大洗牌」","summary","2026年A股医药商业公司三季报显示行业形势严峻，部分企业增速放缓、增收不增利甚至扭亏为亏。国资背景企业以并购整合转型，如浙江震元增资扩股引入华润医药商业取得震元医药51%股权；民营九州通则通过九州通资本布局创新药与医疗器械。头部连锁药店业绩同比明显改善，转向提高单店坪效与客户留存。","reason","source",{"_65":80},"links",{"_58":79},"publishedAt","2026-11-22T11:08:04.000Z","discoveredAt","2026-11-23T04:31:08.980Z","timelineAt","category","industry","tags",[68,66,73,74,75,76,77,78],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","陶秋骋","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","trends","name","行业趋势","company-news","公司动态","market","市场与销售","device-ivd","医疗器械与 IVD","市场/销售","医疗器械/IVD","国药控股","上海医药","九州通","华润医药","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653671478&idx=1&sn=e239ca959428fedfc5d797c73cec681f&chksm=bca8447b00822715d0c61fab018d72ed2a6893648f2bb700f0cc91df89a4e3fe4f16a8ef2490&scene=126&sessionid=1795408256#rd","赛柏蓝",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
