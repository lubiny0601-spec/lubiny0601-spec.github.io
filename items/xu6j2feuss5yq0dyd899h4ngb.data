[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795443793000,"id","xu6j2feuss5yq0dyd899h4ngb","title","发热咳嗽先别急着用抗菌药物：呼吸道检测报告怎么看、常见呼吸道病毒与就医提示","originalTitle","发热咳嗽，先别急着用抗菌药物！呼吸道检测报告怎么看？常见的呼吸道病毒与就医提示？","summary","世界提高抗微生物药物耐药性认识周（11月18日至24日）提示，流感、新冠和普通感冒均为病毒感染，抗菌药物无法杀病毒也不能预防病毒性肺炎，国内调查显示近一半家长在家存有抗菌药物且自行用药更常见。","reason","source",{"_63":74},"links",{"_58":73},"publishedAt","2026-11-20T07:45:37.000Z","discoveredAt","2026-11-23T04:30:53.984Z","timelineAt","category","opinion","tags",[67,68,69,70,71,72],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","徐春晖  等","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","opinions","name","观点与解读","antibiotics","抗菌药物与耐药","观点/解读","抗菌药物","耐药与院感","抗感染","循证指南","对销售","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247605090&idx=2&sn=d2fd012facacbd3fd6dcef710e9c2189&chksm=fce93c76ff51a16310223fdb4c4dc2850b5fa125a21254b8e33c9edfa82ff7c3b5ba4d6f6631&scene=126&sessionid=1795408232#rd","呼吸界",{"_76":77,"_78":-5,"_79":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
