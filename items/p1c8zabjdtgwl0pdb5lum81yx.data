[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888184000,"id","p1c8zabjdtgwl0pdb5lum81yx","title","新疆推行DRG/DIP半年清算机制，14个统筹地区完成2758家医疗机构清算","originalTitle","【新疆】新疆推行DRG/DIP半年清算机制 释放医保基金使用综合效能","summary","新疆医保局统筹部署全区DRG/DIP半年清算，截至目前14个统筹地区均已完成对2758家医疗机构的半年清算，累计支付166.23亿元。2026年1-6月全区8065.25万人次享受医保待遇，医保基金支出243.86亿元。半年累计评审病例4.4万余例，医保基金支付7.66亿元，并构建\"线上双盲评审+分级审核\"闭环管理体系。","reason","source",{"_69":79},"links",{"_59":80},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T09:52:08.905Z","timelineAt","category","policy","tags",[77,78,79],"score",42,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fDfqhsxb2Izk","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","insurance","医保与集采",{"_74":75,"_13":76},"publicId","4fd2f360-c842-4018-8c3d-c3df598436fa","新疆14个统筹地区完成DRG/DIP半年清算","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/10/25/art_14_23226.html",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
