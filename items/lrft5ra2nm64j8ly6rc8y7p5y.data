[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":36,"_55":36,"_56":57,"_58":59,"_60":61},"expiresAt",1795408366000,"id","lrft5ra2nm64j8ly6rc8y7p5y","title","第二批商保创新药目录发布，纳入12款创新药","originalTitle","12款创新药！第二批商保创新药目录发布（附明细）","summary","2026年国家医保药品目录调整同步公布第二批商保创新药目录，共纳入12款创新药，承接暂不适合纳入基本医保、但临床获益突出的高价值创新药。该目录经形式审查、专家综合评审、价格测算与企业谈判确认后，于11月14日正式公布，为院外支付和商业医疗险产品设计提供统一参考清单。","reason","source",{"_71":85},"links",{"_61":84},"publishedAt","2026-11-14T02:47:02.000Z","discoveredAt","2026-11-16T01:00:48.264Z","timelineAt","category","policy","tags",[81,82,83],"score",60,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","sameEvent",{"_11":79,"_13":80},"readingMode","full","author","body","outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fXb5ibrzwy6g","reportCount",6,"additionalSourceCount",1,{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","政策与监管","insurance","医保与集采",{"_76":77,"_13":78},"publicId","36976c37-63b5-4f49-aaeb-20cada1484ae","2026年医保目录新增107种药品，商保创新药目录扩至28种","xjj8fe3psbbncixaonjtb0mc1","国家医保局发布2026版医保药品目录与第二批商保创新药目录，新增107种药品","政策/监管","医保/集采","国家医保局","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699673&idx=1&sn=7021b00a701517dfc4a3053779ceeee2&chksm=bc81b9683cbce6a200c65abf2930ff7eff067fd7c31618b7d8499fbf05f170b044d9093f58a1&scene=126&sessionid=1794790832#rd","医药云端工作室",{"_87":88,"_89":-5,"_90":36},"changelogVersion","2026-10-08T08:00","release","staticSite"]
