[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791091000,"id","m81pjlhkol5yt3ib30izkb27a","title","第12批国采11省落地：65种药品、521个产品，采购周期至2029年底","originalTitle","第12批国采11省落地，窗口在哪","summary","内蒙古、福建11月12日同日发文落实第十二批国采中选结果，明确落地时间的省份已达11个，涉及65种药品、521个产品，采购周期至2029年12月31日。各省落地节奏分梯队，早的11月28日、晚的12月1日零时，价格切换与医院备货集中在这一窗口。本轮沿用按厂牌报量，锁死的是中选品种中选价，同一通用名下未被锁死的规格和品种仍有空间。","reason","source",{"_69":83},"links",{"_59":82},"publishedAt","2026-11-12T12:00:34.000Z","discoveredAt","2026-11-12T14:31:28.659Z","timelineAt","category","policy","tags",[77,78,79,80,81],"score",40,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fqUt-hfTKvY4","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","insurance","医保与集采",{"_74":75,"_13":76},"publicId","57febbba-0ac8-4dd6-8680-7ddb2196bbc3","内蒙古、福建发文落实第十二批国采中选结果","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670466&idx=6&sn=d0f4e431ae74e4d50e8c723e36004728&chksm=bc2e330d94c8f2396674c7f944167c8e3146ba5c3379577cf70add0e0f3258499f95c8b34e65&scene=126&sessionid=1794493868#rd","赛柏蓝",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
