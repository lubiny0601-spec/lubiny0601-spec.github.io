[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888184000,"id","ii3a903ivw5tzs28r66ubg04y","title","广东“医保钱包2.0”上线：职工医保个人账户实现跨省共济","originalTitle","【广东】“医保钱包2.0”上线 广东职工医保个人账户可以跨省共济使用了","summary","“医保钱包2.0”于9月29日上线，广东作为首批省份实现职工医保个人账户从省内共济扩展至跨省共济。职工参保人可通过国家医保服务平台APP与省外参保近亲属绑定共济关系、设定共济额度，用于支付其就医购药个人负担费用或参保缴费，绑定次数和金额不限，剩余额度可返还个人账户。","reason","source",{"_69":79},"links",{"_59":80},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T09:52:08.963Z","timelineAt","category","policy","tags",[77,78,79],"score",22,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f-hbqdGjmvoc","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","insurance","医保与集采",{"_74":75,"_13":76},"publicId","b06a6c47-18df-4daf-b1fb-93b084256c9d","广东医保个账共济扩至跨省","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/10/21/art_14_23178.html",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
