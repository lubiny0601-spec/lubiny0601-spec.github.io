[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205951000,"id","jq8djspbxpe2q6bkzcmv8ra2s","title","主编评论：OMB拟议规则限制国际科研合作，无国界的感染病学科正被逐块围栏","originalTitle","Drawing Borders Around a Borderless Specialty","summary","感染病学主编Jason Gallagher撰文指出，OMB拟议的联邦拨款规则将研究资助限于国内研究者，国际合作需政治任命官员签字批准，直接威胁感染病监测网络。他举例称，辉瑞资助的ATLAS数据库已依据司法部《敏感数据批量规则》下架美国分离株，而JMI Laboratories的SENTRY项目仍可查看。该规则还将禁止用联邦拨款支付开放获取出版费用，除非获得机构批准。","reason","source",{"_64":80},"links",{"_57":79},"publishedAt","2026-09-04T12:54:56.344Z","discoveredAt","2026-10-27T15:41:44.455Z","timelineAt","category","opinion","tags",[72,73,74,75,76,77,78,71],"score",20,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":70,"_64":71},{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","opinions","name","观点与解读","policy","政策与监管","antibiotics","抗菌药物与耐药","pfizer","辉瑞","观点/解读","抗菌药物","耐药与院感","政策/监管","抗感染","循证指南","对市场","https://www.contagionlive.com/view/drawing-borders-around-a-borderless-specialty","Contagion Live·抗菌药物管理",{"_82":83,"_84":-5,"_85":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
