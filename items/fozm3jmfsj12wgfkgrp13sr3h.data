[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1793888171000,"id","fozm3jmfsj12wgfkgrp13sr3h","title","广东省药品交易中心就广东联盟阿替洛尔等药品带量联动采购文件征求意见","originalTitle","广东省药品交易中心关于征求《广东联盟阿替洛尔等药品带量联动采购文件（征求意见稿）》意见的通知","summary","广东省药品交易中心就《广东联盟阿替洛尔等药品带量联动采购文件（征求意见稿）》公开征求意见，反馈时间为2026年10月30日至11月5日17:00，需提交加盖单位鲜章的征求意见表扫描件及对应excel文档至yaopinbu@gdmede.com.cn，逾期不予受理。文件依据粤医保规〔2025〕4号起草，具体采购品种与规则见附件1。","reason","广东联盟新一轮带量联动采购进入征求意见阶段，涉及品种与报量规则尚待文件附件披露。","source",{"_70":81},"links",{"_60":80},"publishedAt","2026-10-29T16:00:00.000Z","discoveredAt","2026-10-30T11:06:56.307Z","timelineAt","category","policy","tags",[78,79],"score",58,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fgMk5Lefh1sI","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","政策与监管","insurance","医保与集采",{"_75":76,"_13":77},"publicId","de3e6cd6-631e-46d6-a698-fd8edd599125","广东联盟药品带量联动采购文件征求意见","政策/监管","医保/集采","https://www.gdmede.com.cn/announcement/announcement/detail?id=2116083198168403968","广东省药品交易中心·通知公告",{"_83":84,"_85":-5,"_86":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
