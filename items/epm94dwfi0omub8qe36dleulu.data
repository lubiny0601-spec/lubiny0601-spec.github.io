[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888188000,"id","epm94dwfi0omub8qe36dleulu","title","国家药监局批准珠海圣美生物3号/10号染色体异常细胞检测试剂盒（荧光原位杂交法）上市","originalTitle","国家药监局公布荧光原位杂交法获批上市","summary","国家药监局批准珠海圣美生物诊断技术有限公司“人类3号和10号染色体异常细胞检测试剂盒（荧光原位杂交法）”创新产品注册申请。该产品通过检测肺结节人群外周血中3号和/或10号染色体扩增异常的单个核细胞，用于胸部CT发现结节、临床无法判断是否需侵入性检查患者的肺癌辅助诊断，提供无创检查方法。","reason","source",{"_72":87},"links",{"_59":86},"publishedAt","2026-10-26T00:00:00.000Z","discoveredAt","2026-10-27T13:29:45.257Z","timelineAt","category","approval","tags",[73,84,85,77],"score",34,"selected",false,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","body","outline",[],"relatedStories",[80],"topics",[66,67,68,69],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fdky9SXUEUpk","reportCount",1,"additionalSourceCount",0,{"_70":78,"_72":79},{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","approvals","name","获批上市","device-ivd","医疗器械与 IVD","oncology","肿瘤","nmpa","中国 NMPA",{"_81":82,"_13":83},"publicId","e84a0de0-2f37-4620-afab-105dc2d68441","国家药监局批准肺结节肺癌辅助诊断试剂盒上市","医疗器械/IVD","NMPA","https://www.cnpharm.com/c/2026-10-26/1109443.shtml","中国食品药品网·要闻",{"_89":90,"_91":-5,"_92":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
