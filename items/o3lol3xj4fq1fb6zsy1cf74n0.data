[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794384581000,"id","o3lol3xj4fq1fb6zsy1cf74n0","title","百济神州前三季净利润增431.8%，全年营收指引第三次上调至463-470亿元","originalTitle","百济业绩再超预期：前三季净利润增4倍、全年营收指引第三次上调至463-470亿元","summary","百济神州2026年前三季度营收349.93亿元、同比增26.8%，归母净利润60.55亿元、同比增431.8%，全年营收指引第三次上调至463-470亿元。泽布替尼第三季度全球销售94.24亿元、同比增27%，前三季度累计255.51亿元，其中美国市场单季贡献68.16亿元。","reason","百济神州三季报显示利润主要来自泽布替尼在欧美的销售而非授权变现，可与国内其他创新药企的路径作对照。","source",{"_69":87},"links",{"_59":86},"publishedAt","2026-11-05T16:00:00.000Z","discoveredAt","2026-11-09T06:30:56.084Z","timelineAt","category","industry","tags",[70,83,82,80,78,84,85],"score",74,"selected",true,"channel","news","story","x","readingMode","full","author","药事达","body","outline",[],"relatedStories",[],"topics",[60,61,62,63,64,65,66],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_67":81,"_69":82},{"_67":79,"_69":80},{"_67":77,"_69":78},{"_67":75,"_69":76},{"_67":73,"_69":74},{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","company-news","name","公司动态","market","市场与销售","antibody","抗体与双抗","adc","ADC 与偶联药物","hematology","血液","oncology","肿瘤","beigene","百济神州","市场/销售","ADC","抗体/双抗","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699506&idx=1&sn=689eaf735290037e9470d5999e2c62ce&chksm=bc5cc63075982924804be608b3b277287e95832e4035b3039274d1bda9cee74c72f6ee5537f9&scene=126&sessionid=1794205837#rd","医药云端工作室",{"_89":90,"_91":-5,"_92":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
