[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794205945000,"id","xg9fp4f133r51ukquyzvr98hb","title","尽管诺和诺德 ziltivekimab 的 ZEUS 研究未达终点，心脏病专家仍将推进抗炎药物研发","originalTitle","STAT+: Despite Novo drug’s failure, cardiologists say they will still pursue anti-inflammatories","summary","诺和诺德 ziltivekimab（靶向 IL-6 的单克隆抗体）在 ZEUS 研究中虽降低炎症细胞因子 IL-6 水平，但未减少重症患者的心脏病发作、卒中或死亡，未达主要终点。基于此，诺和诺德已叫停 HERMES 和 ATHENA 两项试验。ZEUS 详细结果在 AHA 科学年会公布并同步发表于 NEJM，心脏病专家表示仍将继续探索抗炎药物。","reason","source",{"_72":86},"links",{"_60":85},"publishedAt","2026-11-07T14:35:00.000Z","discoveredAt","2026-11-09T06:26:05.110Z","timelineAt","category","clinical","tags",[73,77,84,79],"score",22,"selected",false,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","Elizabeth Cooney","body","outline",[],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fyWZpS5mgI7A","reportCount",1,"additionalSourceCount",0,{"_71":78,"_72":79},{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","临床进展","antibody","抗体与双抗","cardiovascular","心血管","novonordisk","诺和诺德",{"_81":82,"_13":83},"publicId","785cbf67-8934-4dfc-a9fe-06481b58ef9c","ZEUS试验结果公布：ziltivekimab未减少心血管事件","抗体/双抗","https://www.statnews.com/2026/11/07/aha-2026-conference-novo-nordisk-zeus-trial-ziltivekimab-results/?utm_campaign=rss","STAT",{"_88":89,"_90":-5,"_91":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
