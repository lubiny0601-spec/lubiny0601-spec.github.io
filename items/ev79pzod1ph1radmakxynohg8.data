[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794384592000,"id","ev79pzod1ph1radmakxynohg8","title","北京取消哈尔滨力强药业洛索洛芬钠凝胶贴膏集采中选资格并撤网","originalTitle","关于取消哈尔滨力强药业洛索洛芬钠凝胶贴膏集采中选资格的通知","summary","北京市医药集中采购服务中心通知，哈尔滨力强药业生产的洛索洛芬钠凝胶贴膏因生产线严重缺陷、GMP符合性检查不合格，被取消第十一批国家集采中选资格，该产品已在平台撤网。按集采规则，其约定采购量由涉及医疗机构在该品种其他中选企业中自行选择供应企业。","reason","北京医保局据此撤网并明确约定采购量的重新分配方式，涉及集采中选药品的供应衔接。","source",{"_64":75},"links",{"_58":74},"publishedAt","2026-05-09T00:00:00.000Z","discoveredAt","2026-10-27T16:01:16.789Z","timelineAt","category","policy","tags",[69,70,71,72,73],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":67,"_64":68},{"_62":31,"_64":66},{"_62":63,"_64":65},"slug","safety","name","安全与质量","政策与监管","insurance","医保与集采","政策/监管","安全/质量","医保/集采","抗感染","市场准入","https://ybj.beijing.gov.cn/zczxs/2020_ycgga/202605/t20260509_4642684.html","北京医保局·药品通知公告",{"_77":78,"_79":-5,"_80":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
