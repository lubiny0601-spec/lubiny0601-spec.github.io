[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795443792000,"id","ls5upx4et46czgbxqznpk2w7d","title","研究者探索CTE血液检测可能性：eMTBR-tau在确诊球员血中升高","originalTitle","Researchers explore possibility of a CTE blood test","summary","研究者发现，一种名为eMTBR-tau的tau蛋白形式在18名尸检确诊CTE的橄榄球运动员生前血样中升高，且晚期CTE患者血中水平高于轻度患者。该研究基于21名生前献血、死后捐献脑组织至波士顿大学CTE中心脑库的橄榄球运动员，其中16例为晚期病变。研究者称，在检测可用于患者前仍需大量验证工作。","reason","source",{"_63":70},"links",{"_58":69},"publishedAt","2026-11-20T13:53:10.000Z","discoveredAt","2026-11-23T04:24:56.339Z","timelineAt","category","research","tags",[67,68],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","Jason Mast and O. Rose Broderick","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","neuroscience","神经与精神","论文/研究","神经/精神","https://www.statnews.com/2026/11/20/health-news-researchers-explore-possibility-of-cte-blood-test/?utm_campaign=rss","STAT",{"_72":73,"_74":-5,"_75":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
