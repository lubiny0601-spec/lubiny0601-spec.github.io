[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794205946000,"id","v5uo8utxn0df5k8aecsgincnp","title","诺华确认Zolgensma治疗儿童中发生9例肿瘤，2例显示AAV载体DNA整合","originalTitle","Novartis Confirms Nine Cases of Tumors in Children Treated with Gene Therapy Zolgensma","summary","诺华确认其SMA基因疗法Zolgensma（onasemnogene abeparvovec-xioi）治疗的儿童中出现9例肿瘤报告，其中7例为新披露，2例已显示载体DNA整合入患者DNA。Zolgensma为AAV9载体基因疗法，用于治疗2岁以下双等位SMN1突变的SMA患儿，全球已治疗超6000例患者，载体整合致瘤风险已列入处方信息。","reason","source",{"_65":75},"links",{"_58":74},"publishedAt","2026-11-06T16:58:32.000Z","discoveredAt","2026-11-09T06:26:06.977Z","timelineAt","category","industry","tags",[73,68,70,72],"score",30,"selected",false,"channel","news","story","x","readingMode","full","author","Alex Philippidis","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","safety","name","安全与质量","cell-gene","细胞与基因治疗","rare-disease","罕见病","novartis","诺华","安全/质量","https://www.genengnews.com/topics/genome-editing/novartis-confirms-nine-cases-of-tumors-in-children-treated-with-gene-therapy-zolgensma/","GEN Genetic Engineering & Biotechnology News",{"_77":78,"_79":-5,"_80":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
