[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443805000,"id","ai9e7l1a4kgolsi594n35acw6","title","湖南调整优化医疗服务价格：统筹基金安全、医院运转与群众负担","originalTitle","【湖南】统筹基金安全·医院运转·群众负担 湖南调整优化医疗服务价格","summary","湖南省医保局持续调整优化医疗服务价格，2025年全省全年调价总金额12.69亿元，其中年度动态调整空间5.34亿元、价格治理腾出空间7.35亿元，调价严格控制在总量之内。动态调整机制设3项启动条件、5项约束条件，并设医保基金安全\"熔断\"红线。2025年全省公立医疗机构医疗服务收入占医药总费用比例62.3%，较2019年的55.8%增长6.5个百分点。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-11-20T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.206Z","timelineAt","category","policy","tags",[65,66,67],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/17/art_14_23414.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
