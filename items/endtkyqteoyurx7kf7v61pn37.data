[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794384582000,"id","endtkyqteoyurx7kf7v61pn37","title","原勃林格殷格翰高级副总裁张维加盟恒瑞医药，出任高级副总裁","originalTitle","重磅！原BI高级副总裁张维加盟恒瑞，担任高级副总裁","summary","恒瑞医药第十届董事会第六次会议审议通过聘任张维为公司高级副总裁，任期至本届董事会届满。张维此前担任勃林格殷格翰高级副总裁、大中华区研发和医学部负责人，曾管理800余人团队，并主导推动中国纳入全球早期临床开发。恒瑞医药2026年第三季度单季营收89.53亿元，同比增长20.55%，归母净利润24.58亿元，同比增长88.92%。","reason","恒瑞聘任有跨国药企大中华区研发管理经验的张维任高级副总裁，读者可据此观察其研发与准入布局的用人思路。","source",{"_64":69},"links",{"_59":68},"publishedAt","2026-11-04T01:31:36.000Z","discoveredAt","2026-11-09T06:26:03.942Z","timelineAt","category","industry","tags",[65,67],"score",48,"selected",true,"channel","news","story","x","readingMode","full","author","yian","body","outline",[],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","company-news","name","公司动态","hengrui","恒瑞医药","https://www.drugtimes.cn/2026/11/04/zhongbangyuanbigaojifuzongcaizhangweijiamenghengruidanrengao/","药时代",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
