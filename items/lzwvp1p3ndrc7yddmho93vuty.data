[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793889546000,"id","lzwvp1p3ndrc7yddmho93vuty","title","第十二批国采河南定于11月30日执行，15省已发文","originalTitle","第12批国采：河南11月30日执行，15省已发文","summary","河南省医保局印发通知，明确第十二批国家集采中选结果于2026年11月30日落地执行，采购周期至2029年12月31日，采购协议每年一签，各厂牌年采购量原则上不低于首年的90%。","reason","河南落地文件给出了第十二批国采的执行时间、采购周期与柔性考核细则，可对照各省节奏安排备货与院内准入。","source",{"_62":72},"links",{"_58":71},"publishedAt","2026-10-29T09:37:57.000Z","discoveredAt","2026-10-31T03:04:36.835Z","timelineAt","category","policy","tags",[66,67,68,69,70],"score",67,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699422&idx=1&sn=bad53a59e9623136b000e3e356baea71&chksm=bc73657a13ec36b196bd060f198209b25fcf37738aa465b28b8f843ee77ed7c372ad63c58684&scene=126&sessionid=1793415858#rd","医药云端工作室",{"_74":75,"_76":-5,"_77":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
