[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794205949000,"id","bpmitmz1p4uw6pq40npjlumqh","title","北京医保局发文优化药品集采期内续约及期满接续工作","originalTitle","关于优化本市药品集采项目期内续约及期满接续有关工作的通知","summary","北京市医疗保障局发布通知，优化本市药品集采项目期内续约流程，设置续约窗口期，由医药采购平台自动将上一协议期约定采购量推送为下一协议期约定采购量，经医疗机构确认后生效。约定采购量因政策限制、诊疗资源调整、用药人群改变等发生较大变化时，医疗机构可在窗口期内申请调整。本年度内本市自行组织的集采项目期满接续将与新增带量采购项目统筹开展，过渡期间协议期顺延，采购供应政策与期内保持一致。","reason","北京医保局明确集采续约窗口期与期满接续统筹安排，涉及医疗机构报量与协议签订流程。","source",{"_62":72},"links",{"_58":71},"publishedAt","2026-10-10T00:00:00.000Z","discoveredAt","2026-10-27T16:01:16.701Z","timelineAt","category","policy","tags",[66,67,68,69,70],"score",60,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://ybj.beijing.gov.cn/zczxs/2020_ycgga/202610/t20261010_4896649.html","北京医保局·药品通知公告",{"_74":75,"_76":-5,"_77":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
