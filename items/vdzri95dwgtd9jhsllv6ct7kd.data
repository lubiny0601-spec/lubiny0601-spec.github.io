[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794384581000,"id","vdzri95dwgtd9jhsllv6ct7kd","title","CDE 发布《化学药生物等效性试验备案范围和程序》修订版及共性问题解答","originalTitle","CDE发布《化学药生物等效性试验备案范围和程序》及共性问题解答","summary","药审中心发布修订后的《化学药生物等效性试验备案范围和程序》及共性问题解答（2026年第51号通告），自2027年2月1日起施行。此次修订旨在明确 BE 试验备案范围、完善备案工作程序，经国家药监局审查同意后发布，两份文件以附件形式随通告公布。","reason","CDE 修订化学药 BE 试验备案范围与程序并配套共性问题解答，仿制药研发与注册人员可据此调整备案安排。","source",{"_70":81},"links",{"_60":80},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-09T06:26:07.610Z","timelineAt","category","policy","tags",[78,79],"score",50,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fJvLs9B2qT2c","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","政策与监管","nmpa","中国 NMPA",{"_75":76,"_13":77},"publicId","37895b05-9ba4-4a60-b596-04b26ea94998","CDE修订化学药BE试验备案范围与程序","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-09/1110128.shtml","中国食品药品网·要闻",{"_83":84,"_85":-5,"_86":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
