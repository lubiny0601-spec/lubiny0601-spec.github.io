[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794205965000,"id","ppn04jf9p9hbqcwxl2z79bqjs","title","广东省药品交易中心启动第十二批国家集采中选药品信息维护","originalTitle","关于开展第十二批国家组织药品集中采购中选药品信息维护工作的通知","summary","广东省药品交易中心发布通知，开展第十二批国家集采中选药品信息维护，范围为《第十二批全国药品集中采购中选品种供应清单》内药品，维护时间即日起至2026年11月4日。","reason","广东启动第十二批国家集采中选药品信息维护，涉及企业需在11月4日前完成资质更新，否则影响后续交易资格。","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-10-25T16:00:00.000Z","discoveredAt","2026-10-27T16:01:17.227Z","timelineAt","category","policy","tags",[66,67],"score",47,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","https://www.gdmede.com.cn/announcement/announcement/detail?id=2114649329368043520","广东省药品交易中心·通知公告",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
