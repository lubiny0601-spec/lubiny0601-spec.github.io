[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794205960000,"id","h04h3qm6u6u66yx6qvmg57sas","title","湖南省医保局公示部分医疗机构美容整形类医疗服务项目市场调节价备案","originalTitle","【湖南】湖南省部分医疗机构美容整形类医疗服务项目市场调节价备案说明","summary","湖南省医保局对接国家医保局美容整形类医疗服务价格项目立项指南，统一规范美容整形项目并公示长沙市部、省属医疗机构备案价格及执业许可证载明的医疗美容整形诊疗科目。美容整形医疗服务不属于基本医疗服务，实行市场调节价管理，不纳入医保支付范围，由具备相应资质的医疗机构自主合理定价并按规定备案、向社会公开。","reason","source",{"_68":75},"links",{"_59":76},"publishedAt","2026-10-28T00:00:00.000Z","discoveredAt","2026-10-28T15:38:58.463Z","timelineAt","category","policy","tags",[74,75],"score",12,"selected",false,"channel","news","story",{"_71":72,"_13":73},"x","readingMode","full","author","body","outline",[],"relatedStories",[70],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fJ_qSKCqmngM","reportCount",1,"additionalSourceCount",0,{"_67":30,"_68":69},"slug","name","政策与监管",{"_71":72,"_13":73},"publicId","4f0ac2f0-57ea-4683-83d4-1474261cc0cf","湖南公示美容整形类医疗服务备案价格","政策/监管","国家医保局","http://www.nhsa.gov.cn/art/2026/9/27/art_14_22362.html",{"_78":79,"_80":-5,"_81":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
