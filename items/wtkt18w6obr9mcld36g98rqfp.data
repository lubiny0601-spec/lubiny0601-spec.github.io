[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794205945000,"id","wtkt18w6obr9mcld36g98rqfp","title","明慧医药与 ASKA 就 IGF-1R 抗体 MHB018A 达成日本独家许可，首付款 1.1 亿美元","originalTitle","1.1亿美元首付款！明慧医药达成出海合作","summary","明慧医药与 ASKA Pharmaceutical 就靶向 IGF-1R 的皮下注射抗体 MHB018A 签订日本开发与商业化独家许可协议，明慧医药将获得 1.1 亿美元首付款，并有资格获得最高 3.3 亿美元的开发、监管和商业化里程碑付款，以及基于日本净销售额、最高达 mid-30% 的分级特许权使用费。","reason","交易结构写清了首付款、里程碑与日本权益范围，可对照同类出海授权判断条款水平。","source",{"_65":74},"links",{"_59":73},"publishedAt","2026-11-04T12:35:56.000Z","discoveredAt","2026-11-09T06:26:03.932Z","timelineAt","category","industry","tags",[71,70,72],"score",60,"selected",true,"channel","news","story","x","readingMode","full","author","yian","body","outline",[],"relatedStories",[],"topics",[60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","deals","name","交易与授权","antibody","抗体与双抗","ophthalmology","眼科","交易/授权","抗体/双抗","https://www.drugtimes.cn/2026/11/04/11yimeiyuanshoufukuanminghuiyiyaodachengchuhaihezuo/","药时代",{"_76":77,"_78":-5,"_79":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
