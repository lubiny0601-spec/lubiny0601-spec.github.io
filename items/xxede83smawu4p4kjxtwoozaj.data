[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794205946000,"id","xxede83smawu4p4kjxtwoozaj","title","Science：小脑丹鳉全身单细胞图谱覆盖60余万细胞，DigiFish开放共享","originalTitle","Science：透明小鱼撑起首个成年脊椎动物全身细胞图谱，60余万细胞、空间定位与再生轨迹一并呈现，DigiFish开放共享","summary","怀特黑德研究所团队在《Science》发表首个覆盖成年脊椎动物的全身单细胞转录组图谱，基于透明小脑丹鳉（Danionella cerebrum）分析超60万个细胞，并结合空间方法定位细胞类型与基因活动。图谱揭示神经元基因活动与区域身份相关、成纤维细胞保留发育位置记忆，并追踪了端脑损伤后的再生轨迹。数据已通过DigiFish交互式资源开放共享。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-09T06:26:04.610Z","timelineAt","category","research","tags",[78,79],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fqeYc7GO2pzU","reportCount",2,"additionalSourceCount",1,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","neuroscience","神经与精神",{"_75":76,"_13":77},"publicId","1296177f-77c7-4aad-a41a-da6b01f04fe1","首个成年脊椎动物全身单细胞图谱建成","论文/研究","神经/精神","https://news.bioon.com/article/16ab96304543.html","生物谷",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
