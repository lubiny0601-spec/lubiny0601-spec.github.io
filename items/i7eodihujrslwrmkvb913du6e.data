[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795443791000,"id","i7eodihujrslwrmkvb913du6e","title","医疗器械销售代表能赚多少钱？普通销售年收入中位值19.3万元，高级销售30.9万元","originalTitle","医疗器械代表，能赚多少钱？","summary","薪智《2026年医疗器械行业白皮书》显示，截至2026年7月，一线城市医疗器械销售专员年总现金收入50分位值为19.3万元，高级销售专员达30.9万元，两者相差11.6万元。技术岗位薪酬溢价明显，器械研发管理岗平均发布年薪34.8万元，算法工程师33.1万元。医学联络专员与质量保证专员年总现金收入中位值分别为25.8万元和27.3万元，均高于普通销售专员。","reason","source",{"_64":76},"links",{"_58":75},"publishedAt","2026-11-22T11:08:04.000Z","discoveredAt","2026-11-23T04:32:21.771Z","timelineAt","category","opinion","tags",[70,71,72,73,74],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","秦酒","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","opinions","name","观点与解读","market","市场与销售","device-ivd","医疗器械与 IVD","观点/解读","医疗器械/IVD","市场/销售","迈瑞医疗","联影医疗","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653671478&idx=3&sn=71c3bd9ba0b842b8b4e779249b7dbfba&chksm=bcca0cd1097dcbe7ea94a2c821cd0e183fe0e6fc3a22749df23f9005e8b7c78707d253ae3d94&scene=126&sessionid=1795408256#rd","赛柏蓝",{"_78":79,"_80":-5,"_81":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
