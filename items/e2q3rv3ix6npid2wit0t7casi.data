[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795443792000,"id","e2q3rv3ix6npid2wit0t7casi","title","STAT+：MAHA Institute 税表显示储备金大幅缩水，智库运营承压","originalTitle","STAT+: Is MAHA’s think tank in the tank? Tax filings show low reserves","summary","支持 Robert F. Kennedy Jr. 健康议程的非营利智库 MAHA Institute 2025 年支出超过 100 万美元，年末现金仅剩 17.1 万美元，较年初近 130 万美元下降 86%。该机构全年收入略低于 6.7 万美元，难以抵消支出缺口。俄亥俄州立大学非营利会计专家 Brian Mittendorf 称，损失超过 100 万美元“相当值得注意”。","reason","source",{"_63":68},"links",{"_58":67},"publishedAt","2026-11-20T20:26:10.000Z","discoveredAt","2026-11-23T04:24:56.299Z","timelineAt","category","industry","tags",[66,64],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","Isabella Cueto","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","trends","name","行业趋势","company-news","公司动态","https://www.statnews.com/2026/11/20/maha-institute-tax-filings-rfk-jr-health-agenda-spending/?utm_campaign=rss","STAT",{"_70":71,"_72":-5,"_73":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
