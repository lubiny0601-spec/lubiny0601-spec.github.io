[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794205946000,"id","ghn6m41gb5zbhu61vqp2q720d","title","上药康德乐在进博会展示供应链解法：定制化方案与全栈一体化承接复杂需求","originalTitle","复杂需求，如何一体承接？上药康德乐在进博会展示供应链解法","summary","第九届进博会期间，上药康德乐在上药控股国际大健康专场展示供应链服务实践、数智化服务产品及全球伙伴合作，以定制化方案设计和全栈一体化交付回应客户多元供应链需求。公司针对境外临床急需药械依托海南博鳌乐城“先行先试”政策提供进口、通关、仓储及配送支持，并展示市场准入管理系统与AI智能调度系统两款数智化产品。美纳里尼、蔡司中国、贝德玛、罗氏诊断、凯西等全球伙伴到场交流。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-09T06:26:01.722Z","timelineAt","category","industry","tags",[71,78,79],"score",18,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fcHk54PlRHek","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","company-news","name","公司动态","device-ivd","医疗器械与 IVD",{"_75":76,"_13":77},"publicId","1eaa9ff8-9120-43bf-8925-216d931f1b62","上药康德乐进博会展示供应链与数智产品","医疗器械/IVD","上海医药","https://www.menet.com.cn/info/202611/202611091155225522_151413.shtml","米内网·企业",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
