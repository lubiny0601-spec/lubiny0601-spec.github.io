[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205967000,"id","iqrvhj2nbv4z3h794lij43wpe","title","2026年第42周第931期中国流感监测周报：南北方流感阳性率略升，甲型占66.1%","originalTitle","2026年第42周第931期中国流感监测周报","summary","截至2026年10月18日当周，南、北方省份流感病毒检测阳性率略有上升，全国检出阳性样本中甲型流感病毒占66.1%、乙型占33.9%，甲型中A(H3N2)占80.6%、A(H1N1)pdm09占19.4%，乙型均为B(Victoria)系，全国共报告28起流感样病例暴发疫情。","reason","source",{"_62":69},"links",{"_57":68},"publishedAt","2026-10-22T00:00:00.000Z","discoveredAt","2026-10-27T15:39:54.002Z","timelineAt","category","research","tags",[66,67],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","papers","name","论文研究","infectious","感染与疫苗","论文/研究","感染/疫苗","https://www.chinacdc.cn/jksj/jksj04_14249/202610/t20261022_1842422.html","中国疾控·流感监测周报",{"_71":72,"_73":-5,"_74":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
