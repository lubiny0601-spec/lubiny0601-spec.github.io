[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384587000,"id","kqxpsbk23vduko0pmuobugiuc","title","母体接种肺炎克雷伯菌荚膜多糖生物结合疫苗可保护新生小鼠免受败血症","originalTitle","Maternal Vaccination Shown to Protect Against K Pneumoniae Neonatal Sepsis","summary","在首个评估母体接种疫苗预防新生儿败血症的动物模型中，孕鼠接种两款荚膜多糖生物结合疫苗后，其幼鼠在腹腔注射高毒力肺炎克雷伯菌后存活率>80%，而未接种母鼠的幼鼠几乎全部或大量死亡。2剂和3剂方案均在第21天检出母体IgG，抗体经胎盘和母乳转移，3剂方案滴度更高且持续至6周龄。研究者提示小鼠结果未必直接外推至人类，单剂接种在临床上可能更受青睐。","reason","source",{"_63":77},"links",{"_57":76},"publishedAt","2026-10-20T11:27:12.187Z","discoveredAt","2026-11-09T06:26:06.980Z","timelineAt","category","research","tags",[69,70,71,72,73,74,75],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","infectious","感染与疫苗","论文/研究","抗菌药物","耐药与院感","感染/疫苗","抗感染","循证指南","对市场","https://www.contagionlive.com/view/maternal-vaccination-shown-to-protect-against-k-pneumoniae-neonatal-sepsis","Contagion Live·抗菌药物管理",{"_79":80,"_81":-5,"_82":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
