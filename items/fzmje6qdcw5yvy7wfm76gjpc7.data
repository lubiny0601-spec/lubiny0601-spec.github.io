[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793888177000,"id","fzmje6qdcw5yvy7wfm76gjpc7","title","环境管理：抗菌药物在气候变化中的作用","originalTitle","Environmental Stewardship: The Role of Antimicrobials in Climate Change","summary","广泛使用抗菌药物会破坏调节地球生物地球化学循环的微生物群落，加剧抗菌药物耐药性并助推气候变化。一项研究估算，一个疗程的抗生素通过影响土壤微生物环境，可释放9.84吨土壤储存的CO2，相当于一辆汽车绕地球行驶1.5倍；避免使用抗生素可移除目前大气中超过7%的CO2。微生物通过生物膜、持留菌、芽孢及可移动遗传元件等防御系统应对抗菌药物压力，耐药基因可在微生物组内外快速传播。","reason","source",{"_62":73},"links",{"_57":72},"publishedAt","2026-09-26T11:43:46.637Z","discoveredAt","2026-10-27T15:41:44.347Z","timelineAt","category","opinion","tags",[66,67,68,69,70,71],"score",15,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","opinions","name","观点与解读","antibiotics","抗菌药物与耐药","观点/解读","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://www.contagionlive.com/view/enivronmental-stewardship-the-role-of-antimicrobials-in-climate-change","Contagion Live·抗菌药物管理",{"_75":76,"_77":-5,"_78":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
