[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793888193000,"id","egatlr1sfckxkosu52eldd3cb","title","全国急性呼吸道传染病哨点监测：第42周流感病毒阳性率15.4%，南方高于北方","originalTitle","全国急性呼吸道传染病哨点监测情况（2026年第42周）","summary","中国疾控发布2026年第42周（10月12日—10月18日）全国急性呼吸道传染病哨点监测，216家多病原监测哨点医院门急诊流感样病例呼吸道样本阳性率前三位为流感病毒15.4%、鼻病毒10.9%、人偏肺病毒3.7%，住院严重急性呼吸道感染病例为鼻病毒9.2%、流感病毒4.8%、博卡病毒3.7%。","reason","第42周哨点监测给出流感病毒阳性率15.4%及南北方差异，可据此判断流感季启动节奏与区域防控重点。","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-10-22T00:00:00.000Z","discoveredAt","2026-10-27T15:39:54.174Z","timelineAt","category","policy","tags",[66,67],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","infectious","感染与疫苗","政策/监管","感染/疫苗","https://www.chinacdc.cn/jksj/jksj04_14275/202610/t20261022_1842412.html","中国疾控·急性呼吸道传染病哨点监测",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
