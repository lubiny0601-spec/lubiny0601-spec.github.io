[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795410132000,"id","h61v5l418odeff90fqr92hnng","title","美国调查：近30%成年人曾夸大或编造症状以获取抗生素","originalTitle","Nearly 30% of US Adults Report Misrepresenting Symptoms to Get Antibiotics","summary","一项纳入959名美国成年人的全国性调查显示，27.9%的受访者曾向临床医生夸大或编造症状以获取抗生素，其中76.9%至少成功获得过一次。感冒样症状最常被虚报（65.7%），其次为胃部症状（49.3%）和关节或肌肉疼痛（46.3%）。18-33岁人群虚报症状的比值比显著高于65岁以上人群（OR 3.20，95% CI 1.58-6.63），该结果发表于JAMA Network Open。","reason","source",{"_62":73},"links",{"_57":72},"publishedAt","2026-11-01T11:21:14.554Z","discoveredAt","2026-11-11T14:04:24.107Z","timelineAt","category","research","tags",[66,67,68,69,70,71],"score",20,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","papers","name","论文研究","antibiotics","抗菌药物与耐药","论文/研究","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://www.contagionlive.com/view/nearly-30-of-us-adults-report-misrepresenting-symptoms-to-get-antibiotics","Contagion Live·抗菌药物管理",{"_75":76,"_77":-5,"_78":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
