[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443791000,"id","sduacnwihthz06zi1nwvhrq9o","title","金税四期上线，医药老板财税管控与商业重构研修班12月北京开班","originalTitle","不少药企实控人，容易被财税牵连","summary","金税四期上线后资金流、发票流、业务流一比对，药企过往不合规操作将无所遁形，实控人个人身家可能被历史遗留财税隐患牵连。12月3-4日在北京举办的医药老板财税管控与商业重构研修班，旨在提醒仍粗放经营的医药老板拆掉历史遗留的雷。","reason","source",{"_69":77},"links",{"_59":76},"publishedAt","2026-11-21T11:29:31.000Z","discoveredAt","2026-11-23T04:32:41.059Z","timelineAt","category","industry","tags",[70,75],"score",8,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fj0ysUQZW23s","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","company-news","name","公司动态",{"_72":73,"_13":74},"publicId","7cc238de-0e3c-41bb-b779-ba83014178b0","赛柏蓝推广医药财税研修班12月北京开班","其他","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653671423&idx=4&sn=fda658b5cbde47f79f4fab05366fbf34&chksm=bc975ac3d127742dde1f41b47ed59b985f6025983537ee15dc6afc8d3a554ac74ee5d75fbeac&scene=126&sessionid=1795408256#rd","赛柏蓝",{"_79":80,"_81":-5,"_82":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
