[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794384584000,"id","fwoz2t199xd25duvs6x6dtpxq","title","MAHA 领袖 Calley Means 辞职后抨击白宫官员屈从行业利益","originalTitle","STAT+: MAHA leader Calley Means castigates White House officials as bending to industry","summary","刚辞职的 MAHA 关键人物 Calley Means 在接受播客 Joe Rogan 采访时称，特朗普政府的 MAHA 议程已被企业利益和金钱影响所破坏，白宫高层官员正根据行业游说调整政策。他以草甘膦争议为例，称行业团体对研究或限制该除草剂作出\"近乎暴力的反应\"，随后有白宫官员向他提出一项促进其生产的政策，并表示\"不容讨论\"。","reason","source",{"_63":70},"links",{"_58":69},"publishedAt","2026-11-06T21:55:21.000Z","discoveredAt","2026-11-09T06:26:05.123Z","timelineAt","category","opinion","tags",[67,68],"score",10,"selected",false,"channel","news","story","x","readingMode","full","author","Daniel Payne","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","opinions","name","观点与解读","policy","政策与监管","观点/解读","政策/监管","https://www.statnews.com/2026/11/06/calley-means-joe-rogan-trump-maha-agenda-derailed-by-corporate-influence/?utm_campaign=rss","STAT",{"_72":73,"_74":-5,"_75":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
