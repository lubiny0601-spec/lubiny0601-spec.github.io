[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794384582000,"id","al1ui9exasqe5g5xocpkgl5om","title","广东联盟药品集采公示第十批新增中选产品，公示至11月4日","originalTitle","广东省药品交易中心关于公示广东联盟药品集中带量采购新增中选产品信息的通知（十）","summary","广东省药品交易中心公示广东联盟药品集中带量采购新增中选产品信息（十），南京力成药业等企业申请增补中选资格，公示期至2026年11月4日17:30。依据《广东联盟双氯芬酸等药品接续采购文件（GDYJYPDL202501）》，报名截止后首次获批的同品种同剂型产品，接受本企业最低价格/最低日均费用与中选产品最低单位可比价两者低值的，可按中选产品挂网，当年度协议采购量默认为0。","reason","公示规则明确了接续集采品种范围内新获批产品按中选价挂网的准入路径，涉及企业可据此判断增补资格。","source",{"_70":83},"links",{"_60":82},"publishedAt","2026-11-01T16:00:00.000Z","discoveredAt","2026-11-03T15:25:05.461Z","timelineAt","category","policy","tags",[78,79,80,81],"score",50,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fYoRgDkRnMjo","reportCount",2,"additionalSourceCount",1,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","政策与监管","insurance","医保与集采",{"_75":76,"_13":77},"publicId","5d5bf734-2b63-4042-8d78-c3c3de94cb24","广东联盟集采第十批新增中选产品公布","政策/监管","医保/集采","抗感染","市场准入","https://www.gdmede.com.cn/announcement/announcement/detail?id=2117188449717981184","广东省药品交易中心·通知公告",{"_85":86,"_87":-5,"_88":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
