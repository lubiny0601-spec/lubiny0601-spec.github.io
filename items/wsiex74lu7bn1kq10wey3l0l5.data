[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384597000,"id","wsiex74lu7bn1kq10wey3l0l5","title","黑龙江多措并举打通基层药品配备“最后一公里”","originalTitle","【黑龙江】黑龙江多措并举打通基层药品配备“最后一公里”","summary","黑龙江省医保部门联合卫健、中医药管理等部门出台系列举措，将社区卫生服务中心常用口服药品指导目录扩充至600种，并要求常态化配备不少于300种。乡镇卫生院、村卫生室分别明确常态化配药300种以上、100种以上的刚性标准。依托全省一体化医保信息平台，已累计推送医保药品结算数据12次、4000余条，并完成650种基层常用药品的医保支付属性标注。","reason","source",{"_69":79},"links",{"_59":80},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T09:52:08.939Z","timelineAt","category","policy","tags",[77,78,79],"score",38,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f7dEweKnea-0","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","insurance","医保与集采",{"_74":75,"_13":76},"publicId","b366d6d5-4e3b-4310-b589-d0165db35183","黑龙江扩充基层药品配备标准","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/10/24/art_14_23220.html",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
