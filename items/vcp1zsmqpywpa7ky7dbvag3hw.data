[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384595000,"id","vcp1zsmqpywpa7ky7dbvag3hw","title","第九届进博会开幕：拜耳、诺和诺德、勃林格殷格翰等跨国药企首秀创新药械并加码在华投资","originalTitle","进博会 | 奔赴进博之约 开启机遇之门 跨国企业“秀肌肉”更“亮决心”","summary","11月5日第九届进博会在上海开幕，拜耳阿舒克森片、塞伐艾替尼片获批后进博首秀，诺和诺德依柯胰岛素司美格鲁肽注射液全球首展，勃林格殷格翰Verducatib等3款在研疗法中国首秀。西门子医疗累计展出超200款产品、约85%已在中国获批上市，赛诺菲今年在华落地三个项目，包括总投资10亿欧元的北京胰岛素原料药基地开工。","reason","source",{"_65":82},"links",{"_57":81},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-09T06:26:07.604Z","timelineAt","category","industry","tags",[66,75,74,76,70,77,78,79,80],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":73,"_65":74},{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","trends","name","行业趋势","device-ivd","医疗器械与 IVD","cardiovascular","心血管","metabolic","代谢与减重","oncology","肿瘤","医疗器械/IVD","代谢/减重","拜耳","诺和诺德","礼来","赛诺菲","https://www.cnpharm.com/c/2026-11-05/1110005.shtml","中国食品药品网·要闻",{"_84":85,"_86":-5,"_87":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
