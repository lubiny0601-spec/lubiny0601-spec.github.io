[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795443792000,"id","awo94zj650olh0ctoputd9tc1","title","HHS 启动 MAHA ELEVATE 试点：15 家机构测试“食物即药物”等生活方式项目能否改善 Medicare 患者健康","originalTitle","STAT+: Medicare pilot will test ‘food is medicine’ and other lifestyle programs to counter chronic diseases","summary","美国卫生与公众服务部（HHS）周五宣布，全美 15 家机构将参与 MAHA ELEVATE 项目，测试营养、运动等生活方式干预能否改善 Medicare 患者健康并节省政府开支。该项目计划在未来数年积累证据，评估烹饪课程、营养指导等预防性措施是否值得纳入 Medicare 报销范围。目前 Medicare 并不覆盖许多此类生活方式干预。","reason","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-11-20T19:04:04.000Z","discoveredAt","2026-11-23T04:24:56.308Z","timelineAt","category","policy","tags",[66,67],"score",10,"selected",false,"channel","news","story","x","readingMode","full","author","Isabella Cueto","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":64,"_62":65},{"_61":30,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","https://www.statnews.com/2026/11/20/kennedy-food-is-medicine-maha-elevate-pilot/?utm_campaign=rss","STAT",{"_71":72,"_73":-5,"_74":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
