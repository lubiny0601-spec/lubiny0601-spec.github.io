[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443793000,"id","ucm9jj1u90j3m5idenepbpn6u","title","第15届医药健康互联网大会-蓝亭叙2026：医药线上营销3大命门与3大亮点","originalTitle","医药线上营销，3大命门、3大亮点","summary","第15届医药健康互联网大会-蓝亭叙2026将于11月28-29日在杭州举办，聚焦医药电商流量贵、转化难等三大命门。大会设三大亮点：京东健康高管拆解B2C+O2O双场景协同与本地即时零售+AI数字化；哈药、好药师、德开医药、湖北民康等操盘过线上近10亿单品、年销28亿+的高管分享爆品策略与AI精准投流；另设非药大健康战略转型专场，并由阿里、京东、小红书专家参与圆桌对话。","reason","source",{"_71":88},"links",{"_59":87},"publishedAt","2026-11-12T12:00:34.000Z","discoveredAt","2026-11-12T14:31:31.319Z","timelineAt","category","industry","tags",[74,81,72,82,83,84,85,86],"score",10,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fprfJgyaonR0","reportCount",7,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","trends","name","行业趋势","company-news","公司动态","market","市场与销售",{"_78":79,"_13":80},"publicId","fc8ce772-0c1b-487e-bdbe-1be471cae4a6","赛柏蓝杭州医药健康互联网大会日期说法不一","市场/销售","抗感染","企业竞争","对市场","对数字化","哈药股份","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670466&idx=7&sn=4d291f6caa9aa23d6d4d5948459e6c5c&chksm=bc4a55bcdd71867b50186f478fce1c209e4e5cf8b1ee8ce10cd8c002e30bda610e1ad3998b63&scene=126&sessionid=1794493868#rd","赛柏蓝",{"_90":91,"_92":-5,"_93":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
