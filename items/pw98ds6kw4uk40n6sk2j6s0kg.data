[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443790000,"id","pw98ds6kw4uk40n6sk2j6s0kg","title","Cell Reports：南京医科大学江宏兵团队发现Piezo1内感受环路将咬合力传入下丘脑调控颅面骨稳态","originalTitle","Cell子刊：牙齿一咬，骨头就知道，南京医科大学江宏兵团队发现一条Piezo1内感受环路把咬合力送进下丘脑","summary","南京医科大学江宏兵团队在Cell Reports发表研究，揭示一条牙周Piezo1依赖的脑-骨内感受环路：Gli1谱系牙周间充质基质细胞上的Piezo1感知咬合力，经YAP/Gli1复合物促进COX-2表达与PGE2生成，激活三叉神经感觉通路并维持腹内侧下丘脑（VMH）活性、减弱室旁核（PVN）相关交感传出。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T11:48:45.398Z","timelineAt","category","research","tags",[78,79],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f0bKOOB83Zmc","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","neuroscience","神经与精神",{"_75":76,"_13":77},"publicId","f04ddde4-55d5-43a2-b1b6-3cf24643c067","江宏兵团队揭示牙周Piezo1脑-骨环路","论文/研究","神经/精神","https://news.bioon.com/article/1b2796529520.html","生物谷",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
