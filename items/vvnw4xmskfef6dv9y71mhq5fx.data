[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795408390000,"id","vvnw4xmskfef6dv9y71mhq5fx","title","恒瑞卡瑞利珠单抗联合无蒽环化疗用于三阴性乳腺癌新辅助治疗的III期研究发表于Annals of Oncology","originalTitle","恒瑞创新药卡瑞利珠单抗联合无蒽环化疗用于三阴性乳腺癌新辅助治疗研究荣登Annals of Oncology","summary","恒瑞医药PD-1抑制剂卡瑞利珠单抗联合多西他赛+卡铂的无蒽环新辅助方案，在II–III期三阴性乳腺癌随机III期HELEN-Trio 011研究中将pCR率提升至57.5%，单纯化疗组为45.4%，绝对差异12.2%（95% CI：1.4%–22.9%；单侧P=0.014）。","reason","source",{"_63":73},"links",{"_57":72},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-16T00:55:42.775Z","timelineAt","category","clinical","tags",[64,68,70,71],"score",40,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":69,"_63":70},{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":30,"_63":64},"slug","name","临床进展","antibody","抗体与双抗","oncology","肿瘤","hengrui","恒瑞医药","抗体/双抗","https://www.hengrui.com/media/detail-1065.html","恒瑞医药·新闻",{"_75":76,"_77":-5,"_78":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
