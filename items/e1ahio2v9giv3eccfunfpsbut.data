[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889554000,"id","e1ahio2v9giv3eccfunfpsbut","title","Basecamp Research的EDEN AI模型经Claude Science可分钟级设计抗WHO重点病原体抗生素肽","originalTitle","AI Model Designs Potent Antibiotics Against WHO Priority Pathogens in Minutes","summary","Basecamp Research的EDEN生物AI模型已通过Anthropic的Claude Science开放，与宾夕法尼亚大学合作开展的实验室测试中，EDEN设计的抗生素肽对97%的WHO重点病原体有活性。候选分子EDEN-7在耐多药鲍曼不动杆菌小鼠感染模型中显示出与最后线抗生素相当的有效性，且为无需迭代优化的零样本生成。EDEN还具备疫苗靶点预测能力，可将数周的靶点筛选压缩为一次AI对话。","reason","source",{"_62":72},"links",{"_57":71},"publishedAt","2026-07-23T13:00:00.000Z","discoveredAt","2026-10-28T01:14:46.537Z","timelineAt","category","industry","tags",[63,66,67,68,69,70],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","company-news","name","公司动态","antibiotics","抗菌药物与耐药","抗菌药物","抗感染","管线上新","对市场","对品牌","https://www.contagionlive.com/view/eden-ai-antibiotic-design-who-priority-pathogens-basecamp-research","Contagion Live·抗菌药物管理",{"_74":75,"_76":-5,"_77":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
