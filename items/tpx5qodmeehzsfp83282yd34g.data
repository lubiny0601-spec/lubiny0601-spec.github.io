[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794384583000,"id","tpx5qodmeehzsfp83282yd34g","title","诺华 pelacarsen III 期 HORIZON 试验未降低心血管事件，Lp(a) 策略受质疑","originalTitle","STAT+: Failure of Novartis Lp(a) drug raises questions about cardiovascular strategy","summary","诺华 pelacarsen 在 III 期 HORIZON 试验中虽大幅降低 Lp(a)，但近 5 年随访显示心梗、卒中、紧急冠脉血运重建或死亡与安慰剂无差异。该结果于美国心脏协会科学年会公布并同步发表于《新英格兰医学杂志》，令针对这一影响 1/5 人群的遗传性心血管风险因素的研发策略面临质疑。","reason","source",{"_72":85},"links",{"_60":84},"publishedAt","2026-11-07T14:50:00.000Z","discoveredAt","2026-11-09T06:26:05.103Z","timelineAt","category","clinical","tags",[73,77,79,75],"score",30,"selected",false,"channel","news","story",{"_81":82,"_13":83},"x","readingMode","full","author","Elizabeth Cooney and Matthew Herper","body","outline",[],"relatedStories",[80],"topics",[67,68,69,70],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fb5GPh0_HZ3k","reportCount",1,"additionalSourceCount",0,{"_71":78,"_72":79},{"_71":76,"_72":77},{"_71":74,"_72":75},{"_71":30,"_72":73},"slug","name","临床进展","nucleic","核酸药物","cardiovascular","心血管","novartis","诺华",{"_81":82,"_13":83},"publicId","2c8bd27a-cc0e-4973-8813-d9e727d35d46","诺华pelacarsen三期试验未改善心血管结局","https://www.statnews.com/2026/11/07/aha-conference-news-novartis-lp-a-pelacarsen-heart-disease-trial-mystery/?utm_campaign=rss","STAT",{"_87":88,"_89":-5,"_90":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
