[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":55,"_56":35,"_57":58},"expiresAt",1794791091000,"id","fxwlsimi0wtv55qb4e6zvx06p","title","破谣 | 一个柿子十付药、能治肺热咳嗽？","originalTitle","summary","柿子性味甘涩微寒，传统认为有清热润肺化痰止咳之功效，主要对肺热引起的黄痰、咳嗽声响、咽喉肿痛等症状起作用，但并非\"一个柿子十付药\"般可替代中药。软柿与硬柿功效相似，软柿可溶性糖更高、升糖更快，需控糖者慎选。鲜柿建议用量为100~200克，中等柿子约一个，不宜多食。","reason","source",{"_69":79},"links",{"_58":78},"publishedAt","2026-11-12T14:11:11.000Z","discoveredAt","2026-11-12T14:30:58.448Z","timelineAt","category","opinion","tags",[77,72],"score",3,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fCT8ttN4UCb8","reportCount",1,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","opinions","name","观点与解读","tcm","中药",{"_74":75,"_13":76},"publicId","959f206a-d2c1-46af-a990-da7e9f942fdb","柿子润肺止咳功效被夸大，不能替代中药","观点/解读","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604792&idx=3&sn=73752d4b4679e7a4849425953a4bffa9&chksm=fc00eb6e8a433112b41f203496993f06391f617a9c2f49622548a334cc879bada3faa8d0bab3&scene=126&sessionid=1794493844#rd","呼吸界",{"_81":82,"_83":-5,"_84":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
