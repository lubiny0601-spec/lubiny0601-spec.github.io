[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795410130000,"id","bocc708ws0d5id8d2e4how6i1","title","哈药股份哈药总厂注射用头孢唑肟钠通过仿制药一致性评价","originalTitle","哈药股份｜哈药集团股份有限公司关于所属企业药品通过仿制药一致性评价的公告","summary","哈药集团制药总厂收到 NMPA 颁发的《药品补充申请批准通知书》，注射用头孢唑肟钠 0.5g 与 1.0g 两个规格通过仿制药质量和疗效一致性评价。该药适用于敏感菌所致下呼吸道感染、尿路感染、腹腔感染、败血症、脑膜炎和单纯性淋病等。","reason","公告给出该品种的院端销售额与过评厂家数量，读者可据此判断头孢唑肟钠市场的竞争格局。","source",{"_71":87},"links",{"_60":86},"publishedAt","2026-11-10T16:00:00.000Z","discoveredAt","2026-11-11T08:03:36.756Z","timelineAt","category","approval","tags",[72,79,80,81,82,83,84,85],"score",49,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fUhSZDyU2Vak","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","approvals","name","获批上市","antibiotics","抗菌药物与耐药",{"_76":77,"_13":78},"publicId","96f2ef21-ef9a-420b-8340-d7e60bf4ada6","哈药总厂头孢唑肟钠通过一致性评价","抗菌药物","NMPA","哈药股份","抗感染","管线上新","对市场","对准入","https://static.cninfo.com.cn/finalpage/2026-11-11/1225664721.PDF","哈药股份·公司公告",{"_89":90,"_91":-5,"_92":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
