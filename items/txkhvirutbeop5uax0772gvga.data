[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794791088000,"id","txkhvirutbeop5uax0772gvga","title","药明康德被美国国防部移出1260H清单，梳理近三年博弈前因后果","originalTitle","药明康德被移出1260H清单，一文梳理前因后果","summary","美国国防部决定将药明康德从1260H条款项下的中国军工企业名单中移除，药明康德11月9日获悉、11月10日在港交所公告。事件起于6月8日国防部更新清单将药明康德列为中国军工企业，公司6月11日在哥伦比亚特区联邦地区法院起诉，8月7日法院批准初步禁令，裁决意见书指出国防部认定存在事实错误。","reason","梳理药明康德被移出1260H清单的完整时间线与司法路径，并指出移除标注不排除再次列名。","source",{"_73":85},"links",{"_61":84},"publishedAt","2026-11-10T02:07:57.000Z","discoveredAt","2026-11-11T08:15:37.749Z","timelineAt","category","industry","tags",[74,83,78],"score",58,"selected",true,"channel","news","story",{"_80":81,"_13":82},"x","readingMode","full","author","子非鱼","body","outline",[],"relatedStories",[79],"topics",[68,69,70],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fKmGmqBSPANA","reportCount",1,"additionalSourceCount",0,{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","company-news","name","公司动态","cxo","CXO 与外包","wuxi","药明康德",{"_80":81,"_13":82},"publicId","80f88856-6bb2-47cc-9f07-dcf70cb2e46f","美国国防部将药明康德移出1260H清单","CXO","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699533&idx=1&sn=e7515636aee185ac0cff162018562e1d&chksm=bc7a8bbea5b43f458c997ff82f08a170f26addb3adbb08d8e21ff8a0205184988827cf9384cf&scene=126&sessionid=1794384876#rd","医药云端工作室",{"_87":88,"_89":-5,"_90":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
