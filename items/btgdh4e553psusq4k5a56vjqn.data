[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795443792000,"id","btgdh4e553psusq4k5a56vjqn","title","STAT+ Pharmalittle：赛诺菲考虑收购 Insmed、AI 加速药物开发等","originalTitle","STAT+: Pharmalittle: We’re reading about Sanofi eyeing Insmed, AI speeding drug development, and more","summary","赛诺菲正考虑收购 Insmed。今年 AI 已把部分大型药企早期药物开发中产出新分子并推进至临床的时间最多缩短一半，BMS、诺华、礼来、赛诺菲、诺和诺德和阿斯利康的科学家称已用 AI 设计分子、筛选候选并识别安全风险。默沙东、礼来、艾伯维、辉瑞和 BMS 向美国国会委员会表示不计划在中国新疆地区或与中国军方关联的医院启动新的临床试验点。","reason","source",{"_62":72},"links",{"_58":71},"publishedAt","2026-11-20T14:16:35.000Z","discoveredAt","2026-11-23T04:24:56.324Z","timelineAt","category","industry","tags",[63,64,65,66,67,68,69,70],"score",15,"selected",false,"channel","news","story","x","readingMode","full","author","Ed Silverman","body","outline",[],"relatedStories",[],"topics",[59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":61,"_62":63},"slug","trends","name","行业趋势","辉瑞","默沙东","礼来","艾伯维","BMS","诺华","赛诺菲","https://www.statnews.com/pharmalot/2026/11/20/sanofi-eyeing-insmed-ai-speeding-drug-development/?utm_campaign=rss","STAT",{"_74":75,"_76":-5,"_77":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
