[{"_1":2,"_3":4},"root",{"_5":68},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889566000,"id","cs2fcpbfabio63n1qgxkhe3fx","title","八部门印发《产业基础能力提升\"十五五\"规划》：前瞻布局生物制造、脑机接口、具身智能等前沿领域","originalTitle","八部门印发《产业基础能力提升“十五五”规划》 前瞻布局生物制造、脑机接口、具身智能等前沿领域","summary","工业和信息化部、国家发展和改革委员会等8部门联合印发《产业基础能力提升\"十五五\"规划》，提出到2030年产业基础薄弱问题明显缓解、产业基础能力总体进入国际先进行列。规划聚焦7个方面提出22项重点任务，并明确瞄准生物制造、脑机接口、具身智能等前沿领域，前瞻布局一批关键基础产品创新任务。","reason","source",{"_62":67},"links",{"_57":66},"publishedAt","2026-10-23T00:00:00.000Z","discoveredAt","2026-10-27T13:29:45.271Z","timelineAt","category","policy","tags",[65,63],"score",20,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":30,"_62":64},{"_60":61,"_62":63},"slug","trends","name","行业趋势","政策与监管","政策/监管","https://www.cnpharm.com/c/2026-10-23/1109392.shtml","中国食品药品网·要闻",{"_69":70,"_71":-5,"_72":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
