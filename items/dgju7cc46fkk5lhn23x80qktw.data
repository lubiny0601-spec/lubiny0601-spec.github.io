[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384602000,"id","dgju7cc46fkk5lhn23x80qktw","title","2026 ESMO：安尼妥单抗KC-WISE研究更新OS数据，HER2阳性晚期胃癌二线治疗mOS达19.6个月","originalTitle","2026 ESMO大会：安尼妥单抗KC-WISE研究更新OS数据，有望改写 HER2 阳性晚期胃癌二线及以上人群的生存局面","summary","石药集团在2026 ESMO年会以LBA口头报告形式公布III期KC-WISE研究更新OS数据：安尼妥单抗（恩尼妥®）联合化疗用于曲妥珠单抗治疗失败的HER2阳性GC/GEJA，mOS达19.6个月，对照组9.6个月（HR=0.39，95% CI 0.28-0.54，P<0.0001），死亡风险降低61%。","reason","source",{"_63":73},"links",{"_57":72},"publishedAt","2026-10-27T00:00:00.000Z","discoveredAt","2026-10-29T14:00:04.303Z","timelineAt","category","clinical","tags",[64,68,71,70],"score",45,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":69,"_63":70},{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":30,"_63":64},"slug","name","临床进展","adc","ADC 与偶联药物","oncology","肿瘤","cspc","石药集团","ADC","https://www.cspc.cn/details/details_92_7259.html","石药集团·新闻中心",{"_75":76,"_77":-5,"_78":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
