[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795443789000,"id","tmh96p809fciwwf70g9429e3c","title","全国单抗类药品联盟集采启动信息申报，7个品种15个规格纳入","originalTitle","全国生物药集采，启动信息申报","summary","11月21日，安徽省医药集中采购平台发布《全国药品联盟集中带量采购（单克隆抗体类）公告（第1号）》，本轮集采涉及阿达木单抗、贝伐珠单抗、地舒单抗、利妥昔单抗、曲妥珠单抗、托珠单抗和英夫利西单抗7个品种、15个规格，企业须在11月24日9时至11月27日18时完成信息申报。","reason","全国单抗联盟集采首次明确7个品种与申报窗口，读者可据此判断自家品种是否在报量范围内。","source",{"_73":92},"links",{"_61":91},"publishedAt","2026-11-21T11:29:31.000Z","discoveredAt","2026-11-23T04:32:32.264Z","timelineAt","category","policy","tags",[85,86,87,88,89,90],"score",78,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","颜色","body","outline",[],"relatedStories",[81],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fD7NrpfPigZk","reportCount",2,"additionalSourceCount",1,{"_72":79,"_73":80},{"_72":77,"_73":78},{"_72":75,"_73":76},{"_72":31,"_73":74},"slug","name","政策与监管","insurance","医保与集采","antibody","抗体与双抗","nmpa","中国 NMPA",{"_82":83,"_13":84},"publicId","23cbfca6-055b-40f2-b8f8-e2c5d73a280f","安徽牵头单抗类药品全国联盟集采启动申报","政策/监管","医保/集采","抗体/双抗","NMPA","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653671423&idx=1&sn=d841a05913633f2341497f6a8e87e811&chksm=bc779c563f9c7fa83c4b8522a599b3ff35ac5a4a9a9db493d71920241ff4272c5de9af1b06c2&scene=126&sessionid=1795408256#rd","赛柏蓝",{"_94":95,"_96":-5,"_97":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
