[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":55,"_56":35,"_57":58},"expiresAt",1794384600000,"id","tcxzr0xgi0p9yll125vk0g6n1","title","雷平会见俄罗斯联邦卫生监督局副局长德米特里·帕夫柳科夫一行","originalTitle","summary","国家药监局副局长雷平10月23日在京会见俄罗斯联邦卫生监督局副局长德米特里·帕夫柳科夫一行。雷平介绍了中国医疗器械审评审批制度改革、法规标准体系建设、全生命周期监管和产业创新发展情况，帕夫柳科夫介绍了俄方医疗器械监管工作，双方同意在医疗器械注册管理及上市后监测等领域加强交流，共同提升监管能力、保障两国公众用械安全。","reason","source",{"_69":83},"links",{"_58":82},"publishedAt","2026-10-28T00:00:00.000Z","discoveredAt","2026-10-28T15:39:01.273Z","timelineAt","category","policy","tags",[79,80,81],"score",8,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","body","outline",[],"relatedStories",[75],"topics",[65,66,67],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","ff-VSwkmvnhY","reportCount",1,"additionalSourceCount",0,{"_68":73,"_69":74},{"_68":71,"_69":72},{"_68":29,"_69":70},"slug","name","政策与监管","device-ivd","医疗器械与 IVD","nmpa","中国 NMPA",{"_76":77,"_13":78},"publicId","a73a955a-0927-4439-af75-a0a86ce7cb2f","中俄药监部门商谈医疗器械监管合作","政策/监管","医疗器械/IVD","NMPA","https://www.cnpharm.com/c/2026-10-28/1109585.shtml","中国食品药品网·要闻",{"_85":86,"_87":-5,"_88":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
