[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408366000,"id","f69m1cmhljp9lwqsb6yymzw39","title","第15届医药健康互联网大会·蓝亭叙2026将在杭州举办，聚焦医药电商全渠道与爆品打法","originalTitle","一位医药营销人，太想进步了","summary","第15届医药健康互联网大会·蓝亭叙2026定于11月28-30日在杭州举办，议程覆盖政策趋势与行业洞察、AI时代的医药健康互联网新生态，以及B2C、O2O双轮驱动的全渠道打法。下午场聚焦线上全域营销打造超级爆品、抖音小红书视频号内容电商破圈、即时零售爆品策略与私域加兴趣电商加复购的一体化经营，并涉及数字营销与降本增效路径设计。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-15T10:27:27.000Z","discoveredAt","2026-11-16T01:03:19.038Z","timelineAt","category","industry","tags",[71,78],"score",8,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fprfJgyaonR0","reportCount",6,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","trends","name","行业趋势","opinions","观点与解读",{"_75":76,"_13":77},"publicId","fc8ce772-0c1b-487e-bdbe-1be471cae4a6","赛柏蓝杭州办医药健康互联网大会","观点/解读","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670716&idx=5&sn=b549c91a8f2e9cbb2842d580c8354e96&chksm=bc3c87f867074fd0398beba034c1a609bd7bc2ad47b4cff4c88bed0d3770893104070e6e9fb3&scene=126&sessionid=1794790858#rd","赛柏蓝",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
