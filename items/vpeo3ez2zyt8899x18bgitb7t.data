[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49,"_50":35,"_51":52,"_53":-5,"_54":35,"_55":56},"expiresAt",1795410149000,"id","vpeo3ez2zyt8899x18bgitb7t","title","CDE公示将NouvSight001纳入“关爱计划-延伸”试点项目","originalTitle","summary","CDE于11月13日公示，拟将睿健毅联医药科技（成都）有限公司的NouvSight001纳入“关爱计划-延伸”试点项目，拟开发适应症为视网膜色素变性，公示期截至2026年11月20日。该公示依据《罕见疾病创新药物研发鼓励试点计划（“关爱计划-延伸”）申报指南》发布，异议可发送至指定邮箱。","reason","source",{"_62":73},"links",{"_56":72},"publishedAt","2026-11-14T00:00:00.000Z","discoveredAt","2026-11-16T00:55:14.805Z","timelineAt","category","policy","tags",[70,67,65,71],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[57,58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":68,"_62":69},{"_61":66,"_62":67},{"_61":64,"_62":65},{"_61":29,"_62":63},"slug","name","政策与监管","ophthalmology","眼科","rare-disease","罕见病","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-14/1110507.shtml","中国食品药品网·要闻",{"_75":76,"_77":-5,"_78":52},"changelogVersion","2026-10-08T08:00","release","staticSite"]
