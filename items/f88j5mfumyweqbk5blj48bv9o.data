[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443791000,"id","f88j5mfumyweqbk5blj48bv9o","title","慢阻肺病最隐匿却危害最大的症状：活动后气促为何最会“骗人”","originalTitle","肺病这一症状「最会骗人」，极易被忽视但危害最大，多数人却没放心上","summary","慢阻肺病典型症状中，活动后气促最隐匿却危害最大，常被归因于年纪大或缺乏锻炼而延误就诊。该症状早期仅表现为爬楼、快走时气短，休息可缓解，待走平路也喘、夜间躺不平就诊时肺功能多已降至中重度。气促引发的行为回避会进一步缩小活动范围，并与肺过度充气共同加重心脏和肺微循环负担。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-21T11:17:13.000Z","discoveredAt","2026-11-23T04:30:47.050Z","timelineAt","category","opinion","tags",[78,73],"score",8,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fX70YvDj9oAU","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","respiratory","呼吸",{"_75":76,"_13":77},"publicId","9b799210-7bdd-4c82-8691-e96cd1ec22d4","慢阻肺病活动后气促易被忽视而延误就诊","观点/解读","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247605101&idx=2&sn=979940f5c7569f39f58a7fecaa08be69&chksm=fcca4ae99ed3ff9e5f18884411ad98c403fb365b722081ce6c7dc15e9b26e9ee73a0459a0bea&scene=126&sessionid=1795408232#rd","呼吸界",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
