[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794791088000,"id","nlm0po7xu4108td3t4ubso8ho","title","中保协发布首版商保药品推荐清单，58款高值创新药械入选","originalTitle","重磅！58个商保药品推荐清单（第一版）+成本测算涉及117品种（附名单）","summary","11月10日，中国保险行业协会发布《商业健康保险药品保障推荐清单（第一版）》，首批遴选58款推荐药械，适应症覆盖肺癌、肝癌、血液肿瘤等高发恶性肿瘤及神经母细胞瘤等国家罕见病目录内肿瘤，其中1类创新药25款、2类改良型新药2款，基本医保目录外自费药32款。","reason","商保药品推荐清单与成本测算同步落地，读者可据此判断高值创新药在院外商保渠道的准入路径。","source",{"_64":75},"links",{"_58":74},"publishedAt","2026-11-10T11:29:40.000Z","discoveredAt","2026-11-11T08:15:31.917Z","timelineAt","category","policy","tags",[72,73,71,69],"score",62,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":70,"_64":71},{"_63":68,"_64":69},{"_63":66,"_64":67},{"_63":31,"_64":65},"slug","name","政策与监管","insurance","医保与集采","rare-disease","罕见病","oncology","肿瘤","政策/监管","医保/集采","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699547&idx=1&sn=876e47f9b66147f900ca3c68d6e3b26c&chksm=bc71c129d5e5830141f99f0e62f4a5af2b31b84ccf34d9c6af210752518c8e58eee5adfc7f30&scene=126&sessionid=1794384876#rd","医药云端工作室",{"_77":78,"_79":-5,"_80":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
