[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":55,"_56":35,"_57":58},"expiresAt",1794384582000,"id","jyvmbh3fzm1vbtdron0fagijl","title","有药企营销高管，迷茫了","originalTitle","summary","一位药企电商部门负责人向作者坦言，面对竞品在抖音、小红书的种草与私域复购，自己仍靠硬广、线上流量成本难以承受，对医药电商玩法感到迷茫。作者建议其参加赛柏蓝11月28-29日在杭州举办的蓝亭叙2026-第15届医药健康互联网大会，京东健康、哈药、好药师、德开医药及抖音、小红书、阿里健康操盘手将分享超级爆品策划、平台与私域IP选择、医生IP科普转化及医疗短剧带货路径。","reason","source",{"_69":81},"links",{"_58":80},"publishedAt","2026-11-07T12:15:14.000Z","discoveredAt","2026-11-09T06:32:50.511Z","timelineAt","category","opinion","tags",[77,78,79],"score",8,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[65,66],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","fprfJgyaonR0","reportCount",3,"additionalSourceCount",0,{"_67":71,"_69":72},{"_67":68,"_69":70},"slug","opinions","name","观点与解读","market","市场与销售",{"_74":75,"_13":76},"publicId","fc8ce772-0c1b-487e-bdbe-1be471cae4a6","赛柏蓝11月在杭州办医药健康互联网大会","观点/解读","市场/销售","哈药股份","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669765&idx=5&sn=f0a248b4129772fd46f22a1e25254081&chksm=bccf7dbbf8df2d32d3d21b03ee4e06614c803e70ae404c210ff7c67d85e8b442fdc3aada5561&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_83":84,"_85":-5,"_86":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
