[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794384605000,"id","cz4o4xrsmu2jhta39cerqmu72","title","CDE就《药品市场独占期工作程序（征求意见稿）》公开征求意见","originalTitle","CDE公开征求《药品市场独占期工作程序（征求意见稿）》意见","summary","国家药监局药审中心于10月23日公开征求《药品市场独占期工作程序（征求意见稿）》意见，该程序为配合《药品市场独占期实施办法》贯彻落实而起草，经内部讨论并组织行业专家、企业代表研讨完善。征求意见时限为自发布之日起15日，反馈意见发送至 ypzscq@cde.org.cn。","reason","CDE就药品市场独占期工作程序征求意见，读者可据此了解独占期制度的落地流程与反馈窗口。","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-10-24T00:00:00.000Z","discoveredAt","2026-10-28T15:39:01.328Z","timelineAt","category","policy","tags",[66,67],"score",62,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-24/1109536.shtml","中国食品药品网·要闻",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
