[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795410126000,"id","v1y9irp11x2a9v8vfzf4gnmqb","title","首都医科大学吉训明等 Med 发文揭示中国急性缺血性卒中再灌注服务的地理差异与老龄化负担","originalTitle","Med：首都医科大学吉训明等合作揭示中国急性缺血性卒中再灌注服务的地理差异与老龄化负担","summary","首都医科大学吉训明、吴川杰、马青峰团队在 Med 发表基于全国2522家医院数据的空间分析，揭示中国急性缺血性卒中再灌注服务呈东高西低梯度。三级、城市与核心医院溶栓量更高、门—针时间更短；高老龄化与低产出的错配集中于县级及以下医院，占70.9%，而老龄化率较高反而与更及时溶栓相关。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T04:24:55.729Z","timelineAt","category","research","tags",[78,79],"score",20,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fXYOxOCuQ3LI","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","neuroscience","神经与精神",{"_75":76,"_13":77},"publicId","4dc78a78-dcc2-4f8f-9173-29e20fec30f0","中国卒中再灌注服务地理差异研究发表","论文/研究","神经/精神","https://news.bioon.com/article/736c965303c9.html","生物谷",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
