[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":36,"_55":36,"_56":57,"_58":59,"_60":61},"expiresAt",1795443794000,"id","wlbrwnoex4063t9l3hqx3uf6p","title","辽宁对第12批国采非中选药品启动红黄标价格风险标识","originalTitle","辽宁：第12批国采未中选的各类品种，红黄标来了！","summary","辽宁省公共资源交易中心通知，将于11月26日对第12批国采同通用名非中选其他厂牌药品价格进行红黄标风险标识。未中选已过评同通用名药高于全国最高中选价1.8倍为黄标、3倍为红标；未中选参比制剂高于同通用名药最高挂网价1.8倍为黄标，暂不执行红标；未中选未过评同通用名药高于全国最高中选价即为黄标。被标识企业可随时申请降价，平台按挂网价格自动调整颜色标识。","reason","source",{"_71":86},"links",{"_61":85},"publishedAt","2026-11-11T02:32:31.000Z","discoveredAt","2026-11-11T08:15:29.145Z","timelineAt","category","policy","tags",[81,82,83,84],"score",55,"selected",true,"channel","news","story",{"_76":77,"_13":78},"x","sameEvent",{"_11":79,"_13":80},"readingMode","full","author","body","outline",[],"relatedStories",[75],"topics",[68,69],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fJYxi7vkV5uI","reportCount",2,"additionalSourceCount",0,{"_70":73,"_71":74},{"_70":30,"_71":72},"slug","name","政策与监管","insurance","医保与集采",{"_76":77,"_13":78},"publicId","55012e0b-480c-4ba7-a599-e18e62420ca8","辽宁对第12批国采非中选药品实施红黄标价格标识","qu7bvo5ket1nxt34z1sur6luz","辽宁对第12批国采非中选药品启动红黄标价格标识","政策/监管","医保/集采","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699555&idx=1&sn=c81fb046fadf47b94fea7083af632e48&chksm=bcd3ed6cf42ddf3cfae9eaf5979acde1d5dbcd345b13a896d8e41d797fa4373d4916a4761d12&scene=126&sessionid=1794384876#rd","医药云端工作室",{"_88":89,"_90":-5,"_91":36},"changelogVersion","2026-10-08T08:00","release","staticSite"]
