[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794384586000,"id","pqww65i5mism69ezxrpsdqlwr","title","米内网统计第13批集采候选品种，53个药竞争企业达7家以上","originalTitle","第13批集采，53个药备战","summary","随着第12批集采中选结果多地公布执行时间，米内网按治疗领域统计了尚未纳入集采且竞争企业数（原研+过评）在7家及以上的药品，共涉及呼吸系统化药15个、抗肿瘤和免疫调节剂16个、高血压化药10个、皮肤病化药10个等品类。文章提示部分品种因专利期、产品属性或市场规模可能不会被纳入，最终以官方信息为准。","reason","梳理了尚未纳入集采且竞争企业达7家以上的品种分布，可用来预判第13批集采的候选范围。","source",{"_71":89},"links",{"_60":88},"publishedAt","2026-10-28T12:15:55.000Z","discoveredAt","2026-10-28T15:45:46.473Z","timelineAt","category","policy","tags",[81,82,83,84,85,86,87],"score",47,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","f-ciCMxOmqvc","reportCount",1,"additionalSourceCount",0,{"_70":75,"_71":76},{"_70":73,"_71":74},{"_70":31,"_71":72},"slug","name","政策与监管","insurance","医保与集采","antibiotics","抗菌药物与耐药",{"_78":79,"_13":80},"publicId","a223151b-1331-4702-b43f-6c09e254beaf","米内网统计53个第13批集采候选品种","政策/监管","医保/集采","抗菌药物","抗感染","市场准入","对市场","对准入","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653668532&idx=3&sn=846e623fa17a180914068fd8530735c2&chksm=bc740064201af89f64d85a653a66382ed6c06310258371edfa18bc8fa7693ce2afd15c919167&scene=126&sessionid=1793202325#rd","赛柏蓝",{"_91":92,"_93":-5,"_94":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
