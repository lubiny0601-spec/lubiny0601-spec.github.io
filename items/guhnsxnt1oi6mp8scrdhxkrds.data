[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794791090000,"id","guhnsxnt1oi6mp8scrdhxkrds","title","武田发作性睡病药物Orzeyful获DEA批准在美上市，辉瑞Premarin退出加拿大市场","originalTitle","STAT+: Pharmalittle: We’re reading about Lilly conflict questions, a DEA OK for a narcolepsy pill, and more","summary","武田的发作性睡病药物Orzeyful获美国DEA列为Schedule IV管制物质后正式在美上市，成为首个针对该罕见睡眠障碍潜在病因的治疗药物，60片装全规格定价16,500美元。辉瑞则因内部审查决定停止在加拿大销售激素替代疗法药物Premarin，其阴道乳膏自6月起已短缺且不再供货。","reason","source",{"_63":71},"links",{"_58":70},"publishedAt","2026-11-13T14:33:16.000Z","discoveredAt","2026-11-16T00:55:13.597Z","timelineAt","category","industry","tags",[64,67,68,69],"score",10,"selected",false,"channel","news","story","x","readingMode","full","author","Ed Silverman","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","company-news","name","公司动态","neuroscience","神经与精神","神经/精神","武田","辉瑞","https://www.statnews.com/pharmalot/2026/11/13/lilly-conflict-questions-dea-okays-takeda-narcolepsy-pill/?utm_campaign=rss","STAT",{"_73":74,"_75":-5,"_76":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
