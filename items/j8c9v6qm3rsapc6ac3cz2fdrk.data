[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888172000,"id","j8c9v6qm3rsapc6ac3cz2fdrk","title","湖北民康制药吴妍：药企院内院外、线上线下一体化布局策略","originalTitle","药企赚钱：院内线上一体化","summary","湖北民康制药营销中心总经理吴妍在第48届中国医药产业发展大会上提出，药企线上渠道应分核心层、增长层、护城河三层协同布局，而非各平台平均用力。她将医药电商归为货架电商、即时零售、内容电商、私域生态、专业平台五类，主张院内打基础、院外做增量，以患者旅程串联认知至复购六环节。蓝亭叙2026-第15届医药健康互联网大会将于11月28-29日在杭州举办，德开医药、好药师、迈迪森将现场洽谈电商包销与采购。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-05T03:22:30.000Z","discoveredAt","2026-11-05T05:15:56.202Z","timelineAt","category","opinion","tags",[81,82,72],"score",15,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fvIiCZcDgnQs","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","trends","name","行业趋势","opinions","观点与解读","market","市场与销售",{"_78":79,"_13":80},"publicId","c0482ebd-6f01-4721-9298-04323ec39c44","吴妍提出药企渠道三层协同布局策略","观点/解读","市场/销售","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669497&idx=1&sn=097ae27584a1b7bfb439885f4d282d69&chksm=bcccb2d7940e1db0e329a05d61dca117d14c1a75131802e9aab0a7b416a304071f51094194ec&scene=126&sessionid=1793855794#rd","赛柏蓝",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
