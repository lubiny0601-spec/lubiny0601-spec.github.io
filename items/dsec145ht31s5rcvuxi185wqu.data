[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795443792000,"id","dsec145ht31s5rcvuxi185wqu","title","Science：手机移动数据可预测刚果（金）埃博拉疫情走向，应对转向“预测先行”","originalTitle","Science：手机移动数据成埃博拉“预报器”，刚果（金）疫情应对走向“预测先行”","summary","研究人员在《科学》发文提出一种基于手机移动数据的模拟方法，可在检测确认前预测刚果（金）埃博拉新病例可能出现的地点。该模型利用4月24日至5月24日三个疫情中心的人群出行数据，发现实际访客流动比距离或旅行时间更能准确重现早期疫情传播。研究团队称，该工具可帮助官员决定检测试剂和疫苗试验的投放方向。","reason","source",{"_71":84},"links",{"_59":83},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T04:24:55.743Z","timelineAt","category","research","tags",[81,82,74],"score",20,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fqMlD85Rdc2U","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","ai-pharma","AI 制药","infectious","感染与疫苗",{"_78":79,"_13":80},"publicId","4e690bf7-adf9-4807-901d-d6d56d79cfc8","Science刊发手机数据预测埃博拉传播研究","论文/研究","感染/疫苗","https://news.bioon.com/article/974d9659559d.html","生物谷",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
