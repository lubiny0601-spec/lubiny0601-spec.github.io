[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795410147000,"id","vp2jb5mkntfsjjr6md14hbtpm","title","象山县医保局深化宁波长护险试点：2358名失能人员享受待遇，建成7家基层医养中心","originalTitle","【浙江】三年渡海护晚晴 一诺如山暖桑榆","summary","宁波长护险试点启动以来，象山县医保局走访失能家庭4000余户，建立497名村社联系人制度，目前全县2358名失能人员享受长护待遇。全县已建成7家基层医养中心、160张医养床位，家庭照护负担减轻四成以上；2025年处理违规机构11家次，追回基金3.16万元。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-11-16T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.286Z","timelineAt","category","policy","tags",[65,66,67],"score",10,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/9/art_14_23334.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
