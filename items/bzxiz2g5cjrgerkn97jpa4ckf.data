[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795443809000,"id","bzxiz2g5cjrgerkn97jpa4ckf","title","恒瑞医药12款产品通过2026年新版国家医保目录调整，3款新药首次纳入","originalTitle","践行担当守护健康，恒瑞医药12款产品通过新版国家医保目录调整","summary","《国家基本医疗保险、生育保险和工伤保险药品目录（2026年）》于11月14日公布，恒瑞医药共有12款产品通过调整，其中3款新药首次进入医保，覆盖代谢与肿瘤领域，分别为恒格列净瑞格列汀二甲双胍缓释片（II）、鲁兹诺雷钠片和泽美妥司他片。另有艾维达（注射用瑞康曲妥珠单抗）与艾瑞康（羟乙磺酸达尔西利片）的新适应症纳入医保，后者同时完成续约；其余7款产品续约成功保留在目录内。","reason","恒瑞12款产品通过新版医保目录调整，其中3款新药首次纳入，读者可据此了解相关品种的准入变化。","source",{"_65":79},"links",{"_58":78},"publishedAt","2026-11-16T00:00:00.000Z","discoveredAt","2026-11-23T04:25:02.662Z","timelineAt","category","policy","tags",[75,76,74,72,77],"score",72,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61,62,63],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_64":73,"_65":74},{"_64":71,"_65":72},{"_64":69,"_65":70},{"_64":67,"_65":68},{"_64":31,"_65":66},"slug","name","政策与监管","insurance","医保与集采","metabolic","代谢与减重","oncology","肿瘤","hengrui","恒瑞医药","政策/监管","医保/集采","代谢/减重","https://www.hengrui.com/media/detail-1070.html","恒瑞医药·新闻",{"_81":82,"_83":-5,"_84":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
