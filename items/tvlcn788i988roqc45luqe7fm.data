[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443806000,"id","tvlcn788i988roqc45luqe7fm","title","福建省医保局举办“敬老月里话长护 医保服务暖银龄”长护险政策宣传活动","originalTitle","【福建】敬老月里话长护 医保服务暖银龄","summary","10月21日，福建省医保局、福州市医保局在福州鼓楼区举办长期护理保险政策专场宣传活动，设政策宣讲、现场答疑、健康义诊、互动问答、科普展板五大功能区。福州自2021年起开展全国第二批长护险试点，今年6月福建省印发实施方案，明确2028年基本建立覆盖全省的长护险制度，2026年底前省本级、厦门、泉州、三明陆续启动，福州将覆盖范围从职工扩大到城乡居民。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-11-18T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.248Z","timelineAt","category","policy","tags",[65,66,67],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/12/art_14_23357.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
