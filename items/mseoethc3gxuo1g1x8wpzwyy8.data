[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794384593000,"id","mseoethc3gxuo1g1x8wpzwyy8","title","舒巴坦-度洛巴坦对比黏菌素治疗碳青霉烯耐药鲍曼不动杆菌感染达到非劣效","originalTitle","Antibiotic Shows Noninferiority Vs Colistin for Acinetobacter infections","summary","III 期 ATTACK 试验中，舒巴坦-度洛巴坦对比黏菌素治疗碳青霉烯耐药鲍曼不动杆菌感染，主要终点 28 天全因死亡率达到统计学非劣效：舒巴坦-度洛巴坦组 63 例中 12 例（19%），黏菌素组 62 例中 20 例（32%），差异 –13.2%（95% CI –30.0 至 3.5）。","reason","III 期 ATTACK 试验显示该复方在 28 天全因死亡率上不劣于黏菌素，肾毒性更低，可对照耐药鲍曼不动杆菌的用药选择。","source",{"_65":80},"links",{"_58":79},"publishedAt","2023-05-12T17:15:43.184Z","discoveredAt","2026-10-28T01:14:48.440Z","timelineAt","category","clinical","tags",[67,72,73,74,75,76,77,78],"score",48,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":70,"_65":71},{"_63":68,"_65":69},{"_63":31,"_65":67},{"_63":64,"_65":66},"slug","papers","name","论文研究","临床进展","antibiotics","抗菌药物与耐药","fda","美国 FDA","抗菌药物","耐药与院感","论文/研究","抗感染","循证指南","对市场","FDA","https://www.contagionlive.com/view/antibiotic-shows-noninferiority-vs-colistin-for-acinetobacter-infections","Contagion Live·医院感染",{"_82":83,"_84":-5,"_85":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
