[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794205944000,"id","oe38y0k8hxh7ja9rqykh82srz","title","广东联盟取消西安利君康乐氯化钠注射液中选资格","originalTitle","广东省药品交易中心关于取消西安利君康乐制药有限责任公司产品氯化钠注射液中选资格的公告","summary","广东省药品交易中心公告，因陕西省药监部门检查发现西安利君康乐制药有限责任公司药品生产质量管理不符合要求并已暂停其氯化钠注射液（250ml:2.25g、500ml:4.5g，直立式聚丙烯输液袋）生产、销售，依据《广东联盟双氯芬酸等药品接续采购文件（GDYJYPDL202501）》取消该产品在广东联盟双氯芬酸等药品接续采购的中选资格。","reason","陕西药监因生产质量管理问题暂停该产品生产销售，广东联盟据此取消其中选资格，可看集采中选资格的风险处置链条。","source",{"_72":85},"links",{"_60":84},"publishedAt","2026-11-03T16:00:00.000Z","discoveredAt","2026-11-05T05:13:29.209Z","timelineAt","category","policy","tags",[81,82,83],"score",47,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fmw2uB_3dxgE","reportCount",1,"additionalSourceCount",0,{"_70":75,"_72":76},{"_70":31,"_72":74},{"_70":71,"_72":73},"slug","safety","name","安全与质量","政策与监管","insurance","医保与集采",{"_78":79,"_13":80},"publicId","591bb457-e67c-4f78-b041-4fbcdf2e7ee5","广东联盟取消利君康乐氯化钠注射液中选资格","政策/监管","安全/质量","医保/集采","https://www.gdmede.com.cn/announcement/announcement/detail?id=2117903816765476864","广东省药品交易中心·通知公告",{"_87":88,"_89":-5,"_90":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
