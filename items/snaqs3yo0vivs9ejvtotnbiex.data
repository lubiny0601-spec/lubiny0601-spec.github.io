[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795408383000,"id","snaqs3yo0vivs9ejvtotnbiex","title","国家药监局部署优化化学原料药管理及细胞与基因治疗药品审评审批工作","originalTitle","国家药监局部署优化化学原料药管理及细胞与基因治疗药品审评审批等工作","summary","11月13日，国家药监局党组书记、局长黄果主持召开会议，审议通过《化学原料药登记主体变更管理规定》和《关于优化细胞与基因治疗药品审评审批有关事项的公告》，同意两份文件于近日发布实施。前者明确化学原料药批准证书转让的申报要求、工作程序及各相关方责任义务；后者从提高临床研发质量和效率、服务支持重点创新品种、加强注册检验早期介入、强化专家支撑、完善技术标准等方面提出优化举措，覆盖药品全生命周期关键环节。","reason","source",{"_63":74},"links",{"_57":73},"publishedAt","2026-11-13T00:00:00.000Z","discoveredAt","2026-11-16T00:55:14.833Z","timelineAt","category","policy","tags",[71,72,68,66],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":69,"_63":70},{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":30,"_63":64},"slug","name","政策与监管","small-molecule","小分子","cell-gene","细胞与基因治疗","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-13/1110495.shtml","中国食品药品网·要闻",{"_76":77,"_78":-5,"_79":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
