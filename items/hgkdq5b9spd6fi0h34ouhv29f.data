[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384600000,"id","hgkdq5b9spd6fi0h34ouhv29f","title","新疆医保便民服务平台上线“医保小课堂”并新增“看讲解办业务”悬浮按钮","originalTitle","【新疆】新疆医保便民服务平台上线“医保小课堂”","summary","新疆医保便民服务平台上线“医保小课堂”特色便民功能，同步在业务经办页面新增“看讲解办业务”悬浮按钮，实现政策解读与业务办理衔接。“医保小课堂”设于平台首页特色专题栏目下，分为医保宣传、政策解读、办理指南三大板块。悬浮按钮覆盖家庭共济、城乡居民参保登记、异地就医备案等高频业务，点击可跳转对应专属办理指南。","reason","source",{"_69":79},"links",{"_59":80},"publishedAt","2026-10-28T00:00:00.000Z","discoveredAt","2026-10-28T15:38:58.424Z","timelineAt","category","policy","tags",[77,78,79],"score",8,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fbkK4JqPJp-8","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","insurance","医保与集采",{"_74":75,"_13":76},"publicId","c983e581-722f-4c4a-8cce-f5aac3d117f6","新疆医保平台上线医保小课堂及办理讲解按钮","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/10/19/art_14_23151.html",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
