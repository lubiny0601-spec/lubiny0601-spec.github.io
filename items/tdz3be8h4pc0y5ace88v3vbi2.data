[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408365000,"id","tdz3be8h4pc0y5ace88v3vbi2","title","单细胞多组学揭示男性乳腺癌免疫逃逸机制：Y染色体KDM5D缺失抑制cGAS/STING通路","originalTitle","同为乳腺癌，男性患者预后更差！Clinical and Translational Medicine：单细胞多组学揭示Y染色体基因掌控免疫逃逸开关","summary","一项发表于 Clinical and Translational Medicine 的单细胞多组学研究，对比男性乳腺癌与管腔型女性乳腺癌的肿瘤微环境，发现Y染色体基因KDM5D表达缺失会减少M1巨噬细胞和中性粒细胞浸润、缩短总生存期。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T04:24:55.767Z","timelineAt","category","research","tags",[78,73],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f4zSas3Lx3dM","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","oncology","肿瘤",{"_75":76,"_13":77},"publicId","501af9c8-b37a-4b80-9aff-2d484db2d752","男性乳腺癌单细胞多组学研究发表","论文/研究","https://news.bioon.com/article/516d9653520f.html","生物谷",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
