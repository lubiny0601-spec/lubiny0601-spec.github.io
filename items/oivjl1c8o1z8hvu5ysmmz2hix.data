[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384588000,"id","oivjl1c8o1z8hvu5ysmmz2hix","title","本周传染病要闻 Top 5：宾州青少年麻疹死亡、CDC 狂犬病暴露咨询增 17%、头孢曲松安全性与头孢吡肟死亡风险再评估","originalTitle","This Week's Top 5 Infectious Disease News Stories: September 12-September 18, 2026","summary","宾夕法尼亚州一名 18 岁居民死于麻疹并发症急性播散性脑脊髓炎（ADEM），成为该州数周内第四例麻疹死亡。CDC 报告今年夏季狂犬病暴露相关咨询电话增加 17%，并发布健康警示。一项多医院回顾性综述评估了州卫生部门警示后头孢曲松的严重不良事件信号，一项系统综述与贝叶斯 meta 分析则提示头孢吡肟相对其他 β-内酰胺类抗生素可能小幅增加死亡风险。","reason","source",{"_61":71},"links",{"_57":70},"publishedAt","2026-09-19T11:11:12.921Z","discoveredAt","2026-10-27T15:41:44.418Z","timelineAt","category","clinical","tags",[62,65,66,67,68,69],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","临床进展","antibiotics","抗菌药物与耐药","抗菌药物","耐药与院感","抗感染","循证指南","对市场","https://www.contagionlive.com/view/this-week-s-top-5-infectious-disease-news-stories-september-12-september-18-2026","Contagion Live·抗菌药物管理",{"_73":74,"_75":-5,"_76":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
