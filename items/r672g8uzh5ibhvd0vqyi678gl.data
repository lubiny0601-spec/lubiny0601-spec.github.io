[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794384583000,"id","r672g8uzh5ibhvd0vqyi678gl","title","11年“间质性肺炎”激素+免疫抑制剂治疗后病灶反增，TBLB与多学科会诊确诊双肺腺癌（KRAS G12D）","originalTitle","11年的“间质性肺炎”突然加速，激素+免疫抑制剂治疗后病灶反而增多？TBLB与多学科会诊如何突破“一元论”思维局限？","summary","一例52岁男性“间质性肺炎”患者经甲泼尼龙联合吗替麦考酚酯治疗后双肺病灶反而增多，经多学科会诊行TBLB，双肺叶均病理诊断为肺腺癌，检出KRAS G12D变异、PD-L1 TPS<1%。患者有30包年吸烟史及长期油漆暴露史，2014年即发现间质性肺炎改变，提示对免疫抑制治疗反应差、影像进展的ILD患者需警惕“肺炎型”肺癌并及时肺活检。","reason","source",{"_72":84},"links",{"_60":83},"publishedAt","2026-11-08T11:03:31.000Z","discoveredAt","2026-11-09T06:30:50.171Z","timelineAt","category","research","tags",[82,77,75],"score",12,"selected",false,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","姚秀娟 等","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","f1b53ZyQ-meg","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","papers","name","论文研究","respiratory","呼吸","oncology","肿瘤",{"_79":80,"_13":81},"publicId","261cca8e-2595-46a6-9d3c-8103edf0c6c8","间质性肺炎治疗后进展，肺活检确诊双肺腺癌","论文/研究","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604571&idx=1&sn=b34f7ef4dbd70a8088e569312f246b1e&chksm=fc7eb2e4899d03f91957b2ae0bd8e0dfe7f96ba17fd328810e990520d4dce1bfd8de3c4f3292&scene=126&sessionid=1794205843#rd","呼吸界",{"_86":87,"_88":-5,"_89":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
