[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":-5,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":55,"_56":35,"_57":58},"expiresAt",1795408365000,"id","s5arbhrbjw3bdzugowk87eg5u","title","AI浪潮下药企财务如何破局？赛柏蓝11月广州医药财税AI实战研修班","originalTitle","AI浪潮，药企财务咋破局","summary","赛柏蓝定于11月26-27日在广州举办医药财税AI实战研修班，聚焦药企财务的人机协同破局。课程用两天时间带学员建模型、查风险、建体系：掌握三大报表、利润归因、现金流预警等五类核心模型，沿合同、发票、账务与申报开展穿透式核查，并将核查方法封装为可重复执行的技能、配置专属岗位数字同事。全程基于脱敏资料，确保专业结论可核、可复算。","reason","source",{"_71":72},"links",{"_58":70},"publishedAt","2026-11-14T05:35:05.000Z","discoveredAt","2026-11-16T01:03:36.357Z","timelineAt","category","tags",[69],"score",5,"selected",false,"channel","news","story",{"_66":67,"_13":68},"x","readingMode","full","author","body","outline",[],"relatedStories",[65],"topics",[],"indexable","markdownAvailable",true,"group",{"_59":60,"_61":62,"_63":64},"hasTranslation","bodyLanguage","original","factId","f6T1RT8e28lM","reportCount",1,"additionalSourceCount",0,{"_66":67,"_13":68},"publicId","98db10bd-a9fc-4fb1-8f4d-e694812ebae4","赛柏蓝11月广州办医药财税AI研修班","其他","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670661&idx=5&sn=669487a32949f7a0bc5bac1bc542155e&chksm=bc39987989b447180716aad7994b79f6d8c88669326b44f86acdb0514e750cc9e40740290717&scene=126&sessionid=1794790858#rd","name","赛柏蓝",{"_74":75,"_76":-5,"_77":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
