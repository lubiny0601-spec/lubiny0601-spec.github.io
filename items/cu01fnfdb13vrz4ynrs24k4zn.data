[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443807000,"id","cu01fnfdb13vrz4ynrs24k4zn","title","云南构建“事前提醒+事中控制”机制，筑牢医保基金安全防线","originalTitle","【云南】云南构建“事前提醒+事中控制”机制 筑牢医保基金安全防线","summary","云南省医保部门针对回流药倒卖、超量开药等问题，实施“事前提醒、事中控制”模式，首批将司美格鲁肽、复方α-酮酸片等纳入控制范围。自2023年12月实施以来，系统累计分析审核处方约3.1亿张，对213.8万笔不合理超量开药费用实施事中控制转自费结算，涉及金额1.21亿元。全省定点医药机构事前提醒功能接入率超95%。","reason","source",{"_62":70},"links",{"_57":72},"publishedAt","2026-11-18T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.237Z","timelineAt","category","policy","tags",[68,69,70,71],"score",42,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":66,"_62":67},{"_61":64,"_62":65},{"_61":30,"_62":63},"slug","name","政策与监管","insurance","医保与集采","metabolic","代谢与减重","政策/监管","医保/集采","国家医保局","GLP-1","http://www.nhsa.gov.cn/art/2026/11/12/art_14_23359.html",{"_74":75,"_76":-5,"_77":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
