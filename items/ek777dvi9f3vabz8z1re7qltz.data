[{"_1":2,"_3":4},"root",{"_5":63},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795443792000,"id","ek777dvi9f3vabz8z1re7qltz","title","普林斯顿大学神经科学博士生 Eva Yi Xie 遭 ICE 拘留，学术界震动","originalTitle","ICE detention of Princeton scientist rattles academia","summary","普林斯顿大学三年级博士生 Eva Yi Xie 本周四在赴华盛顿参加神经科学学会年会后返程途中被 ICE 拘留，其签证已过期，但律师称她有待审的庇护申请、可合法留美。Xie 研究神经科学与人工智能交叉领域，利用小鼠实验与神经记录大数据集探究大脑不同区域如何协同决策，被同事视为新星。普林斯顿研究生院院长 Rodney D. Priestley 表示校方已为其提供法律代理，希望她能尽快恢复学业。","reason","source",{"_61":62},"links",{"_58":60},"publishedAt","2026-11-20T21:19:27.000Z","discoveredAt","2026-11-23T04:24:56.292Z","timelineAt","category","industry","tags",[59],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","Anil Oza","body","outline",[],"relatedStories",[],"topics",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","其他","https://www.statnews.com/2026/11/20/princeton-researcher-eva-yi-xie-ice-detention-rattles-interational-scholars/?utm_campaign=rss","name","STAT",{"_64":65,"_66":-5,"_67":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
