[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1793889569000,"id","gp38wyy02sytceppt8cx5wuc7","title","FDA 批准 GSK 反义寡核苷酸药物 Hibsago（bepirovirsen）联合现有抗病毒治疗用于慢性乙肝","originalTitle","FDA Approves First-of-Its-Kind Chronic Hepatitis B Treatment","summary","FDA 批准 GSK 的 Hibsago（bepirovirsen）注射液联合现有抗病毒治疗，用于无肝硬化、已接受至少 6 个月抗病毒治疗、HBV 得到抑制且 HBsAg≤3,000 IU/mL 的部分成人慢性乙肝患者，这是 FDA 批准的首个治疗慢性乙肝的反义寡核苷酸。","reason","原文给出获批人群的HBsAg阈值与停药后病毒控制比例，读者可据此判断适用患者范围。","source",{"_67":81},"links",{"_59":80},"publishedAt","2026-10-20T19:40:38.000Z","discoveredAt","2026-10-27T13:29:42.835Z","timelineAt","category","approval","tags",[68,77,70,45,78,79],"score",52,"selected",true,"channel","news","story","x","readingMode","full","author","FDA","body","outline",[],"relatedStories",[],"topics",[60,61,62,63,64],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_65":75,"_67":76},{"_65":73,"_67":74},{"_65":71,"_67":72},{"_65":69,"_67":70},{"_65":66,"_67":68},"slug","approvals","name","获批上市","nucleic","核酸药物","infectious","感染与疫苗","gsk","GSK 葛兰素史克","fda","美国 FDA","感染/疫苗","GSK","罗氏","http://www.fda.gov/news-events/press-announcements/fda-approves-first-its-kind-chronic-hepatitis-b-treatment","FDA 新闻稿",{"_83":84,"_85":-5,"_86":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
