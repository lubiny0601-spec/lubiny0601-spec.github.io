[{"_1":2,"_3":4},"root",{"_5":88},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1793888171000,"id","pnjlx18ya54hc0k99vie6h8b7","title","哈药集团2026年三季报营收123.52亿元、净利润6亿元同比增82.66%","originalTitle","净利暴涨83%！哈药集团战略攻坚成果显现，大健康赛道成绩亮眼，中药、创新药大有可为","summary","哈药集团2026年三季报显示，报告期内实现营收123.52亿元（+2.75%）、归母净利润约6亿元（+82.66%），业绩双增。保健品业务延续高增长，钙铁锌口服液、消食化积口服液、朴雪、盖中盖等经典品种叠加GNC品牌产品矩阵，成为线上渠道增长主力；商业板块批发与零售两端同步调整品种结构。","reason","三季报净利同比增82.66%，原文拆解了保健品线上渠道与工商两端对增长的贡献。","source",{"_72":87},"links",{"_60":86},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T09:52:12.644Z","timelineAt","category","industry","tags",[73,82,77,83,84,85],"score",58,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","readingMode","full","author","body","outline",[],"relatedStories",[78],"topics",[67,68,69],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fh1WUjv_yimo","reportCount",1,"additionalSourceCount",0,{"_70":76,"_72":77},{"_70":74,"_72":75},{"_70":71,"_72":73},"slug","company-news","name","公司动态","market","市场与销售","tcm","中药",{"_79":80,"_13":81},"publicId","a97143fa-a1b6-4d47-991c-0161a2c9b640","哈药集团三季报净利增82.66%","市场/销售","哈药股份","抗感染","企业竞争","https://www.menet.com.cn/info/202611/202611020925152515_151369.shtml","米内网·企业",{"_89":90,"_91":-5,"_92":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
