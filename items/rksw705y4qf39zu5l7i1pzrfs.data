[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793889545000,"id","rksw705y4qf39zu5l7i1pzrfs","title","中疾控第43周监测：流感病毒阳性率14.7%，北方省份上升且H1N1占比过半","originalTitle","最新丨鼻病毒阳性率再次上升；北方省份流感阳性率上升，H1N1占比过半；香港再通报儿童感染流感严重个案；9月新增新冠重症271例、死亡9例","summary","中疾控第43周（10月19日至25日）急性呼吸道传染病哨点监测显示，门急诊流感样病例呼吸道样本阳性率前三位为流感病毒14.7%、鼻病毒11.7%、副流感病毒4.3%，流感样病例百分比为3.7%，南方省份4.5%高于北方省份3.0%。","reason","汇总第43周哨点监测与月度新冠数据，可看到南北方流感、鼻病毒与新冠流行株的当前分布。","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-10-30T11:28:26.000Z","discoveredAt","2026-10-31T03:04:04.200Z","timelineAt","category","policy","tags",[66,67],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","infectious","感染与疫苗","政策/监管","感染/疫苗","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604229&idx=1&sn=9c31d1a3ab41c8f08b11798742844e24&chksm=fc244a5f17cb119ddb3181ee96be963f3d8a43e9ab961a5c38648a07976618300dcca1c421d8&scene=126&sessionid=1793415832#rd","呼吸界",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
