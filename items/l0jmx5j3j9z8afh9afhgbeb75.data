[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793888181000,"id","l0jmx5j3j9z8afh9afhgbeb75","title","江苏医保局明确药品挂网与医保结算联动，未挂网药品费用原则上不予结算","originalTitle","江苏省医疗保障局关于明确药品挂网与医保结算联动有关事项的通知（苏医保发〔2026〕5号）","summary","江苏省医保局发布通知，明确药品挂网与医保结算联动：取消挂网包装数量要求，已在省医保药品目录数据库且属阳光挂网范围的药品须于2026年6月20日前完成挂网，自2026年7月1日起定点医疗机构采购的未挂网药品费用医保基金原则上不予结算。","reason","江苏把挂网与医保结算直接绑定，未挂网或撤网药品的费用原则上不予结算，企业需按节点完成挂网和价格登记。","source",{"_62":72},"links",{"_58":71},"publishedAt","2026-03-26T00:00:00.000Z","discoveredAt","2026-10-27T16:04:45.551Z","timelineAt","category","policy","tags",[66,67,68,69,70],"score",60,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","抗感染","市场准入","http://ybj.jiangsu.gov.cn/art/2026/3/26/art_85482_11750122.html","江苏医保局·阳光采购服务网",{"_74":75,"_76":-5,"_77":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
