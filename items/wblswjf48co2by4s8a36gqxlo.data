[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795410126000,"id","wblswjf48co2by4s8a36gqxlo","title","上海药物所于海军等PNAS发表T细胞–激动剂嵌合体SNTC，靶向TAM实现逻辑门控STING激活","originalTitle","PNAS：让T细胞顺路“点火”，上海药物所于海军等通过把STING激动剂精准投到肿瘤巨噬细胞","summary","中国科学院上海药物研究所于海军等开发T细胞–激动剂嵌合体SNTC，将甘露糖基化STING纳米激动剂共价锚定于过继性T细胞表面，经静脉注射后随T细胞归巢蓄积于肿瘤，响应T细胞表面还原电位升高局部释放，再由TAM内高谷胱甘肽实现AND逻辑门控STING激活。","reason","source",{"_71":83},"links",{"_59":82},"publishedAt","2026-11-23T00:00:00.000Z","discoveredAt","2026-11-23T04:24:55.720Z","timelineAt","category","research","tags",[81,76,74],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fv9PgUiZBED8","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","cell-gene","细胞与基因治疗","oncology","肿瘤",{"_78":79,"_13":80},"publicId","a3647a4b-15e8-4a8e-9022-8d7061177683","上海药物所发表T细胞-激动剂嵌合体研究","论文/研究","https://news.bioon.com/article/0d6496530288.html","生物谷",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
