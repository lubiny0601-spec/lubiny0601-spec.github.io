[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793889569000,"id","ttwmpz47x9a69052nvjv4wp8s","title","FDA 发布处方药配套应用与软件最终指南","originalTitle","FDA Issues Final Guidance on Prescription Drug Apps and Software","summary","FDA 发布最终指南，明确药企开发、分发和标注处方药配套应用的框架，厘清应用内容何时需提交 FDA 审评、何时应在药品说明书中提及。指南区分两类配套软件：与医疗器械连接的应用（如配合哮喘吸入器）一般应在处方标签中说明；独立应用（症状追踪、用药提醒、健康指导工具）需证明对安全有效使用必不可少或具有临床获益才列入标签。多数情况下，配套应用向用户展示的内容按推广材料管理。","reason","source",{"_63":72},"links",{"_58":71},"publishedAt","2026-10-20T13:03:14.000Z","discoveredAt","2026-10-27T13:29:42.854Z","timelineAt","category","policy","tags",[69,44,70],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","FDA","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":30,"_63":64},"slug","name","政策与监管","device-ivd","医疗器械与 IVD","fda","美国 FDA","政策/监管","医疗器械/IVD","http://www.fda.gov/news-events/press-announcements/fda-issues-final-guidance-prescription-drug-apps-and-software","FDA 新闻稿",{"_74":75,"_76":-5,"_77":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
