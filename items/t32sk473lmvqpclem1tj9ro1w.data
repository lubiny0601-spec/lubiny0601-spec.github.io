[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384584000,"id","t32sk473lmvqpclem1tj9ro1w","title","PNAS报道LATS1/2抑制剂NCGC-6782激活YAP通路促进皮肤创面愈合","originalTitle","不用苦等伤口自愈！PNAS报道新型小分子松开再生刹车，驱动皮肤创面快速增殖愈合","summary","PNAS发表研究，通过激酶组筛选获得选择性LATS1/2小分子抑制剂NCGC-6782，可激活YAP信号通路促进皮肤创面增殖性愈合。该分子以AKT抑制剂AT-7867为先导经骨架跃迁优化得到，对绝大多数人类激酶具20倍以上选择窗口，口服生物利用度良好。小鼠全层皮肤缺损模型中隔日局部给药显著缩短愈合周期，未出现体重下降等全身性毒性。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-09T06:26:04.640Z","timelineAt","category","research","tags",[78,73],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fAuB7dPFwN_g","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","small-molecule","小分子",{"_75":76,"_13":77},"publicId","7889d9b8-19cb-4f5e-8601-3b53b3054cbf","PNAS报道LATS1/2抑制剂NCGC-6782促创面愈合","论文/研究","https://news.bioon.com/article/9209961982e6.html","生物谷",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
