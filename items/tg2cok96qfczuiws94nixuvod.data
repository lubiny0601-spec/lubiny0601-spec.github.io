[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794205944000,"id","tg2cok96qfczuiws94nixuvod","title","NMPA 批准艺妙神州泊基奥仑赛注射液（赛泊华）上市，用于复发或难治性大B细胞淋巴瘤","originalTitle","国家药监局批准泊基奥仑赛注射液上市","summary","国家药监局批准北京艺妙神州生物医药股份有限公司申报的泊基奥仑赛注射液（商品名：赛泊华）上市，用于经过二线或以上系统性治疗后成人复发或难治性大B细胞淋巴瘤患者，包括弥漫性大B细胞淋巴瘤非特指型、3b级滤泡性淋巴瘤和高级别B细胞淋巴瘤。该品种的上市为相关患者提供了新的治疗选择。","reason","国内又一款 CAR-T 产品获批，适应症覆盖二线及以上复发难治大B细胞淋巴瘤的多个亚型。","source",{"_65":75},"links",{"_58":74},"publishedAt","2026-11-06T00:00:00.000Z","discoveredAt","2026-11-09T06:26:07.617Z","timelineAt","category","approval","tags",[66,70,68,73],"score",62,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","approvals","name","获批上市","cell-gene","细胞与基因治疗","oncology","肿瘤","nmpa","中国 NMPA","NMPA","https://www.cnpharm.com/c/2026-11-06/1110085.shtml","中国食品药品网·要闻",{"_77":78,"_79":-5,"_80":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
