[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791091000,"id","a3bgcq3sjvhke5vmoq4edwn6b","title","赛柏蓝11月19-20日上海举办医药企业商务体系重构与销售增长实战班","originalTitle","医药企业商务体系重构与销售增长实战班「11月19-20日 上海」","summary","赛柏蓝定于11月19-20日在上海举办医药企业商务体系重构与销售增长实战班，聚焦集采常态化、合规趋严与院内外市场格局重构下的商务体系承压问题。课程围绕商务战略定位、集采保供履约管控、商业分级治理与控价防窜、院外增量激活，以及AI工具搭建商务组织与绩效体系等议题展开。","reason","source",{"_69":78},"links",{"_59":77},"publishedAt","2026-11-12T07:28:06.000Z","discoveredAt","2026-11-12T14:33:22.736Z","timelineAt","category","industry","tags",[75,76],"score",8,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fwmMr-z1FWTs","reportCount",2,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","insurance","name","医保与集采",{"_72":73,"_13":74},"publicId","ed88d38b-ade0-436e-ba24-8b6d6fd90c98","赛柏蓝11月19-20日上海办医药商务实战班","其他","医保/集采","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670439&idx=5&sn=3b439276b3aa46e5f59eb1555daf452c&chksm=bca63823ea6031443c63c9abe5b563fbe3c2e61a88893051c67dc0c93c2bdcdd0e4c84d5e416&scene=126&sessionid=1794493868#rd","赛柏蓝",{"_80":81,"_82":-5,"_83":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
