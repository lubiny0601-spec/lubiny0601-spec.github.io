[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1795410125000,"id","zvcswwfefxttd1xlg5v4xroyw","title","康方生物古莫奇单抗获批活动性强直性脊柱炎新适应症","originalTitle","康方：古莫奇单抗获批新适应症，活动性强直性脊柱炎","summary","11月13日，国家药监局官网显示康方生物自主研发的IL-17A单抗古莫奇单抗（AK111）获批新适应症，用于活动性强直性脊柱炎，这是继2026年6月斑块状银屑病之后该药的第2项适应症。","reason","原文梳理了古莫奇单抗两项适应症的获批节奏与康方自免管线梯队，也点出IL-17赛道已有7款单靶点药物获批的竞争格局。","source",{"_74":90},"links",{"_61":89},"publishedAt","2026-11-14T01:51:16.000Z","discoveredAt","2026-11-16T01:00:56.400Z","timelineAt","category","approval","tags",[75,86,87,81,88],"score",58,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","药事达","body","outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fR5hupPID7io","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","approvals","name","获批上市","antibody","抗体与双抗","immunology","自免与炎症","akeso","康方生物",{"_83":84,"_13":85},"publicId","695ecd5a-5c90-472a-900b-c083c86edce2","古莫奇单抗获批活动性强直性脊柱炎新适应症","自免","抗体/双抗","NMPA","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699657&idx=2&sn=e8a916ccd6df30972a28140fdd30b85a&chksm=bc2438528bf97b90a3f97f5df5ac423b3179d7984f19e1fba6122dab8a242810e5a5f4127022&scene=126&sessionid=1794790832#rd","医药云端工作室",{"_92":93,"_94":-5,"_95":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
