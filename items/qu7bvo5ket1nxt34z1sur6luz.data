[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794791089000,"id","qu7bvo5ket1nxt34z1sur6luz","title","辽宁对第12批国采非中选药品启动红黄标价格标识","originalTitle","辽宁：第12批国采未中选的各类品种，红黄标","summary","辽宁省公共资源交易中心11月10日通知，将于11月26日对第12批国采同通用名非中选其他厂牌药品价格进行红黄标风险标识。已过评未中选品种高于全国最高中选价1.8倍为黄标、3倍为红标；未过评未中选品种高于全国最高中选价即为黄标，红标按黄标价格除以1.8再乘3计算；参比制剂以同通用名药最高挂网价为锚点执行黄标预警，暂不执行红标。被标识企业可随时申请降价，平台按挂网价格自动调整颜色标识。","reason","辽宁对第12批国采非中选药品按倍数关系标红黄标，未过评品种的锚点规则与过评品种不同。","source",{"_70":83},"links",{"_60":82},"publishedAt","2026-11-11T12:04:00.000Z","discoveredAt","2026-11-12T14:31:05.348Z","timelineAt","category","policy","tags",[78,79,80,81],"score",58,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fJYxi7vkV5uI","reportCount",2,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","政策与监管","insurance","医保与集采",{"_75":76,"_13":77},"publicId","55012e0b-480c-4ba7-a599-e18e62420ca8","辽宁对第12批国采非中选药品实施红黄标价格标识","政策/监管","医保/集采","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699573&idx=1&sn=55754ebf39ce8b27008a5c28ae604b29&chksm=bc9833870ab8e69ef237fdbb30754d4e36af23080f55a138d51765c70e57eb31fb04d68650b6&scene=126&sessionid=1794493842#rd","医药云端工作室",{"_85":86,"_87":-5,"_88":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
