[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":24,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":-5,"_39":-5,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":35,"_52":53,"_54":-5,"_55":35,"_56":57},"expiresAt",1794384592000,"id","u1dsgdr8pwy49l40xi5oroabs","title","【齐星论道2.0】微生物检验质量与标准化建设行动落地-武汉站会议纪要","originalTitle","summary","“齐星论道2.0——微生物检验质量与标准化建设行动”学术会议于5月22日-23日在武汉以线下会议+线上直播形式举行，聚焦检验结果报告与解读。会议围绕铜绿假单胞菌治疗药物选择、2025年湖北省细菌耐药监测数据（涵盖全年33万余株临床菌株）、药敏报告解读及耐药机制诊疗对策展开授课，并组织学员赴同济医院微生物室开展头孢他啶阿维巴坦MIC自动化仪器法等实操训练。","reason","source",{"_61":69},"links",{"_57":68},"publishedAt","2026-05-27T07:47:04.000Z","discoveredAt","2026-11-02T13:05:49.397Z","timelineAt","category","industry","tags",[63,64,65,66,67],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","SCM","body","outline",[],"relatedStories",[],"topics",[58],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_59":60,"_61":62},"slug","antibiotics","name","抗菌药物与耐药","其他","耐药与院感","抗感染","专家会议","对市场","https://mp.weixin.qq.com/s?__biz=MzA5MTExNzgwMA==&mid=2651005836&idx=1&sn=85aa9e1fa185a5d13e9137e6739036a5&chksm=8abb34f4bc2f8e1a68aa5122425222e466539da4da25777f0ade06aae4e02f1cf54ef38b0118&scene=126&sessionid=1793624721#rd","CHINET 中国细菌耐药监测网",{"_71":72,"_73":-5,"_74":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
