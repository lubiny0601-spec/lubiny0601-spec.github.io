[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888173000,"id","couxpa4sf0h6fk6309h221hu2","title","九州通与昭衍新药、昭衍生物、生仝智能签署战略合作，打造CRO+CDMO+CSO一体化药物价值服务新模式","originalTitle","九州通携手昭衍，打造一体化药物价值服务新模式","summary","2026年10月29日，九州通与昭衍新药、昭衍生物、生仝智能签署《战略合作协议》，在药物研发、药物销售、早期项目投资、AI医疗及生物医药产业生态园区五大方向开展合作，打通\"研发—临床—注册—商业化\"闭环。九州通将借此优先锁定创新药、高端仿制药等优质品种的销售及代理权。合作各方将共同打造CRO+CDMO+CSO一体化药物价值服务新模式。","reason","source",{"_71":85},"links",{"_59":84},"publishedAt","2026-11-04T00:00:00.000Z","discoveredAt","2026-11-05T05:13:26.472Z","timelineAt","category","industry","tags",[81,72,82,83],"score",40,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fZ69uN7O1EN0","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","company-news","name","公司动态","deals","交易与授权","cxo","CXO 与外包",{"_78":79,"_13":80},"publicId","e361bca3-9bbc-40a5-9015-e4bcff5cad1e","九州通与昭衍新药等签署战略合作协议","交易/授权","CXO","九州通","https://www.menet.com.cn/info/202611/202611040944134413_151393.shtml","米内网·企业",{"_87":88,"_89":-5,"_90":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
