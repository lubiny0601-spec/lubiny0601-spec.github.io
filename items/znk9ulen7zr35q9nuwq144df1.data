[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794205946000,"id","znk9ulen7zr35q9nuwq144df1","title","复旦大学宋少莉等发现谷氨酰胺摄取是肝癌免疫逃逸的\"隐形检查点\"，¹⁸F-FGln PET/CT可预测免疫治疗应答","originalTitle","Adv Sci：复旦大学宋少莉等发现谷氨酰胺摄取是肝癌免疫逃逸的“隐形检查点”","summary","复旦大学宋少莉、Liu Fei团队在Advanced Science发表研究，发现谷氨酰胺摄取是肝细胞癌免疫逃逸的检查点。小鼠HCC模型中，¹⁸F-FGln PET/CT高摄取肿瘤Slc1a5表达升高、对抗PD-1治疗应答差，低摄取肿瘤更敏感；敲低Slc1a5或使用V-9302降低Gln摄取可提升抗PD-1疗效。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-09T06:26:04.680Z","timelineAt","category","research","tags",[78,73],"score",17,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fLba1CFcSV_o","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","oncology","肿瘤",{"_75":76,"_13":77},"publicId","c5a5ffec-f9b2-4a06-bb54-fb4d42b66785","复旦团队发表肝癌谷氨酰胺摄取与免疫逃逸研究","论文/研究","https://news.bioon.com/article/cc15962660b7.html","生物谷",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
