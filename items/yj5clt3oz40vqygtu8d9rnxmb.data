[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384596000,"id","yj5clt3oz40vqygtu8d9rnxmb","title","翰森制药荣膺2026《中国医药创新指数》年度领先企业，创新力榜第三、发明力榜第六","originalTitle","翰森制药 | 荣膺 2026《中国医药创新指数》年度领先企业","summary","翰森制药获评2026《中国医药创新指数》\"年度领先企业\"，位列创新力榜单第三位、发明力榜单第六位。公司已有7款创新药商业化落地，创新药与合作产品收入占比超85%；超过40个候选创新药项目正在开展超70项临床试验。公司先后与GSK、默沙东、罗氏、再生元及Glenmark达成授权合作，首付款超10亿美元，潜在交易价值超275亿美元。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-01T16:00:00.000Z","discoveredAt","2026-11-02T09:52:10.414Z","timelineAt","category","industry","tags",[73,71,78],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fP_clPZdW4bs","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","trends","name","行业趋势","company-news","公司动态",{"_75":76,"_13":77},"publicId","ef67fc70-87e9-43b5-9720-aa64e62ea02d","翰森制药获评2026中国医药创新指数年度领先企业","翰森制药","https://www.hansoh.cn/news/news-detail-514103.htm","翰森制药·公司新闻",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
