[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889546000,"id","opx9a0dtxhyz10rkcb5joi60e","title","东阳光集团采购百余个腾讯WorkBuddy账号，医药营销AI技能包实战班11月广州开班","originalTitle","医药营销，AI接手了","summary","东阳光集团已采购百余个腾讯WorkBuddy企业版账号，覆盖信息、法规、市场多个部门，将药品审评报告结构化提取、竞品资料比对等约40小时人工工作压缩至约2小时。赛柏蓝将于11月26-27日在广州举办医药营销全场景AI技能包搭建与人机协同实战班，基于腾讯WorkBuddy，两天内搭建拜访复盘、竞品监测、数据核对等技能包。","reason","source",{"_70":79},"links",{"_59":78},"publishedAt","2026-11-04T10:45:03.000Z","discoveredAt","2026-11-05T05:16:14.117Z","timelineAt","category","industry","tags",[73,71],"score",10,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fnnPtgtJd1Vs","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","trends","name","行业趋势","company-news","公司动态",{"_75":76,"_13":77},"publicId","5d6949fb-4614-4fed-9fe0-39130acd6b16","东阳光采购百余WorkBuddy账号，赛柏蓝广州开实战班","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669472&idx=5&sn=de4e6ac3b48c1b335be369e3b4088887&chksm=bc303d71ad505298b2e57325ceaacf9f47cccac01bf13e4fda5c181711c0e1b0191c8b425f14&scene=126&sessionid=1793855794#rd","赛柏蓝",{"_81":82,"_83":-5,"_84":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
