[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793889549000,"id","x2vnyo3v5ssi8dvtdnx2wgue1","title","东北制药总经理蔡永刚上任不足两年卸任，方大集团朱旻接任","originalTitle","80年老牌药企，总经理卸任","summary","东北制药10月28日公告，总经理蔡永刚因工作调整辞去董事、总经理职务，任职不足两年，由方大集团商业板块中兴商业背景的朱旻接任。2026年前三季度公司营收48.55亿元、同比下降11.37%，扣非归母净利润约0.69亿元、同比下降48.16%。公司同期布局细胞治疗，DCTY1102为国内首个进入I期临床的靶向KRAS G12D的TCR-T细胞药物。","reason","source",{"_71":85},"links",{"_60":84},"publishedAt","2026-10-29T11:17:10.000Z","discoveredAt","2026-10-29T14:00:53.120Z","timelineAt","category","industry","tags",[72,79,80,81,82,83],"score",40,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","晓琳","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fQhk7VRm1_Ec","reportCount",1,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","company-news","name","公司动态","antibiotics","抗菌药物与耐药",{"_76":77,"_13":78},"publicId","eac72678-a66f-4f16-a521-9a2c9c4775c0","东北制药总经理蔡永刚辞职，朱旻接任","抗菌药物","抗感染","企业竞争","对市场","东北制药","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653668642&idx=2&sn=811434f0e0edc9be8547ab14bb5e4691&chksm=bc595c490bfb0c2f4a623c0ea162949ac4b9680427bfc68a8414232ed1a54a09e8fed8c26097&scene=126&sessionid=1793282443#rd","赛柏蓝",{"_87":88,"_89":-5,"_90":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
