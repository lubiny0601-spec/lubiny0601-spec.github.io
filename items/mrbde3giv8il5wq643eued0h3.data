[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205965000,"id","mrbde3giv8il5wq643eued0h3","title","福建厦门优化医保结算流程：拨付时限最短1个工作日，覆盖2000多家定点医药机构","originalTitle","福建厦门优化医保结算流程跑出“加速度”","summary","福建厦门市医保部门将医保基金拨付时限压缩至最短1个工作日，覆盖全市2000多家定点医药机构，实现门诊、住院、生育医疗、救助与药店购药费用“日报日审日拨”。同时建立按分值月度预清算机制，将年度清算的“结余留用、超支分担”提前至月度拨付，并连续3年较全国平均水平提前两个月完成年度清算。今年2月完成2025年度清算，比往年提前超60天，全年拨付医保资金超110亿元。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-10-25T00:00:00.000Z","discoveredAt","2026-11-09T06:26:15.528Z","timelineAt","category","policy","tags",[65,66,67],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/10/25/art_287_23314.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
