[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1794384586000,"id","qrfg2990hsobj651n80tigo6s","title","安徽拟规定未挂网药品医保不予结算，2027年起执行","originalTitle","安徽：“未挂网，不结算”！江苏、河北早已执行","summary","安徽省医保局10月28日发布《关于明确药品挂网与医保结算联动有关事项的通知（征求意见稿）》，拟自2027年1月1日起对定点医疗机构采购的未挂网药品费用原则上不予医保结算，撤网药品给1个月过渡期，意见征集截止11月10日。","reason","安徽拟将挂网与医保结算绑定，文中对比江苏、河北的执行节奏与覆盖范围差异，可看清各省准入收紧的推进路径。","source",{"_63":73},"links",{"_59":72},"publishedAt","2026-10-28T08:45:10.000Z","discoveredAt","2026-11-02T13:59:21.392Z","timelineAt","category","policy","tags",[67,68,69,70,71],"score",72,"selected",true,"channel","news","story","x","readingMode","full","author","子非鱼","body","outline",[],"relatedStories",[],"topics",[60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":65,"_63":66},{"_62":31,"_63":64},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699395&idx=1&sn=e73eaf0e5c9063d11153b2f78c85a1fa&chksm=bc85d57267dcd99b7283433eea43e35f7e771505b0cea413385596b390dadb5adaaae4c70a75&scene=126&sessionid=1793627945#rd","医药云端工作室",{"_75":76,"_77":-5,"_78":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
