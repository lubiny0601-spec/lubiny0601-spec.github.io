[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1793888172000,"id","j5c7vw39t5336c5kyg2ekhqa5","title","全国急性呼吸道传染病哨点监测：第43周流感病毒阳性率14.7%，南方高于北方","originalTitle","全国急性呼吸道传染病哨点监测情况（2026年第43周）","summary","2026年第43周（10月19日—10月25日），全国216家多病原监测哨点医院门急诊流感样病例呼吸道样本阳性率前三位为流感病毒（14.7%）、鼻病毒（11.7%）、副流感病毒（4.3%），住院严重急性呼吸道感染病例为鼻病毒（11.0%）、流感病毒（4.9%）、人偏肺病毒（4.4%）。","reason","第43周哨点监测给出流感、鼻病毒等病原体的南北差异与年龄分布，可作为呼吸道用药需求的先行参考。","source",{"_70":81},"links",{"_60":80},"publishedAt","2026-10-29T00:00:00.000Z","discoveredAt","2026-10-29T14:00:45.454Z","timelineAt","category","policy","tags",[78,79],"score",58,"selected",true,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fH5jonOeOto0","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":31,"_70":71},"slug","name","政策与监管","infectious","感染与疫苗",{"_75":76,"_13":77},"publicId","f9178773-ec2f-4f96-8872-ff76227949fd","中国疾控发布第43周急性呼吸道传染病哨点监测","政策/监管","感染/疫苗","https://www.chinacdc.cn/jksj/jksj04_14275/202610/t20261029_1842566.html","中国疾控·急性呼吸道传染病哨点监测",{"_83":84,"_85":-5,"_86":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
