[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795410155000,"id","zzn9bk18aa9jmgym305cc367v","title","CDE发布修订版《化学药生物等效性试验备案范围和程序》，2027年2月1日起施行","originalTitle","化学药BE试验备案范围和程序更新，明年2月1日起施行","summary","国家药监局药品审评中心11月6日发布修订后的《化学药生物等效性试验备案范围和程序》，自2027年2月1日起施行，进一步明确BE试验备案范围并完善备案程序。新规细化三类应备案情形（仿制原研、支持变更、一致性评价），并明确以临床终点为BE评价指标或存在潜在安全性风险需技术评价的药品应按《药品注册管理办法》提出药物临床试验申请。","reason","source",{"_69":80},"links",{"_59":79},"publishedAt","2026-11-11T00:00:00.000Z","discoveredAt","2026-11-11T14:04:23.175Z","timelineAt","category","policy","tags",[77,78],"score",36,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fJvLs9B2qT2c","reportCount",2,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","nmpa","中国 NMPA",{"_74":75,"_13":76},"publicId","37895b05-9ba4-4a60-b596-04b26ea94998","CDE修订化学药BE试验备案范围与程序","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-11/1110337.shtml","中国食品药品网·要闻",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
