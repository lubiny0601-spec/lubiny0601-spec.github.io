[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1794791091000,"id","cw9lnptbd6qeyixkgldm1od3l","title","急性评分之外的“隐形杀手”：重症临床实践中的ICU共病管理","originalTitle","看似轻微的急性打击为何足以成为“最后一根稻草”？急性评分之外的“隐形杀手”？——结合重症临床实践系统梳理ICU与共病","summary","约80%的ICU患者合并≥2种慢性疾病，MIMIC-Ⅲ队列（n=36390）中该比例为77.3%，共病与急性疾病严重度共同决定短期预后。FROG-ICU研究（n=1400）显示出院时Charlson共病指数（CCI）是ICU出院后1年死亡的最强预测因子，出院后7天AUC达0.70，优于SAPS-Ⅱ（0.63）和SOFA（0.61）。","reason","source",{"_70":79},"links",{"_60":78},"publishedAt","2026-11-11T11:05:00.000Z","discoveredAt","2026-11-12T14:31:04.815Z","timelineAt","category","research","tags",[76,77],"score",12,"selected",false,"channel","news","story",{"_73":74,"_13":75},"x","readingMode","full","author","詹以安","body","outline",[],"relatedStories",[72],"topics",[67],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","foQGI7cIV14Q","reportCount",1,"additionalSourceCount",0,{"_68":69,"_70":71},"slug","papers","name","论文研究",{"_73":74,"_13":75},"publicId","9eaeee5a-ff3f-4a9b-9e48-0c5430c64b3e","ICU共病管理：八成患者合并多种慢病","论文/研究","其他","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604714&idx=2&sn=a66340359bbc3a786f324f31aa0e1c0b&chksm=fcf802ea6fc89cb467ad08f9cdeb05a305542456193b67b409ab55085746847f574cb03829e4&scene=126&sessionid=1794493844#rd","呼吸界",{"_81":82,"_83":-5,"_84":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
