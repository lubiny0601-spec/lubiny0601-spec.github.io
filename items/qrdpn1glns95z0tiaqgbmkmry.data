[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793888174000,"id","qrdpn1glns95z0tiaqgbmkmry","title","中期选举健康议题盘点：民主党夺回两院，MAHA运动受挫","originalTitle","Top health takeaways from the midterm elections","summary","民主党在中期选举中赢得国会两院控制权，在得克萨斯、堪萨斯、南卡罗来纳等深红州取得胜利，被视为对共和党医疗改革议程的否定。多名医生和科学家候选人赢得关键席位，儿科医生Annie Andrews拿下南卡罗来纳州参议院席位。与MAHA结盟的参议员Roger Marshall等候选人落败，MAHA运动影响力明显减弱。","reason","source",{"_63":69},"links",{"_58":68},"publishedAt","2026-11-04T12:15:08.000Z","discoveredAt","2026-11-05T05:13:22.024Z","timelineAt","category","opinion","tags",[67,64],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","Daniel Payne, Anil Oza, Sarah Todd, Bob Herman, Chelsea Cirruzzo,and John Wilkerson","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","trends","name","行业趋势","opinions","观点与解读","观点/解读","https://www.statnews.com/2026/11/04/health-news-midterm-elections-2026-democrats-control-congress/?utm_campaign=rss","STAT",{"_71":72,"_73":-5,"_74":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
