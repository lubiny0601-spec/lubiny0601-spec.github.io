[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794205947000,"id","c4w6q4m85z6l1u00nvboke9v7","title","养生堂药业复方马其通胶囊厂家直招：独家通用名中成药，4周中医证候总有效率72.3%","originalTitle","复方马其通胶囊厂家直招","summary","养生堂药业对独家中成药复方马其通胶囊（国药准字Z20040068）开展厂家直招，该品为非医保、非基药的自费定位品种，再注册有效期至2030年7月26日。产品仅含水蛭、土鳖虫两味，主打抗凝、抗栓与改善血液流变性，4周中医证候总有效率72.3%、心绞痛总改善率61.3%，可覆盖心内、老年、中医等六大科室。招商对接通过「小蓝推荐官AI」小程序进行，平台入驻与上架免费、不抽佣金。","reason","source",{"_71":83},"links",{"_59":82},"publishedAt","2026-11-04T23:00:00.000Z","discoveredAt","2026-11-05T05:16:01.274Z","timelineAt","category","industry","tags",[81,74,76],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fTVFFbOg5wN4","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","market","name","市场与销售","tcm","中药","cardiovascular","心血管",{"_78":79,"_13":80},"publicId","59dfaa96-ded0-4ddf-9548-bb19727843d2","养生堂药业在赛柏蓝平台直招复方马其通胶囊","市场/销售","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669471&idx=1&sn=47106214e3979c0ac32fb2e262d8f032&chksm=bce02771c87d7f6c552276d7ad0661e1c5e86e0d0715f89f673e4b6107c836fef5fed5f6777d&scene=126&sessionid=1793855794#rd","赛柏蓝",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
