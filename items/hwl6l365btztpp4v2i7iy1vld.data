[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443805000,"id","hwl6l365btztpp4v2i7iy1vld","title","武汉\"医保共治随手拍\"吸纳8182名环卫工，凭广告照片侦破跨省\"回流药\"分销案","originalTitle","【长江日报微信公众号】环卫工随手拍下广告照片，牵出跨省“回流药”分销案件，武汉抓获多名涉案人员","summary","武汉依托\"医保共治随手拍\"活动吸纳8182名环卫工人、城管协管员担任街头医保监督员，上报医保套现类小广告线索，街面广告存量与新发量降幅明显。江汉区依据环卫工拍下的广告照片，联合公安开展大数据研判并借助药品追溯码溯源，成功侦破跨省\"回流药\"分销案件，抓获多名涉案人员。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-11-20T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.297Z","timelineAt","category","policy","tags",[65,66,67],"score",40,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/11/19/art_14_23465.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
