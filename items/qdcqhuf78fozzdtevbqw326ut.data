[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794205947000,"id","qdcqhuf78fozzdtevbqw326ut","title","破谣 | 吸入药早上吸比晚上吸效果好？单支扩剂宜晚上吸，双支扩剂与三联药物时间不限","originalTitle","破谣 | 吸入药早上吸比晚上吸效果好？","summary","吸入药并非早上吸效果更好：以噻托溴铵为代表的单支扩剂最初建议晚上吸，使药效峰值与夜间迷走神经张力升高、气道易痉挛的时段对齐。双支扩剂（如茚达特罗格隆溴铵）和三联药物（如氟替美维）药效覆盖24小时，一天中任何时间吸均可，关键是固定时间每天坚持。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-05T04:12:36.000Z","discoveredAt","2026-11-05T05:15:42.552Z","timelineAt","category","opinion","tags",[78,73],"score",8,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f5Wf7ESoV1qw","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","respiratory","呼吸",{"_75":76,"_13":77},"publicId","af0c2bf6-bf62-4829-8583-aaba7eaa3066","吸入药并非早上吸更好，单支扩剂宜晚上吸","观点/解读","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604445&idx=3&sn=92650b4efe5d4ba069d0e602acb79b8e&chksm=fc730d46e61a16b0896798b3414b9f6c6cd3492b39a7063b749bb8195b038783b87aa4d75e76&scene=126&sessionid=1793855735#rd","呼吸界",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
