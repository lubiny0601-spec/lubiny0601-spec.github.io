[{"_1":2,"_3":4},"root",{"_5":75},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384588000,"id","gum36ylumtgzmo1rtooeu81qa","title","播客：gyrA 基因分型指导淋病治疗，让环丙沙星重回临床","originalTitle","Pathogen to Diagnosis: Using gyrA Genotyping to Revive Ciprofloxacin","summary","环丙沙星因耐药率在2000年代初达到5%而被弃用，如今gyrA基因第91位密码子单点突变检测以98%敏感性和98%特异性预测耐药，可指导该药重新用于淋病。美国约60%淋病奈瑟菌株仍对环丙沙星敏感，3项临床研究中各解剖部位（含咽部）治愈率达100%或超过98%。3款gyrA检测产品的510(k)大型试验即将结束，FDA clearance预计2027年初落地，报销是另一障碍。","reason","source",{"_62":74},"links",{"_57":73},"publishedAt","2026-09-15T13:00:00.000Z","discoveredAt","2026-10-27T15:41:44.435Z","timelineAt","category","opinion","tags",[66,67,68,69,70,71,72],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","opinions","name","观点与解读","antibiotics","抗菌药物与耐药","观点/解读","抗菌药物","耐药与院感","抗感染","专家会议","对品牌","对市场","https://www.contagionlive.com/view/pathogen-diagnosis-gyra-genotyping-revive-ciprofloxacin","Contagion Live·抗菌药物管理",{"_76":77,"_78":-5,"_79":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
