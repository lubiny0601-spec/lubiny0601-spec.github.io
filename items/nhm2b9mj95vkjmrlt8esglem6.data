[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384599000,"id","nhm2b9mj95vkjmrlt8esglem6","title","上海提示冠脉支架国家集采第二轮接续结果执行前未中选产品挂网价申报","originalTitle","关于本市执行国家组织冠脉支架集采第二轮接续结果的工作提示（二）","summary","上海拟于2026年11月中下旬执行国家组织冠脉支架集采第二轮接续结果，未中选产品企业须在2026年11月10日前向市药事所递交加盖公章的挂网价申报纸质材料。申报材料包括法人授权书、挂网价申报函、最低省级平台挂网价截图及价格承诺书等；无外省市价格者需填报成本价并递交无外省市价格承诺书。","reason","source",{"_70":84},"links",{"_59":83},"publishedAt","2026-10-28T00:00:00.000Z","discoveredAt","2026-10-28T15:39:02.573Z","timelineAt","category","policy","tags",[80,81,82],"score",12,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f0TfSGua2Np4","reportCount",1,"additionalSourceCount",0,{"_69":74,"_70":75},{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","政策与监管","insurance","医保与集采","device-ivd","医疗器械与 IVD",{"_77":78,"_13":79},"publicId","fe6c65c7-2cf5-433f-ab04-0aaaae7a7d45","上海冠脉支架接续结果11月执行，未中选产品须申报挂网价","政策/监管","医保/集采","医疗器械/IVD","https://www.smpaa.cn/xxgk/gggs/2026/10/28/25534.shtml","上海阳光医药采购网",{"_86":87,"_88":-5,"_89":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
