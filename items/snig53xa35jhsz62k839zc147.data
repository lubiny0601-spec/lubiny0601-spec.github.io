[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795443790000,"id","snig53xa35jhsz62k839zc147","title","石四药前三季度营收35.2亿港元增13.5%，211个过评产品与50余品种备战第十三批集采","originalTitle","大输液龙头走出低谷，何以守住35亿基本盘？","summary","石家庄四药2026年前三季度营业额35.2亿港元，同比增长13.5%，股东应占溢利4.6亿港元，同比增长15.5%，建立在2025年低基数之上。输液板块四大类产品合计占营收六成以上，其中直立式软袋输液5.61亿港元增51.3%；原料药6.06亿港元增22.1%。公司已有211个产品过评/视同过评，38个品种在已开展的十一批化药集采中中选，目前50多个品种基本满足第十三批集采纳入条件。","reason","以石四药前三季度分板块数据为切口，拆解输液企业靠治疗性品种与过评储备对冲集采降价的路径。","source",{"_65":78},"links",{"_58":77},"publishedAt","2026-11-17T00:00:00.000Z","discoveredAt","2026-11-23T04:24:56.914Z","timelineAt","category","industry","tags",[66,73,74,75,76],"score",60,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","company-news","name","公司动态","market","市场与销售","pipeline","研发管��","insurance","医保与集采","市场/销售","医保/集采","研发管线","其他","https://www.menet.com.cn/info/202611/20261117090514514_151451.shtml","米内网·企业",{"_80":81,"_82":-5,"_83":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
