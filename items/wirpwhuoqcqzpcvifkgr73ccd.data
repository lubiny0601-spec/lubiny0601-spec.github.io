[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791091000,"id","wirpwhuoqcqzpcvifkgr73ccd","title","药企业务部不敢用AI，赛柏蓝11月杭州开课讲医药企业AI知识库搭建","originalTitle","药企业务部，不敢用AI...","summary","药企引入智能体后业务部门因不信任答案而不敢使用，根源在于智能体拿不到企业专属的产品资料、注册证照、GSP文件、临床数据等上下文。赛柏蓝定于11月28-29日在杭州举办医药企业AI知识库搭建与组织运营实战班，以实战工作坊形式讲解知识库的建、治、用、管。","reason","source",{"_72":73},"links",{"_59":71},"publishedAt","2026-11-12T12:00:34.000Z","discoveredAt","2026-11-12T14:31:23.871Z","timelineAt","category","industry","tags",[70],"score",8,"selected",false,"channel","news","story",{"_67":68,"_13":69},"x","readingMode","full","author","body","outline",[],"relatedStories",[66],"topics",[],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f2bqf6Op3_Ns","reportCount",2,"additionalSourceCount",0,{"_67":68,"_13":69},"publicId","fc49f268-179c-4427-aeda-ca31765a754a","赛柏蓝杭州开医药AI知识库实战班","其他","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670466&idx=4&sn=fe9d01febdacdad9ce06bf2e76369c15&chksm=bc184bf8cdd081820db7feab9048c5776a0c447e387de8acac6aba5fa986dafe539043813c7b&scene=126&sessionid=1794493868#rd","name","赛柏蓝",{"_75":76,"_77":-5,"_78":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
