[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793889568000,"id","zdvww0i6nx9bvxora7gje6388","title","国家医保局公布2026年1-9月基本医疗保险统筹基金和生育保险主要指标","originalTitle","2026年1-9月基本医疗保险统筹基金和生育保险主要指标","summary","国家医保局公布2026年1-9月基本医疗保险统筹基金和生育保险主要指标，数据为统筹基金收入、支出，不含职工基本医保个人账户。2026年3月起部分省份启动居民医保基金缴费收入权责发生制改革，将2025年底预收的2026年度保费计入2026年度收入，显著提升1-9月居民医保收入同比增幅，随着10-12月参保季到来，年底参保缴费收入同比增幅将回归常态。","reason","source",{"_61":67},"links",{"_57":68},"publishedAt","2026-10-21T00:00:00.000Z","discoveredAt","2026-10-27T13:29:37.771Z","timelineAt","category","policy","tags",[65,66,67],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/10/21/art_7_23187.html",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
