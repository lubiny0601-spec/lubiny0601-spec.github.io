[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384583000,"id","nosbrexjd10vs32dscfq02bly","title","药企被判失信后必做的三件事：退钱、书面整改与人员机构处置","originalTitle","药企被判失信，三件事必做","summary","药企被判失信后需完成三件事：核算并退回不合理收益、按监管要求撰写整改报告与致歉声明、处置涉案人员与代理机构并留痕证据，才有资格谈惩戒减免。信用修复还需按时间倒排材料包与证据链，错过节点可能拉长惩戒期；修复完成后仍须核对挂网资格恢复范围与红线清单。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-09T03:37:00.000Z","discoveredAt","2026-11-09T06:31:16.722Z","timelineAt","category","opinion","tags",[78,79],"score",15,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fRnxykOV1IqE","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","policy","政策与监管",{"_75":76,"_13":77},"publicId","e9cac697-18f9-42e2-8eba-5fc7b89d3136","药企被判失信后须退钱、整改并处置人员","观点/解读","政策/监管","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669812&idx=1&sn=59e5a15f9f6bc7be8c04b9adfb228ba1&chksm=bc59700d4841a6bfdd6dfd3d97b5cdd6cbea74f3148064ab6bfc7c87fc8acc84d021833a642d&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
