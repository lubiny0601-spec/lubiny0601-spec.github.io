[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794384582000,"id","z3xmmx6rbt8cdiok8l2hszcbo","title","全国急性呼吸道传染病哨点监测：第44周流感病毒阳性率15.6%，南方省份处中流行水平","originalTitle","全国急性呼吸道传染病哨点监测情况（2026年第44周）","summary","中国疾控中心发布2026年第44周（10月26日—11月1日）全国急性呼吸道传染病哨点监测结果，216家多病原监测哨点医院门急诊流感样病例呼吸道样本阳性率前三位为流感病毒（15.6%）、鼻病毒（11.4%）、人偏肺病毒（4.3%），住院严重急性呼吸道感染病例前三位为鼻病毒（10.1%）、流感病毒（6.1%）、人偏肺病毒（4.4%）。","reason","疾控中心第44周哨点监测显示流感阳性率升至15.6%，南方省份已进入中流行水平，可据此判断呼吸道病原体的流行节奏。","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-09T06:32:44.661Z","timelineAt","category","policy","tags",[66,67],"score",58,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","infectious","感染与疫苗","政策/监管","感染/疫苗","https://www.chinacdc.cn/jksj/jksj04_14275/202611/t20261105_1842736.html","中国疾控·急性呼吸道传染病哨点监测",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
