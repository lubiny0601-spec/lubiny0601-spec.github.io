[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1795443790000,"id","z6acn2zcnnj2ekwwx2psgq8hi","title","为何领先药企正用自有数据微调开源模型","originalTitle","Why today’s leading drug developers are fine-tuning open models on their own data","summary","艾伯维、BMS、强生等5家全球Top20药企在一项联邦式计划中，用逾2万条自有蛋白-小分子结构数据微调OpenFold3，所得模型在测试中优于所有公开模型。OpenFold3由OpenFold联盟于2026年3月发布更新权重、代码及训练数据，多数任务表现与AlphaFold3相近。开源模型可让申办方在自有环境内微调并保留权重，但需自行承担算力、编排、安全与模型验证工作。","reason","source",{"_62":73},"links",{"_57":72},"publishedAt","2026-11-23T10:00:00.000Z","discoveredAt","2026-11-23T11:48:44.155Z","timelineAt","category","opinion","tags",[66,63,67,68,69,70,71],"score",10,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":64,"_62":65},{"_60":61,"_62":63},"slug","trends","name","行业趋势","opinions","观点与解读","观点/解读","辉瑞","礼来","艾伯维","BMS","强生","https://www.biopharmadive.com/spons/why-todays-leading-drug-developers-are-fine-tuning-open-models-on-their-ow/875153/","BioPharma Dive",{"_75":76,"_77":-5,"_78":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
