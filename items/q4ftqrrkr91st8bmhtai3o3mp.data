[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795410128000,"id","q4ftqrrkr91st8bmhtai3o3mp","title","观点：美国失去麻疹消除状态，下一届国会应协助恢复","originalTitle","Opinion: The U.S. lost measles elimination status. The next Congress should help restore it","summary","PAHO宣布美国已失去维持26年的麻疹消除状态，同一病毒谱系在美本土人际传播至少一年，达到麻疹传播重新建立的标准。11月纽约报告一例儿童麻疹相关死亡，为该州30多年来首例；威斯康星报告1990年以来首例麻疹死亡（一名婴儿），8天后又报告第二例儿童死亡；宾夕法尼亚11月早些时候报告两例死亡，使该州今年总数达7例，随后又确认今年第8例麻疹相关死亡。","reason","source",{"_63":70},"links",{"_58":69},"publishedAt","2026-11-19T22:55:19.000Z","discoveredAt","2026-11-23T04:24:56.386Z","timelineAt","category","opinion","tags",[67,68],"score",20,"selected",false,"channel","news","story","x","readingMode","full","author","Krutika Kuppalli","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","opinions","name","观点与解读","infectious","感染与疫苗","观点/解读","感染/疫苗","https://www.statnews.com/2026/11/19/measles-elimination-status-congress-should-prioritize-restoration/?utm_campaign=rss","STAT",{"_72":73,"_74":-5,"_75":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
