[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794791090000,"id","wbryma313tg4w501wam6w5g5o","title","All of Us 队列研究：近10万人中人人携带至少一种影响药物代谢的基因变异","originalTitle","High Frequency of Drug-Impacting Gene Variants Found in All of Us Cohort","summary","匹兹堡大学团队分析NIH All of Us研究项目中近10万人的数据发现，100%参与者携带至少一种已知药物基因组学变异，中位数为9种，99.49%具有CPIC或FDA用药建议所覆盖基因的可预测表型。24.38%的参与者曾被处方与其携带变异相互作用的药物，最常见为昂丹司琼、布洛芬、奥美拉唑、泮托拉唑和阿托伐他汀。研究还鉴定出逾1.7万个新变异，并报告了多个祖先群体中药物相关变异的频率。","reason","source",{"_63":69},"links",{"_58":68},"publishedAt","2026-11-12T20:17:04.000Z","discoveredAt","2026-11-16T00:55:16.787Z","timelineAt","category","research","tags",[67,66],"score",18,"selected",false,"channel","news","story","x","readingMode","full","author","Sophia Ktori","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","papers","name","论文研究","small-molecule","小分子","论文/研究","https://www.genengnews.com/topics/omics/high-frequency-of-drug-impacting-gene-variants-found-in-all-of-us-cohort/","GEN Genetic Engineering & Biotechnology News",{"_71":72,"_73":-5,"_74":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
