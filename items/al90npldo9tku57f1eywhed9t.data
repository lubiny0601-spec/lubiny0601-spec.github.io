[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793888181000,"id","al90npldo9tku57f1eywhed9t","title","北京医保局部署国家集采第一至八批协议期满品种接续采购中选结果执行","originalTitle","北京市医疗保障局关于做好国家组织集采药品协议期满品种接续采购中选结果执行工作的通知","summary","北京市医保局发文部署国家组织药品集采第一至八批（不含胰岛素专项）协议期满品种接续采购中选结果执行，采购周期至2028年12月31日。3月27日0时招采子系统统一调整中选药品采购价格，3月31日0时起全面执行中选结果及医保支付标准，4月27日0时调整非中选药品信息与价格并暂停相关未过评产品。","reason","北京明确第一至八批集采接续采购的执行时间表与考核口径，涉及抗菌药物使用限制等未完成约定采购量的处理方式。","source",{"_62":72},"links",{"_58":71},"publishedAt","2026-03-26T00:00:00.000Z","discoveredAt","2026-10-27T16:01:16.801Z","timelineAt","category","policy","tags",[66,67,68,69,70],"score",78,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","抗感染","市场准入","https://ybj.beijing.gov.cn/zczxs/2020_ycgga/202603/t20260326_4566984.html","北京医保局·药品通知公告",{"_74":75,"_76":-5,"_77":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
