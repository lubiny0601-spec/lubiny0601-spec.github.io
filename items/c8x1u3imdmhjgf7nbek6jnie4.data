[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795410127000,"id","c8x1u3imdmhjgf7nbek6jnie4","title","FDA 再寻新掌门，Summit/Akeso 肺癌药遭拒，中国最大药企榜单出炉","originalTitle","FDA’s search for a new leader, and China’s largest drugmakers","summary","特朗普政府在参议院委员会关键投票前数小时撤回 Heidi Overton 的 FDA 局长提名，FDA 再度启动新领导人遴选。本周 FDA 还拒绝了 Summit Therapeutics 与康方生物（Akeso）合作的一款备受关注的肺癌药物。STAT 同时发布中国最大药企排名新指数，并讨论其编制方法及追踪中国生物医药的重要性。","reason","source",{"_65":76},"links",{"_58":75},"publishedAt","2026-11-20T09:30:00.000Z","discoveredAt","2026-11-23T04:24:56.353Z","timelineAt","category","opinion","tags",[73,74,70,66],"score",17,"selected",false,"channel","news","story","x","readingMode","full","author","Adam Feuerstein, Elaine Chen,and Damian Garde","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","trends","name","行业趋势","opinions","观点与解读","akeso","康方生物","fda","美国 FDA","观点/解读","FDA","https://www.statnews.com/2026/11/20/new-fda-commissioner-summit-lung-cancer-drug-readout-loud-podcast/?utm_campaign=rss","STAT",{"_78":79,"_80":-5,"_81":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
