[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791089000,"id","mjqvntfmsdujn6kj5ott8ub4j","title","陈靖/何川团队发现硫酸氧钒可作为衰老细胞清除剂，口服延长雄性小鼠寿命","originalTitle","Nat Aging：找到新型抗衰老物质！陈靖/何川发现膳食补充剂可选择性清除衰老细胞","summary","芝加哥大学陈靖及何川团队在Nature Aging发表研究，报道矿物质膳食补充剂硫酸氧钒（VS）可作为衰老细胞清除剂，口服VS改善衰老表型和多种年龄相关疾病，并延长雄性小鼠寿命。机制上，VS在衰老细胞中灭活反应性半胱氨酸并促进二硫键形成，导致蛋白质错误折叠、聚集并最终细胞死亡；谷胱甘肽还原酶下调促进GSSG积累，赋予衰老细胞对VS的选择性易感性。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-15T00:00:00.000Z","discoveredAt","2026-11-16T00:55:13.264Z","timelineAt","category","research","tags",[78,73],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f27NsDXZr8-M","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","papers","name","论文研究","small-molecule","小分子",{"_75":76,"_13":77},"publicId","1eb57f9f-d279-4ef8-a7a1-21667e1f701c","硫酸氧钒被证实可清除衰老细胞并延长雄性小鼠寿命","论文/研究","https://news.bioon.com/article/fa86963082f0.html","生物谷",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
