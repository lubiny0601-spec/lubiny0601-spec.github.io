[{"_1":2,"_3":4},"root",{"_5":67},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794791090000,"id","yubi9hcv4tm96sfe2jome1hi6","title","两名参议员提出法案，拟约束美国预防服务工作组利益冲突","originalTitle","STAT+: Senators introduce bill to curb conflicts of interest on preventive care panel","summary","参议员 Angus King 与 Elizabeth Warren 提出法案，为美国预防服务工作组（USPSTF）成员资格和利益冲突规避制定标准。此前 STAT 报道该工作组多名成员持有制药和医疗器械公司股票，其中两人拥有可能因工作组推荐特定诊疗而获利的私人诊所，联邦官员已给予全体成员豁免。该工作组已超过一年未召开会议。","reason","source",{"_61":66},"links",{"_58":65},"publishedAt","2026-11-13T14:00:00.000Z","discoveredAt","2026-11-16T00:55:13.604Z","timelineAt","category","policy","tags",[63,64],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","Chelsea Cirruzzo","body","outline",[],"relatedStories",[],"topics",[59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":30,"_61":62},"slug","name","政策与监管","政策/监管","其他","https://www.statnews.com/2026/11/13/uspstf-preventive-care-panel-senators-target-conflicts-of-interest/?utm_campaign=rss","STAT",{"_68":69,"_70":-5,"_71":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
