[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791091000,"id","aetzglfdbypuvczme4yntz9ps","title","赛柏蓝12月26-27日杭州举办医学事务MA与注册事务RA的AI效率重构研修班","originalTitle","医学事务MA与注册事务RA的AI效率重构研修班「12月26-27日 杭州」","summary","赛柏蓝定于12月26-27日在杭州举办医学事务MA与注册事务RA的AI效率重构研修班，围绕年度医学策略制定、文献检索与证据综述撰写、发补问题答复等七个高频环节展开。课程以腾讯WorkBuddy等AI智能体为例，讲解方法、AI介入步骤与产出物资产化，学员需自带笔记本电脑。东阳光集团已采购百余个WorkBuddy企业版账号，将约40小时人工工作压缩至约2小时。","reason","source",{"_69":76},"links",{"_59":75},"publishedAt","2026-11-12T07:28:06.000Z","discoveredAt","2026-11-12T14:33:27.116Z","timelineAt","category","industry","tags",[70],"score",3,"selected",false,"channel","news","story",{"_72":73,"_13":74},"x","readingMode","full","author","body","outline",[],"relatedStories",[71],"topics",[66],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fMFY_dCkrQYE","reportCount",1,"additionalSourceCount",0,{"_67":68,"_69":70},"slug","company-news","name","公司动态",{"_72":73,"_13":74},"publicId","ad199639-f205-406c-acbd-f0433e3987a5","赛柏蓝12月杭州办MA与RA的AI效率研修班","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670439&idx=7&sn=cb0bf9b46ffcff67b572c53c24f7495d&chksm=bc303f2b437c40a32a7be8d3cb37bc9d2ac2e3bb3def3a1de584a156261021e0a202d28d444d&scene=126&sessionid=1794493868#rd","赛柏蓝",{"_78":79,"_80":-5,"_81":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
