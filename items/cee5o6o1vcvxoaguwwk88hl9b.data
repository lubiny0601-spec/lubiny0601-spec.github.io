[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794205953000,"id","cee5o6o1vcvxoaguwwk88hl9b","title","北京医药采购平台药品挂网业务6月15日起推行\"随申随办\"","originalTitle","关于进一步优化本市医药采购平台药品挂网业务办理流程的通知","summary","北京市医药集中采购服务中心通知，自2026年6月15日起，本市医药采购平台对新增药品挂网、已挂网药品价格调整等业务推行\"随申随办\"，实行随时申报、随时办理。办理范围覆盖化学药品、生物制剂、中成药，澄清审核原则上3个工作日内、最长不超过9个工作日，通过后公示3个工作日。6月15日起原\"产品申报\"\"价格申报\"功能关闭，统一切换至新\"药品挂网信息申报\"功能。","reason","source",{"_61":70},"links",{"_57":69},"publishedAt","2026-06-12T00:00:00.000Z","discoveredAt","2026-10-27T16:01:16.780Z","timelineAt","category","policy","tags",[65,66,67,68],"score",29,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","抗感染","市场准入","https://ybj.beijing.gov.cn/zczxs/2020_ycgga/202606/t20260612_4698785.html","北京医保局·药品通知公告",{"_72":73,"_74":-5,"_75":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
