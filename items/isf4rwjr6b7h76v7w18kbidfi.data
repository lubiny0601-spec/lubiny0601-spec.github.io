[{"_1":2,"_3":4},"root",{"_5":90},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":37,"_55":37,"_56":57,"_58":59,"_60":61},"expiresAt",1794791088000,"id","isf4rwjr6b7h76v7w18kbidfi","title","拜耳 Factor XIa 抑制剂 asundexian 获 FDA 批准，商品名 Sunharbo，用于卒中二级预防","originalTitle","Bayer wins FDA nod for a new kind of blood thinner","summary","FDA 批准拜耳的口服 Factor XIa 抑制剂 asundexian（商品名 Sunharbo）用于特定成人患者的卒中二级预防，需与抗血小板治疗联用。支持获批的研究入组逾 12,000 名既往发生预警性卒中或心源性以外血栓性卒中的成人，一半接受安慰剂、一半每日一次 Sunharbo，结果显示缺血性卒中风险较对照组降低 26%，两组大出血例数相近，最常见不良反应为腹泻。","reason","FDA 批准拜耳 asundexian 用于卒中二级预防，关键三期数据同时给出疗效幅度与出血风险对比。","source",{"_74":89},"links",{"_61":88},"publishedAt","2026-11-09T22:40:00.000Z","discoveredAt","2026-11-11T14:10:21.623Z","timelineAt","category","approval","tags",[75,79,77,86,87],"score",58,"selected",true,"channel","news","story",{"_83":84,"_13":85},"x","readingMode","full","author","Jacob Bell","body","outline",[],"relatedStories",[82],"topics",[68,69,70,71],"indexable","markdownAvailable","group",{"_62":63,"_64":65,"_66":67},"hasTranslation",false,"bodyLanguage","original","factId","fr6uzGADhTEY","reportCount",1,"additionalSourceCount",0,{"_72":80,"_74":81},{"_72":78,"_74":79},{"_72":76,"_74":77},{"_72":73,"_74":75},"slug","approvals","name","获批上市","small-molecule","小分子","cardiovascular","心血管","fda","美国 FDA",{"_83":84,"_13":85},"publicId","ffddf180-8c86-47cb-9a76-991b2707b1e4","FDA批准拜耳抗凝药Sunharbo用于卒中二级预防","FDA","拜耳","https://www.biopharmadive.com/news/bayer-sunharbo-asundexian-fda-approve-stroke-factor-xi/872837/","BioPharma Dive",{"_91":92,"_93":-5,"_94":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
