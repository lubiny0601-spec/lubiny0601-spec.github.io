[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1793889548000,"id","r0jf3nthpkom64var2e15we4a","title","参议员Bernie Sanders将主导FDA用户付费法案续期谈判","originalTitle","STAT+: Pharma critic Bernie Sanders is set to hold major sway over FDA funding bill","summary","中期选举民主党大胜后，长期批评FDA用户付费制度的参议员Bernie Sanders（I-Vt.）预计将领导参议院卫生委员会，从而在《处方药用户付费法案》（PDUFA）续期谈判中掌握主导权。现行法律须在9月30日前续期，否则可能影响FDA审评药品的能力。Sanders是少数反对用户付费结构核心前提的议员之一。","reason","source",{"_70":81},"links",{"_60":80},"publishedAt","2026-11-04T21:17:19.000Z","discoveredAt","2026-11-05T05:13:21.928Z","timelineAt","category","policy","tags",[78,79],"score",20,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","Margaret Manto","body","outline",[],"relatedStories",[74],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fvOWoqjGVbpQ","reportCount",1,"additionalSourceCount",0,{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","政策与监管","fda","美国 FDA",{"_75":76,"_13":77},"publicId","c6043102-65d0-4c46-b41e-fc1e11aa8b59","桑德斯将主导FDA用户费法案续期谈判","政策/监管","FDA","https://www.statnews.com/2026/11/04/bernie-sanders-senate-help-key-role-pdufa-reauthorization/?utm_campaign=rss","STAT",{"_83":84,"_85":-5,"_86":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
