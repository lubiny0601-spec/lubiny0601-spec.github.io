[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":36,"_54":55,"_56":57,"_58":36,"_59":60},"expiresAt",1795408368000,"id","kpnx7xw02k98z6ljtg1m51mm1","title","国家级继教项目《呼吸道感染诊治与防控》暨第16期《中山感染感控实践行》将在上海中山医院开班","originalTitle","疑难肺部感染怎么诊？病原检出后怎么治？来上海中山医院，看专家如何决策！","summary","国家级继续医学教育项目《呼吸道感染诊治与防控》暨第16期《中山感染感控实践行》将于2026年11月24—26日在复旦大学附属中山医院举办，聚焦疑难肺部感染诊疗决策。课程覆盖mNGS、tNGS等分子检测的临床解读、侵袭性肺曲霉病、NTM-PD、耐药菌感染及呼吸道传染病防控，并设感染病科与微生物实验室现场参访和真实病例讨论。普通学员培训费800元/人，上海市预防医学会会员单位600元/人。","reason","source",{"_71":86},"links",{"_60":85},"publishedAt","2026-11-11T12:07:06.000Z","discoveredAt","2026-11-12T14:31:19.661Z","timelineAt","category","industry","tags",[79,80,81,82,83,84],"score",10,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","readingMode","full","author","SIFIC团队","body","outline",[],"relatedStories",[75],"topics",[67,68],"indexable","markdownAvailable",true,"group",{"_61":62,"_63":64,"_65":66},"hasTranslation","bodyLanguage","original","factId","fYD8ATYDKqx0","reportCount",2,"additionalSourceCount",0,{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","antibiotics","name","抗菌药物与耐药","infectious","感染与疫苗",{"_76":77,"_13":78},"publicId","7c24033c-00ba-4c2d-99f3-d7171b76a570","上海11月办呼吸道感染诊治培训班，普通学员收费800元","其他","感染/疫苗","耐药与院感","抗感染","专家会议","对市场","https://mp.weixin.qq.com/s?__biz=MzAxNDYzMDM4MA==&mid=2650200575&idx=1&sn=ef83d824b60cb9dab87bc2d2db928bf7&chksm=821dac4be142dd3d2d75e1cf3607e6749b57d26ea5ef57cd14e10d390b2968e3044a2d18b826&scene=126&sessionid=1794493866#rd","SIFIC 感染视界",{"_88":89,"_90":-5,"_91":55},"changelogVersion","2026-10-08T08:00","release","staticSite"]
