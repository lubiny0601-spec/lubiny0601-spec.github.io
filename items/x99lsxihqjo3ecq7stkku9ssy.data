[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794791089000,"id","x99lsxihqjo3ecq7stkku9ssy","title","广西大学覃一峰团队在Autophagy发表研究：猪星状病毒衣壳蛋白经ER应激诱导自噬降解MAVS抑制I型干扰素","originalTitle","Autophagy：广西大学覃一峰团队发现病毒衣壳“饿死”抗病毒哨兵：把MAVS送进自噬锅","summary","广西大学覃一峰团队在Autophagy发表研究，揭示猪星状病毒（PAstV）衣壳蛋白通过诱导内质网应激激活EIF2AK3/PERK-EIF2S1/ATF4通路，进而启动自噬，以非经典、不依赖caspase-3的方式促进MAVS降解，抑制I型干扰素产生。该研究利用PAstV1-GX1毒株感染PK-15细胞，发现衣壳蛋白同时定位于线粒体和内质网并与MAVS相互作用。","reason","source",{"_71":85},"links",{"_59":84},"publishedAt","2026-11-15T00:00:00.000Z","discoveredAt","2026-11-16T00:55:13.238Z","timelineAt","category","research","tags",[81,82,83],"score",8,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f5PSydXlWdww","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","infectious","感染与疫苗","immunology","自免与炎症",{"_78":79,"_13":80},"publicId","9eafeffb-91e6-4b0a-9cd1-7858c5ed156a","覃一峰团队揭示猪星状病毒衣壳蛋白降解MAVS机制","论文/研究","感染/疫苗","自免","https://news.bioon.com/article/d51f96389958.html","生物谷",{"_87":88,"_89":-5,"_90":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
