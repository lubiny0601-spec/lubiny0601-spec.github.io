[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1794384583000,"id","znpp5zpxs78708nfp68h2ul73","title","扬子江连发三道GEO招标：新锐®、香芍颗粒、蓝芩口服液为AI答案付费","originalTitle","扬子江连发三道GEO招标，药企开始为AI答案付费","summary","扬子江药业三个月内连发三份GEO招标，涉及新锐®（左奥硝唑）、香芍颗粒与蓝芩口服液，要求投标方完成大模型知识库入驻、临床问答场景搭建与合规内容投放。蓝芩口服液项目周期6个月，30%尾款挂钩产品在主流大模型提及率或推荐率排名前二。2026年上半年国内GEO公开招标约23个、总金额突破6000万元。","reason","source",{"_63":72},"links",{"_57":71},"publishedAt","2026-11-09T02:20:00.000Z","discoveredAt","2026-11-09T06:31:19.250Z","timelineAt","category","industry","tags",[64,66,69,70],"score",38,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":67,"_63":68},{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","trends","name","行业趋势","company-news","公司动态","market","市场与销售","扬子江药业","市场/销售","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669800&idx=1&sn=3e5a57b788edeea3d4c5baab9cf1916b&chksm=bc9faf49bb7828920a2ecf249d57415be3d012237da7b0001690f5ce09c0e5f0990e8dc2e28d&scene=126&sessionid=1794205869#rd","赛柏蓝",{"_74":75,"_76":-5,"_77":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
