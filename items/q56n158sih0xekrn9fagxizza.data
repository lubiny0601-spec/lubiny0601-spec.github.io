[{"_1":2,"_3":4},"root",{"_5":89},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1795410153000,"id","q56n158sih0xekrn9fagxizza","title","NMPA批准礼来奥氟格列隆钙片（穆优达）上市用于成人长期体重管理","originalTitle","国家药监局批准奥氟格列隆钙片上市","summary","国家药监局批准EliLilly Nederland B.V.申报的1类创新药奥氟格列隆钙片（商品名穆优达）上市，用于在控制饮食和增加运动基础上对成人进行长期体重管理。适用人群为BMI≥30 kg/m2的肥胖成人，或BMI≥27 kg/m2至<30 kg/m2且伴有至少一种体重相关合并症（如高血压、血脂异常、高血糖、阻塞性睡眠呼吸暂停综合征、心血管疾病等）的超重成人。","reason","原文给出了获批的适应症与BMI门槛，读者可据此判断该药在国内减重市场的准入范围。","source",{"_73":88},"links",{"_60":87},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-12T14:18:47.921Z","timelineAt","category","approval","tags",[74,85,86,78],"score",63,"selected",true,"channel","news","story",{"_82":83,"_13":84},"x","readingMode","full","author","body","outline",[],"relatedStories",[81],"topics",[67,68,69,70],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fWlREWb9IbDM","reportCount",3,"additionalSourceCount",2,{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","approvals","name","获批上市","metabolic","代谢与减重","lilly","礼来","nmpa","中国 NMPA",{"_82":83,"_13":84},"publicId","cd186274-59bb-4177-8e85-a2a70636f17e","NMPA批准礼来口服GLP-1减重药穆优达上市","代谢/减重","NMPA","https://www.cnpharm.com/c/2026-11-12/1110394.shtml","中国食品药品网·要闻",{"_90":91,"_92":-5,"_93":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
