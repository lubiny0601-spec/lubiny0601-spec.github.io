[{"_1":2,"_3":4},"root",{"_5":91},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408386000,"id","etgb74ydv323z9y8wy0lsrw3w","title","恒瑞医药HRS-5346片获NMPA临床试验批准，将开展III期临床","originalTitle","恒瑞医药｜恒瑞医药关于获得药物临床试验批准通知书的公告","summary","恒瑞医药子公司山东盛迪医药的HRS-5346片获NMPA核准签发《药物临床试验批准通知书》，同意开展III期临床试验，适应症为降低伴有Lp(a)升高的已确诊动脉粥样硬化性心血管疾病或首次心血管事件风险升高成人患者的主要不良心血管事件风险。HRS-5346是一种Lp(a)口服小分子抑制剂，目前国内外尚无同类药物获批上市，该项目累计研发投入约8,620万元。","reason","source",{"_73":90},"links",{"_59":89},"publishedAt","2026-11-09T16:00:00.000Z","discoveredAt","2026-11-11T08:03:36.791Z","timelineAt","category","clinical","tags",[87,78,76,80,88],"score",22,"selected",false,"channel","news","story",{"_84":85,"_13":86},"x","readingMode","full","author","body","outline",[],"relatedStories",[83],"topics",[66,67,68,69,70],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fDuaw4uy-S-s","reportCount",1,"additionalSourceCount",0,{"_71":81,"_73":82},{"_71":79,"_73":80},{"_71":77,"_73":78},{"_71":75,"_73":76},{"_71":72,"_73":74},"slug","pipeline","name","研发管��","small-molecule","小分子","cardiovascular","心血管","hengrui","恒瑞医药","nmpa","中国 NMPA",{"_84":85,"_13":86},"publicId","25951e2c-f4ff-4207-9773-737cab8e7fe0","恒瑞HRS-5346片获III期临床批准","研发管线","NMPA","https://static.cninfo.com.cn/finalpage/2026-11-10/1225663318.PDF","恒瑞医药·公司公告",{"_92":93,"_94":-5,"_95":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
