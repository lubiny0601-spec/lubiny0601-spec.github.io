[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793889546000,"id","tamzx3ntzdlbpbenk9h8njb5i","title","PCCM科室规范化建设3.0版：睡眠呼吸障碍、肺结核专病照护能力提升项目正式启动","originalTitle","持续推进PCCM科室规范化建设，睡眠呼吸障碍、肺结核专病照护能力提升项目正式启动","summary","PCCM科室规范化建设——睡眠呼吸障碍、肺结核专病照护能力提升项目启动会分别召开，两个专病项目正式进入实施阶段。睡眠呼吸障碍项目将围绕规范化评估、睡眠呼吸监测、气道正压通气治疗、合并症处置与长期随访管理开展建设，推动“筛查-诊断-治疗-全周期照护”标准化模式下沉各级医疗机构。","reason","source",{"_62":68},"links",{"_58":67},"publishedAt","2026-11-04T11:41:12.000Z","discoveredAt","2026-11-05T05:15:45.485Z","timelineAt","category","policy","tags",[66,65],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","规建项目办公室","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":64,"_62":65},{"_61":30,"_62":63},"slug","name","政策与监管","respiratory","呼吸","政策/监管","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604411&idx=1&sn=fbedafd2cced2250487e31d0848ce1b9&chksm=fcfe60da9eddf4d3a2fff85d9034efb33d8a75542b2f5d89ad42d8dffda026ab4c311dd27eda&scene=126&sessionid=1793855735#rd","呼吸界",{"_70":71,"_72":-5,"_73":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
