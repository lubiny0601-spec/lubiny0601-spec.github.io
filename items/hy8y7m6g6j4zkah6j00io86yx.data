[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889558000,"id","hy8y7m6g6j4zkah6j00io86yx","title","福建厦门优化医保结算流程：基金拨付最短1个工作日，覆盖2000多家定点医药机构","originalTitle","【福建】福建厦门优化医保结算流程跑出“加速度”","summary","福建厦门医保部门将基金拨付时限压缩至最短1个工作日，覆盖全市2000多家定点医药机构，并连续3年较全国平均水平提前两个月完成年度清算。即时结算实现门诊、住院、生育医疗、救助与药店购药费用\"日报日审日拨\"，大病保险结算由按月拨付升级为按日拨付，预计每年快拨付大病保险费用6亿元。今年2月完成2025年度医保清算，比往年提前超60天，全年拨付医保资金超110亿元。","reason","source",{"_69":79},"links",{"_59":80},"publishedAt","2026-11-02T00:00:00.000Z","discoveredAt","2026-11-02T09:52:08.922Z","timelineAt","category","policy","tags",[77,78,79],"score",22,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","readingMode","full","author","body","outline",[],"relatedStories",[73],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","foZpOH25Cq0g","reportCount",1,"additionalSourceCount",0,{"_68":71,"_69":72},{"_68":30,"_69":70},"slug","name","政策与监管","insurance","医保与集采",{"_74":75,"_13":76},"publicId","dda58615-efb4-47af-bc6c-95146fcdead4","厦门医保基金拨付最短缩至1个工作日","政策/监管","医保/集采","国家医保局","http://www.nhsa.gov.cn/art/2026/10/25/art_14_23224.html",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
