[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408366000,"id","druqlkdblg84oy8h8sg19gwr9","title","中日医院苏楠教授谈雾化祛痰：乙酰半胱氨酸、氨溴索与高渗盐水如何选","originalTitle","吃完化痰药再补一招，老痰排出更丝滑，简单呼吸就起效！","summary","中日医院呼吸与危重症医学科苏楠教授推荐用雾化吸入替代或联合口服化痰药，药物直达气道、起效快且全身不良反应小，适合慢阻肺病、支扩等痰多患者及儿童、老人。痰液黏稠如胶水时可选乙酰半胱氨酸等黏液溶解剂，纤毛清除能力下降时可用氨溴索等黏液调节剂，高渗盐水（3%或7%氯化钠）雾化亦可稀释痰液。雾化后仍需配合拍背、体位引流、主动咳痰，并针对感染等病因治疗。","reason","source",{"_70":80},"links",{"_59":79},"publishedAt","2026-11-14T05:39:17.000Z","discoveredAt","2026-11-16T01:00:58.885Z","timelineAt","category","opinion","tags",[78,73],"score",10,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fusWnH2rEv78","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","respiratory","呼吸",{"_75":76,"_13":77},"publicId","78144b30-c629-4b8e-87b0-f2532fc29e01","苏楠教授谈雾化祛痰药物选择","观点/解读","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604829&idx=2&sn=d50f4697853515c387e8f6b7ac11b0a7&chksm=fcd4afaceff3347e4e0e1fe2110f6852dd8ec6afd66fe02369cb426ef5afa9337749a2166b01&scene=126&sessionid=1794790833#rd","呼吸界",{"_82":83,"_84":-5,"_85":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
