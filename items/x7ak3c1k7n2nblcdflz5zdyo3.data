[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793888172000,"id","x7ak3c1k7n2nblcdflz5zdyo3","title","GUT：程向东/徐志远/白凡合作揭示胃癌定向肝转移机制，鉴定C/EBPβ为关键调控因子及ADM–CALCRL、C3–C3AR1潜在干预靶点","originalTitle","GUT：程向东/徐志远/白凡合作揭示胃癌定向肝转移的调控机制和潜在干预靶点","summary","浙江省肿瘤医院程向东、徐志远与北京大学白凡团队在GUT发表研究，构建迄今最大的胃癌多部位转移单细胞图谱，鉴定转录因子C/EBPβ为促进肝转移的关键调控因子。机制上，C/EBPβ促进肿瘤细胞分泌ADM，经CALCRL破坏内皮连接促进内渗；同时诱导C3表达，激活巨噬细胞C3AR1形成免疫抑制状态，支持外渗时免疫逃逸。","reason","source",{"_71":83},"links",{"_59":82},"publishedAt","2026-11-05T00:00:00.000Z","discoveredAt","2026-11-05T08:14:19.781Z","timelineAt","category","research","tags",[81,76,74],"score",12,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fl57PptFpiSE","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","small-molecule","小分子","oncology","肿瘤",{"_78":79,"_13":80},"publicId","99efea39-6687-47bb-b61c-af2be8d7ade6","GUT发表胃癌肝转移调控机制研究","论文/研究","https://news.bioon.com/article/0f259621061b.html","生物谷",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
