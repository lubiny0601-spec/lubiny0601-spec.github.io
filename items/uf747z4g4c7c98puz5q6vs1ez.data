[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795410128000,"id","uf747z4g4c7c98puz5q6vs1ez","title","研究：L9LS 单抗与 R21 疟疾疫苗联用干扰免疫应答，婴儿人群保护策略存疑","originalTitle","Study raises doubts about combining vaccine, monoclonal antibody to protect against malaria","summary","在马里婴儿中开展的试验显示，单抗 L9LS 在六个月传播季内对疟原虫的保护效力为 78%（对照安慰剂），但会干扰 R21 疟疾疫苗诱发的免疫应答，使疫苗产生的抗体水平下降 20%–30%。研究者因此计划在关键性研究中转向婴儿以外人群，希望 2028 年启动可支持 L9LS 获批的试验。","reason","source",{"_64":72},"links",{"_58":71},"publishedAt","2026-11-19T22:20:00.000Z","discoveredAt","2026-11-23T04:24:56.392Z","timelineAt","category","clinical","tags",[66,69,70],"score",15,"selected",false,"channel","news","story","x","readingMode","full","author","Andrew Joseph","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":67,"_64":68},{"_62":30,"_64":66},{"_62":63,"_64":65},"slug","papers","name","论文研究","临床进展","infectious","感染与疫苗","感染/疫苗","论文/研究","https://www.statnews.com/2026/11/19/malaria-monoclonal-antibody-l9ls-vaccine-r21-infant-study-mali/?utm_campaign=rss","STAT",{"_74":75,"_76":-5,"_77":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
