[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":-5,"_56":57,"_58":59},"expiresAt",1793889545000,"id","wq2nqezlgrnos0d5m3m6et8w1","title","辉瑞将舒普深国内推广交给第三方CSO，康新博划入核心医院急症BU","originalTitle","舒普深推广交出去了，其他原研药呢？","summary","据行业消息，辉瑞中国将注射用头孢哌酮钠舒巴坦钠（舒普深）的国内推广整体交给第三方CSO，不再由自有销售队伍覆盖；同属抗感染矩阵的艾沙康唑（康新博）则从广阔市场团队划入核心医院急症BU。","reason","从舒普深转交CSO切入，梳理外企成熟原研药在集采常态化下的处置路径与取舍标准。","source",{"_66":81},"links",{"_59":80},"publishedAt","2026-11-03T04:05:26.000Z","discoveredAt","2026-11-03T15:30:38.245Z","timelineAt","category","industry","tags",[67,74,73,75,76,77,78,79],"score",72,"selected",true,"channel","news","story","x","readingMode","full","author","子非鱼","body","outline",[],"relatedStories",[],"topics",[60,61,62,63],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_64":72,"_66":73},{"_64":70,"_66":71},{"_64":68,"_66":69},{"_64":65,"_66":67},"slug","company-news","name","公司动态","market","市场与销售","antibiotics","抗菌药物与耐药","pfizer","辉瑞","抗菌药物","市场/销售","抗感染","企业竞争","对市场","对销售","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699457&idx=1&sn=11de5c9e5c809960a8cb1fa1453487c0&chksm=bc6aaeb3e73cec0766ead50088868e999dd98b87fe0f395c0de72eb1fbf3f26079262d47e88d&scene=126&sessionid=1793719809#rd","医药云端工作室",{"_83":84,"_85":-5,"_86":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
