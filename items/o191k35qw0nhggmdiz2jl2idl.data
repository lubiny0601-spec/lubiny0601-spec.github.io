[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1793889562000,"id","o191k35qw0nhggmdiz2jl2idl","title","健康元子公司丽珠集团完带汤颗粒获药品注册证书，为国内首家获批","originalTitle","健康元｜就完带汤颗粒获药品注册证书","summary","健康元控股子公司丽珠集团旗下四川光大制药的完带汤颗粒获NMPA签发《药品注册证书》（证书编号2026S03950），为国内首家获批上市，也是丽珠集团第二款中药3.1类新药。该药品处方源自《傅青主女科》，已列入《古代经典名方目录（第一批）》，功能主治为补脾疏肝、化湿止带，用于带下病肝郁脾虚、湿浊下注证。截至公告披露日累计直接研发投入约447.46万元。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-10-27T16:00:00.000Z","discoveredAt","2026-10-28T16:55:42.928Z","timelineAt","category","approval","tags",[71,73,78,79],"score",22,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f9wjd_hcFf2M","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","approvals","name","获批上市","tcm","中药",{"_75":76,"_13":77},"publicId","d8ed2206-eb6e-4104-bd34-3a800dfdf447","丽珠集团子公司完带汤颗粒获注册证书","NMPA","健康元","https://static.cninfo.com.cn/finalpage/2026-10-28/1225631138.PDF","健康元·公司公告",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
