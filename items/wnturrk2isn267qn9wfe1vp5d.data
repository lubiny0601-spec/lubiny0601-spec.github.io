[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793888171000,"id","wnturrk2isn267qn9wfe1vp5d","title","中纪委连发两文，天津成都将集采药耗列为医保基金监管重点","originalTitle","医院检查，全面升级","summary","中纪委官网连发天津、成都两篇医保基金监管文章，天津市纪委监委将医保药品及医用耗材集采作为日常监督重点，全过程跟进资格审核、招标竞价、合同签订等节点，今年以来天津落地集采品种已达1400余种。","reason","从天津、成都的纪检介入看医保基金监管如何前移到集采资格审核与竞价环节，并延伸到科室和个人。","source",{"_62":70},"links",{"_58":69},"publishedAt","2026-11-01T11:46:16.000Z","discoveredAt","2026-11-02T13:59:43.238Z","timelineAt","category","policy","tags",[66,67,68],"score",55,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","国家医保局","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653668987&idx=2&sn=e01ed76db2a0fb0f22169dcfb5b44a82&chksm=bc0ab55523d461340521489e1246638de8da1bd861234f43aa74335da841167861b2167d83a1&scene=126&sessionid=1793627968#rd","赛柏蓝",{"_72":73,"_74":-5,"_75":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
