[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":28,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":37,"_54":37,"_55":56,"_57":58,"_59":60},"expiresAt",1794791088000,"id","t6wzabnp4fwctewdoxf02csze","title","国家药监局通告27批次不符合规定药品，涉加替沙星滴眼液、盐酸莫西沙星片等","originalTitle","国家药监局27批次不符合规定药品","summary","国家药监局11月12日发布2026年第39号通告，经7家药品检验机构检验，17家企业生产的27批次药品不符合规定。其中郑州卓峰制药、楚雄老拨云堂药业的4批次加替沙星滴眼液可见异物不合格，桂林南药的3批次盐酸莫西沙星片溶出度不合格，武汉华龙生物制药的5批次聚明胶肽注射液涉及热原和可见异物。药监部门已要求相关企业暂停销售使用、召回并调查整改，省级药监部门将立案调查涉嫌违法行为。","reason","通告列出17家企业27批次不合格药品的具体品种与检验项目，可供判断相关品类的质量风险与召回范围。","source",{"_74":94},"links",{"_60":93},"publishedAt","2026-11-12T00:00:00.000Z","discoveredAt","2026-11-12T14:18:47.963Z","timelineAt","category","policy","tags",[87,88,89,90,78,91,92],"score",47,"selected",true,"channel","news","story",{"_84":85,"_13":86},"x","readingMode","full","author","body","outline",[],"relatedStories",[83],"topics",[67,68,69,70,71],"indexable","markdownAvailable","group",{"_61":62,"_63":64,"_65":66},"hasTranslation",false,"bodyLanguage","original","factId","fpxUM7-oshRI","reportCount",1,"additionalSourceCount",0,{"_72":81,"_74":82},{"_72":79,"_74":80},{"_72":77,"_74":78},{"_72":31,"_74":76},{"_72":73,"_74":75},"slug","safety","name","安全与质量","政策与监管","tcm","中药","antibiotics","抗菌药物与耐药","nmpa","中国 NMPA",{"_84":85,"_13":86},"publicId","85e16f7d-c252-48cb-8a0e-3f1fdec90c58","国家药监局通告27批次药品不符合规定","政策/监管","安全/质量","NMPA","抗菌药物","抗感染","市场准入","https://www.cnpharm.com/c/2026-11-12/1110353.shtml","中国食品药品网·要闻",{"_96":97,"_98":-5,"_99":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
