[{"_1":2,"_3":4},"root",{"_5":69},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50,"_51":36,"_52":53,"_54":-5,"_55":36,"_56":57},"expiresAt",1793888194000,"id","n0nqm5n1x8vv5uq8wzqvkpt37","title","2026年国际药品标准物质交流会在京召开，12个国家和地区专家参会","originalTitle","2026年国际药品标准物质交流会在京召开","summary","2026年国际药品标准物质交流会10月20日在北京召开，来自12个国家和地区药品监管机构、科研院所及行业专家围绕行业发展前沿与产业需求开展交流。国家药监局副局长杨胜指出，我国药品标准物质数量持续增长、质量水平显著提升、国际影响力不断增强，并提出深化国际交流合作、推动药品标准物质高质量发展。会议由中国药品检定研究院主办。","reason","source",{"_61":68},"links",{"_57":67},"publishedAt","2026-10-21T00:00:00.000Z","discoveredAt","2026-10-27T13:29:45.362Z","timelineAt","category","policy","tags",[65,66],"score",8,"selected",false,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[58,59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":63,"_61":64},{"_60":30,"_61":62},"slug","name","政策与监管","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-21/1109165.shtml","中国食品药品网·要闻",{"_70":71,"_72":-5,"_73":53},"changelogVersion","2026-10-08T08:00","release","staticSite"]
