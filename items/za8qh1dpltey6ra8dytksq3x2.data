[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795410125000,"id","za8qh1dpltey6ra8dytksq3x2","title","监管穿透式追责下，药企高管合规侥幸心理风险凸显","originalTitle","有些药企高管，危险","summary","在监管全链条穿透核查、资金流水与合作台账均可追溯的态势下，部分药企高管仍心存侥幸，误以为靠CSO包装或纸面整改即可过关。一旦被认定主观故意，企业受罚之外决策高管将首当其冲，虚假整改罪责更重。靠带金销售赚快钱的时代已结束，主动排查风险、搭建真正落地的合规体系才是正道。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-23T03:05:00.000Z","discoveredAt","2026-11-23T04:31:05.813Z","timelineAt","category","opinion","tags",[78,79],"score",12,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","f2QLD-Q85FYM","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","policy","政策与监管",{"_75":76,"_13":77},"publicId","8cca5bd7-8eb8-49d3-8fc3-be81338ed866","监管穿透式追责下药企高管合规侥幸风险凸显","观点/解读","政策/监管","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653671524&idx=1&sn=073fa08ddc3fef285899bcae3e8defb1&chksm=bcae7c0f335fc763d0a504824062929a20805076759fcf88dc3275dd6b35d5f244d53bfed454&scene=126&sessionid=1795408256#rd","赛柏蓝",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
