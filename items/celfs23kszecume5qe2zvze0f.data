[{"_1":2,"_3":4},"root",{"_5":67},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795443791000,"id","celfs23kszecume5qe2zvze0f","title","观点：医学院何时开课？——回应“应在通过Step 1考试后再入读医学院”的提议","originalTitle","Opinion: When should medical school start?","summary","哈佛医学院学生Surya Pulukuri回应Rachel E. Fabi与Amy Caruso Brown提出的“学生通过Step 1考试后再开始医学院学习”的提议，认为该方案建立在基础科学与临床学习可分离的前提上，而其一年的临床接触经历表明两者难以割裂。他同意学生常被医师资格考试分散精力，但认为早期临床接触正是最强有力的平衡力量，放弃这段宝贵时间将得不偿失。","reason","source",{"_62":66},"links",{"_58":65},"publishedAt","2026-11-21T12:00:00.000Z","discoveredAt","2026-11-23T04:24:56.271Z","timelineAt","category","opinion","tags",[64],"score",2,"selected",false,"channel","news","story","x","readingMode","full","author","Torie Bosch","body","outline",[],"relatedStories",[],"topics",[59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":61,"_62":63},"slug","opinions","name","观点与解读","观点/解读","https://www.statnews.com/2026/11/21/stat-letters-to-editor-medical-school-pediatric-emergency-care/?utm_campaign=rss","STAT",{"_68":69,"_70":-5,"_71":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
