[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1795408366000,"id","jg5p3y4us9phmcuqzvgstb7xe","title","霍乱为何被称为「2号病」：非洲15个月确诊超17万例，口服补液盐与「5要5不要」如何防护","originalTitle","曾15个月内确诊超17万人？「2号病」来得猛、传得快，但它怕你这样做……","summary","霍乱与鼠疫并列为我国仅有的两种甲类传染病，有「2号病」之称；联合国儿童基金会表示，2024年1月至2025年3月东部和南部非洲16个国家已确诊超过178000例霍乱病例，约2900人死亡。霍乱弧菌经水传播，口服补液盐可替代静脉输液救治脱水患者，早期注射式疫苗仅能提供约50%保护力、持续3-6个月，WHO已于1970年代停止推荐。预防需做到饭前便后洗手、水要煮沸、海产品煮熟等「5要」与「5不要」。","reason","source",{"_70":81},"links",{"_59":80},"publishedAt","2026-11-14T10:00:00.000Z","discoveredAt","2026-11-16T01:00:52.919Z","timelineAt","category","opinion","tags",[78,79],"score",18,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","readingMode","full","author","body","outline",[],"relatedStories",[74],"topics",[66,67],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fNsHyuGBwFns","reportCount",1,"additionalSourceCount",0,{"_68":72,"_70":73},{"_68":69,"_70":71},"slug","opinions","name","观点与解读","infectious","感染与疫苗",{"_75":76,"_13":77},"publicId","ae1e8ea7-4996-407f-8dde-c3f93c86fdaf","非洲15个月霍乱确诊超17万例，口服补液盐可救治脱水","观点/解读","感染/疫苗","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604830&idx=2&sn=527cfd6ed0a7c946c3c138be1d0a4c3f&chksm=fcf5c3502ccd35c325337cf803f84ae97dbf27c02070e8129e1c24147e8c74c41d6e36ee5c50&scene=126&sessionid=1794790833#rd","呼吸界",{"_83":84,"_85":-5,"_86":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
