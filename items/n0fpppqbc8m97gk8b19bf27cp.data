[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795443791000,"id","n0fpppqbc8m97gk8b19bf27cp","title","Isomorphic Labs完成50亿美元C轮融资，刷新AI制药单笔融资纪录","originalTitle","AI制药大爆，333亿天价融资破记录","summary","Isomorphic Labs于11月17日宣布完成50亿美元（约合人民币333亿元）C轮融资，由Greenoaks和红杉资本联合领投，Alphabet继续加注，刷新全球AI制药行业单笔融资纪录。公司成立五年尚无药物获批上市，也未公开宣布自研管线进入人体临床试验，累计融资已达77亿美元。其核心引擎IsoDDE可整合蛋白质结构预测与小分子相互作用，辅助候选药物设计与筛选。","reason","source",{"_64":71},"links",{"_58":70},"publishedAt","2026-11-21T11:29:31.000Z","discoveredAt","2026-11-23T04:32:38.600Z","timelineAt","category","industry","tags",[69,65,67],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","草履虫","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":68,"_64":69},{"_62":66,"_64":67},{"_62":63,"_64":65},"slug","trends","name","行业趋势","company-news","公司动态","capital","投融资","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653671423&idx=3&sn=68afc1805797ff602539d7ce5fcb682e&chksm=bc1db6e2907528a1b2e53d03f21adae90e80eb1862ecf7a53c33bf30d145f8e00ab413815819&scene=126&sessionid=1795408256#rd","赛柏蓝",{"_73":74,"_75":-5,"_76":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
