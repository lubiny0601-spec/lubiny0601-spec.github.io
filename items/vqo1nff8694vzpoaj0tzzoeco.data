[{"_1":2,"_3":4},"root",{"_5":78},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793888180000,"id","vqo1nff8694vzpoaj0tzzoeco","title","ECDC 警告：持续高温升高欧洲多类传染病风险","originalTitle","Sustained heat raises infectious disease risks across Europe, ECDC warns","summary","ECDC 7月29日警告，持续偏高的气温而非单次热浪，正在延长病原体与媒介繁殖传播的窗口期。截至7月22日，欧洲报告81例本地获得性西尼罗病毒人间病例，涉及意大利、希腊、北马其顿、罗马尼亚、西班牙和法国，35个地区受影响。ECDC 同时提示弧菌病风险上升，并更新了基于海表温度与盐度数据的 Vibrio Viewer 工具，含五日预报。","reason","source",{"_63":77},"links",{"_58":76},"publishedAt","2026-07-30T08:08:22.000Z","discoveredAt","2026-10-27T15:40:08.606Z","timelineAt","category","policy","tags",[69,70,71,72,73,74,75],"score",18,"selected",false,"channel","news","story","x","readingMode","full","author","Sandra Mejia","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":30,"_63":64},"slug","name","政策与监管","antibiotics","抗菌药物与耐药","infectious","感染与疫苗","政策/监管","感染/疫苗","耐药与院感","抗感染","疫情监测","对市场","对准入","https://outbreaknewstoday.com/sustained-heat-raises-infectious-disease-risks-across-europe-ecdc-warns-741/?utm_source=rss&utm_medium=rss&utm_campaign=sustained-heat-raises-infectious-disease-risks-across-europe-ecdc-warns","Outbreak News Today",{"_79":80,"_81":-5,"_82":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
