[{"_1":2,"_3":4},"root",{"_5":70},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795443789000,"id","y0gezf3exh2rinr0udq8x4l8k","title","中疾控第46周哨点监测：流感阳性率22.5%，全国进入呼吸道传染病高发季","originalTitle","最新丨全国大部分地区已进入呼吸道传染病高发季！流感、鼻病毒是主要病原体；流感活动整体进入中流行水平，阳性率达近10个月最高值","summary","中疾控第46周（2026年11月9日—11月15日）急性呼吸道传染病哨点监测显示，全国大部分地区已进入呼吸道传染病高发季，流感病毒和鼻病毒是主要流行病原体。门急诊流感样病例呼吸道样本阳性率前三位为流感病毒（22.5%）、鼻病毒（10.6%）、人偏肺病毒（5.5%）；住院严重急性呼吸道感染病例前三位为鼻病毒（9.5%）、流感病毒（8.7%）、人偏肺病毒（6.8%）。","reason","第46周哨点监测给出了流感、鼻病毒、人偏肺病毒的阳性率与年龄分布，可据此判断本季呼吸道传染病防控重点。","source",{"_62":69},"links",{"_58":68},"publishedAt","2026-11-20T07:45:37.000Z","discoveredAt","2026-11-23T04:30:50.161Z","timelineAt","category","policy","tags",[66,67],"score",62,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","infectious","感染与疫苗","政策/监管","感染/疫苗","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247605090&idx=1&sn=da7d20d44f0a422a79a2c8eb3f7020e6&chksm=fcf50948f7c66f9aae4fdebded753a6c119843cd60657642b787babf383f979ce331f61fc8b8&scene=126&sessionid=1795408232#rd","呼吸界",{"_71":72,"_73":-5,"_74":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
