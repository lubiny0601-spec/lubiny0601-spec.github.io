[{"_1":2,"_3":4},"root",{"_5":73},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1793889569000,"id","zxsouuhaptx3xb2h65jm6muec","title","国家药监局就《药品市场独占期实施办法（征求意见稿）》公开征求意见","originalTitle","国家药监局公开征求《药品市场独占期实施办法（征求意见稿）》意见","summary","国家药监局综合司于10月19日就《药品市场独占期实施办法（征求意见稿）》公开征求意见，目的是鼓励罕见病治疗用药品和儿童用药品研发，并配套新修订《药品管理法实施条例》。意见须在2026年11月18日前通过邮箱 hxypc@nmpa.gov.cn 反馈，邮件标题注明“药品市场独占期实施办法意见反馈”。","reason","罕见病与儿童用药的市场独占期规则进入征求意见阶段，读者可据此判断后续数据保护与独占安排的走向。","source",{"_63":72},"links",{"_58":71},"publishedAt","2026-10-20T00:00:00.000Z","discoveredAt","2026-10-27T13:29:45.469Z","timelineAt","category","policy","tags",[69,70,66],"score",67,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":31,"_63":64},"slug","name","政策与监管","rare-disease","罕见病","nmpa","中国 NMPA","政策/监管","NMPA","https://www.cnpharm.com/c/2026-10-20/1109016.shtml","中国食品药品网·要闻",{"_74":75,"_76":-5,"_77":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
