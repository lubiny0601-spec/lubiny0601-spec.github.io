[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1795410124000,"id","wlcer7ylafqawgf1n363et9rc","title","深圳医保以数据穿透和事前拦截整治超量开药，拦截金额超3600万元","originalTitle","【广东】广东深圳“数据穿透+行刑联动+事前拦截” 全链条整治超量开药","summary","深圳市医保部门针对门诊共济改革后超量开药套取医保基金行为，采取数据穿透、行刑联动和事前拦截等措施，联合公安机关抓获犯罪嫌疑人30名，涉案金额200余万元，15名涉案人员被依法处理。","reason","深圳医保部门用知识图谱锁定超量开药，并开发11类事前提醒规则，呈现了门诊共济改革后基金监管的具体做法。","source",{"_63":71},"links",{"_58":73},"publishedAt","2026-11-20T00:00:00.000Z","discoveredAt","2026-11-23T04:24:45.217Z","timelineAt","category","policy","tags",[69,70,71,72],"score",52,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60,61],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_62":67,"_63":68},{"_62":65,"_63":66},{"_62":31,"_63":64},"slug","name","政策与监管","insurance","医保与集采","metabolic","代谢与减重","政策/监管","医保/集采","国家医保局","GLP-1","http://www.nhsa.gov.cn/art/2026/11/13/art_14_23375.html",{"_75":76,"_77":-5,"_78":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
