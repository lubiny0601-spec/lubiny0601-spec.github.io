[{"_1":2,"_3":4},"root",{"_5":77},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1795410127000,"id","mt3wso488mup8io68dx6phex5","title","脉流科技冠脉微循环阻力指数AI计算软件获NMPA三类创新器械注册，无需导丝与腺苷","originalTitle","这款AI软件获批上市，不用导丝、不用腺苷！会改写心内科的检查逻辑吗？","summary","杭州脉流科技的冠状动脉造影微循环阻力指数计算软件获NMPA三类创新器械注册，基于血流动力学AI算法、仅用术中冠脉造影影像即可无创评估微循环，无需压力导丝和腺苷。产品以25为界输出微循环障碍二分类结果，定位辅助筛查，不能替代有创IMR金标准，适用成人稳定性/不稳定性心绞痛及疑诊冠心病患者。该软件可与QFR联用，一次造影同时评估大血管缺血与微血管功能。","reason","source",{"_65":76},"links",{"_58":75},"publishedAt","2026-11-20T03:52:50.000Z","discoveredAt","2026-11-23T04:30:46.322Z","timelineAt","category","approval","tags",[66,73,74,70],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","子非鱼","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","approvals","name","获批上市","device-ivd","医疗器械与 IVD","cardiovascular","心血管","nmpa","中国 NMPA","医疗器械/IVD","NMPA","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699743&idx=1&sn=4e323113601986aca87e6cbf8bfab1ac&chksm=bcf448ea742b20aee76153500070d6d6544da3751a9d8fe493d030a6e539cefbf9fb757a4325&scene=126&sessionid=1795408227#rd","医药云端工作室",{"_78":79,"_80":-5,"_81":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
