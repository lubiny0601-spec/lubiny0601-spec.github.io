[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794384584000,"id","t4jea0bao57lbwukrk728khfm","title","Science：秦骏/吕伟/于政权/王桂华团队发现肝转移灶唤醒肝内造血，LM-HSCs 经 CCR1/CREB 轴产出 ANXA1⁺中性粒细胞压制免疫","originalTitle","Science：肝脏被肿瘤改造成“造血基地”，秦骏/吕伟/于政权/王桂华团队发现新造的中性粒细胞专压免疫","summary","秦骏、吕伟、于政权、王桂华团队在 Science 发表研究，发现肝转移灶重新唤醒肝内休眠造血程序，经 CCR1 信号招募骨髓 HSCs 形成门脉周围异位造血龛，CREB 激活驱动髓系偏倚，产出 ANXA1⁺未成熟中性粒细胞，通过糖皮质激素受体信号压制 CD8⁺ T 细胞与 NK 细胞。","reason","source",{"_71":83},"links",{"_59":82},"publishedAt","2026-11-09T00:00:00.000Z","discoveredAt","2026-11-09T06:26:04.666Z","timelineAt","category","research","tags",[81,76,74],"score",14,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","readingMode","full","author","body","outline",[],"relatedStories",[77],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fpaMCdFL_uJw","reportCount",1,"additionalSourceCount",0,{"_69":75,"_71":76},{"_69":73,"_71":74},{"_69":70,"_71":72},"slug","papers","name","论文研究","cell-gene","细胞与基因治疗","oncology","肿瘤",{"_78":79,"_13":80},"publicId","af5436f2-0dfa-4676-8fc0-e03a069a2219","Science：肝转移灶唤醒肝内造血促免疫抑制","论文/研究","https://news.bioon.com/article/0bf596269e3d.html","生物谷",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
