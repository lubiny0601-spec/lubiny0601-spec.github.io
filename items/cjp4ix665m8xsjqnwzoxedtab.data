[{"_1":2,"_3":4},"root",{"_5":74},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1793889546000,"id","cjp4ix665m8xsjqnwzoxedtab","title","医药代表薪资水平公布：2026年一季度平均招聘薪酬0.98万元/月","originalTitle","医药代表，薪资水平公布","summary","人社部市场招聘薪酬数据显示，2026年第一季度医药代表岗位平均招聘薪酬为0.98万元/月，该数据反映招聘报价而非在职代表实际收入。上海部分企业医药代表岗位标注月薪1.5万-3.5万元，天津部分岗位为5000元-2万元。A股515家医药企业中，百济神州2025年人均薪酬95.65万元，居化学制剂领域首位。","reason","source",{"_63":73},"links",{"_58":72},"publishedAt","2026-11-04T10:45:03.000Z","discoveredAt","2026-11-05T05:16:03.636Z","timelineAt","category","industry","tags",[67,64,68,69,70,71],"score",22,"selected",false,"channel","news","story","x","readingMode","full","author","颜色","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_61":65,"_63":66},{"_61":62,"_63":64},"slug","trends","name","行业趋势","market","市场与销售","市场/销售","百济神州","君实生物","智飞生物","齐鲁制药","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669472&idx=1&sn=4e32d32ae868bb99ccef5ea02eb18a15&chksm=bc78fdf0664633e390d074d1c808a9d7d0cdff5a72a2e432ff4bd3af77743d952b6a11c7a70a&scene=126&sessionid=1793855794#rd","赛柏蓝",{"_75":76,"_77":-5,"_78":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
