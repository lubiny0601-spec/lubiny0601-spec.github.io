[{"_1":2,"_3":4},"root",{"_5":72},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":26,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":37,"_53":37,"_54":-5,"_55":56,"_57":58},"expiresAt",1794384587000,"id","rusvafazm0ewlrdobe8gcfrgc","title","广东省药品交易中心开展“四同”药品挂网价格确认，逾期未确认将撤销挂网","originalTitle","关于开展“四同”药品挂网价格确认工作的通知（20261021批次）","summary","广东省药品交易中心发布通知，对省内挂网价格高于全国最低挂网价格的“四同”（同通用名、同厂牌、同剂型、同规格）药品开展价格确认，确认时间为即日起至2026年10月23日17:30，企业需通过广东省招采子系统操作。确认价格的药品省内三平台统一调整；拒绝确认且申诉未获采纳、以及逾期未操作的药品将被撤销挂网，后续需按挂网申报流程重新申请。企业在外省新的更低挂网价格执行30日内，须通过子系统提交调价申请。","reason","广东对挂网价高于全国最低价的同通用名同厂牌药品启动价格确认，未确认或申诉未采纳将被撤网，涉及企业在粤三平台的价格与准入。","source",{"_62":71},"links",{"_58":70},"publishedAt","2026-10-20T16:00:00.000Z","discoveredAt","2026-10-27T16:01:17.240Z","timelineAt","category","policy","tags",[66,67,68,69],"score",60,"selected",true,"channel","news","story","x","readingMode","full","author","body","outline",[],"relatedStories",[],"topics",[59,60],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original",{"_61":64,"_62":65},{"_61":31,"_62":63},"slug","name","政策与监管","insurance","医保与集采","政策/监管","医保/集采","抗感染","市场准入","https://www.gdmede.com.cn/announcement/announcement/detail?id=2112810505734197248","广东省药品交易中心·通知公告",{"_73":74,"_75":-5,"_76":37},"changelogVersion","2026-10-08T08:00","release","staticSite"]
