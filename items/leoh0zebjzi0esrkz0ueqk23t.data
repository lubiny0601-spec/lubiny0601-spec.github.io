[{"_1":2,"_3":4},"root",{"_5":71},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794384589000,"id","leoh0zebjzi0esrkz0ueqk23t","title","第二届临床微生物学学术大会暨中国医药教育协会临床微生物学专业委员会2026年学术年会在杭州召开","originalTitle","会议纪要：第二届临床微生物学学术大会暨中国医药教育协会临床微生物学专业委员会2026年学术年会","summary","第二届临床微生物学学术大会暨中国医药教育协会临床微生物学专业委员会2026年学术年会于8月21日—23日在杭州召开，来自全国25个省、自治区的300余名代表参会。会议设主论坛及多个分论坛，围绕细菌耐药防控、CRE精准诊疗、真菌感染、AI赋能耐药诊疗等主题交流，并发布ChiAST药敏试验专家系统、举行塞力医疗-华为AI战略合作签约。第三届年会将于2027年8月20日-22日在宁夏银川举办。","reason","source",{"_62":70},"links",{"_58":69},"publishedAt","2026-08-30T12:09:00.000Z","discoveredAt","2026-11-02T13:05:29.365Z","timelineAt","category","industry","tags",[64,65,66,67,68],"score",18,"selected",false,"channel","news","story","x","readingMode","full","author","SCM","body","outline",[],"relatedStories",[],"topics",[59],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_60":61,"_62":63},"slug","antibiotics","name","抗菌药物与耐药","其他","耐药与院感","抗感染","专家会议","对市场","https://mp.weixin.qq.com/s?__biz=MzA5MTExNzgwMA==&mid=2651006086&idx=1&sn=bbaf154e071af81f976a7d3cf5ebb8c4&chksm=8a94ff31dba8e81aa35fc06c306af2fdea10b646cf5e595106fe699c0358f5b6ea65146126ec&scene=126&sessionid=1793624721#rd","CHINET 中国细菌耐药监测网",{"_72":73,"_74":-5,"_75":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
