[{"_1":2,"_3":4},"root",{"_5":76},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":25,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":-5,"_40":-5,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":-5,"_56":36,"_57":58},"expiresAt",1794791090000,"id","vm1jc8m1h1iysv3jkhcwziguj","title","两款心血管药物试验失败后，心脏病药物研究的未来走向","originalTitle","The future of heart drug research in the wake of study setbacks","summary","今年美国心脏协会（AHA）年会上公布的两项临床试验显示，两款长期被认为具有遗传学验证依据的心脏病药物均未显示出任何获益。STAT 的播客节目讨论了这些挫折可能如何影响心血管药物研究的未来，并谈及 Vertex Pharmaceuticals 与诺华面临的药物安全性担忧，以及 Alnylam 因增长担忧导致的股价下跌。","reason","source",{"_65":75},"links",{"_58":74},"publishedAt","2026-11-13T13:34:45.000Z","discoveredAt","2026-11-16T00:55:13.612Z","timelineAt","category","opinion","tags",[73,70,66,72],"score",12,"selected",false,"channel","news","story","x","readingMode","full","author","Adam Feuerstein and Elaine Chen","body","outline",[],"relatedStories",[],"topics",[59,60,61,62],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original",{"_63":71,"_65":72},{"_63":69,"_65":70},{"_63":67,"_65":68},{"_63":64,"_65":66},"slug","trends","name","行业趋势","opinions","观点与解读","cardiovascular","心血管","novartis","诺华","观点/解读","https://www.statnews.com/2026/11/13/cardiovascular-disease-heart-drug-failures-readout-loud-podcast/?utm_campaign=rss","STAT",{"_77":78,"_79":-5,"_80":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
