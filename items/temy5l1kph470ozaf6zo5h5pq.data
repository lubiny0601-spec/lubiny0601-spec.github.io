[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8,"_9":10},"item",{"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":27,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":36,"_53":54,"_55":56,"_57":36,"_58":59},"expiresAt",1794205957000,"id","temy5l1kph470ozaf6zo5h5pq","title","CDE将注射用埃普奈明纳入\"关爱计划-延伸\"试点项目","originalTitle","CDE将注射用埃普奈明纳入“关爱计划-延伸”试点项目","summary","CDE将武汉海特生物制药的注射用埃普奈明纳入\"关爱计划-延伸\"试点项目，拟开发适应症为不可切除或转移的经典型软骨肉瘤。该通知于11月3日发布，依据《罕见疾病创新药物研发鼓励试点计划（\"关爱计划-延伸\"）申报指南》执行。","reason","source",{"_70":83},"links",{"_59":82},"publishedAt","2026-11-03T00:00:00.000Z","discoveredAt","2026-11-03T15:25:10.221Z","timelineAt","category","policy","tags",[80,73,81],"score",30,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","readingMode","full","author","body","outline",[],"relatedStories",[76],"topics",[66,67,68],"indexable","markdownAvailable",true,"group",{"_60":61,"_62":63,"_64":65},"hasTranslation","bodyLanguage","original","factId","fAbCY_czhSN0","reportCount",1,"additionalSourceCount",0,{"_69":74,"_70":75},{"_69":72,"_70":73},{"_69":30,"_70":71},"slug","name","政策与监管","rare-disease","罕见病","nmpa","中国 NMPA",{"_77":78,"_13":79},"publicId","c6327f78-44ba-48a6-946a-48ad9084a7ad","CDE将注射用埃普奈明纳入关爱计划-延伸试点","政策/监管","NMPA","https://www.cnpharm.com/c/2026-11-03/1109885.shtml","中国食品药品网·要闻",{"_85":86,"_87":-5,"_88":54},"changelogVersion","2026-10-08T08:00","release","staticSite"]
