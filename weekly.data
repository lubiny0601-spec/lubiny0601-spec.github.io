[{"_1":2,"_3":4},"root",{"_5":133},"weekly-latest",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14,"_15":16},"kind","weekly","report",{"_7":8,"_21":33,"_23":34,"_25":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":31,"_55":30,"_56":-5},"index",[17,18,19,20],"today","2026-11-23","expiresAt",1795443789000,{"_21":33,"_23":34,"_25":35},{"_21":30,"_23":31,"_25":32},{"_21":27,"_23":28,"_25":29},{"_21":22,"_23":24,"_25":26},"key","2026-W44","issueNumber",1,"title","国家药监局批准拜耳阿舒克森片上市，用于降低缺血性卒中及高风险TIA患者卒中风险","2026-W45",2,"北京医保局发文执行第十二批国家集采中选结果，11月28日起全面落地","2026-W46",3,"四部门发文促进创新药配备使用，两目录内1类新药不计入一品两规","2026-W47",4,"国家医保局发布2026版医保药品目录与第二批商保创新药目录，新增107种药品","MedHOT 周报 · 2026-W47","generatedAt","2026-11-23T04:25:31.499Z","lead",{"_25":35,"_132":44},"leadItemId","xjj8fe3psbbncixaonjtb0mc1","overview","本周国家医保局公布2026版医保药品目录与第二批商保创新药目录，医保目录新增107种药品、调出34种，商保创新药目录调整后共28种。多个品种借新版目录落地：度普利尤单抗的慢阻肺病与哮喘等适应症、征祥医药玛硒洛沙韦片、罗氏艾美赛珠单抗新纳入，药明巨诺瑞基奥仑赛成为首个进入基本医保的CAR-T。行业层面，米内网数据显示2026H1有52个国谈药在城市实体药店销售过亿，合计接近140亿元。","highlights",[129,130,131],"sections",[62,63,64],"flashes",[],"cover","metrics",{"_57":58,"_59":60,"_61":24},"readingMinutes","prev","next","totalStories",6,"selectedCount",10,"reportsCovered",{"_65":118,"_67":-5,"_68":119},{"_65":89,"_67":90,"_68":91},{"_65":66,"_67":-5,"_68":69},"label","观点与解读","summary","items",[70],{"_71":72,"_25":73,"_67":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88},"itemId","x0xqs42xpeuukznbms8x3f0je","药明巨诺瑞基奥仑赛降至30万元以内进基本医保，成首个纳入的CAR-T","2026版国家医保目录公布，药明巨诺瑞基奥仑赛（倍诺达）从129万元一支谈至30万元以内，成为国内首个进入基本医保的CAR-T，新版目录明年1月1日执行。降价底气来自慢病毒载体国产化，单支成本压到二十多万，按出厂价29万、成本约22万测算毛利率约25%。","sourceName","医药云端工作室","sourceUrl","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699684&idx=1&sn=e72806fa9b4136ea9d8279f1ff04a301&chksm=bcfe2e4492439d1f54fc0e3d12d2bbf62ec2d7a109510448f333d6238f2209763a846a084f98&scene=126&sessionid=1794790832#rd","publishedAt","2026-11-15T04:07:46.000Z","sourceIconUrl","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=920757ef74ebe49f","sourceIconSrcSet","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=9cb8174b387e7452 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=920757ef74ebe49f 96w","firstParty",false,"available",true,"政策与监管","新版目录落地带动具体品种支付范围变化，CAR-T经谈判大幅降价后首次进入基本医保。",[92,93,94,95],{"_71":42,"_25":35,"_67":115,"_75":76,"_77":116,"_79":117,"_81":82,"_83":84,"_85":86,"_87":88},{"_71":110,"_25":111,"_67":112,"_75":105,"_77":113,"_79":114,"_81":108,"_83":109,"_85":86,"_87":88},{"_71":102,"_25":103,"_67":104,"_75":105,"_77":106,"_79":107,"_81":108,"_83":109,"_85":86,"_87":88},{"_71":96,"_25":97,"_67":98,"_75":99,"_77":100,"_79":101,"_81":-5,"_85":86,"_87":88},"cy13d4uidahrp0yi7v3os5021","罗氏艾美赛珠单抗纳入 2026 年版国家医保目录，覆盖 A 型血友病规律替代治疗","国家医保局公布《国家基本医疗保险、生育保险和工伤保险药品目录（2026 年版）》，罗氏制药中国的艾美赛珠单抗注射液（舒友立乐）纳入医保，报销范围覆盖伴或不伴凝血因子 VIII 抑制物的 A 型血友病患者规律替代治疗。","药时代","https://www.drugtimes.cn/2026/11/14/aimeisaizhudankangchenggongnaruguojiayibaokaiqixueyoubinglin/","2026-11-14T11:08:01.000Z","pyz9ox90brl8hyn4nwbf2gqkt","征祥医药玛硒洛沙韦片（济可舒）纳入2026年国家医保目录","国家医保局11月14日公布2026年国家医保药品目录（2027年1月1日起执行），征祥医药自主研发的1类抗流感新药玛硒洛沙韦片（济可舒）纳入，济川药业为该药中国独家商业化权益方。该药为流感病毒PA核酸内切酶抑制剂，全疗程单次口服，成人80mg、12岁及以上青少年40mg，成人适应症2025年7月获批、青少年适应症2026年6月获批。其代谢不依赖CYP450酶，轻中度肝功能不全无需调整剂量。","呼吸界","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604842&idx=1&sn=53c76be260adf113c60d275172de9e58&chksm=fca3fae73304ded76277d3ba4478e763487eeda5a4c491f72789b47d51c2831b2da86d8ca250&scene=126&sessionid=1794790833#rd","2026-11-15T03:13:12.000Z","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2FqcrGY40NstI9KRy4xGibFbQKxOmj4bsGPiaZUj6GX6GT7y8o5IhK2s0WmeUI2OpkvORFYDp0anficAMm01e7dLGAg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=a6a1bb0cc49dcaf4","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2FqcrGY40NstI9KRy4xGibFbQKxOmj4bsGPiaZUj6GX6GT7y8o5IhK2s0WmeUI2OpkvORFYDp0anficAMm01e7dLGAg%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=df299adc40fe2737 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2FqcrGY40NstI9KRy4xGibFbQKxOmj4bsGPiaZUj6GX6GT7y8o5IhK2s0WmeUI2OpkvORFYDp0anficAMm01e7dLGAg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=a6a1bb0cc49dcaf4 96w","l4gif7m8k6kbnc3prgwmqr4i3","度普利尤单抗慢阻肺病与哮喘适应症纳入2026国家医保药品目录","国家医保局公布《国家基本医疗保险、工伤保险和生育保险药品目录（2026年）》，度普利尤单抗注射液成人慢阻肺病及6岁及以上儿童和成人哮喘等四项适应症首次纳入医保支付范围，中重度特应性皮炎适应症续约。该药为靶向白介素-4及白介素-13的生物制剂，陈荣昌、瞿介明两位教授在文中提到纳入医保有助于减轻用药负担、提升可及性并减少急性加重。","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604830&idx=1&sn=f243eb34d45828f019b753a8cf4bbab4&chksm=fcd2f2447358c79aaa4cf155da72bba585adc408db479a1afd77fdcd5789515aa523aee7e06c&scene=126&sessionid=1794790833#rd","2026-11-14T10:00:00.000Z","国家医保局公布2026年国家医保药品目录和商保创新药目录，医保目录新增107种药品（含51种1类创新药）、调出34种，目录总数达3331个；商保创新药目录新纳入11家药企的12种药品，调整后共28种。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699682&idx=1&sn=191dc7e70ed0de6b0a1dfd1744b77d89&chksm=bc5159a21fa3a9a5765db8b67eb2fab594d82db0a45ddba14fb00cb64da8e617165bab59e81a&scene=126&sessionid=1794790832#rd","2026-11-14T04:44:12.000Z","行业动态",[120],{"_71":121,"_25":122,"_67":123,"_75":124,"_77":125,"_79":126,"_81":127,"_83":128,"_85":86,"_87":88},"l3sg0o11v4cxvprqzjdqk3k25","2026H1有52个国谈药在城市实体药店销售过亿，合计近140亿元","米内网数据显示，2026H1中国城市实体药店终端有52个国谈药（2025版）销售额超过1亿元，合计接近140亿元，其中36个品种涨幅超过10%。甲磺酸伏美替尼片、甲磺酸阿美替尼片均超12亿元，泽布替尼胶囊、司库奇尤单抗注射液超5亿元，替尔泊肽注射液涨超300%。一级集团排名中翰森制药、恒瑞医药、诺华位列前三，52个品种中独家品种占比约86%。","赛柏蓝","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670661&idx=3&sn=a9cd49c32ff7ef89dd2a9c581dafef4b&chksm=bc42d62ab2be85beda9a1268ccddc564b3976c1b2d011a5bed0fbab3ff527c17595834433720&scene=126&sessionid=1794790858#rd","2026-11-14T05:35:05.000Z","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=167030ae1e219003","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=b828ff70e947816f 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=167030ae1e219003 96w",{"_71":110,"_25":111,"_67":112,"_75":105,"_77":113,"_79":114,"_81":108,"_83":109,"_85":86,"_87":88},{"_71":72,"_25":73,"_67":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88},{"_71":102,"_25":103,"_67":104,"_75":105,"_77":106,"_79":107,"_81":108,"_83":109,"_85":86,"_87":88},"leadParagraph",{"_134":135,"_136":-5,"_137":88},"changelogVersion","2026-10-08T08:00","release","staticSite"]
