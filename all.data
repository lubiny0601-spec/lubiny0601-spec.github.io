00,"_82":83,"_84":85,"_86":-5},{"_64":186,"_66":187,"_68":188,"_70":-5,"_71":189,"_73":190,"_75":190,"_76":191,"_78":192,"_80":100,"_82":83,"_84":85,"_86":-5},{"_64":179,"_66":180,"_68":181,"_70":-5,"_71":182,"_73":183,"_75":183,"_76":121,"_78":184,"_80":185,"_82":83,"_84":85,"_86":-5},{"_64":173,"_66":174,"_68":175,"_70":-5,"_71":176,"_73":177,"_75":177,"_76":108,"_78":178,"_80":17,"_82":83,"_84":85,"_86":-5},{"_64":166,"_66":167,"_68":168,"_70":-5,"_71":169,"_73":170,"_75":170,"_76":108,"_78":171,"_80":172,"_82":83,"_84":85,"_86":-5},{"_64":158,"_66":159,"_68":160,"_70":-5,"_71":161,"_73":162,"_75":162,"_76":163,"_78":164,"_80":123,"_82":83,"_84":85,"_86":-5},{"_64":149,"_66":150,"_68":141,"_70":-5,"_71":151,"_73":143,"_75":143,"_76":152,"_78":153,"_80":81,"_82":83,"_84":85,"_86":-5},{"_64":139,"_66":140,"_68":141,"_70":-5,"_71":142,"_73":143,"_75":143,"_76":-5,"_78":144,"_80":145,"_82":83,"_84":85,"_86":-5},{"_64":129,"_66":130,"_68":131,"_70":-5,"_71":132,"_73":133,"_75":133,"_76":108,"_78":134,"_80":81,"_82":83,"_84":85,"_86":-5},{"_64":116,"_66":117,"_68":118,"_70":-5,"_71":119,"_73":120,"_75":120,"_76":121,"_78":122,"_80":123,"_82":83,"_84":85,"_86":-5},{"_64":103,"_66":104,"_68":105,"_70":-5,"_71":106,"_73":107,"_75":107,"_76":108,"_78":109,"_80":81,"_82":83,"_84":85,"_86":-5},{"_64":94,"_66":95,"_68":96,"_70":-5,"_71":97,"_73":98,"_75":98,"_76":77,"_78":99,"_80":100,"_82":83,"_84":85,"_86":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":74,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":-5},"id","x8ns1f0u4ixvhisa0mrdj2xrh","title","石药集团SYS6055注射液治疗复发/难治性B细胞非霍奇金淋巴瘤I/II期临床试验在中国首个研究中心启动","summary","石药集团宣布，SYS6055注射液用于治疗复发/难治性B细胞非霍奇金淋巴瘤的I/II期临床试验已在中国首个研究中心正式启动。该试验为I/II期临床研究，适应症为复发/难治性B细胞非霍奇金淋巴瘤。","reason","source",{"_92":93},"publishedAt","2026-11-06T11:03:00.000Z","timelineAt","category","clinical","tags",[87,88,89,90,91],"score",22,"selected",false,"channel","news","x","临床进展","肿瘤","血液","研发管线","石药集团","name","石药集团·港交所公告","r82hghui2s56vvmcahz071ky7","石药集团 SYH9061 治疗特发性肺纤维化 II 期临床试验在中国首个研究中心启动","石药集团宣布，SYH9061 用于治疗特发性肺纤维化的 II 期临床试验已在中国首个研究中心正式启动。该公告为港交所自愿公告，披露业务发展最新情况。",{"_92":93},"2026-11-06T11:05:00.000Z",[87,101,102,91],18,"呼吸","小分子","tx30oez6h4s643jle9oqt27uv","本周图表：华尔街关注的3款药物上市——诺和诺德Wegovy口服片、Madrigal的Rezdiffra与Axsome的Auvelity","诺和诺德Wegovy口服片第三季度销售额达53.9亿丹麦克朗（约8.11亿美元），超过Jefferies分析师给出的49.6亿丹麦克朗共识预期，带动公司股价上涨逾5%。",{"_92":115},"2026-11-06T12:00:00.000Z","industry",[110,111,112,113,114],"市场/销售","GLP-1","代谢/减重","诺和诺德","礼来","BioPharma Dive","rlz7gjb4z3yn5zf3s1x1unn8m","为何糖基化控制已成为复杂生物药开发的首要问题","Samsung Biologics上游开发总监Sojeong Lee指出，双特异性抗体、ADC、Fc融合蛋白等新一代抗体药物对糖基异质性远比传统mAb敏感，糖基化须从细胞株和工艺开发早期即纳入控制。",{"_92":128},"2026-11-06T13:56:24.000Z","opinion",[124,125,126,127],10,"观点/解读","抗体/双抗","ADC","细胞与基因治疗","GEN Genetic Engineering & Biotechnology News","bqvcsg31q82jiec8osoyl7g44","诺华脊髓性肌萎缩症基因疗法被曝7例儿童肿瘤新病例，英国加快药品审评","诺华承认其脊髓性肌萎缩症疗法出现7例此前未知的儿童肿瘤病例，目前被视为潜在安全性信号，SMA Europe称监管机构正在审查这些病例。另据《纽约时报》报道，美国卫生与公众服务部部长Robert F. Kennedy Jr. 9月任命的健康小组成员中有4人持有受该小组决策影响企业的股票。",{"_92":138},"2026-11-06T14:41:03.000Z",[135,127,136,137],"安全/质量","罕见病","诺华","STAT","am2liov1beuhj9a2wr1vashy4","恒瑞医药｜恒瑞医药关于2025年A股员工持股计划部分份额解锁条件成就暨第一个锁定期届满的提示性公告","",{"_92":148},"2026-11-06T16:00:00.000Z",[146,147],12,"其他","恒瑞医药","恒瑞医药·公司公告","rzi599bunfyoyhgmbzwm5owxq","华北制药｜关于公司获得《化学原料药上市申请批准通知书》的公告",{"_92":157},"approval",[154,155,156],"获批上市","NMPA","华北制药","华北制药·公司公告","p9ekq6be4zi7l0t4zqaq2zyri","NIH研究：血液中PFOA与PFOS水平较高与ER阴性乳腺癌风险升高相关","NIH研究者发现，血液中PFOA和PFOS水平最高的女性发生ER阴性乳腺癌的比率分别比最低组高67%和93%，该关联经既往前瞻性研究的meta分析验证，但两种化学物与乳腺癌总体风险未见明确关联。",{"_92":128},"2026-11-06T16:42:35.000Z","research",[165,88],"论文/研究","ecytk1ngxjfavdxbdyg79dlgf","诺华披露9例SMA患者接受Zolgensma后出现肿瘤，2例检出AAV载体DNA整合","诺华披露9名接受基因疗法Zolgensma的脊髓性肌萎缩症（SMA）患者后续出现肿瘤，其中2例检出治疗所用AAV载体整合入患者DNA的证据。诺华称每例均已通报监管机构，将继续配合后续工作；Zolgensma说明书已列明AAV可能整合入DNA的理论风险，目前全球已有6000人接受该治疗。",{"_92":115},"2026-11-06T16:51:00.000Z",[135,137,127,136],40,"v5uo8utxn0df5k8aecsgincnp","诺华确认Zolgensma治疗儿童中发生9例肿瘤，2例显示AAV载体DNA整合","诺华确认其SMA基因疗法Zolgensma（onasemnogene abeparvovec-xioi）治疗的儿童中出现9例肿瘤报告，其中7例为新披露，2例已显示载体DNA整合入患者DNA。Zolgensma为AAV9载体基因疗法，用于治疗2岁以下双等位SMN1突变的SMA患儿，全球已治疗超6000例患者，载体整合致瘤风险已列入处方信息。",{"_92":128},"2026-11-06T16:58:32.000Z",[135,127,136,137],"b7g6zrzttr26x3mksvw70ewur","衰老蛋白质组：衰老时钟、队列与临床试验——Alamar Biosciences与UCSD专家谈超灵敏多重蛋白质组学","GEN网络研讨会将邀请Alamar Biosciences CTO Xiao-Jun Ma与UCSD副教授Michael J. Corley，讨论超灵敏多重蛋白质组学如何测量衰老速度及干预效果。",{"_92":128},"2026-11-06T22:23:01.000Z",[124,112,111],8,"pw6ucp2922s9vr0aj4z2srgo9","国家药监局副局长雷平率队赴上海参加第九届进博会","国家药监局党组成员、副局长雷平于11月4日—6日率队参加第九届中国国际进口博览会，出席开幕式及由国家药监局和虹桥论坛秘书处主办的第九届虹桥国际经济论坛\"国际药品安全治理与中国药品监管改革\"分论坛并致辞。雷平表示，国家药监局着力统筹发展与安全、质量与效率、监管与服务，欢迎各国医药企业将全球医药创新成果第一时间引入中国，并支持中国优质药械走向世界。",{"_92":194},"2026-11-07T00:00:00.000Z","policy",[193,155],"政策/监管","中国食品药品网·要闻","ghn6m41gb5zbhu61vqp2q720d","上药康德乐在进博会展示供应链解法：定制化方案与全栈一体化承接复杂需求","第九届进博会期间，上药康德乐在上药控股国际大健康专场展示供应链服务实践、数智化服务产品及全球伙伴合作，以定制化方案设计和全栈一体化交付回应客户多元供应链需求。公司针对境外临床急需药械依托海南博鳌乐城“先行先试”政策提供进口、通关、仓储及配送支持，并展示市场准入管理系统与AI智能调度系统两款数智化产品。美纳里尼、蔡司中国、贝德玛、罗氏诊断、凯西等全球伙伴到场交流。",{"_92":205},"2026-11-09T00:00:00.000Z","2026-11-09T06:26:01.722Z",[202,203,204],"公司动态","医疗器械/IVD","上海医药","米内网·企业","zgab8ztwenodx87wi9bywl62s","金陵药业终止收购常州四药100%股权及四药厂部分资产","金陵药业11月8日公告决定不参加常州四药100%股权及四药厂部分土地使用权、厂房资产的竞价出售，并终止此前投资意向。公司自2026年4月13日递交《投资意向函》后已开展尽职调查、初步审计及资产评估，截至公告日未签署任何具有法律约束力的协议，称终止不会对生产经营及财务状况产生重大影响。",{"_92":205},"2026-11-09T06:26:01.734Z",[202,213],38,"投融资","seaiad78o4uisfn4q60ly09ns","葵花药业2026年前三季度净利润增349.07%，儿科中成药份额居首","葵花药业2026年前三季度营收约21.19亿元、同比增长25.81%，归母净利润约8353万元、同比增长349.07%，扣非归母净利润约4943万元、同比增长160.72%。公司拥有600余个生产批文、29个独家品种，2026H1在中国城市实体药店终端儿科中成药集团排名居首，份额保持13%以上。今年以来5个品种获批并视同过评，其中氟比洛芬凝胶贴膏为首款贴膏剂，美沙拉秦肠溶片在第12批国家集采中选。","葵花药业前三季度净利增349%，材料同时给出儿科中成药终端份额与在审新品结构，可看其增长来源。",{"_92":205},"2026-11-09T06:26:01.746Z",[202,223,110,90],60,true,"中药","g2m75iruvropozafc1wbiyc4z","广东省第三方药品电子交易平台同步20261030批次新增挂网药品数据","广东省第三方药品电子交易平台已将20261030批次审核通过且公示无异议的新增挂网药品数据同步至广东招采子系统。相关企业需使用CA登录子系统维护配送关系，挂网药品配送须覆盖全省所有参加药品采购的各类医疗机构，配送关系符合要求后医疗机构方可发起合同交易。",{"_92":232},"2026-11-08T16:00:00.000Z","2026-11-09T06:26:04.016Z",[193,231],"医保/集采","广东省药品交易中心·通知公告","h8u2loixgeqs6nckc2f1fcl45","复旦李世斌/仓静团队《Sci Adv》揭示孤束核NTSVglut2神经元驱动高碳酸血症微觉醒与睡眠变浅","复旦大学李世斌和仓静团队在 Science Advances 发表研究，鉴定出孤束核谷氨酸能神经元（NTSVglut2）介导高碳酸血症诱导的微觉醒和睡眠深度降低。",{"_92":240},"2026-11-09T06:26:04.603Z",[165,239,101],"神经/精神","生物谷","xxede83smawu4p4kjxtwoozaj","Science：小脑丹鳉全身单细胞图谱覆盖60余万细胞，DigiFish开放共享","怀特黑德研究所团队在《Science》发表首个覆盖成年脊椎动物的全身单细胞转录组图谱，基于透明小脑丹鳉（Danionella cerebrum）分析超60万个细胞，并结合空间方法定位细胞类型与基因活动。图谱揭示神经元基因活动与区域身份相关、成纤维细胞保留发育位置记忆，并追踪了端脑损伤后的再生轨迹。数据已通过DigiFish交互式资源开放共享。",{"_92":240},"2026-11-09T06:26:04.610Z",[165,239],"qfouhpr2285v45s1iu16r7456","PNAS：中国海洋大学田苗等团队发现隐蔽转录充当“筛子”，清除会误伤自身的小RNA","中国海洋大学田苗与法国蒙彼利埃大学Kazufumi Mochizuki团队在PNAS发表研究，揭示四膜虫体细胞基因组中非编码RNA源于经典启动子外的广泛隐蔽转录，依赖发育特异性中介体复合物相关蛋白Dima1和Emit2。",{"_92":240},"2026-11-09T06:26:04.617Z",[165,254,102],7,"核酸药物","ea3t2ftigaqmi282e44w9gmqq","eClinicalMedicine：15分钟平板自助测评识别轻度认知障碍，AUC达0.90","eClinicalMedicine发表跨国横断面研究，一款平板自助交互测评工具可在中位13.8分钟内识别临床确诊的轻度认知障碍，AUC为0.90，外部验证队列AUC达0.87。",{"_92":240},"2026-11-09T06:26:04.625Z",[165,239,203],"m7s37krw9qugvws6jhtaefymu","陆军军医大学王延江团队揭示Tau蛋白致蓝斑去甲肾上腺素能神经元过度兴奋机制，驱动睡眠碎片化与认知下降","陆军军医大学王延江、重庆大学谌小维团队在 Cell Reports 发表研究，利用 P301S 转基因小鼠及细胞类型特异性 tau 过表达模型发现，病理性 tau 蓄积选择性升高蓝斑多巴胺-β-羟化酶去甲肾上腺素能（LCDBH）神经元内在兴奋性，破坏睡眠稳态、减少 NREM 睡眠与慢波活动并造成识别记忆缺损。",{"_92":240},"2026-11-09T06:26:04.633Z",[165,239],"t32sk473lmvqpclem1tj9ro1w","PNAS报道LATS1/2抑制剂NCGC-6782激活YAP通路促进皮肤创面愈合","PNAS发表研究，通过激酶组筛选获得选择性LATS1/2小分子抑制剂NCGC-6782，可激活YAP信号通路促进皮肤创面增殖性愈合。该分子以AKT抑制剂AT-7867为先导经骨架跃迁优化得到，对绝大多数人类激酶具20倍以上选择窗口，口服生物利用度良好。小鼠全层皮肤缺损模型中隔日局部给药显著缩短愈合周期，未出现体重下降等全身性毒性。",{"_92":240},"2026-11-09T06:26:04.640Z",[165,102],"y0fz3zofejvvjcovbdw3bgufb","上交大AutoDNA登上《Nature》：一句话指挥20台仪器，核酸检测到肿瘤突变检测全程无人值守","上海交通大学陈海波、樊春海、王飞、王肇国团队在《Nature》发表AI原生自主生物分子实验平台AutoDNA，可将自然语言需求转化为可执行实验流程，协调20余类仪器、跨越超11,000个步骤完成核酸合成、转录、扩增与测序。",{"_92":240},"2026-11-09T06:26:04.647Z",[165,279,88],"AI 制药","jjpngod4wvkklwadhn27bw8t7","Cell研究揭示小细胞肺癌共同弱点：剥夺半胱氨酸可致死，ASCL1/GCH1 构成铁死亡防线","德国科隆大学研究人员在 Cell 发表临床前研究，发现小细胞肺癌各细胞状态均依赖半胱氨酸，剥夺后全部死亡，但死亡方式由细胞状态决定。ASCL1 低水平细胞经铁死亡死亡，ASCL1 高水平细胞则激活 GCH1 促进抗氧化剂产生而抵抗铁死亡；剥夺半胱氨酸同时阻断该保护机制可显著减缓临床前模型肿瘤生长。",{"_92":240},"2026-11-09T06:26:04.653Z",[165,88,102],"uejf9g27hot6yeoi47yycw3yq","Cell：密歇根大学与哈佛团队证实穿孔素可独立诱导肿瘤细胞铁死亡，改写免疫杀伤机制认知","美国密歇根大学罗格尔癌症中心联合哈佛医学院波士顿儿童医院在 Cell 发表研究，证实穿孔素（Prf1）不依赖颗粒酶 A/B 即可直接诱导肿瘤细胞铁死亡。机制上，穿孔素在肿瘤细胞膜成孔后触发转铁蛋白受体（TFR/CD71）内吞，促进内体-线粒体接触位点形成，导致线粒体铁过载与脂质过氧化物堆积。",{"_92":240},"2026-11-09T06:26:04.660Z",[165,88,127],14,"t4jea0bao57lbwukrk728khfm","Science：秦骏/吕伟/于政权/王桂华团队发现肝转移灶唤醒肝内造血，LM-HSCs 经 CCR1/CREB 轴产出 ANXA1⁺中性粒细胞压制免疫","秦骏、吕伟、于政权、王桂华团队在 Science 发表研究，发现肝转移灶重新唤醒肝内休眠造血程序，经 CCR1 信号招募骨髓 HSCs 形成门脉周围异位造血龛，CREB 激活驱动髓系偏倚，产出 ANXA1⁺未成熟中性粒细胞，通过糖皮质激素受体信号压制 CD8⁺ T 细胞与 NK 细胞。",{"_92":240},"2026-11-09T06:26:04.666Z",[165,88,127],"fbghv61dt06twm9y9fy8ms8v9","Ann Rheum Dis：上海交通大学吕良敬/丁显廷团队揭示系统性硬化症症状出现前的分子信号","上海交通大学医学院附属仁济医院吕良敬团队联合丁显廷团队在Ann Rheum Dis发表多组学研究，首次提出并系统刻画\"系统性硬化症特异性自身抗体阳性无症状人群\"（SSAP），将SSc早期研究窗口前移至临床前阶段。",{"_92":240},"2026-11-09T06:26:04.673Z",[165,305,136],"自免","znk9ulen7zr35q9nuwq144df1","复旦大学宋少莉等发现谷氨酰胺摄取是肝癌免疫逃逸的\"隐形检查点\"，¹⁸F-FGln PET/CT可预测免疫治疗应答","复旦大学宋少莉、Liu Fei团队在Advanced Science发表研究，发现谷氨酰胺摄取是肝细胞癌免疫逃逸的检查点。小鼠HCC模型中，¹⁸F-FGln PET/CT高摄取肿瘤Slc1a5表达升高、对抗PD-1治疗应答差，低摄取肿瘤更敏感；敲低Slc1a5或使用V-9302降低Gln摄取可提升抗PD-1疗效。",{"_92":240},"2026-11-09T06:26:04.680Z",[165,88],17,"z5ntl1g73tmtotdlutl52drzl","北卡罗来纳60县随机对照试验：社区与急救系统强化培训未改善院外心脏骤停生存率","北卡罗来纳60个县、约850万居民的随机对照试验显示，针对911调度员、急救人员和社区居民的多层面心脏骤停培训未能提高院外心脏骤停患者的生存率及良好神经功能结局。研究五年间共22,459名成年居民发生院外心脏骤停，干预县11,615人与对照县10,844人的生存情况无差异。探索性分析显示第四年旁观者实施CPR的比例有所上升，研究者认为需更长时间评估。",{"_92":138},"2026-11-08T22:15:00.000Z","2026-11-09T06:26:05.069Z",[87,320,165],"心血管","m5lc3xveu4yjejqeh01mhvktr","从诺华pelacarsen与诺和诺德IL-6靶向药心脏试验失败看AI hype为何该被质疑","美国心脏协会年会上公布的两项研究显示，诺华pelacarsen虽降低血中Lp(a)水平，却对心脏病发作和卒中发生率无影响；诺和诺德靶向IL-6的抗炎药大型研究同样未显示获益。这两次失败表明，被寄望加速新药问世的遗传学与新技术一再落空，对AI等新技术的疗效宣称应保持怀疑。",{"_92":138},"2026-11-08T09:30:00.000Z","2026-11-09T06:26:05.078Z",[124,320,137,113,328],"行业趋势","wlgr9pi4ry2d84bprqqa9elpj","AHA 科学年会三项研究：卒中后与 2 型糖尿病患者降压的挑战与分歧结果","AHA 科学年会公布的三项降压研究结果不一：REDUCE 试验显示卒中后早期加用螺内酯（spironolactone）使患者 3 个月后血压更易降至 130/80 mm Hg 以下。",{"_92":138},"2026-11-07T21:39:02.000Z","2026-11-09T06:26:05.085Z",[87,320,112],"z9e9cehp1psac0sgeqyex8tab","BIO 联合加州两家生物技术行业组织起诉 CMS，寻求叫停 GLOBE 药品定价试点","BIO 与两家加州生物技术行业组织于周五向美国加州北区联邦地区法院提起诉讼，寻求叫停 CMS 的 GLOBE 试点，主张该示范项目超越 Medicare 法定权限。GLOBE 旨在将 Medicare 药品价格与同类国家价格对齐，业界预计其实际影响有限，但希望阻止其形成先例。CMS 未立即回应置评请求。",{"_92":138},"2026-11-07T16:57:13.000Z","2026-11-09T06:26:05.094Z",[193,231,328],"tpx5qodmeehzsfp83282yd34g","诺华 pelacarsen III 期 HORIZON 试验未降低心血管事件，Lp(a) 策略受质疑","诺华 pelacarsen 在 III 期 HORIZON 试验中虽大幅降低 Lp(a)，但近 5 年随访显示心梗、卒中、紧急冠脉血运重建或死亡与安慰剂无差异。该结果于美国心脏协会科学年会公布并同步发表于《新英格兰医学杂志》，令针对这一影响 1/5 人群的遗传性心血管风险因素的研发策略面临质疑。",{"_92":138},"2026-11-07T14:50:00.000Z","2026-11-09T06:26:05.103Z",[87,320,137,254],"xg9fp4f133r51ukquyzvr98hb","尽管诺和诺德 ziltivekimab 的 ZEUS 研究未达终点，心脏病专家仍将推进抗炎药物研发","诺和诺德 ziltivekimab（靶向 IL-6 的单克隆抗体）在 ZEUS 研究中虽降低炎症细胞因子 IL-6 水平，但未减少重症患者的心脏病发作、卒中或死亡，未达主要终点。基于此，诺和诺德已叫停 HERMES 和 ATHENA 两项试验。ZEUS 详细结果在 AHA 科学年会公布并同步发表于 NEJM，心脏病专家表示仍将继续探索抗炎药物。",{"_92":138},"2026-11-07T14:35:00.000Z","2026-11-09T06:26:05.110Z",[87,320,125,113],"uomgdmzom0sppmr9kjom7wugs","赛诺菲终止STAT6降解剂SAR448272（NX-3911）I期开发，Nurix股价单日暴跌38%","赛诺菲终止了与Nurix合作开发的口服STAT6降解剂SAR448272（NX-3911）的I期开发，该药此前在欧洲开展首次人体试验并已触发赛诺菲向Nurix支付1000万美元里程碑款。",{"_92":128},"2026-11-09T01:26:46.000Z","2026-11-09T06:26:06.901Z",[202,305,102,365,366],20,"赛诺菲","罗氏","ib36t6n6wbf2qny1sle4v03ad","每周医药看点（11月2日—8日）：罕见病目录制订程序2026年版印发，海创药业HP570达成独家授权","11月2日—8日，国家卫生健康委办公厅、国家中医药局综合司印发《罕见病目录制订工作程序（2026年版）》，明确目录病种纳入条件与调整程序。海创药业将口服VAV1分子胶降解剂HP570授权给Evommune，获3000万美元首付款及最高10.7亿美元里程碑付款；明慧医药将靶向IGF-1R的MHB018A日本权益授予ASKA，获1.1亿美元首付款及最高3.3亿美元里程碑付款。",{"_92":194},"2026-11-09T06:26:07.580Z",[193,328,136,223,231,111,126,279,155,373],"FDA","f272484705k792ovyoc3s7q5e","第九届进博会美妆龙头首发首展新品盘点：欧莱雅、资生堂、雅诗兰黛等集中亮相","第九届进博会上，欧莱雅、资生堂、雅诗兰黛、爱茉莉太平洋、高丝、宝洁、花王等美妆龙头集中展示首发首展新品。欧莱雅携27个品牌参展，带来5款全球首发和10余款中国首发新品，其中金致驭龄面霜与鲜注油膜已申请备案，油养微珠精华液已于今年9月完成备案。资生堂悦薇智感视黄醇抗皱紧颜精萃水今年7月完成备案，拟于12月上市。",{"_92":194},"2026-11-08T00:00:00.000Z","2026-11-09T06:26:07.592Z",[202,328,146],3,"vdzri95dwgtd9jhsllv6ct7kd","CDE 发布《化学药生物等效性试验备案范围和程序》修订版及共性问题解答","药审中心发布修订后的《化学药生物等效性试验备案范围和程序》及共性问题解答（2026年第51号通告），自2027年2月1日起施行。此次修订旨在明确 BE 试验备案范围、完善备案工作程序，经国家药监局审查同意后发布，两份文件以附件形式随通告公布。","CDE 修订化学药 BE 试验备案范围与程序并配套共性问题解答，仿制药研发与注册人员可据此调整备案安排。",{"_92":194},"2026-11-09T06:26:07.610Z",[193,155],50,"wjm4uifgw355ewrhfjrjgclj3","翰森制药亮相2026进博会：7款创新药商业化，瑞康立伏妥塔单抗III期PFS风险降低67%","翰森制药在第九届进博会上展示抗肿瘤、代谢、自身免疫、中枢神经系统、抗感染五大领域创新进展，已实现7款创新药商业化，创新药与合作产品收入占比超85%。近三年与葛兰素史克、默沙东、罗氏、再生元等达成8项授权合作，累计首付款超10亿美元，总潜在交易价值超275亿美元。瑞康立伏妥塔单抗（B7-H3 ADC）在骨肉瘤取得近30年来首个阳性III期结果，疾病进展风险降低67%。",{"_92":401},"2026-11-07T16:00:00.000Z","2026-11-09T06:26:16.165Z",[202,328,88,112,136,126,111,397,398,399,366,400],"翰森制药","GSK","默沙东","再生元","翰森制药·公司新闻","oc05noe5ktw2vfh21yh666lub","中国生物制药TQ-A3334（TLR7激动剂）在2026 AASLD公布II期临床数据","中国生物制药在港交所自愿公告，TLR7激动剂TQ-A3334于2026 AASLD公布II期临床数据。公告未披露具体适应症、样本量及疗效终点数值。",{"_92":412},"2026-11-09T00:01:00.000Z","2026-11-09T06:26:18.312Z",[87,410,411],26,"感染/疫苗","中国生物制药","中国生物制药·港交所公告","all","tag","q","tab","time",{"_419":420,"_421":-5,"_422":222},"changelogVersion","2026-10-08T08:00","release","staticSite"]
