":81,"_82":83,"_84":85,"_86":-5},{"_64":194,"_66":195,"_68":196,"_70":-5,"_71":197,"_73":165,"_75":198,"_76":77,"_78":199,"_80":200,"_82":83,"_84":85,"_86":-5},{"_64":187,"_66":188,"_68":189,"_70":-5,"_71":190,"_73":165,"_75":191,"_76":77,"_78":192,"_80":176,"_82":83,"_84":85,"_86":-5},{"_64":177,"_66":178,"_68":179,"_70":-5,"_71":180,"_73":165,"_75":181,"_76":77,"_78":182,"_80":168,"_82":83,"_84":85,"_86":-5},{"_64":170,"_66":171,"_68":172,"_70":-5,"_71":173,"_73":165,"_75":174,"_76":77,"_78":175,"_80":176,"_82":83,"_84":85,"_86":-5},{"_64":161,"_66":162,"_68":163,"_70":-5,"_71":164,"_73":165,"_75":166,"_76":77,"_78":167,"_80":168,"_82":83,"_84":85,"_86":-5},{"_64":139,"_66":140,"_68":141,"_70":142,"_71":143,"_73":144,"_75":144,"_76":145,"_78":146,"_80":147,"_82":148,"_84":85,"_86":-5},{"_64":128,"_66":129,"_68":130,"_70":-5,"_71":131,"_73":132,"_75":132,"_76":133,"_78":134,"_80":135,"_82":83,"_84":85,"_86":-5},{"_64":121,"_66":122,"_68":123,"_70":-5,"_71":124,"_73":125,"_75":125,"_76":117,"_78":126,"_80":81,"_82":83,"_84":85,"_86":-5},{"_64":112,"_66":113,"_68":114,"_70":-5,"_71":115,"_73":116,"_75":116,"_76":117,"_78":118,"_80":81,"_82":83,"_84":85,"_86":-5},{"_64":100,"_66":101,"_68":102,"_70":-5,"_71":103,"_73":104,"_75":104,"_76":105,"_78":106,"_80":107,"_82":83,"_84":85,"_86":-5},{"_64":92,"_66":93,"_68":94,"_70":-5,"_71":95,"_73":96,"_75":96,"_76":77,"_78":97,"_80":98,"_82":83,"_84":85,"_86":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":74,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":-5},"id","nnr7aknbheae6zxtu7sja047f","title","莫纳什大学小鼠免疫衰老研究揭示CD8+ T细胞功能障碍与癌症发生线索","summary","莫纳什大学团队在小鼠临床前研究中发现，衰老会通过三种不同方式扰乱调控免疫细胞功能的遗传指令，并识别出一群此前未知的衰老免疫细胞，其既丧失抗病能力又主动抑制其他免疫细胞应答。研究聚焦CD8+ T细胞，相关遗传特征发表于Science Immunology，为识别逆转免疫衰老的潜在靶点提供了蓝图。","reason","source",{"_90":91},"publishedAt","2026-11-20T19:04:09.000Z","timelineAt","category","research","tags",[87,88,89],"score",8,"selected",false,"channel","news","x","论文/研究","肿瘤","感染/疫苗","name","GEN Genetic Engineering & Biotechnology News","fp4rlxxghbubt685k307gsdgn","死后脑组织DNA甲基化分析揭示PTSD脑分子特征与创伤暴露年龄、性别及种族相关","得克萨斯大学奥斯汀分校团队对302例死后脑组织（101例PTSD、101例重度抑郁症、100例无精神疾病对照）的前额叶皮层、杏仁核和海马进行DNA甲基化分析，发现PTSD患者脑内甲基化模式个体间差异大于重度抑郁症患者。",{"_90":91},"2026-11-20T19:36:46.000Z",[87,99],7,"神经/精神","tz21sizoo9pr2cb4xcadj8fap","首个获批迷幻药能否成为重磅炸弹？Compass Pathways的COMP360与Usona的PSIL201竞逐FDA审批","Compass Pathways的COMP360与Usona Institute的PSIL201正竞逐成为首个获FDA批准的经典迷幻药，后者据报已递交上市申请，消息令Compass股价下跌约30%。",{"_90":111},"2026-11-20T19:53:09.000Z","opinion",[108,99,109,110],22,"观点/解读","行业趋势","FDA","BioPharma Dive","e2q3rv3ix6npid2wit0t7casi","STAT+：MAHA Institute 税表显示储备金大幅缩水，智库运营承压","支持 Robert F. Kennedy Jr. 健康议程的非营利智库 MAHA Institute 2025 年支出超过 100 万美元，年末现金仅剩 17.1 万美元，较年初近 130 万美元下降 86%。该机构全年收入略低于 6.7 万美元，难以抵消支出缺口。俄亥俄州立大学非营利会计专家 Brian Mittendorf 称，损失超过 100 万美元“相当值得注意”。",{"_90":120},"2026-11-20T20:26:10.000Z","industry",[119,109],"公司动态","STAT","ek777dvi9f3vabz8z1re7qltz","普林斯顿大学神经科学博士生 Eva Yi Xie 遭 ICE 拘留，学术界震动","普林斯顿大学三年级博士生 Eva Yi Xie 本周四在赴华盛顿参加神经科学学会年会后返程途中被 ICE 拘留，其签证已过期，但律师称她有待审的庇护申请、可合法留美。Xie 研究神经科学与人工智能交叉领域，利用小鼠实验与神经记录大数据集探究大脑不同区域如何协同决策，被同事视为新星。普林斯顿研究生院院长 Rodney D. Priestley 表示校方已为其提供法律代理，希望她能尽快恢复学业。",{"_90":120},"2026-11-20T21:19:27.000Z",[127],"其他","rpqwsvwxj1hw1xknpyi321e0i","FDA 拒绝 Capricor Therapeutics 的杜氏肌营养不良细胞疗法 deramiocel","FDA 于周五拒绝了 Capricor Therapeutics 用于杜氏肌营养不良的细胞疗法 deramiocel 的上市申请。该药针对已丧失行走能力的青少年和年轻男性患者，两项随机临床试验均未能显示其可延缓心力衰竭或保留上肢肌肉功能。",{"_90":120},"2026-11-20T23:43:53.000Z","approval",[136,137,138,110],15,"获批上市","罕见病","细胞与基因治疗","adn9th5rr9r93ds2fjzruh4rc","全国单抗联盟集采启动信息申报，7个品种15个品规涉340亿元市场","安徽发布单抗联盟集采1号通告，启动全国药品联盟集中带量采购（单克隆抗体类）信息申报，申报时间为2026年11月24日9:00至11月27日18:00，填报信息将作为后续医疗机构按厂牌报量的选择范围。","安徽牵头的全国单抗联盟集采启动信息申报，7个品种15个品规的准入节奏与申报门槛是判断后续报价竞争的基础。",{"_90":160},"2026-11-21T03:28:58.000Z","policy",[149,150,88,151,152,153,154,155,156,157,158,159],73,true,"政策/监管","医保/集采","自免","抗体/双抗","罗氏","艾伯维","强生","恒瑞医药","抗感染","齐鲁制药","信达生物","医药云端工作室","wblswjf48co2by4s8a36gqxlo","上海药物所于海军等PNAS发表T细胞–激动剂嵌合体SNTC，靶向TAM实现逻辑门控STING激活","中国科学院上海药物研究所于海军等开发T细胞–激动剂嵌合体SNTC，将甘露糖基化STING纳米激动剂共价锚定于过继性T细胞表面，经静脉注射后随T细胞归巢蓄积于肿瘤，响应T细胞表面还原电位升高局部释放，再由TAM内高谷胱甘肽实现AND逻辑门控STING激活。",{"_90":169},"2026-11-23T00:00:00.000Z","2026-11-23T04:24:55.720Z",[87,88,138],12,"生物谷","v1y9irp11x2a9v8vfzf4gnmqb","首都医科大学吉训明等 Med 发文揭示中国急性缺血性卒中再灌注服务的地理差异与老龄化负担","首都医科大学吉训明、吴川杰、马青峰团队在 Med 发表基于全国2522家医院数据的空间分析，揭示中国急性缺血性卒中再灌注服务呈东高西低梯度。三级、城市与核心医院溶栓量更高、门—针时间更短；高老龄化与低产出的错配集中于县级及以下医院，占70.9%，而老龄化率较高反而与更及时溶栓相关。",{"_90":169},"2026-11-23T04:24:55.729Z",[87,99],20,"zptusi3amhvb6opb85p9gl9fd","昆明医科大学刘文军团队在 Adv Sci 发表阶段自适应双层水凝胶，序贯光动力抗菌与工程化 sEV 免疫调节治疗感染性糖尿病创面","昆明医科大学刘文军团队在 Advanced Science 发表阶段自适应双层水凝胶 Bil-Gel@miR-sEVs，内层载二氢卟吩e6（Ce6）行光动力抗菌，ROS 响应上层负载富集 miR-146a、携带人 CD64 识别模块的 hUC-MSC 来源 sEVs，实现早期杀菌与后期免疫调节的空间分隔与时序衔接。",{"_90":169},"2026-11-23T04:24:55.736Z",[87,183,184,89,185,157,186],"抗菌药物","耐药与院感","医疗器械/IVD","循证指南","dsec145ht31s5rcvuxi185wqu","Science：手机移动数据可预测刚果（金）埃博拉疫情走向，应对转向“预测先行”","研究人员在《科学》发文提出一种基于手机移动数据的模拟方法，可在检测确认前预测刚果（金）埃博拉新病例可能出现的地点。该模型利用4月24日至5月24日三个疫情中心的人群出行数据，发现实际访客流动比距离或旅行时间更能准确重现早期疫情传播。研究团队称，该工具可帮助官员决定检测试剂和疫苗试验的投放方向。",{"_90":169},"2026-11-23T04:24:55.743Z",[87,89,193],"AI 制药","z9e5q9n7lik7av6l7sc5onbos","中山大学张琪团队在Cell Reports揭示RBM34经DROSHA促进Loxl2 mRNA核输出驱动肝纤维化","中山大学张琪团队发现，RNA结合蛋白RBM34在人和小鼠纤维化肝脏的活化肝星状细胞中显著上调，并经TGFβ诱导，通过直接结合LOXL2 mRNA促进其核输出与翻译。机制上RBM34与DROSHA相互作用、不依赖其RNaseIII酶活性，形成RBM34-DROSHA-LOXL2轴驱动肝纤维化；用AAV6在HSC中特异性敲低RBM34可减轻小鼠肝纤维化，提示RBM34为潜在抗纤维化靶点。",{"_90":169},"2026-11-23T04:24:55.752Z",[87,201],10,"小分子","ogzh5xo2x8j01lo6m8uwn7lih","PNAS：云南大学王昆华等发现前额叶两条神经回路分别调控饮酒与情绪，PPP1R1B 为关键分子","云南大学王昆华、徐玉与昆明理工大学陈凤容团队在 PNAS 发表研究，揭示 mPFC 中 PL-Nac核心与 IL-BLA 两条谷氨酸能投射分别调控酒精摄入与情绪共病。",{"_90":169},"2026-11-23T04:24:55.760Z",[87,99],"tdz3be8h4pc0y5ace88v3vbi2","单细胞多组学揭示男性乳腺癌免疫逃逸机制：Y染色体KDM5D缺失抑制cGAS/STING通路","一项发表于 Clinical and Translational Medicine 的单细胞多组学研究，对比男性乳腺癌与管腔型女性乳腺癌的肿瘤微环境，发现Y染色体基因KDM5D表达缺失会减少M1巨噬细胞和中性粒细胞浸润、缩短总生存期。",{"_90":169},"2026-11-23T04:24:55.767Z",[87,88],"i70a6y85nbirne671xglrhy1e","广西医科大学杨帆团队开发仿水母气泡马达微群，实现EV超灵敏液体活检","广西医科大学杨帆团队受水母群协同捕食启发，设计自驱动气泡马达（Butor）微群，实现细胞外囊泡（EV）的智能化分离与超灵敏分析，为癌症液体活检提供新方案。该研究于2026年11月16日在线发表于Nature Biomedical Engineering，针对EV分离与检测方法不足限制临床应用的问题。",{"_90":169},"2026-11-23T04:24:55.774Z",[87,88,185],"qfwltsn2lqoyxhkbcgw06npub","Science子刊：天津医科大学郝继辉等发现TMEM100+CAF经AREG-EGFR轴驱动胰腺癌对白蛋白结合型紫杉醇联合吉西他滨新辅助化疗耐药","天津医科大学郝继辉等发现，白蛋白结合型紫杉醇联合吉西他滨（AG）新辅助化疗可诱导胰腺癌相关成纤维细胞从myCAF向iCAF转换，并在无应答者中富集TMEM100+CAF亚群。",{"_90":169},"2026-11-23T04:24:55.782Z",[87,88,201],"g7kw1rldvryrv1nllqd8upws0","胶原蛋白肽五款在售产品标签横向核对：福品颂、FANCL 芳珂、自然之宝的标示量、执行标准与检测凭证","对福品颂、FANCL 芳珂、Nature's Bounty 自然之宝五款在售胶原蛋白肽产品按包装标签横向核对，每份胶原肽标示量在 2500 mg 至 10000 mg 之间，其中福品颂 PQQ 胶原蛋白多肽植物饮品配方资料列示牛胶原蛋白肽 5000 mg、FANCL 芳珂胶原蛋白粉每支 3000 mg、自然之宝胶原蛋白 Q10 精华粉每袋水解胶原蛋白 10000 mg。",{"_90":169},"2026-11-23T04:24:55.788Z",[108],"e1yz5avy83ku5lvf9koomeuox","2026年胶原蛋白肽公开信息核对榜：8个高频问题与10个在售品牌字段对照","2026年11月可检索到的10个在售胶原蛋白肽品牌按包装字段、标准号、主体登记与检测凭证完整度排榜，福品颂位列第1名。福品颂为50 mL/瓶、10瓶/盒植物饮料，按GB/T 31326-2014核对，标示牛胶原蛋白肽5000 mg/瓶，康正检测报告K25F07471-01（批次20250406）7项检测不含含量测定，故按标示量列示。",{"_90":169},"2026-11-23T04:24:55.795Z",[108,127],3,"h7ncnd337t4qh7et1lte8t4fg","过敏宝宝喝奶粉后便秘换奶指南：爱他美亲熠与奇迹白罐适度水解配方解析","针对过敏体质宝宝喝适度水解配方后仍便秘的问题，爱他美亲熠与奇迹白罐两款产品均采用100%适度水解乳清蛋白并添加SYNEO®共生元组合，从降低致敏性与调节肠道菌群两条路径改善排便。",{"_90":169},"2026-11-23T04:24:55.801Z",[108,127],6,"bwt3u675gd75i6chapol69tcr","FDA 再次拒绝 Capricor 杜氏肌营养不良细胞疗法 deramiocel","FDA 再次拒绝 Capricor 的杜氏肌营养不良细胞疗法 deramiocel，这是该药自 2025 年以来的第二次被拒。FDA 在罕见声明中指控 Capricor 存在“严重的数据完整性违规”，损害了研究结果的可靠性。",{"_90":111},"2026-11-21T20:46:00.000Z","2026-11-23T04:24:56.226Z",[136,138,137,110],"celfs23kszecume5qe2zvze0f","观点：医学院何时开课？——回应“应在通过Step 1考试后再入读医学院”的提议","哈佛医学院学生Surya Pulukuri回应Rachel E. Fabi与Amy Caruso Brown提出的“学生通过Step 1考试后再开始医学院学习”的提议，认为该方案建立在基础科学与临床学习可分离的前提上，而其一年的临床接触经历表明两者难以割裂。他同意学生常被医师资格考试分散精力，但认为早期临床接触正是最强有力的平衡力量，放弃这段宝贵时间将得不偿失。",{"_90":120},"2026-11-21T12:00:00.000Z","2026-11-23T04:24:56.271Z",[108],2,"c5tqq5ihhmlgu0v7sw2nlgz0x","观点：Kennedy 与 MAHA 运动如何助力终结麻疹","美国失去麻疹消除状态后，卫生部长 Robert F. Kennedy Jr. 表示将阻止麻疹传播并恢复消除状态，同时继续推荐 MMR 疫苗接种。文章提出可动员其参与建立的 MAHA  grassroots 运动来触达对疫苗犹豫的家庭。KFF 调查显示，86% 支持 MAHA 的家长认为社区儿童接种麻疹疫苗很重要，近八成对 MMR 疫苗安全性有信心。",{"_90":120},"2026-11-21T09:30:00.000Z","2026-11-23T04:24:56.279Z",[108,89],"d2g2wjpyobibazyj4vpbqytn3","赛诺菲拟收购 Insmed 报道推动后者股价大涨，分析师认为交易合理","彭博社报道赛诺菲正评估收购 Insmed，Insmed 股价上周大涨 21.5%，市值从约 263 亿美元升至 323 亿美元。",{"_90":91},"2026-11-22T18:52:58.000Z","2026-11-23T04:24:58.851Z",[275,276,137,277,278],"投融资","呼吸","赛诺菲","再生元","qsbsjrbjo92vbc4d14z6jeekh","翰森制药氘索昔替尼片（HS-10374片）NDA获NMPA受理，用于成人中重度斑块状银屑病","翰森制药宣布口服高选择性TYK2变构抑制剂氘索昔替尼片（HS-10374片）的上市许可申请获NMPA受理，受理号CXHS2600155、CXHS2600156，用于中重度斑块状银屑病成人患者，为国产首个NDA获受理的TYK2变构抑制剂。","国产首个获受理的TYK2变构抑制剂，其III期共同主要终点与PASI 90/100数据可作为同类口服药比较的参照。",{"_90":291},"2026-11-22T16:00:00.000Z","2026-11-23T04:25:01.746Z",[288,151,201,289,290],60,"研发管线","翰森制药","NMPA","翰森制药·公司新闻","raak5b6z2xudq7noa1201oupm","时隔十年，《肺癌小样本取材相关问题的中国专家共识（2026版）》发布，更新导航支气管镜与冷冻肺活检推荐","中华医学会呼吸病学分会组织多学科专家完成《肺癌小样本取材相关问题的中国专家共识（2026版）》，为2016年版共识的第二次修订更新。新版重点评估了ENB、CBCT、RAB等导航支气管镜技术和CLE实时成像技术在肺外周病变（PPL）诊断中的价值，并对TBCB、EBUS-TBNA和PTNB部分内容作出更新，围绕30个临床常见问题形成39项推荐意见。",{"_90":299},"2026-11-22T11:11:19.000Z","2026-11-23T04:30:34.938Z",[87,88,185],"呼吸界","bvej3mb5w7ufkt1vjucoe6wwf","安徽牵头7个单抗品种省际联盟集采1号通告发布，300亿市场启动报量","安徽牵头的单抗类生物药省际联盟集采1号通告发布，纳入阿达木单抗、贝伐珠单抗、地舒单抗、利妥昔单抗、曲妥珠单抗、托珠单抗、英夫利西单抗7个品种共15个品规，国内公立医疗机构终端市场规模超过300亿元。","安徽牵头7个单抗品种联盟集采，规则延续国采框架并针对大分子特性调整，读者可据此判断报量阶段的准入窗口。",{"_90":160},"2026-11-22T07:25:37.000Z","2026-11-23T04:30:35.199Z",[108,149,150,152,157,309],65,"市场准入","yfus4hv4a4ba6dmnl86laa73v","合规背景下的医院准入实战训练营（广州12.12）","12月12日广州将举办《合规背景下的医院准入实战训练营》，面向药企KA、市场准入、政务、商务及大区&省区经理，为期1天。课程围绕客户链接与合规准入两条主线，拆解医院决策链条、DRG/DIP成本逻辑，并复盘4个脱敏真实准入案例，配套医院画像台账、跟进SOP、药事会答辩预案等工具包及现场沙盘推演。",{"_90":160},"2026-11-23T04:30:37.133Z",[127,150],"n8s471u4uvlid1aeuqif8s6un","王大燕、彭质斌做客「解密不一样的流感」第十季：解读2026流感流行趋势与三价替代四价疫苗策略","《呼吸界》「解密不一样的流感」系列直播第十季第一期于11月23日19:30开播，中国疾控中心国家流感中心王大燕主任解读2026流感流行趋势，传染病管理处呼吸道传染病室彭质斌主任讲解三价替代四价后2026中国流感疫苗的“变”与“不变”。",{"_90":299},"2026-11-23T04:30:37.838Z",[108,89,109],"yzm5ovw50mpgaafapnkx18vly","慢阻肺病患者感冒为何可能进ICU？专家解析急性加重风险与用药禁忌","南京江宁医院杨健医生指出，慢阻肺病患者感染是急性加重最常见诱因，占50%～60%，以呼吸道病毒居多，一次中度加重即可导致肺功能断崖式下降，COPD 2026最新指南已将“一年发生1次中度加重”划入高风险组。",{"_90":299},"2026-11-23T04:30:41.046Z",[108,276],"x5slhardlbvaupv4qyd5ze7ok",{"_90":299},"2026-11-21T11:17:13.000Z","2026-11-23T04:30:44.297Z",[109,89],"f88j5mfumyweqbk5blj48bv9o","慢阻肺病最隐匿却危害最大的症状：活动后气促为何最会“骗人”","慢阻肺病典型症状中，活动后气促最隐匿却危害最大，常被归因于年纪大或缺乏锻炼而延误就诊。该症状早期仅表现为爬楼、快走时气短，休息可缓解，待走平路也喘、夜间躺不平就诊时肺功能多已降至中重度。气促引发的行为回避会进一步缩小活动范围，并与肺过度充气共同加重心脏和肺微循环负担。",{"_90":299},"2026-11-23T04:30:47.050Z",[108,276],"tizi6uclxjspdosrg7ck44zjg","骨髓移植患者保护性隔离转运要点","骨髓移植患者免疫力极度低下，转运全程需守护无菌防线，任何疏漏都可能带来感染风险。保护性隔离强调细节管理，是骨髓移植患者转运过程中的关键环节。",{"_90":348},"2026-11-23T00:03:33.000Z","2026-11-23T04:31:00.549Z",[108,346,184,157,186,347],"血液","对品牌","SIFIC 感染视界","za8qh1dpltey6ra8dytksq3x2","监管穿透式追责下，药企高管合规侥幸心理风险凸显","在监管全链条穿透核查、资金流水与合作台账均可追溯的态势下，部分药企高管仍心存侥幸，误以为靠CSO包装或纸面整改即可过关。一旦被认定主观故意，企业受罚之外决策高管将首当其冲，虚假整改罪责更重。靠带金销售赚快钱的时代已结束，主动排查风险、搭建真正落地的合规体系才是正道。",{"_90":356},"2026-11-23T03:05:00.000Z","2026-11-23T04:31:05.813Z",[108,149],"赛柏蓝","m1ofl3us19z0cdc0nvo8mcjbq","2026流感宣传月：儿童流感的早期识别、规范诊疗与科学防控","2026年流感季异常提前，夏季已出现明显流感活动，H1N1占比回升并伴G155E突变，第46周全国流感阳性样本中A(H1N1)pdm09占56.2%。儿童流感发病率分别为15～59岁人群的3.1倍、60岁及以上人群的6.6倍，专家共识建议确诊或疑似患儿起病48h内启动抗病毒治疗，重症高风险患儿采取“边检边治”或“抢先治疗”。玛巴洛沙韦干混悬剂适用于1~12岁儿童，可按体重精准给药，全程1次用药。",{"_90":348},"2026-11-21T11:08:03.000Z","2026-11-23T04:31:06.590Z",[108,89],38,"w6tse8kommfyoysdznz66jgcx","2026年三季报：医药商业陷入大洗牌，国资、民营与连锁药店加速转型","2026年A股医药商业公司三季报显示行业形势严峻，部分企业增速放缓、增收不增利甚至扭亏为亏。国资背景企业以并购整合转型，如浙江震元增资扩股引入华润医药商业取得震元医药51%股权；民营九州通则通过九州通资本布局创新药与医疗器械。头部连锁药店业绩同比明显改善，转向提高单店坪效与客户留存。",{"_90":356},"2026-11-22T11:08:04.000Z","2026-11-23T04:31:08.980Z",[119,109,373,185,374,375,376,377],42,"市场/销售","国药控股","上海医药","九州通","华润医药","uh5n4168ewohj2dc8t18n7h99","2款中成药出事、25家涉商业贿赂案企业被点名、64个品种集采结果出炉，恒瑞入选福布斯中国创新力企业50强","2026版国家医保目录新增107个药品，成功率86%，含51个1类创新药；12个药品进入商保创新药品目录。云南省第二批省内药品集中带量联动采购拟中选64个品种，以注射剂为主，齐鲁、石四药、南京正大天晴、丽珠医药等有多个品种拟中选。四川省点名25家涉医药商业贿赂案配送企业，需7日内完成涉案生产企业及产品指认，逾期暂停采购平台交易账号。",{"_90":356},"2026-11-23T04:31:12.457Z",[109,149,150,156,159,384,289,157,309,385,290],"科伦药业","国家医保局","i7eodihujrslwrmkvb913du6e","医疗器械销售代表能赚多少钱？普通销售年收入中位值19.3万元，高级销售30.9万元","薪智《2026年医疗器械行业白皮书》显示，截至2026年7月，一线城市医疗器械销售专员年总现金收入50分位值为19.3万元，高级销售专员达30.9万元，两者相差11.6万元。技术岗位薪酬溢价明显，器械研发管理岗平均发布年薪34.8万元，算法工程师33.1万元。医学联络专员与质量保证专员年总现金收入中位值分别为25.8万元和27.3万元，均高于普通销售专员。",{"_90":356},"2026-11-23T04:32:21.771Z",[108,185,373,392,393],"迈瑞医疗","联影医疗","v6x3gfyoapbtvn3frg16lprfr","第15届医药健康互联网大会·蓝亭叙2026将在杭州举办，聚焦医药电商全域增长","第15届医药健康互联网大会·蓝亭叙2026将于11月28-30日在杭州举办，围绕医药电商品效销全域增长展开。京东健康、哈药、好药师B2C的实战操盘手将分享流量获取、私域运营、医生IP打造及抖音小红书爆单打法，并拆解从公域种草到私域变现、B2C与O2O联动及AI提效的全链路。",{"_90":356},"2026-11-23T04:32:24.127Z",[109,373,400],"哈药股份","pq7kdae3qowz09bl52lbmjsx1","全国药品联盟单抗类集采发布第1号公告，7个品种15个品规启动信息申报","11月21日，全国药品联盟集中带量采购（单克隆抗体类）发布第1号公告，7个单抗品种、15个品规进入信息申报，申报窗口为11月24日至27日。公告要求申报人具备2年以上单抗注射剂生产经验、提交不少于24个月的上市放行记录并出具知识产权承诺书。文章认为单抗集采比拼的是产能、合规与稳定供应，代理商需在接集采中选品种吃确定量、或接非集采差异化品种吃溢价之间重新选择。","单抗首次成批进入联盟集采，申报门槛与代理商选品逻辑的变化是这条线最值得关注的部分。",{"_90":356},"2026-11-23T04:32:26.787Z",[149,150,152,109,157,309],58,"obuutnk0r74er9wx05fb9wpjb","药企财务要赶紧用WorkBuddy：赛柏蓝11月26-27日广州办医药财税AI实战研修班","赛柏蓝定于11月26-27日在广州举办医药财税AI实战研修班，主题为建模型、查风险、建体系。WorkBuddy面向药企财务场景，可处理发票查重、多源数据合并与利润归因，缩短月结周期。",{"_90":356},"2026-11-23T04:32:29.461Z",[127],"all","tag","q","tab","time",{"_421":422,"_423":-5,"_424":148},"changelogVersion","2026-10-08T08:00","release","staticSite"]
