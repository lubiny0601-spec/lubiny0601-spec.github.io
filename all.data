":83,"_84":85,"_86":-5},{"_64":176,"_66":177,"_68":154,"_70":-5,"_71":178,"_73":156,"_75":156,"_76":-5,"_78":179,"_80":119,"_82":83,"_84":85,"_86":-5},{"_64":170,"_66":171,"_68":154,"_70":-5,"_71":172,"_73":156,"_75":156,"_76":-5,"_78":173,"_80":21,"_82":83,"_84":85,"_86":-5},{"_64":162,"_66":163,"_68":154,"_70":-5,"_71":164,"_73":156,"_75":156,"_76":165,"_78":166,"_80":81,"_82":83,"_84":85,"_86":-5},{"_64":152,"_66":153,"_68":154,"_70":-5,"_71":155,"_73":156,"_75":156,"_76":157,"_78":158,"_80":21,"_82":83,"_84":85,"_86":-5},{"_64":145,"_66":146,"_68":147,"_70":-5,"_71":148,"_73":149,"_75":149,"_76":77,"_78":150,"_80":151,"_82":83,"_84":85,"_86":-5},{"_64":135,"_66":136,"_68":137,"_70":-5,"_71":138,"_73":139,"_75":139,"_76":77,"_78":140,"_80":119,"_82":83,"_84":85,"_86":-5},{"_64":129,"_66":130,"_68":131,"_70":-5,"_71":132,"_73":133,"_75":133,"_76":98,"_78":134,"_80":81,"_82":83,"_84":85,"_86":-5},{"_64":121,"_66":122,"_68":123,"_70":-5,"_71":124,"_73":125,"_75":125,"_76":126,"_78":127,"_80":119,"_82":83,"_84":85,"_86":-5},{"_64":113,"_66":114,"_68":115,"_70":-5,"_71":116,"_73":117,"_75":117,"_76":77,"_78":118,"_80":119,"_82":83,"_84":85,"_86":-5},{"_64":103,"_66":104,"_68":105,"_70":-5,"_71":106,"_73":107,"_75":107,"_76":77,"_78":108,"_80":109,"_82":83,"_84":85,"_86":-5},{"_64":94,"_66":95,"_68":96,"_70":-5,"_71":97,"_73":74,"_75":74,"_76":98,"_78":99,"_80":81,"_82":83,"_84":85,"_86":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":74,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":-5},"id","j3o4x2htlr67k1gojcjfbg38p","title","本周图表：脑部药物重回风投视野，五家神经科学初创公司融资约4.5亿美元","summary","五家神经科学初创公司近几周合计融资约4.5亿美元，其中Oyster Therapeutics完成6000万美元A轮，由4BIO Capital领投、礼来参投，目标是降解与阿尔茨海默病相关的蛋白。","reason","source",{"_92":93},"publishedAt","2026-11-13T14:00:00.000Z","timelineAt","category","industry","tags",[87,88,89,90,91],"score",12,"selected",false,"channel","news","x","投融资","行业趋势","神经/精神","细胞与基因治疗","礼来","name","BioPharma Dive","yubi9hcv4tm96sfe2jome1hi6","两名参议员提出法案，拟约束美国预防服务工作组利益冲突","参议员 Angus King 与 Elizabeth Warren 提出法案，为美国预防服务工作组（USPSTF）成员资格和利益冲突规避制定标准。此前 STAT 报道该工作组多名成员持有制药和医疗器械公司股票，其中两人拥有可能因工作组推荐特定诊疗而获利的私人诊所，联邦官员已给予全体成员豁免。该工作组已超过一年未召开会议。",{"_92":102},"policy",[100,101],"政策/监管","其他","STAT","guhnsxnt1oi6mp8scrdhxkrds","武田发作性睡病药物Orzeyful获DEA批准在美上市，辉瑞Premarin退出加拿大市场","武田的发作性睡病药物Orzeyful获美国DEA列为Schedule IV管制物质后正式在美上市，成为首个针对该罕见睡眠障碍潜在病因的治疗药物，60片装全规格定价16,500美元。辉瑞则因内部审查决定停止在加拿大销售激素替代疗法药物Premarin，其阴道乳膏自6月起已短缺且不再供货。",{"_92":102},"2026-11-13T14:33:16.000Z",[110,89,111,112],10,"公司动态","武田","辉瑞","l09eh0j6450k8a60mohmf1eu3","Synchron 暂停第二代脑机接口临床试验","Synchron 已暂停其第二代脑机接口的临床试验，该无线版设备通过静脉导管将支架置入大脑运动皮层附近，旨在让用户以脑活动连接数字设备。公司负责人称暂停与安全性无关，同时将在纽约市裁员并着手开发新设备。CEO Tom Oxley 此前曾称系统中有数百个组件，某一组件延迟拖慢了向 FDA 的申报。",{"_92":102},"2026-11-13T14:40:32.000Z",[110,120],8,"医疗器械/IVD","mhk725ro72xppnkurc9pss01x","评论：器官捐献新规对家属不公平","美国器官获取与移植网络（OPTN）11月18日起实施新规，允许器官获取组织在患者家属决定是否撤除生命支持治疗前就接触家属讨论捐献，以增加可移植器官供给。作者作为俄勒冈健康与科学大学神经重症监护医生指出，此举模糊了救治医生与器官获取团队的界限，可能让家属对ICU救治产生不信任。",{"_92":102},"2026-11-13T14:59:54.000Z","opinion",[128,100],"观点/解读","pir9ghih79eketwf5t8zey5jt","HHS 计划资助伊博格碱（ibogaine）治疗 PTSD 研究","HHS 计划为伊博格碱（ibogaine）治疗 PTSD 的研究提供资金。原文未披露资助金额、研究分期与样本量等细节。",{"_92":102},"2026-11-13T15:25:46.000Z",[100,89,88],"hlu5qece2bjlryuu1g9fj6s5t","下游工艺：当目标分子“不听话”时，如何纯化复杂抗体药物","一场GEN网络研讨会将于12月8日举行，来自阿斯利康、Avid Bioservices和Thermo Fisher Scientific的下游工艺专家将讨论双特异性抗体、多特异性抗体、抗体片段、Fc融合蛋白、ADC等工程化抗体格式的纯化策略。",{"_92":144},"2026-11-13T15:39:32.000Z",[101,141,142,88,143],"抗体/双抗","ADC","阿斯利康","GEN Genetic Engineering & Biotechnology News","ozpqjwjt77fddycbh73qrryzm","Cerevance 任命 Karl Kieburtz 为首席医学官","Cerevance 聘请 Karl Kieburtz 担任首席医学官。这是 STAT+ 每周人事变动栏目本期重点介绍的人事任命。",{"_92":102},"2026-11-13T15:48:14.000Z",[110],5,"drskln6ge349cgn852petpszh","恒瑞医药｜恒瑞医药关于获得药物临床试验批准通知书的公告","",{"_92":161},"2026-11-13T16:00:00.000Z","clinical",[159,160],"临床进展","恒瑞医药","恒瑞医药·公司公告","tk8se50qhie1qoajx4cwarift","海正药业｜浙江海正药业股份有限公司关于子公司获得兽药产品批准文号批件的公告",{"_92":169},"approval",[167,168,101],"获批上市","海正药业","海正药业·公司公告","vgvty103qexrnq9sn5zcn8q9m","健康元｜健康元药业集团股份有限公司关于2026年第三季度业绩说明会召开情况的公告",{"_92":175},[101,174],"健康元","健康元·公司公告","wjrqizsxuibmort3rmw8jhk7k","恒瑞医药｜恒瑞医药关于2025年A股员工持股计划第一个锁定期解锁执行完毕的公告",{"_92":161},[101,160],"sjbxnnemrbkr4d3edsf0z35kc","丹麦医院中耐万古霉素肠球菌如何演化：ITQB NOVA 解析 VREfm ST80 的兴衰机制","葡萄牙 ITQB NOVA 团队对丹麦 9 家医院 2012–2020 年收集的 334 株 vanA 型 VREfm ST80 分离株（83% 定植、17% 感染）做全基因组测序与系统发育分析，发现亚簇 1.A 在 2012–2015 年占 72%，2016–2020 年分离株分散于全部亚簇、多样性上升。",{"_92":144},"2026-11-13T20:02:36.000Z","research",[188,189,190,191,192,193],20,"论文/研究","抗菌药物","耐药与院感","抗感染","循证指南","对市场","mskrnocb3zbuid2ybqrz2sn0a","ASAM 发布首份美托咪定戒断识别与处理全国性指导意见","美国成瘾医学学会（ASAM）本周发布首份全国性指导意见，用于识别和处理使用镇静剂美托咪定（medetomidine）的患者。该文件属“考量”而非指南，因尚无更大规模研究验证临床推断。",{"_92":102},"2026-11-13T20:45:42.000Z",[100,200,89],"安全/质量","xlnbumx413ndgocc35xc52xoe","民主党人就「Medicare for More」与「Medikids」提案形成共识","民主党正围绕「Medicare for More」提案凝聚共识，该政策旨在向更多美国人提供 Medicare 覆盖，被视为可避免党内温和派与自由派分歧的折中方案。另一项「Medikids」提案拟为从出生至 26 岁人群提供免费医疗保险，同样在民主党内获得越来越多支持。",{"_92":102},"2026-11-13T21:46:05.000Z",[100,207],"医保/集采","x6v907wroesx32lxg14sl10ai","MD Anderson 构建 ER+ DCIS 细胞图谱，揭示浸润性乳腺癌进展线索","MD Anderson 研究团队在 Science 发表 ER+ 导管原位癌（DCIS）肿瘤微环境细胞图谱，通过单细胞 RNA 测序分析 159 例患者的 854,911 个细胞、空间转录组分析 39 份样本，鉴定出 9 种细胞类型和 60 种细胞状态。",{"_92":144},"2026-11-13T22:04:09.000Z",[188,214,215],"肿瘤","AI 制药","y4q8qmv8qpk29h02c3eootsu8","特朗普政府将 Medicaid 工作要求执行推迟六个月","特朗普政府周五宣布，将各州开始执行 Medicaid 工作要求的期限额外延长六个月，各州原需在 1 月 1 日前完成系统准备。该要求源自去年通过的 One Big Beautiful Bill，规定 ACA 扩围后各州须确保无受抚养子女的工作年龄受助者每月工作、就学或志愿服务至少 80 小时，残疾、照护幼儿或\"medical frail\"者除外。",{"_92":102},"2026-11-13T22:21:56.000Z",[100,207],"wfjjtg4pmgbzbrd39uih80djd","国家医保局印发2026年版医保药品目录及商保创新药目录，2027年1月1日起执行","国家医保局、人力资源社会保障部印发《国家基本医疗保险、生育保险和工伤保险药品目录（2026年）》和《商业健康保险创新药品目录（2026年）》，两版目录均自2027年1月1日起执行，2025年版同时废止。","新版医保目录与商保创新药目录同步印发，读者可据此梳理执行时间、支付标准与进院衔接要求。",{"_92":231},"2026-11-14T00:00:00.000Z",[100,207,231],88,true,"国家医保局","es4cw3eqedoqn7nypvwox7911","恒瑞医药公告公司药品纳入国家医保目录","恒瑞医药发布公告，说明公司药品纳入国家医保目录。公告未披露具体药品名称、适应症及纳入方式。",{"_92":161},"2026-11-15T16:00:00.000Z","2026-11-16T00:55:08.298Z",[100,207,160],62,"x31n2db92vy3sut3ri8fk47ql","华东医药公告全资子公司产品及合作产品纳入国家医保目录及商保创新药目录","华东医药发布公告，称其全资子公司产品及合作产品纳入国家医保目录及商保创新药目录。公告未披露具体产品名称、适应症及纳入方式。",{"_92":248},"2026-11-16T00:55:12.313Z",[100,207,247],75,"华东医药","华东医药·公司公告","xv32ttkjsz2akjfpcxtn9d3rv","四川大学梁淑芳团队发现DDX3的SUMO化开关：病毒将抗病毒蛋白改造成肿瘤推手","四川大学梁淑芳团队在Advanced Science发表研究，揭示HBV感染下DDX3的SUMO化与去SUMO化动态调控机制。",{"_92":258},"2026-11-16T00:00:00.000Z","2026-11-16T00:55:13.196Z",[188,214,256,257],"感染/疫苗","小分子","生物谷","gsi6a5l948tgszxtjr3ouzx7c","Immunity：莫纳什大学研究发现抗衰老新靶点 GzmK，可解耦机体衰老与免疫衰老","莫纳什大学研究团队在 Immunity 发表研究，发现颗粒酶 K（GzmK）可驱动年龄相关组织纤维化和器官功能障碍，但不促进免疫衰老。在年轻和老年 GzmK−/− 小鼠中，GzmK 缺失显著减轻器官衰老，同时免疫衰老表型持续存在，表明机体衰老与免疫衰老可以解耦。肾脏中该效应与补体沉积减少相关，肝脏中则伴随核心糖蛋白聚糖（decorin）增加及促纤维化 TGF-β 信号减弱。",{"_92":258},"2026-11-15T00:00:00.000Z","2026-11-16T00:55:13.205Z",[188,101],"oix0jkjcdf2bm20vw0tf9b7qa","东芬兰大学研究：中年男性动物蛋白摄入越多，血清睾酮水平越低","东芬兰大学等机构基于库奥皮奥地区缺血性心脏病危险因素研究中2546名42-60岁芬兰东部男性的数据发现，动物蛋白与植物蛋白摄入量同血清睾酮水平呈相反关联：动物蛋白摄入最高组总睾酮平均比最低组低1.2 nmol/L，植物蛋白摄入最高组则高1.1 nmol/L，SHBG浓度呈类似关联。",{"_92":258},"2026-11-16T00:55:13.214Z",[188,272],"代谢/减重","u2o9lynnmhmeh068g98nkm7dc","陈晓亚/万里团队《Nature》揭示植物NIB1感知昆虫效应子产生的2′,3′-cNMP激活抗虫免疫","中国科学院分子植物科学卓越创新中心陈晓亚院士团队联合万里研究团队在《Nature》发表研究，揭示植物RNA结合蛋白NIB1可感知昆虫效应子T2家族核糖核酸酶（如NVR1）切割RNA产生的2′,3′-cAMP、2′,3′-cGMP及ApG>p等环磷酸核苷酸信号。",{"_92":258},"2026-11-16T00:55:13.222Z",[188,257],"y6xqcmabd2f8ickiprhbmguic","晁代印/严建兵合作《Cell》：鉴定ZmNAET1揭示烟胺介导镍向籽粒转运机制","中国科学院分子植物科学卓越创新中心晁代印与华中农业大学严建兵共同通讯在Cell发表研究，首次鉴定出调控禾本科作物籽粒镍积累的关键转运蛋白ZmNAET1。该转运蛋白介导烟胺（NA）分泌，实现节中烟胺依赖性镍的韧皮部装载并向库器官转运；缺乏ZmNAET1的突变体出现显著产量损失、种子萌发变慢及种子寿命急剧缩短，镍补充可完全挽救上述表型。",{"_92":258},"2026-11-16T00:55:13.229Z",[188],"x99lsxihqjo3ecq7stkku9ssy","广西大学覃一峰团队在Autophagy发表研究：猪星状病毒衣壳蛋白经ER应激诱导自噬降解MAVS抑制I型干扰素","广西大学覃一峰团队在Autophagy发表研究，揭示猪星状病毒（PAstV）衣壳蛋白通过诱导内质网应激激活EIF2AK3/PERK-EIF2S1/ATF4通路，进而启动自噬，以非经典、不依赖caspase-3的方式促进MAVS降解，抑制I型干扰素产生。该研究利用PAstV1-GX1毒株感染PK-15细胞，发现衣壳蛋白同时定位于线粒体和内质网并与MAVS相互作用。",{"_92":258},"2026-11-16T00:55:13.238Z",[188,256,291],"自免","uanqxiwzwawt474szqsl104k0","Nat Commun：海军军医大学李天亮/李楠揭示p50–PRMT6–IL-1β恶性回路驱动肠道炎症","海军军医大学李天亮、李楠团队在Nature Communications发表研究，发现IBD患者肠道髓系细胞中PRMT6持续下调，而IL-1β表达上调。",{"_92":258},"2026-11-16T00:55:13.244Z",[188,291,257],"b2ydg94t1vxpx4vcu1cw2mpal","Cancer Res：复旦大学尤超团队揭示保乳术后复发机制，CD24+肿瘤细胞与BGN+CAF空间共定位可独立预测复发","复旦大学尤超团队在Cancer Research发表研究，对22例患者的原发乳腺癌与配对同侧乳腺肿瘤复发（IBTR）标本行单细胞空间转录组学分析，构建约600,000个细胞图谱。",{"_92":258},"2026-11-16T00:55:13.251Z",[188,214,215],"iqoxow3olfkbvxgzt0apqw2dc","中国农业大学刘蓉/任发政等发现运动诱导WDR41 K319乳酰化激活自噬改善脂肪肝","中国农业大学刘蓉、任发政与美国西北大学Congcong He合作发现，运动产生的乳酸促进WDR41在K319位点乳酰化，该修饰由LDHA催化、SIRT2去乳酰化，通过驱动ULK1复合物组装启动自噬。WDR41及其K319乳酰化对运动诱导的胰岛素敏感性和脂质代谢改善、对抗肝脏过度脂质积累至关重要，为MAFLD防治提供新机制见解。",{"_92":258},"2026-11-16T00:55:13.258Z",[188,272],"mjqvntfmsdujn6kj5ott8ub4j","陈靖/何川团队发现硫酸氧钒可作为衰老细胞清除剂，口服延长雄性小鼠寿命","芝加哥大学陈靖及何川团队在Nature Aging发表研究，报道矿物质膳食补充剂硫酸氧钒（VS）可作为衰老细胞清除剂，口服VS改善衰老表型和多种年龄相关疾病，并延长雄性小鼠寿命。机制上，VS在衰老细胞中灭活反应性半胱氨酸并促进二硫键形成，导致蛋白质错误折叠、聚集并最终细胞死亡；谷胱甘肽还原酶下调促进GSSG积累，赋予衰老细胞对VS的选择性易感性。",{"_92":258},"2026-11-16T00:55:13.264Z",[188,257],"fgnn66npwpsxazh8ren0s61m9","Nat Commun：白蛋白包裹钯催化剂利用癌细胞内一氧化碳原位合成抗癌药","日本理化学研究所（RIKEN）团队在Nat Commun发表概念验证研究，将白蛋白-钯环配合物递送入癌细胞，借助癌细胞内过量产生的一氧化碳原位合成具细胞毒性的菲啶酮类抗癌药。体外实验中，该配合物与肝癌、宫颈癌、乳腺癌或肺癌细胞系孵育48小时后，仅在癌细胞系中检测到目标产物，正常细胞系中未检测到，血液中亦未检出该药物。下一步将从小鼠模型推进。",{"_92":258},"2026-11-16T00:55:13.279Z",[188,214,257],"rabta62futqrn55vggnegpvpm","FDA 拒绝 Summit Therapeutics 与康方生物肺癌药物 ivonescimab 的上市申请","FDA 拒绝批准 Summit Therapeutics 与康方生物开发的肺癌药物 ivonescimab，理由是该药未能延长患者生存期。FDA 审评人员指出，尽管该药可延缓肺癌进展，但缺乏生存获益\"不支持支持批准的正面获益-风险特征\"。Summit 负责该药中国以外地区的开发。",{"_92":102},"2026-11-15T15:05:15.000Z","2026-11-16T00:55:13.509Z",[167,214,330,331],41,"FDA","康方生物","jb2iq02cqmnptb0jg7u2k5dmm","华北制药公告公司及下属子公司产品纳入国家医保目录","华北制药发布公告，说明公司及下属子公司产品纳入国家医保目录。公告未披露具体产品名称、适应症及纳入方式。",{"_92":339},"2026-11-16T00:55:13.893Z",[100,207,338,231],"华北制药","华北制药·公司公告","nd7yzwjuqsswknaef4gi5bt8d","复星医药公告控股子公司药品新纳入国家医保目录","复星医药发布提示性公告，称控股子公司药品获新纳入国家医保目录。公告未披露具体药品名称、适应症及纳入类别。",{"_92":347},"2026-11-16T00:55:13.951Z",[100,207,346],"复星医药","复星医药·公司公告","tt9tjjwwg93phhrtcf98iupnv","Nvidia CEO 黄仁勋因婚外情传闻辞职，其生命科学合作前景生变","Nvidia CEO 黄仁勋因至多三起婚外情报道突然辞职，董事会任命自2013年起担任执行副总裁兼CFO的 Colette Kress 为临时CEO。黄仁勋此前与 Insilico Medicine 等生物医药及实验室工具企业有AI合作，Insilico CEO Alex Zhavoronkov 称此事将对行业产生大规模后果。",{"_92":144},"2026-11-15T21:57:19.000Z","2026-11-16T00:55:16.751Z",[110,215,87,159,89,91,143,355,356],"GSK","诺和诺德","cy13d4uidahrp0yi7v3os5021","罗氏艾美赛珠单抗纳入 2026 年版国家医保目录，覆盖 A 型血友病规律替代治疗","国家医保局公布《国家基本医疗保险、生育保险和工伤保险药品目录（2026 年版）》，罗氏制药中国的艾美赛珠单抗注射液（舒友立乐）纳入医保，报销范围覆盖伴或不伴凝血因子 VIII 抑制物的 A 型血友病患者规律替代治疗。","艾美赛珠单抗进医保后，A 型血友病规律替代治疗首次覆盖成人，读者可据此判断皮下给药方案在院内的准入空间。",{"_92":369},"2026-11-14T11:08:01.000Z","2026-11-16T00:55:17.840Z",[100,207,366,367,368,231],71,"罕见病","血液","罗氏","药时代","ypm4stlmmnmggw6js6djwl3wz","翰森製藥｜自願公告 - 阿美替尼上市許可獲歐洲藥品管理局人用藥品委員會積極意見",{"_92":379},"2026-11-15T10:29:00.000Z","2026-11-16T00:55:18.029Z",[167,214,377,378],40,"EMA","翰森制药","翰森制药·港交所公告","etbb7t1ta2pb6a34m8aak48hh","翰森制药创新药纳入2026国家医保目录","翰森制药发布自愿公告，披露创新药纳入2026国家医保目录的业务进展。公告未披露具体药品名称、适应症及谈判结果细节。",{"_92":379},"2026-11-15T10:25:00.000Z","2026-11-16T00:55:18.036Z",[100,207,378],36,"nq1ki3pelbm5ythtjw4jg64m7","ObesityWeek 2026：翰森制药公布每月一次皮下给药GLP-1/GIP/GCG受体激动剂HS-20136-2临床前研究结果","翰森制药在ObesityWeek 2026以最新突破摘要壁报形式公布每月一次皮下给药GLP-1R/GIPR/GCGR三重受体激动剂HS-20136-2的临床前研究结果。",{"_92":396},"2026-11-16T00:55:18.940Z",[159,272,395,378],15,"GLP-1","翰森制药·公司新闻","oa84kezbrab8fr5au7p69v1z8","ObesityWeek 2026 | 翰森制药奥莱泊肽减重Ⅲ期 LIGHTEN 研究性别亚组数据以 LBA 公布：男女均疗效显著，安全性特征一致","翰森制药在 ObesityWeek 2026 以最新突破性摘要壁报公布奥莱泊肽（HS-20094）中国减重Ⅲ期 LIGHTEN 研究性别亚组分析：604 例超重/肥胖成人每周皮下注射 5mg、10mg、15mg 或安慰剂 48 周，各剂量组体重、腰围、WHtR、FLI 改善均显著优于安慰剂（P<0.001），女性在体重降幅 ≥15%、≥20% 等达标比例上呈高于男性趋势。",{"_92":396},"2026-11-14T16:00:00.000Z","2026-11-16T00:55:18.947Z",[159,272,395,378],"all","tag","q","tab","time",{"_410":411,"_412":-5,"_413":230},"changelogVersion","2026-10-08T08:00","release","staticSite"]
