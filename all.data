_83":84,"_85":86,"_87":-5},{"_64":204,"_66":205,"_68":206,"_70":-5,"_71":207,"_73":117,"_75":208,"_77":78,"_79":209,"_81":210,"_83":190,"_85":86,"_87":-5,"_211":212},{"_64":193,"_66":194,"_68":195,"_70":196,"_71":197,"_73":198,"_75":199,"_77":78,"_79":200,"_81":201,"_83":190,"_85":86,"_87":-5},{"_64":180,"_66":181,"_68":182,"_70":183,"_71":184,"_73":185,"_75":186,"_77":187,"_79":188,"_81":189,"_83":190,"_85":86,"_87":-5},{"_64":175,"_66":176,"_68":167,"_70":-5,"_71":177,"_73":117,"_75":178,"_77":78,"_79":179,"_81":135,"_83":84,"_85":86,"_87":-5},{"_64":165,"_66":166,"_68":167,"_70":-5,"_71":168,"_73":117,"_75":169,"_77":78,"_79":170,"_81":100,"_83":84,"_85":86,"_87":-5},{"_64":155,"_66":156,"_68":157,"_70":-5,"_71":158,"_73":149,"_75":159,"_77":78,"_79":160,"_81":135,"_83":84,"_85":86,"_87":-5},{"_64":145,"_66":146,"_68":147,"_70":-5,"_71":148,"_73":149,"_75":150,"_77":78,"_79":151,"_81":152,"_83":84,"_85":86,"_87":-5},{"_64":128,"_66":129,"_68":130,"_70":-5,"_71":131,"_73":132,"_75":133,"_77":78,"_79":134,"_81":135,"_83":84,"_85":86,"_87":-5},{"_64":113,"_66":114,"_68":115,"_70":-5,"_71":116,"_73":117,"_75":118,"_77":119,"_79":120,"_81":121,"_83":84,"_85":86,"_87":-5},{"_64":103,"_66":104,"_68":105,"_70":-5,"_71":106,"_73":107,"_75":108,"_77":109,"_79":110,"_81":82,"_83":84,"_85":86,"_87":-5},{"_64":92,"_66":93,"_68":94,"_70":-5,"_71":95,"_73":96,"_75":97,"_77":98,"_79":99,"_81":100,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","cj1i5thmdsdp6ol29rtsrwuxj","title","Ribbon Bio 推出无细胞 DNA 组装技术 MiroMine，摆脱细菌宿主限制","summary","Ribbon Bio 推出 MiroMine 试剂盒，以无细胞组装技术替代细菌扩增来构建定制 DNA，早期版本可合成约 7 kb 的分子，仅需标准实验室硬件。公司自测显示，约 3.4 kb 和 6.8 kb 的分子测序 reads 100% 序列正确，约 4 kb 构建体为 88%，内毒素水平≤0.1 units/µg，未检出细菌基因组 DNA。","reason","source",{"_90":91},"publishedAt","2026-11-04T18:45:05.000Z","timelineAt","2026-11-05T05:13:23.190Z","category","industry","tags",[88,89],"score",8,"selected",false,"channel","news","x","公司动态","抗体/双抗","name","GEN Genetic Engineering & Biotechnology News","sobjvk44kguvrm2txnjb0916x","分析：标准化单采流程将助力细胞治疗行业","一项新分析指出，单采环节的操作差异会影响细胞治疗起始材料的质量，部分流程标准化将有利于细胞与基因治疗开发者。作者建议以ISBT 128等现有标准为起点，统一供者合格性数据要素、质量属性定义及产品标识与标签，并呼吁FDA明确研究用与商业化起始材料的区分及境外采集的监管预期。",{"_90":91},"2026-11-04T17:00:51.000Z","2026-11-05T05:13:23.196Z","opinion",[101,102],12,"观点/解读","细胞与基因治疗","wv1b2ibhzhnayvsy5peuy235h","瑞士团队开发微型生物阻抗传感器，实现小规模生物工艺活细胞密度实时监测","瑞士东部应用科技大学Yves Mermoud团队报告了一款概念验证型微型活细胞密度传感器，采用1 x 10 mm、25 µL工作体积的生物阻抗芯片，在CHO细胞测试中与参考细胞计数呈强相关（R² = 0.92），检测限约0.5 × 10⁶ cells mL⁻¹。",{"_90":91},"2026-11-04T17:00:35.000Z","2026-11-05T05:13:23.204Z","research",[111,112],"论文/研究","医疗器械/IVD","u4cf1ebyl684vq27vxdtrmbos","上海医药曲前列尼尔二乙醇胺吸入粉雾剂获NMPA临床试验批准","上海医药下属上药睿尔的曲前列尼尔二乙醇胺吸入粉雾剂获国家药监局《药物临床试验批准通知书》，同意开展临床试验。该药为2.2类改良型创新药，活性成分为人工合成前列环素类衍生物，拟用于治疗肺动脉高压（PAH，WHO第1组），通过舒张肺和全身动脉血管床并抑制血小板聚集发挥作用。截至公告日该项目累计研发投入约2,141万元人民币，尚未在全球任何国家或地区获批上市。",{"_90":127},"2026-11-04T16:00:00.000Z","2026-11-05T05:13:24.119Z","clinical",[122,123,124,125,126],15,"临床进展","呼吸","小分子","上海医药","NMPA","上海医药·公司公告","vmb66v182kxu0xlaa0nhkvsx8","每周医药看点（10月26日—11月1日）：CDE就新生抗原药品技术考虑征求意见，贝达药业与晟斯生物合作超长效生长激素月制剂SS202","CDE就《新生抗原药品关键问题的技术考虑（征求意见稿）》公开征求意见，针对新生抗原预测、筛选与验证及软件/算法性能评估等药学研究提出一般性技术要求。贝达药业与晟斯生物就超长效重组生长激素月制剂SS202达成合作，贝达药业将主导该产品全球研发、生产及商业化，并支付首付款、里程碑付款及销售分成。和黄医药索乐匹尼布获FDA孤儿药资格认定，拟用于治疗原发免疫性血小板减少症。",{"_90":144},"2026-11-05T00:00:00.000Z","2026-11-05T05:13:24.522Z",[136,137,138,139,140,141,142,143,126],22,"行业趋势","政策/监管","研发管线","交易/授权","医保/集采","恒瑞医药","华润医药","九州通","中国食品药品网·要闻","couxpa4sf0h6fk6309h221hu2","九州通与昭衍新药、昭衍生物、生仝智能签署战略合作，打造CRO+CDMO+CSO一体化药物价值服务新模式","2026年10月29日，九州通与昭衍新药、昭衍生物、生仝智能签署《战略合作协议》，在药物研发、药物销售、早期项目投资、AI医疗及生物医药产业生态园区五大方向开展合作，打通\"研发—临床—注册—商业化\"闭环。九州通将借此优先锁定创新药、高端仿制药等优质品种的销售及代理权。合作各方将共同打造CRO+CDMO+CSO一体化药物价值服务新模式。",{"_90":154},"2026-11-04T00:00:00.000Z","2026-11-05T05:13:26.472Z",[139,88,153,143],40,"CXO","米内网·企业","htt6ep85kypx9gpjarys5hqqg","514家A股药企2026三季报：超120家亏损，恒瑞、云南白药创新高，35家扭亏","A股514家医药企业披露2026年三季报，超3成营收与净利润双涨，但仍有超过120家亏损，百利天恒亏损超7亿元居首。药明康德净利润194亿元领跑，恒瑞医药首次突破60亿元，诺诚健华、荣昌生物等5家首次三季报盈利，35家扭亏。34家营收超100亿元，上海医药、九州通领军，药明康德、国药股份首次突破400亿元。",{"_90":154},"2026-11-05T05:13:26.479Z",[88,161,141,125,143,162,163,164],"市场/销售","药明康德","联影医疗","华东医药","exudj6u1k09cbrt39yfljt1wb","海正药业｜浙江海正药业股份有限公司关于公司董事离任的公告","",{"_90":174},"2026-11-05T05:13:27.105Z",[88,171,172,173],"海正药业","抗感染","企业竞争","海正药业·公司公告","hvvwt8ru0kq8o5mw9yt3zux8f","海正药业｜浙江海正药业股份有限公司关于持股5%以上股东协议转让股份过户完成的公告",{"_90":174},"2026-11-05T05:13:27.112Z",[88,171,172,173],"oe38y0k8hxh7ja9rqykh82srz","广东联盟取消西安利君康乐氯化钠注射液中选资格","广东省药品交易中心公告，因陕西省药监部门检查发现西安利君康乐制药有限责任公司药品生产质量管理不符合要求并已暂停其氯化钠注射液（250ml:2.25g、500ml:4.5g，直立式聚丙烯输液袋）生产、销售，依据《广东联盟双氯芬酸等药品接续采购文件（GDYJYPDL202501）》取消该产品在广东联盟双氯芬酸等药品接续采购的中选资格。","陕西药监因生产质量管理问题暂停该产品生产销售，广东联盟据此取消其中选资格，可看集采中选资格的风险处置链条。",{"_90":192},"2026-11-03T16:00:00.000Z","2026-11-05T05:13:29.209Z","policy",[137,191,140],47,true,"安全/质量","广东省药品交易中心·通知公告","mrqa4l5bvc0nkkbc3ssjse6gr","中国生物制药与勃林格殷格翰达成战略合作，潜在总金额70亿美元","中国生物制药发布自愿公告，宣布与勃林格殷格翰达成战略合作，潜在总金额70亿美元。公告未披露合作的具体管线、首付款与里程碑结构。","公告披露了中国生物制药与勃林格殷格翰合作的潜在总金额，读者可据此判断这笔交易的体量级别。",{"_90":203},"2026-11-04T08:34:00.000Z","2026-11-05T05:13:30.039Z",[139,202,136],62,"中国生物制药","中国生物制药·港交所公告","cl7w715vbckizmfnwin7n7ajv","中国生物制药与勃林格殷格翰达成70亿美元许可协议，覆盖六个临床前ADC与TcE项目","11月4日，中国生物制药与勃林格殷格翰达成选择权与许可协议，覆盖六个临床前项目，围绕ADC和T细胞衔接器（TcE）两条技术路线开发下一代癌症疗法，潜在总额最高70亿美元。",{"_90":215},"2026-11-05T05:15:38.307Z",[139,213,214,202],68,"sameEvent",{"_64":193,"_66":194},"肿瘤","ADC","医药云端工作室","ouy5p1a5uxasbgxb6vlv22fto","梁宗安教授谈呼吸治疗师如何规范化开展胸部物理治疗","梁宗安教授围绕呼吸治疗师规范化实施胸部物理治疗（CPT）提出临床要点，明确CPT以物理手段改善呼吸功能、促进气道分泌物清除为核心目标。文章梳理体位引流、胸壁叩拍、胸壁震颤、主动呼吸循环技术（ACBT）、自体引流、正压呼气装置、高频胸壁振荡及指导性咳嗽与哈气等主流技术的原理、方法与关键点，并强调呼吸治疗师与胸部物理治疗师在执业体系上的差异。",{"_90":223},"2026-11-05T04:12:36.000Z","2026-11-05T05:15:39.731Z",[101,123],"呼吸界","qdqf8dh19136xkmclel908cen","国家卫健委发布《罕见病目录制订工作程序（2026年版）》","11月4日，国家卫健委联合国家中医药局发布《罕见病目录制订工作程序（2026年版）》（国卫办医政发〔2026〕16号），替代2018版旧程序。新版新增“具备较高预防筛查、科研价值”的纳入情形，申报主体扩大至国家级行业学会或协会、民政部注册登记的相关社会组织、国家医学中心和国家临床医学研究中心等，并取消原则上不少于2年的固定更新周期，同时建立病种退出机制。","新版程序放宽申报主体并新增科研价值纳入情形，药企可据此判断罕见病病种申报的路径与证据准备。",{"_90":215},"2026-11-05T05:15:40.712Z",[137,232],58,"罕见病","qdcqhuf78fozzdtevbqw326ut","破谣 | 吸入药早上吸比晚上吸效果好？单支扩剂宜晚上吸，双支扩剂与三联药物时间不限","吸入药并非早上吸效果更好：以噻托溴铵为代表的单支扩剂最初建议晚上吸，使药效峰值与夜间迷走神经张力升高、气道易痉挛的时段对齐。双支扩剂（如茚达特罗格隆溴铵）和三联药物（如氟替美维）药效覆盖24小时，一天中任何时间吸均可，关键是固定时间每天坚持。",{"_90":223},"2026-11-05T05:15:42.552Z",[101,123],"ucq247nraf34rd1grsxyk3l1a","诺和诺德前三季度中国区收入约23亿美元，GLP-1下降18%","诺和诺德2026年前三季度全球净销售额2545.06亿丹麦克朗（约395.45亿美元），按固定汇率同比增长13%；中国区收入147.78亿丹麦克朗（约22.96亿美元），同比下滑2%，第三季度单季再降5%。","财报拆出中国区胰岛素与GLP-1的分化，并解释替尔泊肽进医保后的价格竞争如何改变格局。",{"_90":215},"2026-11-04T09:40:00.000Z","2026-11-05T05:15:43.700Z",[88,161,248,249,250,251],67,"GLP-1","代谢/减重","诺和诺德","礼来","tamzx3ntzdlbpbenk9h8njb5i","PCCM科室规范化建设3.0版：睡眠呼吸障碍、肺结核专病照护能力提升项目正式启动","PCCM科室规范化建设——睡眠呼吸障碍、肺结核专病照护能力提升项目启动会分别召开，两个专病项目正式进入实施阶段。睡眠呼吸障碍项目将围绕规范化评估、睡眠呼吸监测、气道正压通气治疗、合并症处置与长期随访管理开展建设，推动“筛查-诊断-治疗-全周期照护”标准化模式下沉各级医疗机构。",{"_90":223},"2026-11-04T11:41:12.000Z","2026-11-05T05:15:45.485Z",[137,123],"j0dk3m0550gk6zzv8tgazfxa6","第十二批国采落地：北京11月28日执行，黑龙江、海南11月30日执行","11月3日北京、黑龙江、海南、吉林相继发布第十二批国采落地通知，北京明确11月28日0时全面执行中选结果、采购周期至2029年12月31日，黑龙江与海南均于11月30日执行。","各省第十二批国采执行时点与价格切换节奏拉开梯度，中选企业可据此安排备货配送与院内准入衔接。",{"_90":215},"2026-11-04T06:49:31.000Z","2026-11-05T05:15:46.187Z",[137,140,126,172,267],"市场准入","ie9di3hieo7u3qswrgobddm8t","感染前30天内抗菌药物使用史与腹部侵入性操作是CRKP感染独立危险因素——青岛市市立医院CRKP分子流行病学特征研究","青岛市市立医院2016年11月至2023年10月分离的528株肺炎克雷伯菌中，80例CRKP感染患者的多因素logistic回归显示，感染前30天内抗菌药物使用史（OR=4.411，95%CI：1.749~11.128）和腹部侵入性操作（OR=6.846，95%CI：3.141~14.922）是CRKP感染的独立危险因素。",{"_90":223},"2026-11-05T05:15:48.501Z",[111,274,275,172,276,277],"抗菌药物","耐药与院感","循证指南","对市场","bishq0amt3d2me1pxgru72hw5","南方医院遴选处方流转合作药店，广东双通道单独支付征求意见同步推进","南方医科大学南方医院发布处方流转合作药店遴选公告，仅限广州医保双通道定点药店常态化申报，合作期限最长三年，分配送药店和回流药店两类，回流药店需具备30分钟送药回医院指定区域的能力。","文章把医院遴选细则与省级单独支付征求意见稿并置，梳理出处方流转在价格、责任与药店承接意愿上的现实堵点。",{"_90":215},"2026-11-04T03:40:02.000Z","2026-11-05T05:15:49.069Z",[137,140,136,101,286],"国家医保局","c7aj5ap61a47jkv4be8ksw3i3","华西医院罗凤鸣、金洪团队引领ILD全程管理新范式：AI早筛、MDT与专病管理师重塑慢病诊疗闭环","四川大学华西医院依托2025年升级的\"全程与共病管理中心\"，将临床指南、MDT、AI与专病管理师制度融合，构建覆盖筛查—诊断—治疗—随访—康复—共病管理的ILD全程管理闭环。",{"_90":223},"2026-11-05T05:15:51.251Z",[101,123,232],"zmj9yu1apgn2s0vzv0yhexfx1","六大上市连锁药店三季报拆解：大参林、益丰、老百姓等盈利与门店效率、会员策略对比","2026年前三季度六大上市连锁药店营收分化，大参林以213.08亿元领跑，益丰182.36亿元、老百姓166.50亿元紧随；利润端普遍反转，一心堂营收微降2.33%但归母净利润大增41.86%，健之佳因约2.24亿元租赁视同销售补税及滞纳金亏损2.59亿元。门店策略转向存量提效，老百姓直营日均坪效49元/㎡、会员1.16亿，一心堂净减333家店、租赁负债降31.31%。",{"_90":215},"2026-11-03T23:26:52.000Z","2026-11-05T05:15:52.115Z",[101,161,136],"j8c9v6qm3rsapc6ac3cz2fdrk","湖北民康制药吴妍：药企院内院外、线上线下一体化布局策略","湖北民康制药营销中心总经理吴妍在第48届中国医药产业发展大会上提出，药企线上渠道应分核心层、增长层、护城河三层协同布局，而非各平台平均用力。她将医药电商归为货架电商、即时零售、内容电商、私域生态、专业平台五类，主张院内打基础、院外做增量，以患者旅程串联认知至复购六环节。蓝亭叙2026-第15届医药健康互联网大会将于11月28-29日在杭州举办，德开医药、好药师、迈迪森将现场洽谈电商包销与采购。",{"_90":307},"2026-11-05T03:22:30.000Z","2026-11-05T05:15:56.202Z",[101,161,136],"赛柏蓝","e570usrvll6h25p13jj3k7l6j","2026流感宣传月丨曾玫教授：儿童流感起病急、进展快，低龄儿童如何做到早诊早治与规范用药","复旦大学附属儿科医院曾玫教授指出，儿童流感起病急、进展快，低龄儿童易发展为重症且症状不典型，治疗须把握发病48小时内的\"黄金48小时\"尽早启动抗病毒治疗。",{"_90":316},"2026-11-04T10:49:55.000Z","2026-11-05T05:15:57.592Z",[101,315],"感染/疫苗","SIFIC 感染视界","tazdg6od3vcbtbi7coz3rffq2","人社部数据：2026年第一季度医药代表平均招聘薪酬0.98万元/月","人社部市场招聘薪酬数据显示，2026年第一季度医药代表岗位平均招聘薪酬为0.98万元/月，该数据反映招聘市场薪酬报价，不等于在职医药代表实际平均收入。从业者对薪资感受不一，有肿瘤产品推广代表认为压力大但薪水较一般行业可观，也有代表称压力大、收入不如从前。",{"_90":307},"2026-11-05T00:54:40.000Z","2026-11-05T05:15:58.734Z",[136,161],"e9gnid2v9rgat4byurt0synv7","开包只取部分物品 无菌原则不打折","无菌包开包后仅取用部分物品时，无菌原则仍不可打折。图示中的几个关键操作要点一个都不能省，基础操作最容易大意，守住无菌底线需从每一次开包做起。",{"_90":316},"2026-11-04T08:11:14.000Z","2026-11-05T05:16:00.219Z",[331],"其他","c4w6q4m85z6l1u00nvboke9v7","养生堂药业复方马其通胶囊厂家直招：独家通用名中成药，4周中医证候总有效率72.3%","养生堂药业对独家中成药复方马其通胶囊（国药准字Z20040068）开展厂家直招，该品为非医保、非基药的自费定位品种，再注册有效期至2030年7月26日。产品仅含水蛭、土鳖虫两味，主打抗凝、抗栓与改善血液流变性，4周中医证候总有效率72.3%、心绞痛总改善率61.3%，可覆盖心内、老年、中医等六大科室。招商对接通过「小蓝推荐官AI」小程序进行，平台入驻与上架免费、不抽佣金。",{"_90":307},"2026-11-04T23:00:00.000Z","2026-11-05T05:16:01.274Z",[161,339,340],"中药","心血管","stvtomfnlbdjs6sczdfl08rwr","取无菌溶液法规范操作图解","取无菌溶液的操作瞬间是污染隐患的高发环节，规范操作需重视细节。该图解针对“倒一瓶无菌溶液”这一常见动作，梳理取无菌溶液法的规范操作要点，强调细节决定无菌成败。",{"_90":316},"2026-11-04T04:50:07.000Z","2026-11-05T05:16:02.684Z",[331],"cjp4ix665m8xsjqnwzoxedtab","医药代表薪资水平公布：2026年一季度平均招聘薪酬0.98万元/月","人社部市场招聘薪酬数据显示，2026年第一季度医药代表岗位平均招聘薪酬为0.98万元/月，该数据反映招聘报价而非在职代表实际收入。上海部分企业医药代表岗位标注月薪1.5万-3.5万元，天津部分岗位为5000元-2万元。A股515家医药企业中，百济神州2025年人均薪酬95.65万元，居化学制剂领域首位。",{"_90":307},"2026-11-04T10:45:03.000Z","2026-11-05T05:16:03.636Z",[161,136,355,356,357,358],"百济神州","君实生物","智飞生物","齐鲁制药","lkzlmmf8zqgfdbkl8wwpbzf4i","两款进口集采中选药因断供被取消资格，来曲唑片申报企业禁入4年","国家组织药品联合采购办公室公告取消两款国家集采中选药品的中选资格：Eugia Pharma的来曲唑片（第1—8批接续采购中选，申报企业杭州科图供应链）自接续采购执行以来未进行配送供应。","两起断供处置的禁入期限不同，读者可据此看清集采履约处罚如何按违约情形分档。",{"_90":307},"2026-11-05T05:16:06.723Z",[137,140,126,172,267],"yhbzdap7m00p2v6ya7dj3ffwe","A股医疗器械上市公司2026年前三季度营收TOP100出炉，迈瑞医疗居首","2026年前三季度A股142家医疗器械上市公司中102家营收增长，迈瑞医疗以超270亿元营收、71.84亿元归母净利润稳居营收和净利润榜首。营收前十还包括英科医疗、联影医疗、新华医疗、鱼跃医疗等，十强总营收846.55亿元。第三季度医疗器械板块收入同比增长9.82%，归母净利润同比增长15.79%，医疗设备、医用耗材、体外诊断三大板块均实现增长。",{"_90":307},"2026-11-05T05:16:08.787Z",[88,112,161,136,372,163],"迈瑞医疗","j1791wtoo27k8ny0hl03ypxda","步长制药赵菁出席2026“一带一路”媒体合作论坛，谈中医药国际化与健康丝绸之路","步长制药副董事长赵菁出席11月3日在福州举办的2026“一带一路”媒体合作论坛，并作主旨报告分享中医药国际化实践。目前步长制药已有43个品种进入39个国家和地区，脑心通胶囊、稳心颗粒在印尼、马来西亚、新加坡完成注册销售，宣肺败毒颗粒在乌兹别克斯坦、哈萨克斯坦、蒙古国等注册上市。赵菁提出聚焦标准互认、布局绿色供应链、深化人才共育三点合作倡议。",{"_90":307},"2026-11-05T05:16:11.339Z",[88,339,136],"opx9a0dtxhyz10rkcb5joi60e","东阳光集团采购百余个腾讯WorkBuddy账号，医药营销AI技能包实战班11月广州开班","东阳光集团已采购百余个腾讯WorkBuddy企业版账号，覆盖信息、法规、市场多个部门，将药品审评报告结构化提取、竞品资料比对等约40小时人工工作压缩至约2小时。赛柏蓝将于11月26-27日在广州举办医药营销全场景AI技能包搭建与人机协同实战班，基于腾讯WorkBuddy，两天内搭建拜访复盘、竞品监测、数据核对等技能包。",{"_90":307},"2026-11-05T05:16:14.117Z",[88,136],10,"mvphp0nw301gtjki0jn869g1c","华中科技大学殷涛/杨明团队：抑制NCLX联合Ca²⁺递送增强IRE对PDAC的疗效与抗肿瘤免疫","华中科技大学殷涛、杨明团队在Advanced Science发表研究，构建电穿孔同步瘤内递送Ca²⁺并负载CGP37157的纳米颗粒（mPEG–PCL@CGP37157）抑制线粒体NCLX的方案。",{"_90":392},"2026-11-05T08:14:19.763Z",[111,213,124],"生物谷","olu8s2jmvqvpopa95rsc38chq","北京大学袁林团队在 Nat Chem Biol 揭示 ADP-核糖经 ENT2 诱导神经元铁死亡","北京大学袁林团队在 Nature Chemical Biology 发表研究，鉴定 NAD+ 分解产物 ADP-核糖通过结合并抑制核苷转运蛋白 ENT2（SLC29A2）诱导神经元铁死亡。",{"_90":392},"2026-11-05T08:14:19.772Z",[111,399,124],"神经/精神","x7ak3c1k7n2nblcdflz5zdyo3","GUT：程向东/徐志远/白凡合作揭示胃癌定向肝转移机制，鉴定C/EBPβ为关键调控因子及ADM–CALCRL、C3–C3AR1潜在干预靶点","浙江省肿瘤医院程向东、徐志远与北京大学白凡团队在GUT发表研究，构建迄今最大的胃癌多部位转移单细胞图谱，鉴定转录因子C/EBPβ为促进肝转移的关键调控因子。机制上，C/EBPβ促进肿瘤细胞分泌ADM，经CALCRL破坏内皮连接促进内渗；同时诱导C3表达，激活巨噬细胞C3AR1形成免疫抑制状态，支持外渗时免疫逃逸。",{"_90":392},"2026-11-05T08:14:19.781Z",[111,213,124],"lqd1qk09x6nw80s7iudiddhs9","清华大学王凤超等发现KAT5-H2A.Z乙酰化失稳致滋养层染色体不稳定，关联复发性流产","清华大学王凤超等人在 Science Advances 发表研究，证明KAT5通过乙酰化H2A.Z转录激活Aurka、Aurkb和Cenpa等有丝分裂基因，维持滋养层细胞染色体稳定性。小鼠滋养层特异性敲除Kat5或引入乙酰化缺陷突变体可诱导严重染色体不稳定性（CIN）并致胚胎致死，该作用在人滋养层干细胞中保守。复发性流产患者胎盘绒毛中KAT5与乙酰化H2A.Z表达降低。",{"_90":392},"2026-11-05T08:14:19.789Z",[111,232],"febbflseghxdanb9yqoxwzzi9","Blood：浙江大学胡永仙/黄河等揭示CD7 CAR-T后EBV阳性LPD的空间机制","浙江大学胡永仙、黄河等合作在Blood发表研究，通过单核RNA测序、ATAC测序和Stereo-seq多组学空间分析，揭示CD7 CAR-T治疗后EBV阳性淋巴增殖性疾病（PCLD）的分子机制。",{"_90":392},"2026-11-05T08:14:19.798Z",[111,418,102,213],"血液","prrkdfv8p31882v0ag7sfxggv","Alethio完成9000万美元A轮融资，推进ATX-011靶向G6b治疗罕见血液肿瘤","英国生物技术公司Alethio Therapeutics完成9000万美元A轮融资，用于推进罕见骨髓增殖性肿瘤（包括原发性骨髓纤维化、原发性血小板增多症和真性红细胞增多症）的治疗药物开发。",{"_90":427},"2026-11-05T08:00:00.000Z","2026-11-05T08:14:20.231Z",[426,418,232,89,138],"投融资","BioPharma Dive","myck3lcrykihphx3tmpyb2mxj","广东省药品交易中心公布广东联盟药品集中带量采购新增中选产品信息（十）","广东省药品交易中心公布广东联盟药品集中带量采购新增中选产品信息（十），依据《广东联盟双氯芬酸等药品接续采购文件（GDYJYPDL202501）》，经企业申请、审核、公示等程序确定。新增中选产品当年度协议采购量默认为0。",{"_90":192},"2026-11-05T13:32:29.450Z",[137,140,172,267],"all","tag","q","tab","time",{"_440":441,"_442":-5,"_443":190},"changelogVersion","2026-10-08T08:00","release","staticSite"]
