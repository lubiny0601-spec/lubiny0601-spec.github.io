"_77":105,"_79":202,"_81":117,"_83":108,"_85":86,"_87":-5},{"_64":182,"_66":183,"_68":184,"_70":-5,"_71":185,"_73":186,"_75":187,"_77":105,"_79":188,"_81":189,"_83":108,"_85":86,"_87":-5},{"_64":175,"_66":176,"_68":177,"_70":-5,"_71":178,"_73":179,"_75":180,"_77":78,"_79":181,"_81":167,"_83":108,"_85":86,"_87":-5},{"_64":168,"_66":169,"_68":170,"_70":-5,"_71":171,"_73":172,"_75":173,"_77":78,"_79":174,"_81":127,"_83":108,"_85":86,"_87":-5},{"_64":160,"_66":161,"_68":162,"_70":-5,"_71":163,"_73":164,"_75":165,"_77":78,"_79":166,"_81":167,"_83":108,"_85":86,"_87":-5},{"_64":152,"_66":153,"_68":154,"_70":-5,"_71":155,"_73":156,"_75":157,"_77":78,"_79":158,"_81":107,"_83":108,"_85":86,"_87":-5},{"_64":140,"_66":141,"_68":142,"_70":-5,"_71":143,"_73":144,"_75":145,"_77":78,"_79":146,"_81":107,"_83":108,"_85":86,"_87":-5},{"_64":134,"_66":135,"_68":136,"_70":-5,"_71":137,"_73":131,"_75":138,"_77":78,"_79":139,"_81":107,"_83":108,"_85":86,"_87":-5},{"_64":129,"_66":111,"_68":112,"_70":-5,"_71":130,"_73":131,"_75":132,"_77":105,"_79":133,"_81":117,"_83":108,"_85":86,"_87":-5},{"_64":121,"_66":122,"_68":123,"_70":-5,"_71":124,"_73":114,"_75":125,"_77":78,"_79":126,"_81":127,"_83":108,"_85":86,"_87":-5},{"_64":110,"_66":111,"_68":112,"_70":-5,"_71":113,"_73":114,"_75":115,"_77":78,"_79":116,"_81":117,"_83":108,"_85":86,"_87":-5},{"_64":100,"_66":101,"_68":102,"_70":-5,"_71":103,"_73":74,"_75":104,"_77":105,"_79":106,"_81":107,"_83":108,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5,"_88":89},"id","bvej3mb5w7ufkt1vjucoe6wwf","title","安徽牵头7个单抗品种省际联盟集采1号通告发布，300亿市场启动报量","summary","安徽牵头的单抗类生物药省际联盟集采1号通告发布，纳入阿达木单抗、贝伐珠单抗、地舒单抗、利妥昔单抗、曲妥珠单抗、托珠单抗、英夫利西单抗7个品种共15个品规，国内公立医疗机构终端市场规模超过300亿元。","reason","source",{"_98":99},"publishedAt","2026-11-22T07:25:37.000Z","timelineAt","2026-11-23T04:30:35.199Z","category","opinion","tags",[92,93,94,95,96,97],"score",65,"selected",true,"channel","news","x","sameEvent",{"_64":90,"_66":91},"tmh96p809fciwwf70g9429e3c","全国单抗类药品联盟集采启动信息申报，7个品种15个规格纳入","观点/解读","政策/监管","医保/集采","抗体/双抗","抗感染","市场准入","name","医药云端工作室","yfus4hv4a4ba6dmnl86laa73v","合规背景下的医院准入实战训练营（广州12.12）","12月12日广州将举办《合规背景下的医院准入实战训练营》，面向药企KA、市场准入、政务、商务及大区&省区经理，为期1天。课程围绕客户链接与合规准入两条主线，拆解医院决策链条、DRG/DIP成本逻辑，并复盘4个脱敏真实准入案例，配套医院画像台账、跟进SOP、药事会答辩预案等工具包及现场沙盘推演。",{"_98":99},"2026-11-23T04:30:37.133Z","industry",[109,94],8,false,"其他","n8s471u4uvlid1aeuqif8s6un","王大燕、彭质斌做客「解密不一样的流感」第十季：解读2026流感流行趋势与三价替代四价疫苗策略","《呼吸界》「解密不一样的流感」系列直播第十季第一期于11月23日19:30开播，中国疾控中心国家流感中心王大燕主任解读2026流感流行趋势，传染病管理处呼吸道传染病室彭质斌主任讲解三价替代四价后2026中国流感疫苗的“变”与“不变”。",{"_98":120},"2026-11-22T11:11:19.000Z","2026-11-23T04:30:37.838Z",[92,118,119],22,"感染/疫苗","行业趋势","呼吸界","yzm5ovw50mpgaafapnkx18vly","慢阻肺病患者感冒为何可能进ICU？专家解析急性加重风险与用药禁忌","南京江宁医院杨健医生指出，慢阻肺病患者感染是急性加重最常见诱因，占50%～60%，以呼吸道病毒居多，一次中度加重即可导致肺功能断崖式下降，COPD 2026最新指南已将“一年发生1次中度加重”划入高风险组。",{"_98":120},"2026-11-23T04:30:41.046Z",[92,128],12,"呼吸","x5slhardlbvaupv4qyd5ze7ok",{"_98":120},"2026-11-21T11:17:13.000Z","2026-11-23T04:30:44.297Z",[119,118],"f88j5mfumyweqbk5blj48bv9o","慢阻肺病最隐匿却危害最大的症状：活动后气促为何最会“骗人”","慢阻肺病典型症状中，活动后气促最隐匿却危害最大，常被归因于年纪大或缺乏锻炼而延误就诊。该症状早期仅表现为爬楼、快走时气短，休息可缓解，待走平路也喘、夜间躺不平就诊时肺功能多已降至中重度。气促引发的行为回避会进一步缩小活动范围，并与肺过度充气共同加重心脏和肺微循环负担。",{"_98":120},"2026-11-23T04:30:47.050Z",[92,128],"tizi6uclxjspdosrg7ck44zjg","骨髓移植患者保护性隔离转运要点","骨髓移植患者免疫力极度低下，转运全程需守护无菌防线，任何疏漏都可能带来感染风险。保护性隔离强调细节管理，是骨髓移植患者转运过程中的关键环节。",{"_98":151},"2026-11-23T00:03:33.000Z","2026-11-23T04:31:00.549Z",[92,147,148,96,149,150],"血液","耐药与院感","循证指南","对品牌","SIFIC 感染视界","bwc0r3rta6bpb7jiylo965ksl","药企如何借AI抢抖音营销红利？12月成都实战工作坊","针对药企使用AI工具多停留在浅层次试用、难出业务结果的问题，12月12-13日在成都举办抖音医药内容合规投放转化与AI技能人机协作实战工作坊。工作坊带企业用现成AI工具包结合自家产品现场实操，当堂产出短视频脚本、种草图文与千川投放文案初稿，并给出修改优化方向。",{"_98":159},"2026-11-23T03:22:45.000Z","2026-11-23T04:31:03.082Z",[92],"赛柏蓝","oii57co93og2khi0rba07yk0a","2026流感宣传月：从流感规范化诊疗到全院感控的临床实践要点","2026年流感季异常提前，第46周全国检出以甲流为主，A(H1N1)pdm09占比56.2%，H1N1阳性样本中13/17份存在G155E突变。抗病毒治疗应在发病48小时内启动，奥司他韦每日2次连用5天，玛巴洛沙韦全程单次口服。研究显示患者服用玛巴洛沙韦后家庭内传播风险从19.35%降至9.57%。",{"_98":151},"2026-11-22T11:41:53.000Z","2026-11-23T04:31:03.796Z",[92,118],38,"za8qh1dpltey6ra8dytksq3x2","监管穿透式追责下，药企高管合规侥幸心理风险凸显","在监管全链条穿透核查、资金流水与合作台账均可追溯的态势下，部分药企高管仍心存侥幸，误以为靠CSO包装或纸面整改即可过关。一旦被认定主观故意，企业受罚之外决策高管将首当其冲，虚假整改罪责更重。靠带金销售赚快钱的时代已结束，主动排查风险、搭建真正落地的合规体系才是正道。",{"_98":159},"2026-11-23T03:05:00.000Z","2026-11-23T04:31:05.813Z",[92,93],"m1ofl3us19z0cdc0nvo8mcjbq","2026流感宣传月：儿童流感的早期识别、规范诊疗与科学防控","2026年流感季异常提前，夏季已出现明显流感活动，H1N1占比回升并伴G155E突变，第46周全国流感阳性样本中A(H1N1)pdm09占56.2%。儿童流感发病率分别为15～59岁人群的3.1倍、60岁及以上人群的6.6倍，专家共识建议确诊或疑似患儿起病48h内启动抗病毒治疗，重症高风险患儿采取“边检边治”或“抢先治疗”。玛巴洛沙韦干混悬剂适用于1~12岁儿童，可按体重精准给药，全程1次用药。",{"_98":151},"2026-11-21T11:08:03.000Z","2026-11-23T04:31:06.590Z",[92,118],"w6tse8kommfyoysdznz66jgcx","2026年三季报：医药商业陷入大洗牌，国资、民营与连锁药店加速转型","2026年A股医药商业公司三季报显示行业形势严峻，部分企业增速放缓、增收不增利甚至扭亏为亏。国资背景企业以并购整合转型，如浙江震元增资扩股引入华润医药商业取得震元医药51%股权；民营九州通则通过九州通资本布局创新药与医疗器械。头部连锁药店业绩同比明显改善，转向提高单店坪效与客户留存。",{"_98":159},"2026-11-22T11:08:04.000Z","2026-11-23T04:31:08.980Z",[190,119,191,192,193,194,195,196],42,"公司动态","市场/销售","医疗器械/IVD","国药控股","上海医药","九州通","华润医药","uh5n4168ewohj2dc8t18n7h99","2款中成药出事、25家涉商业贿赂案企业被点名、64个品种集采结果出炉，恒瑞入选福布斯中国创新力企业50强","2026版国家医保目录新增107个药品，成功率86%，含51个1类创新药；12个药品进入商保创新药品目录。云南省第二批省内药品集中带量联动采购拟中选64个品种，以注射剂为主，齐鲁、石四药、南京正大天晴、丽珠医药等有多个品种拟中选。四川省点名25家涉医药商业贿赂案配送企业，需7日内完成涉案生产企业及产品指认，逾期暂停采购平台交易账号。",{"_98":159},"2026-11-23T04:31:12.457Z",[119,93,94,203,204,205,206,96,97,207,208],"恒瑞医药","信达生物","科伦药业","翰森制药","国家医保局","NMPA","i7eodihujrslwrmkvb913du6e","医疗器械销售代表能赚多少钱？普通销售年收入中位值19.3万元，高级销售30.9万元","薪智《2026年医疗器械行业白皮书》显示，截至2026年7月，一线城市医疗器械销售专员年总现金收入50分位值为19.3万元，高级销售专员达30.9万元，两者相差11.6万元。技术岗位薪酬溢价明显，器械研发管理岗平均发布年薪34.8万元，算法工程师33.1万元。医学联络专员与质量保证专员年总现金收入中位值分别为25.8万元和27.3万元，均高于普通销售专员。",{"_98":159},"2026-11-23T04:32:21.771Z",[92,192,191,215,216],"迈瑞医疗","联影医疗","v6x3gfyoapbtvn3frg16lprfr","第15届医药健康互联网大会·蓝亭叙2026将在杭州举办，聚焦医药电商全域增长","第15届医药健康互联网大会·蓝亭叙2026将于11月28-30日在杭州举办，围绕医药电商品效销全域增长展开。京东健康、哈药、好药师B2C的实战操盘手将分享流量获取、私域运营、医生IP打造及抖音小红书爆单打法，并拆解从公域种草到私域变现、B2C与O2O联动及AI提效的全链路。",{"_98":159},"2026-11-23T04:32:24.127Z",[119,191,223],"哈药股份","pq7kdae3qowz09bl52lbmjsx1","全国药品联盟单抗类集采发布第1号公告，7个品种15个品规启动信息申报","11月21日，全国药品联盟集中带量采购（单克隆抗体类）发布第1号公告，7个单抗品种、15个品规进入信息申报，申报窗口为11月24日至27日。公告要求申报人具备2年以上单抗注射剂生产经验、提交不少于24个月的上市放行记录并出具知识产权承诺书。文章认为单抗集采比拼的是产能、合规与稳定供应，代理商需在接集采中选品种吃确定量、或接非集采差异化品种吃溢价之间重新选择。","单抗首次成批进入联盟集采，申报门槛与代理商选品逻辑的变化是这条线最值得关注的部分。",{"_98":159},"2026-11-23T04:32:26.787Z","policy",[93,94,95,119,96,97],"obuutnk0r74er9wx05fb9wpjb","药企财务要赶紧用WorkBuddy：赛柏蓝11月26-27日广州办医药财税AI实战研修班","赛柏蓝定于11月26-27日在广州举办医药财税AI实战研修班，主题为建模型、查风险、建体系。WorkBuddy面向药企财务场景，可处理发票查重、多源数据合并与利润归因，缩短月结周期。",{"_98":159},"2026-11-23T04:32:29.461Z",[109],"11月21日，安徽省医药集中采购平台发布《全国药品联盟集中带量采购（单克隆抗体类）公告（第1号）》，本轮集采涉及阿达木单抗、贝伐珠单抗、地舒单抗、利妥昔单抗、曲妥珠单抗、托珠单抗和英夫利西单抗7个品种、15个规格，企业须在11月24日9时至11月27日18时完成信息申报。","全国单抗联盟集采首次明确7个品种与申报窗口，读者可据此判断自家品种是否在报量范围内。",{"_98":159},"2026-11-21T11:29:31.000Z","2026-11-23T04:32:32.264Z",[93,94,95,208,96,97],78,"puodbvjkx6rrir1onhyg3i01b","32家医药企业董事长离职；药明生物原副总裁王卓智出任水木分子CEO；第十二批国采25地确定执行时间","截至11月21日，今年已有32家医药企业披露33起董事长离任消息，科伦药业创始人刘革新辞任董事长、由其子刘思川接任。药明生物原副总裁王卓智出任水木分子CEO，负责AI驱动创新生物药管线研发及全球商务拓展。第十二批国采中选结果已有25地确定执行时间，江西、湖北、青海已执行。",{"_98":159},"2026-11-23T04:32:35.273Z",[190,94,207,205,252,253,254,96,255],30,"药明康德","华东医药","赛诺菲","企业竞争","n0fpppqbc8m97gk8b19bf27cp","Isomorphic Labs完成50亿美元C轮融资，刷新AI制药单笔融资纪录","Isomorphic Labs于11月17日宣布完成50亿美元（约合人民币333亿元）C轮融资，由Greenoaks和红杉资本联合领投，Alphabet继续加注，刷新全球AI制药行业单笔融资纪录。公司成立五年尚无药物获批上市，也未公开宣布自研管线进入人体临床试验，累计融资已达77亿美元。其核心引擎IsoDDE可整合蛋白质结构预测与小分子相互作用，辅助候选药物设计与筛选。",{"_98":159},"2026-11-23T04:32:38.600Z",[262,119,190],"投融资","sduacnwihthz06zi1nwvhrq9o","金税四期上线，医药老板财税管控与商业重构研修班12月北京开班","金税四期上线后资金流、发票流、业务流一比对，药企过往不合规操作将无所遁形，实控人个人身家可能被历史遗留财税隐患牵连。12月3-4日在北京举办的医药老板财税管控与商业重构研修班，旨在提醒仍粗放经营的医药老板拆掉历史遗留的雷。",{"_98":159},"2026-11-23T04:32:41.059Z",[190,109],"xtqebncrroxqdb52brt7zerub","西南医科大学王荣浩等发现m6A依赖的ARv7翻译将乳酸代谢与恩杂鲁胺耐药偶联","西南医科大学王荣浩等发现，恩杂鲁胺治疗可增加ARv7 mRNA在A1177位点的METTL3依赖性m6A甲基化，经阅读蛋白YTHDC2识别后增强ARv7翻译效率，从而驱动前列腺癌恩杂鲁胺耐药。",{"_98":280},"2026-11-23T00:00:00.000Z","2026-11-23T07:25:14.867Z","research",[277,278,279],"论文/研究","肿瘤","小分子","生物谷","vp0vr02ehl9bvzqr7k7iv10zi","上海交通大学李慧/周斌兵团队揭示嘌呤代谢物积累经TUFM-RHEB轴抑制mTORC1","上海交通大学李慧和周斌兵团队在 Cell Death & Differentiation 发表研究，以PRPS1功能获得性突变为嘌呤积累模型，发现升高的嘌呤尤其是脱氧鸟苷（dG）抑制mTORC1信号。机制上，dG促进RHEB在Ser130位点磷酸化，触发TUFM与鸟嘌呤核苷酸从RHEB解离，使RHEB失活。抑制XDH/XO时也观察到类似的mTORC1抑制和TUFM结合丢失。",{"_98":280},"2026-11-23T07:25:14.879Z",[277,278,279],"tg12fmnfco52uk3hhyd1loi3m","《Nature》研究揭示铁死亡癌细胞经p38-PGE2通路抑制cDC1介导免疫逃逸","德国图宾根大学Jan P. Böttcher团队在《Nature》发表研究，揭示铁死亡癌细胞通过细胞外Ca²⁺内流激活p38 MAPK、异常合成PGE2，削弱cDC1抗原呈递并抑制CD8⁺ T细胞启动，导致肿瘤免疫逃逸。",{"_98":280},"2026-11-23T07:25:14.907Z",[277,278,279],"opr7j8yfxbp4xfyl6b15utwp0","Nature Methods：BCR-MERFISH 技术实现浆细胞克隆性原位成像，看清抗体工厂的邻里关系","波士顿儿童医院等机构研究人员在 Nature Methods 发表 BCR-MERFISH 技术，在 MERFISH 基础上改造，可依据 B 细胞受体基因特征区分浆细胞类群并同时测量周围细胞基因活动。",{"_98":280},"2026-11-23T07:25:14.931Z",[277,147,299],"AI 制药","onp0bhygo0mfn0zfeov73clqw","国家药监局推进真实世界数据应用试点转入规范发展新阶段","国家药监局副局长雷平在海南参加第八次真实世界数据应用试点领导小组会议，部署推动真实世界试点从探索阶段转入规范发展、常态应用新阶段。会议提出完善制度规则、对标国际共识打造技术指南体系，并探索建设全国药械真实世界数据平台，支持不良反应（事件）监测等工作。雷平同时出席第五届博鳌国际药械真实世界研究大会。",{"_98":306},"2026-11-23T07:25:15.980Z",[93,208],"中国食品药品网·要闻","pz5drvoitu22by2u85ods5knz","口腔种植体系统全国联盟接续采购启动需求量填报，四川牵头、上海通知医疗机构报量","四川省医保局牵头组织全国各省组成联盟开展口腔种植体系统接续采购，医疗机构须于2026年11月23日9:00至12月4日17:00在四川省口腔种植体系统报量平台填报历史采购量（2025年11月1日—2026年10月31日）和采购需求量。",{"_98":313},"2026-11-23T08:25:31.551Z",[93,94,192,207],"上海阳光医药采购网","z6acn2zcnnj2ekwwx2psgq8hi","为何领先药企正用自有数据微调开源模型","艾伯维、BMS、强生等5家全球Top20药企在一项联邦式计划中，用逾2万条自有蛋白-小分子结构数据微调OpenFold3，所得模型在测试中优于所有公开模型。OpenFold3由OpenFold联盟于2026年3月发布更新权重、代码及训练数据，多数任务表现与AlphaFold3相近。开源模型可让申办方在自有环境内微调并保留权重，但需自行承担算力、编排、安全与模型验证工作。",{"_98":327},"2026-11-23T10:00:00.000Z","2026-11-23T11:48:44.155Z",[92,119,322,323,324,325,326],10,"辉瑞","礼来","艾伯维","BMS","强生","BioPharma Dive","p428j27hrac2cvf9arikiix4c","Caronilex 开发下一代多发性骨髓瘤 CAR-T 疗法 TriPRIL，早期试验 15 例中 12 例缓解","新生物技术公司 Caronilex 正在开发下一代 CAR-T 疗法 TriPRIL，用于多发性骨髓瘤。上周发表于 The Lancet 的小型早期试验显示，TriPRIL 使 15 例复发或难治性多发性骨髓瘤患者中的 12 例肿瘤体征减少或消除，其中多数患者此前接受过 CAR-T 治疗。该疗法安全性数据积极，可能成为自身免疫疾病的候选疗法。",{"_98":338},"2026-11-23T09:30:00.000Z","2026-11-23T11:48:44.182Z","clinical",[336,278,337,147],"临床进展","细胞与基因治疗","STAT","dgqrfmxhd911avh71pew347y3","观点：若 AI 泡沫破裂，医疗 AI 公司倒闭将给医疗体系带来严重问题","PATHORA 病理与组织医学研究所首席科学官 David Adler 撰文指出，若 AI 泡沫破裂导致医疗 AI 公司失去融资、缩减或停止支持产品，医院可能无法完成对相关工具的评估。",{"_98":338},"2026-11-23T11:48:44.190Z",[92,119],"p91nspexyc0mxzhku9gyzv0z4","Genmab 三款抗癌药关键试验接连告捷，下一步聚焦获批与自主商业化","Genmab 上月有三款药物在三种不同癌症的关键试验中取得成功，被分析师称为“帽子戏法”。公司下一步需推进这些药物的获批与上市，其中两款产品将由 Genmab 自主商业化，以证明其不依赖大型药企合作的能力。CEO Jan van de Winkel 表示“一切归结于执行”。",{"_98":338},"2026-11-23T11:48:44.201Z",[190,278,95],20,"pg5iwvk1vrpiwu5y1r2ehee17","观点：中国研究机构通过FOIA获取我的科研工作，我不得不交出","美国西北大学Francesca E. Duncan通过FOIA收到通知，一家中国实体仅支付25美元即申请获取其由NIH资助的科研基金申请书，依法她必须交出。NIH十余年间通过FOIA收到超过13,300份基金申请书请求。她呼吁国会将专有美国科学成果豁免或排除于FOIA之外。",{"_98":338},"2026-11-23T11:48:44.209Z",[92],15,"rrk2z52z9p1uxn7qjoz8yk7tc","ADA 内乱持续，对糖尿病患者意味着什么？","美国糖尿病协会（ADA）因政治抗议风波分裂五个月后，专家担忧这场僵局可能阻碍糖尿病诊疗进展。纷争源于五名成员在 2026 年新奥尔良科学会议上被驱逐，随后引发高层辞职、1,221 名成员抵制，以及未公开姓名的临时编辑委员会接管《Diabetes Care》期刊。ADA 表示 2027 版指南将于 12 月按期发布，但下届科学会议议程尚未确定。",{"_98":338},"2026-11-23T11:48:44.215Z",[119,109],"xvh34j2hghg2w0s306ql5v6om","NMPA 批准和记黄埔医药醋酸索乐匹尼布片上市，用于 ITP 与 wAIHA","国家药监局通过优先审评审批程序批准和记黄埔医药（上海）有限公司申报的 1 类创新药醋酸索乐匹尼布片（商品名赛威珂）上市。该药适用于对既往至少一种治疗反应不佳的慢性原发免疫性血小板减少症（ITP）成人患者，以及既往至少对糖皮质激素治疗反应不佳的温抗体型自身免疫性溶血性贫血（wAIHA）成人患者。","原文交代了获批的两个适应症与优先审评通道，读者可据此判断该药进入的血液罕见病治疗场景。",{"_98":306},"2026-11-23T11:48:45.303Z","approval",[374,375,147,208],62,"获批上市","罕见病","ld5s7kkcss0t4hpom2u4xo09r","中山大学关新元等发现肝癌\"返老还童\"开关：组蛋白伴侣ASF1B经H3.3-SOX9轴驱动祖细胞样细胞状态","中山大学关新元、张翼鷟、严倩团队在Advanced Science发表研究，鉴定出癌胎组蛋白分子伴侣ASF1B在肝细胞癌中重新激活，其高表达与肿瘤低分化及不良生存预后相关。",{"_98":280},"2026-11-23T11:48:45.369Z",[277,278,279],"co1vil49n9g9whxcb2qf7v7wo","杰毅生物mNGS呼吸道病原微生物检测试剂盒获国内自动化建库试剂品类首证","杰毅生物自主研发的mNGS呼吸道病原微生物检测试剂盒（可逆末端终止测序法）于2026年11月20日获国家三类医疗器械注册证（国械注准20263402360），为国内病原mNGS自动化建库试剂品类首张注册证。该方案以\"试剂+自动化设备+软件\"全流程闭环，将建库由手工7至8小时压缩至90分钟，生信分析由约2小时缩短至不到10分钟完成一张芯片审核，推动病原NGS院内本地化开展。",{"_98":280},"2026-11-23T11:48:45.384Z",[374,192,208],"f5fzmr4r3zi8cljcm3guhauxx","Cell Metab：上海交通大学占贞贞/夏强等揭示既往肝损伤通过固有免疫记忆加重心肌梗死","上海交通大学占贞贞、夏强与海军军医大学刘星光合作在 Cell Metabolism 发表研究，揭示既往肝损伤会引发固有免疫系统长期重编程，使造血干细胞分化偏向髓系命运，加重心肌梗死（MI）期间的炎症损伤。",{"_98":280},"2026-11-23T11:48:45.391Z",[277,394,395],"心血管","自免","pw98ds6kw4uk40n6sk2j6s0kg","Cell Reports：南京医科大学江宏兵团队发现Piezo1内感受环路将咬合力传入下丘脑调控颅面骨稳态","南京医科大学江宏兵团队在Cell Reports发表研究，揭示一条牙周Piezo1依赖的脑-骨内感受环路：Gli1谱系牙周间充质基质细胞上的Piezo1感知咬合力，经YAP/Gli1复合物促进COX-2表达与PGE2生成，激活三叉神经感觉通路并维持腹内侧下丘脑（VMH）活性、减弱室旁核（PVN）相关交感传出。",{"_98":280},"2026-11-23T11:48:45.398Z",[277,402],"神经/精神","vxcpk675loj8ni5cq36j1fcmp","上海药事所发布2026年第四季度集采中选药品续签通知，12月20日执行","上海市医药集中招标采购事务管理所发布通知，对采购协议期满并完成约定采购量的部分集采中选药品，与中选企业及其指定配送企业续签购销三方协议，通知于2026年12月20日执行。具体续签品种见附件《2026年第四季度集采中选药品续签信息表》，医疗机构在带量采购中选药品采购中发现问题需及时向市药事所反馈。","上海药事所对四季度到期的集采中选药品启动三方协议续签，涉及品种与执行时间以附件信息表为准。",{"_98":313},"2026-11-23T12:26:30.207Z",[93,94,96,97],"u2gdvowt6n9yfb29t6012vctj","上海暂停桂林南药盐酸莫西沙星片采购资格","上海市医药集中招标采购事务管理所通知，桂林南药股份有限公司持有并生产的盐酸莫西沙星片为1-8批国家集采协议期满接续采购中选药品，因经辽宁省药品检验检测院检验溶出度不符合规定，自2026年11月24日0时起暂停该药品在上海市招采子系统的采购资格。此次暂停依据国家药监局2026年11月12日发布的《关于27批次不符合规定药品的通告》（2026年第39号），涉及0.4g规格3片/盒与6片/盒两种包装。","国家集采中选药品因溶出度不合格被暂停采购资格，读者可据此了解中选药品质量问题的处理路径。",{"_98":313},"2026-11-23T12:26:30.217Z",[93,418,419,96,97,420,421],72,"抗菌药物","安全/质量","对销售","对准入","all","tag","q","tab","time",{"_428":429,"_430":-5,"_431":84},"changelogVersion","2026-10-08T08:00","release","staticSite"]
