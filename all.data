3,"_83":84,"_85":86,"_87":-5},{"_64":204,"_66":205,"_68":206,"_70":-5,"_71":207,"_73":208,"_75":209,"_77":78,"_79":210,"_81":211,"_83":84,"_85":86,"_87":-5},{"_64":190,"_66":191,"_68":192,"_70":-5,"_71":193,"_73":194,"_75":195,"_77":148,"_79":196,"_81":197,"_83":84,"_85":86,"_87":-5},{"_64":181,"_66":182,"_68":183,"_70":184,"_71":185,"_73":161,"_75":186,"_77":121,"_79":187,"_81":188,"_83":189,"_85":86,"_87":-5},{"_64":172,"_66":173,"_68":174,"_70":-5,"_71":175,"_73":176,"_75":177,"_77":148,"_79":178,"_81":179,"_83":84,"_85":86,"_87":-5},{"_64":157,"_66":158,"_68":159,"_70":-5,"_71":160,"_73":161,"_75":162,"_77":148,"_79":163,"_81":101,"_83":84,"_85":86,"_87":-5},{"_64":142,"_66":143,"_68":144,"_70":-5,"_71":145,"_73":146,"_75":147,"_77":148,"_79":149,"_81":150,"_83":84,"_85":86,"_87":-5},{"_64":134,"_66":135,"_68":136,"_70":-5,"_71":137,"_73":138,"_75":139,"_77":78,"_79":140,"_81":101,"_83":84,"_85":86,"_87":-5},{"_64":125,"_66":126,"_68":127,"_70":-5,"_71":128,"_73":129,"_75":130,"_77":78,"_79":131,"_81":132,"_83":84,"_85":86,"_87":-5},{"_64":115,"_66":116,"_68":117,"_70":-5,"_71":118,"_73":119,"_75":120,"_77":121,"_79":122,"_81":101,"_83":84,"_85":86,"_87":-5},{"_64":106,"_66":107,"_68":108,"_70":-5,"_71":109,"_73":110,"_75":111,"_77":78,"_79":112,"_81":113,"_83":84,"_85":86,"_87":-5},{"_64":93,"_66":94,"_68":95,"_70":-5,"_71":96,"_73":97,"_75":98,"_77":99,"_79":100,"_81":101,"_83":84,"_85":86,"_87":-5},{"_64":65,"_66":67,"_68":69,"_70":-5,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5},"id","z5ntl1g73tmtotdlutl52drzl","title","北卡罗来纳60县随机对照试验：社区与急救系统强化培训未改善院外心脏骤停生存率","summary","北卡罗来纳60个县、约850万居民的随机对照试验显示，针对911调度员、急救人员和社区居民的多层面心脏骤停培训未能提高院外心脏骤停患者的生存率及良好神经功能结局。研究五年间共22,459名成年居民发生院外心脏骤停，干预县11,615人与对照县10,844人的生存情况无差异。探索性分析显示第四年旁观者实施CPR的比例有所上升，研究者认为需更长时间评估。","reason","source",{"_91":92},"publishedAt","2026-11-08T22:15:00.000Z","timelineAt","2026-11-09T06:26:05.069Z","category","clinical","tags",[88,89,90],"score",8,"selected",false,"channel","news","x","临床进展","心血管","论文/研究","name","STAT","m5lc3xveu4yjejqeh01mhvktr","从诺华pelacarsen与诺和诺德IL-6靶向药心脏试验失败看AI hype为何该被质疑","美国心脏协会年会上公布的两项研究显示，诺华pelacarsen虽降低血中Lp(a)水平，却对心脏病发作和卒中发生率无影响；诺和诺德靶向IL-6的抗炎药大型研究同样未显示获益。这两次失败表明，被寄望加速新药问世的遗传学与新技术一再落空，对AI等新技术的疗效宣称应保持怀疑。",{"_91":92},"2026-11-08T09:30:00.000Z","2026-11-09T06:26:05.078Z","opinion",[102,89,103,104,105],22,"观点/解读","诺华","诺和诺德","行业趋势","wlgr9pi4ry2d84bprqqa9elpj","AHA 科学年会三项研究：卒中后与 2 型糖尿病患者降压的挑战与分歧结果","AHA 科学年会公布的三项降压研究结果不一：REDUCE 试验显示卒中后早期加用螺内酯（spironolactone）使患者 3 个月后血压更易降至 130/80 mm Hg 以下。",{"_91":92},"2026-11-07T21:39:02.000Z","2026-11-09T06:26:05.085Z",[88,89,114],17,"代谢/减重","z9e9cehp1psac0sgeqyex8tab","BIO 联合加州两家生物技术行业组织起诉 CMS，寻求叫停 GLOBE 药品定价试点","BIO 与两家加州生物技术行业组织于周五向美国加州北区联邦地区法院提起诉讼，寻求叫停 CMS 的 GLOBE 试点，主张该示范项目超越 Medicare 法定权限。GLOBE 旨在将 Medicare 药品价格与同类国家价格对齐，业界预计其实际影响有限，但希望阻止其形成先例。CMS 未立即回应置评请求。",{"_91":92},"2026-11-07T16:57:13.000Z","2026-11-09T06:26:05.094Z","policy",[123,124,105],"政策/监管","医保/集采","tpx5qodmeehzsfp83282yd34g","诺华 pelacarsen III 期 HORIZON 试验未降低心血管事件，Lp(a) 策略受质疑","诺华 pelacarsen 在 III 期 HORIZON 试验中虽大幅降低 Lp(a)，但近 5 年随访显示心梗、卒中、紧急冠脉血运重建或死亡与安慰剂无差异。该结果于美国心脏协会科学年会公布并同步发表于《新英格兰医学杂志》，令针对这一影响 1/5 人群的遗传性心血管风险因素的研发策略面临质疑。",{"_91":92},"2026-11-07T14:50:00.000Z","2026-11-09T06:26:05.103Z",[88,89,103,133],30,"核酸药物","xg9fp4f133r51ukquyzvr98hb","尽管诺和诺德 ziltivekimab 的 ZEUS 研究未达终点，心脏病专家仍将推进抗炎药物研发","诺和诺德 ziltivekimab（靶向 IL-6 的单克隆抗体）在 ZEUS 研究中虽降低炎症细胞因子 IL-6 水平，但未减少重症患者的心脏病发作、卒中或死亡，未达主要终点。基于此，诺和诺德已叫停 HERMES 和 ATHENA 两项试验。ZEUS 详细结果在 AHA 科学年会公布并同步发表于 NEJM，心脏病专家表示仍将继续探索抗炎药物。",{"_91":92},"2026-11-07T14:35:00.000Z","2026-11-09T06:26:05.110Z",[88,89,141,104],"抗体/双抗","uomgdmzom0sppmr9kjom7wugs","赛诺菲终止STAT6降解剂SAR448272（NX-3911）I期开发，Nurix股价单日暴跌38%","赛诺菲终止了与Nurix合作开发的口服STAT6降解剂SAR448272（NX-3911）的I期开发，该药此前在欧洲开展首次人体试验并已触发赛诺菲向Nurix支付1000万美元里程碑款。",{"_91":156},"2026-11-09T01:26:46.000Z","2026-11-09T06:26:06.901Z","industry",[151,152,153,154,155],20,"公司动态","自免","小分子","赛诺菲","罗氏","GEN Genetic Engineering & Biotechnology News","ib36t6n6wbf2qny1sle4v03ad","每周医药看点（11月2日—8日）：罕见病目录制订程序2026年版印发，海创药业HP570达成独家授权","11月2日—8日，国家卫生健康委办公厅、国家中医药局综合司印发《罕见病目录制订工作程序（2026年版）》，明确目录病种纳入条件与调整程序。海创药业将口服VAV1分子胶降解剂HP570授权给Evommune，获3000万美元首付款及最高10.7亿美元里程碑付款；明慧医药将靶向IGF-1R的MHB018A日本权益授予ASKA，获1.1亿美元首付款及最高3.3亿美元里程碑付款。",{"_91":171},"2026-11-09T00:00:00.000Z","2026-11-09T06:26:07.580Z",[123,105,164,165,124,166,167,168,169,170],"罕见病","中药","GLP-1","ADC","AI 制药","NMPA","FDA","中国食品药品网·要闻","f272484705k792ovyoc3s7q5e","第九届进博会美妆龙头首发首展新品盘点：欧莱雅、资生堂、雅诗兰黛等集中亮相","第九届进博会上，欧莱雅、资生堂、雅诗兰黛、爱茉莉太平洋、高丝、宝洁、花王等美妆龙头集中展示首发首展新品。欧莱雅携27个品牌参展，带来5款全球首发和10余款中国首发新品，其中金致驭龄面霜与鲜注油膜已申请备案，油养微珠精华液已于今年9月完成备案。资生堂悦薇智感视黄醇抗皱紧颜精萃水今年7月完成备案，拟于12月上市。",{"_91":171},"2026-11-08T00:00:00.000Z","2026-11-09T06:26:07.592Z",[151,105,180],3,"其他","vdzri95dwgtd9jhsllv6ct7kd","CDE 发布《化学药生物等效性试验备案范围和程序》修订版及共性问题解答","药审中心发布修订后的《化学药生物等效性试验备案范围和程序》及共性问题解答（2026年第51号通告），自2027年2月1日起施行。此次修订旨在明确 BE 试验备案范围、完善备案工作程序，经国家药监局审查同意后发布，两份文件以附件形式随通告公布。","CDE 修订化学药 BE 试验备案范围与程序并配套共性问题解答，仿制药研发与注册人员可据此调整备案安排。",{"_91":171},"2026-11-09T06:26:07.610Z",[123,169],50,true,"wjm4uifgw355ewrhfjrjgclj3","翰森制药亮相2026进博会：7款创新药商业化，瑞康立伏妥塔单抗III期PFS风险降低67%","翰森制药在第九届进博会上展示抗肿瘤、代谢、自身免疫、中枢神经系统、抗感染五大领域创新进展，已实现7款创新药商业化，创新药与合作产品收入占比超85%。近三年与葛兰素史克、默沙东、罗氏、再生元等达成8项授权合作，累计首付款超10亿美元，总潜在交易价值超275亿美元。瑞康立伏妥塔单抗（B7-H3 ADC）在骨肉瘤取得近30年来首个阳性III期结果，疾病进展风险降低67%。",{"_91":203},"2026-11-07T16:00:00.000Z","2026-11-09T06:26:16.165Z",[151,105,198,114,164,167,166,199,200,201,155,202],18,"肿瘤","翰森制药","GSK","默沙东","再生元","翰森制药·公司新闻","oc05noe5ktw2vfh21yh666lub","中国生物制药TQ-A3334（TLR7激动剂）在2026 AASLD公布II期临床数据","中国生物制药在港交所自愿公告，TLR7激动剂TQ-A3334于2026 AASLD公布II期临床数据。公告未披露具体适应症、样本量及疗效终点数值。",{"_91":214},"2026-11-09T00:01:00.000Z","2026-11-09T06:26:18.312Z",[88,212,213],26,"感染/疫苗","中国生物制药","中国生物制药·港交所公告","r672g8uzh5ibhvd0vqyi678gl","11年“间质性肺炎”激素+免疫抑制剂治疗后病灶反增，TBLB与多学科会诊确诊双肺腺癌（KRAS G12D）","一例52岁男性“间质性肺炎”患者经甲泼尼龙联合吗替麦考酚酯治疗后双肺病灶反而增多，经多学科会诊行TBLB，双肺叶均病理诊断为肺腺癌，检出KRAS G12D变异、PD-L1 TPS<1%。患者有30包年吸烟史及长期油漆暴露史，2014年即发现间质性肺炎改变，提示对免疫抑制治疗反应差、影像进展的ILD患者需警惕“肺炎型”肺癌并及时肺活检。",{"_91":225},"2026-11-08T11:03:31.000Z","2026-11-09T06:30:50.171Z","research",[90,198,224],12,"呼吸","呼吸界","gd3mphdbgx3r4poc6o5rt2opp","九芝堂三季度单季利润增近6倍，陇神戎发单季亏损超千万","九芝堂前三季净赚3个多亿，三季度单季利润翻了近6倍；陇神戎发前三季营收下降近28%，三季度单季亏损1000多万，扣非净利润仅7万多。文章将分化归因于集采与医保控费压缩价格空间，临床价值证据不足的中药注射剂、辅助用药进院变难，并提到九芝堂以3.1亿收购吉象隆切入多肽赛道、陇神戎发九成收入依赖两个独家品种且销售费用削减三分之一。","两家同处中药板块的企业三季报分化，对照出集采控费下独家品种与循证、并购路径的差别。",{"_91":236},"2026-11-09T02:10:18.000Z","2026-11-09T06:30:50.608Z",[151,165,235,105],47,"市场/销售","医药云端工作室","y1mw0ht42upm1xbm5kysizsxk","GSK进博会展示靶向IL-5生物制剂美泊利珠单抗与德莫奇单抗，推动呼吸慢病长期管理","GSK在第九届进博会上展示多款靶向生物制剂，其中靶向IL-5的美泊利珠单抗已在华获批慢阻肺病、重度哮喘等5大相关适应症，同为IL-5靶点的德莫奇单抗仅需半年给药一次。GSK称德莫奇单抗为全球首个且目前唯一的\"超长效\"生物制剂，可帮助患者更长久地控制疾病。",{"_91":225},"2026-11-09T06:30:52.769Z",[151,224,141,200],"llm9us4bozf0dvjpsb7wll595","九芝堂与陇神戎发三季报冰火两重天：一家净利增588.01%，一家单季亏损1073.25万元","九芝堂前三季度营收21.86亿元、同比增长34.34%，归母净利润3.04亿元同比翻倍，三季度单季归母净利5337.56万元、同比暴增588.01%；陇神戎发前三季度营收4.55亿元、同比下滑27.95%，归母净利润297.49万元、同比跌86.69%，三季度单季亏损1073.25万元。",{"_91":236},"2026-11-09T01:08:21.000Z","2026-11-09T06:30:53.000Z",[102,165,235,105],42,"lvipbxtl2p3r6dqkusjnhwntf","破谣 | 立冬之后一定要多吃萝卜？生吃比熟吃效果好？","立冬后\"冬日萝卜赛人参\"的说法流传，中医认为萝卜味甘性寒、入肺胃经，可清热生津、下气宽中，对肺热所致的黄稠鼻涕、口干咽痛、痰黄黏稠等有帮助。萝卜籽\"莱菔子\"也是常用清热化痰、消食降气药。生吃辣味重、清热生津下气消食效果相对更好，炖煮后辣味消减、性质平和，更适合脾胃虚寒者；服用人参、党参等补气药时不宜同食，且萝卜不能替代药物。",{"_91":225},"2026-11-09T06:30:55.877Z",[102,165],"na85rwl6gzrkasnp4bunp64rl","王一民医生：病毒性肺炎该不该用抗生素？何时用、用哪一种？——多病例详解分层抉择与动态评估","王一民医生结合流行病学与共感染证据，梳理病毒性肺炎抗生素使用的分层抉择与动态评估。我国成人CAP中病毒感染占39.2%，混合感染在重症患者中比例更高、细菌与病毒混合约占30%；流感合并细菌感染增加死亡风险（OR=2.55，95%CI 1.88～3.44）、ICU入院风险（OR=1.87）及机械通气需求风险（OR=1.78）。",{"_91":225},"2026-11-07T12:20:37.000Z","2026-11-09T06:30:59.177Z",[102,264,265,266,267,268],"抗菌药物","耐药与院感","抗感染","循证指南","对品牌","n1gow9ocpk6bnjnhzzbww2nhu","慢阻肺病7年后出现蓝嘴唇、腿脚肿，迟春花教授解析肺动脉高压诊断","北京大学第一医院迟春花教授解析一例慢阻肺病确诊7年后新发蓝嘴唇、活动后气短的病例，右心导管实测平均肺动脉压力28毫米汞柱、肺血管阻力3.8 Wood单位，超过20毫米汞柱诊断界值，确诊肺动脉高压。长期缺氧刺激肺小动脉收缩并结构重塑，肺循环压力升高，右心负荷加重可致肺心病。疾病所致\"蓝嘴唇\"变色范围更广、持续不消退且随活动加重，常伴气短、胸闷、心悸。",{"_91":225},"2026-11-09T06:31:01.857Z",[102,224],"k8qu5is0ypvyv0aoys2msenus","如何正确将无菌包内物品全部取出，避免污染","开无菌包时手不可接触包布内无菌面，禁止跨越无菌区域。无菌包受潮、破损或超出有效期一律视为污染，严禁使用。",{"_91":283},"2026-11-09T00:19:26.000Z","2026-11-09T06:31:07.113Z",[102,265,266,267,282],"对销售","SIFIC 感染视界","omlb3r4eqkdvyz543skwhact4","《感染在线》启动“大感控·真实践”2026院内感控实践优秀案例征集","《感染在线》在2026流感宣传月期间启动“大感控·真实践”优秀案例征集，面向全国各级医疗机构征集流感感染防控实践，投稿截止2026年11月30日。征集方向包括医院感控体系构建、重点科室与高危人群保护、MDT与医防协同、信息化智能化感控及“早防早治”落地实践。入选案例将在《感染在线》平台专题展示。",{"_91":283},"2026-11-08T11:28:18.000Z","2026-11-09T06:31:09.721Z",[180,212],10,"nosbrexjd10vs32dscfq02bly","药企被判失信后必做的三件事：退钱、书面整改与人员机构处置","药企被判失信后需完成三件事：核算并退回不合理收益、按监管要求撰写整改报告与致歉声明、处置涉案人员与代理机构并留痕证据，才有资格谈惩戒减免。信用修复还需按时间倒排材料包与证据链，错过节点可能拉长惩戒期；修复完成后仍须核对挂网资格恢复范围与红线清单。",{"_91":300},"2026-11-09T03:37:00.000Z","2026-11-09T06:31:16.722Z",[102,123],15,"赛柏蓝","znpp5zpxs78708nfp68h2ul73","扬子江连发三道GEO招标：新锐®、香芍颗粒、蓝芩口服液为AI答案付费","扬子江药业三个月内连发三份GEO招标，涉及新锐®（左奥硝唑）、香芍颗粒与蓝芩口服液，要求投标方完成大模型知识库入驻、临床问答场景搭建与合规内容投放。蓝芩口服液项目周期6个月，30%尾款挂钩产品在主流大模型提及率或推荐率排名前二。2026年上半年国内GEO公开招标约23个、总金额突破6000万元。",{"_91":300},"2026-11-09T02:20:00.000Z","2026-11-09T06:31:19.250Z",[105,151,309,235],38,"扬子江药业","e7k78qhoqentb3hu5vjwkb30o","283家A股药企前三季度研发费用出炉：恒瑞、复星、百利天恒领跑","截至2026年11月8日，283家A股上市医药企业披露2026年前三季度研发费用合计543.04亿元，同比增长1.41%。恒瑞医药、复星医药、百利天恒分别以54.23亿元、31.18亿元、20.45亿元位列前三，百利天恒研发费用率达97.69%。化学制药是三类行业中唯一研发费用实现增长的板块，160家企业平均2.17亿元，同比增长2.84%。",{"_91":300},"2026-11-08T11:01:13.000Z","2026-11-09T06:31:22.171Z",[151,318,319,320,321,322,323,105],40,"恒瑞医药","复星医药","君实生物","石药集团","智飞生物","华润医药","b78kh7xzwkpoy7ozjturm9576","3家药企注销《药品经营许可证》；12起严重学术造假被查处；云南35个药最高降幅81%","甘肃省药监局11月3日公告依法注销甘肃裕康药业等3家企业《药品经营许可证》，原因均为有效期届满未申请重新审查发证。国家卫健委11月5日通报第六批涉\"论文工厂\"严重学术造假调查结果，共12起，主要责任人来自多家医院。同日云南省药品集中采购平台公示35个药品企业申请降价，最高降幅81%。",{"_91":300},"2026-11-09T06:31:25.456Z",[151,105,169,321,330,124,266,331],"海正药业","企业竞争","lah90pviwcbxvsmyinpykbdr8","招商蛇口挂牌转让招商力宝50%股权及5086.9863万元债权，退出太子湾医院运营","招商蛇口全资子公司深圳市招商创业在北京产权交易所挂牌，拟转让招商力宝医院管理（深圳）有限公司50%股权及5086.9863万元债权，底价5456.5863万元，等同出售太子湾医院50%股权。该项目须与乐活国际50%股权及1500万元债权打包受让，原股东力宝医疗保留优先购买权。截至2026年6月30日，招商力宝营业收入2171.73万元，净利润-5880.94万元，所有者权益-15115.52万元。",{"_91":300},"2026-11-09T06:31:28.766Z",[151,338],"医疗器械/IVD","w8jj3ve16fruym7rdrw966pgl","蓝亭叙2026第15届医药健康互联网大会11月28-29日杭州召开，聚焦药企电商与医生IP","蓝亭叙2026-第15届医药健康互联网大会将于11月28-29日在杭州举行，针对药企线上流量贵、ROI低、私域IP合规受限等营销痛点设置议程。大会邀请京东健康分享AI与O2O玩法，哈药、德开等年销过亿爆品操盘手现场交底，并设医生IP打造、医疗短剧带货专场及平台与私域IP辩论。",{"_91":300},"2026-11-09T06:31:31.122Z",[105,235,345],"哈药股份","u70duxchekr4h815o6foai4gy","药械企业失信惩戒穿透联动强化，赛柏蓝11月19-20日上海举办信用修复策略实战班","药械价格招采信用评价新规下修复口径显著收窄，企业一旦触发失信线索将面临挂网受限、集采禁入等经营风险。赛柏蓝定于11月19-20日在上海举办药械企业失信公示与信用修复策略实战班，覆盖失信认定、分级惩戒与全流程修复实操。课程针对收益核算、价格剔除、证据组织及主管部门沟通等自主修复难点设计整改方案与谈判策略。",{"_91":300},"2026-11-09T06:31:33.731Z",[151,123,124],"nfoi2srvarqrb8ldz6dd5u3vw","36家药企被点名；6个中成药被取消集采中选资格；九州通新公司来了","河南省公共资源交易中心近日点名36家医药企业，指其涉嫌违背公平合理、诚实信用、质价相符原则，涉及医药价格和招采信用评价预评级。上海取消6个中成药全国中成药联采中选资格，涉及5家药企，自2026年11月7日起执行。中国生物制药与勃林格殷格翰签下涵盖6个临床前ADC及TCE资产的许可协议，获3.58亿美元首付款及近期付款，潜在里程碑最高70亿美元。",{"_91":300},"2026-11-07T12:15:14.000Z","2026-11-09T06:32:39.166Z",[151,359,213,360,104,124,361,266,362],"投融资","九州通","交易/授权","市场准入","r45x6ai05lhz7as5qvhap5tfr","2026进博会：京东健康前三季度线上首发超100款新药，与辉瑞、默克、武田等20余家全球药企签约","2026年前三季度京东健康线上首发超过100款新药，已超2025年全年总和，覆盖代谢、皮肤、罕见病等领域。进博会期间京东健康集中与辉瑞、默克、武田、勃林格殷格翰、诺华、诺和诺德等超过20家全球医药健康品牌签约，合作从新药首发延伸至患者管理与AI创新。默克明确未来三年将京东健康作为新药上市发布首选渠道。",{"_91":300},"2026-11-09T06:32:42.088Z",[151,235,105,369,103,370,104,371],"辉瑞","武田","阿斯利康","uld0b976u4g1wxz6ecp6hc7n6","26家医药企业董事长离职：工作调整占四成，二代接班与国资调配成接棒主线","截至11月7日，今年已有26家医药企业发生27次董事长离任变动，其中工作调整或工作变动11条、占比40.74%，个人及身体原因6条、占22.22%，退休、董事会换届或任期届满各4条、分别占14.81%。接任者主要来自集团体系内调配与内部选任，天士力由原总经理蔡金勇接任董事长，天坛生物由梁红军接任；海森药业王雨潇、珍宝岛方福鑫则由年轻二代接棒。",{"_91":300},"2026-11-09T06:32:45.265Z",[151,105,318],"ekhtr90srbsvv0m6j86b1nsow","10月9个新药未被批准，沙库巴曲缬沙坦钠片3家企业未过评","10月共9个新药审评未获批准，另有5个新药补充申请未通过。未获批品种中沙库巴曲缬沙坦钠片涉及3家企业，数量最多；上海合全医药、印度西普拉、白云山东泰商丘药业各有2个品种未获批准。当月整体批准率为93.34%，1561个受理号完成审评审批。",{"_91":300},"2026-11-09T06:32:48.119Z","approval",[385,169,180,386],"获批上市","鲁抗医药","jyvmbh3fzm1vbtdron0fagijl","有药企营销高管，迷茫了","一位药企电商部门负责人向作者坦言，面对竞品在抖音、小红书的种草与私域复购，自己仍靠硬广、线上流量成本难以承受，对医药电商玩法感到迷茫。作者建议其参加赛柏蓝11月28-29日在杭州举办的蓝亭叙2026-第15届医药健康互联网大会，京东健康、哈药、好药师、德开医药及抖音、小红书、阿里健康操盘手将分享超级爆品策划、平台与私域IP选择、医生IP科普转化及医疗短剧带货路径。",{"_91":300},"2026-11-09T06:32:50.511Z",[102,235,345],"qh96udwhm94tshijqy5qjn333","集采后药企商务体系如何重构：赛柏蓝上海实战班11月19-20日开课","集采后医药企业商务板块正从后勤保障转向增长驱动，商务权责划分、渠道管控、库存止损与缺货断供应对成为普遍痛点。赛柏蓝定于11月19-20日在上海举办医药企业商务体系重构与销售增长实战班，提供四象限表、履约风险清单、返利设计模板、窜货取证流程、ROI测算表、KPI设计模板及体系重构路线图等落地工具。",{"_91":300},"2026-11-09T06:32:53.285Z",[151,124,266,362],"bocc708ws0d5id8d2e4how6i1","哈药股份｜哈药集团股份有限公司关于所属企业药品通过仿制药一致性评价的公告","",{"_91":406},"2026-11-10T16:00:00.000Z","2026-11-11T08:03:36.756Z",[385,180,345],"哈药股份·公司公告","etgb74ydv323z9y8wy0lsrw3w","恒瑞医药｜恒瑞医药关于获得药物临床试验批准通知书的公告",{"_91":415},"2026-11-09T16:00:00.000Z","2026-11-11T08:03:36.791Z",[88,318,414],21,"研发管线","恒瑞医药·公司公告","dg7awav6zgsmqd3yukzu23meq","国内首个！天士力中药1.1类新药枣仁宁心滴丸获批上市，开拓睡眠维持困难新市场","天士力中药1.1类新药枣仁宁心滴丸获批上市，是国内首个精准针对睡眠维持困难（时睡时醒）及伴有日间功能障碍的创新中药，处方源自国医大师张伯礼教授临床经验方。四项多中心、随机双盲、安慰剂对照临床试验显示，睡眠质量改善有效率最高89.2%，失眠严重程度改善有效率最高98.7%，日间功能改善有效率最高97.3%。产品采用滴丸固体分散技术，一日1次/1袋晚上服用，填补安神补脑中成药细分市场空白。",{"_91":424},"2026-11-10T00:00:00.000Z","2026-11-11T08:03:40.948Z",[385,165,423],"神经/精神","米内网·企业","xe4qxvzav9b2fsc1vfkiybo1d","上海市药事所11月19日举办“政府开放日”活动，分科室现场接待企业咨询","上海市医药集中招标采购事务管理所定于11月19日14:00—17:00在局门路622号举办“政府开放日”专项互动答疑活动，由联采科、药采科、耗材科、监督科分科室现场接待企业。企业代表当日13:30起在一楼服务大厅按业务对应科室取号排队，每家企业原则上安排1名业务人员到场。现场可即时答复的咨询即时回应，需核查、流转处置的诉求统一登记台账。",{"_91":432},"2026-11-11T00:00:00.000Z","2026-11-11T08:03:41.104Z",[123,124],"上海阳光医药采购网","rwnxfwlhpi92h2i7b7lkace12","上海启动第十二批国家集采未中选药品梯度降价填报，11月17日前未调价将暂停采购","上海阳光医药采购网开通第十二批国家集采未中选已挂网药品申报价填报通道，价格确认时间为2026年11月11日至11月17日。已挂网参比制剂和过评药品按系统参考治理价调整申报价，未过评药品按不高于本市有约定采购量中选药品最低价依差比价规则计算，中选产品非供应清单内的二同药品按其中选价格依差比价规则计算。","上海对第十二批国家集采未中选药品设梯度降价与暂停采购规则，涉及参比制剂、过评和未过评三类价格口径。",{"_91":432},"2026-11-11T08:03:41.113Z",[123,124,266,362],72,"eddzyi3ptowsbm9iysyq0ad5r","AASLD 2026 | 翰森制药恒沐®（艾米替诺福韦，TMF）6项研究成果亮相，长期疗效与安全性再获力证","翰森制药在AASLD 2026公布恒沐®（艾米替诺福韦，TMF）6项研究成果，覆盖长期治疗、低病毒血症、肝硬化、肝衰竭、代谢合并症及机制探索。PROMOTE研究144周数据显示，ALT正常慢性HBV感染者接受TMF治疗持续获益。此外，真实世界研究显示TMF治疗CHB合并MASLD不影响抗病毒疗效，合并肝衰竭患者可实现快速病毒学下降。",{"_91":203},"2026-11-11T08:03:55.014Z",[88,212,199],29,"all","tag","q","tab","time",{"_454":455,"_456":-5,"_457":189},"changelogVersion","2026-10-08T08:00","release","staticSite"]
