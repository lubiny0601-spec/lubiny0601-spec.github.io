[{"_1":2,"_3":4},"root",{"_5":199},"weekly-detail",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14},"report",{"_34":35,"_19":25,"_21":26,"_23":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":20,"_57":28},"index",[15,16,17,18],"today","2026-11-23","expiresAt",1795443818000,{"_19":31,"_21":32,"_23":33},{"_19":28,"_21":29,"_23":30},{"_19":25,"_21":26,"_23":27},{"_19":20,"_21":22,"_23":24},"key","2026-W44","issueNumber",1,"title","国家药监局批准拜耳阿舒克森片上市，用于降低缺血性卒中及高风险TIA患者卒中风险","2026-W45",2,"北京医保局发文执行第十二批国家集采中选结果，11月28日起全面落地","2026-W46",3,"四部门发文促进创新药配备使用，两目录内1类新药不计入一品两规","2026-W47",4,"国家医保局发布2026版医保药品目录与第二批商保创新药目录，新增107种药品","kind","weekly","MedHOT 周报 · 2026-W45","generatedAt","2026-11-09T06:22:16.416Z","lead",{"_23":27,"_198":44},"leadItemId","i02u4hpugvk7m0bazm8ocvs8v","overview","本周 17 件大事，最受关注的是：北京医保局发文执行第十二批国家集采中选结果，11月28日起全面落地；江苏医保局部署第十二批国家集采中选结果落地，11月30日起全省执行；第12批国家集采落地：5省明确执行时间，16省发文安排挂网与支付。","highlights",[195,196,197],"sections",[63,64],"flashes",[],"cover","metrics",{"_58":59,"_60":61,"_62":29},"readingMinutes",6,"prev","next","totalStories",17,"selectedCount",22,"reportsCovered",{"_65":148,"_67":-5,"_68":149},{"_65":66,"_67":-5,"_68":69},"label","政策与监管","summary","items",[70,71,72,73,74,75,76,77,78,79],{"_80":42,"_23":27,"_67":145,"_84":146,"_86":147,"_88":144,"_90":-5,"_94":95,"_96":95},{"_80":139,"_23":140,"_67":141,"_84":142,"_86":143,"_88":144,"_90":-5,"_94":95,"_96":95},{"_80":134,"_23":135,"_67":136,"_84":105,"_86":137,"_88":138,"_90":108,"_92":109,"_94":110,"_96":95},{"_80":129,"_23":130,"_67":131,"_84":114,"_86":132,"_88":133,"_90":117,"_92":118,"_94":110,"_96":95},{"_80":124,"_23":125,"_67":126,"_84":114,"_86":127,"_88":128,"_90":117,"_92":118,"_94":110,"_96":95},{"_80":119,"_23":120,"_67":121,"_84":114,"_86":122,"_88":123,"_90":117,"_92":118,"_94":110,"_96":95},{"_80":111,"_23":112,"_67":113,"_84":114,"_86":115,"_88":116,"_90":117,"_92":118,"_94":110,"_96":95},{"_80":102,"_23":103,"_67":104,"_84":105,"_86":106,"_88":107,"_90":108,"_92":109,"_94":110,"_96":95},{"_80":97,"_23":98,"_67":99,"_84":85,"_86":100,"_88":101,"_90":91,"_92":93,"_94":95,"_96":95},{"_80":81,"_23":82,"_67":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":95,"_96":95},"itemId","oe38y0k8hxh7ja9rqykh82srz","广东联盟取消西安利君康乐氯化钠注射液中选资格","广东省药品交易中心公告，因陕西省药监部门检查发现西安利君康乐制药有限责任公司药品生产质量管理不符合要求并已暂停其氯化钠注射液（250ml:2.25g、500ml:4.5g，直立式聚丙烯输液袋）生产、销售，依据《广东联盟双氯芬酸等药品接续采购文件（GDYJYPDL202501）》取消该产品在广东联盟双氯芬酸等药品接续采购的中选资格。","sourceName","广东省药品交易中心·通知公告","sourceUrl","https://www.gdmede.com.cn/announcement/announcement/detail?id=2117903816765476864","publishedAt","2026-11-03T16:00:00.000Z","sourceIconUrl","/api/img-proxy?u=https%3A%2F%2Fwww.gdmede.com.cn%2Ffavicon.ico&mode=avatar&exp=1795651200&sig=7b6790186a8c4652","sourceIconSrcSet","/api/img-proxy?u=https%3A%2F%2Fwww.gdmede.com.cn%2Ffavicon.ico&mode=avatar-48&exp=1795651200&sig=e585872dca2ffb01 48w, /api/img-proxy?u=https%3A%2F%2Fwww.gdmede.com.cn%2Ffavicon.ico&mode=avatar&exp=1795651200&sig=7b6790186a8c4652 96w","firstParty",true,"available","al1ui9exasqe5g5xocpkgl5om","广东联盟药品集采公示第十批新增中选产品，公示至11月4日","广东省药品交易中心公示广东联盟药品集中带量采购新增中选产品信息（十），南京力成药业等企业申请增补中选资格，公示期至2026年11月4日17:30。依据《广东联盟双氯芬酸等药品接续采购文件（GDYJYPDL202501）》，报名截止后首次获批的同品种同剂型产品，接受本企业最低价格/最低日均费用与中选产品最低单位可比价两者低值的，可按中选产品挂网，当年度协议采购量默认为0。","https://www.gdmede.com.cn/announcement/announcement/detail?id=2117188449717981184","2026-11-01T16:00:00.000Z","lkzlmmf8zqgfdbkl8wwpbzf4i","两款进口集采中选药因断供被取消资格，来曲唑片申报企业禁入4年","国家组织药品联合采购办公室公告取消两款国家集采中选药品的中选资格：Eugia Pharma的来曲唑片（第1—8批接续采购中选，申报企业杭州科图供应链）自接续采购执行以来未进行配送供应。","赛柏蓝","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669472&idx=2&sn=140f969345708404949ecf1c77273041&chksm=bc5d150067828c8fcef11ad97b6f4f4c494f44ea272c27a35f5de835be620e16fdb58931d2d0&scene=126&sessionid=1793855794#rd","2026-11-04T10:45:03.000Z","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=167030ae1e219003","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=b828ff70e947816f 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=167030ae1e219003 96w",false,"jzjgbk1bi97f2zsnlm16v7aix","河北公布10个原研药与1类新药挂网，须锚定全国最低价否则按失信处理","11月2日，河北省医用药品器械集中采购中心公布参比制剂（原研药）与创新药挂网通知，共10条产品，包括雌二醇透皮喷雾剂（298元）、黄体酮软胶囊（70.91元）。","医药云端工作室","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699472&idx=1&sn=0e300ab2a03afd447acf160ea2bcd2b2&chksm=bcdd698f1ae604d1b77db503080371beb0f87e8c7dcb0f66a802171e0a2d268c40ec74f27a87&scene=126&sessionid=1793719809#rd","2026-11-03T10:10:49.000Z","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=920757ef74ebe49f","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=9cb8174b387e7452 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=920757ef74ebe49f 96w","wdk21hh936uoy0a7hf88kg2zt","第12批国采江苏11月30日执行，16省已发文","江苏省医保局通知第12批国采将于11月30日24:00起全省统一执行，采购周期至2029年12月31日，11月8日前完成中选规格申报、11月20-24日网签合同、11月26日切换中选价格。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699446&idx=1&sn=e13e688f928045bf4d8d8168d8dca936&chksm=bc49fce15fcc5d20c9d5b99a73f6347085532de390ba5387d1fd8a0397832e1073b9f64a5052&scene=126&sessionid=1793627945#rd","2026-11-02T07:52:39.000Z","j0dk3m0550gk6zzv8tgazfxa6","第十二批国采落地：北京11月28日执行，黑龙江、海南11月30日执行","11月3日北京、黑龙江、海南、吉林相继发布第十二批国采落地通知，北京明确11月28日0时全面执行中选结果、采购周期至2029年12月31日，黑龙江与海南均于11月30日执行。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699487&idx=1&sn=426c7bbd871be15c157c06f5f3213b31&chksm=bc1696242e440165a84ab2a44023b9e146ae23727d0d3416b23041ed56c03fef411b4326f158&scene=126&sessionid=1793855733#rd","2026-11-04T06:49:31.000Z","dzqr8y6fdp4mzdssmzmlowxwe","福建医保药品单列门诊统筹支付管理办法施行，明确目录准入与调出规则","福建省医保局10月30日印发《福建省医保药品单列门诊统筹支付管理办法》（闽医保规〔2026〕3号），自2026年11月1日施行、有效期五年，替代原试行版本。药品纳入单列支付目录需同时满足四项条件：属于协议期内或已转常规目录的国谈药品、竞价药品；适合门诊治疗；适应症未被现有门诊特殊病种政策完全覆盖；疗程达12周及以上或年度治疗费用偏高。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699453&idx=1&sn=ab85bb7b69202a9b54f9b9bf5e7bd7e8&chksm=bcb1245cbe1b264572e30044905e868a585eb826c0b37f0f4c09a9b8666bb3fceb7939ae7f22&scene=126&sessionid=1793627945#rd","2026-11-02T09:40:38.000Z","set8oz08lf9shu80sn0qvw6k1","第12批国家集采落地：5省明确执行时间，16省发文安排挂网与支付","截至11月1日，第12批国家集采已有江西、青海、辽宁、海南、河南5省明确执行时间，最早为江西11月16日零时起执行，另有湖南、浙江、四川、广东等11省公布落地安排。","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653668987&idx=1&sn=81d142da0b370d206a86015ea9aa8cbc&chksm=bc27536f47753d34d04fa37e844bbcf49ec5afe609f1bcfda9ef25015abe78f4b9afc3b13027&scene=126&sessionid=1793627968#rd","2026-11-01T11:46:16.000Z","emr76r0kqmzedhg1d2fq4nfo4","江苏医保局部署第十二批国家集采中选结果落地，11月30日起全省执行","江苏省医保局发文部署第十二批国家集采中选结果落地，全省公立医疗机构自2026年11月30日24:00起统一执行，采购周期至2029年12月31日。中选药品按中选价挂网，曲马多注射剂、艾司唑仑口服常释剂型、吡仑帕奈口服常释剂型3个品种完成约定采购量后不再考核用量；伐昔洛韦口服常释剂型等8个品种对接执行本批中选结果，原集采结果同步停止执行。","江苏医保局·阳光采购服务网","http://ybj.jiangsu.gov.cn/art/2026/11/3/art_85482_11853913.html","2026-11-03T00:00:00.000Z","北京市医保局通知执行第十二批国家组织药品集采中选结果，2026年11月21日0时招采子系统统一调整中选药品采购价格，11月28日0时起全面执行中选结果及医保支付标准，采购周期至2029年12月31日。通知明确因抗菌药物使用限制等导致临床需求重大变化的，考核以使用比例代替使用数量；医疗机构反映中选药品供应问题并经核实公示后，采购其他中选企业药品可视作采购该中选药品并享受医保资金结余留用政策。","北京医保局·药品通知公告","https://ybj.beijing.gov.cn/zczxs/2020_ycgga/202611/t20261103_4931207.html","行业动态",[150,151,152,153,154,155,156],{"_80":190,"_23":191,"_67":192,"_84":114,"_86":193,"_88":194,"_90":117,"_92":118,"_94":110,"_96":95},{"_80":184,"_23":185,"_67":186,"_84":187,"_86":188,"_88":189,"_90":-5,"_94":95,"_96":95},{"_80":179,"_23":180,"_67":181,"_84":114,"_86":182,"_88":183,"_90":117,"_92":118,"_94":110,"_96":95},{"_80":174,"_23":175,"_67":176,"_84":105,"_86":177,"_88":178,"_90":108,"_92":109,"_94":110,"_96":95},{"_80":169,"_23":170,"_67":171,"_84":105,"_86":172,"_88":173,"_90":108,"_92":109,"_94":110,"_96":95},{"_80":163,"_23":164,"_67":165,"_84":166,"_86":167,"_88":168,"_90":-5,"_94":110,"_96":95},{"_80":157,"_23":158,"_67":159,"_84":160,"_86":161,"_88":162,"_90":-5,"_94":110,"_96":95},"wbm2snhs4cop4oc1zaytxx14n","熙源安健两项偏头痛临床前项目授权艾伯维，潜在总额最高7.57亿美元","熙源安健公布与艾伯维独家授权合作进展，两项偏头痛临床前项目的潜在交易总价值最高可达7.57亿美元，另加未来产品销售分成。协议于2024年签署，熙源安健负责药物发现，艾伯维主导全球开发与商业化；两个项目的名称、靶点、技术模态及首付款、分成比例均未披露。","药时代","https://www.drugtimes.cn/2026/11/03/757yimeiyuanxiyuananjianpiantoutongguanxianchuhaiaibowei/","2026-11-03T01:55:20.000Z","pnjlx18ya54hc0k99vie6h8b7","哈药集团2026年三季报营收123.52亿元、净利润6亿元同比增82.66%","哈药集团2026年三季报显示，报告期内实现营收123.52亿元（+2.75%）、归母净利润约6亿元（+82.66%），业绩双增。保健品业务延续高增长，钙铁锌口服液、消食化积口服液、朴雪、盖中盖等经典品种叠加GNC品牌产品矩阵，成为线上渠道增长主力；商业板块批发与零售两端同步调整品种结构。","米内网·企业","https://www.menet.com.cn/info/202611/202611020925152515_151369.shtml","2026-11-02T00:00:00.000Z","n7btsxsgvx3s4rwf3nzku3hhd","十余家医院密集召开廉洁会，带金销售模式面临收紧","11月1日至3日，包头市第三医院、海南医科大学第二附属医院、大理大学第一附属医院等十余家医院密集发布消息，近期召开了廉洁教育或医药反腐专题部署会议，廉洁教育向岗位权责、学术活动费用和干部家属延伸。","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669349&idx=2&sn=94ef064bca9ac6dab96100f660b72664&chksm=bc9bd5bd4bf441268aa2f04ebdf022437bd9131a460eecc108d7f10cfd7cce1cc71b6299e7e6&scene=126&sessionid=1793719833#rd","2026-11-03T12:55:47.000Z","k1eif37jd2voi25bib80hh174","2026H1公立医疗机构终端83个国谈药销售额超3亿元，合计近640亿元","2026H1中国公立医疗机构终端有83个国谈药销售额突破3亿元，合计接近640亿元，独家品种占比接近90%。","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653669124&idx=3&sn=a787f98e2cd825710248302fbdcb5f42&chksm=bcc2bd461e0de1a881fb6d13a220f28b3aa7808eb03b38b39e102ebded428aecb339bafbe0e1&scene=126&sessionid=1793624689#rd","2026-11-02T11:51:44.000Z","ucq247nraf34rd1grsxyk3l1a","诺和诺德前三季度中国区收入约23亿美元，GLP-1下降18%","诺和诺德2026年前三季度全球净销售额2545.06亿丹麦克朗（约395.45亿美元），按固定汇率同比增长13%；中国区收入147.78亿丹麦克朗（约22.96亿美元），同比下滑2%，第三季度单季再降5%。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699489&idx=1&sn=29621a8992a1c8fb21ee92541f160a06&chksm=bcf07b9fb8c8e5872ed113f623cd835f8f24ee564ad6a2d9dcd398067a8de44425bab86c18ee&scene=126&sessionid=1793855733#rd","2026-11-04T09:40:00.000Z","mrqa4l5bvc0nkkbc3ssjse6gr","中国生物制药与勃林格殷格翰达成战略合作，潜在总金额70亿美元","中国生物制药发布自愿公告，宣布与勃林格殷格翰达成战略合作，潜在总金额70亿美元。公告未披露合作的具体管线、首付款与里程碑结构。","中国生物制药·港交所公告","https://www1.hkexnews.hk/listedco/listconews/sehk/2026/1104/2026110400623_c.pdf","2026-11-04T08:34:00.000Z","wq2nqezlgrnos0d5m3m6et8w1","辉瑞将舒普深国内推广交给第三方CSO，康新博划入核心医院急症BU","据行业消息，辉瑞中国将注射用头孢哌酮钠舒巴坦钠（舒普深）的国内推广整体交给第三方CSO，不再由自有销售队伍覆盖；同属抗感染矩阵的艾沙康唑（康新博）则从广阔市场团队划入核心医院急症BU。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699457&idx=1&sn=11de5c9e5c809960a8cb1fa1453487c0&chksm=bc6aaeb3e73cec0766ead50088868e999dd98b87fe0f395c0de72eb1fbf3f26079262d47e88d&scene=126&sessionid=1793719809#rd","2026-11-03T04:05:26.000Z",{"_80":139,"_23":140,"_67":141,"_84":142,"_86":143,"_88":144,"_90":-5,"_94":95,"_96":95},{"_80":134,"_23":135,"_67":136,"_84":105,"_86":137,"_88":138,"_90":108,"_92":109,"_94":110,"_96":95},{"_80":190,"_23":191,"_67":192,"_84":114,"_86":193,"_88":194,"_90":117,"_92":118,"_94":110,"_96":95},"leadParagraph",{"_200":201,"_202":-5,"_203":95},"changelogVersion","2026-10-08T08:00","release","staticSite"]
