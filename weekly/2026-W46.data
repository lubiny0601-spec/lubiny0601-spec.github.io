[{"_1":2,"_3":4},"root",{"_5":233},"weekly-detail",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14},"report",{"_34":35,"_19":28,"_21":29,"_23":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":25,"_57":31},"index",[15,16,17,18],"today","2026-11-23","expiresAt",1795443818000,{"_19":31,"_21":32,"_23":33},{"_19":28,"_21":29,"_23":30},{"_19":25,"_21":26,"_23":27},{"_19":20,"_21":22,"_23":24},"key","2026-W44","issueNumber",1,"title","国家药监局批准拜耳阿舒克森片上市，用于降低缺血性卒中及高风险TIA患者卒中风险","2026-W45",2,"北京医保局发文执行第十二批国家集采中选结果，11月28日起全面落地","2026-W46",3,"四部门发文促进创新药配备使用，两目录内1类新药不计入一品两规","2026-W47",4,"国家医保局发布2026版医保药品目录与第二批商保创新药目录，新增107种药品","kind","weekly","MedHOT 周报 · 2026-W46","generatedAt","2026-11-23T04:25:28.962Z","lead",{"_23":30,"_232":44},"leadItemId","iayz6rcd3vs29pftlmp9qe809","overview","本周国内创新药获批密集，信诺维的注射用亚胺西福与礼来的奥氟格列隆钙片先后获国家药监局批准上市。政策端四部门发文优化创新药配备使用，两目录内1类新药不计入一品两规，中保协首版商保药品推荐清单同步发布。行业层面药明康德被美国国防部移出1260H清单，泰格医药拟出售方达控股控制权。","highlights",[229,230,231],"sections",[63,64,65,66],"flashes",[],"cover","metrics",{"_58":59,"_60":61,"_62":29},"readingMinutes",8,"prev","next","totalStories",20,"selectedCount",32,"reportsCovered",{"_67":203,"_69":204,"_71":205},{"_67":163,"_69":164,"_71":165},{"_67":107,"_69":108,"_71":109},{"_67":68,"_69":70,"_71":72},"label","论文研究","summary","慢性阻塞性肺疾病诊治指南2026年修订版发布，流感监测显示南北方阳性率上升、甲型H1N1占近半。","items",[73,74,75],{"_76":98,"_23":99,"_69":100,"_80":101,"_82":102,"_84":103,"_86":104,"_88":105,"_90":106,"_92":91},{"_76":93,"_23":94,"_69":95,"_80":96,"_82":97,"_84":85,"_86":87,"_88":89,"_90":91,"_92":91},{"_76":77,"_23":78,"_69":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":91},"itemId","fubx64y7iuf3aj03hi4n8pzcl","中国流感监测周报第934期：南北方流感阳性率上升，A(H1N1)pdm09占47.4%","截至2026年11月8日的一周，南、北方省份流感病毒检测阳性率上升，全国检出阳性样本中A(H1N1)pdm09占47.4%、A(H3N2)占23.4%、B(Victoria)系占29.2%，共报告125起流感样病例暴发疫情。","sourceName","中国疾控·流感监测周报","sourceUrl","https://www.chinacdc.cn/jksj/jksj04_14249/202611/t20261111_1842933.html","publishedAt","2026-11-12T00:00:00.000Z","sourceIconUrl","/api/img-proxy?u=https%3A%2F%2Fwww.chinacdc.cn%2Fimages%2Flogo_ico.png&mode=avatar&exp=1795651200&sig=dce7a2aec60f8270","sourceIconSrcSet","/api/img-proxy?u=https%3A%2F%2Fwww.chinacdc.cn%2Fimages%2Flogo_ico.png&mode=avatar-48&exp=1795651200&sig=7775fef985ba8279 48w, /api/img-proxy?u=https%3A%2F%2Fwww.chinacdc.cn%2Fimages%2Flogo_ico.png&mode=avatar&exp=1795651200&sig=dce7a2aec60f8270 96w","firstParty",true,"available","m345oqkragfyvkx2jvhm6umvr","中国疾控发布2026年第45周全国急性呼吸道传染病哨点监测：流感病毒阳性率18.8%","中国疾控发布2026年第45周（11月2日—11月8日）全国急性呼吸道传染病哨点监测结果，216家多病原监测哨点医院门急诊流感样病例呼吸道样本阳性率前三位为流感病毒18.8%、鼻病毒10.9%、人偏肺病毒5.4%，住院严重急性呼吸道感染病例为鼻病毒10.2%、流感病毒6.6%、人偏肺病毒5.6%。","中国疾控·急性呼吸道传染病哨点监测","https://www.chinacdc.cn/jksj/jksj04_14275/202611/t20261112_1842956.html","g7pvd8hfxhkimujq702vbenuw","《慢性阻塞性肺疾病诊治指南（2026年修订版）》全文发布","中华医学会呼吸病学分会与中国医师协会呼吸医师分会发布《慢性阻塞性肺疾病诊治指南（2026年修订版）》，在2021年版基础上围绕22个临床问题给出推荐意见，采用GRADE方法评价证据。","呼吸界","https://mp.weixin.qq.com/s?__biz=MzU3NjA5MTM2OQ==&mid=2247604612&idx=1&sn=b0783ca21119ec3b0775009eaea7085b&chksm=fc83958b9cccbab9fd3a714cd94906633d1a59c2b23ac4e80942eb9d82b51f6089486727b542&scene=126&sessionid=1794384928#rd","2026-11-09T09:37:03.000Z","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2FqcrGY40NstI9KRy4xGibFbQKxOmj4bsGPiaZUj6GX6GT7y8o5IhK2s0WmeUI2OpkvORFYDp0anficAMm01e7dLGAg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=a6a1bb0cc49dcaf4","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2FqcrGY40NstI9KRy4xGibFbQKxOmj4bsGPiaZUj6GX6GT7y8o5IhK2s0WmeUI2OpkvORFYDp0anficAMm01e7dLGAg%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=df299adc40fe2737 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2FqcrGY40NstI9KRy4xGibFbQKxOmj4bsGPiaZUj6GX6GT7y8o5IhK2s0WmeUI2OpkvORFYDp0anficAMm01e7dLGAg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=a6a1bb0cc49dcaf4 96w",false,"政策与监管","第十二批国家集采多省明确执行节点，上海启动未中选药品梯度降价，美国食品药品监督管理局要求GLP-1药物增列眼病风险警示。",[110,111,112,113,114,115,116],{"_76":42,"_23":30,"_69":157,"_80":158,"_82":159,"_84":160,"_86":161,"_88":162,"_90":91,"_92":91},{"_76":152,"_23":153,"_69":154,"_80":136,"_82":155,"_84":156,"_86":139,"_88":140,"_90":106,"_92":91},{"_76":147,"_23":148,"_69":149,"_80":136,"_82":150,"_84":151,"_86":139,"_88":140,"_90":106,"_92":91},{"_76":141,"_23":142,"_69":143,"_80":144,"_82":145,"_84":146,"_86":-5,"_90":91,"_92":91},{"_76":133,"_23":134,"_69":135,"_80":136,"_82":137,"_84":138,"_86":139,"_88":140,"_90":106,"_92":91},{"_76":125,"_23":126,"_69":127,"_80":128,"_82":129,"_84":130,"_86":131,"_88":132,"_90":91,"_92":91},{"_76":117,"_23":118,"_69":119,"_80":120,"_82":121,"_84":122,"_86":123,"_88":124,"_90":106,"_92":91},"cy615dx5b3ywgwqj1m58mizck","FDA 要求所有 GLP-1 药物说明书新增 NAION 眼病风险警示，涉及司美格鲁肽、替尔泊肽","11 月 9 日，FDA 要求所有 GLP-1 受体激动剂上市许可持有人在美国说明书“警告和注意事项”部分增加非动脉炎性前部缺血性视神经病变（NAION）潜在风险信息，范围从司美格鲁肽扩至替尔泊肽及 2026 年获批的口服小分子 Foundayo。","赛柏蓝","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670067&idx=4&sn=1aba008d7091e137fec6c9de86badac5&chksm=bc6b73b20544af489e8ce63cb00b425215066594cac9d5821867fa8ee4c808a0ebefb093f24f&scene=126&sessionid=1794384945#rd","2026-11-10T11:54:18.000Z","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=167030ae1e219003","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=b828ff70e947816f 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F6BqBCkCD1bg8EOJKO4icJ1QlstDibu4HuDRmxsxweYJquTYc9twadYxCOlcxueicaj2sBmqmGpoOKudB5ll2pP5Wg%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=167030ae1e219003 96w","cq4zpkd59donpvwllbtes9bc1","广东明确第十二批国家集采首年采购周期为2026年11月30日至2027年11月29日","广东省药品交易中心发布通知，第十二批国家集采首年采购周期为2026年11月30日至2027年11月29日，中选企业即日起在广东招采子系统维护配送关系，医疗机构与中选企业可查看约定采购量。与广东联盟双氯芬酸等药品接续采购、常见病慢性病药品接续采购、易短缺和急抢救药联盟集采存在重复的品种，自本次集采结果执行之日起按国家集采结果执行并重新签订购销合同，各采购平台关闭原历史购销合同采购下单功能。","广东省药品交易中心·通知公告","https://www.gdmede.com.cn/announcement/announcement/detail?id=2120795759115767808","2026-11-11T16:00:00.000Z","/api/img-proxy?u=https%3A%2F%2Fwww.gdmede.com.cn%2Ffavicon.ico&mode=avatar&exp=1795651200&sig=7b6790186a8c4652","/api/img-proxy?u=https%3A%2F%2Fwww.gdmede.com.cn%2Ffavicon.ico&mode=avatar-48&exp=1795651200&sig=e585872dca2ffb01 48w, /api/img-proxy?u=https%3A%2F%2Fwww.gdmede.com.cn%2Ffavicon.ico&mode=avatar&exp=1795651200&sig=7b6790186a8c4652 96w","nlm0po7xu4108td3t4ubso8ho","中保协发布首版商保药品推荐清单，58款高值创新药械入选","11月10日，中国保险行业协会发布《商业健康保险药品保障推荐清单（第一版）》，首批遴选58款推荐药械，适应症覆盖肺癌、肝癌、血液肿瘤等高发恶性肿瘤及神经母细胞瘤等国家罕见病目录内肿瘤，其中1类创新药25款、2类改良型新药2款，基本医保目录外自费药32款。","医药云端工作室","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699547&idx=1&sn=876e47f9b66147f900ca3c68d6e3b26c&chksm=bc71c129d5e5830141f99f0e62f4a5af2b31b84ccf34d9c6af210752518c8e58eee5adfc7f30&scene=126&sessionid=1794384876#rd","2026-11-10T11:29:40.000Z","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=920757ef74ebe49f","/api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar-48&exp=1795651200&sig=9cb8174b387e7452 48w, /api/img-proxy?u=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_png%2F2R6vHe0tpKunwibAIZuFvPyFGCsZxKaujgPIqVdteoMdXIlf4CG5keoVTMD9ia6fI8kJo2bMrVpOvibC8SL6BcGBw%2F0%3Fwx_fmt%3Dpng&mode=avatar&exp=1795651200&sig=920757ef74ebe49f 96w","rwnxfwlhpi92h2i7b7lkace12","上海启动第十二批国家集采未中选药品梯度降价填报，11月17日前未调价将暂停采购","上海阳光医药采购网开通第十二批国家集采未中选已挂网药品申报价填报通道，价格确认时间为2026年11月11日至11月17日。已挂网参比制剂和过评药品按系统参考治理价调整申报价，未过评药品按不高于本市有约定采购量中选药品最低价依差比价规则计算，中选产品非供应清单内的二同药品按其中选价格依差比价规则计算。","上海阳光医药采购网","https://www.smpaa.cn/xxgk/gggs/2026/11/11/25805.shtml","2026-11-11T00:00:00.000Z","xoyrc6solxje32yui6z9rdukx","第十二批国采落地：内蒙古等11省份明确执行时间节点","截至11月12日，内蒙古、甘肃、山西、辽宁、山东、上海、宁夏、江西、江苏、北京、黑龙江、海南、河南等省份相继发布第十二批国家集采落地通知。江西11月16日零时起更新734个品规医保支付标准并执行，山东、山西、内蒙古、河南、海南、黑龙江统一锁定11月30日执行，北京为11月28日0时。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699587&idx=1&sn=725f033bf10796404d56dfedf0e9b281&chksm=bcdeede9d40f585769662daeffd9e5aa5bed90bf1dfccc5b1e4d1831058948950d162931bd4c&scene=126&sessionid=1794493842#rd","2026-11-12T05:12:54.000Z","wusdux4co97jino3gtmcwkwcu","第12批国采福建11月27日执行，12省份明确落地时间","福建省医保局11月12日发文，第12批国采中选结果定于2026年11月27日挂网执行，采购周期至2029年12月31日，12月4日起中选与非中选药品同步执行差别化医保支付标准。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699601&idx=1&sn=fffd535b5f2beb6cc933dd5dbf6f82bc&chksm=bc5ef9a635ee01806adf703e43e839c2a2921f6e6fe390568665284a0bc12d7cb2cbec65647d&scene=126&sessionid=1794493842#rd","2026-11-12T10:08:22.000Z","11月10日，国家卫生健康委、国家医保局、国家中医药局、国家疾控局联合发布《关于进一步做好创新药安全合理配备使用工作的通知》，明确国家医保谈判药品目录和商业健康保险创新药品目录内1类新药不计入一品两规，也不纳入门诊患者基本药物处方占比、住院次均药品费用增幅等公立医疗机构绩效监测指标。","中国食品药品网·要闻","https://www.cnpharm.com/c/2026-11-10/1110268.shtml","2026-11-10T00:00:00.000Z","/api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar&exp=1795651200&sig=c24b59b2539d0fa2","/api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar-48&exp=1795651200&sig=a6033af3171219fe 48w, /api/img-proxy?u=https%3A%2F%2Fwww.cnpharm.com%2Ftemplate%2Fimg%2Ftitlogo.png&mode=avatar&exp=1795651200&sig=c24b59b2539d0fa2 96w","行业动态","药明康德移出1260H清单、泰格医药剥离方达控股，另有同源康与汇宇和解及Madrigal前高管诉讼。",[166,167,168,169,170,171],{"_76":197,"_23":198,"_69":199,"_80":200,"_82":201,"_84":202,"_86":-5,"_90":106,"_92":91},{"_76":193,"_23":194,"_69":195,"_80":175,"_82":196,"_84":177,"_86":-5,"_90":106,"_92":91},{"_76":188,"_23":189,"_69":190,"_80":175,"_82":191,"_84":192,"_86":-5,"_90":106,"_92":91},{"_76":183,"_23":184,"_69":185,"_80":120,"_82":186,"_84":187,"_86":123,"_88":124,"_90":106,"_92":91},{"_76":178,"_23":179,"_69":180,"_80":136,"_82":181,"_84":182,"_86":139,"_88":140,"_90":106,"_92":91},{"_76":172,"_23":173,"_69":174,"_80":175,"_82":176,"_84":177,"_86":-5,"_90":106,"_92":91},"xftkwqqgcq9ehq1g9qm73wzkh","黑石生命科学最高投入15亿美元，支持辉瑞GLP-1在研药Berobenatide开发","2026年11月11日，辉瑞与黑石生命科学达成研发共担战略融资协议，黑石旗下管理基金将在2028年前最高投入15亿美元，支持一月一次给药的GLP-1受体激动剂多肽Berobenatide（PF'3944）开发。","药时代","https://www.drugtimes.cn/2026/11/12/15yimeiyuanjiamaheishiyazhuhuiruibaiyijinggoudeglp1zhongbang/","2026-11-12T03:22:34.000Z","txkhvirutbeop5uax0772gvga","药明康德被美国国防部移出1260H清单，梳理近三年博弈前因后果","美国国防部决定将药明康德从1260H条款项下的中国军工企业名单中移除，药明康德11月9日获悉、11月10日在港交所公告。事件起于6月8日国防部更新清单将药明康德列为中国军工企业，公司6月11日在哥伦比亚特区联邦地区法院起诉，8月7日法院批准初步禁令，裁决意见书指出国防部认定存在事实错误。","https://mp.weixin.qq.com/s?__biz=MjM5NDEwMDQ2Mg==&mid=2658699533&idx=1&sn=e7515636aee185ac0cff162018562e1d&chksm=bc7a8bbea5b43f458c997ff82f08a170f26addb3adbb08d8e21ff8a0205184988827cf9384cf&scene=126&sessionid=1794384876#rd","2026-11-10T02:07:57.000Z","dlqfgn0lci9cbq9wuo6tpwfpj","泰格医药拟出售方达控股控制权，剥离海外实验室业务","泰格医药11月10日公告，拟出售子公司方达控股控制权并剥离其海外实验室业务。香港泰格将与查尔斯河（CRL）、方达控股董事会主席李松博士及相关信托共同推进方达私有化、退出港股上市，再分拆业务由各方分别承接；私有化以共同设立的SanRex为收购主体，每股注销价2.37港元，较10月21日收盘价溢价约59.1%。交易完成后泰格医药及香港泰格不再持有方达股份，但仍持有拆分后保留的业务。","https://mp.weixin.qq.com/s?__biz=MjM5NTA4Mzc2Mg==&mid=2653670239&idx=1&sn=370c061360176f0269ef86b445a81470&chksm=bcac0cbca4d36b4b16e47ae37f6fd6f48a2bdabe2f9764d4b77d9333f36775869e782cfb7d81&scene=126&sessionid=1794384945#rd","2026-11-11T04:07:52.000Z","k9lo3hff5lckcsrhcpahgtr46","Madrigal前临床开发负责人起诉，指控Rezdiffra试验数据被操纵","Madrigal前高级副总裁、临床开发负责人Michael Charlton向美国伊利诺伊州北区联邦地区法院提起SOX吹哨人报复诉讼，指控公司隐瞒Rezdiffra肝脏安全风险、操纵临床试验数据、篡改EASL会议披露的MAESTRO-NAFLD-1 F4c队列两年随访结果，并在其上报后将其调岗、2026年1月5日离职。","https://www.drugtimes.cn/2026/11/10/nianxiaotupo10yimeiyuanzhijiyizhisuzhuangxilaiqianlinchuangf/","2026-11-10T01:21:07.000Z","a1gdvgfiqbqnbwtt7y07j1x98","同源康与汇宇就TY-9591商业化授权纠纷和解，支付3亿元","同源康医药与汇宇制药就TY-9591销售代理及配套合作争议签署附条件和解协议，同源康分两期支付合计3亿元，首期1.5亿元于协议生效后30日内支付，第二期最晚2027年1月25日；汇宇收款后向内江中院撤诉并放弃对TY-9591的全部权利主张。","https://www.drugtimes.cn/2026/11/12/3yiyuanbdxuefeitongyuankangyuhuiyudeshangyehuashouquanjiufen/","seaiad78o4uisfn4q60ly09ns","葵花药业2026年前三季度净利润增349.07%，儿科中成药份额居首","葵花药业2026年前三季度营收约21.19亿元、同比增长25.81%，归母净利润约8353万元、同比增长349.07%，扣非归母净利润约4943万元、同比增长160.72%。公司拥有600余个生产批文、29个独家品种，2026H1在中国城市实体药店终端儿科中成药集团排名居首，份额保持13%以上。今年以来5个品种获批并视同过评，其中氟比洛芬凝胶贴膏为首款贴膏剂，美沙拉秦肠溶片在第12批国家集采中选。","米内网·企业","https://www.menet.com.cn/info/202611/202611090911261126_151405.shtml","2026-11-09T00:00:00.000Z","获批与准入","国内两款1类新药获批，海外拜耳的asundexian与和誉医药的匹米替尼获美国食品药品监督管理局批准。",[206,207,208,209],{"_76":225,"_23":226,"_69":227,"_80":158,"_82":228,"_84":85,"_86":161,"_88":162,"_90":91,"_92":91},{"_76":221,"_23":222,"_69":223,"_80":158,"_82":224,"_84":85,"_86":161,"_88":162,"_90":91,"_92":91},{"_76":215,"_23":216,"_69":217,"_80":218,"_82":219,"_84":220,"_86":-5,"_90":106,"_92":91},{"_76":210,"_23":211,"_69":212,"_80":213,"_82":214,"_84":146,"_86":-5,"_90":106,"_92":91},"pjbipbd33vluv26wpuotpgab5","和誉医药盐酸匹米替尼胶囊获FDA批准用于症状性腱鞘巨细胞瘤","和誉医药自主研发的CSF-1R小分子抑制剂贝捷迈（盐酸匹米替尼胶囊）获FDA批准，用于系统性治疗手术切除可能导致功能受限加重或严重并发症的症状性腱鞘巨细胞瘤成年患者。","生物谷","https://news.bioon.com/article/daf4963e948e.html","isf4rwjr6b7h76v7w18kbidfi","拜耳 Factor XIa 抑制剂 asundexian 获 FDA 批准，商品名 Sunharbo，用于卒中二级预防","FDA 批准拜耳的口服 Factor XIa 抑制剂 asundexian（商品名 Sunharbo）用于特定成人患者的卒中二级预防，需与抗血小板治疗联用。支持获批的研究入组逾 12,000 名既往发生预警性卒中或心源性以外血栓性卒中的成人，一半接受安慰剂、一半每日一次 Sunharbo，结果显示缺血性卒中风险较对照组降低 26%，两组大出血例数相近，最常见不良反应为腹泻。","BioPharma Dive","https://www.biopharmadive.com/news/bayer-sunharbo-asundexian-fda-approve-stroke-factor-xi/872837/","2026-11-09T22:40:00.000Z","q56n158sih0xekrn9fagxizza","NMPA批准礼来奥氟格列隆钙片（穆优达）上市用于成人长期体重管理","国家药监局批准EliLilly Nederland B.V.申报的1类创新药奥氟格列隆钙片（商品名穆优达）上市，用于在控制饮食和增加运动基础上对成人进行长期体重管理。适用人群为BMI≥30 kg/m2的肥胖成人，或BMI≥27 kg/m2至<30 kg/m2且伴有至少一种体重相关合并症（如高血压、血脂异常、高血糖、阻塞性睡眠呼吸暂停综合征、心血管疾病等）的超重成人。","https://www.cnpharm.com/c/2026-11-12/1110394.shtml","tro5a5rnazr0cc9daieelgnaz","国家药监局批准信诺维1类创新药注射用亚胺西福上市，用于HABP/VABP","国家药监局批准苏州信诺维医药科技股份有限公司申报的1类创新药注射用亚胺西福（商品名：福诺凯）上市，适应症为医院获得性细菌性肺炎和呼吸机相关性细菌性肺炎（HABP/VABP）。该药适用于18岁及以上患者中由肺炎克雷伯菌、醋酸钙-鲍曼不动杆菌复合群、铜绿假单胞菌、流感嗜血杆菌、产气克雷伯菌、阴沟肠杆菌、大肠埃希菌、产酸克雷伯菌等敏感革兰阴性菌引起的HABP/VABP。","https://www.cnpharm.com/c/2026-11-12/1110391.shtml",{"_76":225,"_23":226,"_69":227,"_80":158,"_82":228,"_84":85,"_86":161,"_88":162,"_90":91,"_92":91},{"_76":152,"_23":153,"_69":154,"_80":136,"_82":155,"_84":156,"_86":139,"_88":140,"_90":106,"_92":91},{"_76":147,"_23":148,"_69":149,"_80":136,"_82":150,"_84":151,"_86":139,"_88":140,"_90":106,"_92":91},"leadParagraph",{"_234":235,"_236":-5,"_237":91},"changelogVersion","2026-10-08T08:00","release","staticSite"]
